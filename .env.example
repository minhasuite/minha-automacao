# Dev: o devcontainer já define DATABASE_URL/PORT. Credenciais opcionais —
# vazias, a feature correspondente fica desligada.
# Entrar com Google (docs/login-google.md) e Google Drive/Agenda: client WEB.
GOOGLE_CLIENT_ID=
# Login: outros clients aceitos como audiência do id_token (vírgula). Opcional.
GOOGLE_LOGIN_AUDIENCES=
# Google Agenda pela conta (F9): o mesmo cliente OAuth + o segredo dele.
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FCM_CREDENTIALS_JSON=
FCM_PROJECT_ID=
# Web Push da PWA: gere com bin/vapid-keys (grava aqui; nunca commite).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Licenciamento central (vazio = desligado).
LICENCAS_URL=
LICENCAS_API_KEY=
