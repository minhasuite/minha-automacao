{
  "name": "Avisar quando sensor ficar aberto por X minutos",
  "description": "Avisa quando um sensor (porta, janela, portão) fica aberto mais tempo que o combinado.",
  "domain": "automation",
  "mode": "single",
  "inputs": [
    { "key": "sensor", "label": "Sensor de abertura", "type": "point", "filter": { "capability": ["contact"] } },
    { "key": "tempo", "label": "Aberto há pelo menos", "type": "duration", "default": "5m" },
    { "key": "titulo", "label": "Título do aviso", "type": "text", "default": "Ficou aberto" }
  ],
  "definition": {
    "triggers": [ { "type": "state", "point": { "!input": "sensor" }, "to": true, "for": { "!input": "tempo" } } ],
    "conditions": [],
    "actions": [
      { "type": "notify", "channels": ["in_app", "push"], "title": { "!input": "titulo" }, "message": "{{ trigger.title }}" }
    ]
  }
}
