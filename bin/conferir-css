#!/usr/bin/env ruby
# frozen_string_literal: true

# Régua do "100% componentes-ui" no CSS do produto: toda classe com prefixo do produto usada nas
# telas, helpers e controllers JS tem de estar na allowlist de DOMÍNIO abaixo (o mesmo que o comentário
# "domínio:" no topo de cada CSS diz), e os CSS de tela só podem ter seletores dessas classes (nada de
# .ss-* da gem: ela muda por token, --ss-card-bg e afins). Peça genérica (card, título, texto, ícone,
# botão, chip, linha, selo, barra, amostra de tema) vem da gem. Uso: bin/conferir-css (sai 1 se falhar).
ROOT = File.expand_path("..", __dir__)
PREFIX = /\b(?:dw|hx|ef|mp|mg|ob|oba|ma|vz|ap|oa|lb)-[a-z0-9-]*[a-z0-9]/

CSS_DOMINIO = {
  "dashboards.css" => [
    /\Adw-(grid|sections|w|side|hide-(mobile|tablet|desktop))\z/, # cola da grade do painel
    /\Adw-(anim|ico-art|spinning|cover-blind|gate-(bars|open|opening|closed|unknown|[a-z]+))\z/, # arte viva do ponto
    /\Adw-vac-(run|trail|bot|dock|back)\z/, /\Adw-art-[0-5]\z/, # robô limpando, arte da área
    /\Adw-fpe?(-[a-z-]+)?\z/, /\Adw-(on|unavailable)\z/, # planta baixa (+ estado dos pinos)
    /\Adw-ed(-[a-z-]+)?\z/, /\Adw-(wf|act)\z/, # editor do painel e formulário do widget
    /\Adw-(themed|has-wall|glass|theme-[a-z0-9_-]+)\z/, # temas do painel no <body>
    /\Ama-kiosk(-[a-z]+)?\z/, /\Ama-saver(-[a-z]+)?\z/, /\Ama-ea-[a-z0-9]+\z/ # quiosque e arte do vazio
  ],
  "paineis.css" => [/\Adw-(tappable|holding|panel|stack(-[a-z]+)?)\z/, /\Aap-(live|glass|wall-[a-z]+)\z/],
  "paridade.css" => [/\Amp-(map|compact|canvas|fallback|avatar|home|approx|pin)\z/],
  "produto.css" => [/\Aob-(page|blobs|top|main|wizard|card|art|content|nav|radar-wrap|ticker)\z/, /\Aoba(-[a-z0-9-]+)?\z/],
  "voz.css" => [/\Avz-(flow(-[a-z]+)?|run-bar|seg(-[a-z]+)?)\z/]
}.freeze
ALLOW = CSS_DOMINIO.values.flatten
# Classes só de comportamento (gancho de JS, sem CSS): também são domínio.
HOOKS = %w[ma-kiosk-pop dw-gesture dw-widgets dw-ed-grip dw-ed-grip-s dw-ed-edit].freeze

def domain?(c) = HOOKS.include?(c) || ALLOW.any? { _1.match?(c) }

# Classes de tela: atributos class/css e strings de classe em Ruby e JS (ids e aria-* ficam de fora).
CONTEXTS = [
  /class\s*=\s*"([^"]*)"/, /\bclass(?:Name)?:\s*"([^"]*)"/, /\bcss:\s*"([^"]*)"/, /\bclass:\s*\[([^\]]*)\]/,
  /className\s*=\s*`([^`]*)`/, /className\s*=\s*"([^"]*)"/, /classList\.(?:add|remove|toggle)\(([^)]*)\)/,
  /\bcss\s*=\s*%w\[([^\]]*)\]/, /\bcss\s*<<\s*"([^"]*)"/, /"(dw-(?:hide|theme)-#\{[^}]*\})"/, /"(dw-art-#\{[^}]*\})"/
].freeze
used = Hash.new { |h, k| h[k] = [] }
Dir[File.join(ROOT, "app/{views,helpers,javascript}/**/*.{erb,rb,js}")].each do |f|
  src = File.read(f)
  CONTEXTS.each do |re|
    src.scan(re) do |m|
      m.first.to_s.scan(PREFIX) do |c|
        c = c.sub(/-\z/, "")
        used[c] << f.delete_prefix("#{ROOT}/") unless c.end_with?("-")
      end
    end
  end
end

errors = []
used.each do |c, files|
  next if domain?(c) || c.match?(/\Adw-(hide|theme|art|gate)\z/) # prefixo de classe montada ("dw-hide-#{tela}")

  errors << "classe genérica no produto: .#{c} (#{files.uniq.first(3).join(', ')}) — use a peça da gem"
end
%w[dw-card dw-card-title dw-quiet dw-name dw-state dw-ico dw-row dw-rows dw-feat].each do |c|
  errors << "#{c} ainda usado (#{used[c].uniq.join(', ')})" if used.key?(c)
end

css_lines = 0
Dir[File.join(ROOT, "app/assets/tailwind/*.css")].each do |f|
  name = File.basename(f)
  next if name == "application.css"

  src = File.read(f)
  css_lines += src.lines.size
  errors << "#{name}: sem o comentário \"domínio:\" no topo" unless src[0, 400].include?("domínio:")
  rules = CSS_DOMINIO[name] or (errors << "#{name}: arquivo de CSS sem allowlist em CSS_DOMINIO") && next
  body = src.gsub(%r{/\*.*?\*/}m, "")
  body.scan(/([^{};]+)\{/) do |(sel)|
    next if sel.strip.start_with?("@") || sel.include?(":root") && !sel.include?(".")

    sel.scan(/\.(-?[a-z][a-z0-9-]*)/) do |(c)|
      next if c.match?(/\A(leaflet-[a-z-]+|sortable-fallback|flex-1)\z/) # classes do Leaflet/Sortable e um utilitário no editor da planta

      if c.start_with?("ss-")
        errors << "#{name}: regra em cima de classe da gem .#{c} (#{sel.strip[0, 80]}) — use os tokens --ss-*"
      elsif !(rules.any? { _1.match?(c) } || domain?(c) || c.match?(/\Ais-[a-z-]+\z/)) # contexto de outro arquivo do domínio ou estado .is-*
        errors << "#{name}: .#{c} fora da allowlist de domínio"
      end
    end
  end
end

if errors.any?
  puts errors.uniq
  exit 1
end
puts "CSS do produto só de domínio: #{used.size} classes de domínio em uso, 0 genéricas, #{css_lines} linhas de CSS de tela."
