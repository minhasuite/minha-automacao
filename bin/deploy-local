#!/usr/bin/env bash
# Implanta no servidor local da casa (docker-compose.local.yml): usa a imagem
# local (buildada nesta máquina) ou puxa com o login do GHCR, envia por
# `docker save | ssh docker load` (o servidor não guarda credencial do
# GitHub), gera os segredos lá na primeira vez e sobe o compose. Se a versão
# nova não ficar saudável (web /up + worker healthy) em 6 min, volta para a
# anterior sozinho. Use uma tag por versão (o commit) para a anterior ficar lá.
#
#   bin/deploy-local [tag]          # tag padrão: latest
#   DEPLOY_HOST=herlon@192.168.68.199 DEPLOY_KEY=~/.ssh/id_ed25519
set -euo pipefail

TAG="${1:-latest}"
IMAGE="ghcr.io/minhasuite/minha-automacao:$TAG"
HOST="${DEPLOY_HOST:-herlon@192.168.68.199}"
KEY="${DEPLOY_KEY:-$HOME/.ssh/id_ed25519}"
DIR="${DEPLOY_DIR:-/opt/minha-automacao}"
SSH=(ssh -i "$KEY" -o BatchMode=yes "$HOST")
cd "$(dirname "$0")/.."

echo "==> imagem $IMAGE"
docker image inspect "$IMAGE" >/dev/null 2>&1 || docker pull "$IMAGE" >/dev/null
local_id=$(docker image inspect --format '{{.Id}}' "$IMAGE" | sed 's/^sha256://')
remote_id=$("${SSH[@]}" "docker image inspect --format '{{.Id}}' $IMAGE 2>/dev/null | sed 's/^sha256://'" || true)
if [ "$local_id" != "$remote_id" ]; then
  echo "==> enviando a imagem (pode levar alguns minutos)"
  docker save "$IMAGE" | gzip -1 | "${SSH[@]}" "gunzip | docker load" >/dev/null
else
  echo "==> imagem já está no servidor"
fi

echo "==> compose e segredos"
"${SSH[@]}" "mkdir -p $DIR/backups"
scp -q -i "$KEY" docker-compose.local.yml "$HOST:$DIR/docker-compose.yml"
# Segredos nascem no servidor e não saem de lá.
"${SSH[@]}" bash -s "$DIR" <<'REMOTE'
set -euo pipefail
cd "$1"
touch .env && chmod 600 .env
gen() { grep -q "^$1=" .env || echo "$1=$(openssl rand -hex "${2:-32}")" >> .env; }
gen SECRET_KEY_BASE 64
gen DB_PASSWORD 24
gen AR_ENCRYPTION_PRIMARY_KEY
gen AR_ENCRYPTION_DETERMINISTIC_KEY
gen AR_ENCRYPTION_KEY_DERIVATION_SALT
gen MQTT_PASSWORD 24
gen Z2M_FRONTEND_TOKEN 16
gen SUPERVISOR_TOKEN 32
REMOTE
# Web Push (PWA): par VAPID gerado lá, uma vez só.
"${SSH[@]}" bash -s "$DIR/.env" < bin/vapid-keys

echo "==> subindo"
"${SSH[@]}" bash -s "$DIR" "$IMAGE" <<'REMOTE'
set -euo pipefail
cd "$1"
profiles=()
grep -q '^CF_TUNNEL_TOKEN=.' .env && profiles+=(--profile tunnel)
anterior="$(grep -oP '^IMAGE=\K.*' .env || true)"
sobe() { # A tag implantada fica no .env: `docker compose up` à mão sobe a mesma.
  sed -i '/^IMAGE=/d' .env && echo "IMAGE=$1" >> .env
  docker compose "${profiles[@]}" up -d --remove-orphans --quiet-pull
}
# Saudável = /up respondendo e o worker com o healthcheck "healthy"
# (bin/worker-health: batimento do Solid Queue e fila andando).
saudavel() {
  for _ in $(seq 1 72); do # até 6 min (o healthcheck do worker tem 3 min de partida)
    w="$(docker inspect -f '{{.State.Health.Status}}' "$(docker compose ps -q worker)" 2>/dev/null || echo ausente)"
    if curl -fsS -o /dev/null "http://127.0.0.1:${WEB_PORT:-80}/up" && [ "$w" = healthy ]; then return 0; fi
    sleep 5
  done
  return 1
}
sobe "$2"
if saudavel; then
  echo "no ar: http://$(hostname -I | awk '{print $1}')/"
  docker compose "${profiles[@]}" ps --format '{{.Service}}: {{.Status}}'
  exit 0
fi
echo "!! $2 não ficou saudável (web /up e worker healthy em 6 min)"
docker compose logs --tail 40 web worker || true
if [ -n "$anterior" ] && [ "$anterior" != "$2" ]; then
  echo "==> voltando para $anterior"
  sobe "$anterior"
  saudavel && echo "voltou para $anterior (no ar)" || echo "!! a anterior também não ficou saudável: veja docker compose ps/logs"
fi
exit 1
REMOTE
