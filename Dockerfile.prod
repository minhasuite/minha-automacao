# Imagem de produção (build no job `build` do ci-cd.yml).
# Web + API. Sem Node: CSS pelo binário do Tailwind e JS por importmap.
# libvips para o Active Storage; DejaVu para acento em PDF; ping para o
# rastreador de rede (Pacote 3, só leitura); openssh-client para a cópia de
# backup fora de casa por SSH (G20); ffmpeg para a voz gravada que a Echo toca
# (Alexa::Talk: webm/m4a → MP3).
FROM ruby:3.3.10-slim

ENV RAILS_ENV=production \
    RAILS_LOG_TO_STDOUT=true \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_DEPLOYMENT="1"

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
  build-essential libpq-dev libyaml-dev libvips42 postgresql-client curl fonts-dejavu-core iputils-ping openssh-client ffmpeg \
  && rm -rf /var/lib/apt/lists/*

# resto (7.12): pg_dump da mesma versão do banco (Postgres 18) para o backup
# parcial pela tela; o do Debian (17) recusa servidor mais novo.
RUN install -d /usr/share/postgresql-common/pgdg   && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc   && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo $VERSION_CODENAME)-pgdg main" > /etc/apt/sources.list.d/pgdg.list   && apt-get update -qq && apt-get install -y --no-install-recommends postgresql-client-18   && rm -rf /var/lib/apt/lists/*

RUN gem install bundler -v 2.5.22

WORKDIR /app

COPY Gemfile Gemfile.lock /app/
RUN bundle install --jobs 4 --retry 3 && rm -rf /usr/local/bundle/cache

COPY . /app
RUN bundle exec bootsnap precompile app/ lib/ && \
    SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile

# Qual commit é esta imagem: vira a `versao` de todo erro reportado ao meulog.
# Não entra no compose (variável vazia lá sobrescreveria este ENV).
ARG GIT_SHA=""
# Versão numerada (tag vX.Y.Z do CI): a tela de atualização compara com a
# última release mesmo quando o .env aponta para `latest-stable`.
ARG RELEASE_TAG=""
ENV APP_VERSION=${GIT_SHA} GIT_SHA=${GIT_SHA} RELEASE_TAG=${RELEASE_TAG}

EXPOSE 3000
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
