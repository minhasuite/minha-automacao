<%= render "web/shared/header", title: @point.name, subtitle: [ @point.area&.name, @point.device.name ].compact.join(" · "), back: cameras_path(site_id: @point.site_id) do %>
  <% if @prev %>
    <%= render Ss::IconButtonComponent.new(icon: icon("chevron-left", ""), label: t("cameras.screen.prev_x", name: @prev.name), href: camera_path(@prev), variant: :outline) %>
  <% end %>
  <% if @next %>
    <%= render Ss::IconButtonComponent.new(icon: icon("chevron-right", ""), label: t("cameras.screen.next_x", name: @next.name), href: camera_path(@next), variant: :outline) %>
  <% end %>
  <%= link_to point_path(@point), class: "ss-btn ss-btn-ghost" do %><%= icon("cog", "size-4") %><%= t("cameras.screen.details") %><% end %>
<% end %>
<% can_talk = @features["talk"] && @point.writable && can?(:command, risk: @point.risk) %>
<%# Uma câmera grande: ← → (ou arrastar) troca, F = tela cheia. A reprodução do DVR toca no mesmo card. %>
<div data-controller="camera-nav camera-playback" data-camera-nav-prev-value="<%= (camera_path(@prev) if @prev) %>" data-camera-nav-next-value="<%= (camera_path(@next) if @next) %>"
     data-camera-playback-url-value="<%= camera_playback_path(@point) %>" data-camera-playback-zone-value="<%= @point.site.timezone %>"
     data-camera-playback-locale-value="<%= I18n.locale %>" class="grid grid-cols-1 gap-4">
  <div data-camera-nav-target="stage" data-camera-playback-target="tile" data-action="pointerdown->camera-nav#down pointerup->camera-nav#up"
       class="touch-pan-y mx-auto w-full max-w-[calc((100vh-15rem)*16/9)] min-w-0">
    <%= render "web/cameras/tile", point: @point, autoplay: true, interval: 5, talk: can_talk, fullscreen: true %>
    <p class="text-sm font-semibold text-danger mt-2" data-camera-target="status" role="status" hidden></p>
  </div>
  <p class="text-xs text-muted"><%= t("cameras.screen.keys_one") %></p>

  <% if @features["playback"] %>
    <section class="ss-card ss-card-pad" aria-labelledby="cam-dvr">
      <%= render Ss::CardHeaderComponent.new(title: t("cameras.timeline.title"), subtitle: t("cameras.timeline.subtitle"), heading: :h2, id: "cam-dvr") %>
      <%# Dia (GET no quadro da linha do tempo), hora + Tocar, ±30 s e Ao vivo. %>
      <div class="flex flex-wrap items-end gap-3 mt-3">
        <%= ss_form_with url: camera_timeline_path(@point), method: :get, data: { turbo_frame: "camera-timeline", controller: "ss-autosubmit" }, class: "contents" do |f| %>
          <% zone_today = Cameras::Playback.zone(@point).today %>
          <%= f.ss_date_field :dia, label: t("cameras.timeline.day"), value: @day, id: "cam-day", max: zone_today, min: zone_today - Cameras::Timeline::MAX_DAYS,
                                    data: { camera_playback_target: "day", action: "change->ss-autosubmit#submit" } %>
        <% end %>
        <%= ss_fields(nil) { |f| f.ss_time_field :cam_time, label: t("cameras.timeline.time"), id: "cam-time", name: nil, step: 1, data: { camera_playback_target: "time" } } %>
        <%= render Ss::ButtonComponent.new(label: t("cameras.timeline.play"), icon: icon("play", ""), data: { action: "camera-playback#playTime" }) %>
        <div class="flex gap-2" role="group" aria-label="<%= t("cameras.timeline.jump") %>">
          <%= render Ss::ButtonComponent.new(label: t("cameras.timeline.back30"), icon: icon("rewind", ""), variant: :outline, disabled: true,
                                             data: { camera_playback_target: "jump", action: "camera-playback#jump", camera_playback_seconds_param: "-30" }) %>
          <%= render Ss::ButtonComponent.new(label: t("cameras.timeline.fwd30"), icon: icon("fast-forward", ""), variant: :outline, disabled: true,
                                             data: { camera_playback_target: "jump", action: "camera-playback#jump", camera_playback_seconds_param: "30" }) %>
        </div>
        <%= render Ss::ButtonComponent.new(label: t("cameras.timeline.back_live"), icon: icon("status-online", ""), variant: :ghost, hidden: true,
                                           data: { camera_playback_target: "liveButton", action: "camera-playback#live" }) %>
      </div>
      <p class="text-sm text-muted mt-2 num" aria-live="polite"><span class="sr-only"><%= t("cameras.timeline.position") %></span><span data-camera-playback-target="position"></span></p>
      <p class="text-sm font-semibold text-danger mt-1" data-camera-playback-target="error" role="alert" hidden></p>
      <%= turbo_frame_tag "camera-timeline", src: camera_timeline_path(@point, dia: @day), class: "block mt-4" do %>
        <%= render Ss::SkeletonComponent.new(lines: 3, label: t("cameras.timeline.loading")) %>
      <% end %>
    </section>
  <% end %>
</div>
