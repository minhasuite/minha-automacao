<%= render "web/shared/header", title: t("todo_lists.index.title"), subtitle: t("todo_lists.index.subtitle", site: @site.name) do %>
  <% if can?(:manage) %><%= link_to new_site_helper_path(@site, tipo: "todo"), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("todo_lists.index.new") %><% end %><% end %>
<% end %>
<%= render "web/sites/tabs", site: @site, current: :todo %>
<% if @lists.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("todo_lists.index.empty"), text: t("todo_lists.index.empty_hint"), css: "ss-card") do %><% if can?(:manage) %><%= link_to new_site_helper_path(@site, tipo: "todo"), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("todo_lists.index.first") %><% end %><% end %><% end %>
<% else %>
  <div class="grid gap-4 lg:grid-cols-2 items-start">
    <% @lists.each do |l| %>
      <% items = HelperTypes::TodoList.items(l) %>
      <% pending, done = items.partition { |i| i["status"] != "completed" } %>
      <section class="ss-card ss-card-pad" id="lista-<%= l.id %>" aria-labelledby="t-<%= l.id %>">
        <div class="flex items-center justify-between gap-2 mb-3">
          <h2 id="t-<%= l.id %>" class="flex items-center gap-2 min-w-0"><span class="ss-icon-tile is-accent is-sm"><%= icon(point_icon(l), "") %></span><span class="truncate"><%= l.name %></span></h2>
          <span class="ss-badge"><%= t("todo_lists.index.pending", count: pending.size) %></span>
        </div>
        <% if can?(:command, risk: l.risk) %>
          <%= form_with url: items_site_todo_list_path(@site, l), class: "flex gap-2 mb-2" do %>
            <label class="sr-only" for="novo-<%= l.id %>"><%= t("todo_lists.index.new_item", name: l.name) %></label>
            <%= text_field_tag :summary, nil, id: "novo-#{l.id}", class: "ss-input flex-1 min-w-0", placeholder: t("todo_lists.index.add_ph"), maxlength: 255, required: true %>
            <%= button_tag type: "submit", class: "ss-btn ss-btn-primary", title: t("todo_lists.index.add"), "aria-label": t("todo_lists.index.add") do %><%= icon("plus", "size-4") %><% end %>
          <% end %>
        <% end %>
        <% if items.empty? %>
          <p class="text-sm text-muted py-3"><%= t("todo_lists.index.empty_list") %></p>
        <% else %>
          <%# Lista da gem (.ss-checklist de linha inteira): a linha é o <label> da caixa, que manda o
              PATCH do próprio form (atributo form + data-autosubmit) ao marcar ou desmarcar. %>
          <ul class="ss-checklist" aria-label="<%= t("todo_lists.index.items_of", name: l.name) %>">
            <% (pending + done).each do |i| %>
              <% is_done = i["status"] == "completed" %>
              <li>
                <% if can?(:command, risk: l.risk) %>
                  <% fid = "td-#{l.id}-#{i['uid']}" %>
                  <%= form_with url: toggle_item_site_todo_list_path(@site, l, i["uid"]), method: :patch, id: fid, class: "hidden" do %><% end %>
                  <label class="min-w-0 break-words"><%= check_box_tag nil, "1", is_done, id: nil, form: fid, data: { autosubmit: true } %><%= i["summary"] %></label>
                <% else %>
                  <label class="min-w-0 break-words"><%= check_box_tag nil, "1", is_done, id: nil, disabled: true %><%= i["summary"] %></label>
                <% end %>
                <% if i["due"].present? %><% late = !is_done && (Date.parse(i["due"]) rescue nil)&.past? %><span class="ss-badge <%= late ? 'ss-badge-danger' : 'ss-badge-muted' %> shrink-0"><%= t("todo_lists.index.due", date: i["due"]) %></span><% end %>
                <% if can?(:command, risk: l.risk) %>
                  <%= button_to remove_item_site_todo_list_path(@site, l, i["uid"]), method: :delete, class: "ss-icon-btn is-sm is-danger", form: { class: "contents" },
                                title: t("todo_lists.index.remove", name: i["summary"]), "aria-label": t("todo_lists.index.remove", name: i["summary"]) do %><%= icon("x", "") %><% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
          <% if done.any? && can?(:command, risk: l.risk) %>
            <%= button_to completed_site_todo_list_path(@site, l), method: :delete, class: "ss-btn ss-btn-ghost ss-btn-sm mt-3", form: { class: "contents" } do %><%= icon("trash", "size-4") %><%= t("todo_lists.index.clear_done", count: done.size) %><% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>
  </div>
<% end %>
