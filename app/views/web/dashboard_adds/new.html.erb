<%# Ideia 2: "Adicionar ao painel". O widget sai da coisa (Dashboards::AddTo, pela capacidade); a pessoa escolhe o
    painel, a visão e a seção (uma lista só, agrupada por painel). Entra no rascunho; publicar é no editor. %>
<% name = (@record.try(:name) unless @record.is_a?(Site)) %>
<% type_label = Dashboards::Schema.labels.fetch(@widget["type"], @widget["type"]) %>
<%= render "web/shared/header", title: t("dashboards.add_to.title"), subtitle: [ name, @site.name ].compact.join(" · "), back: (request.referer.presence if request.referer.to_s.start_with?(request.base_url)) %>
<% if @places.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("dashboards.add_to.no_place"), text: t("dashboards.add_to.no_place_hint"), css: "ss-card") do %>
    <%= link_to t("dashboards.add_to.open_editor"), edit_dashboard_path(@dashboards.first), class: "ss-btn ss-btn-primary" if @dashboards.any? %>
  <% end %>
<% else %>
  <%= form_with url: dashboard_adds_path, class: "ss-card ss-card-pad grid gap-4 max-w-2xl" do %>
    <%= hidden_field_tag :tipo, @type, id: nil %><%= hidden_field_tag :id, @record.id, id: nil %>
    <div class="flex items-center gap-3">
      <span class="ss-icon-tile is-accent"><%= icon(Dashboards::Widgets[@widget["type"]]&.icon || "cube", "") %></span>
      <p class="min-w-0"><span class="block font-bold text-ink"><%= @widget["label"].presence || name %></span>
        <span class="block text-sm text-muted"><%= t("dashboards.add_to.becomes", type: type_label) %></span></p>
    </div>
    <div><label class="ss-label" for="place"><%= t("dashboards.add_to.where") %></label>
      <%= select_tag :place, grouped_options_for_select(@places.group_by(&:first).map { |d, list| [ d.name, list.map { |_, v, s| [ "#{v['title']} · #{s['title'].presence || t('dashboards.ed.untitled')}", "#{d.id}:#{s['id']}" ] } ] }),
                     id: "place", class: "ss-input", required: true %></div>
    <p class="text-sm text-muted"><%= t("dashboards.add_to.draft_note") %></p>
    <div><%= submit_tag t("dashboards.add_to.submit"), class: "ss-btn ss-btn-primary" %></div>
  <% end %>
<% end %>
