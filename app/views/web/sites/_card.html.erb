<%# locals: (site:, delay: 0) -%>
<%= link_to site, class: "ss-card ss-card-pad no-underline ss-rise flex flex-col gap-4", style: "animation-delay: #{delay}ms" do %>
  <div class="flex items-start justify-between gap-3">
    <span class="grid place-items-center size-11 rounded-xl bg-accent-soft text-accent"><%= icon(site_icon(site)) %></span>
    <span class="ss-badge"><%= site.kind_label %></span>
  </div>
  <div class="min-w-0">
    <p class="font-bold text-lg text-ink truncate"><%= site.name %></p>
    <p class="text-sm text-muted"><%= t("shared.count.areas", count: site.areas.size) %> · <%= t("shared.count.devices", count: site.devices.size) %></p>
  </div>
<% end %>
