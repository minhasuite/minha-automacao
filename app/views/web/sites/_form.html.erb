<%# locals: (site:) -%>
<%# Formulário do local; o bloco (de new e edit) traz as ações: yield f. -%>
<%= ss_form_with model: site, class: "ss-card ss-card-pad grid gap-4 md:grid-cols-2 max-w-3xl" do |f| %>
  <%= render "web/shared/errors", record: site %>
  <div class="md:col-span-2"><%= f.ss_text_field :name, label: t("sites.form.name"), required: true, placeholder: t("sites.form.name_hint"), autofocus: true %></div>
  <%= f.ss_select :kind, Site::KINDS.invert, label: t("sites.form.kind") %>
  <%= f.ss_text_field :address, label: t("sites.form.address"), placeholder: t("shared.optional") %>
  <%= f.ss_select :timezone, ActiveSupport::TimeZone::MAPPING.values.uniq.sort, label: t("sites.form.timezone") %>
  <div class="grid grid-cols-2 gap-2">
    <%= f.ss_number_field :latitude, label: t("sites.form.latitude"), step: "any", min: -90, max: 90, class: "num", placeholder: "-15.79" %>
    <%= f.ss_number_field :longitude, label: t("sites.form.longitude"), step: "any", min: -180, max: 180, class: "num", placeholder: "-47.88" %>
  </div>
  <small class="ss-field-help md:col-span-2 -mt-2"><%= t("sites.form.coords_hint") %></small>
  <%= f.ss_select :unit_system, Units::SYSTEMS.keys.map { |k| [ t("sites.form.unit_systems.#{k}"), k ] }, label: t("sites.form.unit_system") %>
  <div class="grid grid-cols-2 gap-2">
    <%= f.ss_text_field :currency, label: t("sites.form.currency"), class: "uppercase", maxlength: 3, placeholder: "BRL" %>
    <%= f.ss_number_field :elevation, label: t("sites.form.elevation"), class: "num", min: -500, max: 9000, placeholder: "1100" %>
  </div>
  <%= f.ss_text_field :country, label: t("sites.form.country"), class: "uppercase", maxlength: 2, placeholder: "BR" %>
  <%= f.ss_select :language, [ [ "Português (Brasil)", "pt-BR" ], [ "English", "en" ], [ "Español", "es" ] ], label: t("sites.form.language"), include_blank: t("sites.form.language_blank") %>
  <small class="ss-field-help md:col-span-2 -mt-2"><%= t("sites.form.units_hint") %></small>
  <div class="md:col-span-2 flex flex-wrap gap-2"><%= yield f %></div>
<% end %>
