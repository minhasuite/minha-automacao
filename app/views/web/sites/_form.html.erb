<%# locals: (site:) -%>
<%= form_with model: site, class: "ss-card ss-card-pad grid gap-4 md:grid-cols-2 max-w-3xl" do |f| %>
  <%= render "web/shared/errors", record: site %>
  <div class="md:col-span-2"><%= f.label :name, "Nome", class: "ss-label" %><%= f.text_field :name, class: "ss-input", required: true, placeholder: "Casa da praia", autofocus: true %></div>
  <div><%= f.label :kind, "Tipo", class: "ss-label" %><%= f.select :kind, Site::KINDS.invert, {}, class: "ss-input" %></div>
  <div><%= f.label :address, "Endereço", class: "ss-label" %><%= f.text_field :address, class: "ss-input", placeholder: "Opcional" %></div>
  <div class="md:col-span-2 flex flex-wrap gap-2">
    <%= f.submit site.new_record? ? "Criar local" : "Salvar local", class: "ss-btn ss-btn-primary" %>
    <%= link_to "Cancelar", site.new_record? ? sites_path : site, class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
