<%# locals: (site:) -%>
<%= form_with model: site, class: "ss-card ss-card-pad grid gap-4 md:grid-cols-2 max-w-3xl" do |f| %>
  <%= render "web/shared/errors", record: site %>
  <div class="md:col-span-2"><%= f.label :name, t("sites.form.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", required: true, placeholder: t("sites.form.name_hint"), autofocus: true %></div>
  <div><%= f.label :kind, t("sites.form.kind"), class: "ss-label" %><%= f.select :kind, Site::KINDS.invert, {}, class: "ss-input" %></div>
  <div><%= f.label :address, t("sites.form.address"), class: "ss-label" %><%= f.text_field :address, class: "ss-input", placeholder: t("shared.optional") %></div>
  <div><%= f.label :timezone, t("sites.form.timezone"), class: "ss-label" %><%= f.select :timezone, ActiveSupport::TimeZone::MAPPING.values.uniq.sort, {}, class: "ss-input" %></div>
  <div class="grid grid-cols-2 gap-2">
    <div><%= f.label :latitude, t("sites.form.latitude"), class: "ss-label" %><%= f.number_field :latitude, step: "any", min: -90, max: 90, class: "ss-input num", placeholder: "-15.79" %></div>
    <div><%= f.label :longitude, t("sites.form.longitude"), class: "ss-label" %><%= f.number_field :longitude, step: "any", min: -180, max: 180, class: "ss-input num", placeholder: "-47.88" %></div>
  </div>
  <p class="md:col-span-2 -mt-2 text-xs text-muted"><%= t("sites.form.coords_hint") %></p>
  <div><%= f.label :unit_system, t("sites.form.unit_system"), class: "ss-label" %><%= f.select :unit_system, Units::SYSTEMS.keys.map { |k| [ t("sites.form.unit_systems.#{k}"), k ] }, {}, class: "ss-input" %></div>
  <div class="grid grid-cols-2 gap-2">
    <div><%= f.label :currency, t("sites.form.currency"), class: "ss-label" %><%= f.text_field :currency, class: "ss-input uppercase", maxlength: 3, placeholder: "BRL" %></div>
    <div><%= f.label :elevation, t("sites.form.elevation"), class: "ss-label" %><%= f.number_field :elevation, class: "ss-input num", min: -500, max: 9000, placeholder: "1100" %></div>
  </div>
  <div><%= f.label :country, t("sites.form.country"), class: "ss-label" %><%= f.text_field :country, class: "ss-input uppercase", maxlength: 2, placeholder: "BR" %></div>
  <div><%= f.label :language, t("sites.form.language"), class: "ss-label" %><%= f.select :language, [ [ "Português (Brasil)", "pt-BR" ], [ "English", "en" ], [ "Español", "es" ] ], { include_blank: t("sites.form.language_blank") }, class: "ss-input" %></div>
  <p class="md:col-span-2 -mt-2 text-xs text-muted"><%= t("sites.form.units_hint") %></p>
  <div class="md:col-span-2 flex flex-wrap gap-2">
    <%= f.submit site.new_record? ? t("sites.form.create") : t("sites.form.save"), class: "ss-btn ss-btn-primary" %>
    <%= link_to t("shared.cancel"), site.new_record? ? sites_path : site, class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
