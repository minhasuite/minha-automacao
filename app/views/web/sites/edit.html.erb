<%= render "web/shared/header", title: t("sites.edit.title"), subtitle: @site.name, back: site_path(@site) %>
<%= render "web/sites/form", site: @site %>
<section class="ss-card ss-card-pad mt-4 max-w-3xl">
  <h2><%= t("sites.edit.delete") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("sites.edit.delete_hint") %></p>
  <%= button_to site_path(@site), method: :delete, class: "ss-btn ss-btn-danger mt-3", form: { data: { turbo_confirm: t("sites.edit.delete_confirm", name: @site.name) } } do %><%= icon("trash", "size-4") %><%= t("sites.edit.delete") %><% end %>
</section>
