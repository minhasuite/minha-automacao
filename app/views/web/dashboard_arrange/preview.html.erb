<%= render "web/shared/header", title: t("arrange.preview.title", name: @view["title"]), subtitle: t("arrange.preview.subtitle"), back: edit_dashboard_path(@dashboard, view: @view["id"]) do %>
  <% unless @same %>
    <%= button_to arrange_dashboard_path(@dashboard), params: { view: @view["id"] }, class: "ss-btn ss-btn-primary" do %><%= icon("check", "size-4") %><%= t("arrange.preview.apply") %><% end %>
  <% end %>
<% end %>
<% if @same %>
  <%= render Ss::NoteComponent.new(text: t("arrange.preview.same"), icon: icon("check", ""), css: "mb-4") %>
<% end %>
<%= render "web/dashboard_arrange/diff", diff: @diff, before_label: t("arrange.diff.before"), after_label: t("arrange.diff.after") %>
<p class="text-sm text-muted mt-4"><%= t("arrange.preview.hint") %> <%= link_to t("arrange.tools.rules"), settings_arrange_rules_path(@site) %></p>
