<%= render "web/shared/header", title: t("arrange.changes.title", name: @dashboard.name), subtitle: t("arrange.changes.subtitle"), back: edit_dashboard_path(@dashboard, view: @focus) do %>
  <% if @dashboard.draft? %>
    <%= render Ss::ButtonComponent.new(label: t("dashboards.ed.discard"), href: discard_dashboard_path(@dashboard), method: :post, variant: :ghost, confirm: t("dashboards.ed.discard_confirm")) %>
    <%= render Ss::ButtonComponent.new(label: t("dashboards.publish"), icon: icon("upload", ""), href: publish_dashboard_path(@dashboard), method: :post,
                                       confirm: t("dashboards.ed.publish_confirm"), confirm_button: t("dashboards.publish")) %>
  <% end %>
<% end %>
<% if @same %>
  <%= render Ss::NoteComponent.new(text: t("arrange.changes.same"), icon: icon("check", ""), css: "mb-4") %>
<% end %>
<%= render "web/dashboard_arrange/diff", diff: @diff.reject { _1.status == :same && _1.id != @focus }, before_label: t("arrange.diff.published"), after_label: t("arrange.diff.draft") %>
