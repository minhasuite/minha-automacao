<%# locals: (integration:) -%>
<%= ss_form_with scope: :integration, url: connect_integration_path(integration), method: :post do |f| %>
  <%= f.hidden_field :test, value: "1" %>
  <%= render Ss::ButtonComponent.new(label: t("integrations.common.send_test"), icon: icon("speakerphone", ""), type: :submit, variant: :outline, class: "w-fit", submitting: t("integrations.common.sending")) %>
<% end %>
