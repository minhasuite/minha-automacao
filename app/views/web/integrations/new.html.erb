<%= render "web/shared/header", title: t("integrations.new.title", name: @plugin.title), subtitle: @plugin.description, back: site_integrations_path(@site, anchor: "adicionar") %>
<%= render layout: "web/integrations/wizard", locals: { current: 0 } do %>
<% if @plugin.discovers? %>
  <%# Pacote 1: descoberta na rede (mDNS ou a do plugin). Só lista; "Usar" preenche o endereço do formulário. %>
  <section class="ss-card ss-card-pad grid gap-3 max-w-2xl mb-4" aria-labelledby="na-rede">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="min-w-0">
        <h2 id="na-rede" class="font-bold text-ink"><%= t("integrations.new.lan") %></h2>
        <p class="text-sm text-muted"><%= t("integrations.new.lan_hint") %></p>
      </div>
      <%= link_to new_site_integration_path(@site, tipo: @plugin.key, procurar: 1), class: "ss-btn ss-btn-outline ss-btn-sm" do %><%= icon("search", "size-4") %><%= t("integrations.new.search_lan") %><% end %>
    </div>
    <% if @found %>
      <% if @found.empty? %>
        <p class="text-sm text-muted" role="status"><%= t("integrations.new.none_found") %></p>
      <% else %>
        <ul class="ss-rows is-compact rounded-xl bg-field" role="list">
          <% @found.each do |s| %>
            <li class="justify-between">
              <span class="min-w-0"><span class="font-semibold text-ink"><%= s["txt"]["friendly_name"].presence || s["txt"]["fn"].presence || s["name"] %></span>
                <span class="block text-xs text-muted num"><%= [ s["host"], s["port"] ].compact.join(":") %><%= " · #{s['txt']['md'] || s['txt']['app'] || s['txt']['board']}" if s["txt"].values_at("md", "app", "board").any?(&:present?) %></span></span>
              <%= link_to t("integrations.new.use"), new_site_integration_path(@site, tipo: @plugin.key, host: s["host"], port: s["port"], nome: s["txt"]["friendly_name"].presence || s["txt"]["fn"].presence || s["name"]), class: "ss-btn ss-btn-ghost ss-btn-sm" %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </section>
<% end %>
<%= ss_form_with scope: :integration, url: site_integrations_path(@site, tipo: @plugin.key), multipart: true, class: "ss-card ss-card-pad grid gap-4 max-w-2xl",
              data: { turbo_submits_with: t("integrations.common.connecting") } do |f| %>
  <%= render integration_form_partial(@plugin), f: f, integration: nil %>
  <div class="flex flex-wrap gap-2">
    <%= f.ss_submit t("integrations.common.continue"), data: { turbo_submits_with: t("integrations.common.connecting") } %>
    <%= link_to t("integrations.common.cancel"), site_integrations_path(@site), class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
<% end %>
