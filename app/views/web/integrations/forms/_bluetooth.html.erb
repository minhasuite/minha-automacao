<%# locals: (f:, integration:) -%>
<% if integration.nil? %>
  <div><%= f.label :name, t("integrations.forms.common.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", placeholder: Integrations::BluetoothPlugin.title, maxlength: 80 %></div>
<% end %>
<div>
  <%= f.label :bindkeys, t("protocols.ble.bindkeys"), class: "ss-label" %>
  <%= f.password_field :bindkeys, class: "ss-input font-mono text-sm", autocomplete: "new-password", value: nil, placeholder: integration ? t("integrations.forms.common.keep") : t("protocols.ble.bindkeys_hint") %>
</div>
<p class="text-xs text-muted"><%= t("protocols.ble.note_html") %></p>
