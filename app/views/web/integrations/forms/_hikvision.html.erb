<%# locals: (f:, integration:) -%>
<% s = integration&.settings || {} %>
<div class="grid gap-4 md:grid-cols-2">
  <div><%= f.label :host, t("integrations.forms.hikvision.host"), class: "ss-label" %><%= f.text_field :host, class: "ss-input num", required: integration.nil?, value: s["host"], placeholder: "192.168.0.10", inputmode: "decimal" %></div>
  <div><%= f.label :http_port, t("integrations.forms.hikvision.http_port"), class: "ss-label" %><%= f.number_field :http_port, class: "ss-input num", value: s["http_port"], placeholder: "80" %></div>
  <div><%= f.label :username, t("integrations.forms.common.username"), class: "ss-label" %><%= f.text_field :username, class: "ss-input", required: integration.nil?, value: s["username"], autocomplete: "off" %></div>
  <div><%= f.label :password, t("integrations.forms.common.password"), class: "ss-label" %><%= f.password_field :password, class: "ss-input", required: integration.nil?, autocomplete: "new-password", placeholder: (integration ? t("integrations.forms.common.keep_short") : nil) %></div>
</div>
<p class="text-xs text-muted"><%= t("integrations.forms.hikvision.help") %></p>
