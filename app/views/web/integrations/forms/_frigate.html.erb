<%# locals: (f:, integration:) -%>
<% s = integration&.settings || {} %>
<% if integration.nil? %>
  <div><%= f.label :name, t("integrations.forms.common.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", placeholder: "Frigate", maxlength: 80 %></div>
<% end %>
<div>
  <%= f.label :url, t("integrations.forms.frigate.url"), class: "ss-label" %>
  <%= f.text_field :url, class: "ss-input font-mono text-sm", value: s["url"], placeholder: "http://192.168.0.10:5000", autocomplete: "off", spellcheck: false %>
</div>
<div>
  <%= f.label :topic, t("integrations.forms.frigate.topic"), class: "ss-label" %>
  <%= f.text_field :topic, class: "ss-input font-mono text-sm", value: s["topic"], placeholder: "frigate", autocomplete: "off", spellcheck: false %>
</div>
<p class="text-xs text-muted"><%= t("integrations.forms.frigate.help_html") %></p>
