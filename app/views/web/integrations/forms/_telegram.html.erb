<%# locals: (f:, integration:) -%>
<% s = integration&.settings || {} %>
<% if integration.nil? %>
  <div><%= f.label :name, t("integrations.forms.common.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", placeholder: "Telegram", maxlength: 80 %></div>
<% end %>
<div>
  <%= f.label :token, t("integrations.forms.telegram.token"), class: "ss-label" %>
  <%= f.password_field :token, class: "ss-input", autocomplete: "off", value: nil, required: integration.nil?, placeholder: integration ? t("integrations.forms.common.keep") : "123456:ABC..." %>
  <p class="text-xs text-muted mt-1"><%= t("integrations.forms.telegram.token_hint") %></p>
</div>
<% if integration %>
  <div><%= f.label :chat_id, t("integrations.forms.telegram.chat"), class: "ss-label" %><%= f.text_field :chat_id, value: s["chat_id"], class: "ss-input num", placeholder: t("integrations.forms.telegram.chat_hint") %></div>
  <label class="ss-check"><%= f.check_box :webhook, { checked: s["webhook"] == true }, "1", "0" %><%= t("integrations.forms.telegram.webhook") %></label>
  <p class="text-xs text-muted"><%= t("integrations.forms.telegram.webhook_hint") %></p>
<% end %>
