<%# locals: (f:, integration:) -%>
<% s = integration&.settings || {} %>
<% if integration.nil? %>
  <div><%= f.ss_text_field :name, label: t("integrations.forms.common.name"), placeholder: "Telegram", maxlength: 80 %></div>
<% end %>
<div>
  <%= f.ss_password_field :token, label: t("integrations.forms.telegram.token"), autocomplete: "off", value: nil, required: integration.nil?, placeholder: integration ? t("integrations.forms.common.keep") : "123456:ABC..." %>
  <p class="text-xs text-muted mt-1"><%= t("integrations.forms.telegram.token_hint") %></p>
</div>
<% if integration %>
  <div><%= f.ss_text_field :chat_id, label: t("integrations.forms.telegram.chat"), value: s["chat_id"], class: "num", placeholder: t("integrations.forms.telegram.chat_hint") %></div>
  <label class="ss-check"><%= f.check_box :webhook, { checked: s["webhook"] == true }, "1", "0" %><%= t("integrations.forms.telegram.webhook") %></label>
  <p class="text-xs text-muted"><%= t("integrations.forms.telegram.webhook_hint") %></p>
<% end %>
