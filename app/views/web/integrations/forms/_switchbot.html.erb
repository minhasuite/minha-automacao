<%# locals: (f:, integration:) -%>
<% if integration.nil? %>
  <div><%= f.label :name, "Nome", class: "ss-label" %><%= f.text_field :name, class: "ss-input", placeholder: "SwitchBot", maxlength: 80 %></div>
<% end %>
<div>
  <%= f.label :token, "Token", class: "ss-label" %>
  <%= f.password_field :token, class: "ss-input font-mono text-sm", autocomplete: "new-password", value: nil, placeholder: integration ? "Deixe vazio para manter o guardado" : "do app SwitchBot" %>
</div>
<div>
  <%= f.label :secret, "Segredo (secret key)", class: "ss-label" %>
  <%= f.password_field :secret, class: "ss-input font-mono text-sm", autocomplete: "new-password", value: nil, placeholder: integration ? "Deixe vazio para manter o guardado" : "do app SwitchBot" %>
</div>
<p class="text-xs text-muted">No app SwitchBot: Perfil → Preferências → toque 10 vezes em "Versão do app" → Opções de desenvolvedor. O estado é lido a cada 5 min (limite da conta) e o comando vai pela nuvem da SwitchBot.</p>
