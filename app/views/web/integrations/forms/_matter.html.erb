<%# locals: (f:, integration:) -%>
<% s = integration&.settings || {} %>
<% if integration.nil? %>
  <%= f.ss_text_field :name, label: t("integrations.forms.common.name"), placeholder: "Matter", maxlength: 80 %>
<% end %>
<%= f.ss_text_field :url, label: t("integrations.forms.matter.url"), class: "font-mono text-sm", value: s["url"], placeholder: "ws://192.168.0.10:5580/ws", autocomplete: "off", spellcheck: false %>
<%= f.ss_text_field :code, label: t("integrations.forms.matter.code"), class: "font-mono text-sm", value: nil, placeholder: t("integrations.forms.matter.code_hint"), autocomplete: "off", spellcheck: false %>
<%= render(Ss::CalloutComponent.new) { t("integrations.forms.matter.help_html") } %>
