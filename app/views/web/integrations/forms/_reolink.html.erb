<%# locals: (f:, integration:) -%>
<% keep = integration && t("integrations.forms.common.keep") %>
<%= render layout: "web/integrations/forms/lan", locals: { f: f, integration: integration, plugin: Integrations::ReolinkPlugin } do %>
  <%= f.ss_text_field :username, label: t("integrations.forms.common.username"), value: params[:username].presence || integration&.settings&.dig("username"), placeholder: "admin", autocomplete: "off", spellcheck: false %>
  <%= f.ss_password_field :password, label: t("integrations.forms.common.password"), help: t("integrations.forms.reolink.password_hint"), class: "font-mono text-sm", autocomplete: "new-password", value: nil, placeholder: keep %>
<% end %>
