<%# locals: (f:, integration:) -%>
<% s = integration&.settings || {} %>
<% site = integration&.site || @site %>
<% if integration.nil? %>
  <div><%= f.ss_text_field :name, label: t("integrations.forms.common.name"), placeholder: t("integrations.forms.weather.name_hint"), maxlength: 80 %></div>
<% end %>
<div>
  <%= f.ss_select :provider, options_for_select(Weather.choices.invert, s["provider"]), label: t("integrations.forms.weather.provider") %>
</div>
<% if Weather.providers.any?(&:needs_key) %>
  <div>
    <%= f.ss_password_field :api_key, label: t("integrations.forms.weather.api_key"), autocomplete: "off", value: nil, placeholder: integration ? t("integrations.forms.weather.keep") : "" %>
  </div>
<% end %>
<fieldset class="grid grid-cols-2 gap-2">
  <legend class="ss-label"><%= t("integrations.forms.weather.location") %> <span class="font-normal">(<%= t("integrations.forms.weather.location_blank") %><%= ": #{site.latitude}, #{site.longitude}" if site&.latitude && site&.longitude %>)</span></legend>
  <%= f.ss_text_field :latitude, label: "Latitude", value: s["latitude"], class: "num", inputmode: "decimal", placeholder: "-12,345678" %>
  <%= f.ss_text_field :longitude, label: "Longitude", value: s["longitude"], class: "num", inputmode: "decimal", placeholder: "-45,678901" %>
</fieldset>
<p class="text-xs text-muted"><%= t("integrations.forms.weather.help") %></p>
