<%# locals: (f:, integration:) -%>
<% keep = integration && t("integrations.forms.common.keep") %>
<%= render layout: "web/integrations/forms/lan", locals: { f: f, integration: integration, plugin: Integrations::SunspecPlugin } do %>
  <%= f.ss_text_field :unit, label: t("integrations.forms.sunspec.unit"), value: params[:unit].presence || integration&.settings&.dig("unit"), placeholder: "1", autocomplete: "off", spellcheck: false %>
<% end %>
