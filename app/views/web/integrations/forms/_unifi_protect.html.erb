<%# locals: (f:, integration:) -%>
<% keep = integration && t("integrations.forms.common.keep") %>
<%= render layout: "web/integrations/forms/lan", locals: { f: f, integration: integration, plugin: Integrations::UnifiProtectPlugin } do %>
  <%= f.ss_text_field :username, label: t("integrations.forms.unifi_protect.username"), help: t("integrations.forms.unifi_protect.username_hint"), value: params[:username].presence || integration&.settings&.dig("username"), autocomplete: "off", spellcheck: false %>
  <%= f.ss_password_field :password, label: t("integrations.forms.common.password"), class: "font-mono text-sm", autocomplete: "new-password", value: nil, placeholder: keep %>
<% end %>
