<%# locals: (f:, integration:) -%>
<p class="text-sm text-ink-2"><%= t("integrations.forms.home_assistant.intro") %></p>
<div>
  <%= f.ss_url_field :url, label: t("integrations.forms.home_assistant.url"), value: integration&.settings&.dig("url"), placeholder: "http://192.168.0.10:8123", required: integration.nil? %>
</div>
<div>
  <%= f.ss_password_field :token, label: t("integrations.forms.home_assistant.token"), autocomplete: "off", value: nil, placeholder: (integration ? t("integrations.forms.common.keep") : ""), required: integration.nil? %>
</div>
<p class="text-xs text-muted"><%= t("integrations.forms.home_assistant.note") %></p>
