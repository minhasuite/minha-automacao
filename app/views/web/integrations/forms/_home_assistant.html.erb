<%# locals: (f:, integration:) -%>
<%= render(Ss::CalloutComponent.new) { t("integrations.forms.home_assistant.intro") } %>
<%= f.ss_url_field :url, label: t("integrations.forms.home_assistant.url"), value: integration&.settings&.dig("url"), placeholder: "http://192.168.0.10:8123", required: integration.nil? %>
<%= f.ss_password_field :token, label: t("integrations.forms.home_assistant.token"), help: t("integrations.forms.home_assistant.note"), autocomplete: "off", value: nil,
                        placeholder: (integration ? t("integrations.forms.common.keep") : ""), required: integration.nil? %>
