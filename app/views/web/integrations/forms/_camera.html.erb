<%# locals: (f:, integration:) -%>
<% s = integration&.settings || {} %>
<% mode = s["mode"] || "rtsp" %>
<% if integration.nil? %>
  <% hint = ->(text, note) { safe_join([text, " ", tag.span("— #{note}", class: "text-muted text-sm")]) } %>
  <%= f.ss_radio_buttons :mode, [[hint.call(t("integrations.forms.camera.rtsp"), t("integrations.forms.camera.rtsp_hint")), "rtsp"],
                                 [hint.call("ONVIF", t("integrations.forms.camera.onvif_hint")), "onvif"]],
                         label: t("integrations.forms.camera.how"), checked: "rtsp", inline: false %>
  <div><%= f.ss_text_field :name, label: t("integrations.forms.common.name"), placeholder: t("integrations.forms.camera.name_hint"), maxlength: 80 %></div>
<% end %>
<div class="grid gap-4 md:grid-cols-2">
  <% if integration.nil? || mode == "rtsp" %>
    <%= f.ss_text_field :url, label: "#{t("integrations.forms.camera.rtsp")}#{" (#{t("integrations.forms.camera.rtsp_mode")})" if integration.nil?}",
                        class: "font-mono text-sm", autocomplete: "off", spellcheck: false, value: nil, wrapper_class: "md:col-span-2",
                        placeholder: integration ? t("integrations.forms.camera.keep_url") : "rtsp://192.168.0.20:554/stream2" %>
  <% end %>
  <% if integration.nil? || mode == "onvif" %>
    <div><%= f.ss_text_field :host, label: "#{t("integrations.forms.camera.ip")}#{" (#{t("integrations.forms.camera.onvif_mode")})" if integration.nil?}", class: "num", value: s["host"], placeholder: "192.168.0.20", inputmode: "decimal" %></div>
    <div><%= f.ss_number_field :onvif_port, label: t("integrations.forms.camera.onvif_port"), class: "num", value: s["onvif_port"], placeholder: t("integrations.forms.camera.onvif_port_hint") %></div>
  <% end %>
  <div><%= f.ss_text_field :username, label: t("integrations.forms.common.username"), value: s["username"], autocomplete: "off" %></div>
  <div><%= f.ss_password_field :password, label: t("integrations.forms.common.password"), autocomplete: "new-password", placeholder: (integration ? t("integrations.forms.common.keep_short") : nil) %></div>
</div>
<p class="text-xs text-muted"><%= t("integrations.forms.camera.help") %></p>
