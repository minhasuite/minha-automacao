<%# locals: (f:, integration:) -%>
<% keep = integration && t("integrations.forms.common.keep") %>
<%= render layout: "web/integrations/forms/lan", locals: { f: f, integration: integration, plugin: Integrations::DirigeraPlugin } do %>
