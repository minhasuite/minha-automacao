<%# locals: (f:, integration:) -%>
<% s = integration&.settings || {} %>
<% if integration.nil? %>
  <div><%= f.label :name, t("integrations.forms.common.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", placeholder: t("integrations.forms.network_tracker.name_hint"), maxlength: 80 %></div>
<% end %>
<div>
  <%= f.label :hosts, t("integrations.forms.network_tracker.hosts"), class: "ss-label" %>
  <%= f.text_area :hosts, value: Integrations::NetworkTrackerPlugin.hosts_text(integration), rows: 4, class: "ss-input num", required: true, placeholder: t("integrations.forms.network_tracker.hosts_hint") %>
</div>
<div class="grid gap-3 sm:grid-cols-3">
  <div><%= f.label :method, t("integrations.forms.network_tracker.method"), class: "ss-label" %><%= f.select :method, options_for_select(Integrations::NetworkTrackerPlugin.probes.invert, s["method"]), {}, class: "ss-input" %></div>
  <div><%= f.label :port, t("integrations.forms.network_tracker.port"), class: "ss-label" %><%= f.number_field :port, value: s["port"] || 80, min: 1, max: 65_535, class: "ss-input num" %></div>
  <div><%= f.label :consider_home, t("integrations.forms.network_tracker.away"), class: "ss-label" %><%= f.text_field :consider_home, value: helper_duration(s["consider_home_s"] || Integrations::NetworkTrackerPlugin::CONSIDER_HOME_S), class: "ss-input num", placeholder: "3m" %></div>
</div>
<p class="text-xs text-muted"><%= t("integrations.forms.network_tracker.help") %></p>
