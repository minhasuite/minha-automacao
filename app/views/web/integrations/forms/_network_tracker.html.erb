<%# locals: (f:, integration:) -%>
<% s = integration&.settings || {} %>
<% if integration.nil? %>
  <div><%= f.label :name, "Nome", class: "ss-label" %><%= f.text_field :name, class: "ss-input", placeholder: "Rastreador de rede", maxlength: 80 %></div>
<% end %>
<div>
  <%= f.label :hosts, "Endereços (um por linha: Nome = IP ou nome na rede)", class: "ss-label" %>
  <%= f.text_area :hosts, value: Integrations::NetworkTrackerPlugin.hosts_text(integration), rows: 4, class: "ss-input num", required: true, placeholder: "Celular da Ana = 192.168.0.23" %>
</div>
<div class="grid gap-3 sm:grid-cols-3">
  <div><%= f.label :method, "Como testar", class: "ss-label" %><%= f.select :method, options_for_select(Integrations::NetworkTrackerPlugin.probes.invert, s["method"]), {}, class: "ss-input" %></div>
  <div><%= f.label :port, "Porta (TCP)", class: "ss-label" %><%= f.number_field :port, value: s["port"] || 80, min: 1, max: 65_535, class: "ss-input num" %></div>
  <div><%= f.label :consider_home, "Fora depois de", class: "ss-label" %><%= f.text_field :consider_home, value: helper_duration(s["consider_home_s"] || Integrations::NetworkTrackerPlugin::CONSIDER_HOME_S), class: "ss-input num", placeholder: "3m" %></div>
</div>
<p class="text-xs text-muted">Só lê: um teste por endereço a cada minuto. Cada endereço vira um aparelho com o ponto "Conectado", que serve de fonte para uma Pessoa (Helpers → Pessoa). Celular dorme e some da rede: por isso "fora" só depois do tempo acima sem resposta. Dê IP fixo ao celular no roteador.</p>
