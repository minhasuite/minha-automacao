<%# locals: (f:, integration:, plugin: @plugin) -%>
<%# Pacote 1: formulário comum dos aparelhos da rede (LanPlugin): nome, endereço e porta. O plugin com segredo ou campo
    próprio tem a partial dele, que usa esta como layout e põe os campos no bloco (segredo vazio no Reconfigurar mantém
    o guardado); a nota `integrations.forms.<key>.note` sai num aviso no fim. %>
<% s = integration&.settings || {} %>
<% if integration.nil? %>
  <%= f.ss_text_field :name, label: t("integrations.forms.common.name"), value: params[:nome], placeholder: plugin.title, maxlength: 80 %>
<% end %>
<div class="grid gap-4 grid-cols-[1fr_7rem]">
  <%= f.ss_text_field :host, label: t("integrations.forms.common.host"), class: "num", value: params[:host].presence || s["host"], placeholder: "192.168.0.50", autocomplete: "off", spellcheck: false %>
  <%= f.ss_number_field :port, label: t("integrations.forms.common.port"), class: "num", value: params[:port].presence || s["port"], placeholder: plugin.port&.to_s %>
</div>
<%= yield %>
<% if (note = t("integrations.forms.#{plugin.key}.note", default: "")).present? %>
  <%= render(Ss::CalloutComponent.new) { note } %>
<% end %>
