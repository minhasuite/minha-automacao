<%# locals: (f:, integration:, plugin:, fields: [], plain: [], note: nil) -%>
<%# Pacote 1: formulário comum dos aparelhos da rede (LanPlugin): nome, endereço, porta e os segredos do plugin.
    fields: [[campo, rótulo, dica]] guardados cifrados; vazio no Reconfigurar mantém o guardado. %>
<% s = integration&.settings || {} %>
<% if integration.nil? %>
  <div><%= f.label :name, t("integrations.forms.common.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", value: params[:nome], placeholder: plugin.title, maxlength: 80 %></div>
<% end %>
<div class="grid gap-4 grid-cols-[1fr_7rem]">
  <div><%= f.label :host, t("integrations.forms.common.host"), class: "ss-label" %><%= f.text_field :host, class: "ss-input num", value: params[:host].presence || s["host"], placeholder: "192.168.0.50", autocomplete: "off", spellcheck: false %></div>
  <div><%= f.label :port, t("integrations.forms.common.port"), class: "ss-label" %><%= f.number_field :port, class: "ss-input num", value: params[:port].presence || s["port"], placeholder: plugin.port %></div>
</div>
<% plain.each do |key, label, hint| %>
  <div><%= f.label key, label, class: "ss-label" %><%= f.text_field key, class: "ss-input", value: params[key].presence || s[key.to_s], placeholder: hint, autocomplete: "off", spellcheck: false %></div>
<% end %>
<% fields.each do |key, label, hint| %>
  <div>
    <%= f.label key, label, class: "ss-label" %>
    <%= f.password_field key, class: "ss-input font-mono text-sm", autocomplete: "new-password", value: nil, placeholder: integration ? t("integrations.forms.common.keep") : hint %>
  </div>
<% end %>
<% if note %><p class="text-xs text-muted"><%= note %></p><% end %>
