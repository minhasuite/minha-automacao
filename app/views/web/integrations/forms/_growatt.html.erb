<%# locals: (f:, integration:) -%>
<% if integration.nil? %>
  <%= f.ss_text_field :name, label: t("integrations.forms.common.name"), placeholder: "Growatt", maxlength: 80 %>
<% end %>
<%= f.ss_password_field :token, label: t("integrations.forms.growatt.token"), help: t("integrations.forms.growatt.from"), class: "font-mono text-sm", autocomplete: "new-password", value: nil,
                        placeholder: (t("integrations.forms.common.keep") if integration) %>
<%= render(Ss::CalloutComponent.new) { t("integrations.forms.growatt.note") } %>
