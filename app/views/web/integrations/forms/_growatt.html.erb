<%# locals: (f:, integration:) -%>
<% if integration.nil? %>
  <div><%= f.label :name, t("integrations.forms.common.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", placeholder: "Growatt", maxlength: 80 %></div>
<% end %>
<div>
  <%= f.label :token, t("integrations.forms.growatt.token"), class: "ss-label" %>
  <%= f.password_field :token, class: "ss-input font-mono text-sm", autocomplete: "new-password", value: nil, placeholder: integration ? t("integrations.forms.common.keep") : t("integrations.forms.growatt.from") %>
</div>
<p class="text-xs text-muted"><%= t("integrations.forms.growatt.note") %></p>
