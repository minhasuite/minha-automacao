<%# locals: (f:, integration:) -%>
<% s = integration&.settings || {} %>
<% if integration.nil? %>
  <div><%= f.ss_text_field :name, label: t("integrations.forms.common.name"), value: params[:nome], placeholder: "HomeKit", maxlength: 80 %></div>
<% end %>
<div class="grid gap-4 grid-cols-[1fr_7rem]">
  <div><%= f.ss_text_field :host, label: t("integrations.forms.common.host"), class: "num", value: params[:host].presence || s["host"], placeholder: "192.168.0.60", autocomplete: "off", spellcheck: false %></div>
  <div><%= f.ss_number_field :port, label: t("integrations.forms.common.port"), class: "num", value: params[:port].presence || s["port"], placeholder: "80" %></div>
</div>
<div>
  <%= f.ss_text_field :code, label: t("protocols.homekit.code"), class: "font-mono num", inputmode: "numeric", autocomplete: "off", placeholder: integration ? t("protocols.homekit.code_keep") : "031-45-154" %>
</div>
<p class="text-xs text-muted"><%= t("protocols.homekit.note_html") %></p>
