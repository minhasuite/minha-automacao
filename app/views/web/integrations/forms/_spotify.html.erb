<%# locals: (f:, integration:) -%>
<% if integration.nil? %>
  <div><%= f.label :name, "Nome", class: "ss-label" %><%= f.text_field :name, class: "ss-input", placeholder: "Spotify", maxlength: 80 %></div>
<% end %>
<div><%= f.label :client_id, "Client ID", class: "ss-label" %><%= f.text_field :client_id, class: "ss-input font-mono text-sm", value: nil, autocomplete: "off", spellcheck: false,
                                                                 placeholder: integration ? "Deixe vazio para manter o guardado" : "" %></div>
<div><%= f.label :client_secret, "Client Secret", class: "ss-label" %><%= f.password_field :client_secret, class: "ss-input font-mono text-sm", value: nil, autocomplete: "new-password",
                                                                         placeholder: integration ? "Deixe vazio para manter o guardado" : "" %></div>
<p class="text-xs text-muted">Crie um app em developer.spotify.com/dashboard (Web API), cadastre a URI de retorno <strong class="font-mono"><%= integrations_oauth_callback_url %></strong> e copie o Client ID e o Client Secret para cá. Eles ficam guardados cifrados.</p>
