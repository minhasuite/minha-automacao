<%# locals: (f:, integration:) -%>
<% if integration.nil? %>
  <div><%= f.ss_text_field :name, label: t("integrations.forms.common.name"), placeholder: "Spotify", maxlength: 80 %></div>
<% end %>
<%= f.ss_text_field :client_id, label: "Client ID", class: "font-mono text-sm", value: nil, autocomplete: "off", spellcheck: false,
                                placeholder: integration ? t("integrations.forms.common.keep") : "" %>
<%= f.ss_password_field :client_secret, label: "Client Secret", class: "font-mono text-sm", value: nil, autocomplete: "new-password",
                                        placeholder: integration ? t("integrations.forms.common.keep") : "" %>
<p class="text-xs text-muted"><%= t("integrations.forms.spotify.help_html", uri: tag.strong(integrations_oauth_callback_url, class: "font-mono")) %></p>
