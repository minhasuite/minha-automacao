<%# locals: (f:, integration:) -%>
<% if integration.nil? %>
  <div><%= f.ss_text_field :name, label: t("integrations.forms.common.name"), placeholder: "Spotify", maxlength: 80 %></div>
<% end %>
<div><%= f.label :client_id, "Client ID", class: "ss-label" %><%= f.text_field :client_id, class: "ss-input font-mono text-sm", value: nil, autocomplete: "off", spellcheck: false,
                                                                 placeholder: integration ? t("integrations.forms.common.keep") : "" %></div>
<div><%= f.label :client_secret, "Client Secret", class: "ss-label" %><%= f.password_field :client_secret, class: "ss-input font-mono text-sm", value: nil, autocomplete: "new-password",
                                                                         placeholder: integration ? t("integrations.forms.common.keep") : "" %></div>
<p class="text-xs text-muted"><%= t("integrations.forms.spotify.help_html", uri: tag.strong(integrations_oauth_callback_url, class: "font-mono")) %></p>
