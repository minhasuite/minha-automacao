<%# locals: (f:, integration:) -%>
<%# catalogo: formulário gerado dos campos do plugin (SchemaPlugin.field); o app recebe o mesmo pela tela transcodificada. %>
<% plugin = @plugin %>
<% s = integration&.settings || {} %>
<% if integration.nil? %>
  <div><%= f.label :name, t("integrations.forms.common.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", value: params[:nome], placeholder: plugin.title, maxlength: 80 %></div>
<% end %>
<% plugin.fields.each do |fld| %>
  <% hint = plugin.field_hint(fld.key) %>
  <% value = params[fld.key].presence || s[fld.key].presence || fld.default %>
  <div>
    <%= f.label fld.key, plugin.field_label(fld.key), class: "ss-label" %>
    <% case fld.type %>
    <% when :password %>
      <%= f.password_field fld.key, class: "ss-input font-mono text-sm", autocomplete: "new-password", value: nil, required: fld.required && integration.nil?,
                           placeholder: integration ? t("integrations.forms.common.keep") : hint.presence %>
    <% when :select %>
      <%= f.select fld.key, Array(fld.options).map { |o| [ plugin.option_label(fld.key, o), o ] }, { selected: value }, class: "ss-input" %>
    <% when :number %>
      <%= f.number_field fld.key, class: "ss-input num", value: value, step: "any", required: fld.required, placeholder: hint.presence %>
    <% else %>
      <%= f.text_field fld.key, class: "ss-input#{' num' if fld.key == 'host'}", value: value, required: fld.required, placeholder: hint.presence,
                       autocomplete: "off", spellcheck: false, inputmode: (fld.type == :url ? "url" : nil) %>
    <% end %>
  </div>
<% end %>
<% if plugin.note.present? %><p class="text-xs text-muted"><%= plugin.note %></p><% end %>
