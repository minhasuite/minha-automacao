<%# locals: (f:, integration:) -%>
<%# catalogo: formulário gerado dos campos do plugin (SchemaPlugin.field); o app recebe o mesmo pela tela transcodificada. %>
<% plugin = @plugin %>
<% s = integration&.settings || {} %>
<% if integration.nil? %>
  <div><%= f.ss_text_field :name, label: t("integrations.forms.common.name"), value: params[:nome], placeholder: plugin.title, maxlength: 80 %></div>
<% end %>
<% plugin.fields.each do |fld| %>
  <% hint = plugin.field_hint(fld.key) %>
  <% value = params[fld.key].presence || s[fld.key].presence || fld.default %>
  <% label = plugin.field_label(fld.key) %>
  <% if fld.type == :password %>
    <%= f.ss_password_field fld.key, label: label, class: "font-mono text-sm", autocomplete: "new-password", value: nil, required: fld.required && integration.nil?,
                            placeholder: integration ? t("integrations.forms.common.keep") : hint.presence %>
  <% elsif fld.type == :select %>
    <%= f.ss_select fld.key, Array(fld.options).map { |o| [ plugin.option_label(fld.key, o), o ] }, label: label, selected: value %>
  <% elsif fld.type == :textarea %>
    <%= f.ss_text_area fld.key, label: label, class: "font-mono text-sm", rows: 6, value: value, required: fld.required, placeholder: hint.presence, spellcheck: false %>
  <% elsif fld.type == :number %>
    <%= f.ss_number_field fld.key, label: label, class: "num", value: value, step: "any", required: fld.required, placeholder: hint.presence %>
  <% else %>
    <%= f.ss_text_field fld.key, label: label, class: ("num" if fld.key == "host"), value: value, required: fld.required, placeholder: hint.presence,
                        autocomplete: "off", spellcheck: false, inputmode: (fld.type == :url ? "url" : nil) %>
  <% end %>
<% end %>
<% if plugin.note.present? %><p class="text-xs text-muted"><%= plugin.note %></p><% end %>
