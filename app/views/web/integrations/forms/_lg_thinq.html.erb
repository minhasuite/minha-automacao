<%# locals: (f:, integration:) -%>
<% if integration.nil? %>
  <div><%= f.label :name, t("integrations.forms.common.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", placeholder: "LG ThinQ", maxlength: 80 %></div>
<% end %>
<div>
  <%= f.label :token, t("integrations.forms.lg_thinq.token"), class: "ss-label" %>
  <%= f.password_field :token, class: "ss-input font-mono text-sm", autocomplete: "new-password", value: nil, placeholder: integration ? t("integrations.forms.common.keep") : t("integrations.forms.lg_thinq.from") %>
</div>
<div><%= f.label :country, t("integrations.forms.lg_thinq.country"), class: "ss-label" %><%= f.text_field :country, class: "ss-input num w-24", value: integration&.settings&.dig("country") || "BR", maxlength: 2 %></div>
<p class="text-xs text-muted"><%= t("integrations.forms.lg_thinq.note") %></p>
