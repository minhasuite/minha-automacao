<%# locals: (f:, integration:) -%>
<% if integration.nil? %>
  <div><%= f.ss_text_field :name, label: t("integrations.forms.common.name"), placeholder: "LG ThinQ", maxlength: 80 %></div>
<% end %>
<div>
  <%= f.ss_password_field :token, label: t("integrations.forms.lg_thinq.token"), class: "font-mono text-sm", autocomplete: "new-password", value: nil, placeholder: integration ? t("integrations.forms.common.keep") : t("integrations.forms.lg_thinq.from") %>
</div>
<div><%= f.ss_text_field :country, label: t("integrations.forms.lg_thinq.country"), class: "num w-24", value: integration&.settings&.dig("country") || "BR", maxlength: 2 %></div>
<p class="text-xs text-muted"><%= t("integrations.forms.lg_thinq.note") %></p>
