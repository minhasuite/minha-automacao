<%# locals: (f:, integration:) -%>
<% if integration.nil? %>
  <div><%= f.label :name, "Nome", class: "ss-label" %><%= f.text_field :name, class: "ss-input", placeholder: "LG ThinQ", maxlength: 80 %></div>
<% end %>
<div>
  <%= f.label :token, "Token de acesso pessoal (PAT)", class: "ss-label" %>
  <%= f.password_field :token, class: "ss-input font-mono text-sm", autocomplete: "new-password", value: nil, placeholder: integration ? "Deixe vazio para manter o guardado" : "de connect-pat.lgthinq.com" %>
</div>
<div><%= f.label :country, "País da conta", class: "ss-label" %><%= f.text_field :country, class: "ss-input num w-24", value: integration&.settings&.dig("country") || "BR", maxlength: 2 %></div>
<p class="text-xs text-muted">Entre em connect-pat.lgthinq.com com a conta LG, crie um token com as permissões de ver e controlar aparelhos e cole aqui (fica cifrado). Os ACs da conta aparecem para adicionar; o estado é lido a cada 2 min.</p>
