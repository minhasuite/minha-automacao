<%# locals: (f:, integration:) -%>
<% keep = integration && t("integrations.forms.common.keep") %>
<%= render layout: "web/integrations/forms/lan", locals: { f: f, integration: integration, plugin: Integrations::EsphomePlugin } do %>
  <%= f.ss_password_field :encryption_key, label: t("integrations.forms.esphome.key"), help: t("integrations.forms.esphome.key_hint"), class: "font-mono text-sm", autocomplete: "new-password", value: nil, placeholder: keep %>
  <%= f.ss_password_field :password, label: t("integrations.forms.esphome.password"), class: "font-mono text-sm", autocomplete: "new-password", value: nil, placeholder: keep %>
<% end %>
