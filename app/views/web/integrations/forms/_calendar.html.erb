<%# locals: (f:, integration:) -%>
<% google = Calendars::Google.configured? %>
<% mode = integration&.settings&.dig("mode") || "ics" %>
<% if integration.nil? %>
  <%# Sem o Google configurado a opção some e o motivo vai na ajuda do grupo. %>
  <% hint = ->(text, note) { safe_join([text, " ", tag.span("— #{note}", class: "text-muted text-sm")]) } %>
  <% choices = [[hint.call(t("integrations.forms.calendar.ics"), t("integrations.forms.calendar.ics_hint")), "ics"]] %>
  <% choices << [hint.call(t("integrations.forms.calendar.google"), t("integrations.forms.calendar.google_on")), "google"] if google %>
  <%= f.ss_radio_buttons :mode, choices, label: t("integrations.forms.calendar.how"), checked: "ics", inline: false,
                         help: ("#{t("integrations.forms.calendar.google")} — #{t("integrations.forms.calendar.google_off")}" unless google) %>
  <div><%= f.ss_text_field :name, label: t("integrations.forms.common.name"), placeholder: t("integrations.forms.calendar.name_hint"), maxlength: 80 %></div>
<% end %>
<% if mode == "ics" %>
  <%= f.ss_text_area :urls, label: t("integrations.forms.calendar.urls"), rows: 3, class: "text-sm", autocomplete: "off", spellcheck: false, value: nil,
                     placeholder: integration ? t("integrations.forms.calendar.keep") : "https://calendar.google.com/calendar/ical/.../private-.../basic.ics" %>
  <p class="text-xs text-muted"><%= t("integrations.forms.calendar.ics_help_html") %></p>
<% else %>
  <p class="text-sm text-ink-2"><%= t("integrations.forms.calendar.google_help") %></p>
<% end %>
