<%# locals: (f:, integration:) -%>
<% google = Calendars::Google.configured? %>
<% mode = integration&.settings&.dig("mode") || "ics" %>
<% if integration.nil? %>
  <fieldset class="grid gap-2">
    <legend class="ss-label">Como ler a agenda</legend>
    <label class="ss-check"><%= f.radio_button :mode, "ics", checked: true %>Link iCal (.ics) <span class="text-muted text-sm">— funciona já, sem login</span></label>
    <label class="ss-check <%= 'opacity-60' unless google %>"><%= f.radio_button :mode, "google", disabled: !google %>Conta Google <span class="text-muted text-sm">— <%= google ? "entra com o Google e lê todas as agendas" : "precisa do cliente OAuth do Google no servidor (docs)" %></span></label>
  </fieldset>
  <div><%= f.label :name, "Nome", class: "ss-label" %><%= f.text_field :name, class: "ss-input", placeholder: "Agenda da família", maxlength: 80 %></div>
<% end %>
<% if mode == "ics" %>
  <div>
    <%= f.label :urls, "Links iCal (um por linha)", class: "ss-label" %>
    <%= f.text_area :urls, rows: 3, class: "ss-input text-sm", autocomplete: "off", spellcheck: false, value: nil,
                    placeholder: integration ? "Deixe vazio para manter os links guardados" : "https://calendar.google.com/calendar/ical/.../private-.../basic.ics" %>
  </div>
  <p class="text-xs text-muted">No Google Agenda (computador): Configurações → a agenda → Integrar agenda → <strong>Endereço secreto no formato iCal</strong>. O link dá acesso à agenda: ele fica guardado cifrado e nunca aparece de novo. Leitura a cada 15 min (mude em Intervalo no card).</p>
<% else %>
  <p class="text-sm text-ink-2">Conta Google: use o botão "Entrar com o Google" ao lado.</p>
<% end %>
