<%# locals: (f:, integration:) -%>
<% if integration.nil? %>
  <div><%= f.label :name, t("integrations.forms.common.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", placeholder: "Z-Wave JS", maxlength: 80 %></div>
<% end %>
<div>
  <%= f.label :url, t("integrations.forms.zwave_js.url"), class: "ss-label" %>
  <%= f.text_field :url, class: "ss-input num", value: integration&.settings&.dig("url"), placeholder: "ws://192.168.0.10:3000", autocomplete: "off", spellcheck: false %>
</div>
<p class="text-xs text-muted"><%= t("integrations.forms.zwave_js.note") %></p>
