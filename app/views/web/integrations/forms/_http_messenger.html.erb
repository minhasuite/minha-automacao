<%# locals: (f:, integration:) -%>
<% s = integration&.settings || {} %>
<% keep = integration ? t("integrations.forms.common.keep") : nil %>
<% if integration.nil? %>
  <div><%= f.ss_text_field :name, label: t("integrations.forms.common.name"), placeholder: t("integrations.forms.http_messenger.name_hint"), maxlength: 80 %></div>
<% end %>
<div class="grid grid-cols-[8rem_1fr] gap-2">
  <div><%= f.label :method, t("integrations.forms.http_messenger.method"), class: "ss-label" %><%= f.select :method, Integrations::HttpMessengerPlugin::METHODS, { selected: s["method"] || "POST" }, class: "ss-input" %></div>
  <div><%= f.ss_text_field :url, label: t("integrations.forms.http_messenger.url"), autocomplete: "off", value: nil, required: integration.nil?, placeholder: keep || "https://api.callmebot.com/whatsapp.php?phone=...&text={{ text | url_encode }}&apikey=..." %></div>
</div>
<div><%= f.ss_text_area :headers, label: t("integrations.forms.http_messenger.headers"), rows: 2, class: "font-mono text-sm", value: nil, placeholder: keep || t("integrations.forms.http_messenger.headers_hint") %></div>
<div><%= f.ss_text_area :body, label: t("integrations.forms.http_messenger.body"), rows: 4, class: "font-mono text-sm", value: nil, placeholder: keep || %({"number": "5585999999999", "text": {{ text | json }}}) %></div>
<p class="text-xs text-muted"><%= t("integrations.forms.http_messenger.help_html") %></p>
