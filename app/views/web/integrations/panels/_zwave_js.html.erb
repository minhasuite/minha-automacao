<%# locals: (integration:, plugin:, controller:, server:, nodes:, map:, provisioning:, inclusion:) -%>
<% act = ->(a) { panel_action_integration_path(integration, acao: a) } %>
<% devices = nodes.reject { |n| n["isControllerNode"] } %>
<% counts = devices.group_by { |n| ZwaveJs::STATUS.fetch(n["status"], "unknown") }.transform_values(&:size) %>
<% state = inclusion["state"] %>
<% classes = ZwaveJs::SECURITY_CLASSES %>

<section class="grid gap-3 grid-cols-2 xl:grid-cols-4" aria-label="<%= t("protocols.zwave.summary") %>">
  <div class="ss-card ss-card-pad">
    <p class="text-xs font-bold uppercase text-muted"><%= t("protocols.zwave.controller") %></p>
    <p class="mt-1 text-lg font-bold text-ink num"><%= controller["homeId"] ? format("%08X", controller["homeId"]) : "—" %></p>
    <p class="text-sm text-muted"><%= [ controller["manufacturer"], controller["type"] && t("protocols.zwave.sdk", v: controller["sdkVersion"]) ].compact.join(" · ").presence || "—" %></p>
  </div>
  <div class="ss-card ss-card-pad">
    <p class="text-xs font-bold uppercase text-muted"><%= t("protocols.zwave.nodes") %></p>
    <p class="mt-1 text-lg font-bold text-ink num"><%= devices.size %></p>
    <p class="text-sm text-muted"><%= t("protocols.zwave.node_counts", alive: counts.fetch("alive", 0) + counts.fetch("awake", 0), asleep: counts.fetch("asleep", 0), dead: counts.fetch("dead", 0)) %></p>
  </div>
  <div class="ss-card ss-card-pad">
    <p class="text-xs font-bold uppercase text-muted"><%= t("protocols.zwave.security") %></p>
    <p class="mt-1 text-lg font-bold text-ink num"><%= devices.count { |n| n["isSecure"] } %> / <%= devices.size %></p>
    <p class="text-sm text-muted"><%= t("protocols.zwave.secure_hint") %></p>
  </div>
  <div class="ss-card ss-card-pad">
    <p class="text-xs font-bold uppercase text-muted"><%= t("protocols.zwave.server") %></p>
    <p class="mt-1 text-lg font-bold text-ink num"><%= server["serverVersion"] || "—" %></p>
    <p class="text-sm text-muted"><%= t("protocols.zwave.driver", v: server["driverVersion"] || "—") %></p>
  </div>
</section>

<section class="ss-card ss-card-pad" aria-labelledby="zw-incl">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 id="zw-incl" class="font-bold text-ink"><%= t("protocols.zwave.inclusion") %></h2>
      <p class="text-sm text-muted mt-1 max-w-2xl"><%= t("protocols.zwave.inclusion_pitch") %></p>
    </div>
    <% if state.present? && !%w[done removed stopped failed].include?(state) %><span class="ss-badge ss-badge-accent"><%= icon("refresh", "size-3.5 animate-spin") %><%= t("protocols.zwave.states.#{state}", default: state) %></span><% end %>
  </div>

  <div class="mt-4" role="status" aria-live="polite">
    <% case state %>
    <% when "requested", "running", "stop" %>
      <div class="flex flex-wrap items-center gap-3">
        <p class="text-ink font-semibold"><%= inclusion["mode"] == "exclude" ? t("protocols.zwave.waiting_exclude") : t("protocols.zwave.waiting_include") %></p>
        <%= button_to t("protocols.zwave.stop"), act.call("stop"), class: "ss-btn ss-btn-outline ss-btn-sm" %>
      </div>
    <% when "grant" %>
      <%= form_with url: act.call("grant"), scope: :panel, class: "grid gap-3" do |f| %>
        <p class="text-ink font-semibold"><%= t("protocols.zwave.grant_title") %></p>
        <% Array(inclusion["requested"]).each do |c| %>
          <label class="flex items-start gap-2"><%= check_box_tag "panel[classes][]", c, true, id: "cls-#{c}", class: "mt-1" %><span><span class="font-semibold text-ink"><%= t("protocols.zwave.classes.#{classes.fetch(c.to_i, 'unknown')}") %></span><br><span class="text-sm text-muted"><%= t("protocols.zwave.classes_hint.#{classes.fetch(c.to_i, 'unknown')}") %></span></span></label>
        <% end %>
        <div class="flex gap-2"><%= f.submit t("protocols.zwave.grant"), class: "ss-btn ss-btn-primary" %></div>
      <% end %>
    <% when "dsk" %>
      <% groups = inclusion["dsk"].to_s.split("-") %>
      <%= form_with url: act.call("pin"), scope: :panel, class: "grid gap-3 max-w-xl" do |f| %>
        <p class="text-ink font-semibold"><%= t("protocols.zwave.dsk_title") %></p>
        <p class="font-mono text-lg tracking-wider text-ink num" aria-label="<%= t("protocols.zwave.dsk") %>"><span class="text-accent">•••••</span>-<%= groups.drop(1).join("-") %></p>
        <div><%= f.label :pin, t("protocols.zwave.pin"), class: "ss-label" %><%= f.text_field :pin, class: "ss-input num w-40 font-mono text-lg", inputmode: "numeric", pattern: "[0-9]{5}", maxlength: 5, autocomplete: "off", required: true %></div>
        <p class="text-xs text-muted"><%= t("protocols.zwave.pin_hint") %></p>
        <div><%= f.submit t("protocols.zwave.send_pin"), class: "ss-btn ss-btn-primary" %></div>
      <% end %>
    <% when "added" %>
      <p class="text-ink font-semibold"><%= t("protocols.zwave.added", node: inclusion["node"]) %></p>
      <% if inclusion["low_security"] %><p class="mt-1 text-sm text-warn"><%= t("protocols.zwave.low_security") %></p><% end %>
    <% when "done", "removed", "stopped", "failed" %>
      <div class="flex flex-wrap items-center gap-3">
        <p class="font-semibold <%= state == 'failed' ? 'text-danger' : 'text-ink' %>"><%= t("protocols.zwave.states.#{state}", node: inclusion["node"]) %><%= " #{inclusion['message']}" if state == "failed" && inclusion["message"] && reveal_sensitive? %></p>
        <% if state == "done" %><%= link_to t("protocols.zwave.see_found"), found_integration_path(integration), class: "ss-btn ss-btn-primary ss-btn-sm" %><% end %>
        <%= button_to t("protocols.zwave.dismiss"), act.call("dismiss"), class: "ss-btn ss-btn-ghost ss-btn-sm" %>
      </div>
    <% else %>
      <div class="grid gap-4 lg:grid-cols-2">
        <%= form_with url: act.call("include"), scope: :panel, class: "grid gap-3" do |f| %>
          <fieldset class="grid gap-2">
            <legend class="ss-label"><%= t("protocols.zwave.strategy") %></legend>
            <% %w[default s2 insecure].each_with_index do |s, i| %>
              <label class="flex items-start gap-2"><%= radio_button_tag "panel[strategy]", s, i.zero?, class: "mt-1" %><span><span class="font-semibold text-ink"><%= t("protocols.zwave.strategies.#{s}") %></span><br><span class="text-sm text-muted"><%= t("protocols.zwave.strategies_hint.#{s}") %></span></span></label>
            <% end %>
          </fieldset>
          <div class="flex flex-wrap gap-2">
            <%= f.button class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("protocols.zwave.include") %><% end %>
          </div>
        <% end %>
        <div class="grid gap-3 content-start">
          <%= form_with url: act.call("smart_start"), scope: :panel, class: "grid gap-2" do |f| %>
            <%= f.label :qr, t("protocols.zwave.smart_start"), class: "ss-label" %>
            <%= f.text_field :qr, class: "ss-input font-mono text-sm", inputmode: "numeric", placeholder: "9001234…", autocomplete: "off", spellcheck: false %>
            <p class="text-xs text-muted"><%= t("protocols.zwave.smart_start_hint") %></p>
            <div><%= f.submit t("protocols.zwave.provision"), class: "ss-btn ss-btn-outline ss-btn-sm" %></div>
          <% end %>
          <hr class="border-line">
          <div class="flex flex-wrap items-center gap-2">
            <%= button_to act.call("exclude"), class: "ss-btn ss-btn-outline ss-btn-sm", form: { data: { turbo_confirm: t("protocols.zwave.exclude_confirm") } } do %><%= icon("minus-circle", "size-4") %><%= t("protocols.zwave.exclude") %><% end %>
            <%= button_to act.call("rebuild_routes"), class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("share", "size-4") %><%= t("protocols.zwave.rebuild") %><% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</section>

<div class="grid gap-4 xl:grid-cols-5">
  <section class="ss-card ss-card-pad xl:col-span-2" aria-labelledby="zw-map">
    <h2 id="zw-map" class="font-bold text-ink"><%= t("protocols.zwave.map") %></h2>
    <p class="text-sm text-muted mt-1"><%= t("protocols.zwave.map_hint") %></p>
    <% pos = map[:nodes].index_by { |n| n[:id] } %>
    <svg viewBox="0 0 100 100" class="mt-3 w-full max-w-md mx-auto" role="img" aria-label="<%= t("protocols.zwave.map") %>">
      <% map[:edges].each do |a, b| %><% next unless pos[a] && pos[b] %>
        <line x1="<%= pos[a][:x] %>" y1="<%= pos[a][:y] %>" x2="<%= pos[b][:x] %>" y2="<%= pos[b][:y] %>" stroke="var(--line)" stroke-width="0.6" />
      <% end %>
      <% map[:nodes].each do |n| %>
        <% color = n[:controller] ? "var(--accent)" : { "dead" => "var(--danger)", "asleep" => "var(--muted)" }.fetch(n[:status], "var(--success)") %>
        <g><title><%= "#{n[:id]} · #{n[:name]} · #{t("protocols.zwave.status.#{n[:status]}")}" %></title>
          <circle cx="<%= n[:x] %>" cy="<%= n[:y] %>" r="<%= n[:controller] ? 5 : 3.6 %>" fill="<%= color %>" />
          <text x="<%= n[:x] %>" y="<%= n[:y] + 1.2 %>" text-anchor="middle" font-size="3" font-weight="700" fill="var(--bg, #fff)"><%= n[:id] %></text>
        </g>
      <% end %>
    </svg>
  </section>

  <section class="xl:col-span-3 grid gap-2 content-start" aria-labelledby="zw-nodes">
    <h2 id="zw-nodes" class="font-bold text-ink"><%= t("protocols.zwave.node_list") %></h2>
    <%= render Ss::DataTableComponent.new(rows: devices, id: "zw-node-table", caption: t("protocols.zwave.node_list"), row_id: "nodeId", tools: false,
                                          empty: t("protocols.zwave.no_nodes")) do |tb| %>
      <% tb.column :node, t("protocols.zwave.col_node") do |n| %>
        <span class="font-semibold text-ink"><%= n["name"].presence || n.dig("deviceConfig", "description") || t("protocols.zwave.node_n", n: n["nodeId"]) %></span><br><span class="text-xs text-muted num">#<%= n["nodeId"] %> · <%= [ n.dig("deviceConfig", "manufacturer"), n.dig("deviceConfig", "label") ].compact.join(" ") %></span>
      <% end %>
      <% tb.column :status, t("protocols.zwave.col_status") do |n| %>
        <% st = ZwaveJs::STATUS.fetch(n["status"], "unknown") %>
        <span class="ss-badge ss-badge-<%= { "dead" => "danger", "asleep" => "accent" }.fetch(st, "success") %>"><%= t("protocols.zwave.status.#{st}") %></span>
      <% end %>
      <% tb.column :security, t("protocols.zwave.col_security") do |n| %><%= n["isSecure"] ? t("protocols.zwave.classes.#{classes.fetch(n['highestSecurityClass'].to_i, 's2_unauthenticated')}") : t("protocols.zwave.insecure") %><% end %>
      <% tb.column :actions, t("protocols.zwave.col_actions"), align: :right, hideable: false do |n| %>
        <div class="inline-flex gap-1">
          <%= button_to act.call("reinterview"), params: { "panel[node]" => n["nodeId"] }, class: "ss-btn ss-btn-ghost ss-btn-sm", title: t("protocols.zwave.reinterview") do %><%= icon("refresh", "size-4") %><span class="sr-only"><%= t("protocols.zwave.reinterview") %></span><% end %>
          <% if ZwaveJs::STATUS.fetch(n["status"], "unknown") == "dead" %>
            <%= button_to act.call("remove_failed"), params: { "panel[node]" => n["nodeId"] }, class: "ss-btn ss-btn-ghost ss-btn-sm text-danger", title: t("protocols.zwave.remove_failed"), form: { data: { turbo_confirm_tone: "danger", turbo_confirm_button: t("shared.confirm.remove"), turbo_confirm: t("protocols.zwave.remove_failed_confirm", n: n["nodeId"]) } } do %><%= icon("trash", "size-4") %><span class="sr-only"><%= t("protocols.zwave.remove_failed") %></span><% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </section>
</div>

<% if provisioning.any? %>
  <section class="ss-card ss-card-pad" aria-labelledby="zw-ss">
    <h2 id="zw-ss" class="font-bold text-ink"><%= t("protocols.zwave.smart_start_list") %></h2>
    <ul class="mt-2 divide-y divide-line">
      <% provisioning.each do |e| %>
        <li class="py-2 flex items-center justify-between gap-3"><span class="font-mono text-sm num"><%= e["dsk"].to_s.split("-").first(2).join("-") %>-…</span>
          <%= button_to t("protocols.zwave.unprovision"), act.call("unprovision"), params: { "panel[dsk]" => e["dsk"] }, class: "ss-btn ss-btn-ghost ss-btn-sm" %></li>
      <% end %>
    </ul>
  </section>
<% end %>
