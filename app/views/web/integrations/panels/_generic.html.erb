<%# locals: (integration:, plugin:, stats: [], rows: [], actions: [], **) -%>
<% if stats.any? %>
  <section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <% stats.each do |label, value| %>
      <div class="ss-card ss-card-pad"><p class="text-xs font-bold uppercase text-muted"><%= label %></p><p class="mt-1 text-lg font-bold text-ink num break-words"><%= value.presence || "—" %></p></div>
    <% end %>
  </section>
<% end %>
<% if rows.any? %>
  <section class="ss-card ss-card-pad divide-y divide-line">
    <% rows.each do |label, value| %><div class="ss-value-row"><span><%= label %></span><b class="whitespace-normal break-words min-w-0 text-right"><%= value.presence || "—" %></b></div><% end %>
  </section>
<% end %>
<% if actions.any? %>
  <div class="flex flex-wrap gap-2">
    <% actions.each do |action, label| %><%= render Ss::ButtonComponent.new(label:, href: panel_action_integration_path(integration, acao: action), method: :post, variant: :outline) %><% end %>
  </div>
<% end %>
