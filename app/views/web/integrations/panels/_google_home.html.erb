<%# locals: (integration:, plugin:, project:, client_id:, has_secret:, redirect_uris:, service_account:, exposed:, links:) -%>
<% act = ->(a) { panel_action_integration_path(integration, acao: a) } %>
<% copy = lambda do |label, value| %>
  <div>
    <p class="ss-label"><%= label %></p>
    <div class="flex items-center gap-2" data-controller="clipboard">
      <input type="text" readonly value="<%= value %>" aria-label="<%= label %>" class="ss-input font-mono text-xs flex-1 min-w-0" data-clipboard-target="source">
      <button type="button" class="ss-btn ss-btn-ghost ss-btn-sm" data-action="clipboard#copy" title="<%= t("protocols.google.copy") %>"><%= icon("duplicate", "size-4") %><span class="sr-only"><%= t("protocols.google.copy") %></span></button>
    </div>
  </div>
<% end %>

<section class="grid gap-3 sm:grid-cols-3" aria-label="<%= t("protocols.google.summary") %>">
  <div class="ss-card ss-card-pad"><p class="text-xs font-bold uppercase text-muted"><%= t("protocols.google.exposed") %></p><p class="mt-1 text-lg font-bold text-ink num"><%= exposed.size %></p>
    <%= link_to t("protocols.google.choose"), site_exposure_path(integration.site), class: "text-sm" %></div>
  <div class="ss-card ss-card-pad"><p class="text-xs font-bold uppercase text-muted"><%= t("protocols.google.linked") %></p><p class="mt-1 text-lg font-bold text-ink num"><%= links.size %></p>
    <p class="text-sm text-muted"><%= t("protocols.google.linked_hint") %></p></div>
  <div class="ss-card ss-card-pad"><p class="text-xs font-bold uppercase text-muted"><%= t("protocols.google.realtime") %></p><p class="mt-1 text-lg font-bold text-ink"><%= service_account ? t("protocols.google.on") : t("protocols.google.off") %></p>
    <p class="text-sm text-muted"><%= t("protocols.google.realtime_hint") %></p></div>
</section>

<section class="ss-card ss-card-pad grid gap-4" aria-labelledby="gh-steps">
  <div>
    <h2 id="gh-steps" class="font-bold text-ink"><%= t("protocols.google.steps_title") %></h2>
    <p class="text-sm text-muted mt-1 max-w-3xl"><%= t("protocols.google.steps_pitch_html") %></p>
  </div>
  <ol class="grid gap-4 lg:grid-cols-2 list-decimal pl-5">
    <li class="grid gap-3 content-start"><span class="font-semibold text-ink"><%= t("protocols.google.step_fulfillment") %></span>
      <% copy.call(t("protocols.google.fulfillment_url"), google_smart_home_url) %></li>
    <li class="grid gap-3 content-start"><span class="font-semibold text-ink"><%= t("protocols.google.step_oauth") %></span>
      <% copy.call(t("protocols.google.client_id"), client_id) %>
      <% copy.call(t("protocols.google.authorize_url"), oauth_authorize_url) %>
      <% copy.call(t("protocols.google.token_url"), oauth_token_url) %>
      <div class="flex flex-wrap items-center gap-2">
        <%= button_to act.call("secret"), class: "ss-btn ss-btn-outline ss-btn-sm", form: { data: { turbo_confirm: (t("protocols.google.secret_confirm") if has_secret) } } do %><%= icon("finger-print", "size-4") %><%= has_secret ? t("protocols.google.secret_again") : t("protocols.google.secret") %><% end %>
        <% if has_secret %><span class="ss-badge ss-badge-success"><%= t("protocols.google.secret_ok") %></span><% end %>
      </div></li>
    <li class="grid gap-2 content-start"><span class="font-semibold text-ink"><%= t("protocols.google.step_redirect") %></span>
      <% redirect_uris.each do |u| %><code class="text-xs font-mono break-all text-muted"><%= u %></code><% end %></li>
    <li class="grid gap-2 content-start"><span class="font-semibold text-ink"><%= t("protocols.google.step_graph") %></span>
      <p class="text-sm text-muted"><%= t("protocols.google.step_graph_hint") %></p>
      <%= link_to t("protocols.google.edit"), connect_integration_path(integration), class: "ss-btn ss-btn-ghost ss-btn-sm w-fit" %></li>
  </ol>
  <div class="flex flex-wrap gap-2">
    <%= button_to act.call("sync"), class: "ss-btn ss-btn-primary", disabled: !service_account do %><%= icon("refresh", "size-4") %><%= t("protocols.google.sync") %><% end %>
  </div>
</section>

<% if links.any? %>
  <section class="ss-card overflow-hidden" aria-labelledby="gh-links">
    <h2 id="gh-links" class="font-bold text-ink px-4 pt-4"><%= t("protocols.google.links") %></h2>
    <ul class="divide-y divide-line mt-2">
      <% links.each do |l| %>
        <li class="px-4 py-3 flex items-center justify-between gap-3">
          <span><span class="font-semibold text-ink"><%= l.user.name.presence || l.user.email %></span><br><span class="text-xs text-muted"><%= t("protocols.google.since", time: l(l.created_at, format: :short)) %></span></span>
          <%= button_to t("protocols.google.unlink"), act.call("unlink"), params: { "panel[token]" => l.id }, class: "ss-btn ss-btn-ghost ss-btn-sm" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
