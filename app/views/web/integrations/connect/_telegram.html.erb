<%# locals: (integration:, chats: [], searched: false) -%>
<section class="ss-card ss-card-pad grid gap-3">
  <h2 class="font-bold"><%= t("integrations.connect.telegram.find") %></h2>
  <p class="text-sm text-ink-2"><%= t("integrations.connect.telegram.hint", bot: integration.account ? "@#{integration.account}" : t("integrations.connect.telegram.your_bot")) %></p>
  <div><%= link_to connect_integration_path(integration, find: 1), class: "ss-btn ss-btn-outline w-fit" do %><%= icon("search", "size-4") %><%= t("integrations.connect.telegram.find") %><% end %></div>
  <% if searched && chats.empty? %>
    <p class="text-sm text-muted"><%= t("integrations.connect.telegram.none") %></p>
  <% end %>
  <% chats.each do |c| %>
    <%= ss_form_with scope: :integration, url: connect_integration_path(integration), method: :post, class: "flex flex-wrap items-center gap-2" do |f| %>
      <%= f.hidden_field :chat_id, value: c["id"] %>
      <span class="text-sm font-semibold"><%= c["name"].presence || c["id"] %></span><span class="text-xs text-muted num"><%= c["id"] %></span>
      <%= f.ss_submit t("integrations.connect.telegram.use"), small: true %>
    <% end %>
  <% end %>
  <% if integration.settings["chat_id"].present? %>
    <%= render "web/integrations/test_button", integration: integration %>
  <% end %>
</section>
