<%# locals: (integration:, qr_png: nil) -%>
<% if qr_png %>
  <section class="ss-card ss-card-pad grid gap-3 justify-items-center text-center" aria-labelledby="qr-title"
           data-controller="ss-poll" data-ss-poll-url-value="<%= status_integration_path(integration) %>">
    <h2 id="qr-title" class="font-bold"><%= t("integrations.connect.xiaomi.title") %></h2>
    <div class="ss-qr-box w-64 max-w-full"><img src="data:image/png;base64,<%= Base64.strict_encode64(qr_png) %>" alt="<%= t("integrations.connect.xiaomi.qr") %>"></div>
    <ol class="list-decimal pl-5 text-sm text-ink-2 text-left grid gap-1">
      <li><%= t("integrations.connect.xiaomi.step1_html") %></li>
      <li><%= t("integrations.connect.xiaomi.step2") %></li>
      <li><%= t("integrations.connect.qr_next") %></li>
    </ol>
    <p class="text-sm text-muted inline-flex items-center gap-2" role="status"><span class="ss-dots" aria-hidden="true"></span><%= t("integrations.connect.xiaomi.waiting") %></p>
    <%= link_to t("integrations.connect.new_qr"), connect_integration_path(integration, modo: "qr"), class: "ss-btn ss-btn-ghost ss-btn-sm" %>
  </section>
<% elsif params[:etapa] == "2fa" %>
  <section class="ss-card ss-card-pad grid gap-3" aria-labelledby="tfa-title">
    <h2 id="tfa-title" class="font-bold"><%= t("integrations.connect.xiaomi.tfa_title") %></h2>
    <p class="text-sm text-ink-2"><%= t("integrations.connect.xiaomi.tfa_hint") %></p>
    <%= link_to connect_integration_path(integration, modo: "qr"), class: "ss-btn ss-btn-primary w-fit" do %><%= icon("photograph", "size-4") %><%= t("integrations.connect.xiaomi.use_qr") %><% end %>
  </section>
<% end %>
