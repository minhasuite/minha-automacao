<%# locals: (integration:, auth_url: nil, redirect_uri: nil) -%>
<section class="ss-card ss-card-pad grid gap-3">
  <h2 class="font-bold"><%= t("integrations.connect.spotify.title") %></h2>
  <p class="text-sm text-ink-2"><%= t("integrations.connect.spotify.hint") %></p>
  <p class="text-xs text-muted"><%= t("integrations.connect.spotify.redirect_html", uri: tag.strong(redirect_uri || integrations_oauth_callback_url, class: "font-mono break-all")) %></p>
  <% if auth_url %>
    <div><%= link_to auth_url, class: "ss-btn ss-btn-primary", data: { turbo: false } do %><%= icon("music-note", "size-4") %><%= t("integrations.connect.spotify.title") %><% end %></div>
  <% end %>
</section>
