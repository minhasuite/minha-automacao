<%# locals: (integration:, auth_url: nil) -%>
<% if auth_url %>
  <section class="ss-card ss-card-pad grid gap-3">
    <h2 class="font-bold"><%= t("integrations.connect.google.title") %></h2>
    <p class="text-sm text-ink-2"><%= t("integrations.connect.google.hint") %></p>
    <div><%= link_to auth_url, class: "ss-btn ss-btn-primary", data: { turbo: false } do %><%= icon("calendar", "size-4") %><%= t("integrations.connect.google.title") %><% end %></div>
  </section>
<% end %>
