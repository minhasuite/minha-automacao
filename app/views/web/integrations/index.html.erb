<% tones = { "ok" => "success", "error" => "danger", "pending" => "warn", "syncing" => "accent" } %>
<%= render "web/shared/header", title: "Integrações", subtitle: "#{@site.name} · contas e serviços que trazem os aparelhos", back: site_path(@site) do %>
  <% if can?(:manage) %><a href="#adicionar" class="ss-btn ss-btn-primary"><%= icon("plus", "size-4") %>Adicionar integração</a><% end %>
<% end %>
<%= render "web/sites/tabs", site: @site, current: :integrations %>

<% if @integrations.empty? %>
  <div class="ss-card ss-empty">
    <p class="font-bold text-ink">Nenhuma integração neste local.</p>
    <p class="mt-1">Escolha uma no catálogo abaixo: a conta é varrida e os aparelhos aparecem para adicionar.</p>
  </div>
<% else %>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @integrations.each do |i| %>
      <section class="ss-card ss-card-pad flex flex-col" aria-labelledby="int-<%= i.id %>">
        <div class="flex items-start gap-3">
          <span class="ss-icon-tile text-accent"><%= icon(i.icon_name) %></span>
          <div class="min-w-0 flex-1">
            <h2 id="int-<%= i.id %>" class="font-bold text-ink truncate"><%= i.name %></h2>
            <p class="text-sm text-muted truncate"><%= i.driver_label %></p>
            <% if i.account %><p class="text-xs text-muted truncate" title="<%= i.account %>"><%= i.account %></p><% end %>
          </div>
          <span class="ss-badge ss-badge-<%= tones.fetch(i.status, 'accent') %>"><%= i.status_label %></span>
        </div>
        <dl class="mt-4 grid grid-cols-3 gap-3 text-sm">
          <div><dt class="text-muted">Dispositivos</dt><dd class="font-semibold text-ink num"><%= @device_counts.fetch(i.id, 0) %></dd></div>
          <div><dt class="text-muted">Pontos</dt><dd class="font-semibold text-ink num"><%= @point_counts.fetch(i.id, 0) %></dd></div>
          <div><dt class="text-muted">Sincronizada</dt><dd class="font-semibold text-ink"><% if i.last_ok_at %><time datetime="<%= i.last_ok_at.iso8601 %>" title="<%= l(i.last_ok_at, format: :short) %>"><%= ago_text(i.last_ok_at) %></time><% else %>Ainda não<% end %></dd></div>
        </dl>
        <% if (n = @pending.fetch(i.id, 0)).positive? %>
          <%= link_to found_integration_path(i), class: "mt-3 ss-badge ss-badge-warn no-underline w-fit" do %><%= icon("sparkles", "size-3.5") %><%= n %> novo(s) para adicionar<% end %>
        <% end %>
        <% if i.last_error.present? %><p class="mt-3 text-sm text-danger" role="status">Último erro: <%= i.last_error %></p><% end %>
        <p class="mt-3 text-sm text-muted"><%= i.poll_s.to_i.positive? ? "Sincroniza sozinha a cada #{duration_text(i.poll_s)}" : "Só sincroniza quando pedir" %>.</p>
        <div class="mt-auto pt-4 flex items-center gap-2">
          <%= link_to site_devices_path(@site, integracao: i.id), class: "ss-btn ss-btn-outline ss-btn-sm flex-1 justify-center" do %><%= icon("view-list", "size-4") %>Ver dispositivos<% end %>
          <% if can?(:manage) %>
            <details class="ss-menu">
              <summary class="ss-btn ss-btn-ghost ss-btn-sm" title="Mais ações" aria-label="Mais ações de <%= i.name %>"><%= icon("dots-horizontal", "size-4") %></summary>
              <div class="ss-menu-list">
                <%= button_to sync_integration_path(i), form: { data: { turbo_submits_with: "Pedindo…" } } do %><%= icon("refresh", "size-4") %>Sincronizar agora<% end %>
                <% if i.plugin&.reconfigurable? %><%= link_to connect_integration_path(i) do %><%= icon("pencil", "size-4") %>Reconfigurar<% end %><% end %>
                <%= form_with model: i, url: integration_path(i), method: :patch, class: "px-2 py-1.5 flex items-end gap-2" do |f| %>
                  <div class="flex-1"><%= f.label :poll_min, "Intervalo (min)", class: "ss-label", for: "poll-#{i.id}" %><%= f.number_field :poll_min, min: 0, step: "any", class: "ss-input num", id: "poll-#{i.id}", placeholder: "0 = manual" %></div>
                  <%= f.submit "Salvar", class: "ss-btn ss-btn-ghost ss-btn-sm" %>
                <% end %>
                <hr>
                <%= button_to integration_path(i), method: :delete, class: "ss-menu-danger", form: { data: { turbo_confirm: "Remover a integração #{i.name}? Os dispositivos continuam no local.", turbo_confirm_button: "Remover" } } do %><%= icon("trash", "size-4") %>Remover<% end %>
              </div>
            </details>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% end %>

<% if can?(:manage) %>
  <section id="adicionar" class="mt-8 scroll-mt-6" aria-labelledby="catalogo">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-3">
      <h2 id="catalogo" class="ss-section">Adicionar integração</h2>
      <%= form_with url: site_integrations_path(@site, anchor: "adicionar"), method: :get, class: "flex gap-2", role: "search" do %>
        <label for="q" class="sr-only">Procurar integração</label>
        <%= search_field_tag :q, params[:q], class: "ss-input w-64", placeholder: "Procurar (Tuya, câmera, Zigbee…)" %>
        <button class="ss-btn ss-btn-ghost" aria-label="Procurar"><%= icon("search", "size-4") %></button>
      <% end %>
    </div>
    <% if @catalog.empty? %>
      <div class="ss-card ss-empty"><p>Nenhuma integração com "<%= params[:q] %>".</p></div>
    <% else %>
      <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3" aria-label="Catálogo de integrações">
        <% @catalog.each do |p| %>
          <li>
            <%= link_to new_site_integration_path(@site, tipo: p.key), class: "ss-card ss-card-link p-4 no-underline flex items-start gap-3 h-full" do %>
              <span class="ss-icon-tile text-accent"><%= icon(p.icon) %></span>
              <span class="min-w-0">
                <span class="block font-bold text-ink"><%= p.title %></span>
                <span class="block text-sm text-muted mt-0.5"><%= p.description %></span>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>
