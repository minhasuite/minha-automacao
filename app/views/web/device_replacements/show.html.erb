<%= render "web/shared/header", title: t("devices.replace.title", name: @device.name), subtitle: t("devices.replace.subtitle"), back: device_path(@device) %>

<%= render(Ss::CalloutComponent.new(css: "mb-4 max-w-3xl")) { tag.p(t("devices.replace.pitch")) } %>

<%= ss_form_with url: replace_device_path(@device), method: :get, class: "ss-card ss-card-pad grid gap-3 max-w-3xl mb-4", data: { turbo: false } do |f| %>
  <% if @assistant %><%= hidden_field_tag :assistente, @assistant, id: nil %><% end %>
  <%= f.ss_select :por, @candidates.map { |d| [ [ d.name, d.driver_label, d.area&.name ].compact.join(" · "), d.id ] }, selected: @new_device&.id, include_blank: t("devices.replace.choose"),
                  label: t("devices.replace.new_device"), help: t("devices.replace.new_device_hint") %>
  <div><%= render Ss::ButtonComponent.new(label: t("devices.replace.load"), type: :submit, variant: :outline) %></div>
<% end %>

<% if @new_device %>
  <%# A prévia responde 200 com a tela: sem Turbo (ele só aceita redirect no envio). -%>
  <%= ss_form_with url: replace_device_path(@device), method: :post, class: "ss-card ss-card-pad grid gap-4 max-w-3xl", data: { turbo: false } do |f| %>
    <%= hidden_field_tag :new_device_id, @new_device.id %>
    <% if @assistant %><%= hidden_field_tag :assistente, @assistant, id: nil %><% end %>
    <%= render Ss::CardHeaderComponent.new(title: t("devices.replace.mapping"), subtitle: t("devices.replace.mapping_hint", old: @device.name, new: @new_device.name), icon: icon("switch-horizontal", "")) %>
    <% if @pairs.empty? %>
      <%= render(Ss::NoteComponent.new) { t("devices.replace.no_points") } %>
    <% end %>
    <% @pairs.each do |pair| %>
      <% o = pair.old %>
      <div class="ss-item grid gap-2 md:grid-cols-[1fr_1fr] md:items-end">
        <div>
          <p class="font-semibold text-ink"><%= o.name %></p>
          <p class="text-xs text-muted"><%= [ o.capability_label, o.device_class, o.unit, Devices::Replace.property(o) ].compact_blank.join(" · ") %></p>
        </div>
        <div class="grid gap-2">
          <%= f.ss_select "map[#{o.id}]", @news.select { |n| Devices::Replace.compatible?(o, n) }.map { |n| [ [ n.name, n.capability_label, n.unit, Devices::Replace.property(n) ].compact_blank.join(" · "), n.id ] },
                          selected: pair.new&.id, include_blank: t("devices.replace.keep_old"), id: "map_#{o.id}", label: t("devices.replace.becomes") %>
          <% if o.bool? %>
            <%= f.ss_check_box "invert[#{o.id}]", label: t("devices.replace.invert"), checked: pair.invert, id: "invert_#{o.id}",
                               help: (t("devices.replace.invert_suggested") if pair.invert) %>
          <% end %>
        </div>
      </div>
    <% end %>
    <%= f.ss_select :retire, Devices::Replace::RETIRE.map { |k| [ t("devices.replace.retire_options.#{k}"), k ] }, selected: @retire, label: t("devices.replace.retire"), help: t("devices.replace.retire_hint") %>
    <%= f.ss_check_box :take_name, label: t("devices.replace.take_name", name: @device.name), checked: @take_name, id: "take_name" %>
    <div class="flex flex-wrap gap-2">
      <%= render Ss::ButtonComponent.new(label: t("devices.replace.preview"), icon: icon("eye", ""), type: :submit, name: "preview", value: "1") %>
      <%= link_to t("devices.replace.cancel"), device_path(@device), class: "ss-btn ss-btn-ghost" %>
    </div>
  <% end %>
<% end %>
