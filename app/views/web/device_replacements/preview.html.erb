<%= render "web/shared/header", title: t("devices.replace.preview_title"), subtitle: "#{@device.name} → #{@new_device.name}", back: replace_device_path(@device, por: @new_device.id) %>

<%= ss_form_with url: replace_device_path(@device), method: :post, class: "grid gap-4 max-w-3xl", data: { turbo_confirm: t("devices.replace.confirm", old: @device.name, new: @new_device.name), turbo_confirm_button: t("devices.replace.apply") } do %>
  <%= hidden_field_tag :new_device_id, @new_device.id %>
  <%= hidden_field_tag :retire, @retire %>
  <%= hidden_field_tag :take_name, @take_name ? "1" : "0" %>
  <% if @assistant %><%= hidden_field_tag :assistente, @assistant %><% end %>
  <section class="ss-card ss-card-pad">
    <%= render Ss::CardHeaderComponent.new(title: t("devices.replace.moves"), subtitle: t("devices.replace.moves_hint"), icon: icon("switch-horizontal", "")) %>
    <ul class="mt-3 grid gap-2 text-sm">
      <% @preview[:pairs].each do |r| %>
        <%= hidden_field_tag "map[#{r[:old].id}]", r[:new].id, id: nil %>
        <%= hidden_field_tag "invert[#{r[:old].id}]", r[:invert] ? "1" : "0", id: nil %>
        <li class="ss-item">
          <p class="font-semibold text-ink"><%= r[:old].name %> <span class="text-muted">← <%= r[:new].name %></span></p>
          <p class="text-xs text-muted"><%= t("devices.replace.keeps", count: r[:usages]) %><% if r[:invert] %> · <%= t("devices.replace.inverted") %><% end %></p>
          <% if r[:new_usages].any? %><p class="text-xs text-muted"><%= t("devices.replace.new_used", what: r[:new_usages].uniq.join(", ")) %></p><% end %>
        </li>
      <% end %>
    </ul>
  </section>
  <section class="ss-card ss-card-pad">
    <%= render Ss::CardHeaderComponent.new(title: t("devices.replace.unchanged"), icon: icon("information-circle", "")) %>
    <p class="mt-2 text-sm"><%= t("devices.replace.old_left", count: @preview[:old_left].size, names: @preview[:old_left].map(&:name).join(", ")) %></p>
    <p class="mt-1 text-sm"><%= t("devices.replace.new_left", count: @preview[:new_left].size, names: @preview[:new_left].map(&:name).join(", ")) %></p>
    <p class="mt-1 text-sm"><%= t("devices.replace.retire_result.#{@preview[:retire]}", name: @device.name) %></p>
    <% if @take_name %><p class="mt-1 text-sm"><%= t("devices.replace.take_name_result", old: @device.name, new: @new_device.name) %></p><% end %>
  </section>
  <div class="flex flex-wrap gap-2">
    <%= render Ss::ButtonComponent.new(label: t("devices.replace.apply"), icon: icon("check", ""), type: :submit) %>
    <%= link_to t("devices.replace.back_edit"), replace_device_path(@device, por: @new_device.id, assistente: @assistant), class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
