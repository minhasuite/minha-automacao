<%= render "web/shared/header", title: t("settings.title"), subtitle: t("plan.subtitle") %>
<%= render layout: "web/settings/frame", locals: { current: :plan } do %>
<section class="ss-card ss-card-pad" aria-labelledby="plan-now">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 id="plan-now" class="flex items-center gap-2"><%= icon("badge-check", "size-5 text-accent") %><%= t("plan.current") %></h2>
    <span class="ss-badge ss-badge-accent"><%= t("plan.names.#{@plan}") %></span>
  </div>
  <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <% Licensing.limits.each do |lim| %>
      <% value = Licensing.limit(@tenant, lim.key) %>
      <div class="rounded-2xl bg-field p-4">
        <p class="text-xs font-semibold text-muted"><%= t("plan.limits.#{lim.key}").upcase_first %></p>
        <% if lim.kind == :flag %>
          <p class="mt-1 font-bold <%= value ? 'text-success' : 'text-muted' %>"><%= value ? t("plan.included") : t("plan.not_included") %></p>
        <% elsif lim.kind == :days %>
          <p class="mt-1 font-bold text-ink"><%= value.nil? ? t("plan.unlimited") : t("plan.days", count: value) %></p>
        <% else %>
          <% used = lim.usage(@tenant) %>
          <p class="mt-1 font-bold text-ink num"><%= used %> <span class="text-muted font-normal">/ <%= value.nil? ? "∞" : value %></span></p>
          <% if value %>
            <% pct = [ (used * 100.0 / [ value, 1 ].max).round, 100 ].min %>
            <div class="mt-2 h-2 rounded-full bg-surface overflow-hidden" role="meter" aria-valuemin="0" aria-valuemax="<%= value %>" aria-valuenow="<%= used %>" aria-label="<%= t("plan.limits.#{lim.key}") %>">
              <div class="h-full rounded-full <%= pct >= 90 ? 'bg-danger' : 'ss-grad' %>" style="width: <%= pct %>%"></div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="plan-cmp">
  <h2 id="plan-cmp"><%= t("plan.compare") %></h2>
  <div class="mt-3 overflow-x-auto">
    <table class="ss-table">
      <thead><tr><th></th><% Licensing::PLANS.each_key do |p| %><th class="<%= 'text-accent' if p == @plan %>"><%= t("plan.names.#{p}") %></th><% end %></tr></thead>
      <tbody>
        <% Licensing.limits.each do |lim| %>
          <tr>
            <td class="font-semibold"><%= t("plan.limits.#{lim.key}").upcase_first %></td>
            <% Licensing::PLANS.each_value do |vals| %>
              <% v = vals[lim.key] %>
              <td><%= if lim.kind == :flag then v ? icon("check", "size-4 text-success") : "—"
                      elsif v.nil? then t("plan.unlimited")
                      elsif lim.kind == :days then t("plan.days", count: v)
                      else v end %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="text-sm text-muted mt-3"><%= Licensing::PAYMENT_PROVIDERS.empty? ? t("plan.no_payment") : "" %></p>
</section>
<% end %>
