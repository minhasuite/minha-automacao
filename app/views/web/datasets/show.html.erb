<%= render "web/shared/header", title: @dataset.name, subtitle: "#{@site.name} · #{@dataset.free? ? t('datasets.free') : @dataset.fields_text.gsub("\n", ", ")}#{" · #{t('datasets.keeps', n: @dataset.retention_days)}" if @dataset.retention_days}", back: site_datasets_path(@site) do %>
  <%= link_to dataset_path(@dataset, format: :csv, filtros: @filters.presence, dias: (@days if @days.positive?)), class: "ss-btn ss-btn-ghost", data: { turbo: false } do %><%= icon("download", "size-4") %><%= t("datasets.show.csv") %><% end %>
  <% if can?(:manage) %><%= link_to edit_dataset_path(@dataset), class: "ss-btn ss-btn-ghost" do %><%= icon("pencil", "size-4") %><%= t("site_helpers.index.edit") %><% end %><% end %>
<% end %>

<%= ss_form_with url: dataset_path(@dataset), method: :get, class: "ss-card ss-card-pad mb-4 grid gap-3 sm:grid-cols-[minmax(0,1fr)_10rem_auto] items-end", role: "search" do |f| %>
  <%= f.ss_text_area :filtros, label: t("datasets.show.filters"), value: @filters, rows: 2, class: "num text-sm", spellcheck: false, placeholder: t("datasets.show.filters_ph"), wrapper_class: "min-w-0" %>
  <%= f.ss_number_field :dias, label: t("datasets.show.days"), value: (@days if @days.positive?), min: 1, class: "num", placeholder: t("site_helpers.index.all") %>
  <div class="flex gap-2"><%= render Ss::ButtonComponent.new(label: t("datasets.show.filter"), icon: icon("filter", ""), type: :submit) %>
    <% if @filters.present? || @days.positive? %><%= link_to t("datasets.show.clear"), dataset_path(@dataset), class: "ss-btn ss-btn-ghost" %><% end %></div>
  <% if @error %><p class="sm:col-span-3 text-sm text-danger" role="alert"><%= @error %></p><% end %>
<% end %>

<% if @records.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: (@filters.present? || @days.positive? ? t("datasets.show.none_filtered") : t("datasets.show.none")), text: t("datasets.show.none_text"), css: "ss-card") %>
<% else %>
  <%= render Ss::DataTableComponent.new(rows: @records, id: "registros", caption: t("datasets.show.records"), sort: @sort, dir: @dir, tools: false,
                                        pagination: { page: @pagy.page, pages: @pagy.pages, total: @pagy.count }) do |tb| %>
    <% tb.column :created_at, t("datasets.show.when"), sortable: true do |r| %><span class="num whitespace-nowrap"><%= l(r.created_at.in_time_zone(@site.timezone), format: t("datasets.show.time_format")) %></span><% end %>
    <% @columns.each do |c| %>
      <% tb.column "f_#{c}", c do |r| %>
        <% v = r.data[c] %>
        <span class="<%= 'num' if v.is_a?(Numeric) %> block max-w-xs truncate" title="<%= v.to_s.truncate(300) %>"><%= v == true ? t("datasets.show.yes") : (v == false ? t("datasets.show.no") : (v.is_a?(Hash) || v.is_a?(Array) ? v.to_json : v).to_s.truncate(120)) %></span>
      <% end %>
    <% end %>
  <% end %>
<% end %>
