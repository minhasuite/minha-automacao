<%# locals: (dataset:, url:, method:) -%>
<%# Formulário da tabela de dados; o bloco (de new e edit) traz as ações: yield f. -%>
<%= ss_form_with model: dataset, scope: :dataset, url: url, method: method, class: "ss-card ss-card-pad grid gap-4 sm:grid-cols-2 max-w-3xl w-full" do |f| %>
  <%= render "web/shared/errors", record: dataset %>
  <div class="sm:col-span-2"><%= f.ss_text_field :name, label: t("datasets.form.name"), required: true, maxlength: 80, autofocus: dataset.new_record?, placeholder: t("datasets.form.name_ph") %></div>
  <div class="sm:col-span-2"><%= f.ss_text_area :fields_text, label: t("datasets.form.fields"), help: t("datasets.form.fields_hint"), rows: 4, class: "num text-sm", spellcheck: false, placeholder: t("datasets.form.fields_ph") %></div>
  <%= f.ss_number_field :retention_days, label: t("datasets.form.retention"), class: "num", min: 1, max: 3650, placeholder: t("datasets.form.retention_ph") %>
  <div class="sm:col-span-2 flex flex-wrap gap-2"><%= yield f %></div>
<% end %>
