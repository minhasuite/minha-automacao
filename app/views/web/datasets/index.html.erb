<%= render "web/shared/header", title: t("datasets.index.title"), subtitle: t("datasets.index.subtitle", site: @site.name), back: site_path(@site) do %>
  <% if can?(:manage) %><%= link_to new_site_dataset_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("datasets.index.new") %><% end %><% end %>
<% end %>
<%= render "web/sites/tabs", site: @site, current: :datasets %>

<% if @datasets.empty? %>
  <div class="ss-card ss-empty">
    <p class="font-bold text-ink"><%= t("datasets.index.empty") %></p>
    <p class="mt-1 max-w-md mx-auto"><%= t("datasets.index.empty_text") %></p>
    <% if can?(:manage) %><%= link_to new_site_dataset_path(@site), class: "ss-btn ss-btn-primary mt-4" do %><%= icon("plus", "size-4") %><%= t("site_helpers.index.create_first") %><% end %><% end %>
  </div>
<% else %>
  <ul class="ss-card ss-rows" aria-label="<%= t("datasets.index.list") %>">
    <% @datasets.each do |d| %>
      <li>
        <span class="grid place-items-center size-10 shrink-0 rounded-xl bg-accent-soft text-accent"><%= icon("table") %></span>
        <div class="min-w-0 flex-1">
          <p class="font-bold text-ink truncate"><%= link_to d.name, dataset_path(d), class: "text-ink no-underline hover:text-accent" %></p>
          <p class="text-xs text-muted truncate"><%= [ t("datasets.key", key: d.key), (d.free? ? t("datasets.free") : d.field_names.join(", ")), (d.retention_days ? t("datasets.keeps", n: d.retention_days) : t("datasets.keeps_all")) ].join(" · ") %></p>
        </div>
        <p class="text-sm font-bold text-ink num shrink-0"><%= number_with_delimiter(@counts[d.id].to_i) %> <span class="text-muted font-normal"><%= t("datasets.index.records") %></span></p>
      </li>
    <% end %>
  </ul>
<% end %>
