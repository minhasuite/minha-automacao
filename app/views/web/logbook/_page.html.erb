<%# locals: (items:, next_cursor:, filter:, zone:, frame:) -%>
<%# Uma página do Diário no Ss::LogbookComponent: os dias agrupados no fuso do local e a próxima página num turbo-frame preguiçoso (frame: o id que o Turbo mandou). -%>
<% entries = items.map do |i|
     href = case i.ref&.dig(:type)
            when "point" then point_path(i.ref[:id])
            when "automation_run" then automation_run_path(i.ref[:id])
            when "scene" then edit_scene_path(i.ref[:id]) if can?(:manage)
            end
     { at: i.at, title: i.title, state: i.state.presence, tone: i.tone, href: href, icon: icon(i.icon, ""),
       detail: [ i.detail, (i.user && t("shared.by", name: i.user)) ].compact_blank.join(" · ").presence }
   end %>
<% more = (logbook_path(filter.to_params(next_cursor).merge(site_id: filter.site.id)) if next_cursor) %>
<%= render Ss::LogbookComponent.new(entries: entries, more_url: more, frame: frame, label: t("logbook.title"), time_zone: zone.tzinfo.name,
                                    end_url: lb_bigger_path(filter), end_link_label: t("logbook.bigger"),
                                    texts: { loading_more: t("logbook.loading"), end: t("logbook.start") }) %>
