<%= render "web/shared/header", title: t("logbook.title"), subtitle: t("logbook.subtitle", site: @site.name) do %>
  <%= link_to history_path(site_id: @site.id), class: "ss-btn ss-btn-ghost" do %><%= icon("chart-bar", "size-4") %><%= t("points.show.history") %><% end %>
<% end %>
<%= render "web/shared/site_switch", sites: @sites, site: @site, path: logbook_path %>
<% f = @filter %>
<% sources = Logbook.sources_for(@site_role) %>
<%# Busca, filtros ativos em chips e "+ Filtro" (tipos, área, aparelho, pessoa): Ss::FilterBarComponent
    (links e GET; o site_id fica na query do url:). Período em chips; datas próprias em "Mais filtros". %>
<section class="ss-card ss-card-pad grid gap-3 mb-5" aria-label="<%= t("logbook.search") %>">
  <%= render Ss::FilterBarComponent.new(url: logbook_path(site_id: @site.id), search: :q, placeholder: t("logbook.search_hint"),
                                        params: lb_bar_params(f), filters: lb_bar_filters(f, @site, sources)) %>
  <nav class="ss-chipbar flex-wrap" aria-label="<%= t("history.period") %>">
    <% Logbook::PERIOD_LABELS.each do |k, label| %>
      <% on = f.period == k && !f.custom_dates? %>
      <%= link_to label, lb_period_path(f, k), class: "ss-fchip no-underline", "aria-current": (on ? "true" : nil), "aria-pressed": on.to_s %>
    <% end %>
  </nav>
  <details <%= "open" if f.custom_dates? %>>
    <summary class="ss-summary text-sm font-semibold text-ink-2"><%= t("logbook.more_filters") %></summary>
    <%= ss_form_with url: logbook_path, method: :get, class: "flex flex-wrap items-end gap-3 mt-3", data: { turbo_frame: "logbook", turbo_action: "advance" } do %>
      <%= hidden_field_tag :site_id, @site.id, id: nil %>
      <% f.to_params.except(:from, :until, :before, :period, :sources).each do |k, v| %><%= hidden_field_tag k, v, id: nil %><% end %>
      <% if f.keys.size < sources.size %><% f.keys.each do |k| %><%= hidden_field_tag "sources[]", k, id: nil %><% end %><% end %>
      <%= render Ss::DateRangeComponent.new(from_name: "from", to_name: "until", from: (f.from.to_date.iso8601 if f.custom_dates?), to: params[:until].presence,
                                            legend: t("history.pick_dates"), id: "lb-range") %>
      <%= render Ss::ButtonComponent.new(label: t("points.apply"), type: :submit) %>
    <% end %>
  </details>
</section>

<%= turbo_frame_tag "logbook", data: { turbo_action: "advance" } do %>
  <% if @items.empty? %>
    <% narrowed = f.narrowed? || f.user_id %>
    <%= render Ss::EmptyStateComponent.new(variant: (narrowed ? :busca : :nada), title: (narrowed ? t("logbook.empty_filtered") : t("logbook.empty")),
                                           text: t("logbook.empty_hint"), css: "ss-card") do %>
      <% if (bigger = lb_bigger_path(f)) %><%= link_to t("logbook.bigger"), bigger, class: "ss-btn ss-btn-ghost", data: { turbo_frame: "_top" } %><% end %>
    <% end %>
  <% else %>
    <div class="ss-card">
      <%= render "page", items: @items, next_cursor: @next, filter: f, zone: @zone, frame: nil %>
    </div>
  <% end %>
<% end %>
