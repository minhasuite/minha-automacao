<%= render "web/shared/header", title: @device.name, subtitle: [ @device.driver_label, @device.area&.name || t("devices.no_area"), @site.name ].join(" · "), back: (@device.area ? area_path(@device.area) : site_path(@site)), badge: (tag.span(t("devices.disabled"), class: "ss-badge ss-badge-warn") if @device.disabled) do %>
  <% if Polling.supported?(@device) && can?(:command, risk: "sensitive") %>
    <%= render Ss::ButtonComponent.new(label: t("devices.refresh"), icon: icon("refresh", ""), href: refresh_device_path(@device), method: :post, variant: :outline, form: { data: { turbo_submits_with: t("devices.asking") } }) %>
    <%= render Ss::ButtonComponent.new(label: t("devices.reconnect"), icon: icon("switch-horizontal", ""), href: reconnect_device_path(@device), method: :post, variant: :ghost, form: { data: { turbo_submits_with: t("devices.reconnecting") } }) %>
  <% end %>
  <% if can?(:manage) %>
    <%= link_to new_device_point_path(@device), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("devices.new_point") %><% end %>
    <%= link_to edit_device_path(@device), class: "ss-btn ss-btn-ghost" do %><%= icon("pencil", "size-4") %><%= t("devices.edit") %><% end %>
    <% if @points.any? %><%= link_to replace_device_path(@device), class: "ss-btn ss-btn-ghost" do %><%= icon("switch-horizontal", "size-4") %><%= t("devices.replace.action") %><% end %><% end %>
    <% if @points.any? %><%= render "web/dashboards/add_to_link", type: "device", record: @device %><% end %>
  <% end %>
<% end %>

<% if (pa = Pairing.for_device(@device)) %>
  <% a = @device.address.to_h %>
  <% if a["rename_error"].present? %>
    <%= render(Ss::NoteComponent.new(tone: :warn, css: "mb-4")) { t("pairing.rename_error", error: a["rename_error"]) } %>
  <% elsif a["rename_to"].present? %>
    <%= render(Ss::NoteComponent.new(css: "mb-4")) { t("pairing.rename_pending", name: a["rename_to"]) } %>
  <% end %>
  <% mesh = Pairing.mesh(@device) %>
  <% if mesh.any? %>
    <p class="mb-4 text-sm text-muted">
      <%= [ (t("pairing.roles.#{mesh['role']}") if mesh["role"]), (t("pairing.power.#{mesh['power']}") if mesh["power"]), (t("pairing.lqi", n: mesh["lqi"]) if mesh["lqi"]) ].compact.join(" · ") %>
      · <%= link_to t("pairing.network.link", protocol: pa.label), site_pairing_network_path(@site, pa.key) %>
    </p>
  <% end %>
<% end %>
<% if @replaced && can?(:manage) %>
  <%= render(Ss::CalloutComponent.new(tone: :info, title: t("devices.replace.replaced_title"), css: "mb-4")) do %>
    <p><%= t("devices.replace.replaced", name: @replaced.details["new_device_name"], at: l(@replaced.created_at, format: :short), count: @replaced.details["pairs"].size) %></p>
    <div class="mt-2 flex flex-wrap gap-2">
      <% if (nd = Device.find_by(id: @replaced.details["new_device_id"])) %><%= link_to t("devices.replace.open_new"), device_path(nd), class: "ss-btn ss-btn-outline" %><% end %>
      <%= render Ss::ButtonComponent.new(label: t("devices.replace.undo"), href: undo_replace_device_path(@device), method: :post, variant: :ghost, confirm: t("devices.replace.undo_confirm"), confirm_button: t("devices.replace.undo")) %>
    </div>
  <% end %>
<% end %>
<% if @points.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("devices.no_points"), text: t("devices.no_points_hint"), css: "ss-card") do %><% if can?(:manage) %><%= link_to new_device_point_path(@device), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("devices.add_point") %><% end %><% end %><% end %>
<% else %>
  <% @points.each { |p| %><%= turbo_stream_from p, channel: PointsChannel %><% } %>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(10rem,1fr))] gap-3 lg:grid-cols-3"><%= render partial: "web/points/point", collection: @points, as: :point %></div>
<% end %>

<% s = @device.situation %>
<div class="mt-6 grid gap-4 lg:grid-cols-2">
  <section class="ss-card ss-card-pad" aria-labelledby="diag">
    <h2 id="diag" class="flex items-center gap-2"><%= icon("information-circle", "size-5") %><%= t("devices.diagnostics") %></h2>
    <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
      <% label, _tone, note = device_situation(@device) %>
      <div><dt class="text-muted"><%= t("devices.status") %></dt><dd class="font-semibold text-ink"><%= label %></dd><% if note && @device.last_error.blank? %><dd class="text-xs text-muted mt-0.5"><%= note %></dd><% end %></div>
      <div><dt class="text-muted"><%= t("devices.last_seen") %></dt><dd class="font-semibold text-ink"><%= @device.last_seen_at ? l(@device.last_seen_at, format: :short) : t("devices.not_yet") %></dd></div>
      <div><dt class="text-muted">IP</dt><dd class="font-semibold text-ink num"><%= @device.host.blank? ? t("devices.not_informed") : (reveal_sensitive? ? @device.host : Sensitive::MASK) %></dd></div>
      <div><dt class="text-muted"><%= t("devices.protocol") %></dt><dd class="font-semibold text-ink num"><%= @device.protocol_version.presence || "—" %></dd></div>
      <div><dt class="text-muted"><%= t("devices.integration") %></dt><dd class="font-semibold text-ink"><%= @device.integration ? link_to(@device.integration.name, site_integrations_path(@site)) : t("devices.no_integration") %></dd></div>
      <div><dt class="text-muted"><%= t("devices.reading") %></dt><dd class="font-semibold text-ink"><%= Polling.supported?(@device) ? poll_label(@device.poll_s).capitalize : t("devices.no_reading") %></dd></div>
      <div class="col-span-2"><dt class="text-muted"><%= t("devices.maker") %></dt><dd class="font-semibold text-ink"><%= [ @device.manufacturer, @device.model ].compact_blank.join(" · ").presence || "—" %></dd></div>
    </dl>
    <% if @device.removed_at %><%= render(Ss::CalloutComponent.new(tone: :warn, css: "mt-3")) { tag.p(t("devices.removed", at: l(@device.removed_at, format: :short))) } %><% end %>
    <% if @device.last_error.present? %><%= render(Ss::CalloutComponent.new(tone: :danger, title: t("devices.last_error").delete_suffix(":"), css: "mt-3")) { tag.p(reveal_sensitive? ? @device.last_error : Sensitive.scrub(@device.last_error)) } %><% end %>
    <% if @device.tuya_local? && @device.host.blank? %><%= render(Ss::CalloutComponent.new(tone: :warn, css: "mt-3")) { tag.p(t("devices.tuya_no_ip")) } %><% end %>
    <% if @problems.any? %>
      <p class="ss-section mt-4"><%= t("devices.failures") %></p>
      <ul class="mt-2 text-sm grid gap-1">
        <% @problems.each do |e| %><li><span class="text-muted"><%= l(e.at, format: :short) %></span> · <%= e.payload["to"] == "unavailable" ? t("devices.no_answer") : e.payload["to"] %></li><% end %>
      </ul>
    <% end %>
  </section>
  <section class="ss-card ss-card-pad" aria-labelledby="uso">
    <h2 id="uso" class="flex items-center gap-2"><%= icon("collection", "size-5") %><%= t("devices.usages") %></h2>
    <%= render "web/shared/usages", usages: @usages, empty: t("devices.no_usages") %>
  </section>
</div>
