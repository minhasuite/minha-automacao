<%# locals: (site:, device:) -%>
<%# Formulário do aparelho; o bloco (de new e edit) traz as ações: yield f. -%>
<%= ss_form_with model: device.new_record? ? [ site, device ] : device, class: "ss-card ss-card-pad grid gap-4 md:grid-cols-2 max-w-3xl" do |f| %>
  <%= render "web/shared/errors", record: device %>
  <div class="md:col-span-2"><%= f.ss_text_field :name, label: t("devices.name"), required: true, placeholder: t("devices.form.name_hint"), autofocus: true %></div>
  <%= f.ss_select :area_id, site.areas.order(:name).pluck(:name, :id), label: t("devices.area"), include_blank: t("devices.no_area") %>
  <%= f.ss_select :driver, Device::DRIVERS.invert, label: t("devices.form.driver"), help: t("devices.form.driver_hint") %>
  <%= f.ss_text_field :manufacturer, label: t("devices.form.maker") %>
  <%= f.ss_text_field :model, label: t("devices.form.model") %>
  <%= f.ss_text_field :serial, label: t("devices.form.serial"), class: "num" %>
  <% if Polling.supported?(device) %>
    <%= f.ss_number_field :poll_min, label: t("devices.form.poll"), help: t("devices.form.poll_note"), min: 0, step: "any", class: "num", placeholder: t("devices.form.poll_hint") %>
  <% end %>
  <div class="flex items-end"><%= f.ss_check_box :disabled, label: t("devices.form.disabled") %></div>
  <% if device.driver.in?(%w[tuya_local xiaomi_miot go2rtc]) %>
    <%= f.ss_text_field :host, label: t("devices.form.host"), class: "num", inputmode: "decimal", placeholder: "192.168.0.50" %>
  <% end %>
  <% if device.tuya_local? %>
    <%= f.ss_select :protocol_version, Drivers::TuyaLocal::VERSIONS, label: t("devices.form.tuya_version"), include_blank: t("devices.form.tuya_discover") %>
    <div class="md:col-span-2"><%= f.ss_check_box :listen, label: t("devices.form.listen"), help: t("devices.form.listen_hint") %></div>
  <% end %>
  <%= render "web/shared/organize_fields", f: f, record: device, span: "md:col-span-2" %>
  <div class="md:col-span-2 flex flex-wrap gap-2"><%= yield f %></div>
<% end %>
