<%# locals: (site:, device:) -%>
<%= form_with model: device.new_record? ? [ site, device ] : device, class: "ss-card ss-card-pad grid gap-4 md:grid-cols-2 max-w-3xl" do |f| %>
  <%= render "web/shared/errors", record: device %>
  <div class="md:col-span-2"><%= f.label :name, t("devices.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", required: true, placeholder: t("devices.form.name_hint"), autofocus: true %></div>
  <div><%= f.label :area_id, t("devices.area"), class: "ss-label" %><%= f.select :area_id, site.areas.order(:name).pluck(:name, :id), { include_blank: t("devices.no_area") }, class: "ss-input" %></div>
  <div><%= f.label :driver, t("devices.form.driver"), class: "ss-label" %><%= f.select :driver, Device::DRIVERS.invert, {}, class: "ss-input" %>
    <p class="text-xs text-muted mt-1"><%= t("devices.form.driver_hint") %></p></div>
  <div><%= f.label :manufacturer, t("devices.form.maker"), class: "ss-label" %><%= f.text_field :manufacturer, class: "ss-input" %></div>
  <div><%= f.label :model, t("devices.form.model"), class: "ss-label" %><%= f.text_field :model, class: "ss-input" %></div>
  <div><%= f.label :serial, t("devices.form.serial"), class: "ss-label" %><%= f.text_field :serial, class: "ss-input num" %></div>
  <% if Polling.supported?(device) %>
    <div><%= f.label :poll_min, t("devices.form.poll"), class: "ss-label" %><%= f.number_field :poll_min, min: 0, step: "any", class: "ss-input num", placeholder: t("devices.form.poll_hint") %>
      <p class="text-xs text-muted mt-1"><%= t("devices.form.poll_note") %></p></div>
  <% end %>
  <div class="flex items-end"><label class="ss-check"><%= f.check_box :disabled %> <%= t("devices.form.disabled") %></label></div>
  <% if device.driver.in?(%w[tuya_local xiaomi_miot go2rtc]) %>
    <div><%= f.label :host, t("devices.form.host"), class: "ss-label" %><%= f.text_field :host, class: "ss-input num", inputmode: "decimal", placeholder: "192.168.0.50" %></div>
  <% end %>
  <% if device.tuya_local? %>
    <div><%= f.label :protocol_version, t("devices.form.tuya_version"), class: "ss-label" %><%= f.select :protocol_version, Drivers::TuyaLocal::VERSIONS, { include_blank: t("devices.form.tuya_discover") }, class: "ss-input" %></div>
    <div class="md:col-span-2"><label class="ss-check"><%= f.check_box :listen %> <%= t("devices.form.listen") %></label>
      <p class="text-xs text-muted mt-1"><%= t("devices.form.listen_hint") %></p></div>
  <% end %>
  <div class="md:col-span-2 flex flex-wrap gap-2">
    <%= f.submit device.new_record? ? t("devices.form.create") : t("devices.form.save"), class: "ss-btn ss-btn-primary" %>
    <%= link_to t("devices.form.cancel"), device.new_record? ? (device.area || site) : device, class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
