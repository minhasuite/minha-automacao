<%= render "web/shared/header", title: t("devices.title"), subtitle: t("devices.subtitle", site: @site.name), back: site_path(@site) do %>
  <% if can?(:manage) %><%= link_to new_site_device_path(@site), class: "ss-btn ss-btn-outline" do %><%= icon("plus", "size-4") %><%= t("devices.new") %><% end %><% end %>
<% end %>
<%= render "web/sites/tabs", site: @site, current: :devices %>

<%# Filtros da gem: busca, chips dos ativos (× tira) e "+ Filtro"; no celular cabe numa linha. %>
<%= render Ss::FilterBarComponent.new(url: site_devices_path(@site), search: :q, placeholder: t("devices.search_hint"), css: "mb-4",
                                      filters: [ { param: :integracao, label: t("devices.integration"), options: @integrations.map { |i| [ i.name, i.id ] } },
                                                 { param: :area, label: t("devices.area"), options: [ [ t("devices.no_area"), "none" ] ] + @areas.map { |a| [ a.name, a.id ] } },
                                                 { param: :situacao, label: t("devices.status"), options: Device::SITUATIONS.invert.to_a } ]) %>

<% if @devices.empty? %>
  <% filtered = params.values_at(:q, :integracao, :area, :situacao).any?(&:present?) %>
  <%= render Ss::EmptyStateComponent.new(variant: (filtered ? :busca : :nada), title: (filtered ? t("devices.none_filtered") : t("devices.none")), text: t("devices.none_hint"), css: "ss-card") do %>
    <% if filtered %>
      <%= link_to t("devices.clear"), site_devices_path(@site), class: "ss-btn ss-btn-ghost" %>
    <% elsif can?(:manage) %>
      <%= link_to site_integrations_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("link", "size-4") %><%= t("devices.add_integration") %><% end %>
      <%= link_to new_site_device_path(@site), class: "ss-btn ss-btn-outline" do %><%= icon("plus", "size-4") %><%= t("devices.add_manual") %><% end %>
    <% end %>
  <% end %>
<% else %>
  <%# Celular: lista de toque (ícone, nome, área · integração · pontos e a situação), uma linha por aparelho;
      a tabela (ordem, colunas e ações em massa) fica do tablet para cima. -%>
  <div class="sm:hidden">
    <ul class="ss-rows ss-card overflow-hidden" aria-label="<%= t("devices.mobile_list") %>">
      <% @devices.each do |d| %>
        <% label, tone, note = device_situation(d) %>
        <li class="relative">
          <span class="ss-icon-tile text-accent"><%= icon(device_icon(d), "") %></span>
          <span class="min-w-0 flex-1">
            <%= link_to d.name, device_path(d), class: "block font-semibold text-ink no-underline truncate after:absolute after:inset-0" %>
            <span class="block text-sm text-muted truncate"><%= [ d.area&.name, t("devices.points_count", count: @points.fetch(d.id, 0)), d.integration&.name || d.driver_label ].compact.join(" · ") %></span>
          </span>
          <span class="ss-badge ss-badge-dot ss-badge-<%= tone %> shrink-0" title="<%= note %>"><%= label %></span>
        </li>
      <% end %>
    </ul>
    <%= render "web/shared/pagination", pagy: @pagy %>
  </div>
  <%# Tabela da gem: ordena no servidor (?sort=&dir=), marca para as ações em massa (barra da gem) e pagina. -%>
  <% filters = params.permit(:integracao, :area, :situacao, :q).to_h.symbolize_keys %>
  <div class="max-sm:hidden">
  <%= render Ss::DataTableComponent.new(rows: @devices, id: "dispositivos", caption: t("devices.title"), sort: @sort, dir: @dir, tools: false,
                                        selectable: can?(:manage), bulk_url: bulk_site_devices_path(@site, **filters),
                                        pagination: { page: @pagy.page, pages: @pagy.pages, total: @pagy.count }) do |tb| %>
    <% tb.column :name, t("devices.name"), sortable: true, hideable: false do |d| %>
      <%# No celular a linha vira cartão com a caixa de marcar no canto: o nome deixa o espaço dela. %>
      <div class="flex items-center gap-3 min-w-0 max-sm:pr-7">
        <span class="ss-icon-tile size-9 text-accent max-sm:size-8"><%= icon(device_icon(d)) %></span>
        <div class="min-w-0 text-left"><%= link_to d.name, device_path(d), class: "font-semibold text-ink no-underline hover:text-accent" %></div>
      </div>
    <% end %>
    <% tb.column :maker, t("devices.maker") do |d| %><span class="text-ink-2"><%= [ d.manufacturer, d.model ].compact_blank.join(" · ").presence || d.driver_label %></span><% end %>
    <% tb.column :area, t("devices.area"), sortable: true do |d| %><%= d.area&.name || "—" %><% end %>
    <% tb.column :integration, t("devices.integration"), sortable: true do |d| %><%= d.integration&.name || d.driver_label %><% end %>
    <% tb.column :points, t("devices.points"), align: :right do |d| %><span class="num"><%= @points.fetch(d.id, 0) %></span><% end %>
    <% tb.column :status, t("devices.status") do |d| %>
      <% label, tone, note = device_situation(d) %>
      <span class="ss-badge ss-badge-dot ss-badge-<%= tone %>" title="<%= note %>"><%= label %></span><% if note && tone != "success" %><span class="block text-xs text-muted mt-1 max-w-48 max-md:hidden"><%= note.truncate(70) %></span><% end %>
    <% end %>
    <% tb.bulk_actions do %>
      <label for="acao" class="sr-only"><%= t("devices.with_checked") %></label><%= select_tag :acao, options_for_select([ [ t("devices.with_checked_hint"), "" ] ] + Web::DevicesController::BULK.invert.to_a), class: "ss-input", required: true %>
      <span class="ma-bulk-area contents"><label for="area_id" class="sr-only"><%= t("devices.move_area") %></label><%= select_tag :area_id, options_for_select([ [ t("devices.no_area"), "" ] ] + @areas.map { |a| [ a.name, a.id ] }), class: "ss-input" %></span>
      <button type="submit" class="ss-btn ss-btn-primary ss-btn-sm" data-turbo-confirm="<%= t("devices.bulk_confirm") %>" data-turbo-confirm-button="<%= t("devices.apply") %>"><%= t("devices.apply") %></button>
    <% end %>
  <% end %>
  </div>
<% end %>
