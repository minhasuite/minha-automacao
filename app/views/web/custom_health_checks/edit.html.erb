<%= render "web/shared/header", title: @check.new_record? ? t("custom.health.new") : @check.name_was.presence || t("custom.health.title"), subtitle: t("custom.health.subtitle"), back: settings_health_checks_path %>
<%= render layout: "web/settings/frame", locals: { current: :health } do %>
  <%= ss_form_with model: @check, url: @check.new_record? ? settings_health_checks_path : settings_health_check_path(@check), scope: :custom_health_check,
                   class: "ss-card ss-card-pad grid gap-4 md:grid-cols-2 max-w-4xl" do |f| %>
    <%= render "web/shared/errors", record: @check %>
    <%= f.ss_text_field :name, label: t("custom.health.name"), maxlength: 80, required: true, placeholder: t("custom.health.name_ph") %>
    <%= f.ss_select :site_id, Site.order(:name).map { |s| [ s.name, s.id ] }, label: t("custom.common.site") %>
    <%= f.ss_text_field :query, label: t("custom.health.query"), class: "num", maxlength: 500, placeholder: "quality=unavailable tag=bateria",
                        help: t("custom.health.query_hint", keys: Points::Query::KEYS.join(", ")), wrapper_class: "md:col-span-2" %>
    <%= f.ss_text_field :expression, label: t("custom.health.expression"), class: "num", maxlength: 500, placeholder: "count_points(\"quality=unavailable\") > 0",
                        help: t("custom.health.expression_hint"), wrapper_class: "md:col-span-2" %>
    <%= f.ss_select :severity, CustomHealthCheck::SEVERITIES.map { |s| [ t("custom.health.severities.#{s}"), s ] }, label: t("custom.health.severity") %>
    <%= f.ss_check_box :enabled, label: t("custom.health.enabled"), wrapper_class: "self-end pb-2" %>
    <%= f.ss_text_area :message, label: t("custom.health.message"), rows: 3, maxlength: MessageTemplate::MAX, placeholder: t("custom.health.message_ph"),
                       help: t("custom.health.message_hint"), wrapper_class: "md:col-span-2" %>
    <div class="md:col-span-2 grid gap-2" data-message-preview>
      <div><%= render Ss::ButtonComponent.new(label: t("custom.preview.button"), icon: icon("eye", ""), type: :submit, name: "preview", value: "1",
                                              variant: :outline, size: :sm, formnovalidate: true) %></div>
      <% if @preview %>
        <% res, error = @preview %>
        <% if error %>
          <%= render(Ss::CalloutComponent.new(tone: :danger)) { tag.p(error) } %>
        <% else %>
          <% status = res[:problem] ? @check.severity : "ok" %>
          <%= render Ss::CalloutComponent.new(tone: { "ok" => :success, "warn" => :warn, "error" => :danger }[status], title: Health.label(status)) do %>
            <p><%= res[:detail] %></p>
            <% if @check.query %><p class="text-xs text-muted"><%= t("custom.health.count", count: res[:count]) %></p><% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <div class="md:col-span-2 flex flex-wrap gap-2">
      <%= f.ss_submit t("custom.common.save"), name: nil %>
      <%= link_to t("automations.settings.cancel"), settings_health_checks_path, class: "ss-btn ss-btn-ghost" %>
    </div>
  <% end %>
  <% if @check.persisted? %>
    <%= render Ss::ButtonComponent.new(label: t("automations.common.delete"), icon: icon("trash", ""), href: settings_health_check_path(@check), method: :delete,
                                       variant: :ghost, css: "text-danger mt-4",
                                       confirm: t("custom.health.confirm_remove", name: @check.name_was), confirm_tone: :danger, confirm_button: t("shared.confirm.delete")) %>
  <% end %>
<% end %>
