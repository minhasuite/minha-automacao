<%= render "web/shared/header", title: t("settings.title"), subtitle: t("hardware.subtitle") %>
<%= render layout: "web/settings/frame", locals: { current: :hardware } do %>
<% h = @host %>
<% if !@available || h.empty? %>
  <div class="ss-card ss-empty"><%= icon("chip", "size-8 text-muted") %>
    <p class="font-bold text-ink"><%= t("hardware.unavailable") %></p>
    <p class="text-sm text-muted"><%= @available ? t("hardware.offline") : t("hardware.no_supervisor") %></p></div>
<% else %>
  <section class="ss-card ss-card-pad" aria-labelledby="hw-t" data-hardware="system">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="hw-t" class="flex items-center gap-2"><%= icon("chip", "size-5 text-accent") %><%= h["hostname"].presence || t("hardware.machine") %></h2>
      <%= link_to settings_hardware_path(atualizar: 1), class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("refresh", "size-4") %><%= t("hardware.refresh") %><% end %>
    </div>
    <dl class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-3 text-sm">
      <% [ [ :os, h["os"] ], [ :kernel, h["kernel"] ], [ :arch, h["arch"] ], [ :cpu, [ h["cpu"], (t("hardware.cores", n: h["cpus"]) if h["cpus"]) ].compact.join(" · ") ],
           [ :memory, (t("hardware.memory_of", free: number_to_human_size(h["memory_free_mb"].to_i.megabytes), total: number_to_human_size(h["memory_mb"].to_i.megabytes)) if h["memory_mb"]) ],
           [ :uptime, (distance_of_time_in_words(h["uptime_s"].to_i) if h["uptime_s"]) ], *([ [ :board, h["board"] ] ] if h["board"].present?) ].each do |k, v| %>
        <div class="min-w-0"><dt class="text-xs font-semibold text-muted"><%= t("hardware.fields.#{k}") %></dt><dd class="text-ink break-words num"><%= v.presence || "—" %></dd></div>
      <% end %>
    </dl>
  </section>

  <section class="ss-card ss-card-pad mt-4" aria-labelledby="net-t" data-hardware="network">
    <h2 id="net-t" class="flex items-center gap-2"><%= icon("globe", "size-5 text-accent") %><%= t("hardware.network") %></h2>
    <p class="text-sm text-muted mt-1 num"><%= t("hardware.gateway") %>: <%= h["gateway"].presence || "—" %> · DNS: <%= Array(h["dns"]).join(", ").presence || "—" %></p>
    <ul class="mt-3 divide-y divide-line">
      <% Array(h["interfaces"]).each do |i| %>
        <li class="py-2 flex flex-wrap items-center justify-between gap-2">
          <div class="min-w-0"><p class="font-semibold text-ink num"><%= i["name"] %></p><p class="text-xs text-muted num break-all"><%= i["mac"] %></p></div>
          <div class="text-right min-w-0"><p class="text-sm text-ink num break-all"><%= (Array(i["ipv4"]) + Array(i["ipv6"])).join(", ").presence || "—" %></p>
            <span class="ss-badge <%= i["state"] == "up" ? "ss-badge-success" : "ss-badge-muted" %>"><%= i["state"] == "up" ? t("hardware.up") : t("hardware.down") %></span></div>
        </li>
      <% end %>
    </ul>
    <p class="text-xs text-muted mt-2"><%= t("hardware.neighbors", n: Array(h["neighbors"]).size) %></p>
  </section>

  <section class="ss-card ss-card-pad mt-4" aria-labelledby="usb-t" data-hardware="usb">
    <h2 id="usb-t" class="flex items-center gap-2"><%= icon("link", "size-5 text-accent") %><%= t("hardware.serial") %></h2>
    <% if Array(h["serial"]).empty? %><p class="text-sm text-muted mt-2"><%= t("hardware.no_serial") %></p><% end %>
    <ul class="mt-2 divide-y divide-line">
      <% Array(h["serial"]).each do |s| %>
        <li class="py-2 min-w-0"><p class="font-semibold text-ink break-words"><%= [ s["manufacturer"], s["product"] ].compact_blank.join(" ").presence || s["id"] %></p>
          <p class="text-xs text-muted num break-all"><%= s["path"] %><%= " · #{s["vid"]}:#{s["pid"]}" if s["vid"].present? %></p></li>
      <% end %>
    </ul>
    <% others = Array(h["usb"]) %>
    <% if others.any? %>
      <details class="mt-2"><summary class="text-sm text-accent cursor-pointer"><%= t("hardware.usb", n: others.size) %></summary>
        <ul class="mt-1 text-sm">
          <% others.each do |u| %><li class="py-1 break-words"><%= [ u["manufacturer"], u["product"] ].compact_blank.join(" ") %> <span class="text-xs text-muted num"><%= u["vid"] %>:<%= u["pid"] %></span></li><% end %>
        </ul></details>
    <% end %>
  </section>

  <section class="ss-card ss-card-pad mt-4 flex flex-wrap items-center justify-between gap-3" aria-labelledby="pw-t">
    <div class="min-w-0"><h2 id="pw-t" class="flex items-center gap-2"><%= icon("exclamation-circle", "size-5 text-warn") %><%= t("hardware.power.title") %></h2>
      <p class="text-sm text-muted mt-1"><%= t("hardware.power.hint") %></p></div>
    <div class="flex flex-wrap gap-2">
      <% %w[reboot shutdown].each do |a| %>
        <%= button_to settings_hardware_power_path(acao: a), class: "ss-btn #{a == "shutdown" ? "ss-btn-danger" : "ss-btn-ghost"}",
                      form: { data: { turbo_confirm: t("hardware.power.confirm.#{a}"), turbo_confirm_button: t("hardware.power.#{a}") } } do %><%= t("hardware.power.#{a}") %><% end %>
      <% end %>
    </div>
  </section>
<% end %>
<% end %>
