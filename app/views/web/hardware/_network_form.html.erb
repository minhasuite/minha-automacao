<%# locals: (h:, wifi:) -%>
<%# resto (7.3): IP fixo/DHCP por interface e Wi-Fi, pelo NetworkManager do host. -%>
<section class="ss-card ss-card-pad mt-4" aria-labelledby="netcfg-t" data-hardware="network-config">
  <h2 id="netcfg-t" class="flex items-center gap-2"><%= icon("adjustments", "size-5 text-accent") %><%= t("resto.host.title") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("resto.host.pitch") %></p>
  <% ifaces = Array(h["interfaces"]).map { |i| i["name"] } %>
  <%= ss_form_with url: settings_hardware_network_path, class: "mt-4 grid gap-3 sm:grid-cols-2", data: { turbo_confirm: t("resto.host.confirm"), turbo_confirm_button: t("resto.host.apply") } do |f| %>
    <%= f.ss_select :interface, ifaces, label: t("resto.host.interface") %>
    <%= f.ss_select :mode, [ [ t("resto.host.dhcp"), "dhcp" ], [ t("resto.host.static"), "static" ] ], label: t("resto.host.mode") %>
    <%= f.ss_text_field :address, label: t("resto.host.address"), class: "num", placeholder: "192.168.0.10/24", inputmode: "decimal" %>
    <%= f.ss_text_field :gateway, label: t("hardware.gateway"), value: h["gateway"], class: "num", inputmode: "decimal" %>
    <%= f.ss_text_field :dns, label: "DNS", value: Array(h["dns"]).join(", "), class: "num", placeholder: "1.1.1.1, 8.8.8.8", help: t("resto.host.static_hint"), wrapper_class: "sm:col-span-2" %>
    <div class="sm:col-span-2"><%= render Ss::ButtonComponent.new(label: t("resto.host.apply"), type: :submit, variant: :outline) %></div>
  <% end %>

  <h3 class="font-bold text-ink mt-6 flex items-center gap-2"><%= icon("globe", "size-4 text-accent") %><%= t("resto.host.wifi") %></h3>
  <% if wifi.nil? %>
    <%= link_to t("resto.host.scan"), settings_hardware_path(wifi: 1, anchor: "netcfg-t"), class: "ss-btn ss-btn-ghost ss-btn-sm mt-2" %>
  <% elsif wifi.empty? %>
    <p class="text-sm text-muted mt-2"><%= t("resto.host.no_wifi") %></p>
  <% end %>
  <%= ss_form_with url: settings_hardware_wifi_path, class: "mt-3 grid gap-3 sm:grid-cols-2", data: { turbo_confirm: t("resto.host.confirm"), turbo_confirm_button: t("resto.host.connect") } do |f| %>
    <div><%= f.ss_text_field :ssid, label: t("resto.host.ssid"), list: "wifi-list", required: true, maxlength: 32, autocomplete: "off" %>
      <datalist id="wifi-list"><% Array(wifi).each do |w| %><option value="<%= w["ssid"] %>"><%= w["signal"] %>%</option><% end %></datalist></div>
    <%= f.ss_password_field :password, label: t("resto.host.wifi_password"), maxlength: 63, autocomplete: "new-password" %>
    <%= hidden_field_tag :interface, ifaces.find { |n| n.start_with?("wl") } %>
    <div class="sm:col-span-2"><%= render Ss::ButtonComponent.new(label: t("resto.host.connect"), type: :submit, variant: :outline) %></div>
  <% end %>
</section>
