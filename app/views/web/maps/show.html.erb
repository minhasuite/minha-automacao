<%= render "web/shared/header", title: t("maps.title"), subtitle: t("maps.subtitle", site: @site.name) %>
<%= render "web/shared/site_switch", sites: @sites, site: @site, path: map_path %>
<% people = @map["people"] %>
<%# Mapa + coluna lateral da gem (Ss::AsideLayoutComponent); o mapa (Leaflet) é o domínio. Cor de cada pessoa = --series-N. %>
<%= render Ss::AsideLayoutComponent.new(label: t("maps.people"), data: (@map["center"] ? { controller: "map", map_data_value: @map.to_json } : {})) do |lay| %>
  <% lay.with_main do %>
  <section class="ss-card overflow-hidden" aria-label="<%= t("maps.title") %>">
    <% if @map["center"] %>
      <%= render "web/maps/canvas", map: @map, height: 560, controller: false %>
    <% else %>
      <%= render Ss::EmptyStateComponent.new(title: t("maps.no_center"), text: t("maps.no_center_hint")) %>
    <% end %>
  </section>
  <% end %>
  <% lay.with_aside do %>
    <div class="grid gap-4">
    <section class="ss-card ss-card-pad" aria-labelledby="mp-people">
      <h2 id="mp-people" class="mb-3"><%= t("maps.people") %></h2>
      <% if people.empty? %>
        <%= render Ss::NoteComponent.new(text: t("maps.no_people"), icon: icon("users", "")) %>
      <% else %>
        <ul class="grid gap-1">
          <% people.each_with_index do |p, i| %>
            <% off = p["quality"] != "good" %>
            <li>
              <%= render(Ss::ButtonComponent.new(variant: :item, disabled: !p["lat"], data: { action: "map#focus", map_id_param: p["id"] })) do %>
                <span class="grid place-items-center flex-none rounded-full font-bold text-[.8rem] leading-none text-[var(--on-accent)] bg-[var(--mp-c,var(--accent))] border-[3px] border-surface size-[2.4rem] <%= p['home'] && !off ? "shadow-[0_0_0_2px_var(--success),0_8px_18px_-8px_color-mix(in_srgb,var(--ink)_50%,transparent)]" : "shadow-[0_0_0_2px_var(--mp-c,var(--accent)),0_8px_18px_-8px_color-mix(in_srgb,var(--ink)_50%,transparent)]" %>" style="--mp-c: var(--series-<%= i % 6 + 1 %>)"><%= p["initials"] %></span>
                <span class="ss-item-main">
                  <span class="block font-semibold text-ink truncate"><%= p["name"] %></span>
                  <span class="block text-xs text-muted truncate"><%= off ? t("points.no_signal") : (p["zone"].presence || t("maps.no_reading")) %><% if p["since"] && !off %> · <%= t("maps.since") %> <%= l(Time.zone.parse(p["since"]), format: Time.zone.parse(p["since"]).to_date == Date.current ? "%H:%M" : "%d/%m %H:%M") %><% end %></span>
                  <span class="block text-xs text-muted"><%= p["precise"] ? "#{t('maps.phone')}#{" (± #{p['accuracy']} m)" if p['accuracy']}" : (p["lat"] ? t("maps.zone_position") : t("maps.no_position")) %><%= " · #{t('maps.track', count: p['track'].size)}" if p["track"].size > 1 %></span>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
    <section class="ss-card ss-card-pad" aria-labelledby="mp-zones">
      <h2 id="mp-zones" class="mb-3"><%= t("maps.zones") %></h2>
      <% if @map["zones"].empty? %>
        <%= render Ss::NoteComponent.new(text: t("maps.no_zones"), icon: icon("location-marker", "")) %>
      <% else %>
        <ul class="grid gap-1">
          <% @map["zones"].each do |z| %>
            <li><%= render(Ss::ButtonComponent.new(variant: :item, data: { action: "map#focus", map_id_param: z["id"] })) do %>
              <span class="ss-icon-tile <%= z['home'] ? 'is-accent' : 'is-muted' %>"><%= icon(z["home"] ? "home" : "location-marker", "") %></span>
              <span class="ss-item-main"><span class="block font-semibold text-ink truncate"><%= z["name"] %></span>
                <span class="block text-xs text-muted num"><%= t("maps.zone_info", radius: z["radius"], count: z["count"]) %></span></span><% end %></li>
          <% end %>
        </ul>
      <% end %>
    </section>
    </div>
  <% end %>
<% end %>
