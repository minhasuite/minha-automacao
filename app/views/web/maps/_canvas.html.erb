<%# locals: (map:, height:, compact: false, controller: true) -%>
<div class="mp-map <%= 'mp-compact' if compact %>" style="--mp-h: <%= height %>px" <% if controller %>data-controller="map" data-map-data-value="<%= map.except('point_ids').to_json %>"<% end %>
     role="region" aria-label="<%= t("maps.aria", people: map['people'].size, zones: map['zones'].size) %>">
  <div class="mp-canvas" data-map-target="canvas"></div>
  <%= render Ss::EmptyStateComponent.new(variant: :erro, compact: true, title: t("maps.failed"), css: "mp-fallback", hidden: true, data: { map_target: "fallback" }) %>
</div>
