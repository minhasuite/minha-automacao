<%= render "web/shared/header", title: t("bridges.title", name: @bridge.title), subtitle: "#{@site.name} · #{@bridge.description}", back: site_path(@site) %>
<%= render "web/sites/tabs", site: @site, current: :"bridge_#{@bridge.key}" %>
<% admin = can?(:admin) %>

<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
  <%= ss_form_with url: site_bridge_path(@site, @bridge.key), method: :patch, class: "ss-card block min-w-0", aria: { label: t("bridges.exposed_on", name: @bridge.title) }, data: { controller: "ss-filter" } do |f| %>
    <div class="ss-card-pad flex flex-wrap items-center justify-between gap-2 border-b border-line">
      <div>
        <h2 class="font-bold"><%= t("bridges.exposed") %></h2>
        <p class="text-sm text-muted"><%= t("bridges.count_html", n: tag.span(@exposed.size, class: "num"), total: tag.span(@items.size, class: "num")) %></p>
      </div>
      <% if admin && @items.any? %><%= f.ss_submit t("integrations.common.save"), name: nil %><% end %>
    </div>
    <% if @items.empty? %>
      <p class="ss-card-pad text-sm text-muted"><%= t("bridges.empty") %></p>
    <% else %>
      <div class="ss-card-pad border-b border-line">
        <%= f.ss_search_field :busca, label: t("bridges.search"), id: "br-busca", placeholder: t("bridges.search_hint"), autocomplete: "off",
                              data: { ss_filter_target: "input", action: "input->ss-filter#apply keydown.esc->ss-filter#clear" } %>
        <p class="text-sm text-muted mt-2" data-ss-filter-target="empty" hidden><%= t("bridges.no_match") %> <%= render Ss::ButtonComponent.new(label: t("bridges.clear"), variant: :ghost, size: :sm, data: { action: "ss-filter#clear" }) %></p>
      </div>
      <ul class="ss-rows">
        <% @items.each do |p, type| %>
          <% e = @exposed[p.id] %>
          <% critical = p.risk == "critical" %>
          <li class="flex-wrap" data-ss-filter-target="item">
            <% title, context = p.display_names %>
            <%= f.ss_check_box "items[#{p.id}][exposed]", id: "br-#{p.id}", checked: e.present?, disabled: !admin, class: "size-5",
                               wrapper_class: "min-w-0 flex-1 [&>label]:gap-3 [&>label]:cursor-pointer",
                               label: safe_join([ tag.span(icon(point_icon(p)), class: "ss-icon-tile #{e ? 'is-grad' : 'is-accent'}"),
                                                  tag.span(class: "min-w-0") { safe_join([ tag.span(title, class: "block font-bold text-ink truncate"),
                                                                                           tag.span([ context, @bridge.label(type) ].compact.join(" · "), class: "block text-xs text-muted truncate") ]) } ]) %>
            <div class="flex items-center gap-2 w-full sm:w-auto">
              <% if critical %><span class="ss-badge ss-badge-danger shrink-0"><%= t("bridges.critical") %></span><% end %>
              <%= f.ss_text_field "items[#{p.id}][name]", id: "brn-#{p.id}", value: e&.name, label: t("bridges.name_of", name: p.name), hide_label: true, placeholder: t("bridges.name_in_app", name: p.name),
                                  maxlength: 60, disabled: !admin, class: "text-sm sm:w-56" %>
            </div>
            <% if critical && admin && e.nil? %>
              <%= f.ss_check_box "items[#{p.id}][confirm]", id: "brc-#{p.id}", checked: false, include_hidden: false, label: t("bridges.confirm", name: p.name),
                                 wrapper_class: "w-full text-sm text-danger" %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if admin %><div class="ss-card-pad border-t border-line"><%= f.ss_submit t("integrations.common.save"), name: nil %></div><% end %>
    <% end %>
  <% end %>

  <div class="grid gap-4">
    <section class="ss-card ss-card-pad" aria-labelledby="pair-t">
      <div class="flex items-center justify-between gap-2">
        <h2 id="pair-t" class="font-bold"><%= t("bridges.pair") %></h2>
        <% if @status.nil? %>
          <span class="ss-badge ss-badge-muted"><%= t("bridges.service_down") %></span>
        <% elsif ActiveModel::Type::Boolean.new.cast(@status["commissioned"]) %>
          <span class="ss-badge ss-badge-success"><%= t("bridges.paired") %><%= " · #{t("bridges.apps", n: @status['fabrics'])}" if @status["fabrics"].to_i.positive? %></span>
        <% else %>
          <span class="ss-badge ss-badge-warn"><%= t("bridges.waiting") %></span>
        <% end %>
      </div>
      <% if @status && @status["qr"].present? %>
        <div class="ss-qr-box mt-3 mx-auto w-48" role="img" aria-label="<%= t("bridges.qr") %>">
          <%= RQRCode::QRCode.new(@status["qr"]).as_svg(module_size: 4, standalone: true, use_path: true, viewbox: true).html_safe %>
        </div>
        <p class="mt-2 text-center text-sm text-muted"><%= t("bridges.or_code") %></p>
        <p class="text-center font-mono text-lg font-bold tracking-wider num"><%= @bridge.format_code(@status["manual"]) %></p>
        <p class="mt-2 text-xs text-muted"><%= @bridge.pair_help %></p>
      <% elsif @status.nil? %>
        <p class="mt-2 text-sm text-muted"><%= sanitize(@bridge.start_html) %></p>
      <% end %>
    </section>

    <section class="ss-card ss-card-pad" aria-labelledby="key-t">
      <h2 id="key-t" class="font-bold"><%= t("bridges.key") %></h2>
      <p class="text-sm text-muted mt-1"><%= t("bridges.key_hint") %></p>
      <% if @key %>
        <p class="text-xs text-muted mt-2"><%= t("bridges.key_once") %></p>
        <%= render Ss::CodeBlockComponent.new(text: @key, label: t("bridges.key_once"), css: "mt-1") %>
      <% end %>
      <% if admin %>
        <%= render Ss::ButtonComponent.new(label: t("bridges.generate"), href: service_key_site_bridge_path(@site, @bridge.key), method: :post, variant: :ghost, css: "mt-3", form: { data: { turbo: false } }) %>
        <p class="text-xs text-muted mt-2"><%= t("bridges.old_keys") %></p>
      <% end %>
    </section>
  </div>
</div>
