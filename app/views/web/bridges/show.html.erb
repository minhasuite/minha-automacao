<%= render "web/shared/header", title: t("bridges.title", name: @bridge.title), subtitle: "#{@site.name} · #{@bridge.description}", back: site_path(@site) %>
<%= render "web/sites/tabs", site: @site, current: :"bridge_#{@bridge.key}" %>
<% admin = can?(:admin) %>

<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
  <%= form_with url: site_bridge_path(@site, @bridge.key), method: :patch, class: "ss-card min-w-0", aria: { label: t("bridges.exposed_on", name: @bridge.title) }, data: { controller: "filter" } do %>
    <div class="ss-card-pad flex flex-wrap items-center justify-between gap-2 border-b border-line">
      <div>
        <h2 class="font-bold"><%= t("bridges.exposed") %></h2>
        <p class="text-sm text-muted"><%= t("bridges.count_html", n: tag.span(@exposed.size, class: "num"), total: tag.span(@items.size, class: "num")) %></p>
      </div>
      <% if admin && @items.any? %><%= submit_tag t("integrations.common.save"), class: "ss-btn ss-btn-primary", name: nil %><% end %>
    </div>
    <% if @items.empty? %>
      <p class="ss-card-pad text-sm text-muted"><%= t("bridges.empty") %></p>
    <% else %>
      <div class="ss-card-pad border-b border-line">
        <label for="br-busca" class="ss-label"><%= t("bridges.search") %></label>
        <input type="search" id="br-busca" class="ss-input" placeholder="<%= t("bridges.search_hint") %>" autocomplete="off" data-filter-target="input" data-action="input->filter#apply">
        <p class="text-sm text-muted mt-2" data-filter-target="empty" hidden><%= t("bridges.no_match") %> <button type="button" class="font-semibold text-accent" data-action="filter#clear"><%= t("bridges.clear") %></button></p>
      </div>
      <ul class="ss-rows">
        <% @items.each do |p, type| %>
          <% e = @exposed[p.id] %>
          <% critical = p.risk == "critical" %>
          <li class="flex-wrap" data-filter-target="item">
            <label class="flex items-center gap-3 min-w-0 flex-1 cursor-pointer">
              <%= hidden_field_tag "items[#{p.id}][exposed]", "0", id: nil %>
              <%= check_box_tag "items[#{p.id}][exposed]", "1", e.present?, id: "br-#{p.id}", disabled: !admin, class: "size-5 accent-[var(--accent)]" %>
              <span class="grid place-items-center size-10 shrink-0 rounded-xl <%= e ? 'ss-grad' : 'bg-accent-soft text-accent' %>"><%= icon(point_icon(p)) %></span>
              <span class="min-w-0">
                <% title, context = p.display_names %>
                <span class="block font-bold text-ink truncate"><%= title %></span>
                <span class="block text-xs text-muted truncate"><%= [ context, @bridge.label(type) ].compact.join(" · ") %></span>
              </span>
            </label>
            <div class="flex items-center gap-2 w-full sm:w-auto">
              <% if critical %><span class="ss-badge ss-badge-danger shrink-0"><%= t("bridges.critical") %></span><% end %>
              <%= text_field_tag "items[#{p.id}][name]", e&.name, placeholder: t("bridges.name_in_app", name: p.name), maxlength: 60, disabled: !admin,
                                 class: "ss-input text-sm sm:w-56", "aria-label": t("bridges.name_of", name: p.name) %>
            </div>
            <% if critical && admin && e.nil? %>
              <label class="ss-check w-full text-sm text-danger">
                <%= check_box_tag "items[#{p.id}][confirm]", "1", false, id: "brc-#{p.id}" %>
                <%= t("bridges.confirm", name: p.name) %>
              </label>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if admin %><div class="ss-card-pad border-t border-line"><%= submit_tag t("integrations.common.save"), class: "ss-btn ss-btn-primary", name: nil %></div><% end %>
    <% end %>
  <% end %>

  <div class="grid gap-4">
    <section class="ss-card ss-card-pad" aria-labelledby="pair-t">
      <div class="flex items-center justify-between gap-2">
        <h2 id="pair-t" class="font-bold"><%= t("bridges.pair") %></h2>
        <% if @status.nil? %>
          <span class="ss-badge ss-badge-muted"><%= t("bridges.service_down") %></span>
        <% elsif ActiveModel::Type::Boolean.new.cast(@status["commissioned"]) %>
          <span class="ss-badge ss-badge-success"><%= t("bridges.paired") %><%= " · #{t("bridges.apps", n: @status['fabrics'])}" if @status["fabrics"].to_i.positive? %></span>
        <% else %>
          <span class="ss-badge ss-badge-warn"><%= t("bridges.waiting") %></span>
        <% end %>
      </div>
      <% if @status && @status["qr"].present? %>
        <div class="mt-3 mx-auto w-48 rounded-xl bg-white p-2" role="img" aria-label="<%= t("bridges.qr") %>">
          <%= RQRCode::QRCode.new(@status["qr"]).as_svg(module_size: 4, standalone: true, use_path: true, viewbox: true).html_safe %>
        </div>
        <p class="mt-2 text-center text-sm text-muted"><%= t("bridges.or_code") %></p>
        <p class="text-center font-mono text-lg font-bold tracking-wider num"><%= @bridge.format_code(@status["manual"]) %></p>
        <p class="mt-2 text-xs text-muted"><%= @bridge.pair_help %></p>
      <% elsif @status.nil? %>
        <p class="mt-2 text-sm text-muted"><%= sanitize(@bridge.start_html) %></p>
      <% end %>
    </section>

    <section class="ss-card ss-card-pad" aria-labelledby="key-t">
      <h2 id="key-t" class="font-bold"><%= t("bridges.key") %></h2>
      <p class="text-sm text-muted mt-1"><%= t("bridges.key_hint") %></p>
      <% if @key %>
        <div class="mt-2 rounded-xl bg-accent-soft p-2"><p class="text-xs text-muted"><%= t("bridges.key_once") %></p><p class="font-mono text-xs break-all"><%= @key %></p></div>
      <% end %>
      <% if admin %>
        <%= button_to t("bridges.generate"), service_key_site_bridge_path(@site, @bridge.key), class: "ss-btn ss-btn-ghost mt-3", form: { data: { turbo: false } } %>
        <p class="text-xs text-muted mt-2"><%= t("bridges.old_keys") %></p>
      <% end %>
    </section>
  </div>
</div>
