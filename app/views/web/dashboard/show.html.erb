<%= render "web/shared/header", title: "#{greeting}, #{current_user.name.split.first}", subtitle: "#{l(Date.current, format: :long).upcase_first} · #{current_user.tenant.trade_name.presence || current_user.tenant.name}" %>

<div class="grid gap-4 md:grid-cols-3">
  <% if @sites.empty? %>
    <section class="ss-hero ss-rise p-6 md:col-span-2 flex flex-col gap-3" aria-label="Boas-vindas">
      <p class="ss-kicker">Minha Automação</p>
      <p class="text-2xl font-bold">Vamos montar a sua casa.</p>
      <% if current_user.admin? %>
        <p class="text-sm opacity-90">Crie o local, as áreas (sala, cozinha, garagem) e os dispositivos. Comece com pontos virtuais para testar sem aparelho nenhum.</p>
        <div><%= link_to new_site_path, class: "ss-btn bg-white text-accent font-bold" do %><%= icon("plus", "size-4") %>Criar meu primeiro local<% end %></div>
      <% else %>
        <p class="text-sm opacity-90">Você ainda não tem acesso a nenhum local. Peça ao dono da empresa.</p>
      <% end %>
    </section>
  <% else %>
    <section class="ss-hero ss-rise p-6 md:col-span-2 flex flex-col gap-3" aria-label="Resumo">
      <p class="ss-kicker">Seus locais</p>
      <p class="text-2xl font-bold"><%= count_label(@sites.size, "local", "locais") %>, <%= count_label(@points_count, "ponto", "pontos") %></p>
      <div class="flex flex-wrap gap-2">
        <% @sites.first(6).each do |site| %>
          <%= link_to site, class: "ss-hero-chip no-underline text-white font-semibold text-sm" do %><%= icon(site_icon(site), "size-4") %><%= site.name %><% end %>
        <% end %>
      </div>
    </section>
  <% end %>
  <%= link_to notifications_path, class: "ss-card ss-card-pad no-underline ss-rise", style: "animation-delay: 60ms" do %>
    <div class="flex items-start justify-between gap-3"><p class="ss-kicker">Notificações</p><span class="ss-icon-tile text-accent"><%= icon("bell") %></span></div>
    <p class="ss-stat -mt-1"><%= @unread %></p>
    <p class="text-sm mt-1 text-muted"><%= @unread == 1 ? "não lida" : "não lidas" %></p>
  <% end %>
</div>

<div class="mt-4 grid gap-4 md:grid-cols-2">
  <%= link_to sites_path, class: "ss-card p-4 no-underline flex items-center gap-3" do %>
    <span class="grid place-items-center size-11 rounded-xl bg-accent-soft text-accent"><%= icon("home") %></span>
    <span class="flex-1"><span class="block font-bold text-ink">Locais</span>
      <span class="block text-sm text-muted">Áreas, dispositivos e o controle dos pontos.</span></span>
    <%= icon("chevron-right", "size-4 text-muted") %>
  <% end %>
  <%= link_to settings_path, class: "ss-card p-4 no-underline flex items-center gap-3" do %>
    <span class="grid place-items-center size-11 rounded-xl bg-accent-soft text-accent"><%= icon("cog") %></span>
    <span class="flex-1"><span class="block font-bold text-ink">Configurações</span>
      <span class="block text-sm text-muted">Empresa, plano, convites e a sua conta.</span></span>
    <%= icon("chevron-right", "size-4 text-muted") %>
  <% end %>
</div>
