<%# locals: (site:, record:) -%>
<%= ss_form_with model: record.new_record? ? [ site, record ] : record, class: "ss-card ss-card-pad grid gap-4 md:grid-cols-3 max-w-4xl" do |f| %>
  <%= render "web/shared/errors", record: record %>
  <%= hidden_field_tag :back, params[:back], id: nil %>
  <div class="md:col-span-3"><%= f.ss_text_field :name, label: t("automations.settings.name"), required: true, placeholder: t("automations.schedules.name_ph"), autofocus: true %></div>
  <%= f.ss_select :kind, Schedule::KINDS.invert, label: t("automations.kind_titles.triggers") %>
  <%= f.ss_time_field :time_of_day, label: t("automations.schedules.time"), class: "num" %>
  <%= render Ss::StepperInputComponent.new(name: "schedule[offset_min]", value: record.offset_min || 0, min: -720, max: 720, step: 5, unit: "min", label: t("automations.schedules.offset"), id: "schedule_offset_min") %>
  <div class="md:col-span-3">
    <%= render Ss::WeekdayPickerComponent.new(name: "schedule[days]", selected: record.days, values: [ 1, 2, 3, 4, 5, 6, 0 ], first_day: 7, legend: t("automations.schedules.days")) %>
  </div>
  <%= f.ss_select :point_id, point_choices(site, writable: true), label: t("automations.labels.field_types.point"), include_blank: t("automations.schedules.no_point") %>
  <%= f.ss_select :command, AutomationHelper::COMMAND_CHOICES, label: t("automations.schedules.command"), include_blank: true %>
  <%= f.ss_text_field :value, label: t("automations.schedules.value"), value: record.value %>
  <div class="md:col-span-3"><%= f.ss_select :scene_id, site.scenes.order(:name).pluck(:name, :id), label: t("automations.schedules.scene"), include_blank: t("automations.settings.none") %></div>
  <%= render Ss::SwitchComponent.new(name: "schedule[enabled]", checked: record.enabled, label: t("automations.schedules.active"), show_label: true, id: "schedule_enabled") %>
  <% if record.next_run_at && record.enabled %><p class="md:col-span-2 text-sm text-muted"><%= t("automations.schedules.next", at: l(record.next_run_at.in_time_zone(site.timezone), format: :short)) %></p><% end %>
  <div class="md:col-span-3 flex flex-wrap gap-2">
    <%= f.submit t("automations.schedules.save"), class: "ss-btn ss-btn-primary" %>
    <%= link_to t("automations.settings.cancel"), back_path, class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
