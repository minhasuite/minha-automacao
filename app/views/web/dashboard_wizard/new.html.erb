<%= render "web/shared/header", title: t("arrange.wizard.title"), subtitle: t("arrange.wizard.subtitle", site: @site.name), back: site_dashboards_path(@site) %>
<%= ss_form_with url: site_dashboard_wizard_path(@site), method: :post, class: "grid gap-6 max-w-3xl", data: { turbo_submits_with: t("arrange.wizard.creating") } do |f| %>
  <%= f.ss_text_field :name, label: t("arrange.wizard.name"), value: t("arrange.wizard.default_name"), id: "wz-name", maxlength: 60, required: true, wrapper_class: "max-w-sm" %>
  <div class="ss-card ss-card-pad"><%= render "web/dashboard_wizard/fields", areas: @areas %></div>
  <fieldset>
    <legend class="ss-label"><%= t("onboarding.dashboard.theme") %></legend>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(8.5rem,1fr))] gap-3">
      <% Dashboards::Themes.plugins.each_with_index do |th, i| %>
        <%= f.ss_swatch_radio :theme, th.key, label: th.label, style: dw_swatch_style(th), size: :lg, block: true, checked: i.zero?, id: "wz-t-#{th.key}" %>
      <% end %>
    </div>
  </fieldset>
  <p class="text-sm text-muted"><%= t("arrange.wizard.hint") %></p>
  <div><%= f.ss_submit t("arrange.wizard.submit"), data: { turbo_submits_with: t("arrange.wizard.creating") } %></div>
<% end %>
