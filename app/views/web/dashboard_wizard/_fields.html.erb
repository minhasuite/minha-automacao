<%# locals: (areas:, scope: nil, layout: "columns") -%>
<%# Ideia 8: cômodos e estilo do assistente (Dashboards::Wizard), na primeira configuração e em Painéis. %>
<%= ss_fields scope do |f| %>
  <fieldset>
    <legend class="ss-label"><%= t("arrange.wizard.areas") %></legend>
    <% if areas.empty? %>
      <p class="text-sm text-muted"><%= t("arrange.wizard.no_areas") %></p>
    <% else %>
      <div class="ss-inputs flex flex-wrap gap-x-4 gap-y-2">
        <% areas.each do |a| %>
          <%= f.ss_check_box :areas, multiple: true, label: a.name, checked_value: a.id, unchecked_value: nil, checked: true, id: "wz-a-#{a.id}" %>
        <% end %>
      </div>
    <% end %>
    <%= f.hidden_field :areas, multiple: true, value: "", id: nil %>
  </fieldset>
  <%= f.ss_radio_buttons :layout,
                         Dashboards::Wizard.layouts.map { |key, label, hint| [ safe_join([ tag.span(label, class: "block font-semibold text-ink"), tag.span(hint, class: "block text-xs text-muted") ]), key ] },
                         label: t("arrange.wizard.layout"), inline: false, checked: layout, wrapper_class: "mt-4" %>
<% end %>
