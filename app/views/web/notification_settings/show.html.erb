<%= render "web/shared/header", title: t("settings.title"), subtitle: t("notifications.settings.subtitle") %>
<%= render layout: "web/settings/frame", locals: { current: :notifications } do %>
<%= form_with scope: :prefs, url: settings_notifications_path, method: :patch, class: "grid gap-4" do |f| %>
  <section class="ss-card ss-card-pad" aria-labelledby="silencio-t">
    <h2 id="silencio-t" class="flex items-center gap-2"><%= icon("moon", "size-4") %><%= t("notifications.settings.quiet_title") %></h2>
    <p class="text-sm text-muted mt-1"><%= t("notifications.settings.quiet_text") %></p>
    <div class="mt-3 grid gap-4 sm:grid-cols-3 items-end">
      <label class="ss-check"><%= f.check_box :quiet_enabled, checked: @prefs.dig("quiet", "enabled") == true %> <%= t("notifications.settings.quiet_on") %></label>
      <div><%= f.label :quiet_from, t("notifications.settings.from"), class: "ss-label" %><%= f.time_field :quiet_from, value: @prefs.dig("quiet", "from"), class: "ss-input" %></div>
      <div><%= f.label :quiet_to, t("notifications.settings.to"), class: "ss-label" %><%= f.time_field :quiet_to, value: @prefs.dig("quiet", "to"), class: "ss-input" %></div>
    </div>
  </section>

  <section class="ss-card ss-card-pad" id="resumo" aria-labelledby="resumo-t">
    <h2 id="resumo-t" class="flex items-center gap-2"><%= icon("calendar", "size-4") %><%= t("notifications.settings.digest_title") %></h2>
    <p class="text-sm text-muted mt-1"><%= t("notifications.settings.digest_text") %></p>
    <div class="mt-3 grid gap-4 sm:grid-cols-3 items-end">
      <label class="ss-check"><%= f.check_box :digest_enabled, checked: @prefs.dig("digest", "enabled") == true %> <%= t("notifications.settings.digest_on") %></label>
      <div><%= f.label :digest_at, t("notifications.settings.digest_at"), class: "ss-label" %><%= f.time_field :digest_at, value: @prefs.dig("digest", "at"), class: "ss-input" %></div>
      <div><%= link_to digest_notifications_path, class: "ss-btn ss-btn-ghost" do %><%= icon("calendar", "size-4") %><%= t("notifications.digest.open") %><% end %></div>
    </div>
  </section>

  <section class="ss-card ss-card-pad" aria-labelledby="silenciar-t">
    <h2 id="silenciar-t" class="flex items-center gap-2"><%= icon("volume-off", "size-4") %><%= t("notifications.settings.mute_title") %></h2>
    <p class="text-sm text-muted mt-1"><%= t("notifications.settings.mute_text") %></p>
    <div class="mt-3 max-w-xs"><%= f.label :mute_hours, t("notifications.settings.mute_hours"), class: "ss-label" %><%= f.select :mute_hours, mute_hours_choices, { selected: @prefs["mute_hours"].to_i }, class: "ss-input" %></div>
  </section>

  <% if @house %>
    <section class="ss-card ss-card-pad" aria-labelledby="casa-t">
      <h2 id="casa-t" class="flex items-center gap-2"><%= icon("home", "size-4") %><%= t("notifications.settings.house_title") %></h2>
      <p class="text-sm text-muted mt-1"><%= t("notifications.settings.house_text") %></p>
      <div class="mt-3 grid gap-4 sm:grid-cols-3 items-end">
        <label class="ss-check"><%= f.check_box :house_quiet_enabled, checked: @house.dig("quiet", "enabled") == true %> <%= t("notifications.settings.house_quiet_on") %></label>
        <div><%= f.label :house_quiet_from, t("notifications.settings.from"), class: "ss-label" %><%= f.time_field :house_quiet_from, value: @house.dig("quiet", "from"), class: "ss-input" %></div>
        <div><%= f.label :house_quiet_to, t("notifications.settings.to"), class: "ss-label" %><%= f.time_field :house_quiet_to, value: @house.dig("quiet", "to"), class: "ss-input" %></div>
        <div class="sm:col-span-3 max-w-xs"><%= f.label :merge_s, t("notifications.merge.label"), class: "ss-label" %><%= f.select :merge_s, notification_merge_choices, { selected: @house["merge_s"].to_i }, class: "ss-input" %>
          <p class="text-xs text-muted mt-1"><%= t("notifications.merge.house_hint") %></p></div>
      </div>
    </section>
  <% end %>
  <div><%= f.submit t("notifications.settings.save"), class: "ss-btn ss-btn-primary" %></div>
<% end %>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="silenciados-t">
  <h2 id="silenciados-t"><%= t("notifications.mute.active") %></h2>
  <% if @mutes.any? %>
    <ul class="mt-2 grid gap-2">
      <% @mutes.each do |m| %>
        <li class="flex flex-wrap items-center justify-between gap-2">
          <span class="min-w-0"><span class="font-semibold"><%= m["label"] %></span> <span class="text-sm text-muted"><%= t("notifications.mute.until", time: l(m["until"].in_time_zone(Notifications.zone(current_user.tenant)), format: :short)) %></span></span>
          <%= button_to unmute_notifications_path(key: m["key"]), method: :delete, class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("bell", "size-4") %><%= t("notifications.mute.undo") %><% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-muted mt-1"><%= t("notifications.mute.none") %></p>
  <% end %>
</section>
<% end %>
