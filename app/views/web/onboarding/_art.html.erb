<%# locals: (art:) -%>
<%# Ilustrações próprias da primeira configuração (SVG): o desenho usa as peças de ilustração da gem (ss-ill-floor, -card,
    -soft, -orbit, -accent, as mesmas do EmptyStateComponent) e só o que é desta arte fica em oba- (gradiente, telhado,
    aparelho, rota e os movimentos). %>
<svg viewBox="0 0 320 260" class="w-full max-w-[20rem] h-auto overflow-visible" role="presentation" focusable="false">
  <defs>
    <linearGradient id="oba-g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" class="[stop-color:var(--accent)]"/><stop offset="1" class="[stop-color:var(--series-2)]"/></linearGradient>
    <radialGradient id="oba-glow" cx=".5" cy=".5" r=".5"><stop offset="0" class="[stop-color:var(--accent)]" stop-opacity=".35"/><stop offset="1" class="[stop-color:var(--accent)]" stop-opacity="0"/></radialGradient>
  </defs>
  <circle cx="160" cy="130" r="118" fill="url(#oba-glow)"/>
  <ellipse cx="160" cy="232" rx="104" ry="9" class="ss-ill-floor"/>
  <% case art %>
  <% when "welcome" %>
    <%# Casa com a chave chegando e brilhos. %>
    <g class="ss-anim-float">
      <path d="M86 128 160 66l74 62v84a8 8 0 0 1-8 8H94a8 8 0 0 1-8-8z" class="ss-ill-card"/>
      <path d="M72 132 160 58l88 74" class="stroke-accent stroke-[10] [stroke-linecap:round] [stroke-linejoin:round]" fill="none"/>
      <rect x="138" y="160" width="44" height="60" rx="6" fill="url(#oba-g)"/>
      <circle cx="173" cy="192" r="3.5" class="fill-[var(--on-accent)]"/>
      <rect x="102" y="140" width="28" height="24" rx="5" class="fill-accent-soft stroke-accent stroke-2"/>
      <rect x="190" y="140" width="28" height="24" rx="5" class="fill-accent-soft stroke-accent stroke-2 ss-anim-blink"/>
    </g>
    <g class="ss-anim-float [--ss-anim-dur:4s] [--ss-anim-dir:reverse]"><circle cx="252" cy="70" r="16" fill="url(#oba-g)"/><path d="m246 70 4 4 8-9" class="fill-none stroke-[var(--on-accent)] stroke-5 [stroke-linecap:round] [stroke-linejoin:round]"/></g>
    <path d="M60 80l4-9 4 9 9 4-9 4-4 9-4-9-9-4z" class="fill-accent ss-anim-twinkle"/>
    <path d="M262 168l3-6 3 6 6 3-6 3-3 6-3-6-6-3z" class="fill-[var(--series-2)] ss-anim-twinkle [--ss-anim-delay:1.2s]"/>
  <% when "home" %>
    <%# Mapa com o pino da casa e o sol do clima. %>
    <g class="ss-anim-float">
      <path d="M58 92 120 70l80 22 62-22v128l-62 22-80-22-62 22z" class="ss-ill-card"/>
      <path d="M120 70v128M200 92v128" class="stroke-line stroke-2 fill-none"/>
      <path d="M70 160c30-10 50 20 90 6s60-36 92-20" class="fill-none stroke-accent stroke-3 [stroke-dasharray:6_7] [stroke-linecap:round] ss-anim-dash"/>
    </g>
    <g class="animate-[ss-a-from_.9s_cubic-bezier(.3,1.5,.5,1)_both,ss-a-float_6s_1s_ease-in-out_infinite] [--ss-anim-from:translateY(-40px)] [--ss-anim-from-opacity:0] motion-reduce:animate-none">
      <path d="M160 56c-22 0-38 16-38 36 0 28 38 64 38 64s38-36 38-64c0-20-16-36-38-36z" fill="url(#oba-g)"/>
      <path d="M146 96 160 84l14 12v14h-28z" class="fill-[var(--on-accent)]"/>
    </g>
    <g class="ss-anim-spin [--ss-anim-dur:18s] [transform-origin:252px_58px]"><circle cx="252" cy="58" r="14" class="fill-warn"/><path d="M252 34v-8M252 90v-8M228 58h-8M284 58h-8M235 41l-6-6M275 81l-6-6M235 75l-6 6M275 35l-6 6" class="stroke-warn stroke-3 [stroke-linecap:round]"/></g>
  <% when "radar" %>
    <%# Radar procurando aparelhos na rede. %>
    <circle cx="160" cy="130" r="92" class="ss-ill-orbit"/><circle cx="160" cy="130" r="62" class="ss-ill-orbit"/><circle cx="160" cy="130" r="32" class="ss-ill-orbit"/>
    <g class="ss-anim-spin [--ss-anim-dur:3s] [transform-origin:160px_130px]"><path d="M160 130 160 38A92 92 0 0 1 240 84z" fill="url(#oba-g)" opacity=".35"/></g>
    <circle cx="160" cy="130" r="10" fill="url(#oba-g)"/>
    <g class="ss-anim-blip" style="animation-delay: .2s"><rect x="210" y="72" width="26" height="18" rx="4" class="fill-surface stroke-accent stroke-[2.5]"/></g>
    <g class="ss-anim-blip" style="animation-delay: 1.1s"><circle cx="96" cy="170" r="11" class="fill-surface stroke-accent stroke-[2.5]"/></g>
    <g class="ss-anim-blip" style="animation-delay: 1.9s"><rect x="196" y="176" width="16" height="24" rx="4" class="fill-surface stroke-accent stroke-[2.5]"/></g>
    <g class="ss-anim-blip" style="animation-delay: 2.6s"><path d="M98 84h20l-4 16h-12z" class="fill-surface stroke-accent stroke-[2.5]"/></g>
  <% when "rooms" %>
    <%# Planta com cômodos e um aparelho sendo arrastado. %>
    <g class="ss-anim-float">
      <rect x="62" y="56" width="196" height="150" rx="14" class="ss-ill-card"/>
      <path d="M62 128h104M166 56v150M166 150h92" class="stroke-line stroke-2 fill-none"/>
      <rect x="76" y="70" width="76" height="44" rx="8" class="ss-ill-soft"/>
      <rect x="180" y="164" width="64" height="30" rx="8" class="ss-ill-soft"/>
    </g>
    <g class="ss-anim-shuttle [--ss-anim-to:translate(-118px,2px)]">
      <rect x="196" y="78" width="54" height="34" rx="9" fill="url(#oba-g)"/>
      <circle cx="212" cy="95" r="6" class="fill-[var(--on-accent)]"/><rect x="222" y="91" width="20" height="4" rx="2" class="fill-[var(--on-accent)]"/><rect x="222" y="99" width="12" height="4" rx="2" class="fill-[var(--on-accent)]" opacity=".7"/>
      <path d="M244 112l10 22 4-9 9-4z" class="fill-ink stroke-surface stroke-2"/>
    </g>
  <% when "board" %>
    <%# Painel pronto com cartões e gráfico. %>
    <g class="ss-anim-float">
      <rect x="52" y="52" width="216" height="160" rx="16" class="ss-ill-card"/>
      <rect x="52" y="52" width="216" height="44" rx="16" fill="url(#oba-g)"/>
      <rect x="66" y="66" width="70" height="8" rx="4" class="fill-[var(--on-accent)]"/><rect x="66" y="79" width="44" height="6" rx="3" class="fill-[var(--on-accent)]" opacity=".7"/>
      <rect x="66" y="108" width="58" height="40" rx="10" class="ss-ill-soft"/><rect x="132" y="108" width="58" height="40" rx="10" class="ss-ill-soft"/><rect x="198" y="108" width="56" height="40" rx="10" class="ss-ill-soft ss-anim-blink"/>
      <circle cx="82" cy="124" r="7" class="ss-ill-accent"/><circle cx="148" cy="124" r="7" class="ss-ill-accent" opacity=".5"/>
      <rect x="66" y="156" width="188" height="44" rx="10" class="ss-ill-soft"/>
      <path d="M74 190l26-14 22 8 26-18 24 10 26-14 24 6 24-10" class="fill-none stroke-accent stroke-3 [stroke-linecap:round] [stroke-linejoin:round] [stroke-dasharray:240] [stroke-dashoffset:240] motion-reduce:[stroke-dashoffset:0] ss-anim-draw [--ss-anim-dur:2.2s] [--ss-anim-delay:.3s]"/>
    </g>
  <% when "family" %>
    <%# Família com o celular e o QR. %>
    <g class="ss-anim-float">
      <circle cx="110" cy="104" r="22" class="ss-ill-soft"/><path d="M70 196c0-26 18-46 40-46s40 20 40 46z" class="ss-ill-soft"/>
      <circle cx="166" cy="116" r="17" fill="url(#oba-g)"/><path d="M136 196c0-20 13-36 30-36s30 16 30 36z" fill="url(#oba-g)"/>
    </g>
    <g class="animate-[ss-a-from_.9s_cubic-bezier(.3,1.5,.5,1)_both,ss-a-float_6s_1s_ease-in-out_infinite] [--ss-anim-from:translateY(-40px)] [--ss-anim-from-opacity:0] motion-reduce:animate-none">
      <rect x="206" y="62" width="64" height="118" rx="12" class="fill-ink"/>
      <rect x="214" y="76" width="48" height="48" rx="6" class="fill-[var(--on-accent)]"/>
      <path d="M220 82h12v12h-12zM244 82h12v12h-12zM220 106h12v12h-12zM238 100h6v6h-6zM248 110h8v8h-8z" class="fill-[color-mix(in_srgb,var(--ink)_85%,var(--accent))]"/>
      <rect x="216" y="134" width="44" height="8" rx="4" class="fill-[var(--on-accent)]" opacity=".8"/><rect x="224" y="148" width="28" height="8" rx="4" fill="url(#oba-g)"/>
    </g>
    <path d="M196 80c-8-6-18-6-26 0" class="fill-none stroke-accent stroke-3 [stroke-linecap:round] ss-anim-twinkle [--ss-anim-dur:1.8s]"/><path d="M200 70c-14-10-32-10-46 0" class="fill-none stroke-accent stroke-3 [stroke-linecap:round] ss-anim-twinkle [--ss-anim-dur:1.8s] [--ss-anim-delay:.4s]"/>
  <% else %>
    <g class="ss-anim-float"><rect x="90" y="70" width="140" height="120" rx="18" fill="url(#oba-g)"/><path d="m140 130 16 16 30-34" class="fill-none stroke-[var(--on-accent)] stroke-5 [stroke-linecap:round] [stroke-linejoin:round]"/></g>
  <% end %>
</svg>
