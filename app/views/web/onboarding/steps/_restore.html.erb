<%# locals: (ctx:, step:, available:, status:) -%>
<% if status["state"] == "running" %>
  <div class="ss-card ss-card-pad max-w-lg" role="status" aria-live="polite" data-controller="ss-reload" data-ss-reload-every-value="5000">
    <p class="font-bold text-ink flex items-center gap-2"><span class="ss-spinner is-sm" aria-hidden="true"></span><%= t("backup_restore.states.running") %></p>
    <p class="text-sm text-muted mt-1"><%= t("backup_restore.onboarding_wait") %></p>
  </div>
<% else %>
  <%= ss_form_with url: onboarding_step_path(step.key), scope: :onboarding, multipart: true, class: "grid gap-4 max-w-lg", data: { turbo: false } do |f| %>
    <% unless available %><%= render(Ss::CalloutComponent.new(tone: :warn)) { t("backup_restore.no_supervisor") } %><% end %>
    <%= f.ss_file_field :file, label: t("backup_restore.file"), accept: ".gz,.enc", required: true %>
    <%= f.ss_password_field :passphrase, label: t("backup_restore.passphrase"), autocomplete: "off" %>
    <p class="text-xs text-muted"><%= t("backup_restore.upload_hint") %></p>
    <div class="flex flex-wrap items-center gap-3">
      <%= f.ss_submit t("backup_restore.submit"), css: "min-h-12", disabled: !available %>
      <%= link_to t("backup_restore.fresh"), onboarding_step_path("account"), class: "text-sm font-bold text-accent" %>
    </div>
  <% end %>
<% end %>
