<%# locals: (ctx:, step:, site:, weather:) -%>
<% v = params[:onboarding] || {} %>
<%= ss_form_with url: onboarding_step_path(step.key), scope: :onboarding, class: "grid gap-4 grid-cols-2", data: { controller: "onboarding-home", turbo_submits_with: t("onboarding.saving"), onboarding_home_found_value: t("onboarding.home.located"), onboarding_home_denied_value: t("onboarding.home.locate_failed") } do |f| %>
  <%= f.ss_text_field :name, label: t("onboarding.home.name"), value: v[:name] || site.name, required: true, autofocus: true, wrapper_class: "col-span-2" %>
  <fieldset class="col-span-2">
    <legend class="ss-label"><%= t("onboarding.home.kind") %></legend>
    <%# Tipo do local: Ss::OptionCardComponent em tiles (ícone em cima) numa grade de três. %>
    <div class="ss-option-grid is-tiles grid-cols-3" role="radiogroup" aria-label="<%= t("onboarding.home.kind") %>">
      <% { "home" => "home", "store" => "shopping-bag", "plant" => "office-building" }.each do |kind, ico| %>
        <%= render Ss::OptionCardComponent.new(name: "onboarding[kind]", value: kind, id: "onboarding_kind_#{kind}", checked: (v[:kind] || site.kind) == kind,
                                               title: t("onboarding.home.kinds.#{kind}"), icon: icon(ico, ""), vertical: true, dense: true) %>
      <% end %>
    </div>
  </fieldset>
  <%= f.ss_select :timezone, ActiveSupport::TimeZone.all.map { |z| [ z.to_s, z.tzinfo.name ] }.uniq(&:last), label: t("onboarding.home.timezone"),
                  selected: v[:timezone] || site.timezone || "America/Sao_Paulo", data: { onboarding_home_target: "zone", fresh: ctx.site.nil? }, wrapper_class: "col-span-2" %>
  <%# Localização num aviso da gem com o botão de pedir ao navegador; a linha de status muda pelo controller. %>
  <%= render Ss::CalloutComponent.new(tone: :accent, title: t("onboarding.home.location"), icon: icon("location-marker", ""), css: "col-span-2") do |c| %>
    <% c.with_action do %><%= render Ss::ButtonComponent.new(label: t("onboarding.home.locate"), icon: icon("location-marker", ""), variant: :outline, size: :sm, data: { action: "onboarding-home#locate" }) %><% end %>
    <p data-onboarding-home-target="status" role="status"><%= t("onboarding.home.location_hint") %></p>
  <% end %>
  <%= f.ss_text_field :latitude, label: t("onboarding.home.latitude"), value: v[:latitude] || site.latitude, class: "num", inputmode: "decimal", placeholder: "-15.79", data: { onboarding_home_target: "lat" } %>
  <%= f.ss_text_field :longitude, label: t("onboarding.home.longitude"), value: v[:longitude] || site.longitude, class: "num", inputmode: "decimal", placeholder: "-47.88", data: { onboarding_home_target: "lon" } %>
  <%= f.ss_check_box :weather, label: tag.span { safe_join([ tag.strong(t("onboarding.home.weather"), class: "text-ink"), " ", tag.span(t("onboarding.home.weather_hint"), class: "text-muted text-sm") ]) },
                     checked: weather, wrapper_class: "col-span-2" %>
  <div class="col-span-2"><%= render "web/onboarding/nav", step: step %></div>
<% end %>
