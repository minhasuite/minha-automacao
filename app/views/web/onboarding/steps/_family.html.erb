<%# locals: (ctx:, step:) -%>
<% invite = ctx.data[:invite_url] %>
<%= ss_form_with url: onboarding_step_path(step.key), scope: :onboarding, class: "block", data: { turbo: false } do |f| %>
  <div class="grid gap-4 md:grid-cols-2">
    <section class="ss-card ss-card-pad is-soft" aria-labelledby="ob-invite">
      <h2 id="ob-invite" class="flex items-center gap-2"><%= icon("users", "size-5 text-accent") %><%= t("onboarding.family.invite_title") %></h2>
      <p class="text-sm text-muted mt-1"><%= t("onboarding.family.invite_text") %></p>
      <% if invite %>
        <div class="ss-qr-box mt-3 w-40"><%= qr_svg(invite) %></div>
        <div class="mt-3 flex gap-2" data-controller="ss-copy" data-ss-copy-done-value="<%= ss_t("code_block.copied") %>">
          <%= f.ss_text_field :invite_link, label: t("onboarding.family.invite_link"), hide_label: true, value: invite, readonly: true, name: "invite_link", id: "invite_link", class: "num text-xs",
                              wrapper_class: "flex-1 min-w-0", data: { ss_copy_target: "source", action: "focus->ss-copy#select" } %>
          <%= render(Ss::ButtonComponent.new(icon: icon("duplicate", ""), variant: :outline, data: { action: "ss-copy#copy", ss_copy_target: "button" })) do %><span data-ss-copy-target="label"><%= t("onboarding.family.copy") %></span><% end %>
        </div>
        <p class="text-xs text-muted mt-2"><%= t("onboarding.family.invite_note") %></p>
      <% else %>
        <%= render Ss::ButtonComponent.new(label: t("onboarding.family.invite_button"), icon: icon("link", ""), variant: :outline, type: :submit, name: "onboarding[invite]", value: "1", class: "mt-3") %>
      <% end %>
    </section>
    <section class="ss-card ss-card-pad is-soft" aria-labelledby="ob-app">
      <h2 id="ob-app" class="flex items-center gap-2"><%= icon("device-mobile", "size-5 text-accent") %><%= t("onboarding.family.app_title") %></h2>
      <p class="text-sm text-muted mt-1"><%= t("onboarding.family.app_text") %></p>
      <div class="ss-qr-box mt-3 w-40"><%= qr_svg(ctx.base_url.to_s) %></div>
      <p class="text-xs text-muted mt-2 num break-all"><%= ctx.base_url %></p>
    </section>
  </div>
  <%= render "web/onboarding/nav", step: step, label: t("onboarding.family.submit") %>
<% end %>
