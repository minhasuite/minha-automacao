<%# locals: (ctx:, step:) -%>
<% invite = ctx.data[:invite_url] %>
<%= form_with url: onboarding_step_path(step.key), scope: :onboarding, data: { turbo: false } do |f| %>
  <div class="grid gap-4 md:grid-cols-2">
    <section class="ob-panel" aria-labelledby="ob-invite">
      <h2 id="ob-invite" class="flex items-center gap-2"><%= icon("users", "size-5 text-accent") %><%= t("onboarding.family.invite_title") %></h2>
      <p class="text-sm text-muted mt-1"><%= t("onboarding.family.invite_text") %></p>
      <% if invite %>
        <div class="ob-qr mt-3"><%= qr_svg(invite) %></div>
        <div class="mt-3 flex gap-2" data-controller="clipboard">
          <%= text_field_tag :invite_link, invite, readonly: true, class: "ss-input num text-xs", data: { clipboard_target: "source" }, "aria-label": t("onboarding.family.invite_link") %>
          <button type="button" class="ss-btn ss-btn-outline" data-action="clipboard#copy"><%= icon("duplicate", "size-4") %><span><%= t("onboarding.family.copy") %></span></button>
        </div>
        <p class="text-xs text-muted mt-2"><%= t("onboarding.family.invite_note") %></p>
      <% else %>
        <button type="submit" name="onboarding[invite]" value="1" class="ss-btn ss-btn-outline mt-3"><%= icon("link", "size-4") %><%= t("onboarding.family.invite_button") %></button>
      <% end %>
    </section>
    <section class="ob-panel" aria-labelledby="ob-app">
      <h2 id="ob-app" class="flex items-center gap-2"><%= icon("device-mobile", "size-5 text-accent") %><%= t("onboarding.family.app_title") %></h2>
      <p class="text-sm text-muted mt-1"><%= t("onboarding.family.app_text") %></p>
      <div class="ob-qr mt-3"><%= qr_svg(ctx.base_url.to_s) %></div>
      <p class="text-xs text-muted mt-2 num break-all"><%= ctx.base_url %></p>
    </section>
  </div>
  <%= render "web/onboarding/nav", step: step, label: t("onboarding.family.submit") %>
<% end %>
