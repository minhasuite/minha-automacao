<%# locals: (ctx:, step:, dashboard:, views:, themes:, current:, areas: [], layouts: []) -%>
<%= ss_form_with url: onboarding_step_path(step.key), scope: :onboarding, class: "block", data: { turbo_submits_with: t("onboarding.saving") } do |f| %>
  <fieldset>
    <legend class="ss-label"><%= t("onboarding.dashboard.theme") %></legend>
    <%# Galeria de temas com a amostra da gem (.ss-swatch): o rádio some e a escolhida ganha o anel. %>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(8.5rem,1fr))] gap-3">
      <% themes.each do |th| %>
        <label class="ss-swatch ss-swatch-lg is-block" style="<%= dw_swatch_style(th) %>">
          <%= f.radio_button :theme, th.key, checked: th.key == current %>
          <span class="ss-swatch-dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="ss-swatch-bar" aria-hidden="true"></span>
          <span class="ss-swatch-name"><%= th.label %></span>
        </label>
      <% end %>
    </div>
  </fieldset>
  <%# Ideia 8: cômodos e estilo (Dashboards::Wizard). %>
  <div class="ss-card ss-card-pad mt-5"><%= render "web/dashboard_wizard/fields", areas: areas, scope: "onboarding" %></div>
  <div class="ss-card ss-card-pad is-soft mt-5">
    <p class="font-semibold text-ink flex items-center gap-2"><%= icon("view-boards", "size-5 text-accent") %><%= t("onboarding.dashboard.ready", count: views.size) %></p>
    <div class="mt-2 flex flex-wrap gap-1.5">
      <% views.first(8).each do |v| %><span class="ss-chip"><%= icon(v["icon"].presence || "view-boards", "size-4") %><%= v["title"] %></span><% end %>
    </div>
    <p class="text-xs text-muted mt-2"><%= t("onboarding.dashboard.auto_note") %></p>
  </div>
  <%= render "web/onboarding/nav", step: step, label: t("onboarding.dashboard.submit") %>
<% end %>
