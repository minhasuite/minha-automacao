<%# locals: (ctx:, step:, areas:, devices:, suggested:) -%>
<%= ss_form_with url: onboarding_step_path(step.key), scope: :onboarding, class: "block", data: { controller: "onboarding-board", turbo_submits_with: t("onboarding.saving") } do |f| %>
  <% if suggested.any? %>
    <fieldset>
      <legend class="ss-label"><%= t("onboarding.areas.suggestions") %></legend>
      <div class="flex flex-wrap gap-2">
        <% suggested.each do |k| %>
          <%= f.ss_chip_check_box :suggested, multiple: true, label: t("onboarding.areas.suggested.#{k}"), checked_value: k, unchecked_value: nil, checked: areas.empty? && k.in?(%w[living kitchen bedroom bathroom]), id: "sug-#{k}" %>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <div class="mt-3 flex flex-wrap items-end gap-2">
    <%= f.ss_text_field :custom, label: t("onboarding.areas.custom"), value: nil, placeholder: t("onboarding.areas.custom_hint"), wrapper_class: "min-w-48 flex-1" %>
    <%= render Ss::ButtonComponent.new(label: t("onboarding.areas.create"), icon: icon("plus", ""), variant: :outline, type: :submit, name: "onboarding[create]", value: "1") %>
  </div>

  <h2 class="mt-6 text-base!"><%= t("onboarding.areas.board") %></h2>
  <% if devices.empty? %>
    <p class="text-sm text-muted mt-1"><%= t("onboarding.areas.no_devices") %></p>
  <% else %>
    <p class="text-sm text-muted mt-1"><%= t("onboarding.areas.board_hint") %></p>
    <%# Quadro de arrastar da gem (.ss-kanban com coluna e cartão; o SsKanban do app). %>
    <div class="ss-kanban is-wrap mt-3">
      <% ([ nil ] + areas).each do |area| %>
        <section class="ss-kanban-col" data-onboarding-board-target="column" data-area="<%= area&.id %>" data-action="dragover->onboarding-board#over dragleave->onboarding-board#leave drop->onboarding-board#drop" aria-label="<%= area&.name || t("onboarding.areas.loose") %>">
          <h3 class="ss-kanban-head"><%= icon(area ? "home" : "inbox", "size-4") %><%= area&.name || t("onboarding.areas.loose") %></h3>
          <% devices.select { |d| d.area_id == area&.id }.each do |d| %>
            <div class="ss-kanban-card" draggable="true" data-onboarding-board-target="card" data-action="dragstart->onboarding-board#start dragend->onboarding-board#end">
              <span class="text-muted" aria-hidden="true"><%= icon("dots-horizontal", "size-4") %></span>
              <span class="min-w-0 flex-1 truncate font-semibold text-sm text-ink"><%= d.name %></span>
              <%= f.ss_select :device_area, options_for_select([ [ t("onboarding.areas.loose"), "" ] ] + areas.map { |a| [ a.name, a.id ] }, d.area_id),
                              label: t("onboarding.areas.move", name: d.name), hide_label: true, name: "onboarding[device_area][#{d.id}]", id: "onboarding_device_area_#{d.id}",
                              class: "h-8 min-h-0 text-xs", wrapper_class: "basis-full", data: { action: "onboarding-board#pick" } %>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>
  <% end %>
  <%= render "web/onboarding/nav", step: step %>
<% end %>
