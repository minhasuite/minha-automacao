<%# locals: (found:) -%>
<turbo-frame id="ob-found">
  <% if found.empty? %>
    <div role="status"><%= render Ss::EmptyStateComponent.new(variant: :busca, title: t("onboarding.discover.none"), text: t("onboarding.discover.none_hint"), compact: true) %></div>
  <% else %>
    <p class="text-sm font-semibold text-ink mb-3" role="status"><%= t("onboarding.discover.found", count: found.size) %></p>
    <%# Cada aparelho achado é um .ss-option-card da gem (caixa no canto; o já adicionado vem apagado e desabilitado). %>
    <ul class="ss-option-grid" role="list">
      <% found.each_with_index do |e, i| %>
        <li class="ss-rise min-w-0" style="animation-delay: <%= [ i, 10 ].min * 60 %>ms">
          <%= render Ss::OptionCardComponent.new(type: :checkbox, name: "onboarding[pick][]", value: e.slice("plugin", "name", "host", "port").to_json, checked: !e["added"],
                                                 id: "pick-#{i}", input: { disabled: e["added"] }, css: "h-full", icon: icon(e["icon"], "size-5"),
                                                 title: safe_join([ e["name"], (safe_join([ " ", tag.span(t("onboarding.discover.added_badge"), class: "ss-badge ss-badge-success") ]) if e["added"]) ].compact),
                                                 description: safe_join([ e["title"], " · ", tag.span([ e["host"], e["port"] ].compact.join(":"), class: "num") ])) %>
        </li>
      <% end %>
    </ul>
    <p class="text-xs text-muted mt-3"><%= t("onboarding.discover.note") %></p>
  <% end %>
  <%= link_to onboarding_discover_path, class: "ss-btn ss-btn-ghost ss-btn-sm mt-3" do %><%= icon("refresh", "size-4") %><%= t("onboarding.discover.again") %><% end %>
</turbo-frame>
