<%= render "web/shared/header", title: t("panel_devices.title"), subtitle: t("panel_devices.subtitle"), back: settings_dashboards_path %>
<%= render layout: "web/settings/frame", locals: { current: :dashboards } do %>
  <div class="grid gap-6">
    <section class="ss-card ss-card-pad grid gap-3" aria-labelledby="pd-this">
      <%= render Ss::CardHeaderComponent.new(title: t("panel_devices.this_device"), subtitle: @current ? t("panel_devices.this_known", name: @current.name) : t("panel_devices.this_hint"), icon: icon("device-mobile", ""), id: "pd-this") %>
      <%= ss_form_with model: PanelDevice.new, scope: :panel_device, url: settings_panel_devices_path, method: :post, class: "grid gap-3 sm:grid-cols-3 items-end" do |f| %>
        <%= f.ss_text_field :name, label: t("panel_devices.name"), value: @current&.name, id: "pd-new-name", required: true, maxlength: 60, placeholder: t("panel_devices.name_hint") %>
        <%= f.ss_select :dashboard_id, options_for_select(@dashboards, @current&.dashboard_id), label: t("panel_devices.dashboard"), include_blank: t("panel_devices.person_default"), id: "pd-new-dash" %>
        <%= f.ss_text_field :view, label: t("panel_devices.view"), value: @current&.view, id: "pd-new-view", maxlength: 100, placeholder: t("panel_devices.view_hint") %>
        <div class="sm:col-span-3"><%= f.ss_submit t("panel_devices.save_this") %></div>
      <% end %>
    </section>

    <section class="grid gap-3" aria-labelledby="pd-list">
      <%= render Ss::SectionHeaderComponent.new(title: t("panel_devices.list"), subtitle: t("panel_devices.list_hint"), id: "pd-list") %>
      <% if @devices.empty? %>
        <%= render Ss::EmptyStateComponent.new(title: t("panel_devices.none"), text: t("panel_devices.none_hint"), css: "ss-card") %>
      <% else %>
        <% @devices.each do |d| %>
          <div class="ss-card ss-card-pad grid gap-3">
            <%= render Ss::CardHeaderComponent.new(title: d.name, subtitle: [ t("panel_devices.kinds.#{d.kind}"), (t("panel_devices.current") if d.key == @current_key),
                                                                              (t("panel_devices.seen", time: time_ago_in_words(d.last_seen_at)) if d.last_seen_at), d.user&.name ].compact.join(" · "),
                                                   icon: icon(d.kind == "app" ? "device-mobile" : "desktop-computer", "")) do |h| %>
              <% h.with_action do %>
                <%= render Ss::ButtonComponent.new(icon: icon("trash", ""), href: settings_panel_device_path(d), method: :delete, variant: :ghost, size: :sm, class: "text-danger",
                                                   title: t("panel_devices.remove", name: d.name), aria: { label: t("panel_devices.remove", name: d.name) },
                                                   confirm: t("panel_devices.remove_confirm", name: d.name), confirm_tone: :danger, confirm_button: t("panel_devices.remove_button")) %>
              <% end %>
            <% end %>
            <%= ss_form_with model: d, scope: :panel_device, url: settings_panel_device_path(d), method: :patch, class: "grid gap-3 sm:grid-cols-3 items-end" do |f| %>
              <%= f.ss_text_field :name, label: t("panel_devices.name"), id: "pd-#{d.id}-name", required: true, maxlength: 60 %>
              <%= f.ss_select :dashboard_id, options_for_select(@dashboards, d.dashboard_id), label: t("panel_devices.dashboard"), include_blank: t("panel_devices.person_default"), id: "pd-#{d.id}-dash" %>
              <%= f.ss_text_field :view, label: t("panel_devices.view"), id: "pd-#{d.id}-view", maxlength: 100 %>
              <div class="sm:col-span-3"><%= f.ss_submit t("panel_devices.save"), variant: :outline, small: true %></div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </section>
  </div>
<% end %>
