<%= render "web/shared/header", title: "Painel pronto", subtitle: "Escolha um modelo, diga quais pontos usar e o painel nasce montado. Depois é um painel como os outros.", back: site_dashboards_path(@site) %>
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% @presets.each_with_index do |p, i| %>
    <%= link_to site_dashboard_preset_path(@site, p.key), class: "ss-card ss-go p-5 no-underline ss-rise flex flex-col gap-3", style: "animation-delay: #{[ i, 6 ].min * 40}ms" do %>
      <span class="grid place-items-center size-12 rounded-2xl text-white shadow-sm" style="background: var(--amber-grad)"><%= icon(p.icon, "size-6") %></span>
      <span class="block font-bold text-ink text-lg"><%= p.title %></span>
      <span class="block text-sm text-muted"><%= p.description %></span>
      <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-accent">Montar<%= icon("chevron-right", "size-4") %></span>
    <% end %>
  <% end %>
</div>
