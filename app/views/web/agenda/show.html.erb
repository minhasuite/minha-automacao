<%= render "web/shared/header", title: "Agenda", subtitle: "#{@site.name} · todas as agendas (Google, ICS e as locais) dos próximos 31 dias" do %>
  <% if can?(:manage) %><%= link_to new_site_helper_path(@site, tipo: "local_calendar"), class: "ss-btn ss-btn-outline" do %><%= icon("plus", "size-4") %>Nova agenda local<% end %><% end %>
<% end %>
<%= render "web/sites/tabs", site: @site, current: :agenda %>
<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem] items-start">
  <section class="ss-card overflow-hidden" aria-label="Próximos eventos">
    <% if @days.empty? %>
      <div class="ss-empty"><p class="font-bold text-ink">Nada nos próximos 31 dias.</p><p class="mt-1">Crie uma agenda local ou ligue o Google Agenda / ICS em Integrações.</p></div>
    <% else %>
      <% @days.each do |day, events| %>
        <div class="oa-cal-day">
          <div class="oa-cal-date"><b><%= day.day %></b><span><%= l(day, format: "%b") %> · <%= l(day, format: "%a") %></span></div>
          <div class="min-w-0">
            <% events.each do |e| %>
              <% s = Time.zone.parse(e["start"]).in_time_zone(@zone) %>
              <% en = Time.zone.parse(e["end"]).in_time_zone(@zone) %>
              <div class="oa-cal-event">
                <span class="oa-cal-time"><%= e["all_day"] ? "Dia todo" : "#{s.strftime('%H:%M')}–#{en.strftime('%H:%M')}" %></span>
                <span class="min-w-0 flex-1"><span class="font-semibold text-ink break-words"><%= e["summary"] %></span>
                  <span class="block text-xs text-muted"><%= [ e["calendar"].name, e["location"] ].compact_blank.join(" · ") %></span></span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>
  <aside class="grid gap-4">
    <% if @locals.any? && can?(:manage) %>
      <%= form_with scope: :event, url: site_agenda_path(@site), class: "ss-card ss-card-pad grid gap-3" do |f| %>
        <h2>Novo evento</h2>
        <div><%= f.label :point_id, "Agenda", class: "ss-label" %><%= f.select :point_id, @locals.map { |c| [ c.name, c.id ] }, {}, class: "ss-input" %></div>
        <div><%= f.label :summary, "Título", class: "ss-label" %><%= f.text_field :summary, class: "ss-input", required: true, maxlength: 255, placeholder: "Coleta do lixo reciclável" %></div>
        <div class="grid grid-cols-2 gap-2">
          <div><%= f.label :start, "Início", class: "ss-label" %><%= f.datetime_local_field :start, class: "ss-input", required: true %></div>
          <div><%= f.label :end, "Fim", class: "ss-label" %><%= f.datetime_local_field :end, class: "ss-input" %></div>
        </div>
        <label class="ss-check"><%= f.check_box :all_day %> Dia todo</label>
        <div><%= f.label :repeat, "Repetir", class: "ss-label" %><%= f.select :repeat, HelperTypes::LocalCalendar::REPEATS.map { |r| [ HelperTypes::LocalCalendar.text("repeat.#{r}"), r ] }, {}, class: "ss-input" %></div>
        <div><%= f.label :location, "Local (opcional)", class: "ss-label" %><%= f.text_field :location, class: "ss-input", maxlength: 255 %></div>
        <%= f.submit "Criar evento", class: "ss-btn ss-btn-primary" %>
      <% end %>
    <% end %>
    <% @locals.each do |c| %>
      <% list = Array(c.address["local"]) %>
      <section class="ss-card ss-card-pad" aria-label="Eventos de <%= c.name %>">
        <h2 class="flex items-center gap-2"><%= icon("calendar", "size-4") %><%= c.name %></h2>
        <% if list.empty? %><p class="text-sm text-muted mt-2">Sem eventos.</p><% end %>
        <ul class="mt-2 grid gap-1">
          <% list.sort_by { |e| e["start"] }.each do |e| %>
            <li class="flex items-center gap-2 text-sm">
              <span class="min-w-0 flex-1 truncate"><%= e["summary"] %> <span class="text-muted">· <%= l(Time.zone.parse(e["start"]).in_time_zone(@zone), format: "%d/%m %H:%M") %><%= " · #{HelperTypes::LocalCalendar.text("repeat.#{e['repeat']}").downcase}" if e["repeat"].present? && e["repeat"] != "none" %></span></span>
              <% if can?(:manage) %><%= button_to event_site_agenda_path(@site, c.id, e["uid"]), method: :delete, class: "ss-btn ss-btn-ghost ss-btn-sm px-2", form: { class: "contents", data: { turbo_confirm: "Apagar #{e['summary']}?" } }, "aria-label": "Apagar #{e['summary']}" do %><%= icon("trash", "size-4") %><% end %><% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </aside>
</div>
