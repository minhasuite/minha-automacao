<%= render "web/shared/header", title: t("agenda.show.title"), subtitle: t("agenda.show.subtitle", site: @site.name) do %>
  <% if can?(:manage) %><%= link_to new_site_helper_path(@site, tipo: "local_calendar"), class: "ss-btn ss-btn-outline" do %><%= icon("plus", "size-4") %><%= t("agenda.show.new_local") %><% end %><% end %>
<% end %>
<%= render "web/sites/tabs", site: @site, current: :agenda %>
<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem] items-start">
  <section class="ss-card overflow-hidden" aria-label="<%= t("agenda.show.upcoming") %>">
    <% if @days.empty? %>
      <%= render Ss::EmptyStateComponent.new(title: t("agenda.show.empty"), text: t("agenda.show.empty_hint")) %>
    <% else %>
      <%# Lista dos dias na peça da gem (mesma do widget de agenda); uma cor por agenda. %>
      <% now = Time.current.in_time_zone(@zone) %>
      <% tone = ->(cal) { %i[accent warn success info danger][@calendars.index(cal).to_i % 5] } %>
      <% hm = ->(v) { Time.zone.parse(v.to_s)&.in_time_zone(@zone)&.strftime("%H:%M") } %>
      <% days = @days.map do |day, events|
           { date: day, events: events.map { |e| { time: (hm.(e["start"]) unless e["all_day"]), end: (hm.(e["end"]) unless e["all_day"]), all_day: e["all_day"],
                                                   title: e["summary"], detail: [ e["calendar"].name, e["location"] ].compact_blank.join(" · "), tone: tone.(e["calendar"]) } } }
         end %>
      <%= render Ss::AgendaListComponent.new(days: days, now: now, selected: now.to_date, label: t("agenda.show.upcoming")) %>
    <% end %>
  </section>
  <aside class="grid gap-4">
    <% if @locals.any? && can?(:manage) %>
      <%= ss_form_with scope: :event, url: site_agenda_path(@site), class: "ss-card ss-card-pad grid gap-3" do |f| %>
        <h2><%= t("agenda.show.new_event") %></h2>
        <%= f.ss_select :point_id, @locals.map { |c| [ c.name, c.id ] }, label: t("agenda.show.calendar") %>
        <%= f.ss_text_field :summary, label: t("agenda.show.summary"), required: true, maxlength: 255, placeholder: t("agenda.show.summary_ph") %>
        <div class="grid grid-cols-2 gap-2">
          <%= f.ss_datetime_local_field :start, label: t("agenda.show.start"), required: true %>
          <%= f.ss_datetime_local_field :end, label: t("agenda.show.finish") %>
        </div>
        <%= f.ss_check_box :all_day, label: t("agenda.show.all_day") %>
        <%= f.ss_select :repeat, HelperTypes::LocalCalendar::REPEATS.map { |r| [ HelperTypes::LocalCalendar.text("repeat.#{r}"), r ] }, label: t("agenda.show.repeat") %>
        <%= f.ss_text_field :location, label: t("agenda.show.location"), maxlength: 255 %>
        <div><%= f.ss_submit t("agenda.show.create") %></div>
      <% end %>
    <% end %>
    <% @locals.each do |c| %>
      <% list = Array(c.address["local"]) %>
      <section class="ss-card ss-card-pad" aria-label="<%= t("agenda.show.events_of", name: c.name) %>">
        <h2 class="flex items-center gap-2"><%= icon("calendar", "size-4") %><%= c.name %></h2>
        <% if list.empty? %><p class="text-sm text-muted mt-2"><%= t("agenda.show.no_events") %></p><% end %>
        <ul class="mt-2 grid gap-1">
          <% list.sort_by { |e| e["start"] }.each do |e| %>
            <li class="flex items-center gap-2 text-sm">
              <span class="min-w-0 flex-1 truncate"><%= e["summary"] %> <span class="text-muted">· <%= l(Time.zone.parse(e["start"]).in_time_zone(@zone), format: :short) %><%= " · #{HelperTypes::LocalCalendar.text("repeat.#{e['repeat']}").downcase}" if e["repeat"].present? && e["repeat"] != "none" %></span></span>
              <% if can?(:manage) %><%= render Ss::ButtonComponent.new(icon: icon("trash", ""), href: event_site_agenda_path(@site, c.id, e["uid"]), method: :delete, variant: :ghost, size: :sm, class: "text-danger",
                                                                        form: { class: "contents" }, confirm: t("agenda.show.delete_confirm", name: e["summary"]), confirm_tone: :danger, confirm_button: t("shared.confirm.erase"),
                                                                        title: t("agenda.show.delete", name: e["summary"]), aria: { label: t("agenda.show.delete", name: e["summary"]) }) %><% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </aside>
</div>
