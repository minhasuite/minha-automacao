<%= render "web/shared/header", title: t("ask.title"), subtitle: t("ask.subtitle") %>
<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem] items-start max-w-5xl">
  <%# Frame: o POST responde a própria página (200), o que o Turbo só aceita dentro de frame. %>
  <%= turbo_frame_tag "pergunta", class: "grid gap-4 min-w-0" do %>
    <%= ss_form_with url: ask_path, class: "ss-card ss-card-pad grid gap-3" do |f| %>
      <% if @sites.size > 1 %>
        <%= f.ss_select :site_id, @sites.map { |s| [ s.name, s.id ] }, label: t("ask.site"), selected: @site&.id %>
      <% elsif @site %>
        <%= hidden_field_tag :site_id, @site.id %>
      <% end %>
      <%= f.ss_text_area :question, label: t("ask.question"), value: @question, rows: 3, maxlength: 1000, required: true, autofocus: @response.nil?,
                                    placeholder: t("ask.question_ph") %>
      <div><%= render Ss::ButtonComponent.new(label: t("ask.ask"), icon: icon("sparkles", ""), type: :submit, submitting: t("ask.thinking"), disabled: !@site) %></div>
    <% end %>

    <% if @error %>
      <%= render Ss::CalloutComponent.new(tone: :danger, title: t("ask.failed")) do |c| %>
        <p><%= @error %></p>
        <% if current_user.admin? %><% c.with_action { link_to t("ask.setup"), settings_ai_path, class: "ss-btn ss-btn-ghost ss-btn-sm", data: { turbo_frame: "_top" } } %><% end %>
      <% end %>
    <% elsif @response %>
      <section class="ss-card ss-card-pad" aria-labelledby="resp-t" aria-live="polite">
        <h2 id="resp-t" class="flex items-center gap-2"><%= icon("sparkles", "size-5") %><%= t("ask.answer") %></h2>
        <div class="mt-2 text-ink whitespace-pre-line break-words"><%= @response.data.is_a?(Hash) ? @response.data.to_json : @response.data %></div>
        <p class="mt-3 text-xs text-muted"><%= [ Ai.provider(@response.provider)&.label, @response.model, "#{@response.tokens} tokens", usd(@response.cost) ].compact.join(" · ") %></p>
      </section>
    <% end %>
  <% end %>
  <aside class="ss-card ss-card-pad text-sm text-muted">
    <h2 class="text-base text-ink font-bold"><%= t("ask.how") %></h2>
    <ul class="mt-2 grid gap-2 list-disc pl-4">
      <li><%= t("ask.how_1") %><% if @site %> <%= t("ask.how_points", n: @site.points.count, site: @site.name) %><% end %>.</li>
      <li><%= t("ask.how_2") %></li>
      <li><%= t("ask.how_3") %></li>
    </ul>
  </aside>
</div>
