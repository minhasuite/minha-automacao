<%= render "web/shared/header", title: @area.name, subtitle: [ @area.kind_label, (@area.level_label if @area.floor?), @site.name ].compact.join(" · "), back: site_path(@site) do %>
  <% if can?(:manage) %>
    <%= link_to new_site_device_path(@site, area_id: @area.id), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("devices.new") %><% end %>
    <%= link_to edit_area_path(@area), class: "ss-btn ss-btn-ghost" do %><%= icon("pencil", "size-4") %><%= t("shared.edit") %><% end %>
  <% end %>
<% end %>

<% if @children.any? %>
  <p class="ss-section mb-3"><%= @area.floor? ? "Áreas deste andar" : "Áreas dentro" %></p>
  <div class="flex flex-wrap gap-2 mb-6">
    <% @children.each do |c| %>
      <%= link_to c, class: "ss-chip no-underline flex items-center gap-1" do %><%= icon(c.icon.presence || "view-boards", "size-4") %><%= c.name %><% end %>
    <% end %>
    <% if can?(:manage) %><%= link_to new_site_area_path(@site, parent_id: @area.id), class: "ss-chip no-underline text-accent flex items-center gap-1" do %><%= icon("plus", "size-4") %>Nova área aqui<% end %><% end %>
  </div>
<% end %>
<% if @devices.empty? && @children.any? %>
<% elsif @devices.empty? %>
  <div class="ss-card ss-empty">
    <p class="font-bold text-ink"><%= t("areas.show.empty") %></p>
    <p class="mt-1"><%= t("areas.show.empty_hint") %></p>
    <% if can?(:manage) %><%= link_to new_site_device_path(@site, area_id: @area.id), class: "ss-btn ss-btn-primary mt-4" do %><%= icon("plus", "size-4") %><%= t("areas.show.add_device") %><% end %><% end %>
  </div>
<% else %>
  <div class="space-y-6">
    <% @devices.each do |device| %>
      <section aria-label="<%= device.name %>">
        <div class="flex items-center justify-between gap-3 mb-3">
          <%= link_to device, class: "flex items-center gap-2 no-underline min-w-0" do %>
            <span class="ss-section truncate"><%= device.name %></span><span class="ss-badge"><%= device.driver_label %></span>
          <% end %>
          <%= link_to device, class: "text-sm font-semibold text-muted no-underline hover:text-accent flex items-center gap-1" do %><%= t("areas.show.details") %><%= icon("chevron-right", "size-4") %><% end %>
        </div>
        <% points = device.points.reject(&:hidden).sort_by(&:name) %>
        <% if points.any? %>
          <% points.each { |p| %><%= turbo_stream_from p, channel: PointsChannel %><% } %>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(10rem,1fr))] gap-3 lg:grid-cols-3"><%= render partial: "web/points/point", collection: points, as: :point %></div>
        <% else %>
          <p class="ss-card p-4 text-sm text-muted"><%= t("areas.show.no_points") %> <%= link_to(t("devices.add_point"), new_device_point_path(device), class: "font-semibold text-accent") if can?(:manage) %></p>
        <% end %>
      </section>
    <% end %>
  </div>
<% end %>
