<%= render "web/shared/header", title: t("exposures.show.title"), subtitle: t("exposures.show.subtitle", site: @site.name) %>
<%= render "web/sites/tabs", site: @site, current: :exposure %>
<% admin = can?(:admin) %>
<%= form_with url: site_exposure_path(@site), method: :get, class: "mb-3 grid gap-3 sm:flex sm:flex-wrap sm:items-end", role: "search" do %>
  <div class="min-w-0 sm:min-w-48 sm:flex-1"><label for="q" class="ss-label"><%= t("exposures.show.search") %></label><%= search_field_tag :q, params[:q], class: "ss-input", placeholder: t("exposures.show.search_ph") %></div>
  <div class="grid grid-cols-3 gap-2 sm:contents">
    <div><label for="area" class="ss-label"><%= t("exposures.show.area") %></label><%= select_tag :area, options_for_select(@site.areas.order(:level, :position, :name).map { |a| [ a.name, a.id ] }, params[:area]), include_blank: t("exposures.show.all_f"), class: "ss-input", data: { autosubmit: true } %></div>
    <div><label for="rotulo" class="ss-label"><%= t("exposures.show.label") %></label><%= select_tag :rotulo, options_for_select(@labels, params[:rotulo]), include_blank: t("exposures.show.all_m"), class: "ss-input", data: { autosubmit: true } %></div>
    <div><label for="so" class="ss-label"><%= t("exposures.show.show") %></label><%= select_tag :so, options_for_select([ [ t("exposures.show.only_exposed"), "expostos" ] ], params[:so]), include_blank: t("exposures.show.all_m"), class: "ss-input", data: { autosubmit: true } %></div>
  </div>
  <button type="submit" class="ss-btn ss-btn-ghost hidden sm:inline-flex" aria-label="<%= t("exposures.show.search") %>"><%= icon("search", "size-4") %></button>
<% end %>

<% if @points.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("exposures.show.empty"), variant: :busca, css: "ss-card") do %><%= link_to t("exposures.show.clear"), site_exposure_path(@site), class: "ss-btn ss-btn-ghost" %><% end %>
<% else %>
  <%= form_with url: site_exposure_path(@site), method: :patch, data: { controller: "expose" } do %>
    <%= hidden_field_tag :back, request.fullpath, id: nil %>
    <div class="ss-card oa-expose overflow-hidden" role="table" aria-label="<%= t("exposures.show.table") %>" style="--cols: <%= @targets.size %>">
      <div class="oa-expose-row oa-expose-head" role="row">
        <span></span><span role="columnheader"><%= t("exposures.show.point") %></span>
        <div class="oa-expose-cells">
          <% @targets.each do |tg| %>
            <label class="oa-expose-cell" role="columnheader" title="<%= t("exposures.show.column_title", target: tg.title) %>">
              <span class="flex items-center gap-1"><%= icon(tg.icon, "size-4") %><%= tg.title %></span>
              <% if admin %><input type="checkbox" data-action="expose#column" data-expose-col-param="<%= tg.key %>" aria-label="<%= t("exposures.show.column_all", target: tg.title) %>"><% end %>
            </label>
          <% end %>
        </div>
      </div>
      <% @points.each do |p| %>
        <div class="oa-expose-row" role="row" id="expose-<%= p.id %>">
          <span class="ss-icon-tile text-muted"><%= icon(point_icon(p)) %></span>
          <div class="min-w-0" role="cell">
            <p class="font-semibold text-ink truncate"><%= p.name %> <% if p.risk == "critical" %><span class="ss-badge ss-badge-warn"><%= t("exposures.show.critical") %></span><% end %></p>
            <p class="text-xs text-muted truncate"><%= [ p.device&.name, (p.area || p.device&.area)&.name ].compact.uniq.join(" · ") %> <%= label_chips(p) %></p>
            <% if p.aliases.any? %><p class="oa-aliases truncate"><%= t("exposures.show.aliases", list: p.aliases.join(", ")) %></p><% end %>
          </div>
          <div class="oa-expose-cells">
            <% @targets.each do |tg| %>
              <span class="oa-expose-cell" role="cell">
                <% if tg.applies?(p) %>
                  <%= hidden_field_tag "x[#{p.id}][#{tg.key}]", "0", id: nil %>
                  <input type="checkbox" name="x[<%= p.id %>][<%= tg.key %>]" value="1" data-col="<%= tg.key %>" <%= "checked" if tg.exposed?(p) %> <%= "disabled" unless admin %> aria-label="<%= t("exposures.show.cell", point: p.name, target: tg.title) %>">
                  <span class="sr-only"><%= tg.title %></span>
                <% else %>
                  <span class="text-muted" title="<%= t("exposures.show.not_applicable", target: tg.title) %>">–</span>
                <% end %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <% if admin %>
      <div class="ss-bulk-static mt-4 flex flex-wrap items-center gap-3">
        <label class="ss-check text-sm"><%= check_box_tag :confirm, "1", false, id: "confirm" %> <%= t("exposures.show.confirm") %></label>
        <%= submit_tag t("exposures.show.save"), class: "ss-btn ss-btn-primary" %>
      </div>
      <p class="text-xs text-muted mt-2"><%= t("exposures.show.hint") %></p>
    <% end %>
  <% end %>
<% end %>
