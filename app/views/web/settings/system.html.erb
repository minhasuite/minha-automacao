<%= render "web/shared/header", title: t("settings.title"), subtitle: t("settings.system.subtitle") %>
<% owner = current_user.owner? %>
<%= render layout: "web/settings/frame", locals: { current: :system } do %>
<% up = @update || {} %>
<% running = up["state"] == "running" %>
<section class="ss-card ss-card-pad" aria-labelledby="update-t" <%= tag.attributes(data: { controller: "ss-reload", ss_reload_every_value: 5000 }) if running %>>
  <h2 id="update-t" class="flex items-center gap-2"><%= icon("refresh", "size-5 text-accent") %><%= t("updates.title") %></h2>
  <%# Versões numa faixa de indicadores da gem (sem contar: são etiquetas, não números) e o selo do estado. %>
  <div class="mt-3 grid gap-3">
    <%= render Ss::KpiStripComponent.new(label: t("updates.title"), count: false, css: "ss-card", items: [
          { label: t("updates.current"), value: Updates.current_tag, hint: (Updates.current_commit && "(#{Updates.current_commit})") },
          { label: t("updates.latest"), value: @release ? @release["tag"] : "—",
            hint: @release ? (l(Time.zone.parse(@release["published_at"]).to_date, format: :long) if @release["published_at"]) : t("updates.unknown") }]) %>
    <span class="ss-badge justify-self-start <%= Updates.available?(@release) ? 'ss-badge-accent' : 'ss-badge-success' %>"><%= Updates.available?(@release) ? t("updates.available") : t("updates.up_to_date") %></span>
  </div>

  <% if running %>
    <% steps = %w[backup pull restart] %>
    <% now = steps.index(up["step"]) || (up["step"] == "rollback" ? steps.size : 0) %>
    <% steps << "rollback" if up["step"] == "rollback" %>
    <%# Etapas no Ss::JobProgressComponent (a página se recarrega pelo ss-reload da seção). %>
    <%= render Ss::JobProgressComponent.new(id: "update-job", title: t("updates.title"), state: :running, steps: steps.map { |st| t("updates.steps.#{st}") },
                                            current_step: now, class: "mt-3") %>
    <p class="text-sm text-muted mt-2"><%= t("updates.running_note") %></p>
  <% elsif up["state"].present? %>
    <% tone = { "done" => "text-success", "rolled_back" => "text-warn", "failed" => "text-danger" }[up["state"]] %>
    <p class="text-sm mt-3 <%= tone %>" role="status"><%= t("updates.result.#{up['state']}", to: up["to"].to_s.split(":").last, default: up["state"]) %><%= " #{up['message']}" if up["message"].present? %></p>
  <% end %>

  <% if @release && @release["notes"].present? && Updates.available?(@release) %>
    <details class="mt-3"><summary class="ss-summary text-sm font-semibold text-accent"><%= t("updates.notes") %></summary>
      <div class="text-sm text-ink-2 mt-2 whitespace-pre-line"><%= @release["notes"] %></div></details>
  <% end %>

  <div class="mt-4 flex flex-wrap gap-2">
    <% if owner && Updates.available?(@release) && !running %>
      <% if Updates.supported? %>
        <%= render Ss::ButtonComponent.new(label: t("updates.now"), icon: icon("download", "size-4"), href: settings_update_path, method: :post, params: { tag: @release["tag"] },
                                           confirm: t("updates.confirm", tag: @release["tag"]), confirm_button: t("updates.now")) %>
      <% else %>
        <p class="text-sm text-muted"><%= t("updates.unsupported") %></p>
      <% end %>
    <% end %>
    <%= link_to settings_system_path(verificar: 1), class: "ss-btn ss-btn-ghost" do %><%= icon("search", "size-4") %><%= t("updates.check") %><% end %>
  </div>
  <p class="text-xs text-muted mt-3"><%= t("updates.how") %></p>

  <% if owner && Updates.supported? %>
    <% cfg = Updates.settings %>
    <%= ss_form_with url: settings_updates_path, class: "mt-4 grid gap-3 sm:grid-cols-3 items-end", aria: { label: t("updates.auto_title") } do |f| %>
      <%= f.ss_select :channel, options_for_select(Updates::CHANNELS.map { |c| [ t("updates.channels.#{c}"), c ] }, Updates.channel), id: "up-channel", label: t("updates.channel") %>
      <%= f.ss_select :window_start, options_for_select((0..23).map { |h| [ t("updates.window_option", from: format("%02d:00", h), to: format("%02d:00", (h + Updates::WINDOW_HOURS) % 24)), h ] }, cfg["window_start"].to_i), id: "up-window", label: t("updates.window") %>
      <%= f.ss_check_box :auto, checked_value: "1", unchecked_value: "0", checked: cfg["auto"].present?, id: "up-auto", label: t("updates.auto") %>
      <p class="text-xs text-muted sm:col-span-3"><%= t("updates.auto_hint", days: Updates::AUTO_MIN_AGE.in_days.to_i) %></p>
      <div class="sm:col-span-3"><%= f.ss_submit t("updates.save"), variant: :ghost, name: nil %></div>
    <% end %>
  <% end %>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="backup-t">
  <h2 id="backup-t"><%= t("settings.system.backup_title") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("settings.system.backup_text_html") %></p>
  <div class="mt-3 flex flex-wrap gap-3">
    <%= link_to settings_export_path, class: "ss-btn ss-btn-ghost", data: { turbo: false } do %><%= icon("download", "size-4") %><%= t("settings.system.export") %><% end %>
  </div>
  <% if owner %>
    <div class="ss-danger-zone">
      <h3 class="ss-danger-zone-title"><%= t("settings.system.wipe_title") %></h3>
      <p><%= t("settings.system.wipe_text") %></p>
      <%= ss_form_with url: settings_wipe_path, class: "mt-3 flex flex-wrap gap-2", data: { turbo_confirm_tone: "danger", turbo_confirm_button: t("settings.system.wipe_button"), turbo_confirm: t("settings.system.wipe_confirm") } do |f| %>
        <%= f.ss_text_field :confirm, value: nil, placeholder: t("settings.system.wipe_type"), class: "w-40", label: t("settings.system.wipe_type"), hide_label: true %><%= f.ss_submit t("settings.system.wipe_button"), variant: :danger, name: nil %>
      <% end %>
    </div>
  <% end %>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="ext-t">
  <h2 id="ext-t"><%= t("settings.system.external_title") %></h2>
  <dl class="mt-3 grid gap-3 sm:grid-cols-2 text-sm">
    <div><dt class="text-muted"><%= t("settings.system.using") %></dt><dd class="font-semibold text-ink break-all"><%= request.base_url %></dd></div>
    <div><dt class="text-muted"><%= t("settings.system.public") %></dt><dd class="font-semibold text-ink break-all"><%= ENV["APP_HOST"].presence ? "https://#{ENV['APP_HOST']}" : t("settings.system.not_set") %></dd></div>
  </dl>
  <p class="text-sm text-muted mt-3"><%= t("settings.system.external_text") %></p>
  <% if current_user.admin? %><%= link_to settings_remote_path, class: "ss-btn ss-btn-ghost mt-3" do %><%= icon("globe", "size-4") %><%= t("settings.nav.remote") %><% end %><% end %>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="http-t">
  <h2 id="http-t"><%= t("settings.system.http_title") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("settings.system.http_text_html") %></p>
  <% if owner %>
    <%= ss_form_with url: settings_system_path, method: :patch, class: "mt-3 grid gap-2 max-w-xl" do |f| %>
      <%= f.ss_text_area :http_allow, value: current_user.tenant.http_allow_text, rows: 3, class: "num", placeholder: "192.168.68.10\nmeu-gestor.local", label: t("settings.system.http_label") %>
      <div><%= f.ss_submit t("settings.system.save"), name: nil %></div>
    <% end %>
  <% else %>
    <p class="text-sm mt-2"><%= current_user.tenant.http_allow.presence&.join(", ") || t("settings.system.http_none") %></p>
  <% end %>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="shadow-t">
  <h2 id="shadow-t" class="flex items-center gap-2"><%= icon("moon", "size-5 text-accent") %><%= t("settings.system.shadow_title") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("settings.system.shadow_text") %></p>
  <% on = Shadow.global?(current_user.tenant) %>
  <p class="mt-2"><span class="ss-badge <%= on ? 'ss-badge-accent' : '' %>"><%= on ? t("settings.system.on") : t("settings.system.off") %></span></p>
  <% if owner %>
    <%= render Ss::ButtonComponent.new(label: (on ? t("settings.system.shadow_off") : t("settings.system.shadow_on")), href: settings_system_path, method: :patch, params: { shadow: !on },
                                       variant: (on ? :outline : :primary), css: "mt-3",
                                       confirm: (on ? t("settings.system.shadow_off_confirm") : t("settings.system.shadow_on_confirm")), confirm_button: t("settings.system.confirm")) %>
  <% end %>
</section>

<%= render "web/settings/firmware" %>
<% end %>
