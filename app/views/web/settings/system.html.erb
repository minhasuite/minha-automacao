<%= render "web/shared/header", title: t("settings.title"), subtitle: t("settings.system.subtitle") %>
<% owner = current_user.owner? %>
<%= render layout: "web/settings/frame", locals: { current: :system } do %>
<% up = @update || {} %>
<% running = up["state"] == "running" %>
<section class="ss-card ss-card-pad" aria-labelledby="update-t" <%= tag.attributes(data: { controller: "reload", reload_every_value: 5000 }) if running %>>
  <h2 id="update-t" class="flex items-center gap-2"><%= icon("refresh", "size-5 text-accent") %><%= t("updates.title") %></h2>
  <div class="up-hero mt-3">
    <div class="min-w-0 flex-1">
      <p class="text-xs font-semibold text-muted"><%= t("updates.current") %></p>
      <p class="up-ver"><%= Updates.current_tag %><% if Updates.current_commit %> <span class="text-xs text-muted">(<%= Updates.current_commit %>)</span><% end %></p>
    </div>
    <div class="min-w-0 flex-1">
      <p class="text-xs font-semibold text-muted"><%= t("updates.latest") %></p>
      <% if @release %>
        <p class="up-ver"><%= @release["tag"] %></p>
        <% if @release["published_at"] %><p class="text-xs text-muted"><%= l(Time.zone.parse(@release["published_at"]).to_date, format: :long) %></p><% end %>
      <% else %>
        <p class="text-sm text-muted"><%= t("updates.unknown") %></p>
      <% end %>
    </div>
    <span class="ss-badge <%= Updates.available?(@release) ? 'ss-badge-accent' : 'ss-badge-success' %>"><%= Updates.available?(@release) ? t("updates.available") : t("updates.up_to_date") %></span>
  </div>

  <% if running %>
    <% steps = %w[backup pull restart] %>
    <% now = steps.index(up["step"]) || (up["step"] == "rollback" ? steps.size : 0) %>
    <ol class="up-steps" role="status" aria-live="polite">
      <% steps.each_with_index do |s, i| %>
        <li class="<%= i < now ? 'is-done' : (i == now ? 'is-now' : '') %>"><%= i < now ? icon("check-circle", "size-4") : (i == now ? tag.span(class: "up-spin") : icon("clock", "size-4")) %><%= t("updates.steps.#{s}") %></li>
      <% end %>
      <% if up["step"] == "rollback" %><li class="is-now"><span class="up-spin"></span><%= t("updates.steps.rollback") %></li><% end %>
    </ol>
    <p class="text-sm text-muted mt-2"><%= t("updates.running_note") %></p>
  <% elsif up["state"].present? %>
    <% tone = { "done" => "text-success", "rolled_back" => "text-warn", "failed" => "text-danger" }[up["state"]] %>
    <p class="text-sm mt-3 <%= tone %>" role="status"><%= t("updates.result.#{up['state']}", to: up["to"].to_s.split(":").last, default: up["state"]) %><%= " #{up['message']}" if up["message"].present? %></p>
  <% end %>

  <% if @release && @release["notes"].present? && Updates.available?(@release) %>
    <details class="mt-3"><summary class="text-sm font-semibold text-accent cursor-pointer"><%= t("updates.notes") %></summary>
      <div class="text-sm text-ink-2 mt-2 whitespace-pre-line"><%= @release["notes"] %></div></details>
  <% end %>

  <div class="mt-4 flex flex-wrap gap-2">
    <% if owner && Updates.available?(@release) && !running %>
      <% if Updates.supported? %>
        <%= button_to settings_update_path, params: { tag: @release["tag"] }, class: "ss-btn ss-btn-primary",
                      form: { data: { turbo_confirm: t("updates.confirm", tag: @release["tag"]), turbo_confirm_button: t("updates.now") } } do %><%= icon("download", "size-4") %><%= t("updates.now") %><% end %>
      <% else %>
        <p class="text-sm text-muted"><%= t("updates.unsupported") %></p>
      <% end %>
    <% end %>
    <%= link_to settings_system_path(verificar: 1), class: "ss-btn ss-btn-ghost" do %><%= icon("search", "size-4") %><%= t("updates.check") %><% end %>
  </div>
  <p class="text-xs text-muted mt-3"><%= t("updates.how") %></p>

  <% if owner && Updates.supported? %>
    <% cfg = Updates.settings %>
    <%= form_with url: settings_updates_path, class: "mt-4 grid gap-3 sm:grid-cols-3 items-end", aria: { label: t("updates.auto_title") } do %>
      <div>
        <label for="up-channel" class="ss-label"><%= t("updates.channel") %></label>
        <%= select_tag :channel, options_for_select(Updates::CHANNELS.map { |c| [ t("updates.channels.#{c}"), c ] }, Updates.channel), id: "up-channel", class: "ss-input" %>
      </div>
      <div>
        <label for="up-window" class="ss-label"><%= t("updates.window") %></label>
        <%= select_tag :window_start, options_for_select((0..23).map { |h| [ t("updates.window_option", from: format("%02d:00", h), to: format("%02d:00", (h + Updates::WINDOW_HOURS) % 24)), h ] }, cfg["window_start"].to_i), id: "up-window", class: "ss-input" %>
      </div>
      <div class="flex items-center gap-2">
        <%= hidden_field_tag :auto, "0", id: nil %>
        <%= check_box_tag :auto, "1", cfg["auto"], id: "up-auto" %>
        <label for="up-auto" class="text-sm"><%= t("updates.auto") %></label>
      </div>
      <p class="text-xs text-muted sm:col-span-3"><%= t("updates.auto_hint", days: Updates::AUTO_MIN_AGE.in_days.to_i) %></p>
      <div class="sm:col-span-3"><%= submit_tag t("updates.save"), class: "ss-btn ss-btn-ghost", name: nil %></div>
    <% end %>
  <% end %>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="backup-t">
  <h2 id="backup-t"><%= t("settings.system.backup_title") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("settings.system.backup_text_html") %></p>
  <div class="mt-3 flex flex-wrap gap-3">
    <%= link_to settings_export_path, class: "ss-btn ss-btn-ghost", data: { turbo: false } do %><%= icon("download", "size-4") %><%= t("settings.system.export") %><% end %>
  </div>
  <% if owner %>
    <div class="ss-danger-zone">
      <h3 class="font-bold text-danger text-sm"><%= t("settings.system.wipe_title") %></h3>
      <p class="text-sm text-muted mt-1"><%= t("settings.system.wipe_text") %></p>
      <%= form_with url: settings_wipe_path, class: "mt-3 flex flex-wrap gap-2", data: { turbo_confirm: t("settings.system.wipe_confirm") } do %>
        <%= text_field_tag :confirm, nil, placeholder: t("settings.system.wipe_type"), class: "ss-input w-40", "aria-label": t("settings.system.wipe_type") %><%= submit_tag t("settings.system.wipe_button"), class: "ss-btn ss-btn-danger", name: nil %>
      <% end %>
    </div>
  <% end %>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="ext-t">
  <h2 id="ext-t"><%= t("settings.system.external_title") %></h2>
  <dl class="mt-3 grid gap-3 sm:grid-cols-2 text-sm">
    <div><dt class="text-muted"><%= t("settings.system.using") %></dt><dd class="font-semibold text-ink break-all"><%= request.base_url %></dd></div>
    <div><dt class="text-muted"><%= t("settings.system.public") %></dt><dd class="font-semibold text-ink break-all"><%= ENV["APP_HOST"].presence ? "https://#{ENV['APP_HOST']}" : t("settings.system.not_set") %></dd></div>
  </dl>
  <p class="text-sm text-muted mt-3"><%= t("settings.system.external_text") %></p>
  <% if current_user.admin? %><%= link_to settings_remote_path, class: "ss-btn ss-btn-ghost mt-3" do %><%= icon("globe", "size-4") %><%= t("settings.nav.remote") %><% end %><% end %>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="http-t">
  <h2 id="http-t"><%= t("settings.system.http_title") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("settings.system.http_text_html") %></p>
  <% if owner %>
    <%= form_with url: settings_system_path, method: :patch, class: "mt-3 grid gap-2 max-w-xl" do %>
      <%= label_tag :http_allow, t("settings.system.http_label"), class: "ss-label" %>
      <%= text_area_tag :http_allow, current_user.tenant.http_allow_text, rows: 3, class: "ss-input num", placeholder: "192.168.68.10\nmeu-gestor.local" %>
      <div><%= submit_tag t("settings.system.save"), class: "ss-btn ss-btn-primary", name: nil %></div>
    <% end %>
  <% else %>
    <p class="text-sm mt-2"><%= current_user.tenant.http_allow.presence&.join(", ") || t("settings.system.http_none") %></p>
  <% end %>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="shadow-t">
  <h2 id="shadow-t" class="flex items-center gap-2"><%= icon("moon", "size-5 text-accent") %><%= t("settings.system.shadow_title") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("settings.system.shadow_text") %></p>
  <% on = Shadow.global?(current_user.tenant) %>
  <p class="mt-2"><span class="ss-badge <%= on ? 'ss-badge-accent' : '' %>"><%= on ? t("settings.system.on") : t("settings.system.off") %></span></p>
  <% if owner %>
    <%= button_to settings_system_path, method: :patch, params: { shadow: !on }, class: "ss-btn #{on ? 'ss-btn-outline' : 'ss-btn-primary'} mt-3",
                  form: { data: { turbo_confirm: (on ? t("settings.system.shadow_off_confirm") : t("settings.system.shadow_on_confirm")), turbo_confirm_button: t("settings.system.confirm") } } do %>
      <%= on ? t("settings.system.shadow_off") : t("settings.system.shadow_on") %>
    <% end %>
  <% end %>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="plan-t">
  <h2 id="plan-t"><%= t("settings.system.ai_plan") %></h2>
  <% b = @billing %>
  <p class="mt-1">
    <span class="ss-badge ss-badge-accent"><%= Plans::NAMES[b[:plan]] %></span>
    <% if b[:status] == "trial" %><span class="text-sm text-muted"><%= t("settings.system.trial") %></span><% end %>
    <% if b[:expires_at] %><span class="text-sm text-muted"><%= b[:auto_renewing] == false || b[:status] == "canceled" ? t("settings.system.valid_until") : t("settings.system.renews") %> <%= l(b[:expires_at].to_date) %></span><% end %>
  </p>
  <p class="text-sm text-muted mt-1"><%= t("settings.system.ai_plan_text") %><%= t("settings.system.trial_days", n: Plans::TRIAL_DAYS) if b[:trial_eligible] %>.</p>
</section>
<%= render "web/settings/firmware" %>
<% end %>
