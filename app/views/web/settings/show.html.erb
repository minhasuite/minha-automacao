<%= render "web/shared/header", title: "Configurações", subtitle: "Dados da empresa, plano, convites, chaves de integração e a sua conta." %>
<% owner = current_user.owner? %>

<div class="lg:grid lg:grid-cols-[11rem_1fr] lg:gap-6 lg:items-start">
<nav class="ss-subnav" aria-label="Seções">
  <% [ [ "Empresa", "empresa", "office-building" ], [ "Plano", "plano", "sparkles" ], [ "Convites", "convites", "user-group" ],
       [ "Chaves de integração", "chaves", "link" ], [ "Outra empresa", "entrar", "users" ], [ "Minha conta", "conta", "user-group" ], [ "Seus dados", "dados", "download" ] ].each do |label, id, ico| %>
    <a href="#<%= id %>"><%= icon(ico, "size-4") %><%= label %></a>
  <% end %>
</nav>
<div class="min-w-0">
<section class="ss-card ss-card-pad scroll-mt-20 lg:scroll-mt-6" id="empresa">
  <h2>Empresa</h2>
  <%= form_with model: @company, scope: :company, url: settings_company_path, method: :patch, class: "mt-3 grid gap-4 md:grid-cols-3" do |f| %>
    <fieldset class="contents" <%= "disabled" unless owner %>>
      <div><%= f.label :name, "Razão social", class: "ss-label" %><%= f.text_field :name, class: "ss-input", required: true %></div>
      <div><%= f.label :trade_name, "Nome fantasia", class: "ss-label" %><%= f.text_field :trade_name, class: "ss-input" %></div>
      <div><%= f.label :document, "CNPJ", class: "ss-label" %><%= f.text_field :document, value: document_text(@company.document), class: "ss-input", inputmode: "numeric", "data-mask": "document" %></div>
      <div><%= f.label :phone, "Telefone", class: "ss-label" %><%= f.telephone_field :phone, value: phone_text(@company.phone), class: "ss-input", "data-mask": "phone" %></div>
      <div><%= f.label :email, "E-mail", class: "ss-label" %><%= f.email_field :email, class: "ss-input" %></div>
      <div><%= f.label :city, "Cidade", class: "ss-label" %><%= f.text_field :city, class: "ss-input" %></div>
      <div><%= f.label :uf, "UF", class: "ss-label" %><%= f.text_field :uf, class: "ss-input", maxlength: 2 %></div>
      <div><%= f.label :ibge_code, "Código IBGE do município", class: "ss-label" %><%= f.text_field :ibge_code, class: "ss-input num", inputmode: "numeric", maxlength: 7 %></div>
      <% if owner %><div class="md:col-span-3 ss-actions"><%= f.submit "Salvar empresa", class: "ss-btn ss-btn-primary" %></div><% end %>
    </fieldset>
  <% end %>
</section>

<section class="ss-card ss-card-pad scroll-mt-20 lg:scroll-mt-6 mt-4" id="plano">
  <h2>Plano</h2>
  <% b = @billing %>
  <p class="mt-1">
    <span class="ss-badge ss-badge-accent"><%= Plans::NAMES[b[:plan]] %></span>
    <% if b[:status] == "trial" %><span class="text-sm text-muted">teste grátis</span><% end %>
    <% if b[:expires_at] %><span class="text-sm text-muted"><%= b[:auto_renewing] == false || b[:status] == "canceled" ? "vale até" : "renova em" %> <%= l(b[:expires_at].to_date) %></span><% end %>
    <% if b[:provider] == "manual" %><span class="text-sm text-muted">cortesia</span><% end %>
    <% if b[:provider] == "licencas" %><span class="text-sm text-muted">assinado pelo site</span><% end %>
  </p>
  <p class="text-sm text-muted mt-1">Tudo que não usa IA é grátis. A assinatura libera a IA. Assine pelo app Minha Automação no celular (Google Play)<%= ", com #{Plans::TRIAL_DAYS} dias grátis" if b[:trial_eligible] %>.</p>
  <div class="mt-3 grid gap-3 md:grid-cols-3">
    <% b[:catalog].each do |c| %>
      <div class="ss-card ss-card-pad <%= "ring-2 ring-accent" if c[:plan] == b[:plan] %>">
        <h3 class="font-bold"><%= c[:name] %></h3>
        <p class="text-sm"><%= c[:prices].empty? ? "R$ 0" : c[:prices].map { |pr| "#{Money.format(pr[:price_cents])}/#{pr[:base_plan] == "anual" ? "ano" : "mês"}" }.join(" ou ") %></p>
        <ul class="text-sm text-muted mt-2">
          <% if c[:plan] == Plans::DEFAULT %>
            <li>Tudo que não usa IA</li><li>Sem IA</li>
          <% else %>
            <li>Pergunte à IA (<%= c[:limits][:ai]["ask"] %>/mês)</li>
            <li>Resumo diário (<%= c[:limits][:ai]["daily_summary"] %>/mês)</li>
            <li><%= c[:limits][:ai_tier] == "standard" ? "IA mais caprichada" : "IA rápida" %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</section>

<section class="ss-card ss-card-pad scroll-mt-20 lg:scroll-mt-6 mt-4" id="convites">
  <h2>Convites</h2>
  <p class="text-sm text-muted mt-1">Gere um código e mande para a pessoa: ela cria a conta e entra com ele em "Entrar em outra empresa". Vale 7 dias, uso único.</p>
  <% if current_user.admin? %>
    <%= form_with url: settings_invite_path, class: "mt-3 flex flex-wrap gap-2 items-end" do %>
      <div><label class="ss-label" for="invite_role">Papel</label>
        <%= select_tag :role, options_for_select((owner ? %w[member admin] : %w[member]).map { |r| [ User::ROLE_LABELS[r], r ] }), id: "invite_role", class: "ss-input" %></div>
      <%= submit_tag "Gerar código", class: "ss-btn ss-btn-primary", name: nil %>
    <% end %>
  <% else %>
    <p class="text-sm text-muted mt-2">Só administrador ou dono convida.</p>
  <% end %>
  <ul class="mt-4 divide-y divide-line">
    <% current_user.tenant.users.order(:name).each do |u| %>
      <li class="py-2 flex items-center justify-between gap-3 text-sm"><span class="truncate"><%= u.name %> <span class="text-muted"><%= u.email %></span></span><span class="ss-badge"><%= u.role_label %></span></li>
    <% end %>
  </ul>
</section>

<section class="ss-card ss-card-pad scroll-mt-20 lg:scroll-mt-6 mt-4" id="chaves">
  <h2>Chaves de integração</h2>
  <p class="text-sm text-muted mt-1">Para outro sistema falar com a API (cabeçalho <code>X-Api-Key</code>). Criadas e revogadas pelo dono em <code>/api/v1/api_keys</code>; a chave em claro aparece só na criação.</p>
  <% keys = ServiceApiKey.active.joins(:user).where(users: { tenant_id: current_user.tenant_id }).order(created_at: :desc) %>
  <% if keys.any? %>
    <ul class="mt-3 divide-y divide-line">
      <% keys.each do |k| %>
        <li class="py-2 flex flex-wrap items-center justify-between gap-3 text-sm"><span class="font-semibold"><%= k.name %></span>
          <span class="text-muted"><%= k.scopes.join(", ") %><%= " · usada #{l(k.last_used_at, format: :short)}" if k.last_used_at %></span></li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-muted mt-2">Nenhuma chave ativa.</p>
  <% end %>
</section>

<section class="ss-card ss-card-pad scroll-mt-20 lg:scroll-mt-6 mt-4" id="entrar">
  <h2>Entrar em outra empresa</h2>
  <p class="text-sm text-muted mt-1">Recebeu um código de convite? Entre aqui. Se você é o único membro desta empresa e ela tem dados, marque para descartar.</p>
  <%= form_with url: settings_join_path, class: "mt-3 flex flex-wrap gap-2 items-end", data: { turbo_confirm: "Entrar em outra empresa?" } do %>
    <div class="flex-1"><label class="ss-label" for="join_code">Código</label><%= text_field_tag :code, nil, id: "join_code", class: "ss-input num uppercase", placeholder: "ABCDEFGH23" %></div>
    <label class="ss-check text-xs"><%= check_box_tag :discard_current, "1" %> descartar a atual</label>
    <%= submit_tag "Entrar", class: "ss-btn ss-btn-ghost", name: nil %>
  <% end %>
</section>

<section class="ss-card ss-card-pad scroll-mt-20 lg:scroll-mt-6 mt-4" id="conta">
  <h2>Minha conta</h2>
  <%= form_with scope: :account, url: settings_account_path, method: :patch, class: "mt-3 grid gap-4 md:grid-cols-2" do |f| %>
    <div><%= f.label :name, "Nome", class: "ss-label" %><%= f.text_field :name, value: current_user.name, class: "ss-input", required: true %></div>
    <div><%= f.label :email, "E-mail", class: "ss-label" %><%= f.email_field :email, value: current_user.email, class: "ss-input", required: true %></div>
    <div><%= f.label :current_password, "Senha atual", class: "ss-label" %><%= f.password_field :current_password, class: "ss-input", autocomplete: "current-password" %></div>
    <div><%= f.label :password, "Nova senha", class: "ss-label" %><%= f.password_field :password, class: "ss-input", minlength: 8, autocomplete: "new-password" %></div>
    <div class="md:col-span-2"><%= f.submit "Salvar conta", class: "ss-btn ss-btn-primary" %></div>
  <% end %>
  <div class="mt-4 flex flex-wrap gap-2 items-center">
    <span class="text-sm font-semibold text-muted">Tema:</span>
    <button type="button" class="ss-btn ss-btn-ghost ss-btn-sm" data-action="theme#set" data-theme-theme-param="light">Claro</button>
    <button type="button" class="ss-btn ss-btn-ghost ss-btn-sm" data-action="theme#set" data-theme-theme-param="dark">Escuro</button>
    <button type="button" class="ss-btn ss-btn-ghost ss-btn-sm" data-action="theme#set" data-theme-theme-param="system">Do sistema</button>
  </div>
</section>

<section class="ss-card ss-card-pad scroll-mt-20 lg:scroll-mt-6 mt-4" id="dados">
  <h2>Seus dados</h2>
  <div class="mt-3 flex flex-wrap gap-3">
    <%= link_to settings_export_path, class: "ss-btn ss-btn-ghost", data: { turbo: false } do %><%= icon("download", "size-4") %>Exportar dados (JSON)<% end %>
    <% if owner %>
      <%= form_with url: settings_wipe_path, class: "flex gap-2", data: { turbo_confirm: "Apagar os dados da empresa? A conta, os membros e o plano ficam." } do %>
        <%= text_field_tag :confirm, nil, placeholder: "Digite ZERAR", class: "ss-input w-36", "aria-label": "Confirmação para zerar" %><%= submit_tag "Zerar dados", class: "ss-btn ss-btn-danger", name: nil %>
      <% end %>
    <% end %>
    <%= form_with url: settings_account_path, method: :delete, class: "flex gap-2", data: { turbo_confirm: "Excluir sua conta? Se você é o último membro, a empresa inteira é apagada." } do %>
      <%= text_field_tag :confirm, nil, placeholder: "Digite EXCLUIR", class: "ss-input w-36", "aria-label": "Confirmação para excluir" %><%= submit_tag "Excluir conta", class: "ss-btn ss-btn-danger", name: nil %>
    <% end %>
  </div>
</section>
</div>
</div>
