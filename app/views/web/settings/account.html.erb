<%= render "web/shared/header", title: t("settings.title"), subtitle: t("settings.account.subtitle") %>
<%= render layout: "web/settings/frame", locals: { current: :account } do %>
<section class="ss-card ss-card-pad" aria-labelledby="conta-t">
  <h2 id="conta-t"><%= t("settings.nav.account") %></h2>
  <%= ss_form_with scope: :account, url: settings_account_path, method: :patch, class: "mt-3 grid gap-4 md:grid-cols-2" do |f| %>
    <%= f.ss_text_field :name, value: current_user.name, required: true, label: t("settings.account.name") %>
    <%= f.ss_email_field :email, value: current_user.email, required: true, label: t("sessions.email") %>
    <%= f.ss_password_field :current_password, autocomplete: "current-password", label: t("settings.account.current_password") %>
    <%= f.ss_password_field :password, minlength: 8, autocomplete: "new-password", label: t("settings.account.new_password") %>
    <div class="md:col-span-2"><%= f.ss_submit t("settings.account.save") %></div>
  <% end %>
  <div class="mt-4 flex flex-wrap gap-2 items-center">
    <span class="text-sm font-semibold text-muted" aria-hidden="true"><%= t("layout.theme") %>:</span>
    <%= render Ss::ThemeSwitcherComponent.new(palettes: false, oled: false, label: t("layout.theme"), css: "w-72 max-w-full") %>
  </div>
  <div class="mt-4 flex flex-wrap gap-2 items-center">
    <span class="text-sm font-semibold text-muted"><%= t("layout.language") %>:</span>
    <%= render "web/shared/locale_picker" %>
  </div>
</section>

<section class="ss-card ss-card-pad mt-4 flex flex-wrap items-center justify-between gap-3" aria-labelledby="aparelhos-t">
  <div class="min-w-0">
    <h2 id="aparelhos-t"><%= t("settings.nav.push") %></h2>
    <p class="text-sm text-muted mt-1"><%= t("settings.account.push_text") %></p>
  </div>
  <%= link_to push_subscriptions_path, class: "ss-btn ss-btn-outline" do %><%= icon("bell", "size-4") %><%= t("settings.account.push_manage") %><% end %>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="excluir-t">
  <h2 id="excluir-t"><%= t("settings.account.delete_title") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("settings.account.delete_text") %></p>
  <%= ss_form_with url: settings_account_path, method: :delete, class: "mt-3 flex gap-2", data: { turbo_confirm_tone: "danger", turbo_confirm_button: t("shared.confirm.delete"), turbo_confirm: t("settings.account.delete_confirm") } do |f| %>
    <%= f.ss_text_field :confirm, value: nil, placeholder: t("settings.account.delete_type"), class: "w-36", label: t("settings.account.delete_aria"), hide_label: true %><%= f.ss_submit t("settings.account.delete_button"), variant: :danger, name: nil %>
  <% end %>
</section>
<% end %>
