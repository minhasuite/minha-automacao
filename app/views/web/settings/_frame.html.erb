<%# locals: (current:) -%>
<%# Locais (cadastro, áreas, aparelhos) moraram no menu lateral até 11/2026; agora aqui. A lista é a do SettingsNav (a busca usa a mesma). %>
<div class="lg:grid lg:grid-cols-[13rem_1fr] lg:gap-6 lg:items-start">
  <%# Ss::SubnavComponent: coluna fixa no desktop, menu (atual + grade) no celular. %>
  <%= render Ss::SubnavComponent.new(label: t("settings.nav.label"),
                                     items: SettingsNav.items(current_user).map { |i| { label: i[:label], href: i[:path], icon: icon(i[:icon], "size-4"), current: i[:key] == current } }) %>
  <div class="min-w-0"><%= yield %></div>
</div>
