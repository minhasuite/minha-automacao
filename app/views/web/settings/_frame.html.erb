<%# locals: (current:) -%>
<% reader = current_user.reader? %>
<% items = [ [ "Painéis", settings_dashboards_path, "view-boards", :dashboards, !reader ],
             [ "Pessoas", people_path, "users", :people, current_user.admin? ],
             [ "Chaves de integração", api_keys_path, "link", :api_keys, current_user.owner? ],
             [ "Aplicativos", apps_path, "cube", :apps, current_user.owner? ],
             [ "IA", settings_ai_path, "sparkles", :ai, current_user.admin? ],
             [ "Saúde", settings_health_path, "shield-check", :health, current_user.admin? ],
             [ "Sistema", settings_system_path, "cog", :system, !reader ],
             [ "Minha conta", settings_account_path, "user-group", :account, true ],
             [ "Meus aparelhos", push_subscriptions_path, "bell", :push, true ] ] %>
<div class="lg:grid lg:grid-cols-[13rem_1fr] lg:gap-6 lg:items-start">
  <nav class="ss-subnav" aria-label="Seções das configurações">
    <% items.each do |label, path, ico, key, show| %>
      <% next unless show %>
      <%= link_to path, "aria-current": (key == current ? "page" : nil) do %><%= icon(ico, "size-4") %><%= label %><% end %>
    <% end %>
  </nav>
  <div class="min-w-0"><%= yield %></div>
</div>
