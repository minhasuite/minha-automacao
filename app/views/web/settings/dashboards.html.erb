<% manageable = @sites.select { |s| SiteMembership.allowed?(@roles[s.id], :manage) } %>
<%= render "web/shared/header", title: t("settings.title"), subtitle: t("settings_dashboards.subtitle") do %>
  <% if manageable.size == 1 %>
    <%= link_to new_site_dashboard_path(manageable.first), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("settings_dashboards.new") %><% end %>
  <% elsif manageable.any? %>
    <details class="ss-menu">
      <summary class="ss-btn ss-btn-primary"><%= icon("plus", "size-4") %><%= t("settings_dashboards.new") %></summary>
      <div class="ss-menu-list" role="menu">
        <% manageable.each do |s| %><%= link_to t("settings_dashboards.in", site: s.name), new_site_dashboard_path(s), role: "menuitem" %><% end %>
      </div>
    </details>
  <% end %>
<% end %>
<%= render layout: "web/settings/frame", locals: { current: :dashboards } do %>
<% if @dashboards.empty? %>
  <div class="ss-card ss-empty"><p class="font-bold text-ink"><%= t("settings_dashboards.none") %></p><p class="mt-1"><%= t("settings_dashboards.none_hint") %></p><%= link_to new_site_path, class: "ss-btn ss-btn-primary mt-4" do %><%= icon("plus", "size-4") %><%= t("sites.form.create") %><% end %></div>
<% else %>
  <div class="ss-card overflow-x-auto">
    <table class="ss-table">
      <thead><tr><th><%= t("settings_dashboards.dashboard") %></th><th class="hidden sm:table-cell"><%= t("people.site") %></th><th class="hidden md:table-cell"><%= t("settings_dashboards.views") %></th><th class="hidden sm:table-cell"><%= t("settings_dashboards.in_menu") %></th><th class="hidden lg:table-cell"><%= t("settings_dashboards.who") %></th><th class="r"><span class="sr-only"><%= t("people.actions") %></span></th></tr></thead>
      <tbody>
        <% @dashboards.each do |d| %>
          <% manage = SiteMembership.allowed?(@roles[d.site_id], :manage) %>
          <tr>
            <td>
              <%= link_to dashboard_path(d), class: "flex items-center gap-3 no-underline text-ink hover:text-accent min-w-0" do %>
                <span class="grid place-items-center size-9 shrink-0 rounded-xl bg-accent-soft text-accent"><%= icon(d.icon_name, "size-4") %></span>
                <span class="min-w-0"><span class="block font-semibold truncate"><%= d.name %></span>
                  <span class="block text-xs text-muted"><%= d.auto? ? t("settings_dashboards.auto") : t("settings_dashboards.version", n: d.version) %><%= " · #{t('settings_dashboards.draft')}" if d.draft? %><%= " · #{t('settings_dashboards.site_default')}" if d.site_default %><%= " · #{t('settings_dashboards.your_home')}" if current_user.dashboard_prefs[d.site_id] == d.id %><span class="sm:hidden"> · <%= d.site.name %></span></span></span>
              <% end %>
            </td>
            <td class="hidden sm:table-cell"><%= d.site.name %></td>
            <td class="hidden md:table-cell"><%= d.auto? ? t("settings_dashboards.auto_views") : Array(d.definition["views"]).size %></td>
            <td class="hidden sm:table-cell"><%= d.sidebar ? t("settings_dashboards.yes") : t("settings_dashboards.no") %></td>
            <td class="hidden lg:table-cell"><%= d.roles.empty? ? t("logbook.all") : d.roles.map { |r| SiteMembership.role_label(r) }.to_sentence %></td>
            <td class="r">
              <div class="flex justify-end gap-1">
                <% if manage %>
                  <%= link_to edit_dashboard_path(d), class: "dw-tool", title: t("shared.edit_name", name: d.name), "aria-label": t("shared.edit_name", name: d.name) do %><%= icon("pencil", "size-4") %><% end %>
                  <%= button_to duplicate_dashboard_path(d), class: "dw-tool", title: t("settings_dashboards.duplicate", name: d.name), "aria-label": t("settings_dashboards.duplicate", name: d.name) do %><%= icon("duplicate", "size-4") %><% end %>
                  <%= button_to dashboard_path(d), method: :delete, class: "dw-tool dw-tool-danger", title: t("settings_dashboards.delete", name: d.name), "aria-label": t("settings_dashboards.delete", name: d.name), form: { data: { turbo_confirm: t("settings_dashboards.delete_confirm", name: d.name), turbo_confirm_button: t("settings_dashboards.delete_button") } } do %><%= icon("trash", "size-4") %><% end %>
                <% else %>
                  <%= link_to t("settings_dashboards.open"), dashboard_path(d), class: "ss-btn ss-btn-ghost ss-btn-sm" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
<% end %>
