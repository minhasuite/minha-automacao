<% manageable = @sites.select { |s| SiteMembership.allowed?(@roles[s.id], :manage) } %>
<%= render "web/shared/header", title: t("settings.title"), subtitle: t("settings_dashboards.subtitle") do %>
  <% if manageable.size == 1 %>
    <%= link_to new_site_dashboard_path(manageable.first), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("settings_dashboards.new") %><% end %>
  <% elsif manageable.any? %>
    <details class="ss-menu is-end">
      <summary class="ss-menu-btn"><%= icon("plus", "") %><%= t("settings_dashboards.new") %><%= icon("chevron-down", "") %></summary>
      <div role="menu">
        <% manageable.each do |s| %><%= link_to t("settings_dashboards.in", site: s.name), new_site_dashboard_path(s), role: "menuitem" %><% end %>
      </div>
    </details>
  <% end %>
<% end %>
<%= render layout: "web/settings/frame", locals: { current: :dashboards } do %>
<% if @dashboards.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("settings_dashboards.none"), text: t("settings_dashboards.none_hint"), css: "ss-card") do %><%= link_to new_site_path, class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("sites.form.create") %><% end %><% end %>
<% else %>
  <%= render Ss::DataTableComponent.new(rows: @dashboards, id: "paineis", caption: t("settings_dashboards.dashboard"), sort: @sort, dir: @dir, tools: false, max_height: "none") do |tb| %>
    <% tb.column :name, t("settings_dashboards.dashboard"), sortable: true do |d| %>
      <%= link_to dashboard_path(d), class: "flex items-center gap-3 no-underline text-ink hover:text-accent min-w-0 text-left" do %>
        <span class="grid place-items-center size-9 shrink-0 rounded-xl bg-accent-soft text-accent"><%= icon(d.icon_name, "size-4") %></span>
        <span class="min-w-0"><span class="block font-semibold truncate"><%= d.name %></span>
          <span class="block text-xs text-muted"><%= d.auto? ? t("settings_dashboards.auto") : t("settings_dashboards.version", n: d.version) %><%= " · #{t('settings_dashboards.draft')}" if d.draft? %><%= " · #{t('settings_dashboards.site_default')}" if d.site_default %><%= " · #{t('settings_dashboards.your_home')}" if current_user.dashboard_prefs[d.site_id] == d.id %></span></span>
      <% end %>
    <% end %>
    <% tb.column :site, t("people.site"), sortable: true do |d| %><%= d.site.name %><% end %>
    <% tb.column :views, t("settings_dashboards.views") do |d| %><%= d.auto? ? t("settings_dashboards.auto_views") : Array(d.definition["views"]).size %><% end %>
    <% tb.column :sidebar, t("settings_dashboards.in_menu") do |d| %><%= d.sidebar ? t("settings_dashboards.yes") : t("settings_dashboards.no") %><% end %>
    <% tb.column :roles, t("settings_dashboards.who") do |d| %><%= d.roles.empty? ? t("logbook.all") : d.roles.map { |r| SiteMembership.role_label(r) }.to_sentence %><% end %>
    <% tb.column :actions, t("people.actions"), align: :right do |d| %>
      <div class="flex justify-end gap-1">
        <% if SiteMembership.allowed?(@roles[d.site_id], :manage) %>
          <%= link_to edit_dashboard_path(d), class: "dw-tool", title: t("shared.edit_name", name: d.name), "aria-label": t("shared.edit_name", name: d.name) do %><%= icon("pencil", "size-4") %><% end %>
          <%= button_to duplicate_dashboard_path(d), class: "dw-tool", title: t("settings_dashboards.duplicate", name: d.name), "aria-label": t("settings_dashboards.duplicate", name: d.name) do %><%= icon("duplicate", "size-4") %><% end %>
          <%= button_to dashboard_path(d), method: :delete, class: "dw-tool dw-tool-danger", title: t("settings_dashboards.delete", name: d.name), "aria-label": t("settings_dashboards.delete", name: d.name), form: { data: { turbo_confirm_tone: "danger", turbo_confirm: t("settings_dashboards.delete_confirm", name: d.name), turbo_confirm_button: t("settings_dashboards.delete_button") } } do %><%= icon("trash", "size-4") %><% end %>
        <% else %>
          <%= link_to t("settings_dashboards.open"), dashboard_path(d), class: "ss-btn ss-btn-ghost ss-btn-sm" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
<% end %>
