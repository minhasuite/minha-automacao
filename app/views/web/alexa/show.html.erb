<%= render "web/shared/header", title: t("alexa.title"), subtitle: t("alexa.subtitle", site: @site.name), back: site_path(@site) %>
<%= render "web/sites/tabs", site: @site, current: :alexa %>
<% admin = can?(:admin) %>
<% exposed = @items.count { |t, _| t.alexa_exposed } %>

<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
  <%= form_with url: site_alexa_path(@site), method: :patch, class: "ss-card min-w-0", aria: { label: t("alexa.items_label") }, data: { controller: "filter" } do %>
    <div class="ss-card-pad flex flex-wrap items-center justify-between gap-2 border-b border-line">
      <div>
        <h2 class="font-bold"><%= t("alexa.items") %></h2>
        <p class="text-sm text-muted"><%= t("bridges.count_html", n: tag.span(exposed, class: "num"), total: tag.span(@items.size, class: "num")) %></p>
      </div>
      <% if admin && @items.any? %><%= submit_tag t("integrations.common.save"), class: "ss-btn ss-btn-primary", name: nil %><% end %>
    </div>
    <% if @items.empty? %>
      <p class="ss-card-pad text-sm text-muted"><%= t("alexa.empty") %></p>
    <% else %>
      <div class="ss-card-pad border-b border-line">
        <label for="ax-busca" class="ss-label"><%= t("bridges.search") %></label>
        <input type="search" id="ax-busca" class="ss-input" placeholder="<%= t("alexa.search_hint") %>" autocomplete="off" data-filter-target="input" data-action="input->filter#apply">
        <p class="text-sm text-muted mt-2" data-filter-target="empty" hidden><%= t("bridges.no_match") %> <button type="button" class="font-semibold text-accent" data-action="filter#clear"><%= t("bridges.clear") %></button></p>
      </div>
      <ul class="ss-rows">
        <% @items.each do |t, ifaces| %>
          <% id = Alexa::SmartHome.endpoint_id(t) %>
          <% critical = t.risk == "critical" %>
          <li class="flex-wrap" data-filter-target="item">
            <label class="flex items-center gap-3 min-w-0 flex-1 cursor-pointer">
              <%= hidden_field_tag "items[#{id}][exposed]", "0", id: nil %>
              <%= check_box_tag "items[#{id}][exposed]", "1", t.alexa_exposed, id: "ax-#{id}", disabled: !admin, class: "size-5 accent-[var(--accent)]" %>
              <span class="grid place-items-center size-10 shrink-0 rounded-xl <%= t.alexa_exposed ? 'ss-grad' : 'bg-accent-soft text-accent' %>"><%= icon(t.is_a?(Scene) ? "sparkles" : point_icon(t)) %></span>
              <span class="min-w-0">
                <% title, context = t.is_a?(Scene) ? [ t.name, t("alexa.scene") ] : t.display_names %>
                <span class="block font-bold text-ink truncate"><%= title %></span>
                <span class="block text-xs text-muted truncate"><%= [ context, ifaces.map(&:label).join(", ") ].compact.join(" · ") %></span>
              </span>
            </label>
            <div class="flex items-center gap-2 w-full sm:w-auto">
              <% if critical %><span class="ss-badge ss-badge-danger shrink-0"><%= t("bridges.critical") %></span><% end %>
              <%= text_field_tag "items[#{id}][name]", t.alexa_name, placeholder: t("alexa.spoken", name: t.name), maxlength: 60, disabled: !admin,
                                 class: "ss-input text-sm sm:w-56", "aria-label": t("alexa.spoken_of", name: t.name) %>
            </div>
            <% if critical && admin %>
              <label class="ss-check w-full text-sm text-danger">
                <%= check_box_tag "items[#{id}][confirm]", "1", false, id: "axc-#{id}" %>
                <%= t("alexa.confirm", name: t.name) %>
                <%= t("alexa.voice_code") if ifaces.any? { |i| i.namespace == "Alexa.LockController" } %>
              </label>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if admin %><div class="ss-card-pad border-t border-line"><%= submit_tag t("integrations.common.save"), class: "ss-btn ss-btn-primary", name: nil %></div><% end %>
    <% end %>
  <% end %>

  <div class="grid gap-4">
    <section class="ss-card ss-card-pad" aria-labelledby="links-t">
      <h2 id="links-t" class="font-bold"><%= t("alexa.links") %></h2>
      <% if @links.empty? %>
        <p class="text-sm text-muted mt-1"><%= t("alexa.no_links") %></p>
      <% else %>
        <ul class="mt-2 grid gap-2">
          <% @links.each do |tk| %>
            <li class="flex items-center justify-between gap-2 text-sm">
              <span class="min-w-0"><span class="block font-semibold truncate"><%= tk.user.name %></span><span class="text-xs text-muted"><%= t("alexa.since", date: l(tk.created_at.to_date)) %><%= ", #{t("alexa.used_ago", ago: time_ago_in_words(tk.last_used_at))}" if tk.last_used_at %></span></span>
              <% if admin %><%= button_to t("alexa.unlink"), unlink_site_alexa_path(@site, token_id: tk.id), method: :delete, class: "ss-btn ss-btn-ghost text-sm", form: { data: { turbo_confirm: t("alexa.unlink_confirm") } } %><% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="ss-card ss-card-pad" aria-labelledby="client-t">
      <h2 id="client-t" class="font-bold">Skill (Developer Console)</h2>
      <dl class="mt-2 grid gap-2 text-sm">
        <div><dt class="text-muted"><%= t("alexa.auth_url") %></dt><dd class="font-mono text-xs break-all"><%= oauth_authorize_url %></dd></div>
        <div><dt class="text-muted"><%= t("alexa.token_url") %></dt><dd class="font-mono text-xs break-all"><%= request.base_url %>/oauth/token</dd></div>
        <div><dt class="text-muted">Client ID</dt><dd class="font-mono text-xs break-all"><%= @tenant.alexa_client_id || t("alexa.not_generated") %></dd></div>
        <% if @secret %>
          <div class="rounded-xl bg-accent-soft p-2"><dt class="text-muted"><%= t("alexa.secret_once") %></dt><dd class="font-mono text-xs break-all" data-controller="clipboard"><%= @secret %></dd></div>
        <% end %>
      </dl>
      <% if current_user.owner? && admin %>
        <%= form_with url: client_site_alexa_path(@site), class: "mt-3 grid gap-2" do %>
          <%= label_tag :redirect_uris, t("alexa.redirect_uris"), class: "ss-label" %>
          <%= text_area_tag :redirect_uris, @tenant.alexa_redirect_uris.join("\n"), rows: 3, class: "ss-input text-xs font-mono", placeholder: "https://pitangui.amazon.com/api/skill/link/..." %>
          <div class="flex flex-wrap gap-2">
            <%= submit_tag t("alexa.save_urls"), class: "ss-btn ss-btn-ghost", name: nil %>
            <%= submit_tag @tenant.alexa_client_id ? t("alexa.new_secret") : t("alexa.new_client"), name: "generate", class: "ss-btn ss-btn-primary",
                           data: (@tenant.alexa_client_id ? { turbo_confirm: t("alexa.new_secret_confirm") } : {}) %>
          </div>
        <% end %>
      <% end %>
    </section>
  </div>
</div>
