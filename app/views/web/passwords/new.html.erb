<% content_for :title, "Esqueci a senha — Minha Automação" %>
<div class="text-center">
  <span class="mx-auto grid place-items-center size-12 rounded-2xl bg-accent-soft text-accent"><%= icon("question-mark-circle", "size-6") %></span>
  <h1 class="text-2xl mt-4">Esqueceu a senha?</h1>
  <p class="text-sm text-muted mt-1">Mandamos um link para o seu e-mail. Ele vale 30 minutos.</p>
</div>
<%= form_with url: forgot_password_path, class: "mt-6 space-y-4" do |f| %>
  <div><%= f.label :email, "E-mail", class: "ss-label" %><%= f.email_field :email, class: "ss-input", required: true, autofocus: true, placeholder: "seu@email.com" %></div>
  <%= f.submit "Enviar link", class: "ss-btn ss-btn-primary w-full min-h-12" %>
<% end %>
<p class="mt-6 text-sm text-center"><%= link_to login_path, class: "inline-flex items-center gap-1 text-accent font-bold" do %><%= icon("arrow-left", "size-4") %>Voltar para o login<% end %></p>
