<% content_for :title, "#{t("passwords.title")} — Minha Automação" %>
<div class="text-center">
  <span class="ss-icon-tile is-accent is-lg mx-auto"><%= icon("question-mark-circle", "") %></span>
  <h1 class="text-2xl mt-4"><%= t("passwords.heading") %></h1>
  <p class="text-sm text-muted mt-1"><%= t("passwords.lead") %></p>
</div>
<%= ss_form_with url: forgot_password_path, class: "mt-6 space-y-4" do |f| %>
  <%= f.ss_email_field :email, label: t("sessions.email"), required: true, autofocus: true, placeholder: t("sessions.email_hint") %>
  <%= f.ss_submit t("passwords.submit"), css: "w-full min-h-12" %>
<% end %>
<p class="mt-6 text-sm text-center"><%= link_to login_path, class: "inline-flex items-center gap-1 text-accent font-bold" do %><%= icon("arrow-left", "size-4") %><%= t("passwords.back") %><% end %></p>
