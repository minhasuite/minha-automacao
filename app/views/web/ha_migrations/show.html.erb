<% s = @state %>
<% status = s["status"] %>
<% step = { nil => 1, "failed" => (s["phase"] == "import" ? 3 : 1), "fetching" => 2, "preview" => 2, "importing" => 3, "done" => 4 }.fetch(status, 1) %>
<% steps = [ [ t("ha_migration.steps.connect"), "link" ], [ t("ha_migration.steps.review"), "clipboard-list" ], [ t("ha_migration.steps.import"), "download" ], [ t("ha_migration.steps.check"), "badge-check" ] ] %>
<%= render "web/shared/header", title: t("ha_migration.title"), subtitle: t("ha_migration.subtitle"), back: site_integrations_path(@site) %>

<ol class="mg-steps" aria-label="<%= t("ha_migration.steps_label") %>">
  <% steps.each_with_index do |(label, ico), i| %>
    <li class="<%= 'mg-done' if i + 1 < step %> <%= 'mg-now' if i + 1 == step %>" <%= 'aria-current="step"'.html_safe if i + 1 == step %>>
      <span class="mg-dot"><%= i + 1 < step ? icon("check", "size-4") : icon(ico, "size-4") %></span><span class="mg-label"><%= label %></span>
    </li>
  <% end %>
</ol>

<% if status.nil? || (status == "failed" && s["phase"] != "import") %>
  <section class="ss-card ss-card-pad mg-panel ss-rise" aria-labelledby="mg-connect">
    <h2 id="mg-connect"><%= t("ha_migration.connect_title") %></h2>
    <p class="text-sm text-muted mt-1"><%= t("ha_migration.connect_hint") %></p>
    <% if status == "failed" %>
      <p class="mg-error" role="alert"><%= icon("exclamation-circle", "size-5 shrink-0") %><%= s["error"] %></p>
    <% end %>
    <%= form_with url: connect_site_ha_migration_path(@site), class: "grid gap-4 mt-4 sm:grid-cols-2" do %>
      <div class="sm:col-span-2"><label class="ss-label" for="mg-url"><%= t("ha_migration.url") %></label>
        <%= url_field_tag :url, @integration&.settings&.dig("url"), class: "ss-input", id: "mg-url", placeholder: "http://192.168.0.10:8123", required: true %></div>
      <div class="sm:col-span-2"><label class="ss-label" for="mg-token"><%= t("ha_migration.token") %></label>
        <%= password_field_tag :token, nil, class: "ss-input num", id: "mg-token", autocomplete: "off", placeholder: (@integration&.secrets&.dig("token").present? ? t("ha_migration.token_saved") : "eyJhbGciOi…"), required: @integration&.secrets&.dig("token").blank? %></div>
      <ol class="mg-help sm:col-span-2">
        <li><%= t("ha_migration.help1_html") %></li>
        <li><%= t("ha_migration.help2_html") %></li>
        <li><%= t("ha_migration.help3") %></li>
      </ol>
      <div class="sm:col-span-2"><button class="ss-btn ss-btn-primary"><%= icon("link", "size-4") %><%= t("ha_migration.connect_read") %></button></div>
    <% end %>
  </section>

<% elsif status == "fetching" %>
  <section class="ss-card ss-card-pad mg-panel mg-wait" data-controller="reload" data-reload-every-value="2000" role="status">
    <span class="mg-orb" aria-hidden="true"></span>
    <h2><%= t("ha_migration.reading") %></h2>
    <p class="text-sm text-muted"><%= t("ha_migration.reading_hint") %></p>
  </section>

<% elsif status == "preview" %>
  <% p = s["preview"] %>
  <%= form_with url: import_site_ha_migration_path(@site), class: "mg-review" do %>
    <div class="mg-stats">
      <div class="mg-stat"><span><%= icon("view-boards", "size-5") %></span><strong class="num"><%= p.dig("areas", "total") %></strong><small><%= t("ha_migration.stats.areas_html", n: p.dig("areas", "new")) %></small></div>
      <div class="mg-stat"><span><%= icon("cube", "size-5") %></span><strong class="num"><%= p.dig("devices", "matched") %>/<%= p.dig("devices", "total") %></strong><small><%= t("ha_migration.stats.devices_html") %></small></div>
      <div class="mg-stat"><span><%= icon("collection", "size-5") %></span><strong class="num"><%= p["entities"] %></strong><small><%= t("ha_migration.stats.entities_html") %></small></div>
      <div class="mg-stat"><span><%= icon("calculator", "size-5") %></span><strong class="num"><%= p["helpers"].values.sum %></strong><small><%= t("ha_migration.stats.helpers") %></small></div>
      <div class="mg-stat"><span><%= icon("sparkles", "size-5") %></span><strong class="num"><%= p["automations"].size + p["scripts"].size %></strong><small><%= t("ha_migration.stats.automations_html") %></small></div>
    </div>
    <% if p.dig("devices", "matched") < p.dig("devices", "total") %>
      <p class="mg-note"><%= icon("information-circle", "size-5 shrink-0") %><span><%= t("ha_migration.missing_html", n: p.dig("devices", "total") - p.dig("devices", "matched")) %></span></p>
    <% end %>

    <section class="ss-card ss-card-pad">
      <label class="ss-check font-semibold"><%= check_box_tag :helpers, "1", true, id: "mg-helpers" %><% names = t("ha_migration.helper_kinds").stringify_keys %>
      <%= t("ha_migration.helpers") %> <span class="font-normal text-muted">(<%= p["helpers"].map { |d, n| "#{n} #{names.fetch(d, d)}" }.join(", ").presence || t("ha_migration.none") %>)</span></label>
    </section>
    <% { "automations" => t("ha_migration.groups.automations"), "scripts" => t("ha_migration.groups.scripts"), "scenes" => t("ha_migration.groups.scenes") }.each do |key, title| %>
      <% list = p[key] %>
      <% next if list.empty? %>
      <details class="ss-card mg-group" open>
        <summary><span class="font-bold text-ink"><%= title %></span><span class="ss-chip-count"><%= list.size %></span></summary>
        <div class="mg-items">
          <% list.each do |it| %>
            <label class="hx-opt"><%= check_box_tag "#{key}[]", it["id"], true, id: "mg-#{key}-#{it['id'].parameterize}" %>
              <span class="min-w-0 flex-1 truncate font-semibold text-ink"><%= it["name"] %></span>
              <% if key == "automations" %><span class="ss-badge <%= it['enabled'] ? 'ss-badge-success' : '' %>"><%= it["enabled"] ? t("ha_migration.enabled_ha") : t("ha_migration.disabled") %></span><% end %></label>
          <% end %>
        </div>
      </details>
    <% end %>
    <div class="mg-actions">
      <button class="ss-btn ss-btn-primary"><%= icon("download", "size-4") %><%= t("ha_migration.import_shadow") %></button>
      <%= button_to t("ha_migration.restart"), reset_site_ha_migration_path(@site), class: "ss-btn ss-btn-ghost", form: { class: "contents" } %>
    </div>
  <% end %>

<% elsif status == "importing" || (status == "failed" && s["phase"] == "import") %>
  <% pr = s["progress"] || {} %>
  <% pct = pr["total"] ? ((pr["i"].to_i + 0.5) / pr["total"] * 100).round : 4 %>
  <section class="ss-card ss-card-pad mg-panel mg-wait" <%= 'data-controller="reload" data-reload-every-value="1500"'.html_safe if status == "importing" %> role="status">
    <% if status == "importing" %>
      <span class="mg-orb" aria-hidden="true"></span>
      <% phases = Integrations::HomeAssistantImport::STEPS.keys.map { |k| t(k.to_s.delete_suffix("!"), scope: "ha_migration.phases") } %>
      <h2><%= t("ha_migration.importing") %><%= ": #{phases[pr['i']]}" if pr["i"] %></h2>
      <div class="mg-bar" role="progressbar" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100"><span style="width: <%= pct %>%"></span></div>
      <ul class="mg-phases">
        <% phases.each_with_index do |label, i| %>
          <li class="<%= 'mg-done' if pr['i'] && i < pr['i'] %> <%= 'mg-now' if pr['i'] == i %>"><%= icon(pr["i"] && i < pr["i"] ? "check-circle" : "clock", "size-4") %><%= label %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="mg-error" role="alert"><%= icon("exclamation-circle", "size-5 shrink-0") %><%= t("ha_migration.stopped") %> <%= s["error"] %></p>
      <%= button_to t("ha_migration.restart"), reset_site_ha_migration_path(@site), class: "ss-btn ss-btn-primary mt-3" %>
    <% end %>
  </section>

<% elsif status == "done" %>
  <% r = s["report"] %>
  <% c = r["came"] %>
  <section class="ss-card ss-card-pad mg-panel mg-hero ss-rise">
    <span class="mg-check"><%= icon("check", "size-7") %></span>
    <div>
      <h2><%= t("ha_migration.done_title") %></h2>
      <p class="text-sm text-muted mt-1"><%= t("ha_migration.done_hint_html", link: link_to(t("ha_migration.shadow"), site_shadow_path(@site))) %></p>
    </div>
  </section>
  <div class="mg-stats">
    <% [ [ "view-boards", c["areas"], t("ha_migration.came.areas") ], [ "cube", c["devices_added"], t("ha_migration.came.devices") ], [ "collection", c["entities"], t("ha_migration.came.entities") ],
         [ "calculator", c["helpers"], t("ha_migration.came.helpers") ], [ "color-swatch", c["scenes"], t("ha_migration.came.scenes") ], [ "sparkles", c["automations"], t("ha_migration.came.automations") ], [ "play", c["scripts"], t("ha_migration.came.scripts") ] ].each do |ico, n, label| %>
      <div class="mg-stat"><span><%= icon(ico, "size-5") %></span><strong class="num"><%= n %></strong><small><%= label %></small></div>
    <% end %>
  </div>
  <div class="grid gap-4 lg:grid-cols-2 mt-4">
    <section class="ss-card ss-card-pad" aria-labelledby="mg-bp">
      <h2 id="mg-bp"><%= t("ha_migration.blueprints") %> <span class="ss-chip-count"><%= r["blueprints"].size %></span></h2>
      <p class="text-sm text-muted mt-1"><%= t("ha_migration.blueprints_hint") %></p>
      <ul class="mg-report">
        <% r["blueprints"].each do |b| %>
          <li class="<%= b['lossless'] ? 'mg-ok' : 'mg-warn' %>"><%= icon(b["lossless"] ? "check-circle" : "exclamation-circle", "size-5 shrink-0") %>
            <div class="min-w-0"><p class="font-semibold text-ink"><%= b["name"] %> <span class="text-xs text-muted font-normal"><%= b["kind"] == "script" ? t("ha_migration.kind_script") : t("ha_migration.kind_automation") %><%= " · #{t("ha_migration.enabled")}" if b["enabled"] %></span></p>
              <% if b["notes"].any? %><p class="text-xs text-muted"><%= b["notes"].join(" · ") %></p><% else %><p class="text-xs text-muted"><%= t("ha_migration.lossless") %></p><% end %></div></li>
        <% end %>
        <% if r["blueprints"].empty? %><li class="text-sm text-muted"><%= t("ha_migration.none_chosen") %></li><% end %>
      </ul>
    </section>
    <section class="ss-card ss-card-pad" aria-labelledby="mg-left">
      <h2 id="mg-left"><%= t("ha_migration.left_out") %> <span class="ss-chip-count"><%= r["left_out"].size %></span></h2>
      <p class="text-sm text-muted mt-1"><%= t("ha_migration.left_out_hint") %></p>
      <ul class="mg-report">
        <% r["left_out"].first(100).each do |l| %>
          <li class="mg-warn"><%= icon("minus-circle", "size-5 shrink-0") %><div class="min-w-0"><p class="font-semibold text-ink break-words"><%= l["what"] %></p><p class="text-xs text-muted"><%= l["why"] %></p></div></li>
        <% end %>
        <% if r["left_out"].empty? %><li class="mg-ok"><%= icon("check-circle", "size-5 shrink-0") %><p class="text-sm"><%= t("ha_migration.nothing_left") %></p></li><% end %>
      </ul>
    </section>
  </div>
  <div class="mg-actions">
    <%= link_to site_shadow_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("eye", "size-4") %><%= t("ha_migration.see_shadow") %><% end %>
    <%= link_to site_automations_path(@site), class: "ss-btn ss-btn-outline" do %><%= icon("sparkles", "size-4") %><%= t("ha_migration.groups.automations") %><% end %>
    <%= button_to t("ha_migration.import_again"), reset_site_ha_migration_path(@site), class: "ss-btn ss-btn-ghost", form: { class: "contents" } %>
  </div>
<% end %>
