<% s = @state %>
<% status = s["status"] %>
<% step = { nil => 1, "failed" => (s["phase"] == "import" ? 3 : 1), "fetching" => 2, "preview" => 2, "importing" => 3, "done" => 4 }.fetch(status, 1) %>
<% steps = [ t("ha_migration.steps.connect"), t("ha_migration.steps.review"), t("ha_migration.steps.import"), t("ha_migration.steps.check") ] %>
<%= render "web/shared/header", title: t("ha_migration.title"), subtitle: t("ha_migration.subtitle"), back: site_integrations_path(@site) %>

<%# Passos no Ss::WizardComponent (modo servidor): o passo atual pelo estado; a tela do passo é o painel. %>
<%= render Ss::WizardComponent.new(current: step - 1, aria: { label: t("ha_migration.steps_label") }) do |w| %>
<% steps.each { |label| w.with_step(title: label) } %>
<% if status.nil? || (status == "failed" && s["phase"] != "import") %>
  <section class="ss-card ss-card-pad max-w-[46rem]" aria-labelledby="mg-connect">
    <h2 id="mg-connect"><%= t("ha_migration.connect_title") %></h2>
    <p class="text-sm text-muted mt-1"><%= t("ha_migration.connect_hint") %></p>
    <% if status == "failed" %>
      <%= render(Ss::CalloutComponent.new(tone: :danger, class: "mt-3")) { s["error"] } %>
    <% end %>
    <%= form_with url: connect_site_ha_migration_path(@site), class: "grid gap-4 mt-4 sm:grid-cols-2" do %>
      <div class="sm:col-span-2"><label class="ss-label" for="mg-url"><%= t("ha_migration.url") %></label>
        <%= url_field_tag :url, @integration&.settings&.dig("url"), class: "ss-input", id: "mg-url", placeholder: "http://192.168.0.10:8123", required: true %></div>
      <div class="sm:col-span-2"><label class="ss-label" for="mg-token"><%= t("ha_migration.token") %></label>
        <%= password_field_tag :token, nil, class: "ss-input num", id: "mg-token", autocomplete: "off", placeholder: (@integration&.secrets&.dig("token").present? ? t("ha_migration.token_saved") : "eyJhbGciOi…"), required: @integration&.secrets&.dig("token").blank? %></div>
      <ol class="sm:col-span-2 grid gap-1 pl-5 list-decimal text-sm text-ink-2">
        <li><%= t("ha_migration.help1_html") %></li>
        <li><%= t("ha_migration.help2_html") %></li>
        <li><%= t("ha_migration.help3") %></li>
      </ol>
      <div class="sm:col-span-2"><button class="ss-btn ss-btn-primary"><%= icon("link", "size-4") %><%= t("ha_migration.connect_read") %></button></div>
    <% end %>
  </section>

<% elsif status == "fetching" %>
  <section class="ss-card ss-card-pad max-w-[46rem] grid justify-items-center gap-2.5 py-10 text-center" data-controller="ss-reload" data-ss-reload-every-value="2000" role="status">
    <span class="ss-spinner is-lg" aria-hidden="true"></span>
    <h2><%= t("ha_migration.reading") %></h2>
    <p class="text-sm text-muted"><%= t("ha_migration.reading_hint") %></p>
  </section>

<% elsif status == "preview" %>
  <% p = s["preview"] %>
  <% plain = ->(key, **o) { strip_tags(t(key, **o).to_s.gsub("<br>", " ")) } %>
  <%= form_with url: import_site_ha_migration_path(@site), class: "grid gap-4", multipart: true do %>
    <%= render Ss::KpiStripComponent.new(label: t("ha_migration.steps.review"), items: [
          { label: plain.call("ha_migration.stats.areas_html", n: p.dig("areas", "new")), value: p.dig("areas", "total").to_s },
          { label: plain.call("ha_migration.stats.devices_html"), value: "#{p.dig("devices", "matched")}/#{p.dig("devices", "total")}" },
          { label: plain.call("ha_migration.stats.entities_html"), value: p["entities"].to_s },
          { label: t("ha_migration.stats.helpers"), value: p["helpers"].values.sum.to_s },
          { label: plain.call("ha_migration.stats.automations_html"), value: (p["automations"].size + p["scripts"].size).to_s } ]) %>
    <% if p.dig("devices", "matched") < p.dig("devices", "total") %>
      <%= render(Ss::CalloutComponent.new(tone: :warn)) { t("ha_migration.missing_html", n: p.dig("devices", "total") - p.dig("devices", "matched")) } %>
    <% end %>

    <section class="ss-card ss-card-pad">
      <label class="ss-check font-semibold"><%= check_box_tag :helpers, "1", true, id: "mg-helpers" %><% names = t("ha_migration.helper_kinds").stringify_keys %>
      <%= t("ha_migration.helpers") %> <span class="font-normal text-muted">(<%= p["helpers"].map { |d, n| "#{n} #{names.fetch(d, d)}" }.join(", ").presence || t("ha_migration.none") %>)</span></label>
      <div class="mt-3">
        <label class="ss-label" for="mg-config"><%= t("ha_migration.config_yaml") %></label>
        <%= file_field_tag :config_yaml, id: "mg-config", accept: ".yaml,.yml", class: "ss-input" %>
        <p class="ss-hint"><%= t("ha_migration.config_yaml_hint") %></p>
      </div>
    </section>
    <% { "automations" => t("ha_migration.groups.automations"), "scripts" => t("ha_migration.groups.scripts"), "scenes" => t("ha_migration.groups.scenes") }.each do |key, title| %>
      <% list = p[key] %>
      <% next if list.empty? %>
      <details class="ss-card" open>
        <summary class="ss-summary px-4 py-3.5"><span class="font-bold text-ink"><%= title %></span><span class="ss-chip-count"><%= list.size %></span></summary>
        <div class="ss-option-grid grid gap-1.5 px-2.5 pb-3 max-h-96 overflow-auto grid-cols-[repeat(auto-fill,minmax(17rem,1fr))]">
          <% list.each do |it| %>
            <%= render Ss::OptionCardComponent.new(type: :checkbox, name: "#{key}[]", value: it["id"], checked: true, dense: true, id: "mg-#{key}-#{it['id'].parameterize}",
                                                   title: it["name"], description: (it["enabled"] ? t("ha_migration.enabled_ha") : t("ha_migration.disabled") if key == "automations")) %>
          <% end %>
        </div>
      </details>
    <% end %>
    <div class="flex flex-wrap gap-2.5">
      <button class="ss-btn ss-btn-primary"><%= icon("download", "size-4") %><%= t("ha_migration.import_shadow") %></button>
      <%= button_to t("ha_migration.restart"), reset_site_ha_migration_path(@site), class: "ss-btn ss-btn-ghost", form: { class: "contents" } %>
    </div>
  <% end %>

<% elsif status == "importing" || (status == "failed" && s["phase"] == "import") %>
  <% pr = s["progress"] || {} %>
  <% pct = pr["total"] ? ((pr["i"].to_i + 0.5) / pr["total"] * 100).round : 4 %>
  <% if status == "importing" %>
    <% phases = Integrations::HomeAssistantImport::STEPS.keys.map { |k| t(k.to_s.delete_suffix("!"), scope: "ha_migration.phases") } %>
    <%# Fases no Ss::JobProgressComponent; a página se recarrega (ss-reload) até terminar. %>
    <div class="max-w-[46rem]" data-controller="ss-reload" data-ss-reload-every-value="1500">
      <%= render Ss::JobProgressComponent.new(id: "mg-import", title: "#{t("ha_migration.importing")}#{": #{phases[pr['i']]}" if pr["i"]}", state: :running,
                                              progress: pct / 100.0, steps: phases, current_step: pr["i"]) %>
    </div>
  <% else %>
    <section class="ss-card ss-card-pad max-w-[46rem] grid gap-3" role="status">
      <%= render(Ss::CalloutComponent.new(tone: :danger, title: t("ha_migration.stopped").delete_suffix(":"))) { s["error"] } %>
      <div><%= button_to t("ha_migration.restart"), reset_site_ha_migration_path(@site), class: "ss-btn ss-btn-primary" %></div>
    </section>
  <% end %>

<% elsif status == "done" %>
  <% r = s["report"] %>
  <% c = r["came"] %>
  <section class="ss-card ss-card-pad ss-rise flex items-center gap-4">
    <span class="ss-icon-tile is-success is-lg is-circle"><%= icon("check", "size-7") %></span>
    <div>
      <h2><%= t("ha_migration.done_title") %></h2>
      <p class="text-sm text-muted mt-1"><%= t("ha_migration.done_hint_html", link: link_to(t("ha_migration.shadow"), site_shadow_path(@site))) %></p>
    </div>
  </section>
  <%= render Ss::KpiStripComponent.new(label: t("ha_migration.steps.check"), class: "mt-4",
                                       items: [ [ c["areas"], t("ha_migration.came.areas") ], [ c["devices_added"], t("ha_migration.came.devices") ], [ c["entities"], t("ha_migration.came.entities") ],
                                                [ c["helpers"], t("ha_migration.came.helpers") ], [ c["scenes"], t("ha_migration.came.scenes") ], [ c["automations"], t("ha_migration.came.automations") ],
                                                [ c["scripts"], t("ha_migration.came.scripts") ] ].map { |n, label| { label: label, value: n.to_s } }) %>
  <div class="grid gap-4 lg:grid-cols-2 mt-4">
    <section class="ss-card ss-card-pad" aria-labelledby="mg-bp">
      <h2 id="mg-bp"><%= t("ha_migration.blueprints") %> <span class="ss-chip-count"><%= r["blueprints"].size %></span></h2>
      <p class="text-sm text-muted mt-1"><%= t("ha_migration.blueprints_hint") %></p>
      <ul class="mg-report">
        <% r["blueprints"].each do |b| %>
          <li class="<%= b['lossless'] ? 'mg-ok' : 'mg-warn' %>"><%= icon(b["lossless"] ? "check-circle" : "exclamation-circle", "size-5 shrink-0") %>
            <div class="min-w-0"><p class="font-semibold text-ink"><%= b["name"] %> <span class="text-xs text-muted font-normal"><%= b["kind"] == "script" ? t("ha_migration.kind_script") : t("ha_migration.kind_automation") %><%= " · #{t("ha_migration.enabled")}" if b["enabled"] %></span></p>
              <% if b["notes"].any? %><p class="text-xs text-muted"><%= b["notes"].join(" · ") %></p><% else %><p class="text-xs text-muted"><%= t("ha_migration.lossless") %></p><% end %></div></li>
        <% end %>
        <% if r["blueprints"].empty? %><li class="text-sm text-muted"><%= t("ha_migration.none_chosen") %></li><% end %>
      </ul>
    </section>
    <section class="ss-card ss-card-pad" aria-labelledby="mg-left">
      <h2 id="mg-left"><%= t("ha_migration.left_out") %> <span class="ss-chip-count"><%= r["left_out"].size %></span></h2>
      <p class="text-sm text-muted mt-1"><%= t("ha_migration.left_out_hint") %></p>
      <ul class="mg-report">
        <% r["left_out"].first(100).each do |l| %>
          <li class="mg-warn"><%= icon("minus-circle", "size-5 shrink-0") %><div class="min-w-0"><p class="font-semibold text-ink break-words"><%= l["what"] %></p><p class="text-xs text-muted"><%= l["why"] %></p></div></li>
        <% end %>
        <% if r["left_out"].empty? %><li class="mg-ok"><%= icon("check-circle", "size-5 shrink-0") %><p class="text-sm"><%= t("ha_migration.nothing_left") %></p></li><% end %>
      </ul>
    </section>
  </div>
  <div class="flex flex-wrap gap-2.5 mt-4">
    <%= link_to site_shadow_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("eye", "size-4") %><%= t("ha_migration.see_shadow") %><% end %>
    <%= link_to site_automations_path(@site), class: "ss-btn ss-btn-outline" do %><%= icon("sparkles", "size-4") %><%= t("ha_migration.groups.automations") %><% end %>
    <%= button_to t("ha_migration.import_again"), reset_site_ha_migration_path(@site), class: "ss-btn ss-btn-ghost", form: { class: "contents" } %>
  </div>
<% end %>
<% end %>

<% if @integration&.secrets&.dig("token").present? && !%w[fetching importing].include?(status) %>
  <% dz = s["dashboards"].to_h %>
  <section id="mg-dash" class="ss-card ss-card-pad mt-4 ss-rise" aria-labelledby="mg-dash-t" <%= 'data-controller="ss-reload" data-ss-reload-every-value="2000"'.html_safe if dz["status"] == "running" %>>
    <h2 id="mg-dash-t" class="flex items-center gap-2"><%= icon("view-boards", "size-5 text-accent") %><%= t("ha_migration.dash.title") %></h2>
    <p class="text-sm text-muted mt-1"><%= t("ha_migration.dash.hint") %></p>
    <% if dz["status"] == "running" %>
      <p class="text-sm mt-3 flex items-center gap-2" role="status"><span class="ss-spinner is-sm" aria-hidden="true"></span><%= t("ha_migration.dash.running") %></p>
    <% elsif dz["status"] == "failed" %>
      <%= render(Ss::CalloutComponent.new(tone: :danger, class: "mt-3")) { dz["error"] } %>
    <% elsif dz["status"] == "done" %>
      <p class="text-sm mt-3 text-success" role="status"><%= t("ha_migration.dash.done", n: dz["list"].size) %></p>
      <ul class="mt-2 flex flex-wrap gap-2">
        <% dz["list"].each do |d| %><li><%= link_to d["name"], dashboard_path(d["id"]), class: "ss-btn ss-btn-outline ss-btn-sm" %></li><% end %>
      </ul>
      <% if dz["notes"].any? %>
        <details class="mt-3"><summary class="ss-summary text-sm font-semibold text-accent"><%= t("ha_migration.dash.notes", n: dz["notes"].size) %></summary>
          <ul class="mg-report mt-2"><% dz["notes"].each do |n| %><li class="mg-warn"><%= icon("minus-circle", "size-5 shrink-0") %><p class="text-sm break-words"><%= n %></p></li><% end %></ul></details>
      <% end %>
    <% end %>
    <% unless dz["status"] == "running" %>
      <%= button_to dashboards_site_ha_migration_path(@site), class: "ss-btn ss-btn-primary mt-4", form: { data: { turbo_confirm: (t("ha_migration.dash.confirm") if dz["status"] == "done") } } do %><%= icon("download", "size-4") %><%= dz["status"] == "done" ? t("ha_migration.dash.again") : t("ha_migration.dash.import") %><% end %>
    <% end %>
  </section>
<% end %>
