<% m = @package.manifest %>
<%= render "web/shared/header", title: @package.name, subtitle: [ t("packages.version", v: @package.version), m["description"].to_s.truncate(160).presence ].compact.join(" · "), back: site_packages_path(@site) do %>
  <% if can?(:manage) %>
    <%= link_to check_package_path(@package), class: "ss-btn ss-btn-outline" do %><%= icon("refresh", "size-4") %><%= t("packages.show.check") %><% end %>
    <%= render Ss::ButtonComponent.new(label: t("packages.show.remove"), icon: icon("trash", "size-4"), href: package_path(@package), method: :delete, variant: :ghost, tone: :danger,
                                       confirm: t("packages.show.confirm"), confirm_tone: :danger, confirm_button: t("packages.show.remove")) %>
  <% end %>
<% end %>

<section class="ss-card ss-card-pad mb-4 grid gap-1 text-sm" aria-label="<%= t("packages.source") %>">
  <p><span class="text-muted"><%= t("packages.source") %>:</span> <span class="num break-all"><%= @package.source_url %></span></p>
  <p><span class="text-muted"><%= t("packages.show.installed_at") %></span> <%= l(@package.created_at, format: :short) %> · <span class="text-muted"><%= t("packages.show.updated_at") %></span> <%= l(@package.updated_at, format: :short) %></p>
</section>

<ul class="ss-card ss-rows" aria-label="<%= t("packages.show.items") %>">
  <% @package.installed.each do |r| %>
    <% type = Packages.item_type(r["type"]) %>
    <% item = @package.items.find { |i| i["type"] == r["type"] && i["key"] == r["key"] } || {} %>
    <li>
      <div class="min-w-0 flex-1">
        <p class="font-bold text-ink truncate"><%= type&.title(item) || r["key"] %></p>
        <p class="text-xs text-muted truncate"><%= type&.label || r["type"] %> · <span class="num"><%= r["key"] %></span></p>
      </div>
      <% if r["id"] && (path = type&.path(r)) %><%= link_to t("packages.show.open"), path, class: "ss-btn ss-btn-ghost ss-btn-sm" %><% end %>
    </li>
  <% end %>
</ul>
