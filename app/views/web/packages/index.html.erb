<%= render "web/shared/header", title: t("packages.index.title"), subtitle: t("packages.index.subtitle", site: @site.name), back: site_path(@site) %>
<%= render "web/sites/tabs", site: @site, current: :packages %>

<% if can?(:manage) %>
  <%= ss_form_with url: preview_site_packages_path(@site), class: "ss-card ss-card-pad mb-4 flex flex-wrap items-end gap-3" do |f| %>
    <%= f.ss_url_field :url, label: t("packages.index.url"), value: params[:url], required: true, placeholder: t("packages.index.url_ph"), wrapper_class: "min-w-64 flex-1" %>
    <%= render Ss::ButtonComponent.new(label: t("packages.index.preview"), icon: icon("eye", "size-4"), type: :submit) %>
    <p class="basis-full text-xs text-muted"><%= t("packages.index.hint_html") %></p>
  <% end %>
<% end %>

<nav class="ss-chips is-solid mb-4" data-controller="ss-scroll-current" aria-label="<%= t("packages.catalog.tabs") %>">
  <%= link_to t("packages.catalog.installed", n: @packages.size), site_packages_path(@site), class: "ss-chip no-underline", "aria-current": (@tab == "installed" ? "page" : nil) %>
  <%= link_to site_packages_path(@site, tab: "explorar"), class: "ss-chip no-underline", "aria-current": (@tab == "explore" ? "page" : nil) do %><%= icon("search", "size-4") %><%= t("packages.catalog.explore") %><% end %>
</nav>

<% if @tab == "explore" %>
  <%= render "web/packages/catalog", site: @site, catalog: @catalog, entries: @entries, tags: @tags, installed: @installed %>
<% elsif @packages.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("packages.index.empty"), text: t("packages.index.empty_text"), css: "ss-card") %>
<% else %>
  <ul class="ss-card ss-rows" aria-label="<%= t("packages.index.installed") %>">
    <% @packages.each do |pk| %>
      <li>
        <span class="ss-icon-tile is-accent"><%= icon("archive") %></span>
        <div class="min-w-0 flex-1">
          <p class="font-bold text-ink truncate"><%= link_to pk.name, package_path(pk), class: "text-ink no-underline hover:text-accent" %></p>
          <p class="text-xs text-muted truncate"><span class="num"><%= pk.version %></span> · <%= t("packages.items", n: pk.installed.size) %> · <%= pk.manifest["description"].to_s.truncate(80) %></p>
        </div>
        <%= link_to package_path(pk), class: "ss-icon-btn", title: t("packages.open_name", name: pk.name), "aria-label": t("packages.open_name", name: pk.name) do %><%= icon("chevron-right", "") %><% end %>
      </li>
    <% end %>
  </ul>
<% end %>
