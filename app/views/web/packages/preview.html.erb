<% m = @manifest %>
<%= render "web/shared/header", title: m["name"].presence || t("packages.package"), subtitle: [ t("packages.version", v: m["version"]), (@existing ? t("packages.preview.installed", v: @existing.version) : t("packages.preview.new")), m["description"].to_s.truncate(160).presence ].compact.join(" · "), back: site_packages_path(@site) %>

<section class="ss-card ss-card-pad mb-4 grid gap-1 text-sm" aria-label="<%= t("packages.source") %>">
  <p><span class="text-muted"><%= t("packages.source") %>:</span> <span class="num break-all"><%= @source %></span></p>
  <% if m["author"].present? %><p><span class="text-muted"><%= t("packages.preview.author") %>:</span> <%= m["author"].to_s.truncate(80) %></p><% end %>
  <% if @existing && !@newer.nil? %><p class="<%= @newer ? 'text-success' : 'text-muted' %>"><%= @newer ? t("packages.preview.newer") : t("packages.preview.latest") %></p><% end %>
</section>

<% if @errors.any? %>
  <div class="ss-card ss-card-pad mb-4" role="alert">
    <p class="font-bold text-danger"><%= t("packages.preview.problems") %></p>
    <ul class="mt-2 grid gap-1 text-sm text-ink-2 list-disc pl-5"><% @errors.first(30).each do |e| %><li><%= e %></li><% end %></ul>
  </div>
<% end %>

<% labels = { "add" => [ t("packages.preview.add"), "text-success" ], "update" => [ t("packages.preview.update"), "text-accent" ], "remove" => [ t("packages.preview.remove"), "text-danger" ] } %>
<ul class="ss-card ss-rows mb-4" aria-label="<%= t("packages.preview.changes") %>">
  <% @plan.each do |i| %>
    <li>
      <div class="min-w-0 flex-1">
        <p class="font-bold text-ink truncate"><%= i["label"] %></p>
        <p class="text-xs text-muted truncate"><%= i["type_label"] || i["type"] %> · <span class="num"><%= i["key"] %></span></p>
      </div>
      <% text, css = labels.fetch(i["action"]) %>
      <span class="text-sm font-bold <%= css %> shrink-0"><%= text %></span>
    </li>
  <% end %>
</ul>

<% if @errors.empty? %>
  <%= form_with url: install_site_packages_path(@site), class: "flex flex-wrap gap-2" do %>
    <%= hidden_field_tag :url, @url, id: nil %>
    <button type="submit" class="ss-btn ss-btn-primary"><%= icon("download", "size-4") %><%= @existing ? t("packages.preview.update_to", v: m["version"]) : t("packages.preview.install") %></button>
    <%= link_to t("site_helpers.form.cancel"), site_packages_path(@site), class: "ss-btn ss-btn-ghost" %>
  <% end %>
<% end %>
