<%= render "web/shared/header", title: t("automations.index.title"), subtitle: t("automations.scenes.subtitle", site: @site.name) do %>
  <% if can?(:manage) %><%= link_to new_site_scene_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("automations.scenes.new") %><% end %><% end %>
<% end %>
<%= render "web/automations/tabs", site: @site, current: :scenes %>

<% if @total.zero? %>
  <%= render Ss::EmptyStateComponent.new(title: t("automations.scenes.empty"), text: t("automations.scenes.empty_hint"), css: "ss-card") do %>
    <% if can?(:manage) %><%= link_to new_site_scene_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("automations.index.create_first") %><% end %><% end %>
  <% end %>
<% else %>
  <%= ss_form_with url: site_scenes_path(@site), method: :get, class: "mb-3 flex flex-wrap items-end gap-3", role: "search" do |f| %>
    <%= f.ss_search_field :q, label: t("automations.common.search"), value: params[:q], placeholder: t("automations.scenes.search_placeholder"), wrapper_class: "min-w-48 flex-1" %>
    <% if @labels.any? %><%= f.ss_select :rotulo, @labels, label: t("automations.index.label"), selected: params[:rotulo], include_blank: t("automations.index.all_m"), data: { autosubmit: true } %><% end %>
    <%= render Ss::IconButtonComponent.new(icon: icon("search", ""), label: t("automations.common.search"), type: :submit) %>
  <% end %>
  <% if @scenes.empty? %>
    <%= render Ss::EmptyStateComponent.new(title: t("automations.scenes.no_match"), variant: :busca, css: "ss-card") do %><%= link_to t("automations.scripts_page.clear"), site_scenes_path(@site), class: "ss-btn ss-btn-ghost" %><% end %>
  <% else %>
    <% groups = category_groups(@scenes) %>
    <% groups.each do |category, items| %>
    <%= render layout: "web/shared/category_group", locals: { name: category, count: items.size, grouped: groups.size > 1 || category } do %>
    <ul class="ss-card ss-rows" aria-label="<%= t("automations.tabs.scenes") %><%= " · #{category}" if category %>">
      <% items.each do |s| %>
        <% risk = s.risk %>
        <li id="scene-<%= s.id %>">
          <span class="ss-icon-tile is-accent"><%= icon(s.icon.presence_in(HelperTypes::ICONS) || "sparkles") %></span>
          <div class="min-w-0 flex-1 basis-40">
            <p class="font-bold text-ink break-words"><%= can?(:manage) ? link_to(s.name, edit_scene_path(s), class: "text-ink no-underline hover:text-accent") : s.name %>
              <% if risk != "normal" %> <span class="ss-badge ss-badge-warn"><%= Point::RISKS[risk] %></span><% end %></p>
            <p class="text-sm text-muted"><%= t("automations.scenes.points", count: s.items.size) %> <%= label_chips(s) %></p>
          </div>
          <div class="flex w-full flex-wrap items-center justify-end gap-2 sm:w-auto">
            <% if can?(:manage) %><%= render "web/dashboards/add_to_link", type: "scene", record: s, css: "ss-btn ss-btn-ghost ss-btn-sm" %><% end %>
            <% if can?(:command, risk: risk) %>
              <%= render Ss::ButtonComponent.new(label: t("automations.scenes.activate"), icon: icon("lightning-bolt", ""), href: activate_scene_path(s), method: :post, params: { back: request.fullpath }, size: :sm,
                                                 form: { class: "contents" }, confirm: t("automations.scenes.activate_confirm", name: s.name), confirm_button: t("automations.scenes.activate")) %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
    <% end %>
    <% end %>
  <% end %>
<% end %>
