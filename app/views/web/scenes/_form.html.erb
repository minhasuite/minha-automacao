<%# locals: (site:, record:) -%>
<% writable = site.points.includes(:device, :area).where(writable: true).ordered.to_a %>
<% by_id = writable.index_by(&:id) %>
<% groups = writable.group_by { |p| p.area&.name || p.device.name }.sort.map { |g, ps| [ g, ps.map { |p| [ p.name, p.id ] } ] } %>
<%= form_with model: record.new_record? ? [ site, record ] : record, class: "grid gap-4 max-w-4xl" do |f| %>
  <%= render "web/shared/errors", record: record %>
  <%= hidden_field_tag :back, params[:back], id: nil %>
  <section class="ss-card ss-card-pad grid gap-4 sm:grid-cols-2">
    <div><%= f.label :name, t("automations.settings.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", required: true, placeholder: t("automations.scenes.name_ph"), autofocus: record.new_record? %></div>
    <%= render "web/shared/organize_fields", f: f, record: record, categories: category_options(site.scenes) %>
    <div class="sm:col-span-2"><%= render "web/shared/icon_picker", name: "scene[icon]", selected: record.icon, icons: HelperTypes::ICONS, id: "scene_icon" %></div>
    <div class="sm:col-span-2"><label class="ss-check"><%= f.check_box :shadow %> <%= t("automations.scenes.shadow") %></label>
      <% if Shadow.site?(site) %><p class="text-xs text-muted mt-1"><%= t("automations.scenes.site_shadow") %></p><% end %></div>
  </section>

  <section class="ss-card ss-card-pad" aria-labelledby="scene-capture">
    <h2 id="scene-capture"><%= t("automations.scenes.capture") %></h2>
    <p class="text-sm text-muted mb-3"><%= t("automations.scenes.capture_hint") %></p>
    <label class="sr-only" for="capture_ids"><%= t("automations.scenes.capture_points") %></label>
    <%= select_tag "capture_ids[]", grouped_options_for_select(groups), multiple: true, size: [ writable.size, 8 ].min.clamp(3, 8), class: "ss-input", id: "capture_ids" %>
    <p class="text-xs text-muted mt-1"><%= t("automations.scenes.multi") %></p>
    <%= button_tag name: "capture", value: "1", formnovalidate: true, class: "ss-btn ss-btn-outline ss-btn-sm mt-3" do %><%= icon("photograph", "size-4") %><%= t("automations.scenes.capture") %><% end %>
  </section>

  <section class="ss-card ss-card-pad" aria-labelledby="scene-items">
    <h2 id="scene-items"><%= t("automations.scenes.items") %></h2>
    <p class="text-sm text-muted mb-3"><%= t("automations.scenes.items_hint") %></p>
    <%# Um item por linha da lista da gem (.ss-rows num card): ponto, ação e valor. %>
    <ol class="ss-rows ss-card">
      <% (record.items + Array.new(record.items.empty? ? 3 : 1) { {} }).each_with_index do |item, i| %>
        <% point = by_id[item["point_id"]] %>
        <li class="grid gap-2 sm:grid-cols-[2fr_1.3fr_1.3fr]">
          <div class="min-w-0"><label class="ss-label" for="item_<%= i %>_point"><%= t("automations.labels.field_types.point") %></label>
            <%= select_tag "scene[items][#{i}][point_id]", grouped_options_for_select(groups, item["point_id"]), include_blank: t("automations.fields.pick_point"), class: "ss-input", id: "item_#{i}_point" %>
            <% if point %><p class="text-xs text-muted mt-1"><%= t("automations.scenes.now", value: point_value_text(point)) %></p><% end %></div>
          <div class="min-w-0"><label class="ss-label" for="item_<%= i %>_command"><%= t("automations.scenes.action") %></label>
            <%= select_tag "scene[items][#{i}][command]", options_for_select(command_options(point), item["command"] || "on"), class: "ss-input", id: "item_#{i}_command" %></div>
          <div class="min-w-0"><label class="ss-label" for="item_<%= i %>_value"><%= t("automations.scenes.value") %></label>
            <% if point&.capability.in?(%w[enum gate]) %>
              <%= select_tag "scene[items][#{i}][value]", options_for_select(point.option_values, item["value"].to_s), include_blank: t("automations.field.no_value"), class: "ss-input", id: "item_#{i}_value" %>
            <% elsif point&.numeric? %>
              <%= number_field_tag "scene[items][#{i}][value]", item["value"], class: "ss-input num", id: "item_#{i}_value", min: point.min, max: point.max, step: point.step || "any" %>
            <% elsif point&.bool? %>
              <p class="text-sm text-muted pt-2"><%= t("automations.scenes.by_action") %></p>
            <% else %>
              <%= text_field_tag "scene[items][#{i}][value]", item["value"], class: "ss-input", id: "item_#{i}_value", placeholder: t("automations.scenes.set_select") %>
            <% end %></div>
        </li>
      <% end %>
    </ol>
  </section>

  <section class="ss-card ss-card-pad">
    <label class="inline-flex items-start gap-2 text-sm"><%= check_box_tag :live, "1", false, id: "scene-live", class: "mt-1" %>
      <span><%= t("automations.scenes.live_html") %></span></label>
  </section>

  <div class="flex flex-wrap gap-2">
    <%= f.submit t("automations.scenes.save"), class: "ss-btn ss-btn-primary" %>
    <%= link_to t("automations.settings.cancel"), back_path, class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
