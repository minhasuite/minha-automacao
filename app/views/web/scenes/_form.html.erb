<%# locals: (site:, record:) -%>
<% writable = site.points.includes(:device, :area).where(writable: true).ordered.to_a %>
<% by_id = writable.index_by(&:id) %>
<% groups = writable.group_by { |p| p.area&.name || p.device.name }.sort.map { |g, ps| [ g, ps.map { |p| [ p.name, p.id ] } ] } %>
<%= ss_form_with model: record.new_record? ? [ site, record ] : record, class: "grid gap-4 max-w-4xl" do |f| %>
  <%= render "web/shared/errors", record: record %>
  <%= hidden_field_tag :back, params[:back], id: nil %>
  <section class="ss-card ss-card-pad grid gap-4 sm:grid-cols-2">
    <%= f.ss_text_field :name, label: t("automations.settings.name"), required: true, placeholder: t("automations.scenes.name_ph"), autofocus: record.new_record? %>
    <%= render "web/shared/organize_fields", f: f, record: record, categories: category_options(site.scenes) %>
    <div class="sm:col-span-2"><%= render "web/shared/icon_picker", name: "scene[icon]", selected: record.icon, icons: HelperTypes::ICONS, id: "scene_icon" %></div>
    <%= f.ss_check_box :shadow, label: t("automations.scenes.shadow"), help: (t("automations.scenes.site_shadow") if Shadow.site?(site)), wrapper_class: "sm:col-span-2" %>
  </section>

  <section class="ss-card ss-card-pad" aria-labelledby="scene-capture">
    <h2 id="scene-capture"><%= t("automations.scenes.capture") %></h2>
    <p class="text-sm text-muted mb-3"><%= t("automations.scenes.capture_hint") %></p>
    <%= ss_fields do |top| %>
      <%= top.ss_select :capture_ids, groups, label: t("automations.scenes.capture_points"), hide_label: true, help: t("automations.scenes.multi"),
                        multiple: true, size: [ writable.size, 8 ].min.clamp(3, 8), id: "capture_ids" %>
    <% end %>
    <%= render Ss::ButtonComponent.new(label: t("automations.scenes.capture"), icon: icon("photograph", ""), type: :submit, name: "capture", value: "1", formnovalidate: true, variant: :outline, size: :sm, class: "mt-3") %>
  </section>

  <section class="ss-card ss-card-pad" aria-labelledby="scene-items">
    <h2 id="scene-items"><%= t("automations.scenes.items") %></h2>
    <p class="text-sm text-muted mb-3"><%= t("automations.scenes.items_hint") %></p>
    <%# Um item por linha da lista da gem (.ss-rows num card): ponto, ação e valor. %>
    <ol class="ss-rows ss-card">
      <% (record.items + Array.new(record.items.empty? ? 3 : 1) { {} }).each_with_index do |item, i| %>
        <% point = by_id[item["point_id"]] %>
        <%= ss_fields "scene[items][#{i}]" do |it| %>
        <li class="grid gap-2 sm:grid-cols-[2fr_1.3fr_1.3fr]">
          <%= it.ss_select :point_id, groups, label: t("automations.labels.field_types.point"), include_blank: t("automations.fields.pick_point"), selected: item["point_id"], id: "item_#{i}_point",
                           help: (t("automations.scenes.now", value: point_value_text(point)) if point), wrapper_class: "min-w-0" %>
          <%= it.ss_select :command, command_options(point), label: t("automations.scenes.action"), selected: item["command"] || "on", id: "item_#{i}_command", wrapper_class: "min-w-0" %>
          <% if point&.capability.in?(%w[enum gate]) %>
            <%= it.ss_select :value, point.option_values, label: t("automations.scenes.value"), include_blank: t("automations.field.no_value"), selected: item["value"].to_s, id: "item_#{i}_value", wrapper_class: "min-w-0" %>
          <% elsif point&.numeric? %>
            <%= it.ss_number_field :value, label: t("automations.scenes.value"), value: item["value"], class: "num", id: "item_#{i}_value", min: point.min, max: point.max, step: point.step || "any", wrapper_class: "min-w-0" %>
          <% elsif point&.bool? %>
            <div class="min-w-0"><p class="ss-label"><%= t("automations.scenes.value") %></p><p class="text-sm text-muted pt-2"><%= t("automations.scenes.by_action") %></p></div>
          <% else %>
            <%= it.ss_text_field :value, label: t("automations.scenes.value"), value: item["value"], id: "item_#{i}_value", placeholder: t("automations.scenes.set_select"), wrapper_class: "min-w-0" %>
          <% end %>
        </li>
        <% end %>
      <% end %>
    </ol>
  </section>

  <section class="ss-card ss-card-pad">
    <%= ss_fields do |top| %><%= top.ss_check_box :live, label: t("automations.scenes.live_html"), unchecked_value: nil, checked: false, id: "scene-live" %><% end %>
  </section>

  <div class="flex flex-wrap gap-2">
    <%= f.ss_submit t("automations.scenes.save") %>
    <%= link_to t("automations.settings.cancel"), back_path, class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
