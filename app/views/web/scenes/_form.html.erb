<%# locals: (site:, record:) -%>
<% writable = site.points.includes(:device, :area).where(writable: true).ordered.to_a %>
<% by_id = writable.index_by(&:id) %>
<% groups = writable.group_by { |p| p.area&.name || p.device.name }.sort.map { |g, ps| [ g, ps.map { |p| [ p.name, p.id ] } ] } %>
<%= form_with model: record.new_record? ? [ site, record ] : record, class: "grid gap-4 max-w-4xl" do |f| %>
  <%= render "web/shared/errors", record: record %>
  <%= hidden_field_tag :back, params[:back], id: nil %>
  <section class="ss-card ss-card-pad grid gap-4 sm:grid-cols-2">
    <div><%= f.label :name, "Nome", class: "ss-label" %><%= f.text_field :name, class: "ss-input", required: true, placeholder: "Chegada, Cinema, Boa noite", autofocus: record.new_record? %></div>
    <div class="sm:col-span-2"><%= render "web/shared/icon_picker", name: "scene[icon]", selected: record.icon, icons: HelperTypes::ICONS, id: "scene_icon" %></div>
    <div class="sm:col-span-2"><label class="ss-check"><%= f.check_box :shadow %> Em sombra: acionar só registra o que faria, nada é enviado</label>
      <% if Shadow.site?(site) %><p class="text-xs text-muted mt-1">O local inteiro está em sombra: vale mesmo desmarcado.</p><% end %></div>
  </section>

  <section class="ss-card ss-card-pad" aria-labelledby="scene-capture">
    <h2 id="scene-capture">Capturar estado agora</h2>
    <p class="text-sm text-muted mb-3">Escolha os pontos e capture como estão agora: viram as linhas abaixo, para ajustar valor por valor. Nada é comandado.</p>
    <label class="sr-only" for="capture_ids">Pontos para capturar</label>
    <%= select_tag "capture_ids[]", grouped_options_for_select(groups), multiple: true, size: [ writable.size, 8 ].min.clamp(3, 8), class: "ss-input", id: "capture_ids" %>
    <p class="text-xs text-muted mt-1">Ctrl (ou Cmd) para marcar vários; no celular, toque em cada um.</p>
    <%= button_tag name: "capture", value: "1", formnovalidate: true, class: "ss-btn ss-btn-outline ss-btn-sm mt-3" do %><%= icon("photograph", "size-4") %>Capturar estado agora<% end %>
  </section>

  <section class="ss-card ss-card-pad" aria-labelledby="scene-items">
    <h2 id="scene-items">Estados da cena</h2>
    <p class="text-sm text-muted mb-3">Cada linha leva o ponto a um estado. Linha sem ponto é ignorada.</p>
    <div class="grid gap-3">
      <% (record.items + Array.new(record.items.empty? ? 3 : 1) { {} }).each_with_index do |item, i| %>
        <% point = by_id[item["point_id"]] %>
        <div class="grid gap-2 sm:grid-cols-[2fr_1.3fr_1.3fr] rounded-2xl border border-line bg-page/40 p-3">
          <div class="min-w-0"><label class="ss-label" for="item_<%= i %>_point">Ponto</label>
            <%= select_tag "scene[items][#{i}][point_id]", grouped_options_for_select(groups, item["point_id"]), include_blank: "Escolha o ponto", class: "ss-input", id: "item_#{i}_point" %>
            <% if point %><p class="text-xs text-muted mt-1">Agora: <%= point_value_text(point) %></p><% end %></div>
          <div class="min-w-0"><label class="ss-label" for="item_<%= i %>_command">Ação</label>
            <%= select_tag "scene[items][#{i}][command]", options_for_select(command_options(point), item["command"] || "on"), class: "ss-input", id: "item_#{i}_command" %></div>
          <div class="min-w-0"><label class="ss-label" for="item_<%= i %>_value">Valor</label>
            <% if point&.capability.in?(%w[enum gate]) %>
              <%= select_tag "scene[items][#{i}][value]", options_for_select(point.option_values, item["value"].to_s), include_blank: "Sem valor", class: "ss-input", id: "item_#{i}_value" %>
            <% elsif point&.numeric? %>
              <%= number_field_tag "scene[items][#{i}][value]", item["value"], class: "ss-input num", id: "item_#{i}_value", min: point.min, max: point.max, step: point.step || "any" %>
            <% elsif point&.bool? %>
              <p class="text-sm text-muted pt-2">Pela ação (ligar/desligar)</p>
            <% else %>
              <%= text_field_tag "scene[items][#{i}][value]", item["value"], class: "ss-input", id: "item_#{i}_value", placeholder: "Ajustar/selecionar" %>
            <% end %></div>
        </div>
      <% end %>
    </div>
  </section>

  <section class="ss-card ss-card-pad">
    <label class="inline-flex items-start gap-2 text-sm"><%= check_box_tag :live, "1", false, id: "scene-live", class: "mt-1" %>
      <span><span class="font-semibold text-ink">Modo ao vivo:</span> aplicar a cena nos aparelhos ao salvar. Vem desligado: editar não mexe em nada na casa.</span></label>
  </section>

  <div class="flex flex-wrap gap-2">
    <%= f.submit "Salvar cena", class: "ss-btn ss-btn-primary" %>
    <%= link_to "Cancelar", back_path, class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
