<%# locals: (dashboard:, w:, op:, target:, view_id:, point_options:, areas:, scenes:, back: nil) -%>
<% span = DashboardsHelper::DEFAULT_SPAN.merge(w["span"] || {}) %>
<% roles = Array(w.dig("visible_if", "role")) %>
<% screens = Array(w.dig("visible_if", "screen")) %>
<% plugins = Dashboards::Widgets.plugins %>
<% uid = "#{op}-#{target}" %>
<%# `back`: "painel" = a gaveta da edição na própria tela (ideia 1); a resposta é a página toda. %>
<%= ss_form_with url: draft_dashboard_path(dashboard), method: :patch, multipart: true, class: "dw-wf grid gap-3 sm:grid-cols-2 pt-3", data: ({ turbo_frame: "_top" } if back) do |f| %>
  <% if back %><%= hidden_field_tag :back, back, id: nil %><% end %>
  <%= hidden_field_tag :op, op, id: nil %><%= hidden_field_tag :target, target, id: nil %><%= hidden_field_tag :view_id, view_id, id: nil %>
  <%= f.ss_select "widget[type]", Dashboards::Schema.labels.invert, label: t("dashboards.kind"), selected: w["type"] || "tile", id: "t-#{uid}" %>
  <%= f.ss_text_field "widget[label]", label: safe_join([ t("dashboards.wf.label"), " ", tag.span(t("dashboards.ed.optional"), class: "font-normal") ]), value: w["label"], id: "l-#{uid}", maxlength: 80, placeholder: t("dashboards.wf.label_hint") %>

  <%# Tipos de widget = plugins (Dashboards::Widgets): os campos de cada tipo aparecem quando ele está escolhido. %>
  <style><%= plugins.map { |pl| ".dw-wf:has(option[value=#{pl.type}]:checked) [data-for~=#{pl.type}]" }.join(", ") %> { display: block; }</style>
  <div class="sm:col-span-2" data-for="<%= plugins.select(&:bind?).map(&:type).join(" ") %>">
    <%= f.ss_select "widget[bind]", point_options, label: t("dashboards.wf.point"), include_blank: t("dashboards.wf.pick_point"), selected: w["bind"], id: "b-#{uid}" %></div>
  <div class="sm:col-span-2" data-for="<%= plugins.select(&:binds?).map(&:type).join(" ") %>">
    <%= f.ss_select "widget[binds]", point_options, label: safe_join([ t("dashboards.wf.points"), " ", tag.span(t("dashboards.wf.points_hint"), class: "font-normal") ]), selected: w["binds"], multiple: true, size: 6, id: "bs-#{uid}" %></div>
  <%# P2.5: tipos que só aparecem na web (card de terceiros) avisam que o app mostra "abrir na web". %>
  <% if (web_only = plugins.select(&:web_only?).map(&:type)).any? %>
    <div class="sm:col-span-2" data-for="<%= web_only.join(" ") %>"><%= render Ss::NoteComponent.new(text: t("dashboards.wf.web_only"), icon: icon("globe-alt", "")) %></div>
  <% end %>
  <%# Campos próprios do tipo (`form` do plugin); partial de vários tipos sai uma vez só. %>
  <% plugins.flat_map { |pl| Array(pl.form).map { |form| [ form, pl.type ] } }.group_by(&:first).each do |form, pairs| %>
    <%= render form, w: w, uid: uid, types: pairs.map(&:last).join(" "), point_options: point_options, areas: areas, scenes: scenes %>
  <% end %>
  <% if (gtypes = plugins.select(&:gestures?).map(&:type)).any? %>
    <%= render "web/dashboards/widget_forms/gestures", w: w, uid: uid, types: gtypes.join(" "), point_options: point_options %>
  <% end %>

  <%= render "web/dashboards/widget_forms/style_if", w: w, uid: uid, point_options: point_options %>

  <fieldset class="sm:col-span-2">
    <legend class="ss-label"><%= t("dashboards.wf.width") %></legend>
    <div class="grid grid-cols-3 gap-2">
      <% %w[mobile tablet desktop].each do |screen| %><% label = t("dashboards.screens.#{screen}") %>
        <%= f.ss_select "span[#{screen}]", (1..12).to_a.reverse, label:, selected: span[screen], class: "num", id: "sp-#{screen}-#{uid}" %>
      <% end %>
    </div>
  </fieldset>
  <fieldset class="sm:col-span-2">
    <legend class="ss-label"><%= t("dashboards.wf.show_on") %> <span class="font-normal"><%= t("dashboards.wf.show_on_hint") %></span></legend>
    <div class="flex flex-wrap gap-3">
      <% %w[mobile tablet desktop].each do |screen| %><% label = t("dashboards.screens.#{screen}") %>
        <%= f.ss_check_box "widget[screens]", multiple: true, label:, checked_value: screen, unchecked_value: nil, checked: screens.include?(screen), id: "sc-#{screen}-#{uid}" %>
      <% end %>
    </div>
  </fieldset>
  <fieldset class="sm:col-span-2">
    <legend class="ss-label"><%= t("dashboards.ed.who_sees") %> <span class="font-normal"><%= t("dashboards.wf.who_hint") %></span></legend>
    <div class="flex flex-wrap gap-3">
      <% SiteMembership::ROLES.each do |r| %>
        <%= f.ss_check_box "widget[roles]", multiple: true, label: SiteMembership.role_label(r), checked_value: r, unchecked_value: nil, checked: roles.include?(r), id: "ro-#{r}-#{uid}" %>
      <% end %>
    </div>
  </fieldset>
  <div class="sm:col-span-2"><%= f.ss_submit op == "add_widget" ? t("dashboards.ed.add_widget") : t("dashboards.wf.save") %></div>
<% end %>
