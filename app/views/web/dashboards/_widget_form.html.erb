<%# locals: (dashboard:, w:, op:, target:, view_id:, point_options:, areas:, scenes:) -%>
<% span = DashboardsHelper::DEFAULT_SPAN.merge(w["span"] || {}) %>
<% roles = Array(w.dig("visible_if", "role")) %>
<% screens = Array(w.dig("visible_if", "screen")) %>
<% plugins = Dashboards::Widgets.plugins %>
<% uid = "#{op}-#{target}" %>
<%= form_with url: draft_dashboard_path(dashboard), method: :patch, class: "dw-wf grid gap-3 sm:grid-cols-2 pt-3" do |f| %>
  <%= hidden_field_tag :op, op, id: nil %><%= hidden_field_tag :target, target, id: nil %><%= hidden_field_tag :view_id, view_id, id: nil %>
  <div><label class="ss-label" for="t-<%= uid %>">Tipo</label>
    <%= select_tag "widget[type]", options_for_select(Dashboards::Schema.labels.invert, w["type"] || "tile"), class: "ss-input", id: "t-#{uid}" %></div>
  <div><label class="ss-label" for="l-<%= uid %>">Rótulo <span class="font-normal">(opcional)</span></label>
    <%= text_field_tag "widget[label]", w["label"], class: "ss-input", id: "l-#{uid}", maxlength: 80, placeholder: "Usa o nome do ponto" %></div>

  <%# Tipos de widget = plugins (Dashboards::Widgets): os campos de cada tipo aparecem quando ele está escolhido. %>
  <style><%= plugins.map { |pl| ".dw-wf:has(option[value=#{pl.type}]:checked) [data-for~=#{pl.type}]" }.join(", ") %> { display: block; }</style>
  <div class="sm:col-span-2" data-for="<%= plugins.select(&:bind?).map(&:type).join(" ") %>"><label class="ss-label" for="b-<%= uid %>">Ponto</label>
    <%= select_tag "widget[bind]", grouped_options_for_select(point_options, w["bind"]), include_blank: "Escolha um ponto", class: "ss-input", id: "b-#{uid}" %></div>
  <div class="sm:col-span-2" data-for="<%= plugins.select(&:binds?).map(&:type).join(" ") %>"><label class="ss-label" for="bs-<%= uid %>">Pontos <span class="font-normal">(até 8; Ctrl/toque para marcar vários; no consumo, kWh ou W somados)</span></label>
    <%= select_tag "widget[binds][]", grouped_options_for_select(point_options, w["binds"]), multiple: true, size: 6, class: "ss-input", id: "bs-#{uid}" %></div>
  <%# Campos próprios do tipo (`form` do plugin); partial de vários tipos sai uma vez só. %>
  <% plugins.flat_map { |pl| Array(pl.form).map { |form| [ form, pl.type ] } }.group_by(&:first).each do |form, pairs| %>
    <%= render form, w: w, uid: uid, types: pairs.map(&:last).join(" "), point_options: point_options, areas: areas, scenes: scenes %>
  <% end %>

  <fieldset class="sm:col-span-2">
    <legend class="ss-label">Largura (de 12 colunas)</legend>
    <div class="grid grid-cols-3 gap-2">
      <% { "mobile" => "Celular", "tablet" => "Tablet", "desktop" => "Computador" }.each do |screen, label| %>
        <div><label class="text-xs text-muted" for="sp-<%= screen %>-<%= uid %>"><%= label %></label>
          <%= select_tag "span[#{screen}]", options_for_select((1..12).to_a.reverse, span[screen]), class: "ss-input num", id: "sp-#{screen}-#{uid}" %></div>
      <% end %>
    </div>
  </fieldset>
  <fieldset class="sm:col-span-2">
    <legend class="ss-label">Mostrar em <span class="font-normal">(nenhum marcado = todas as telas)</span></legend>
    <div class="flex flex-wrap gap-3">
      <% { "mobile" => "Celular", "tablet" => "Tablet", "desktop" => "Computador" }.each do |screen, label| %>
        <label class="ss-check"><%= check_box_tag "widget[screens][]", screen, screens.include?(screen), id: "sc-#{screen}-#{uid}" %><%= label %></label>
      <% end %>
    </div>
  </fieldset>
  <fieldset class="sm:col-span-2">
    <legend class="ss-label">Quem vê <span class="font-normal">(nenhum marcado = todos)</span></legend>
    <div class="flex flex-wrap gap-3">
      <% SiteMembership::ROLES.each do |r| %>
        <label class="ss-check"><%= check_box_tag "widget[roles][]", r, roles.include?(r), id: "ro-#{r}-#{uid}" %><%= SiteMembership.role_label(r) %></label>
      <% end %>
    </div>
  </fieldset>
  <div class="sm:col-span-2"><%= submit_tag op == "add_widget" ? "Adicionar widget" : "Salvar widget", class: "ss-btn ss-btn-primary" %></div>
<% end %>
