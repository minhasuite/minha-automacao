<%# locals: (dashboard:, w:, op:, target:, view_id:, point_options:, areas:, scenes:) -%>
<% q = w["query"] || {} %>
<% span = DashboardsHelper::DEFAULT_SPAN.merge(w["span"] || {}) %>
<% roles = Array(w.dig("visible_if", "role")) %>
<% uid = "#{op}-#{target}" %>
<%= form_with url: draft_dashboard_path(dashboard), method: :patch, class: "dw-wf grid gap-3 sm:grid-cols-2 pt-3" do |f| %>
  <%= hidden_field_tag :op, op, id: nil %><%= hidden_field_tag :target, target, id: nil %><%= hidden_field_tag :view_id, view_id, id: nil %>
  <div><label class="ss-label" for="t-<%= uid %>">Tipo</label>
    <%= select_tag "widget[type]", options_for_select(Dashboards::Schema::WIDGET_LABELS.invert, w["type"] || "tile"), class: "ss-input", id: "t-#{uid}" %></div>
  <div><label class="ss-label" for="l-<%= uid %>">Rótulo <span class="font-normal">(opcional)</span></label>
    <%= text_field_tag "widget[label]", w["label"], class: "ss-input", id: "l-#{uid}", maxlength: 80, placeholder: "Usa o nome do ponto" %></div>

  <div class="sm:col-span-2" data-for="tile gauge stat camera"><label class="ss-label" for="b-<%= uid %>">Ponto</label>
    <%= select_tag "widget[bind]", grouped_options_for_select(point_options, w["bind"]), include_blank: "Escolha um ponto", class: "ss-input", id: "b-#{uid}" %></div>
  <div class="sm:col-span-2" data-for="group chart"><label class="ss-label" for="bs-<%= uid %>">Pontos <span class="font-normal">(até 8; Ctrl/toque para marcar vários)</span></label>
    <%= select_tag "widget[binds][]", grouped_options_for_select(point_options, w["binds"]), multiple: true, size: 6, class: "ss-input", id: "bs-#{uid}" %></div>
  <div class="sm:col-span-2" data-for="heading"><label class="ss-label" for="h-<%= uid %>">Título</label>
    <%= text_field_tag "widget[title]", w["title"], class: "ss-input", id: "h-#{uid}", maxlength: 80 %></div>
  <div class="sm:col-span-2" data-for="markdown"><label class="ss-label" for="x-<%= uid %>">Texto</label>
    <%= text_area_tag "widget[text]", w["text"], class: "ss-input", id: "x-#{uid}", rows: 3, maxlength: 2000 %></div>
  <div data-for="stat query_list"><label class="ss-label" for="qc-<%= uid %>">Quais pontos: tipo</label>
    <%= select_tag "widget[query][capability]", options_for_select(Point::CAPABILITY_LABELS.invert, q["capability"]), include_blank: "Qualquer", class: "ss-input", id: "qc-#{uid}" %></div>
  <div data-for="stat query_list"><label class="ss-label" for="qs-<%= uid %>">Estado</label>
    <%= select_tag "widget[query][state]", options_for_select({ "Ligados / abertos" => "on", "Desligados / fechados" => "off" }, q["state"]), include_blank: "Qualquer", class: "ss-input", id: "qs-#{uid}" %></div>
  <div data-for="stat query_list"><label class="ss-label" for="qa-<%= uid %>">Área</label>
    <%= select_tag "widget[query][area]", options_from_collection_for_select(areas, :id, :name, q["area"]), include_blank: "Todas", class: "ss-input", id: "qa-#{uid}" %></div>
  <div data-for="stat query_list"><label class="ss-label" for="qd-<%= uid %>">Medição</label>
    <%= select_tag "widget[query][device_class]", options_for_select({ "Potência (W)" => "power", "Energia (kWh)" => "energy", "Temperatura" => "temperature", "Umidade" => "humidity", "Bateria" => "battery" }, q["device_class"]), include_blank: "Qualquer", class: "ss-input", id: "qd-#{uid}" %></div>
  <div data-for="stat query_list"><label class="ss-label" for="qt-<%= uid %>">Etiqueta</label>
    <%= text_field_tag "widget[query][tag]", q["tag"], class: "ss-input", id: "qt-#{uid}", placeholder: "iluminacao" %></div>
  <div data-for="stat"><label class="ss-label" for="ag-<%= uid %>">Mostrar</label>
    <%= select_tag "widget[aggregate]", options_for_select({ "Quantos são" => "count", "Soma" => "sum", "Média" => "avg", "Mínimo" => "min", "Máximo" => "max", "Valor do ponto" => "last" }, w["aggregate"]), class: "ss-input", id: "ag-#{uid}" %></div>
  <div data-for="query_list"><label class="ss-label" for="et-<%= uid %>">Texto quando vazio</label>
    <%= text_field_tag "widget[empty_text]", w["empty_text"], class: "ss-input", id: "et-#{uid}", placeholder: "Tudo desligado." %></div>
  <div data-for="chart"><label class="ss-label" for="rg-<%= uid %>">Período</label>
    <%= select_tag "widget[range]", options_for_select({ "24 horas" => "24h", "7 dias" => "7d", "30 dias" => "30d" }, w["range"]), class: "ss-input", id: "rg-#{uid}" %></div>
  <div data-for="area_card"><label class="ss-label" for="ar-<%= uid %>">Área</label>
    <%= select_tag "widget[area]", options_from_collection_for_select(areas, :id, :name, w["area"]), class: "ss-input", id: "ar-#{uid}" %></div>
  <div class="sm:col-span-2" data-for="scene_bar"><label class="ss-label" for="sc-<%= uid %>">Cenas <span class="font-normal">(nenhuma marcada = todas)</span></label>
    <%= select_tag "widget[scenes][]", options_from_collection_for_select(scenes, :id, :name, w["scenes"]), multiple: true, size: 4, class: "ss-input", id: "sc-#{uid}" %></div>
  <div data-for="tile"><label class="ss-label" for="co-<%= uid %>">Cor quando ligado</label>
    <%= select_tag "widget[color]", options_for_select({ "Roxo (padrão)" => "accent", "Âmbar (luz)" => "amber", "Verde" => "green", "Vermelho" => "red", "Azul" => "blue" }, w["color"]), class: "ss-input", id: "co-#{uid}" %></div>
  <div data-for="tile"><label class="ss-label" for="tp-<%= uid %>">Toque</label>
    <%= select_tag "widget[tap]", options_for_select({ "Liga e desliga / ajusta" => "toggle", "Só abre o ponto" => "more_info" }, w["tap"]), class: "ss-input", id: "tp-#{uid}" %></div>
  <div data-for="gauge" class="grid grid-cols-2 gap-2">
    <div><label class="ss-label" for="mn-<%= uid %>">Mínimo</label><%= text_field_tag "widget[min]", w["min"], class: "ss-input num", id: "mn-#{uid}", inputmode: "decimal" %></div>
    <div><label class="ss-label" for="mx-<%= uid %>">Máximo</label><%= text_field_tag "widget[max]", w["max"], class: "ss-input num", id: "mx-#{uid}", inputmode: "decimal" %></div>
  </div>

  <fieldset class="sm:col-span-2">
    <legend class="ss-label">Largura (de 12 colunas)</legend>
    <div class="grid grid-cols-3 gap-2">
      <% { "mobile" => "Celular", "tablet" => "Tablet", "desktop" => "Computador" }.each do |screen, label| %>
        <div><label class="text-xs text-muted" for="sp-<%= screen %>-<%= uid %>"><%= label %></label>
          <%= select_tag "span[#{screen}]", options_for_select((1..12).to_a.reverse, span[screen]), class: "ss-input num", id: "sp-#{screen}-#{uid}" %></div>
      <% end %>
    </div>
  </fieldset>
  <fieldset class="sm:col-span-2">
    <legend class="ss-label">Quem vê <span class="font-normal">(nenhum marcado = todos)</span></legend>
    <div class="flex flex-wrap gap-3">
      <% SiteMembership::ROLES.each do |r| %>
        <label class="ss-check"><%= check_box_tag "widget[roles][]", r, roles.include?(r), id: "ro-#{r}-#{uid}" %><%= SiteMembership.role_label(r) %></label>
      <% end %>
    </div>
  </fieldset>
  <div class="sm:col-span-2"><%= submit_tag op == "add_widget" ? "Adicionar widget" : "Salvar widget", class: "ss-btn ss-btn-primary" %></div>
<% end %>
