<%= render "web/shared/header", title: t("dashboards.new"), subtitle: t("dashboards.new_subtitle"), back: site_dashboards_path(@site) %>
<%= form_with model: @dashboard, url: site_dashboards_path(@site), class: "ss-card ss-card-pad grid gap-4 md:grid-cols-2 max-w-3xl" do |f| %>
  <%= render "web/shared/errors", record: @dashboard %>
  <div class="md:col-span-2"><%= f.label :name, t("devices.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", required: true, placeholder: t("dashboards.name_hint"), autofocus: true %></div>
  <div><%= f.label :kind, t("dashboards.kind"), class: "ss-label" %><%= f.select :kind, Dashboard::KINDS.invert, {}, class: "ss-input" %></div>
  <div class="flex items-end"><label class="ss-check"><%= check_box_tag :copy_auto, "1", true %><%= t("dashboards.copy_auto") %></label></div>
  <div class="md:col-span-2 flex flex-wrap gap-2">
    <%= f.submit t("dashboards.create"), class: "ss-btn ss-btn-primary" %>
    <%= link_to t("devices.form.cancel"), site_dashboards_path(@site), class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
