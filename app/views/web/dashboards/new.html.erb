<%= render "web/shared/header", title: t("dashboards.new"), subtitle: t("dashboards.new_subtitle"), back: site_dashboards_path(@site) %>
<%= ss_form_with model: @dashboard, url: site_dashboards_path(@site), class: "ss-card ss-card-pad grid gap-4 md:grid-cols-2 max-w-3xl" do |f| %>
  <%= render "web/shared/errors", record: @dashboard %>
  <%= f.ss_text_field :name, label: t("devices.name"), required: true, placeholder: t("dashboards.name_hint"), autofocus: true, wrapper_class: "md:col-span-2" %>
  <%= f.ss_select :kind, Dashboard::KINDS.keys.index_by { |k| t("dashboards.kinds.#{k}") }, label: t("dashboards.kind") %>
  <%# copy_auto fica fora do dashboard[...] (o controller lê params[:copy_auto]). %>
  <div class="flex items-end"><%= ss_fields { |g| g.ss_check_box :copy_auto, label: t("dashboards.copy_auto"), checked: true, include_hidden: false } %></div>
  <div class="md:col-span-2 flex flex-wrap gap-2">
    <%= f.ss_submit t("dashboards.create") %>
    <%= link_to t("devices.form.cancel"), site_dashboards_path(@site), class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
