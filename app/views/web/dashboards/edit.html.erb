<% views = @draft["views"] %>
<% view = views.find { |v| v["id"] == params[:view] } || views.first %>
<% @body_theme = view && (th = Dashboards::Themes.resolve(@draft, view, @site)) && dw_theme_attrs(th) %>
<% if th && th["dark"] %><%= render "web/dashboards/force_dark" %><% end %>
<% point_options = @points.group_by { |p| p.device.name }.sort.map { |dev, ps| [ dev, ps.map { |p| [ "#{p.name}#{t("dashboards.ed.hidden_suffix") if p.hidden}", p.id ] } ] } %>
<% names = @points.index_by(&:id) %>
<% scenes = @site.scenes.order(:name).to_a %>
<%= render "web/shared/header", title: t("dashboards.ed.title", name: @dashboard.name), subtitle: [ @site.name, (@dashboard.auto? ? t("dashboards.ed.auto_note") : t("dashboards.ed.published", n: @dashboard.version)), (t("dashboards.ed.draft_changed") if @dashboard.draft?) ].compact.join(" · "), back: dashboard_path(@dashboard) do %>
  <%= render "web/dashboards/history_buttons", dashboard: @dashboard, history: @history %>
  <%= link_to dashboard_path(@dashboard, editar: 1, view: view&.dig("id")), class: "ss-btn ss-btn-outline", title: t("dashboards.here.hint") do %><%= icon("cursor-click", "size-4") %><%= t("dashboards.here.open") %><% end %>
  <%# Ideias 24 e 25: publicar passa pela revisão (prévia em todos os tamanhos e temas + avisos que não bloqueiam). %>
  <% why = (t("dashboards.ed.nothing_to_publish") unless @dashboard.draft? || @dashboard.auto?) %>
  <% if why %>
    <button type="button" class="ss-btn ss-btn-primary" disabled title="<%= why %>" aria-describedby="publish-why"><%= icon("upload", "size-4") %><%= t("dashboards.publish") %></button>
    <p id="publish-why" class="basis-full text-right text-xs text-muted sm:basis-auto"><%= why %></p>
  <% else %>
    <%= link_to review_dashboard_path(@dashboard, view: view&.dig("id")), class: "ss-btn ss-btn-primary", data: { dw_key: "publish" } do %><%= icon("upload", "size-4") %><%= t("dashboards.review.publish_btn") %><% end %>
  <% end %>
<% end %>
<%# Ideia 7: ações do painel no Ctrl+K (o grupo aparece primeiro na paleta). %>
<% @palette_groups = [ { title: t("dashboards.keys.palette_group", name: @dashboard.name), items: [
     { label: t("dashboards.keys.new_view"), url: edit_dashboard_path(@dashboard, nova_visao: 1), icon: icon("plus", "") },
     { label: t("dashboards.review.publish_btn"), url: review_dashboard_path(@dashboard, view: view&.dig("id")), icon: icon("upload", "") },
     { label: t("dashboards.cmp.title"), url: compare_dashboard_path(@dashboard), icon: icon("switch-horizontal", "") },
     { label: t("dashboards.here.open"), url: dashboard_path(@dashboard, editar: 1, view: view&.dig("id")), icon: icon("cursor-click", "") },
     { label: t("dashboards.ed.json"), url: json_dashboard_path(@dashboard), icon: icon("code", "") }
   ] } ] %>
<%= render "web/dashboards/keys", dashboard: @dashboard, view_id: view&.dig("id") %>
<% if @clipboard %>
  <%= render Ss::CalloutComponent.new(tone: :accent, title: t("dashboards.clip.holding", name: @clipboard["label"].presence || t("dashboards.clip.#{@clipboard["kind"]}")), icon: icon("clipboard-list", ""), css: "mb-4") do %>
    <p><%= t("dashboards.clip.hint_#{@clipboard["kind"]}") %></p>
  <% end %>
<% end %>

<div class="grid gap-6 lg:grid-cols-3 items-start">
  <div class="lg:col-span-2 flex flex-col gap-4 min-w-0">
    <div class="flex items-start gap-2">
    <nav class="ss-chips is-solid flex-1 min-w-0" data-controller="ss-scroll-current" aria-label="<%= t("dashboards.ed.draft_views") %>">
      <% views.each do |v| %>
        <%= link_to edit_dashboard_path(@dashboard, view: v["id"]), class: "ss-chip no-underline", "aria-current": (v == view ? "true" : nil) do %><%= icon(v["icon"].presence || "view-boards", "size-4") %><%= v["title"] %><% end %>
      <% end %>
    </nav>
      <%# Nova vista: .ss-menu da gem com botão de texto; o painel é o próprio formulário. %>
      <details class="ss-menu is-end shrink-0" id="dw-new-view" <%= "open" if params[:nova_visao].present? %>>
        <summary class="ss-menu-btn" aria-label="<%= t("dashboards.ed.new_view") %>"><%= icon("plus", "size-4") %><span class="max-sm:sr-only"><%= t("dashboards.ed.new_view") %></span></summary>
        <%= form_with url: draft_dashboard_path(@dashboard), method: :patch, class: "!flex gap-2 p-3 w-[min(20rem,calc(100vw-2rem))]" do %>
          <%= hidden_field_tag :op, "add_view", id: nil %>
          <label class="sr-only" for="nv-title"><%= t("dashboards.ed.view_name") %></label>
          <%= text_field_tag :title, nil, class: "ss-input", id: "nv-title", placeholder: t("dashboards.ed.view_placeholder"), required: true, maxlength: 60, autofocus: params[:nova_visao].present? %>
          <%= submit_tag t("dashboards.ed.create"), class: "ss-btn ss-btn-primary" %>
        <% end %>
      </details>
    </div>

    <% if view %>
      <section class="ss-card ss-card-pad" aria-label="<%= t("dashboards.ed.view_label", name: view['title']) %>">
        <div class="flex flex-wrap items-end gap-3">
          <%= form_with url: draft_dashboard_path(@dashboard), method: :patch, class: "flex flex-wrap items-end gap-2 flex-1 min-w-64" do %>
            <%= hidden_field_tag :op, "update_view", id: nil %><%= hidden_field_tag :target, view["id"], id: nil %><%= hidden_field_tag :view_id, view["id"], id: nil %>
            <div class="flex-1 min-w-40"><label class="ss-label" for="vt"><%= t("dashboards.ed.view_name") %></label><%= text_field_tag :title, view["title"], class: "ss-input", id: "vt", maxlength: 60 %></div>
            <div class="basis-full"><%= render "web/shared/icon_picker", name: "icon", selected: view["icon"], icons: Dashboard::ICONS, id: "vi", label: t("dashboards.ed.view_icon") %></div>
            <details class="basis-full" <%= "open" if view["path"].present? %>>
              <summary class="ss-summary text-sm font-semibold text-ink-2 w-fit"><%= t("dashboards.ed.view_path") %></summary>
              <div class="mt-2 max-w-xs"><label class="ss-label" for="vp"><%= t("dashboards.ed.link_name") %> <span class="font-normal"><%= t("dashboards.ed.optional") %></span></label><%= text_field_tag :path, view["path"], class: "ss-input num", id: "vp", maxlength: 40, placeholder: t("dashboards.ed.path_placeholder"), pattern: "[a-z0-9][a-z0-9-]*", title: t("dashboards.ed.path_title"), "aria-describedby": "vp-hint" %>
                <p id="vp-hint" class="text-xs text-muted mt-1"><%= t("dashboards.ed.path_hint") %></p></div>
            </details>
            <%# ondaB2 (B8): tipo da visão e subvisão (fora das abas, com "voltar"). %>
            <div class="basis-full grid gap-3 sm:grid-cols-3 items-end">
              <div><label class="ss-label" for="vty"><%= t("dashboards.vt.form.type") %></label>
                <%= select_tag :view_type, options_for_select(Dashboards::ViewTypes.plugins.map { |x| [ x.label, x.key, { title: x.description } ] }, view["type"] || "sections"), class: "ss-input", id: "vty" %></div>
              <label class="ss-check pb-2"><%= check_box_tag :subview, "1", view["subview"] == true, id: "vsub" %><%= t("dashboards.vt.form.subview") %></label>
              <div><label class="ss-label" for="vbk"><%= t("dashboards.vt.form.back") %></label>
                <%= select_tag :back_path, options_for_select(Array(@draft["views"]).reject { |x| x["id"] == view["id"] }.map { |x| [ x["title"], x["path"].presence || x["id"] ] }, view["back_path"]),
                               include_blank: t("dashboards.vt.form.back_first"), class: "ss-input", id: "vbk" %></div>
            </div>
            <%# P1.4: o topo da visão (Dashboards::Hero): título e linha de cima com Liquid, saudação e esconder. %>
            <% hero = view["hero"].is_a?(Hash) ? view["hero"] : {} %>
            <details class="basis-full" <%= "open" if hero.any? %>>
              <summary class="ss-summary text-sm font-semibold text-ink-2 w-fit"><%= t("dashboards.hero.form.title") %></summary>
              <%= hidden_field_tag "hero[present]", "1", id: nil %>
              <div class="mt-2 grid gap-3 sm:grid-cols-2">
                <div><label class="ss-label" for="vht"><%= t("dashboards.hero.form.text") %> <span class="font-normal"><%= t("dashboards.ed.optional") %></span></label>
                  <%= text_field_tag "hero[title]", hero["title"], class: "ss-input", id: "vht", maxlength: Dashboards::Hero::MAX, placeholder: t("dashboards.hero.form.text_placeholder") %></div>
                <div><label class="ss-label" for="vhk"><%= t("dashboards.hero.form.kicker") %> <span class="font-normal"><%= t("dashboards.ed.optional") %></span></label>
                  <%= text_field_tag "hero[kicker]", hero["kicker"], class: "ss-input", id: "vhk", maxlength: Dashboards::Hero::MAX, placeholder: t("dashboards.hero.form.kicker_placeholder") %></div>
                <div><label class="ss-label" for="vhg"><%= t("dashboards.hero.form.greeting") %></label>
                  <%= select_tag "hero[greeting]", options_for_select({ t("dashboards.hero.form.greeting_auto") => "", t("dashboards.hero.form.greeting_on") => "1", t("dashboards.hero.form.greeting_off") => "0" },
                                                                      { true => "1", false => "0" }.fetch(hero["greeting"], "")), class: "ss-input", id: "vhg" %></div>
                <label class="ss-check self-end pb-2"><%= check_box_tag "hero[hide]", "1", hero["hide"] == true, id: "vhh" %><%= t("dashboards.hero.form.hide") %></label>
                <p class="sm:col-span-2 text-xs text-muted"><%= t("dashboards.hero.form.hint") %></p>
              </div>
            </details>
            <%= submit_tag t("dashboards.save"), class: "ss-btn ss-btn-ghost" %>
          <% end %>
          <%= render "web/dashboards/tools", dashboard: @dashboard, kind: "view", target: view["id"], view_id: view["id"], name: t("dashboards.ed.the_view", name: view["title"]), clipboard: @clipboard %>
        </div>
        <details class="mt-3" <%= "open" if view["theme"].present? %>>
          <summary class="ss-summary text-sm font-semibold text-ink-2 w-fit"><%= t("dashboards.ed.view_theme") %></summary>
          <div class="mt-3"><%= render "web/dashboards/theme_form", dashboard: @dashboard, target: view["id"], theme: view["theme"], view_id: view["id"], inherit: true %></div>
        </details>
      </section>

      <%= render "web/dashboards/layout_editor", dashboard: @dashboard, view: view, live: @live %>
      <%= render "web/dashboards/arrange_tools", dashboard: @dashboard, view: view, areas: @areas %>

      <% sections = Array(view["sections"]) %>
      <% sections.each do |s| %>
        <%# Seções recolhidas quando são muitas (editor curto no celular); a que tem o widget em edição abre. %>
        <% fold_open = sections.size <= 2 || Array(s["widgets"]).any? { |w| w["id"] == @editing } %>
        <section class="ss-card ss-card-pad" aria-label="<%= t("dashboards.ed.section_label", name: s['title']) %>" data-dw-section="<%= s['id'] %>">
          <details <%= "open" if fold_open %>>
          <summary class="ss-summary cursor-pointer font-bold text-ink flex items-center gap-2">
            <span class="min-w-0 flex-1 truncate"><%= s["title"].presence || t("dashboards.ed.untitled") %></span>
            <span class="text-xs font-semibold text-muted shrink-0"><%= t("dashboards.ed.widgets", count: Array(s["widgets"]).size) %></span>
          </summary>
          <div class="flex flex-wrap items-end gap-3 mt-3">
            <%= form_with url: draft_dashboard_path(@dashboard), method: :patch, class: "flex flex-wrap items-end gap-2 flex-1 min-w-64" do %>
              <%= hidden_field_tag :op, "update_section", id: nil %><%= hidden_field_tag :target, s["id"], id: nil %><%= hidden_field_tag :view_id, view["id"], id: nil %>
              <div class="flex-1 min-w-40"><label class="ss-label" for="st-<%= s['id'] %>"><%= t("dashboards.section") %></label><%= text_field_tag :title, s["title"], class: "ss-input", id: "st-#{s['id']}", maxlength: 60, placeholder: t("dashboards.ed.untitled") %></div>
              <div class="w-44"><label class="ss-label" for="sw-<%= s['id'] %>"><%= t("dashboards.ed.desktop_width") %></label>
                <%= select_tag "span[desktop]", options_for_select({ t("dashboards.ed.width.full") => 12, t("dashboards.ed.width.two_thirds") => 8, t("dashboards.ed.width.half") => 6, t("dashboards.ed.width.third") => 4 }, s.dig("span", "desktop") || 12), class: "ss-input", id: "sw-#{s['id']}" %>
                <%= hidden_field_tag "span[mobile]", 12, id: nil %><%= hidden_field_tag "span[tablet]", (s.dig("span", "desktop") || 12) == 12 ? 12 : 6, id: nil %></div>
              <% if view["type"] == "sidebar" %><label class="ss-check pb-2"><%= check_box_tag :position, "sidebar", s["position"] == "sidebar", id: "spo-#{s['id']}" %><%= t("dashboards.vt.form.in_sidebar") %></label><% end %>
              <%= submit_tag t("dashboards.save"), class: "ss-btn ss-btn-ghost" %>
            <% end %>
            <%= render "web/dashboards/tools", dashboard: @dashboard, kind: "section", target: s["id"], view_id: view["id"], name: t("dashboards.ed.the_section", name: s["title"]), clipboard: @clipboard %>
          </div>

          <ul class="mt-4 divide-y divide-line">
            <% Array(s["widgets"]).each do |w| %>
              <%= render "web/dashboards/editor_widget", w: w, view: view, names: names, point_options: point_options, scenes: scenes %>
            <% end %>
          </ul>
          <% if Array(s["widgets"]).empty? %><p class="text-sm text-muted mt-3"><%= t("dashboards.ed.empty_section") %></p><% end %>
          <%= render Ss::CollapsibleComponent.new(title: t("dashboards.ed.add_widget"), icon: icon("plus", ""), css: "mt-3") do %>
            <%= render "web/dashboards/widget_form", dashboard: @dashboard, w: {}, op: "add_widget", target: s["id"], view_id: view["id"], point_options: point_options, areas: @areas, scenes: scenes %>
          <% end %>
          </details>
        </section>
      <% end %>

      <%= form_with url: draft_dashboard_path(@dashboard), method: :patch, class: "ss-card p-3 flex gap-2" do %>
        <%= hidden_field_tag :op, "add_section", id: nil %><%= hidden_field_tag :view_id, view["id"], id: nil %>
        <label class="sr-only" for="ns-title"><%= t("dashboards.ed.new_section_name") %></label>
        <%= text_field_tag :title, nil, class: "ss-input", id: "ns-title", placeholder: t("dashboards.ed.new_section_placeholder"), maxlength: 60 %>
        <%= submit_tag t("dashboards.ed.add_section"), class: "ss-btn ss-btn-outline" %>
      <% end %>
    <% end %>
  </div>

  <aside class="flex flex-col gap-4">
    <%= form_with model: @dashboard, url: dashboard_path(@dashboard), class: "ss-card ss-card-pad grid gap-3" do |f| %>
      <h2><%= t("dashboards.ed.dashboard") %></h2>
      <div><%= f.label :name, t("dashboards.ed.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", required: true %></div>
      <%= render "web/shared/icon_picker", name: "dashboard[icon]", selected: @dashboard.icon, icons: Dashboard::ICONS, id: "dashboard_icon" %>
      <label class="ss-check"><%= f.check_box :sidebar %><%= t("dashboards.ed.sidebar") %></label>
      <fieldset><legend class="ss-label"><%= t("dashboards.ed.who_sees") %> <span class="font-normal"><%= t("dashboards.ed.none_all") %></span></legend>
        <div class="flex flex-wrap gap-3">
          <% SiteMembership::ROLES.each do |r| %><label class="ss-check"><%= check_box_tag "dashboard[roles][]", r, @dashboard.roles.include?(r), id: "dr-#{r}" %><%= SiteMembership.role_label(r) %></label><% end %>
          <%= hidden_field_tag "dashboard[roles][]", "", id: nil %>
        </div></fieldset>
      <label class="ss-check"><%= f.check_box :site_default %><%= t("dashboards.site_default") %></label>
      <div><%= f.submit t("dashboards.ed.save_dashboard"), class: "ss-btn ss-btn-ghost" %></div>
    <% end %>
    <section class="ss-card ss-card-pad" aria-labelledby="theme-title">
      <h2 id="theme-title" class="flex items-center gap-2"><%= icon("color-swatch", "size-5 text-accent") %><%= t("dashboards.ed.appearance") %></h2>
      <p class="text-sm text-muted mt-0.5 mb-3"><%= t("dashboards.ed.appearance_hint") %></p>
      <%= render "web/dashboards/theme_form", dashboard: @dashboard, target: nil, theme: @draft["theme"], view_id: view&.dig("id") %>
    </section>
    <% if current_user.dashboard_prefs[@site.id] == @dashboard.id %>
      <p class="ss-badge ss-badge-success w-fit"><%= t("dashboards.mine") %></p>
    <% else %>
      <%= button_to prefer_dashboard_path(@dashboard), class: "ss-btn ss-btn-ghost w-full" do %><%= icon("home", "size-4") %><%= t("dashboards.prefer") %><% end %>
    <% end %>
    <%= button_to duplicate_dashboard_path(@dashboard), class: "ss-btn ss-btn-ghost w-full" do %><%= icon("duplicate", "size-4") %><%= t("dashboards.ed.duplicate") %><% end %>

    <section class="ss-card ss-card-pad">
      <h2><%= t("dashboards.ed.draft") %></h2>
      <p class="text-sm text-muted mt-1"><%= t("dashboards.ed.draft_hint") %></p>
      <div class="flex flex-wrap gap-2 mt-3">
        <%= link_to json_dashboard_path(@dashboard), class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("document-text", "size-4") %><%= t("dashboards.ed.json") %><% end %>
        <% if @dashboard.draft? %><%= button_to t("dashboards.ed.discard"), discard_dashboard_path(@dashboard), class: "ss-btn ss-btn-danger ss-btn-sm", form: { data: { turbo_confirm: t("dashboards.ed.discard_confirm") } } %><% end %>
      </div>
    </section>

    <section class="ss-card ss-card-pad" aria-labelledby="versions-title">
      <div class="flex items-center gap-2">
        <h2 id="versions-title" class="flex-1"><%= t("dashboards.ed.versions") %></h2>
        <%= link_to compare_dashboard_path(@dashboard), class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("switch-horizontal", "size-4") %><%= t("dashboards.cmp.short") %><% end %>
      </div>
      <% versions = @dashboard.versions.includes(:author).limit(15) %>
      <% if versions.empty? %>
        <p class="text-sm text-muted mt-1"><%= @dashboard.auto? ? t("dashboards.ed.no_versions_auto") : t("dashboards.ed.no_versions") %></p>
      <% else %>
        <ul class="mt-2 divide-y divide-line">
          <% versions.each do |v| %>
            <li class="py-2 flex items-center gap-2">
              <span class="min-w-0 flex-1"><span class="font-semibold text-ink num">v<%= v.version %></span> <span class="text-xs text-muted"><%= l(v.created_at, format: :short) %><%= " · #{v.author.name.split.first}" if v.author %></span></span>
              <% if v.version == @dashboard.version %>
                <span class="ss-badge ss-badge-success"><%= t("dashboards.ed.live") %></span>
              <% else %>
                <%= button_to t("dashboards.ed.revert"), revert_dashboard_path(@dashboard), params: { version: v.version }, class: "ss-btn ss-btn-ghost ss-btn-sm", form: { data: { turbo_confirm: t("dashboards.ed.revert_confirm", n: v.version), turbo_confirm_button: t("dashboards.publish") } } %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <%= button_to dashboard_path(@dashboard), method: :delete, class: "ss-btn ss-btn-danger w-full", form: { data: { turbo_confirm_tone: "danger", turbo_confirm_button: t("shared.confirm.delete"), turbo_confirm: t("dashboards.ed.delete_confirm", name: @dashboard.name) } } do %><%= icon("trash", "size-4") %><%= t("dashboards.ed.delete") %><% end %>
  </aside>
</div>
