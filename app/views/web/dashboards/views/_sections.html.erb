<%# locals: (view:, points:, dashboard:, live:) -%>
<%# Seções (o padrão): grade de 12 colunas, cada seção com a sua largura e o título de seção da gem. %>
<div class="ss-span-grid [--ss-span-gap:1.75rem_1.25rem] mt-5">
  <% view["sections"].each_with_index do |s, i| %>
    <% if s["spacer"] %><div class="ss-span ss-hide-mobile" style="<%= dw_span_style(s['span'], DashboardsHelper::SECTION_SPAN) %>" aria-hidden="true"></div><% next %><% end %>
    <% next if s["widgets"].empty? %>
    <section class="ss-span ss-rise" data-ss-filter-target="group" style="<%= dw_span_style(s['span'], DashboardsHelper::SECTION_SPAN) %>; animation-delay: <%= [ i, 6 ].min * 50 %>ms" aria-label="<%= s['title'] || t("dashboards.section") %>">
      <% if s["title"].present? %><%= render Ss::SectionComponent.new(title: s["title"], icon: (icon(s["icon"], "") if s["icon"].present?)) %><% end %>
      <div class="ss-span-grid">
        <% s["widgets"].each do |w| %><%= render "web/dashboards/widget", w: w, points: points, dashboard: dashboard, badge: false, live: live %><% end %>
      </div>
    </section>
  <% end %>
</div>
