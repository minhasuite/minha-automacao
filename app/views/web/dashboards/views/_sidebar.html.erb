<%# locals: (view:, points:, dashboard:, live:) -%>
<%# Com barra lateral (o sidebar do HA): seções marcadas (position: sidebar) na coluna da direita; sem marca, a última vai para lá.
    Conteúdo + coluna lateral da gem (Ss::AsideLayoutComponent); cada seção com o título de seção da gem. %>
<% list = view["sections"].reject { |s| s["widgets"].empty? } %>
<% side, main = list.partition { |s| s["position"] == "sidebar" } %>
<% side, main = [ [ main.pop ].compact, main ] if side.empty? && main.size > 1 %>
<% section = lambda do |s, i, side = false| %>
  <section class="ss-span ss-rise <%= '[&_.ss-span-grid_.ss-span]:col-[1/-1]!' if side %>" data-ss-filter-target="group" style="animation-delay: <%= [ i, 6 ].min * 50 %>ms" aria-label="<%= s['title'] || t("dashboards.section") %>">
    <% if s["title"].present? %><%= render Ss::SectionComponent.new(title: s["title"], icon: (icon(s["icon"], "") if s["icon"].present?)) %><% end %>
    <div class="ss-span-grid"><% s["widgets"].each do |w| %><%= render "web/dashboards/widget", w: w, points: points, dashboard: dashboard, badge: false, live: live %><% end %></div>
  </section>
<% end %>
<%= render Ss::AsideLayoutComponent.new(label: t("dashboards.vt.sidebar"), css: "mt-5") do |l| %>
  <% l.with_main do %><% main.each_with_index { |s, i| section.(s, i) } %><% end %>
  <% if side.any? %><% l.with_aside do %><% side.each_with_index { |s, i| section.(s, i + main.size, true) } %><% end %><% end %>
<% end %>
