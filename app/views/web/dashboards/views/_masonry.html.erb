<%# locals: (view:, points:, dashboard:, live:) -%>
<%# Mosaico (o masonry do HA): os cards em colunas que se encaixam pela altura; o título da seção vira um cabeçalho no fluxo. %>
<div class="dw-masonry mt-5">
  <% view["sections"].each do |s| %>
    <% next if s["widgets"].empty? %>
    <% if s["title"].present? %><h2 class="dw-sec-title dw-masonry-title"><%= icon(s["icon"], "size-4") if s["icon"].present? %><%= s["title"] %></h2><% end %>
    <% s["widgets"].each do |w| %><%= render "web/dashboards/widget", w: w, points: points, dashboard: dashboard, badge: false, live: live %><% end %>
  <% end %>
</div>
