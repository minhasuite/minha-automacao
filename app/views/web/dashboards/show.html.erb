<% content_for :title, @home ? t("nav.home") : @dashboard.name %>
<% live = !@preview %>
<% points = @resolved["points"] %>
<% view = @view %>
<% home_view = view == @resolved["views"].first %>
<% @body_theme = (th = Dashboards::Themes.resolve(@resolved, view, @site)) && dw_theme_attrs(th) %>
<% if th && th["dark"] %><%= render "web/dashboards/force_dark" %><% end %>
<% if live %><%= turbo_stream_from @site, :points, channel: PointsChannel %><% end %>

<% if @preview %>
  <%= render Ss::CalloutComponent.new(tone: :accent, title: t("dashboards.preview"), icon: icon("eye", ""), css: "mb-4") do |c| %>
    <% c.with_action { link_to t("dashboards.back_editor"), edit_dashboard_path(@dashboard), class: "ss-btn ss-btn-ghost ss-btn-sm" } %>
    <% c.with_action do %><%= button_to publish_dashboard_path(@dashboard), class: "ss-btn ss-btn-primary ss-btn-sm", form: { data: { turbo_confirm: t("dashboards.publish_confirm"), turbo_confirm_button: t("dashboards.publish") } } do %><%= icon("upload", "size-4") %><%= t("dashboards.publish") %><% end %><% end %>
    <p><%= t("dashboards.preview_note", n: @dashboard.version) %></p>
  <% end %>
<% end %>

<%# Topo discreto (Ss::PageComponent compacto da gem): local · data em cima, o nome da visão (ou a saudação
    no Início) e só o editar, em ícone. O "Falar" é o botão flutuante do layout (web/assist/fab) e os
    outros painéis ficam no menu lateral. %>
<% back = Dashboards::ViewTypes.back(@resolved["views"], view) %>
<%= render Ss::PageComponent.new(title: home_view && @home ? "#{greeting}, #{current_user.name.split.first}" : view["title"],
                                 eyebrow: [ @site.name, l(Date.current, format: :long) ].join(" · "), compact: true, css: "ss-rise",
                                 back: (back["href"] || dw_view_path(@dashboard, back, home: @home) if back),
                                 back_label: (t("dashboards.vt.back_to", name: back["title"]) if back)) do |p| %>
  <% if @resolved["can_edit"] && live && !kiosk %>
    <% p.with_actions do %>
      <%= link_to edit_dashboard_path(@dashboard, view: view["id"]), class: "ss-icon-btn", title: t("dashboards.edit_dashboard"), "aria-label": t("dashboards.edit_dashboard") do %><%= icon("pencil", "") %><% end %>
    <% end %>
  <% end %>
<% end %>
<% if view["badges"].present? %>
  <div class="mt-3 flex flex-wrap gap-2" aria-label="<%= t("dashboards.summary") %>">
    <% view["badges"].each do |b| %><%= render "web/dashboards/widget", w: b, points: points, dashboard: @dashboard, badge: true, live: live %><% end %>
  </div>
<% end %>

<% tabs = Dashboards::ViewTypes.tabs(@resolved["views"], view) %>
<% if tabs.size > 1 %>
  <nav class="ss-chips is-solid mt-4" data-controller="ss-scroll-current" aria-label="<%= t("dashboards.views") %>">
    <% tabs.each do |v| %>
      <%= link_to dw_view_path(@dashboard, v, home: @home).then { |p| @preview ? dashboard_path(@dashboard, view: v["path"].presence || v["id"], rascunho: 1) : p }, class: "ss-chip no-underline", "aria-current": (v == view ? "true" : nil) do %><%= icon(v["icon"].presence || "view-boards", "size-4") %><%= v["title"] %><% end %>
    <% end %>
  </nav>
<% end %>

<% if view["sections"].all? { |s| s["widgets"].empty? } %>
  <div class="ss-card ss-empty mt-4">
    <%= render "web/shared/empty_art", art: "board", title: t("dashboards.empty"), text: (t("dashboards.empty_hint") if @resolved["can_edit"]) %>
    <% if @resolved["can_edit"] %><%= link_to t("dashboards.edit_dashboard"), edit_dashboard_path(@dashboard, view: view["id"]), class: "ss-btn ss-btn-primary" %><% end %>
  </div>
<% else %>
  <%# ondaB2 (B8): o tipo da visão (Dashboards::ViewTypes) desenha as seções. %>
  <%= render Dashboards::ViewTypes.for(view).partial, view: view, points: points, dashboard: @dashboard, live: live %>
<% end %>

<%= render "web/dashboards/kiosk", site: @site, dashboard: @dashboard if kiosk && live %>
