<% content_for :title, @home ? "Início" : @dashboard.name %>
<% live = !@preview %>
<% points = @resolved["points"] %>
<% view = @view %>
<% home_view = view == @resolved["views"].first %>
<% @body_theme = (th = Dashboards::Themes.resolve(@resolved, view, @site)) && dw_theme_attrs(th) %>
<% if live %><%= turbo_stream_from @site, :points, channel: PointsChannel %><% end %>

<% if @preview %>
  <div class="ss-card ss-card-grad p-4 mb-4 flex flex-wrap items-center gap-3" role="status">
    <span class="ss-icon-tile text-accent"><%= icon("eye") %></span>
    <p class="flex-1 min-w-0"><strong class="text-ink">Pré-visualização do rascunho.</strong> <span class="text-muted">Quem usa o painel ainda vê a versão <%= @dashboard.version %>.</span></p>
    <%= link_to "Voltar ao editor", edit_dashboard_path(@dashboard), class: "ss-btn ss-btn-ghost ss-btn-sm" %>
    <%= button_to publish_dashboard_path(@dashboard), class: "ss-btn ss-btn-primary ss-btn-sm", form: { data: { turbo_confirm: "Publicar o rascunho para todos?", turbo_confirm_button: "Publicar" } } do %><%= icon("upload", "size-4") %>Publicar<% end %>
  </div>
<% end %>

<section class="ss-hero ss-rise dw-hero" aria-label="<%= view['title'] %>">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="ss-kicker"><%= [ @site.name, l(Date.current, format: :long).upcase_first ].join(" · ") %></p>
      <h1 class="mt-1 text-white truncate"><%= home_view && @home ? "#{greeting}, #{current_user.name.split.first}" : view["title"] %></h1>
    </div>
    <div class="flex items-center gap-2">
      <% if live && can?(:command, risk: "normal") %><%= render "web/assist/button", site: @site %><% end %>
      <% if (@dashboards || []).size > 1 || @sites.to_a.size > 1 %>
        <%= link_to site_dashboards_path(@site), class: "dw-hero-btn", title: "Outros painéis", "aria-label": "Outros painéis" do %><%= icon("view-boards", "size-4") %><span class="hidden sm:inline">Painéis</span><% end %>
      <% end %>
      <% if @resolved["can_edit"] && live && !kiosk %>
        <%= link_to edit_dashboard_path(@dashboard, view: view["id"]), class: "dw-hero-btn", title: "Editar painel", "aria-label": "Editar painel" do %><%= icon("pencil", "size-4") %><span class="hidden sm:inline">Editar</span><% end %>
      <% end %>
    </div>
  </div>
  <% if view["badges"].present? %>
    <div class="mt-4 flex flex-wrap gap-2" aria-label="Resumo">
      <% view["badges"].each do |b| %><%= render "web/dashboards/widget", w: b, points: points, dashboard: @dashboard, badge: true, live: live %><% end %>
    </div>
  <% end %>
</section>

<% if @resolved["views"].size > 1 %>
  <nav class="dw-tabs" aria-label="Visões do painel">
    <% @resolved["views"].each do |v| %>
      <%= link_to dw_view_path(@dashboard, v, home: @home).then { |p| @preview ? dashboard_path(@dashboard, view: v["path"].presence || v["id"], rascunho: 1) : p }, class: "ss-chip no-underline", "aria-current": (v == view ? "true" : nil) do %><%= icon(v["icon"].presence || "view-boards", "size-4") %><%= v["title"] %><% end %>
    <% end %>
  </nav>
<% end %>

<% if view["sections"].all? { |s| s["widgets"].empty? } %>
  <div class="ss-card ss-empty mt-4">
    <%= render "web/shared/empty_art", art: "board", title: "Esta visão ainda está vazia.", text: ("Abra o editor e adicione seções e widgets." if @resolved["can_edit"]) %>
    <% if @resolved["can_edit"] %><%= link_to "Editar painel", edit_dashboard_path(@dashboard, view: view["id"]), class: "ss-btn ss-btn-primary" %><% end %>
  </div>
<% else %>
  <div class="dw-grid dw-sections mt-5">
    <% view["sections"].each_with_index do |s, i| %>
      <% next if s["widgets"].empty? %>
      <section class="dw-w ss-rise" style="<%= dw_span_style(s['span'], DashboardsHelper::SECTION_SPAN) %>; animation-delay: <%= [ i, 6 ].min * 50 %>ms" aria-label="<%= s['title'] || 'Seção' %>">
        <% if s["title"].present? %><h2 class="dw-sec-title"><%= icon(s["icon"], "size-4") if s["icon"].present? %><%= s["title"] %></h2><% end %>
        <div class="dw-grid">
          <% s["widgets"].each do |w| %><%= render "web/dashboards/widget", w: w, points: points, dashboard: @dashboard, badge: false, live: live %><% end %>
        </div>
      </section>
    <% end %>
  </div>
<% end %>

<%= render "web/dashboards/kiosk", site: @site, dashboard: @dashboard if kiosk && live %>
