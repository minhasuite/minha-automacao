<%# locals: (name:, pin:, point_options:, id:) -%>
<%= ss_fields do |f| %>
<div class="<%= FloorplanHelper::FPE_ROW %>" data-kind="pin">
  <div class="min-w-0 flex-1">
    <%= f.ss_select "#{name}[point]", grouped_options_for_select(point_options, pin["point"]), label: t("dashboards.wf.point"), hide_label: true, include_blank: t("dashboards.wf.pick_point"), id: "fp-p-#{id}", data: { role: "ref", action: "floorplan-editor#render" } %></div>
  <%= f.ss_number_field "#{name}[x]", label: "x %", value: pin["x"] || 50, min: 0, max: 100, step: "any", id: "fp-x-#{id}", class: "num", wrapper_class: FloorplanHelper::FPE_NUM, data: { role: "x", action: "floorplan-editor#render" } %>
  <%= f.ss_number_field "#{name}[y]", label: "y %", value: pin["y"] || 50, min: 0, max: 100, step: "any", id: "fp-y-#{id}", class: "num", wrapper_class: FloorplanHelper::FPE_NUM, data: { role: "y", action: "floorplan-editor#render" } %>
  <% if pin["point"] %><%= f.ss_check_box "#{name}[remove]", label: t("dashboards.wf.fp.remove"), checked: false, include_hidden: false, id: "fp-r-#{id}", wrapper_class: "text-xs", data: { role: "remove", action: "floorplan-editor#render" } %><% end %>
</div>
<% end %>
