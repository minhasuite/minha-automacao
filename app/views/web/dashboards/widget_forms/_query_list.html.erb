<%# locals: (w:, uid:, types:, **) -%>
<% q = w["query"] || {} %>
<div data-for="<%= types %>"><label class="ss-label" for="qo-<%= uid %>"><%= t("dashboards.wf.q.sort") %></label>
  <%= select_tag "widget[query][sort]", options_for_select({ t("dashboards.wf.q.sorts.name") => "name", t("dashboards.wf.q.sorts.value") => "value", t("dashboards.wf.q.sorts.value_desc") => "-value", t("dashboards.wf.q.sorts.oldest") => "changed_at", t("dashboards.wf.q.sorts.newest") => "-changed_at" }, q["sort"]), include_blank: t("dashboards.wf.q.sorts.name"), class: "ss-input", id: "qo-#{uid}" %></div>
<div data-for="<%= types %>"><label class="ss-label" for="et-<%= uid %>"><%= t("dashboards.wf.q.empty_text") %></label>
  <%= text_field_tag "widget[empty_text]", w["empty_text"], class: "ss-input", id: "et-#{uid}", placeholder: t("dashboards.gen.all_off") %></div>
