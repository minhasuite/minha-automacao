  <%= select_tag "widget[color]", options_for_select({ "Roxo (padrão)" => "accent", "Âmbar (luz)" => "amber", "Verde" => "green", "Vermelho" => "red", "Azul" => "blue" }, w["color"]), class: "ss-input", id: "co-#{uid}" %></div>
<div data-for="<%= types %>"><label class="ss-label" for="tp-<%= uid %>">Toque</label>
