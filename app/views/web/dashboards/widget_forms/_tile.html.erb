<%# locals: (w:, uid:, types:, **) -%>
<%= ss_fields do |f| %>
<div data-for="<%= types %>">
  <%= f.ss_select "widget[color]", options_for_select(%w[accent amber green red blue].index_by { |k| t("dashboards.wf.colors.#{k}") }, w["color"]), label: t("dashboards.wf.color"), id: "co-#{uid}" %></div>
<div data-for="<%= types %>">
  <%= f.ss_select "widget[tap]", options_for_select({ t("dashboards.wf.taps.toggle") => "toggle", t("dashboards.wf.taps.more_info") => "more_info" }, w["tap"]), label: t("dashboards.wf.tap"), id: "tp-#{uid}" %></div>
<%# ondaB2 (B9): recursos do tile (Dashboards::TileFeatures); o que não acha alvo no aparelho do ponto não aparece. %>
<% chosen = Dashboards::TileFeatures.entries(w["features"]).map(&:first) %>
<details class="sm:col-span-2" data-for="<%= types %>" <%= "open" if chosen.any? %>>
  <summary class="ss-summary ss-label"><%= t("dashboards.feat.title") %> <span class="font-normal"><%= t("dashboards.feat.hint", max: Dashboards::TileFeatures::MAX) %></span></summary>
  <div class="mt-2 grid gap-2 sm:grid-cols-3">
    <% Dashboards::TileFeatures.plugins.each do |ft| %>
      <%= f.ss_check_box "widget[features][]", label: safe_join([ icon(ft.icon, "size-4"), ft.label ]), checked_value: ft.key, include_hidden: false, checked: chosen.include?(ft.key), id: "ft-#{ft.key}-#{uid}" %>
    <% end %>
  </div>
</details>
<% end %>
