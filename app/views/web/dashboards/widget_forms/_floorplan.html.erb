<%# locals: (w:, uid:, types:, point_options:, areas:, **) -%>
<%# Planta baixa: uma caixa por camada (andar). Arrastar os marcadores na imagem
    preenche x/y; os números ficam visíveis para quem usa o teclado. Uma linha em
    branco de ponto, de cômodo e de camada já vem pronta (funciona sem JS). %>
<% if w.empty? || w["type"] == "floorplan" %>
<% layers = Array(w["layers"]) + [ {} ] %>
<% area_options = areas.map { |a| [ a.name, a.id ] } %>
<div class="sm:col-span-2 grid gap-3" data-for="<%= types %>">
<%= ss_fields do |f| %>
  <% layers.each_with_index do |l, li| %>
    <% base = "widget[layers][#{li}]" %>
    <% fresh = l.empty? %>
    <details class="dw-fpe rounded-2xl border border-line p-3" <%= "open" if li.zero? %> data-controller="floorplan-editor">
      <summary class="cursor-pointer font-semibold text-ink flex items-center gap-2"><%= icon(fresh ? "plus" : "map", "size-4 text-accent") %><%= fresh ? (layers.size == 1 ? t("dashboards.wf.fp.first_layer") : t("dashboards.wf.fp.new_layer")) : l["title"] %></summary>
      <%= hidden_field_tag "#{base}[id]", l["id"], id: nil %>
      <div class="grid gap-3 sm:grid-cols-2 mt-3">
        <%= f.ss_text_field "#{base}[title]", label: t("dashboards.wf.fp.layer_name"), value: l["title"], id: "fl-t-#{uid}-#{li}", maxlength: 40, placeholder: t("dashboards.wf.fp.layer_placeholder") %>
        <%= f.ss_file_field "#{base}[upload]", label: safe_join([ t("dashboards.wf.fp.image"), " ", tag.span(t("dashboards.wf.fp.image_hint"), class: "font-normal") ]), accept: "image/png,image/jpeg,image/webp", id: "fl-u-#{uid}-#{li}", data: { action: "floorplan-editor#preview" } %>
        <%= f.ss_text_field "#{base}[image]", label: safe_join([ t("dashboards.wf.fp.image_url"), " ", tag.span(t("dashboards.wf.fp.image_url_hint"), class: "font-normal") ]), value: l["image"], id: "fl-i-#{uid}-#{li}", placeholder: "https://…", wrapper_class: "sm:col-span-2", data: { floorplan_editor_target: "image", action: "floorplan-editor#render" } %>
      </div>

      <p class="text-xs text-muted mt-3" id="fl-hint-<%= uid %>-<%= li %>"><%= t("dashboards.wf.fp.drag_hint") %></p>
      <div class="dw-fpe-canvas <%= 'dw-fp-drawn' if l['image'].blank? %>" data-floorplan-editor-target="canvas" aria-describedby="fl-hint-<%= uid %>-<%= li %>">
        <img src="<%= l['image'] %>" alt="" class="dw-fp-img" data-floorplan-editor-target="img"<%= " hidden" if l["image"].blank? %>>
      </div>

      <fieldset class="mt-3">
        <legend class="ss-label"><%= t("dashboards.wf.fp.pins") %></legend>
        <div class="grid gap-2" data-floorplan-editor-target="pins">
          <% (Array(l["pins"]) + [ {} ]).each_with_index do |pin, pi| %>
            <%= render "web/dashboards/widget_forms/floorplan_pin", name: "#{base}[pins][#{pi}]", pin: pin, point_options: point_options, id: "#{uid}-#{li}-#{pi}" %>
          <% end %>
        </div>
        <%= render Ss::ButtonComponent.new(label: t("dashboards.wf.fp.add_pin"), icon: icon("plus", ""), variant: :ghost, size: :sm, css: "mt-2", hidden: true, data: { action: "floorplan-editor#addPin", floorplan_editor_target: "js" }) %>
      </fieldset>

      <fieldset class="mt-3">
        <legend class="ss-label"><%= t("dashboards.wf.fp.rooms") %> <span class="font-normal"><%= t("dashboards.wf.fp.rooms_hint") %></span></legend>
        <div class="grid gap-2" data-floorplan-editor-target="rooms">
          <% (Array(l["rooms"]) + [ {} ]).each_with_index do |room, ri| %>
            <%= render "web/dashboards/widget_forms/floorplan_room", name: "#{base}[rooms][#{ri}]", room: room, area_options: area_options, id: "#{uid}-#{li}-#{ri}" %>
          <% end %>
        </div>
        <%= render Ss::ButtonComponent.new(label: t("dashboards.wf.fp.add_room"), icon: icon("plus", ""), variant: :ghost, size: :sm, css: "mt-2", hidden: true, data: { action: "floorplan-editor#addRoom", floorplan_editor_target: "js" }) %>
      </fieldset>
      <% unless fresh %><%= f.ss_check_box "#{base}[remove]", label: t("dashboards.wf.fp.remove_layer"), checked: false, include_hidden: false, id: "fl-r-#{uid}-#{li}", wrapper_class: "mt-3" %><% end %>
    </details>
  <% end %>
<% end %>
</div>
<% end %>
