<%# locals: (w:, uid:, types:, point_options:, **) -%>
<div data-for="<%= types %>"><label class="ss-label" for="pb-<%= uid %>"><%= t("dashboards.wf.period") %></label>
  <%= select_tag "widget[period]", options_for_select(Dashboards::Widgets::EnergyBreakdownWidget::PERIODS.keys.index_by { |k| t("dashboards.periods.#{k}") }, w["period"] || "month"), class: "ss-input", id: "pb-#{uid}" %></div>
<div data-for="<%= types %>"><label class="ss-label" for="lb2-<%= uid %>"><%= t("dashboards.wf.limit") %> <span class="font-normal"><%= t("dashboards.wf.limit_hint") %></span></label>
  <%= number_field_tag "widget[limit]", w["limit"], in: 3..20, class: "ss-input num", id: "lb2-#{uid}", placeholder: "8" %></div>
<div data-for="<%= types %>"><label class="ss-label" for="tf-<%= uid %>"><%= t("dashboards.wf.tariff") %></label>
  <%= text_field_tag "widget[tariff]", w["tariff"], class: "ss-input num", id: "tf-#{uid}", inputmode: "decimal", placeholder: t("dashboards.wf.tariff_placeholder") %></div>
<div data-for="<%= types %>"><label class="ss-label" for="tp3-<%= uid %>"><%= t("dashboards.wf.tariff_point") %> <span class="font-normal"><%= t("dashboards.wf.tariff_point_hint2") %></span></label>
  <%= select_tag "widget[tariff_point]", grouped_options_for_select(point_options, w["tariff_point"]), include_blank: t("dashboards.wf.use_fixed"), class: "ss-input", id: "tp3-#{uid}" %></div>
<p data-for="<%= types %>" class="text-xs text-muted sm:col-span-2"><%= t("dashboards.wf.breakdown_hint") %></p>
