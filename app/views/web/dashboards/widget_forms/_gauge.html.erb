<%# locals: (w:, uid:, types:, **) -%>
<div data-for="<%= types %>"><%= ss_fields do |f| %><div class="grid grid-cols-2 gap-2">
  <%= f.ss_text_field "widget[min]", label: t("dashboards.wf.min"), value: w["min"], class: "num", id: "mn-#{uid}", inputmode: "decimal" %>
  <%= f.ss_text_field "widget[max]", label: t("dashboards.wf.max"), value: w["max"], class: "num", id: "mx-#{uid}", inputmode: "decimal" %>
</div><% end %></div>
