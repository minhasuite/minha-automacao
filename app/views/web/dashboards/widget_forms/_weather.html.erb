<%# locals: (w:, uid:, types:, **) -%>
<div data-for="<%= types %>"><label class="ss-label" for="wf-<%= uid %>"><%= t("dashboards.wf.forecast") %></label>
  <%= select_tag "widget[forecast]", options_for_select(Dashboards::Widgets::WeatherWidget::FORECASTS.keys.index_by { |k| t("dashboards.wf.forecasts.#{k}") }, w["forecast"] || "daily"), class: "ss-input", id: "wf-#{uid}" %></div>
