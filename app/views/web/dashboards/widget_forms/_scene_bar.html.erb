<%# locals: (w:, uid:, types:, scenes:, **) -%>
<div class="sm:col-span-2" data-for="<%= types %>">
  <%= ss_fields { |f| f.ss_select "widget[scenes]", options_from_collection_for_select(scenes, :id, :name, w["scenes"]), label: safe_join([ t("dashboards.gen.scenes"), " ", tag.span(t("dashboards.wf.scenes_hint"), class: "font-normal") ]), multiple: true, size: 4, id: "sc-#{uid}" } %></div>
