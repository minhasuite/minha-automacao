<%# locals: (w:, uid:, point_options:) -%>
<%# P1.2: estilo condicional (qualquer widget). Cada regra: quando (um ponto com estado ou faixa e/ou horário) → cor,
    ícone, rótulo, tom e selo. A primeira que bate vale. Condição que o formulário não mostra (OU, qualidade…)
    fica guardada como veio (editável no JSON). Ideia 22: o limite do "dado velho" deste widget. %>
<% rules = Array(w["style_if"]).select { |r| r.is_a?(Hash) } %>
<details class="sm:col-span-2"<%= " open" if rules.any? || w.key?("stale_after_min") %>>
  <summary class="ss-label cursor-pointer"><%= t("dashboards.style.form.title") %></summary>
  <p class="text-xs text-muted mt-1"><%= t("dashboards.style.form.hint") %></p>
  <%= ss_fields do |f| %>
  <div class="grid gap-3 mt-3">
    <% (rules + [ {} ]).each_with_index do |r, i| %>
      <% cond = r["when"] || {} %>
      <% simple = Dashboards::Style.simple?(cond) %>
      <% st = cond["state"] || {} %>
      <% nu = cond["numeric"] || {} %>
      <% sid = "#{uid}-st#{i}" %>
      <% n = "style[#{i}]" %>
      <fieldset class="ss-card ss-card-pad grid gap-3 sm:grid-cols-3">
        <legend class="ss-label"><%= t("dashboards.style.form.rule", n: i + 1) %></legend>
        <% if simple %>
          <%= f.ss_select "#{n}[point]", grouped_options_for_select(point_options, st["point"] || nu["point"]), label: t("dashboards.style.form.when_point"), include_blank: t("dashboards.style.form.no_point"), id: "#{sid}-p", wrapper_class: "sm:col-span-3" %>
          <%= f.ss_text_field "#{n}[is]", label: t("dashboards.style.form.is"), value: Array(st["is"] || st["not"]).first, id: "#{sid}-is", placeholder: "true, open, on" %>
          <%= f.ss_text_field "#{n}[above]", label: t("dashboards.style.form.above"), value: nu["above"], class: "num", id: "#{sid}-ab", inputmode: "decimal" %>
          <%= f.ss_text_field "#{n}[below]", label: t("dashboards.style.form.below"), value: nu["below"], class: "num", id: "#{sid}-be", inputmode: "decimal" %>
          <%= f.ss_check_box "#{n}[negate]", label: t("dashboards.style.form.negate"), checked: st.key?("not"), include_hidden: false, id: "#{sid}-ng" %>
          <%= f.ss_time_field "#{n}[after]", label: t("dashboards.style.form.after"), value: cond.dig("time", "after"), class: "num", id: "#{sid}-af" %>
          <%= f.ss_time_field "#{n}[before]", label: t("dashboards.style.form.before"), value: cond.dig("time", "before"), class: "num", id: "#{sid}-bf" %>
        <% else %>
          <%= hidden_field_tag "#{n}[when_json]", cond.to_json, id: nil %>
          <p class="sm:col-span-3 text-sm text-muted"><%= t("dashboards.style.form.advanced") %> <code class="num"><%= cond.to_json.truncate(120) %></code></p>
        <% end %>
        <%= f.ss_select "#{n}[tone]", options_for_select(Dashboards::Style::TONES.index_by { |k| t("dashboards.facts.tones.#{k}") }, r["tone"]), label: t("dashboards.facts.tone"), include_blank: t("dashboards.facts.tones.none"), id: "#{sid}-to" %>
        <%= f.ss_select "#{n}[color]", options_for_select(Dashboards::Schema::COLORS.index_by { |k| t("dashboards.wf.colors.#{k}") }, r["color"]), label: t("dashboards.style.form.color"), include_blank: t("dashboards.facts.tones.none"), id: "#{sid}-co" %>
        <%= f.ss_text_field "#{n}[icon]", label: t("dashboards.facts.icon"), value: r["icon"], id: "#{sid}-ic", maxlength: 80, placeholder: "mdi:door-open" %>
        <%= f.ss_text_field "#{n}[label]", label: t("dashboards.style.form.label"), value: r["label"], id: "#{sid}-lb", maxlength: 80 %>
        <%= f.ss_text_field "#{n}[badge]", label: t("dashboards.style.form.badge"), value: r["badge"], id: "#{sid}-bd", maxlength: 80, placeholder: t("dashboards.style.form.badge_placeholder"), wrapper_class: "sm:col-span-2" %>
        <% if r.any? %><%= f.ss_check_box "#{n}[remove]", label: t("dashboards.style.form.remove"), checked: false, include_hidden: false, id: "#{sid}-rm", wrapper_class: "sm:col-span-3" %><% end %>
      </fieldset>
    <% end %>
    <div class="max-w-xs">
      <%= f.ss_number_field "widget[stale_after_min]", label: t("dashboards.stale.form.label"), value: w["stale_after_min"], min: 0, max: Dashboards::Staleness::MAX_MIN, class: "num", id: "sa-#{uid}", placeholder: t("dashboards.stale.form.placeholder") %>
      <p class="text-xs text-muted mt-1"><%= t("dashboards.stale.form.hint") %></p></div>
  </div>
  <% end %>
</details>
