<%# locals: (w:, uid:, types:, **) -%>
<div class="sm:col-span-2" data-ss-reveal-for="<%= types %>">
  <%= ss_fields { |f| f.ss_text_area "widget[text]", label: safe_join([ t("dashboards.wf.text"), " ", tag.span(t("dashboards.wf.text_hint"), class: "font-normal") ]), value: w["text"], id: "x-#{uid}", rows: 4, maxlength: 4000 } %></div>
