<%# locals: (facts:, prefix:, uid:, areas:, types: nil, scoped: false) -%>
<%# Itens do cartão como consultas (P1.1): uma linha por item, com o rótulo pela contagem (zero/um/vários; %{count} =
    o número), o ícone, a consulta (o mesmo widget_forms/_query do editor), a conta, quando aparece e o tom. Duas
    linhas vazias a mais para itens novos; linha sem consulta some ao salvar. `scoped`: a área entra sozinha. %>
<% rows = facts.map(&:deep_stringify_keys) + Array.new([ Dashboards::Facts::MAX - facts.size, 2 ].min.clamp(0, 2)) { {} } %>
<%= ss_fields do |fb| %>
<% rows.each_with_index do |f, i| %>
  <% fid = "#{uid}-f#{i}" %>
  <% name = "#{prefix}[#{i}]" %>
  <% legend = f["label_key"].present? ? t("dashboards.facts.labels.#{f['label_key']}.other", count: "N", default: f["id"]) : (f["id"].presence || t("dashboards.facts.new")) %>
  <fieldset class="ss-card ss-card-pad grid gap-3 sm:grid-cols-2" <%= tag.attributes(data: { for: types }) %>>
    <legend class="ss-label"><%= t("dashboards.facts.item", n: i + 1) %> · <%= legend %></legend>
    <%= hidden_field_tag "#{name}[id]", f["id"], id: nil %>
    <%= hidden_field_tag "#{name}[label_key]", f["label_key"], id: nil %>
    <% %w[one other zero].each do |form| %>
      <%= fb.ss_text_field "#{name}[label][#{form}]", label: t("dashboards.facts.label_#{form}"), value: (f["label"].is_a?(Hash) ? f["label"][form] : f["label"]), id: "#{fid}-l#{form}", maxlength: 80,
                           placeholder: (t("dashboards.facts.labels.#{f['label_key']}.#{form}", count: "%{count}", default: "") if f["label_key"].present?) %>
    <% end %>
    <%= fb.ss_text_field "#{name}[icon]", label: t("dashboards.facts.icon"), value: f["icon"], id: "#{fid}-ic", placeholder: "light-bulb, mdi:door-open" %>
    <%= fb.ss_select "#{name}[aggregate]", options_for_select(Dashboards::Facts::AGGREGATES.index_by { |k| t("dashboards.facts.aggregates.#{k}") }, f["aggregate"] || "count"), label: t("dashboards.facts.aggregate"), id: "#{fid}-ag" %>
    <%= fb.ss_select "#{name}[show]", options_for_select(Dashboards::Facts::SHOWS.index_by { |k| t("dashboards.facts.shows.#{k}") }, f["show"] || "nonzero"), label: t("dashboards.facts.show"), id: "#{fid}-sh" %>
    <%= fb.ss_select "#{name}[tone]", options_for_select(Dashboards::Facts::TONES.index_by { |k| t("dashboards.facts.tones.#{k}") }, f["tone"]), label: t("dashboards.facts.tone"), include_blank: t("dashboards.facts.tones.none"), id: "#{fid}-to" %>
    <%= fb.ss_text_field "#{name}[format]", label: t("dashboards.facts.format"), value: f["format"], id: "#{fid}-fo", maxlength: 12, placeholder: "W" %>
    <% shown, rest = Dashboards::Facts.split_query((f["query"] || {}).except(*(scoped ? %w[area] : []))) %>
    <%= render "web/dashboards/widget_forms/query", w: { "query" => shown }, uid: fid, types: types, areas: areas, prefix: "#{name}[query]" %>
    <div class="sm:col-span-2" <%= tag.attributes(data: { for: types }) %>>
      <%= fb.ss_text_field "#{name}[query_text]", label: t("dashboards.facts.query_text"), value: rest, class: "num", id: "#{fid}-qt", placeholder: "quality=unavailable,error capability=contact,gate" %>
      <p class="text-xs text-muted mt-1"><%= t("dashboards.facts.query_text_hint") %></p></div>
    <% if f["query"].present? %>
      <%= fb.ss_check_box "#{name}[remove]", label: t("dashboards.facts.remove"), checked: false, include_hidden: false, id: "#{fid}-rm", wrapper_class: "sm:col-span-2" %>
    <% end %>
  </fieldset>
<% end %>
<% end %>
