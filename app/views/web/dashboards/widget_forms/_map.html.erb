<%# locals: (w:, uid:, types:, **) -%>
<%= ss_fields do |f| %>
<div data-for="<%= types %>">
  <%= f.ss_number_field "widget[height]", label: t("dashboards.wf.height"), value: w["height"], in: 180..800, class: "num", id: "mh-#{uid}", placeholder: "320" %></div>
<div data-for="<%= types %>" class="flex items-end"><%= f.ss_check_box "widget[track]", label: t("dashboards.wf.track"), checked: w["track"] != false, id: "mt-#{uid}" %></div>
<% end %>
