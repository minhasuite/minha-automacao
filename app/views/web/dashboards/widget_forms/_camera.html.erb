<%# locals: (w:, uid:, types:, **) -%>
<div class="sm:col-span-2" data-for="<%= types %>">
  <label class="ss-check"><%= hidden_field_tag "widget[autoplay]", "0", id: nil %><%= check_box_tag "widget[autoplay]", "1", w["autoplay"] == true, id: "cap-#{uid}" %><%= t("dashboards.wf.camera_autoplay") %></label>
  <p class="text-xs text-muted mt-1"><%= t("dashboards.wf.camera_autoplay_hint", max: w["autoplay_max"] || Dashboards::Widgets::CameraWidget::AUTOPLAY_MAX) %></p>
</div>
