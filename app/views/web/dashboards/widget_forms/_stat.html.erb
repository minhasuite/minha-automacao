<%# locals: (w:, uid:, types:, **) -%>
<%= ss_fields do |f| %>
<div data-ss-reveal-for="<%= types %>">
  <%= f.ss_select "widget[aggregate]", options_for_select(%w[count sum avg min max last change].index_by { |k| t("dashboards.wf.aggregates.#{k}") }, w["aggregate"]), label: t("dashboards.wf.show"), id: "ag-#{uid}" %></div>
<div data-ss-reveal-for="<%= types %>">
  <%= f.ss_select "widget[period]", options_for_select(Dashboards::Schema::PERIODS.index_by { |k| t("dashboards.wf.stat_periods.#{k}") }, w["period"]), label: t("dashboards.wf.period"), include_blank: true, id: "pe-#{uid}" %></div>
<div data-ss-reveal-for="<%= types %>">
  <%= f.ss_text_field "widget[attribute]", label: safe_join([ t("dashboards.wf.attribute"), " ", tag.span(t("dashboards.wf.attribute_hint"), class: "font-normal") ]), value: w["attribute"], class: "num", id: "at-#{uid}", maxlength: 40, placeholder: t("dashboards.wf.attribute_placeholder") %></div>
<%# P1.4: rótulo pela contagem (selo do topo e contador); %{count} = o número. Vazio = "número rótulo". %>
<fieldset class="sm:col-span-2" data-ss-reveal-for="<%= types %>">
  <legend class="ss-label"><%= t("dashboards.wf.labels") %> <span class="font-normal"><%= t("dashboards.wf.labels_hint") %></span></legend>
  <div class="grid gap-2 sm:grid-cols-3">
    <% %w[zero one other].each do |form| %>
      <%= f.ss_text_field "widget[labels][#{form}]", label: t("dashboards.facts.label_#{form}"), value: w.dig("labels", form), id: "lb-#{form}-#{uid}", maxlength: 80 %>
    <% end %>
  </div>
</fieldset>
<% end %>
