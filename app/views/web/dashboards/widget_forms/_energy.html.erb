<%# locals: (w:, uid:, types:, point_options:, **) -%>
<div data-for="<%= types %>"><label class="ss-label" for="pe-<%= uid %>"><%= t("dashboards.wf.period") %></label>
  <%= select_tag "widget[period]", options_for_select(Dashboards::Energy::PERIODS.keys.index_by { |k| t("dashboards.periods.#{k}") }, w["period"] || "month"), class: "ss-input", id: "pe-#{uid}" %></div>
<div data-for="<%= types %>"><label class="ss-label" for="cd-<%= uid %>"><%= t("dashboards.wf.cycle_day") %> <span class="font-normal"><%= t("dashboards.wf.cycle_only") %></span></label>
  <%= number_field_tag "widget[cycle_day]", w["cycle_day"], in: 1..28, class: "ss-input num", id: "cd-#{uid}", placeholder: t("dashboards.wf.cycle_placeholder") %></div>
<div data-for="<%= types %>"><label class="ss-label" for="tf-<%= uid %>"><%= t("dashboards.wf.tariff") %></label>
  <%= text_field_tag "widget[tariff]", w["tariff"], class: "ss-input num", id: "tf-#{uid}", inputmode: "decimal", placeholder: t("dashboards.wf.tariff_placeholder") %></div>
<div data-for="<%= types %>"><label class="ss-label" for="tp2-<%= uid %>"><%= t("dashboards.wf.tariff_point") %> <span class="font-normal"><%= t("dashboards.wf.tariff_point_hint") %></span></label>
  <%= select_tag "widget[tariff_point]", grouped_options_for_select(point_options, w["tariff_point"]), include_blank: t("dashboards.wf.use_fixed"), class: "ss-input", id: "tp2-#{uid}" %></div>
<div data-for="<%= types %>"><label class="ss-label" for="gl-<%= uid %>"><%= t("dashboards.wf.goal") %></label>
  <%= text_field_tag "widget[goal]", w["goal"], class: "ss-input num", id: "gl-#{uid}", inputmode: "decimal" %></div>
<div data-for="<%= types %>" class="flex items-end"><label class="ss-check"><%= hidden_field_tag "widget[compare]", "0", id: nil %><%= check_box_tag "widget[compare]", "1", w["compare"], id: "cp-#{uid}" %><%= t("dashboards.wf.compare") %></label></div>
