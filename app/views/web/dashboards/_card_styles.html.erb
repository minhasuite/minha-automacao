<%# locals: (dashboard:, current:) -%>
<%# Ideia 19: galeria de estilos de card (Dashboards::CardStyles, um YAML por estilo em config/card_styles). Cada
    amostra é um card da gem com os tokens do estilo; um clique aplica ao painel (vira versão nova). P1.3/P2.3: os
    modelos de card do local e exportar o painel como pacote. %>
<section class="ss-card ss-card-pad grid gap-3" aria-labelledby="cs-title">
  <h2 id="cs-title" class="flex items-center gap-2"><%= icon("template", "size-5 text-accent") %><%= t("dashboards.card_styles.title") %></h2>
  <p class="text-sm text-muted -mt-2"><%= t("dashboards.card_styles.hint") %></p>
  <div class="grid grid-cols-2 gap-2">
    <% [ nil, *Dashboards::CardStyles.all ].each do |st| %>
      <% key = st&.key %>
      <% on = current.to_s == key.to_s %>
      <%= render(Ss::ButtonComponent.new(href: card_style_dashboard_path(dashboard), method: :patch, params: { card_style: key.to_s }, variant: :item, css: "w-full text-left !p-0 block",
                                         form: { class: "contents" }, aria: { pressed: on }, title: (Dashboards::CardStyles.description(st) if st))) do %>
        <span class="ss-card block p-3 <%= on ? "has-outline" : "" %>" style="<%= Dashboards::CardStyles.css(key) %>">
          <span class="flex items-center gap-2 text-sm font-semibold text-ink"><%= icon(st&.icon || "view-boards", "size-4") %><%= st ? Dashboards::CardStyles.label(st) : t("dashboards.card_styles.none") %></span>
        </span>
      <% end %>
    <% end %>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to site_card_templates_path(dashboard.site), class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("template", "size-4") %><%= t("dashboards.templates.title") %><% end %>
    <%= link_to export_dashboard_path(dashboard), class: "ss-btn ss-btn-ghost ss-btn-sm", data: { turbo: false } do %><%= icon("download", "size-4") %><%= t("dashboards.export.button") %><% end %>
  </div>
</section>
