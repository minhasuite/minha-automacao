<%# locals: (dashboard:, kind:, target:, view_id:, name:, clipboard: nil, back: nil, arrows: true) -%>
<%# Ferramentas de um bloco do editor: subir/descer, copiar e duplicar (ideias 4 e 7), colar o que está na área de
    transferência da pessoa (widget na seção, seção na visão, "colar estilo" no widget), JSON do widget (P1.5) e remover. %>
<% base = { kind: kind, target: target, view_id: view_id, back: back }.compact %>
<% clip_kind = clipboard&.dig("kind") %>
<% top = back ? { data: { turbo_frame: "_top" } } : {} %>
<div class="flex flex-wrap items-center gap-1 shrink-0">
  <% if arrows %>
    <% [ [ "up", "chevron-up" ], [ "down", "chevron-down" ] ].each do |dir, ico| %><% label = t("dashboards.tools.#{dir}", name: name) %>
      <%= render Ss::ButtonComponent.new(icon: icon(ico, "size-4"), href: draft_dashboard_path(dashboard), method: :patch, params: base.merge(op: "move", dir: dir), variant: :ghost, size: :sm, title: label, aria: { label: label }, form: top) %>
    <% end %>
  <% end %>
  <% if kind.in?(%w[widget section]) %>
    <% label = t("dashboards.tools.copy", name: name) %>
    <%= render Ss::ButtonComponent.new(icon: icon("clipboard-list", "size-4"), href: copy_dashboard_path(dashboard), method: :post, params: base, variant: :ghost, size: :sm, title: label, aria: { label: label }, form: top) %>
    <% label = t("dashboards.tools.duplicate", name: name) %>
    <%= render Ss::ButtonComponent.new(icon: icon("duplicate", "size-4"), href: draft_dashboard_path(dashboard), method: :patch, params: base.merge(op: "duplicate"), variant: :ghost, size: :sm, title: label, aria: { label: label }, form: top) %>
  <% end %>
  <% if (kind == "section" && clip_kind == "widget") || (kind == "view" && clip_kind == "section") %>
    <% label = t("dashboards.tools.paste", name: clipboard["label"].presence || t("dashboards.clip.#{clip_kind}")) %>
    <%= render Ss::ButtonComponent.new(icon: icon("inbox", "size-4"), href: draft_dashboard_path(dashboard), method: :patch, params: base.merge(op: "paste"), variant: :ghost, size: :sm, title: label, aria: { label: label }, form: top) %>
  <% end %>
  <% if kind == "widget" %>
    <% if clip_kind == "widget" %>
      <% label = t("dashboards.tools.paste_style", name: clipboard["label"].presence || t("dashboards.clip.widget")) %>
      <%= render Ss::ButtonComponent.new(icon: icon("paint-brush", "size-4"), href: draft_dashboard_path(dashboard), method: :patch, params: base.merge(op: "paste_style"), variant: :ghost, size: :sm, title: label, aria: { label: label }, form: top) %>
    <% end %>
    <% label = t("dashboards.tools.json", name: name) %>
    <%= link_to widget_json_dashboard_path(dashboard, widget_id: target, back: back), class: "ss-icon-btn is-outline is-sm", title: label, "aria-label": label, data: { turbo_frame: "_top" } do %><%= icon("code", "size-4") %><% end %>
  <% end %>
  <% label = t("dashboards.tools.remove", name: name) %>
  <%= render Ss::ButtonComponent.new(icon: icon("trash", "size-4"), href: draft_dashboard_path(dashboard), method: :patch, params: base.merge(op: "remove"), variant: :ghost, size: :sm, tone: :danger,
                                     title: label, aria: { label: label }, form: top, confirm: t("dashboards.tools.remove_confirm", name: name), confirm_tone: :danger,
                                     confirm_button: t("shared.confirm.remove")) %>
</div>
