<%# locals: (dashboard:, kind:, target:, view_id:, name:) -%>
<div class="flex items-center gap-1 shrink-0">
  <% [ [ "up", "chevron-up" ], [ "down", "chevron-down" ] ].each do |dir, ico| %><% label = t("dashboards.tools.#{dir}", name: name) %>
    <%= button_to draft_dashboard_path(dashboard), method: :patch, params: { op: "move", kind: kind, target: target, dir: dir, view_id: view_id }, class: "ss-icon-btn is-outline is-sm", title: label, "aria-label": label do %><%= icon(ico, "size-4") %><% end %>
  <% end %>
  <%= button_to draft_dashboard_path(dashboard), method: :patch, params: { op: "remove", kind: kind, target: target, view_id: view_id }, class: "ss-icon-btn is-outline is-sm is-danger", title: t("dashboards.tools.remove", name: name), "aria-label": t("dashboards.tools.remove", name: name), form: { data: { turbo_confirm_tone: "danger", turbo_confirm_button: t("shared.confirm.remove"), turbo_confirm: t("dashboards.tools.remove_confirm", name: name) } } do %><%= icon("trash", "size-4") %><% end %>
</div>
