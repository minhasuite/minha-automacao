<%# locals: (dashboard:, view:, areas:) -%>
<%# P2.1 e ideias 3 e 6: arrumar a visão, visão automática por área e montagem por frase (Web::DashboardArrangeController). %>
<% auto = Dashboards::AutoViews.auto?(view) %>
<section class="ss-card ss-card-pad grid gap-3" aria-labelledby="arr-title" id="arrumar">
  <%= render Ss::CardHeaderComponent.new(title: t("arrange.tools.title"), subtitle: t("arrange.tools.subtitle"), icon: icon("sparkles", ""), heading: :h2, id: "arr-title") %>
  <% if auto %>
    <%= render Ss::NoteComponent.new(text: t("arrange.tools.auto_note"), icon: icon("refresh", "")) %>
    <div class="flex flex-wrap gap-2">
      <%= render Ss::ButtonComponent.new(label: t("arrange.tools.freeze"), icon: icon("lock-closed", "size-4"), href: freeze_view_dashboard_path(dashboard), method: :post, params: { view: view["id"] },
                                         variant: :outline, size: :sm, confirm: t("arrange.tools.freeze_confirm"), confirm_button: t("arrange.tools.freeze")) %>
    </div>
  <% else %>
    <div class="flex flex-wrap gap-2">
      <% if Dashboards::ViewTypes.for(view) == Dashboards::ViewTypes::Sections %>
        <%= link_to arrange_dashboard_path(dashboard, view: view["id"]), class: "ss-btn ss-btn-outline ss-btn-sm" do %><%= icon("view-boards", "size-4") %><%= t("arrange.tools.arrange") %><% end %>
      <% end %>
      <% if view["area"].present? %>
        <%= render Ss::ButtonComponent.new(label: t("arrange.tools.make_auto"), icon: icon("refresh", "size-4"), href: auto_view_dashboard_path(dashboard), method: :post, params: { view: view["id"] },
                                           variant: :ghost, size: :sm) %>
      <% end %>
    </div>
  <% end %>
  <% if areas.any? %>
    <%= ss_form_with url: auto_view_dashboard_path(dashboard), method: :post, class: "flex flex-wrap items-end gap-2" do |f| %>
      <%= f.ss_select :area_id, areas.reject(&:floor?).map { |a| [ a.name, a.id ] }, label: t("arrange.tools.auto_area"), id: "arr-area", wrapper_class: "flex-1 min-w-40" %>
      <%= f.ss_submit t("arrange.tools.auto_add"), variant: :ghost %>
    <% end %>
  <% end %>
  <%= ss_form_with url: compose_dashboard_path(dashboard), method: :post, class: "grid gap-2", data: { turbo_submits_with: t("arrange.tools.composing") } do |f| %>
    <%= hidden_field_tag :view_id, view["id"], id: nil %>
    <%= f.ss_text_area :text, label: t("arrange.tools.compose"), help: t("arrange.tools.compose_hint"), id: "arr-text", rows: 2, maxlength: Dashboards::Compose::MAX_TEXT,
                              placeholder: t("arrange.tools.compose_placeholder") %>
    <div><%= f.ss_submit t("arrange.tools.compose_submit"), variant: :outline, small: true, data: { turbo_submits_with: t("arrange.tools.composing") } %></div>
  <% end %>
  <div class="flex flex-wrap gap-3 text-sm">
    <%= link_to t("arrange.tools.changes"), changes_dashboard_path(dashboard), class: "ss-btn ss-btn-ghost ss-btn-sm" %>
    <%= link_to t("arrange.tools.rules"), settings_arrange_rules_path(dashboard.site_id), class: "ss-btn ss-btn-ghost ss-btn-sm" %>
  </div>
</section>
