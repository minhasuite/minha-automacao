<%# locals: (site:, dashboard:) -%>
<%# Modo tablet de parede (uiweb): tela cheia sem menu, tela sempre acesa
    (Wake Lock), cursor some parado, protetor de tela que acorda no toque ou
    no movimento de um ponto escolhido. Ajustes por aparelho (cookie). %>
<% k = kiosk %>
<% weather = site.points.where(capability: "weather", disabled: false).first %>
<% temperature = site.points.where(capability: "measure", device_class: "temperature", disabled: false).order(:name).first %>
<% cameras = k["saver"] == "cameras" ? site.points.where(capability: "stream", disabled: false).order(:name).limit(12).map { |c| camera_snapshot_path(c.id) } : [] %>
<% photos = k["saver"] == "photos" ? dashboard.saver_photos.map { |f| rails_blob_path(f, only_path: true) } : [] %>
<% can_album = SiteMembership.allowed?(@site_role, :manage) %>
<div data-controller="kiosk" data-kiosk-idle-value="<%= k['idle'] %>" data-kiosk-saver-value="<%= k['saver'] %>" data-kiosk-motion-value="<%= k['motion'] %>"
     data-kiosk-dim-value="<%= k['dim'] %>" data-kiosk-slides-value="<%= (cameras + photos).to_json %>">
  <div class="ma-kiosk-bar" data-kiosk-target="bar">
    <%= render Ss::IconButtonComponent.new(icon: icon("arrows-expand", "size-5"), label: t("dashboards.kiosk.fullscreen"), data: { action: "kiosk#fullscreen" }) %>
    <%= render Ss::IconButtonComponent.new(icon: icon("moon", "size-5"), label: t("dashboards.kiosk.sleep"), data: { action: "kiosk#sleep" }) %>
    <details class="ma-kiosk-pop relative">
      <summary class="ss-icon-btn" title="<%= t("dashboards.kiosk.settings") %>" aria-label="<%= t("dashboards.kiosk.settings") %>"><%= icon("cog", "size-5") %></summary>
      <div class="ma-kiosk-panel">
      <%= ss_form_with url: kiosk_path, method: :patch, class: "ss-card ma-kiosk-form" do |f| %>
        <p class="font-bold text-ink"><%= t("dashboards.kiosk.this_tablet") %></p>
        <%= f.ss_select :saver, KioskMode::SAVERS.keys.map { |s| [ t("dashboards.kiosk.savers.#{s}"), s ] }, selected: k["saver"], label: t("dashboards.kiosk.saver"), id: "k-saver" %>
        <%= f.ss_number_field :idle, value: k["idle"], min: 1, max: 60, class: "num", label: t("dashboards.kiosk.idle"), id: "k-idle" %>
        <%= f.ss_select :motion, site.points.where(capability: "motion").order(:name).map { |p| [ p.name, p.id ] }, selected: k["motion"], include_blank: t("dashboards.kiosk.touch_only"),
                        label: safe_join([ t("dashboards.kiosk.motion"), " ", tag.span(t("dashboards.ed.optional"), class: "font-normal") ]), id: "k-motion" %>
        <%= f.ss_check_box :dim, label: t("dashboards.kiosk.dim"), checked: k["dim"] ? true : false, id: "k-dim" %>
        <%= f.ss_check_box :clock, label: t("dashboards.kiosk.clock"), checked: k["clock"] ? true : false, id: "k-clock" %>
        <div class="flex flex-wrap gap-2">
          <%= f.ss_submit t("dashboards.save") %>
          <%= link_to t("dashboards.kiosk.exit"), url_for(quiosque: 0), class: "ss-btn ss-btn-ghost" %>
        </div>
      <% end %>
      <%# Ideia 21: álbum do protetor de tela (fotos enviadas; quem edita o painel). %>
      <% if can_album %>
        <% album = dashboard.album %>
        <div class="ss-card ma-kiosk-form">
          <p class="font-bold text-ink"><%= t("dashboards.kiosk.album") %></p>
          <p class="text-xs text-muted"><%= t("dashboards.kiosk.album_hint", max: Dashboard::ALBUM_MAX) %> <%= t("dashboards.kiosk.album_count", count: album.size) %></p>
          <% if album.any? %>
            <ul class="grid grid-cols-4 gap-1.5">
              <% album.each_with_index do |f, i| %>
                <li class="relative"><%= image_tag rails_blob_path(f, only_path: true), alt: "", class: "aspect-square w-full rounded-lg object-cover", loading: "lazy" %>
                  <%= render Ss::ButtonComponent.new(icon: icon("x", "size-4"), href: album_photo_dashboard_path(dashboard, file_id: f.id), method: :delete, variant: :ghost, size: :sm,
                                                     css: "absolute top-0.5 right-0.5", form: { class: "contents" }, title: t("dashboards.kiosk.album_remove", n: i + 1),
                                                     aria: { label: t("dashboards.kiosk.album_remove", n: i + 1) }) %></li>
              <% end %>
            </ul>
          <% end %>
          <%= ss_form_with url: album_dashboard_path(dashboard), method: :post, multipart: true, class: "grid gap-2" do |f| %>
            <%= f.ss_file_field :photos, multiple: true, include_hidden: false, accept: "image/png,image/jpeg,image/webp", label: t("dashboards.kiosk.album_add"), id: "k-album" %>
            <%= f.ss_submit t("dashboards.kiosk.album_add"), variant: :ghost %>
          <% end %>
        </div>
      <% end %>
      </div>
    </details>
  </div>
  <% if k["clock"] %>
    <%# Ideia 21: relógio grande com o painel aceso (o mesmo relógio do protetor). %>
    <p class="ma-kiosk-clock num" aria-hidden="true"><span data-kiosk-target="bigClock">--:--</span><small data-kiosk-target="bigDate"></small></p>
  <% end %>

  <div class="ma-saver <%= 'ma-saver-dim' if k['dim'] %>" data-kiosk-target="saver" hidden role="dialog" aria-modal="true" aria-label="<%= t("dashboards.kiosk.saver_label") %>">
    <div class="ma-saver-slide" data-kiosk-target="slide" aria-hidden="true"></div>
    <div class="ma-saver-info">
      <p class="ma-saver-clock num" data-kiosk-target="clock">--:--</p>
      <p class="ma-saver-date" data-kiosk-target="date"></p>
      <% if k["saver"] == "weather" && (weather || temperature) %>
        <p class="ma-saver-weather"><%= icon("cloud", "size-6") %>
          <% if temperature %><span class="num"><%= point_value_text(temperature) %></span><% end %>
          <% if weather %><span><%= point_value_text(weather) %></span><% end %></p>
      <% end %>
      <p class="ma-saver-hint"><%= site.name %> · <%= t("dashboards.kiosk.touch_back") %></p>
    </div>
  </div>
</div>
