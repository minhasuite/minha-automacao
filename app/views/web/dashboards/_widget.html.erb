<%# locals: (w:, points:, dashboard:, badge: false, live: true, error: nil) -%>
<%# Sem ao vivo (prévia), o que se aperta dentro do quadro vai para a página toda (target _top). %>
<%= turbo_frame_tag "w_#{w['id']}", class: "contents ss-live", target: ("_top" unless live),
                                    data: (live ? { points: w["deps"].join(" "), src: widget_dashboard_path(dashboard, widget_id: w["id"], badge: (1 if badge)) } : {}) do %>
  <% if badge %>
    <% if w["visible"] %><%= render "web/dashboards/widgets/badge", w: w %><% end %>
  <% else %>
    <div class="dw-w <%= dw_screen_class(w) %>" style="<%= dw_span_style(w['span']) %>"<%= " hidden" if !w["visible"] %>>
      <%= render Dashboards::Widgets[w["type"]]&.partial || "web/dashboards/widgets/#{w['type']}", w: w, points: points, dashboard: dashboard, live: live %>
      <% if error %><p class="text-sm font-semibold text-danger mt-1 px-1" role="alert"><%= error %></p><% end %>
    </div>
  <% end %>
<% end %>
