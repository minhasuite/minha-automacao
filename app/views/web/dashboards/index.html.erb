<%= render "web/shared/header", title: "Painéis", subtitle: "#{@site.name} · escolha o que abre no seu Início.", back: site_path(@site) do %>
  <% if can?(:manage) %><%= link_to new_site_dashboard_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %>Novo painel<% end %><% end %>
<% end %>
<%= render "web/sites/tabs", site: @site, current: :dashboards %>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% @dashboards.each_with_index do |d, i| %>
    <% mine = current_user.dashboard_prefs[@site.id] == d.id %>
    <article class="ss-card p-4 flex flex-col gap-3 ss-rise" style="animation-delay: <%= [ i, 6 ].min * 40 %>ms">
      <div class="flex items-start gap-3">
        <span class="grid place-items-center size-11 shrink-0 rounded-xl ss-grad"><%= icon("view-boards") %></span>
        <div class="min-w-0 flex-1">
          <p class="font-bold text-ink truncate"><%= link_to d.name, dashboard_path(d), class: "text-ink no-underline hover:text-accent" %></p>
          <p class="text-xs text-muted"><%= d.kind_label %> · <%= d.auto? ? "automático" : "versão #{d.version}" %><%= " · rascunho" if d.draft? %></p>
        </div>
      </div>
      <div class="flex flex-wrap gap-1.5">
        <% if d.site_default %><span class="ss-badge ss-badge-accent">Padrão do local</span><% end %>
        <% if mine %><span class="ss-badge ss-badge-success">Abre no seu Início</span><% end %>
        <% if d.roles.any? %><span class="ss-badge">Só <%= d.roles.map { |r| SiteMembership.role_label(r).downcase }.to_sentence %></span><% end %>
      </div>
      <div class="flex flex-wrap gap-2 mt-auto">
        <%= link_to "Abrir", dashboard_path(d), class: "ss-btn ss-btn-outline ss-btn-sm" %>
        <% unless mine %><%= button_to "Abrir no meu Início", prefer_dashboard_path(d), class: "ss-btn ss-btn-ghost ss-btn-sm" %><% end %>
        <% if can?(:manage) %><%= link_to edit_dashboard_path(d), class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("pencil", "size-4") %>Editar<% end %><% end %>
      </div>
    </article>
  <% end %>
</div>
