<%= render "web/shared/header", title: t("dashboards.title"), subtitle: t("dashboards.subtitle", site: @site.name), back: site_path(@site) do %>
  <% if can?(:manage) %><%= link_to new_site_dashboard_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("dashboards.new") %><% end %><% end %>
  <% if can?(:manage) %><%= link_to site_dashboard_presets_path(@site), class: "ss-btn ss-btn-outline" do %><%= icon("lightning-bolt", "size-4") %><%= t("dashboards.preset") %><% end %><% end %>
  <% if can?(:manage) %><%= link_to site_dashboard_wizard_path(@site), class: "ss-btn ss-btn-outline" do %><%= icon("sparkles", "size-4") %><%= t("arrange.wizard.button") %><% end %><% end %>
<% end %>
<%= render "web/sites/tabs", site: @site, current: :dashboards %>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% @dashboards.each_with_index do |d, i| %>
    <% mine = current_user.dashboard_prefs[@site.id] == d.id %>
    <article class="ss-card p-4 flex flex-col gap-3 ss-rise" style="animation-delay: <%= [ i, 6 ].min * 40 %>ms">
      <div class="flex items-start gap-3">
        <span class="ss-icon-tile is-grad is-lg"><%= icon("view-boards", "") %></span>
        <div class="min-w-0 flex-1">
          <p class="font-bold text-ink truncate"><%= link_to d.name, dashboard_path(d), class: "text-ink no-underline hover:text-accent" %></p>
          <p class="text-xs text-muted"><%= d.kind_label %> · <%= d.auto? ? t("dashboards.auto") : t("dashboards.version", n: d.version) %><%= " · #{t("dashboards.draft")}" if d.draft? %></p>
        </div>
      </div>
      <div class="flex flex-wrap gap-1.5">
        <% if d.site_default %><span class="ss-badge ss-badge-accent"><%= t("dashboards.site_default") %></span><% end %>
        <% if mine %><span class="ss-badge ss-badge-success"><%= t("dashboards.mine") %></span><% end %>
        <% if d.roles.any? %><span class="ss-badge"><%= t("dashboards.only") %> <%= d.roles.map { |r| SiteMembership.role_label(r).downcase }.to_sentence %></span><% end %>
      </div>
      <div class="flex flex-wrap gap-2 mt-auto">
        <%= link_to t("dashboards.open"), dashboard_path(d), class: "ss-btn ss-btn-outline ss-btn-sm" %>
        <% unless mine %><%= render Ss::ButtonComponent.new(label: t("dashboards.prefer"), href: prefer_dashboard_path(d), method: :post, variant: :ghost, size: :sm) %><% end %>
        <% if can?(:manage) %><%= link_to edit_dashboard_path(d), class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("pencil", "size-4") %><%= t("dashboards.edit") %><% end %><% end %>
      </div>
    </article>
  <% end %>
</div>
