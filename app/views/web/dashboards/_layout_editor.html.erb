<%# locals: (dashboard:, view:, live:) -%>
<%# Layout ao vivo (uiweb): os widgets de verdade do rascunho, arrastáveis
    (ordem e troca de seção) e com alça de largura por tela. Cada soltar salva
    no rascunho; os formulários abaixo continuam valendo (teclado). %>
<% resolved_view = live["views"].find { |v| v["id"] == view["id"] } || { "sections" => [] } %>
<% points = live["points"] %>
<section class="ss-card ss-card-pad dw-ed" aria-labelledby="ed-title" data-controller="layout-editor" data-screen="desktop"
         data-layout-editor-url-value="<%= draft_dashboard_path(dashboard) %>" data-layout-editor-view-value="<%= view['id'] %>"
         data-layout-editor-saved-value="<%= t("dashboards.le.saved") %>" data-layout-editor-failed-value="<%= t("dashboards.le.failed") %>">
  <div class="flex flex-wrap items-center gap-3">
    <div class="min-w-0 flex-1">
      <h2 id="ed-title" class="flex items-center gap-2"><%= icon("view-boards", "size-5 text-accent") %><%= t("dashboards.le.title") %></h2>
      <p class="text-sm text-muted mt-0.5"><%= t("dashboards.le.hint") %></p>
    </div>
    <div class="ss-seg w-full sm:w-96" role="group" aria-label="<%= t("dashboards.le.screen") %>">
      <% { "mobile" => "device-mobile", "tablet" => "device-mobile", "desktop" => "desktop-computer" }.each do |screen, ico| %><% label = t("dashboards.screens.#{screen}") %>
        <button type="button" class="gap-1.5 text-sm font-bold" aria-pressed="<%= screen == 'desktop' %>" data-action="layout-editor#screen" data-layout-editor-screen-param="<%= screen %>" data-layout-editor-target="screenButton">
          <%= icon(ico, "size-4 #{'rotate-90' if screen == 'tablet'}") %><span class="max-sm:sr-only"><%= label %></span>
        </button>
      <% end %>
    </div>
  </div>
  <p id="ed-status" data-turbo-permanent class="text-xs font-semibold mt-2 min-h-4" role="status" aria-live="polite" data-layout-editor-target="status"></p>
  <div class="dw-ed-frame mt-2" data-layout-editor-target="frame">
    <% if resolved_view["sections"].empty? %>
      <%= render "web/shared/empty_art", art: "board", title: t("dashboards.le.empty"), text: t("dashboards.le.empty_hint") %>
    <% end %>
    <div class="dw-grid dw-sections" data-layout-editor-target="sections">
      <% resolved_view["sections"].each do |s| %>
        <section class="dw-w dw-ed-sec" data-id="<%= s['id'] %>" data-kind="section" style="<%= dw_span_style(s['span'], DashboardsHelper::SECTION_SPAN) %>" aria-label="<%= t("dashboards.ed.section_label", name: s['title']) %>">
          <div class="dw-ed-bar">
            <span class="dw-ed-grip dw-ed-grip-s" title="<%= t("dashboards.le.drag_section") %>" aria-hidden="true"><%= icon("dots-horizontal", "size-4") %></span>
            <span class="ss-section flex-1 truncate"><%= s["title"].presence || t("dashboards.ed.untitled") %></span>
            <span class="dw-ed-cols num" data-cols aria-hidden="true"></span>
            <span class="dw-ed-resize" title="<%= t("dashboards.le.resize") %>" aria-hidden="true"></span>
          </div>
          <div class="dw-grid dw-ed-drop" data-section="<%= s['id'] %>" data-layout-editor-target="widgets">
            <% s["widgets"].each do |w| %>
              <div class="dw-w dw-ed-w <%= 'dw-ed-hidden' unless w['visible'] %>" data-id="<%= w['id'] %>" data-kind="widget" style="<%= dw_span_style(w['span']) %>">
                <div class="dw-ed-live" inert><%= render Dashboards::Widgets[w["type"]]&.partial || "web/dashboards/widgets/#{w['type']}", w: w, points: points, dashboard: dashboard, live: false %></div>
                <div class="dw-ed-chrome">
                  <span class="dw-ed-grip" title="<%= t("dashboards.le.drag") %>" aria-hidden="true"><%= icon("dots-horizontal", "size-4") %></span>
                  <a href="#<%= w['id'] %>" class="dw-ed-edit" title="<%= t("dashboards.le.edit_widget") %>"><%= icon("pencil", "size-3.5") %><span class="sr-only"><%= t("dashboards.edit") %> <%= w["label"].presence || Dashboards::Schema.labels[w["type"]] %></span></a>
                  <span class="dw-ed-cols num" data-cols aria-hidden="true"></span>
                </div>
                <span class="dw-ed-resize" title="<%= t("dashboards.le.resize") %>" aria-hidden="true"></span>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</section>
