<%# locals: (f:, p:, w:, dashboard:, live:) -%>
<%# Slider da gem: trilha de brilho/temperatura de cor, envia ao soltar; sem comando, o mesmo slider travado mostra o nível. %>
<% id = "f_#{w['id']}_#{f['type']}" %>
<% track = { "temp" => :kelvin }[f["gradient"]] || (:brightness if f["type"] == "brightness") %>
<% value = f["value"].is_a?(Numeric) ? dw_plain(f["value"]) : dw_plain(f["min"] || 0) %>
<% range = Ss::RangeComponent.new(name: "value", label: f["label"], value: value, min: dw_plain(f["min"] || 0), max: dw_plain(f["max"] || 100), step: dw_plain(f["step"] || 1),
                                  format: dw_range_format(f["unit"]), track: track, submit: :release, id: id, disabled: !(p["can_command"] && p["quality"] == "good"),
                                  tone: (:heat if track == :brightness && dw_light?(p))) %>
<div class="dw-feat">
  <% if p["can_command"] && p["quality"] == "good" %>
    <%= dw_command_form(p, f["command"], w: w, dashboard: dashboard, live: live) do %><%= render range %><% end %>
  <% else %>
    <%= render range %>
  <% end %>
</div>
