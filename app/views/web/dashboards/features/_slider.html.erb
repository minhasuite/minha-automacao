<%# locals: (f:, p:, w:, dashboard:, live:) -%>
<% id = "f_#{w['id']}_#{f['type']}" %>
<div class="dw-feat">
  <div class="dw-feat-row"><label class="dw-feat-label" for="<%= id %>"><%= icon(f["icon"], "size-4") %><%= f["label"] %></label>
    <output class="dw-feat-value num" for="<%= id %>"><%= f["value"].is_a?(Numeric) ? dw_number(f["value"], f["unit"]) : "—" %></output></div>
  <% if p["can_command"] && p["quality"] == "good" %>
    <%= dw_command_form(p, f["command"], w: w, dashboard: dashboard, live: live) do %>
      <input type="range" id="<%= id %>" name="value" class="dw-range <%= "dw-range-#{f['gradient']}" if f["gradient"] %>" data-autosubmit
             min="<%= f['min'] %>" max="<%= f['max'] %>" step="<%= f['step'] %>" value="<%= f['value'] %>">
    <% end %>
  <% else %>
    <div class="dw-feat-bar" aria-hidden="true"><span style="--r: <%= f["value"].is_a?(Numeric) && f["max"].to_f > f["min"].to_f ? ((f["value"] - f["min"].to_f) / (f["max"].to_f - f["min"].to_f)).clamp(0, 1).round(3) : 0 %>"></span></div>
  <% end %>
</div>
