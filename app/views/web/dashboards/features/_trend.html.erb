<%# locals: (f:, p:, w:, dashboard:, live:) -%>
<div class="dw-feat">
  <div class="dw-feat-row"><span class="dw-feat-label"><%= icon(f["icon"], "size-4") %><%= f["label"] %></span>
    <% if f["min"] %><span class="dw-feat-value num"><%= dw_number(f["min"]) %>–<%= dw_number(f["max"], f["unit"]) %></span><% end %></div>
  <% values = Array(f["values"]).grep(Numeric) %>
  <% if values.size > 1 %>
    <div role="img" aria-label="<%= t("dashboards.feat.trend_x", name: f["label"]) %>"><%= ss_sparkline(values, height: 40) %></div>
  <% else %>
    <p class="text-xs text-muted"><%= t("dashboards.feat.no_history") %></p>
  <% end %>
</div>
