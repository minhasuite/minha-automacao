<%# locals: (f:, p:, w:, dashboard:, live:) -%>
<%# Opções do ponto (modo, velocidade): chips da gem; o atual fica marcado (aria-pressed; sem permissão, aria-current). %>
<% can = p["can_command"] && p["quality"] == "good" %>
<div class="grid min-w-0 gap-1.5">
  <span class="ss-label mb-0 inline-flex min-w-0 items-center gap-1.5"><%= icon(f["icon"], "size-4") %><%= f["label"] %></span>
  <div class="ss-chips" role="group" aria-label="<%= f["label"] %>">
    <% Array(f["options"]).each do |o| %>
      <% on = o.to_s == f["value"].to_s %>
      <% if can %>
        <%= dw_command_button(p, f["command"], value: o, w: w, dashboard: dashboard, live: live, class: "ss-chip", form_class: "contents", "aria-pressed": on.to_s) do %><%= o %><% end %>
      <% else %>
        <span class="ss-chip" aria-disabled="true" aria-current="<%= on %>"><%= o %></span>
      <% end %>
    <% end %>
  </div>
</div>
