<%# locals: (f:, p:, w:, dashboard:, live:) -%>
<div class="dw-feat dw-feat-row">
  <span class="dw-feat-label"><%= icon(f["icon"], "size-4") %><%= f["label"] %></span>
  <% if p["can_command"] && p["quality"] == "good" %>
    <%= dw_command_button(p, "toggle", w: w, dashboard: dashboard, live: live, class: "ss-switch", form_class: "contents", "aria-pressed": p["on"].to_s,
                          "aria-label": t(p["on"] ? "dashboards.w.turn_off_x" : "dashboards.w.turn_on_x", name: f["label"])) do %><% end %>
  <% else %>
    <span class="dw-feat-value"><%= p["text"] %></span>
  <% end %>
</div>
