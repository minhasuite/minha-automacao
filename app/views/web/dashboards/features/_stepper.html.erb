<%# locals: (f:, p:, w:, dashboard:, live:) -%>
<%# Campo −/+ da gem; vários toques seguidos viram um comando (form[data-dw-autosubmit]). %>
<% can = p["can_command"] && p["quality"] == "good" %>
<% stepper = Ss::StepperInputComponent.new(name: "value", value: (dw_plain(f["value"]) if f["value"].is_a?(Numeric)), min: f["min"], max: f["max"], step: f["step"] || 1, unit: f["unit"],
                                           label: f["label"], disabled: !can, id: "f_#{w['id']}_#{f['type']}", 
                                           less_label: t("dashboards.feat.less", name: f["label"]), more_label: t("dashboards.feat.more", name: f["label"])) %>
<div class="grid min-w-0 gap-1.5">
  <% if can %>
    <%= dw_command_form(p, f["command"], w: w, dashboard: dashboard, live: live, data: { dw_autosubmit: true }, css: nil) do %><%= render stepper %><% end %>
  <% else %>
    <%= render stepper %>
  <% end %>
</div>
