<%# locals: (f:, p:, w:, dashboard:, live:) -%>
<%# Botões do tile (cores, cenas do aparelho): chips da gem que alternam (aria-pressed); cor = chip redondo com a amostra. %>
<% can = p["can_command"] && p["quality"] == "good" %>
<div class="grid min-w-0 gap-1.5">
  <span class="sr-only"><%= f["label"] %></span>
  <div class="ss-chips" role="group" aria-label="<%= f["label"] %>">
    <% Array(f["buttons"]).each do |b| %>
      <% label = b["label"].to_s %>
      <% inner = capture do %><% if b["swatch"] %><i class="ss-chip-swatch" style="--c: <%= b['swatch'] if b['swatch'].to_s.match?(/\A#\h{6}\z/) %>"></i><% elsif b["icon"] %><%= icon(b["icon"], "size-4") %><% end %><span class="<%= 'sr-only' if b['swatch'] %>"><%= label %></span><% end %>
      <% if can %>
        <%= dw_command_button(p, b["command"], value: b["value"], w: w, dashboard: dashboard, live: live, class: "ss-chip #{'is-icon' if b['swatch']}", form_class: "contents",
                              "aria-pressed": (b["active"] ? "true" : "false"), title: label) do %><%= inner %><% end %>
      <% else %>
        <span class="ss-chip <%= 'is-icon' if b['swatch'] %>" aria-disabled="true" title="<%= label %>"><%= inner %></span>
      <% end %>
    <% end %>
  </div>
</div>
