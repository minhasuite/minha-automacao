<%# locals: (dashboard:, target:, theme:, view_id:, inherit: false) -%>
<%# Galeria de temas (uiweb, registro Dashboards::Themes): do painel ou de uma visão. %>
<% theme ||= {} %>
<% uid = target.presence || "painel" %>
<%= ss_form_with url: draft_dashboard_path(dashboard), method: :patch, multipart: true, class: "grid gap-3" do |f| %>
  <%= hidden_field_tag :op, "theme", id: nil %><%= hidden_field_tag :target, target, id: nil %><%= hidden_field_tag :view_id, view_id, id: nil %>
  <fieldset>
    <legend class="ss-label"><%= t("dashboards.theme.theme") %> <%= tag.span(t("dashboards.theme.empty_inherit"), class: "font-normal") if inherit %></legend>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(6.5rem,1fr))] gap-2">
      <% if inherit %>
        <%= f.ss_swatch_radio "theme[key]", "", label: t("dashboards.theme.inherit"), block: true, checked: theme["key"].blank?, id: "th-#{uid}-none" do %><span class="ss-icon-tile is-muted is-sm"><%= icon("duplicate", "") %></span><span class="ss-swatch-name"><%= t("dashboards.theme.inherit") %></span><% end %>
      <% end %>
      <% Dashboards::Themes.all.each do |t| %>
        <%= f.ss_swatch_radio "theme[key]", t.key, label: t.label, style: dw_swatch_style(t), block: true, checked: theme["key"] == t.key || (!inherit && theme["key"].blank? && t == Dashboards::Themes::Lista), id: "th-#{uid}-#{t.key}" %>
      <% end %>
    </div>
  </fieldset>
  <div class="grid gap-3 sm:grid-cols-2">
    <%= f.ss_select "theme[night]", Dashboards::Themes.all.map { |t| [ t.label, t.key ] }, label: t("dashboards.theme.night"), include_blank: t("dashboards.theme.same_day"), selected: theme["night"], id: "thn-#{uid}" %>
    <%= f.ss_select "theme[glass]", { t("dashboards.theme.as_theme") => "", t("dashboards.theme.glass") => "1", t("dashboards.theme.solid") => "0" }, label: t("dashboards.theme.cards"), selected: theme.key?("glass") ? (theme["glass"] ? "1" : "0") : "", id: "thg-#{uid}" %>
    <%= f.ss_select "theme[dark]", { t("dashboards.theme.mode_person") => "", t("dashboards.theme.mode_dark") => "1" }, label: t("dashboards.theme.mode"), selected: theme["dark"] ? "1" : "", id: "thd-#{uid}" %>
    <div>
      <%= f.ss_file_field "theme[upload]", label: safe_join([ t("dashboards.theme.wallpaper"), " ", tag.span(t("dashboards.theme.formats"), class: "font-normal") ]), accept: "image/png,image/jpeg,image/webp", id: "thu-#{uid}" %>
      <%= hidden_field_tag "theme[image]", theme["image"], id: nil %>
      <% if theme["image"].present? %><%= f.ss_check_box "theme[remove_image]", label: t("dashboards.theme.remove_wallpaper"), unchecked_value: nil, checked: false, id: "thr-#{uid}", wrapper_class: "mt-1 text-sm" %><% end %></div>
    <div><%= render Ss::RangeComponent.new(name: "theme[blur]", label: t("dashboards.theme.blur"), value: (theme["blur"] || 0).to_i, min: 0, max: 40, format: "%s px", id: "thb-#{uid}") %></div>
  </div>
  <%# Beleza (ideia 15 e P2.4): noite pelo sol ou por horário, fundo por hora do dia e escurecer à noite. %>
  <div class="grid gap-3 grid-cols-[repeat(auto-fill,minmax(9rem,1fr))]">
    <%= f.ss_select "theme[night_by]", { t("dashboards.theme.night_sun") => "sun", t("dashboards.theme.night_window") => "window" }, label: t("dashboards.theme.night_by"), selected: theme["night_by"] || "sun", id: "thnb-#{uid}" %>
    <%= f.ss_time_field "theme[night_from]", label: t("dashboards.theme.night_from"), value: theme["night_from"] || Dashboards::Themes::WINDOW[0], class: "num", id: "thnf-#{uid}" %>
    <%= f.ss_time_field "theme[night_to]", label: t("dashboards.theme.night_to"), value: theme["night_to"] || Dashboards::Themes::WINDOW[1], class: "num", id: "thnt-#{uid}" %>
  </div>
  <p class="text-xs text-muted"><%= t("dashboards.theme.night_hint") %></p>
  <div><%= render Ss::RangeComponent.new(name: "theme[dim]", label: t("dashboards.theme.dim"), value: theme["dim"].to_i, min: 0, max: 80, step: 5, format: "%s%%", id: "thdm-#{uid}") %></div>
  <%= ss_fieldset legend: t("dashboards.theme.backgrounds"), help: t("dashboards.theme.backgrounds_hint") do %>
    <% bgs = Array(theme["backgrounds"]).select { |b| b.is_a?(Hash) } %>
    <% (bgs + [ {} ] * [ Dashboards::Themes::MAX_BACKGROUNDS - bgs.size, 2 ].min).each_with_index do |b, i| %>
      <% kind = b["from"].in?(Dashboards::Themes::SUN_EVENTS) ? b["from"] : "time" %>
      <% style = b["image"].present? ? "image" : (b["color2"].present? ? "gradient" : "color") %>
      <% n = "theme[backgrounds][#{i}]" %>
      <fieldset class="grid gap-2 grid-cols-[repeat(auto-fill,minmax(8rem,1fr))] items-end border-t border-line pt-2">
        <legend class="sr-only"><%= t("dashboards.theme.bg_n", n: i + 1) %></legend>
        <%= f.ss_select "#{n}[kind]", { t("dashboards.theme.bg_at_time") => "time", t("dashboards.theme.bg_sunrise") => "sunrise", t("dashboards.theme.bg_sunset") => "sunset" }, label: t("dashboards.theme.bg_from"), selected: kind, id: "thbk-#{uid}-#{i}" %>
        <%= f.ss_time_field "#{n}[time]", label: t("dashboards.theme.bg_time"), value: (b["from"] if kind == "time"), class: "num", id: "thbt-#{uid}-#{i}" %>
        <%= f.ss_select "#{n}[style]", { t("dashboards.theme.bg_color") => "color", t("dashboards.theme.bg_gradient") => "gradient", t("dashboards.theme.bg_photo") => "image" }, label: t("dashboards.theme.bg_style"), selected: style, id: "thbs-#{uid}-#{i}" %>
        <%= f.ss_color_field "#{n}[color]", label: t("dashboards.theme.bg_color1"), value: b["color"] || Dashboards::Themes::BG_COLORS[0], id: "thbc-#{uid}-#{i}" %>
        <%= f.ss_color_field "#{n}[color2]", label: t("dashboards.theme.bg_color2"), value: b["color2"] || Dashboards::Themes::BG_COLORS[1], id: "thbd-#{uid}-#{i}" %>
        <div class="col-span-full">
          <%= f.ss_file_field "#{n}[upload]", label: safe_join([ t("dashboards.theme.bg_photo"), " ", tag.span(t("dashboards.theme.formats"), class: "font-normal") ]), accept: "image/png,image/jpeg,image/webp", id: "thbu-#{uid}-#{i}" %>
          <%= hidden_field_tag "#{n}[image]", b["image"], id: nil %>
          <%= hidden_field_tag "#{n}[used]", b.present? ? "1" : "0", id: nil %></div>
        <% if b.present? %><%= f.ss_check_box "#{n}[remove]", label: t("dashboards.theme.bg_remove"), unchecked_value: nil, checked: false, id: "thbr-#{uid}-#{i}", wrapper_class: "text-sm col-span-full" %><% end %>
      </fieldset>
    <% end %>
  <% end %>
  <div><%= f.ss_submit t("dashboards.theme.save"), variant: :ghost %></div>
<% end %>
