<%# locals: (dashboard:, target:, theme:, view_id:, inherit: false) -%>
<%# Galeria de temas (uiweb, registro Dashboards::Themes): do painel ou de uma visão. %>
<% theme ||= {} %>
<% uid = target.presence || "painel" %>
<%= form_with url: draft_dashboard_path(dashboard), method: :patch, multipart: true, class: "grid gap-3" do %>
  <%= hidden_field_tag :op, "theme", id: nil %><%= hidden_field_tag :target, target, id: nil %><%= hidden_field_tag :view_id, view_id, id: nil %>
  <fieldset>
    <legend class="ss-label">Tema <%= tag.span("(vazio = o do painel)", class: "font-normal") if inherit %></legend>
    <div class="dw-themes">
      <% if inherit %>
        <label class="dw-theme-opt"><%= radio_button_tag "theme[key]", "", theme["key"].blank?, id: "th-#{uid}-none" %><span class="dw-theme-swatch dw-theme-inherit"><%= icon("duplicate", "size-4") %></span><span class="dw-theme-name">Do painel</span></label>
      <% end %>
      <% Dashboards::Themes.plugins.each do |t| %>
        <label class="dw-theme-opt"><%= radio_button_tag "theme[key]", t.key, theme["key"] == t.key || (!inherit && theme["key"].blank? && t == Dashboards::Themes::Lista), id: "th-#{uid}-#{t.key}" %>
          <span class="dw-theme-swatch" style="<%= t.css %>"><i></i><i></i><i></i></span><span class="dw-theme-name"><%= t.label %></span></label>
      <% end %>
    </div>
  </fieldset>
  <div class="grid gap-3 sm:grid-cols-2">
    <div><label class="ss-label" for="thn-<%= uid %>">À noite (18h às 6h)</label>
      <%= select_tag "theme[night]", options_for_select(Dashboards::Themes.plugins.map { |t| [ t.label, t.key ] }, theme["night"]), include_blank: "O mesmo do dia", class: "ss-input", id: "thn-#{uid}" %></div>
    <div><label class="ss-label" for="thg-<%= uid %>">Cartões</label>
      <%= select_tag "theme[glass]", options_for_select({ "Como o tema" => "", "Vidro (fosco)" => "1", "Sólidos" => "0" }, theme.key?("glass") ? (theme["glass"] ? "1" : "0") : ""), class: "ss-input", id: "thg-#{uid}" %></div>
    <div><label class="ss-label" for="thu-<%= uid %>">Papel de parede <span class="font-normal">(PNG, JPG ou WebP)</span></label>
      <%= file_field_tag "theme[upload]", accept: "image/png,image/jpeg,image/webp", class: "ss-input", id: "thu-#{uid}" %>
      <%= hidden_field_tag "theme[image]", theme["image"], id: nil %>
      <% if theme["image"].present? %><label class="ss-check mt-1 text-sm"><%= check_box_tag "theme[remove_image]", "1", false, id: "thr-#{uid}" %>Tirar o papel de parede</label><% end %></div>
    <div><label class="ss-label" for="thb-<%= uid %>">Desfoque do papel de parede</label>
      <%= range_field_tag "theme[blur]", theme["blur"] || 0, min: 0, max: 40, class: "dw-range mt-3", id: "thb-#{uid}" %></div>
  </div>
  <div><%= submit_tag "Salvar tema", class: "ss-btn ss-btn-ghost" %></div>
<% end %>
