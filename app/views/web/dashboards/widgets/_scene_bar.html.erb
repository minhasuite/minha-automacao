<%# locals: (w:, points:, dashboard:, live:) -%>
<%# Cenas em chips da gem (o SsChipBar + SsFilterChip do app); sem permissão, o chip fica travado.
    O chip nunca passa da largura do widget (a gem quebra a linha mas não corta o chip: nome comprido
    vazava por cima do card vizinho): max-w-full no chip e o nome com reticências. %>
<% if w["data"]["scenes"].empty? %>
  <%= render Ss::NoteComponent.new(text: t("dashboards.w.no_scenes"), icon: icon("sparkles", "")) %>
<% else %>
  <div class="ss-chips" role="group" aria-label="<%= w["label"].presence || t("dashboards.w.scenes_label") %>">
    <% w["data"]["scenes"].each do |s| %>
      <% if s["can_activate"] %>
        <% confirm = s["confirm"] ? { turbo_confirm: t("dashboards.w.scene_confirm", name: s['name']), turbo_confirm_button: t("dashboards.w.activate") } : {} %>
        <%= button_to activate_scene_path(s["id"]), params: { back: dashboard_path(dashboard) }, class: "ss-chip max-w-full", title: s["name"], form_class: "contents", form: { data: { turbo_frame: "_top", **confirm } } do %><%= icon(s["icon"].presence || "sparkles", "size-4 shrink-0") %><span class="min-w-0 truncate"><%= s["name"] %></span><% end %>
      <% else %>
        <span class="ss-chip max-w-full" aria-disabled="true" title="<%= t("dashboards.w.scene_role") %>"><%= icon(s["icon"].presence || "sparkles", "size-4 shrink-0") %><span class="min-w-0 truncate"><%= s["name"] %></span></span>
      <% end %>
    <% end %>
  </div>
<% end %>
