<%# locals: (w:, points:, dashboard:, live:) -%>
<% d = w["data"] %>
<% p = points[Array(d["point_ids"]).first] %>
<% c = d["current"] || {} %>
<% if p.nil? %>
  <div class="ss-card ss-card-pad h-full">
    <%= render Ss::CardHeaderComponent.new(title: w["label"].presence || t("dashboards.w.weather"), icon: icon("cloud", "")) %>
    <%= render Ss::NoteComponent.new(text: t("dashboards.w.pick_weather"), icon: icon("cloud", ""), css: "mt-2") %>
  </div>
<% else %>
  <%# Card de clima da gem: agora (sensação e chance de chuva), umidade, vento e a faixa de previsão (por hora ou por dia). %>
  <% fresh = p["quality"] == "good" %>
  <% today = Array(d["forecast"]).find { |f| f["date"] && Date.parse(f["date"]) == Date.current } %>
  <% forecast = Array(d["forecast"]).filter_map do |f|
       temp = (f["temperature"] || f["temperature_max"])&.round
       next unless temp

       date = f["date"] && Date.parse(f["date"])
       when_text = f["time"] ? Time.zone.parse(f["time"]).strftime("%Hh") : (date == Date.current ? t("dashboards.w.wx.today") : l(date, format: "%a"))
       { label: when_text, condition: dw_weather_condition(f["condition"]), temp: temp, min: f["temperature_min"]&.round,
         precip: (f["precipitation_probability"] if f["precipitation_probability"].to_i.positive?) }.compact
     end %>
  <%= render Ss::WeatherCardComponent.new(temperature: c["temperature"]&.round, condition: dw_weather_condition(c["condition"]),
                                          condition_text: fresh ? c["condition_text"] : t("dashboards.w.no_recent"), location: dw_label(w, p),
                                          min: today && today["temperature_min"]&.round, max: today && today["temperature_max"]&.round,
                                          humidity: c["humidity"]&.round, wind: c["wind_speed"]&.round, forecast: forecast,
                                          feels_like: (c["apparent_temperature"]&.round if fresh), rain_chance: (c["precipitation_probability"] if fresh && c["precipitation_probability"].to_i.positive?),
                                          css: "h-full") %>
<% end %>
