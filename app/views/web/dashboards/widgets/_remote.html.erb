<%# locals: (w:, points:, dashboard:, live:) -%>
<% d = w["data"] %>
<% p = points[Array(d["point_ids"]).first] %>
<% if p.nil? %>
  <%= render Ss::DeviceTileComponent.new(name: w["label"].presence || t("dashboards.w.remote"), status: :unavailable, icon: icon("status-online").to_s,
                                         unavailable_label: t("dashboards.w.pick_remote"), css: "h-full") %>
<% else %>
  <% off_line = p["quality"].in?(%w[unavailable error]) %>
  <% can = p["can_command"] && !off_line %>
  <div class="ss-card ss-card-pad h-full">
    <%= render Ss::CardHeaderComponent.new(title: link_to(dw_label(w, p), point_path(p["id"]), data: { turbo_frame: "_top" }),
                                           subtitle: off_line ? t("dashboards.w.offline") : (d["buttons"].empty? ? t("dashboards.w.no_buttons") : t("dashboards.w.buttons", count: d['buttons'].size)),
                                           icon: icon(w["icon"].presence || "status-online", ""), tone: (off_line ? :danger : :accent)) %>
    <% pad = dw_remote_pad(d["buttons"]) %>
    <% if pad %>
      <%# Controle com cruz aprendida: Ss::DPadComponent (setas do teclado, Enter e Esc também); cada tecla manda
          "send" com o nome do botão aprendido (keys:), os outros botões numa linha a mais. %>
      <%= render Ss::DPadComponent.new(url: command_point_path(p["id"], **dw_command_params("send", w: w, dashboard: dashboard, live: live)), param: :value,
                                       disabled: !can, labels: { remote: t("dashboards.w.buttons_x", name: p["name"]) }, css: "mx-auto mt-3", **pad) %>
    <% elsif d["buttons"].any? %>
      <div class="mt-3 grid grid-cols-[repeat(auto-fill,minmax(6.5rem,1fr))] gap-2" role="group" aria-label="<%= t("dashboards.w.buttons_x", name: p['name']) %>">
        <% d["buttons"].each do |name| %>
          <%= dw_command_button(p, "send", value: name, w: w, dashboard: dashboard, live: live, class: "ss-btn ss-btn-ghost w-full", form_class: "contents", disabled: !can) do %><span class="truncate"><%= name %></span><% end %>
        <% end %>
      </div>
    <% end %>
    <% if can && d["learn"] %>
      <details class="mt-3">
        <summary class="text-sm font-semibold text-accent cursor-pointer"><%= t("dashboards.w.learn_button") %></summary>
        <%= dw_command_form(p, "learn", w: w, dashboard: dashboard, live: live) do %>
          <p class="text-xs text-muted mb-2"><%= t("dashboards.w.learn_hint") %></p>
          <div class="flex gap-2"><%= ss_fields(nil) { |f| f.ss_text_field :value, label: t("dashboards.w.button_name"), hide_label: true, id: "rl-#{w['id']}", maxlength: 60,
                                                                   placeholder: t("dashboards.w.button_placeholder"), required: true, wrapper_class: "flex-1 min-w-0" } %>
            <%= render Ss::ButtonComponent.new(label: t("dashboards.w.learn"), type: :submit, variant: :outline) %></div>
        <% end %>
      </details>
    <% end %>
  </div>
<% end %>
