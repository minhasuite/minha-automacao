<%# locals: (w:, points:, dashboard:, live:) -%>
<% p = points[w["data"]["point_ids"].first] %>
<% if p.nil? %>
  <div class="dw-card dw-tile dw-unavailable"><span class="dw-ico"><%= icon("video-camera") %></span><span><span class="dw-name"><%= w["label"].presence || "Câmera removida" %></span><span class="dw-state">Ponto não encontrado</span></span></div>
<% else %>
  <div class="dw-card dw-camera" data-controller="camera" data-camera-snapshot-value="<%= camera_snapshot_path(p['id']) %>"
       data-camera-webrtc-value="<%= camera_webrtc_path(p['id']) %>" data-camera-interval-value="<%= w['snapshot_interval'] || 10 %>">
    <div class="flex items-center gap-2 mb-2">
      <span class="dw-ico dw-ico-sm"><%= icon("video-camera") %></span>
      <%= link_to dw_label(w, p), point_path(p["id"]), class: "dw-name flex-1 min-w-0 no-underline", data: { turbo_frame: "_top" } %>
      <% unless w["live"] == false %>
        <button type="button" class="dw-camera-live" data-camera-target="liveButton" data-action="camera#toggle" aria-pressed="false">Ao vivo</button>
      <% end %>
    </div>
    <div class="dw-camera-view">
      <img data-camera-target="img" alt="Imagem de <%= dw_label(w, p) %>" hidden>
      <video data-camera-target="video" muted playsinline autoplay hidden aria-label="Ao vivo de <%= dw_label(w, p) %>"></video>
      <span class="dw-camera-status" data-camera-target="status" role="status">Carregando…</span>
    </div>
  </div>
<% end %>
