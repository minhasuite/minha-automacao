<%# locals: (w:, points:, dashboard:, live:) -%>
<%# Agenda (ondaB2 B10): hoje no Ss::AgendaComponent (blocos pela hora, linha do agora, dia inteiro em cima) e
    os próximos dias no Ss::AgendaListComponent, com a faixa da semana; uma cor por agenda. %>
<% d = w["data"] %>
<% zone = ActiveSupport::TimeZone[dashboard.site.timezone] || Time.zone %>
<% now = Time.current.in_time_zone(zone) %>
<% days = Array(d["days"]) %>
<% today = days.find { |day| day["date"] == now.to_date.iso8601 } %>
<% many = Array(d["calendars"]).size > 1 %>
<% tone = ->(e) { %i[accent warn success info danger accent][e["color"].to_i % 6] } %>
<% sub = ->(e) { [ e["location"], (e["calendar"] if many) ].compact.join(" · ").presence } %>
<% timed = Array(today && today["events"]).reject { |e| e["all_day"] }.map do |e|
     { title: e["summary"], sub: sub.(e), starts_at: [ Time.zone.parse(e["start"]).in_time_zone(zone), now.beginning_of_day ].max,
       ends_at: Time.zone.parse(e["end"]).in_time_zone(zone), tone: tone.(e) }
   end %>
<div class="ss-card ss-card-pad h-full">
  <%= render Ss::CardHeaderComponent.new(title: w["label"].presence || Dashboards::Widgets::CalendarWidget.label, icon: icon("calendar", "")) %>
  <% if timed.any? %>
    <% all_day = today["events"].select { |e| e["all_day"] }.map { |e| { title: e["summary"], all_day: true, starts_at: now.to_date, tone: tone.(e) } } %>
    <% from = timed.map { |e| e[:starts_at].hour }.min.clamp(0, 23) %>
    <% to = timed.map { |e| e[:ends_at].to_date > now.to_date ? 24 : e[:ends_at].hour + (e[:ends_at].min.positive? ? 1 : 0) }.max.clamp(from + 1, 24) %>
    <%= render Ss::AgendaComponent.new(events: timed + all_day, days: [ now.to_date ], from: from, to: to, now: now, hour_height: 40, label: today["label"], css: "mt-3") %>
  <% end %>
  <% if days.empty? %>
    <%= render Ss::NoteComponent.new(text: d["empty"], icon: icon("calendar", ""), css: "mt-3") %>
    <% if d["connect"] %><%= link_to d["connect"], new_site_integration_path(dashboard.site_id, tipo: "calendar"), class: "ss-btn ss-btn-ghost ss-btn-sm mt-2", data: { turbo_frame: "_top" } %><% end %>
  <% else %>
    <% rest = (timed.any? ? days - [ today ] : days).map do |day|
         { date: Date.iso8601(day["date"]), label: day["label"],
           events: day["events"].map { |e| hm = ->(k) { Time.zone.parse(e[k].to_s)&.in_time_zone(zone)&.strftime("%H:%M") }
                                           { time: (hm.("start") unless e["all_day"]), end: (hm.("end") unless e["all_day"]), all_day: e["all_day"],
                                             title: e["summary"], detail: sub.(e), tone: tone.(e) } } }
       end %>
    <%= render Ss::AgendaListComponent.new(days: rest, week_strip: true, selected: now.to_date, now: now,
                                           label: w["label"].presence || Dashboards::Widgets::CalendarWidget.label, css: "mt-3 max-h-[26rem] overflow-y-auto") %>
  <% end %>
</div>
