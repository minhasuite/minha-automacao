<%# locals: (w:) -%>
<% d = w["data"] %>
<%# Selo do topo do painel: o Ss::BadgeComponent da gem (o SsBadge do app), pequeno e fino como as pílulas dos cartões
    de área e da câmera, para todo selo igual (antes o número saía grande em DM Mono). Sem valor (ponto sem leitura ou
    atributo que não veio) não aparece: "—" no topo não diz nada. O texto pela contagem vem pronto do servidor
    (`caption`, dos `labels` {zero, one, other}; P1.4); sem `labels`, "número rótulo". Com consulta, tocar abre a
    lista dos pontos que entram no número (ideia 14). %>
<% unless d["value"].nil? || d["text"].to_s.strip.in?(["", "—", "-"]) %>
  <% text = d["caption"].presence || [ d["text"], w["label"].presence ].compact.join(" ") %>
  <%= render Ss::BadgeComponent.new(label: text, icon: (icon(w["icon"], "") if w["icon"].present?), href: d["drill_url"],
                                    link_data: ({ turbo_frame: "_top" } if d["drill_url"]), title: (t("dashboards.drill.open", what: text) if d["drill_url"])) %>
<% end %>
