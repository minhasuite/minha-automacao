<%# locals: (w:, points:, dashboard:, live:) -%>
<% p = points[w["data"]["point_ids"].first] %>
<% if p.nil? %>
  <div class="dw-card dw-tile dw-unavailable"><span class="dw-ico"><%= icon("question-mark-circle") %></span><span><span class="dw-name"><%= w["label"].presence || "Ponto removido" %></span><span class="dw-state">Ponto não encontrado</span></span></div>
<% else %>
  <% off_line = p["quality"] != "good" %>
  <% css = "dw-card dw-tile #{dw_color_class(w)} #{'dw-on' if p['on'] && p['capability'] != 'measure'} #{'dw-unavailable' if off_line}" %>
  <% state = p["capability"] == "script" ? "Toque para executar" : (off_line ? "Sem sinal" : (p["value"].nil? && p["capability"] != "command" ? "Sem leitura" : p["text"])) %>
  <%# Contexto (o aparelho, quando o título é o ponto) vem depois do estado: o estado nunca some no corte. %>
  <% state_line = [ state, w.dig("data", "context") ].compact_blank.join(" · ") %>
  <% toggle = w["tap"] != "more_info" && p["can_command"] && Array(p["commands"]).include?("toggle") %>
  <% press = p["can_command"] && p["capability"].in?(%w[command gate script]) %>
  <% press_cmd = { "gate" => "pulse", "script" => "run" }.fetch(p["capability"], "press") %>
  <div class="relative h-full">
    <% if toggle %>
      <%# Liga/desliga (ponto comum ou helper, F8f): o switch fica no próprio tile, como na lista de helpers; o nome abre os detalhes. %>
      <div class="<%= css %> items-center">
        <span class="dw-ico"><%= icon(w["icon"].presence || dw_point_icon(p)) %></span>
        <%= link_to point_path(p["id"]), class: "min-w-0 flex-1 no-underline", data: { turbo_frame: "_top" } do %>
          <span class="dw-name"><%= dw_label(w, p) %></span><span class="dw-state" title="<%= p["status_note"] %>"><%= state_line %></span>
        <% end %>
        <%= dw_command_button(p, "toggle", w: w, dashboard: dashboard, live: live, class: "ss-switch", form_class: "contents", "aria-pressed": p["on"].to_s,
                              "aria-label": "#{p['on'] ? 'Desligar' : 'Ligar'} #{dw_label(w, p)}", title: (p["on"] ? "Desligar" : "Ligar")) do %><% end %>
      </div>
    <% elsif press %>
      <%= dw_command_button(p, press_cmd, w: w, dashboard: dashboard, live: live, class: "#{css} dw-press", form_class: "h-full", "aria-label": "#{p['capability'] == 'script' ? 'Executar' : 'Acionar'} #{dw_label(w, p)}") do %>
        <span class="dw-ico"><%= icon(w["icon"].presence || dw_point_icon(p)) %></span>
        <span class="min-w-0 flex-1 pr-6"><span class="dw-name"><%= dw_label(w, p) %></span><span class="dw-state" title="<%= p["status_note"] %>"><%= state_line %></span></span>
      <% end %>
      <%= link_to point_path(p["id"]), class: "dw-more", data: { turbo_frame: "_top" }, title: "Detalhes de #{dw_label(w, p)}", "aria-label": "Detalhes de #{dw_label(w, p)}" do %><%= icon("chevron-right", "size-4") %><% end %>
    <% else %>
      <div class="<%= css %> flex-wrap">
        <span class="dw-ico"><%= icon(w["icon"].presence || dw_point_icon(p)) %></span>
        <%= link_to point_path(p["id"]), class: "min-w-0 flex-1 no-underline", data: { turbo_frame: "_top" } do %>
          <span class="dw-name"><%= dw_label(w, p) %></span>
          <span class="dw-state <%= 'dw-big num' if p['value'].is_a?(Numeric) && !off_line %>" title="<%= p["status_note"] %>"><%= state %></span>
          <% if w.dig("data", "context").present? %><span class="dw-state truncate"><%= w.dig("data", "context") %></span><% end %>
        <% end %>
        <% if p["can_command"] && !off_line && p["capability"].in?(%w[dimmer setpoint]) && p["mode"] != "box" && w["tap"] != "more_info" %>
          <%= dw_command_form(p, "set", w: w, dashboard: dashboard, live: live) do %>
            <label class="sr-only" for="r_<%= w['id'] %>">Ajustar <%= dw_label(w, p) %></label>
            <input type="range" id="r_<%= w['id'] %>" name="value" class="dw-range" data-autosubmit min="<%= p['min'] || 0 %>" max="<%= p['max'] || 100 %>" step="<%= p['step'] || 1 %>" value="<%= p['value'] %>">
          <% end %>
        <% elsif p["can_command"] && !off_line && p["capability"] == "enum" && w["tap"] != "more_info" %>
          <%= dw_command_form(p, "select", w: w, dashboard: dashboard, live: live) do %>
            <label class="sr-only" for="s_<%= w['id'] %>">Escolher <%= dw_label(w, p) %></label>
            <%= select_tag :value, options_for_select(Array(p["options"]), p["value"]), id: "s_#{w['id']}", class: "ss-input", data: { autosubmit: true } %>
          <% end %>
        <% elsif p["can_command"] && !off_line && p["commands"].include?("set") && p["actions"].blank? && w["tap"] != "more_info" %>
          <%= dw_command_form(p, "set", w: w, dashboard: dashboard, live: live) do %>
            <div class="flex gap-2">
              <label class="sr-only" for="i_<%= w['id'] %>">Novo valor de <%= dw_label(w, p) %></label>
              <input type="<%= p['input'] %>" id="i_<%= w['id'] %>" name="value" class="ss-input min-w-0 flex-1 <%= 'num' if p['input'] == 'number' %>"
                     value="<%= p['value'] unless p['input'] == 'password' %>" <% if p["input"] == "number" %>min="<%= p['min'] %>" max="<%= p['max'] %>" step="<%= p['step'] || 'any' %>"<% end %>>
              <button class="ss-btn ss-btn-primary ss-btn-sm" aria-label="Aplicar <%= dw_label(w, p) %>"><%= icon("check", "size-4") %></button>
            </div>
          <% end %>
        <% end %>
        <% if p["can_command"] && !off_line && p["actions"].present? && w["tap"] != "more_info" %>
          <div class="mt-3 flex w-full flex-wrap gap-2" role="group" aria-label="Ações de <%= dw_label(w, p) %>">
            <% p["actions"].each do |c| %>
              <% ico, label = PointsHelper::ACTION_BUTTONS.fetch(c, [ "lightning-bolt", c ]) %>
              <%= dw_command_button(p, c, w: w, dashboard: dashboard, live: live, class: "ss-btn ss-btn-ghost ss-btn-sm", form_class: "contents", "aria-label": "#{label} #{dw_label(w, p)}") do %><%= icon(ico, "size-4") %><%= label %><% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
