<%# locals: (w:, points:, dashboard:, live:) -%>
<% p = points[w["data"]["point_ids"].first] %>
<% if p.nil? %>
  <%= render Ss::DeviceTileComponent.new(name: w["label"].presence || t("dashboards.w.point_removed"), status: :unavailable, icon: icon("question-mark-circle").to_s,
                                         unavailable_label: t("dashboards.w.not_found"), css: "h-full") %>
<% else %>
  <% off_line = p["quality"] != "good" %>
  <% state = p["capability"] == "script" ? t("dashboards.w.tap_to_run") : (p["value"].nil? && p["capability"] != "command" ? t("dashboards.w.no_reading") : p["text"]) %>
  <%# Contexto (o aparelho, quando o título é o ponto) vem depois do estado: o estado nunca some no corte. %>
  <%# Automação como ponto: ao lado de ligada/desligada, quando rodou (o "last_triggered" do HA). %>
  <% state = [ state, (t("dashboards.w.ran_ago", time: dw_short_ago(Time.zone.parse(p["ran_at"]))) if p["ran_at"]) ].compact.join(" · ") %>
  <% state_line = [ state, w.dig("data", "context") ].compact_blank.join(" · ") %>
  <%# Toque que roda a automação do próprio ponto (automation.trigger do HA): botão "rodar", com quando rodou. %>
  <% tap = w.dig("gestures", "tap") %>
  <% run = tap && tap["action"] == "command" && tap["command"] == "run" && tap["point_id"] == p["id"] && tap["can_command"] %>
  <% state = p["ran_at"] ? t("dashboards.w.ran_ago", time: dw_short_ago(Time.zone.parse(p["ran_at"]))) : t("dashboards.w.never_ran") if run %>
  <% state_line = [ state, w.dig("data", "context") ].compact_blank.join(" · ") if run %>
  <% toggle = !run && w["tap"] != "more_info" && p["can_command"] && Array(p["commands"]).include?("toggle") %>
  <% press = run || (p["can_command"] && p["capability"].in?(%w[command gate script])) %>
  <% press_cmd = run ? "run" : { "gate" => "pulse", "script" => "run" }.fetch(p["capability"], "press") %>
  <%# ondaB2 (B9): gestos (toque/segurar/duplo toque) e recursos do tile; com recursos, os controles próprios saem. %>
  <% gattrs, ghidden = dw_gestures(w, points, dashboard: dashboard, live: live) %>
  <% feats = Array(w.dig("data", "features")).select { |f| points[f["point_id"]] } %>
  <% builtin = feats.empty? && w["tap"] != "more_info" && p["can_command"] && !off_line %>
  <% glow = dw_glow(points[w.dig("data", "color_id")]) %>
  <%# Beleza (ideia 18): ligar, abrir e chegar acenam (ss-cue da gem; só na mudança, menos movimento desliga). %>
  <% cue_kind = p["capability"].in?(%w[contact gate cover]) ? :open : (p["capability"].in?(%w[presence occupancy person]) ? :arrive : :on) %>
  <% cue = ss_cue_data(kind: cue_kind, active: dw_on?(p) && !off_line, key: "tile-#{w['id']}") %>
  <div class="relative h-full" <%= tag.attributes(data: gattrs) %>>
    <%= ghidden %>
    <%= tag.div(class: "ss-cue h-full", style: ("--tone: #{glow}" if glow), data: cue) do %>
    <% if press && !toggle %>
      <%# Botão (comando, portão, script): tile da gem em modo aperto (o toque manda o comando, com a
          confirmação do risco); o ⋯ do tile (more_url:, também no clique direito/toque longo) abre os detalhes. %>
      <%= render Ss::DeviceTileComponent.new(name: dw_label(w, p), state: state_line, on: dw_on?(p), status: dw_tile_status(p, off_line), icon: dw_device_icon(w, p),
                                             tone: dw_tone(w, p, glow: glow), action_url: command_point_path(p["id"]),
                                             action_params: dw_command_params(press_cmd, w: w, dashboard: dashboard, live: live),
                                             action_label: t(press_cmd == "run" ? "dashboards.w.run_x" : "dashboards.w.press_x", name: dw_label(w, p)),
                                             confirm: (run && tap["confirm"]) || dw_confirm_text(p), confirm_title: dw_confirm(p)[:turbo_confirm_title],
                                             unavailable_label: t("dashboards.w.no_signal"), title: p["status_note"].presence, wide: dw_full_row?(w), css: "h-full",
                                             more_url: (point_path(p["id"]) unless dw_narrow?(w)), more_label: t("dashboards.w.details_x", name: dw_label(w, p)), more_data: { turbo_frame: "_top" }) %>
    <% else %>
      <% foot = capture do %>
        <% if builtin && !toggle && p["capability"].in?(%w[dimmer setpoint]) && p["mode"] != "box" %>
          <%= dw_command_form(p, "set", w: w, dashboard: dashboard, live: live) do %>
            <%= render Ss::RangeComponent.new(name: "value", label: t("dashboards.w.adjust_x", name: dw_label(w, p)), value: dw_plain(p["value"] || p["min"] || 0), min: dw_plain(p["min"] || 0), max: dw_plain(p["max"] || 100),
                                              step: dw_plain(p["step"] || 1), format: dw_range_format(p["unit"]), variant: :fill, submit: :release,
                                              tone: dw_tone(w, p, glow: glow), id: "r_#{w['id']}") %>
          <% end %>
        <% elsif builtin && !toggle && p["capability"] == "enum" %>
          <%= dw_command_form(p, "select", w: w, dashboard: dashboard, live: live) do %>
            <label class="sr-only" for="s_<%= w['id'] %>"><%= t("dashboards.w.choose_x", name: dw_label(w, p)) %></label>
            <%= select_tag :value, options_for_select(Array(p["options"]), p["value"]), id: "s_#{w['id']}", class: "ss-input", data: { autosubmit: true } %>
          <% end %>
        <% elsif builtin && !toggle && p["commands"].include?("set") && p["actions"].blank? %>
          <%= dw_command_form(p, "set", w: w, dashboard: dashboard, live: live) do %>
            <div class="flex items-end gap-2">
              <% if p["input"] == "number" %>
                <%= render Ss::StepperInputComponent.new(name: "value", value: dw_plain(p["value"]), min: p["min"], max: p["max"], step: p["step"] || 1, unit: p["unit"],
                                                         label: t("dashboards.w.new_value_x", name: dw_label(w, p)), hide_label: true, id: "i_#{w['id']}", css: "min-w-0 flex-1") %>
              <% else %>
                <label class="sr-only" for="i_<%= w['id'] %>"><%= t("dashboards.w.new_value_x", name: dw_label(w, p)) %></label>
                <input type="<%= p['input'] %>" id="i_<%= w['id'] %>" name="value" class="ss-input min-w-0 flex-1" value="<%= p['value'] unless p['input'] == 'password' %>">
              <% end %>
              <button class="ss-btn ss-btn-primary ss-btn-sm" aria-label="<%= t("dashboards.w.apply_x", name: dw_label(w, p)) %>"><%= icon("check", "size-4") %></button>
            </div>
          <% end %>
        <% end %>
        <% if builtin && p["actions"].present? %>
          <div class="flex w-full flex-wrap gap-2" role="group" aria-label="<%= t("dashboards.w.actions_x", name: dw_label(w, p)) %>">
            <% p["actions"].each do |c| %>
              <% ico, label = PointsHelper::ACTION_BUTTONS.fetch(c, [ "lightning-bolt", c ]) %>
              <%= dw_command_button(p, c, w: w, dashboard: dashboard, live: live, class: "ss-btn ss-btn-ghost ss-btn-sm", form_class: "contents", "aria-label": "#{label} #{dw_label(w, p)}") do %><%= icon(ico, "size-4") %><%= label %><% end %>
            <% end %>
          </div>
        <% end %>
        <% if feats.any? %>
          <div class="mt-3 grid w-full basis-full gap-3 border-t border-dashed border-line pt-3" data-no-gesture><% feats.each do |f| %><%= render dw_feature_partial(f), f: f, p: points[f["point_id"]], w: w, dashboard: dashboard, live: live %><% end %></div>
        <% end %>
      <% end %>
      <%# Tile da gem: o nome abre os detalhes (sem gestos), a chave liga/desliga e volta ao quadro (pendente e erro pelo ss-switch). %>
      <%= render Ss::DeviceTileComponent.new(name: dw_label(w, p), state: state_line, on: dw_on?(p) && p["capability"] != "measure", status: dw_tile_status(p, off_line),
                                             icon: dw_device_icon(w, p), tone: dw_tone(w, p, glow: glow), level: dw_level(w, points, p), url: (point_path(p["id"]) if w["gestures"].blank?), link_data: { turbo_frame: "_top" },
                                             toggle_url: (command_point_path(p["id"]) if toggle), toggle_params: dw_command_params("toggle", w: w, dashboard: dashboard, live: live),
                                             confirm: dw_confirm_text(p), confirm_title: dw_confirm(p)[:turbo_confirm_title], unavailable_label: t("dashboards.w.no_signal"), title: p["status_note"].presence, wide: !toggle, css: "h-full") do |c| %>
        <% c.with_footer { foot } if foot.present? %>
      <% end %>
    <% end %>
    <% end %>
  </div>
<% end %>
