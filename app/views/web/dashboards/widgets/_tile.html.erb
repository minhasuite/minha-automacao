<%# locals: (w:, points:, dashboard:, live:) -%>
<% p = points[w["data"]["point_ids"].first] %>
<% if p.nil? %>
  <div class="dw-card dw-tile dw-unavailable"><span class="dw-ico"><%= icon("question-mark-circle") %></span><span><span class="dw-name"><%= w["label"].presence || "Ponto removido" %></span><span class="dw-state">Ponto não encontrado</span></span></div>
<% else %>
  <% off_line = p["quality"] != "good" %>
  <% css = "dw-card dw-tile #{dw_color_class(w)} #{'dw-on' if p['on'] && p['capability'] != 'measure'} #{'dw-unavailable' if off_line}" %>
  <% state = off_line ? "Indisponível" : p["text"] %>
  <% toggle = w["tap"] != "more_info" && p["can_command"] && p["capability"] == "onoff" %>
  <% press = p["can_command"] && p["capability"].in?(%w[command gate]) %>
  <div class="relative h-full">
    <% if toggle || press %>
      <%= dw_command_button(p, toggle ? "toggle" : (p["capability"] == "gate" ? "pulse" : "press"), w: w, dashboard: dashboard, live: live, class: "#{css} dw-press", form_class: "h-full", "aria-pressed": (p["on"] if toggle), "aria-label": "#{toggle ? (p['on'] ? 'Desligar' : 'Ligar') : 'Acionar'} #{dw_label(w, p)}") do %>
        <span class="dw-ico"><%= icon(w["icon"].presence || dw_point_icon(p)) %></span>
        <span class="min-w-0 flex-1 pr-6"><span class="dw-name"><%= dw_label(w, p) %></span><span class="dw-state"><%= state %></span></span>
      <% end %>
      <%= link_to point_path(p["id"]), class: "dw-more", data: { turbo_frame: "_top" }, title: "Detalhes de #{dw_label(w, p)}", "aria-label": "Detalhes de #{dw_label(w, p)}" do %><%= icon("chevron-right", "size-4") %><% end %>
    <% else %>
      <div class="<%= css %> flex-wrap">
        <span class="dw-ico"><%= icon(w["icon"].presence || dw_point_icon(p)) %></span>
        <%= link_to point_path(p["id"]), class: "min-w-0 flex-1 no-underline", data: { turbo_frame: "_top" } do %>
          <span class="dw-name"><%= dw_label(w, p) %></span>
          <span class="dw-state <%= 'dw-big num' if p['value'].is_a?(Numeric) && !off_line %>"><%= state %></span>
        <% end %>
        <% if p["can_command"] && !off_line && p["capability"].in?(%w[dimmer setpoint]) && w["tap"] != "more_info" %>
          <%= dw_command_form(p, "set", w: w, dashboard: dashboard, live: live) do %>
            <label class="sr-only" for="r_<%= w['id'] %>">Ajustar <%= dw_label(w, p) %></label>
            <input type="range" id="r_<%= w['id'] %>" name="value" class="dw-range" data-autosubmit min="<%= p['min'] || 0 %>" max="<%= p['max'] || 100 %>" step="<%= p['step'] || 1 %>" value="<%= p['value'] %>">
          <% end %>
        <% elsif p["can_command"] && !off_line && p["capability"] == "enum" && w["tap"] != "more_info" %>
          <%= dw_command_form(p, "select", w: w, dashboard: dashboard, live: live) do %>
            <label class="sr-only" for="s_<%= w['id'] %>">Escolher <%= dw_label(w, p) %></label>
            <%= select_tag :value, options_for_select(Array(p["options"]), p["value"]), id: "s_#{w['id']}", class: "ss-input", data: { autosubmit: true } %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
