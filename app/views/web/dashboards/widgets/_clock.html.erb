<%# locals: (w:, points:, dashboard:, live:) -%>
<%# Relógio (ondaB2 B10): Ss::ClockComponent no fuso do local e no idioma da tela (o ss-clock anda sozinho);
    segundos em dígitos, como o relógio do produto, e encolhe no card estreito (fit, size é o teto). %>
<% d = w["data"] %>
<% now = Time.zone.parse(d["now"]).in_time_zone(d["tz"]) %>
<% gattrs, ghidden = dw_gestures(w, points, dashboard: dashboard, live: live) %>
<div class="relative h-full" <%= tag.attributes(data: gattrs) %>>
  <%= ghidden %>
  <div class="dw-card dw-clock">
    <% if w["label"].present? %><p class="dw-clock-label"><%= w["label"] %></p><% end %>
    <%= render Ss::ClockComponent.new(now: now, seconds: (:digits if d["seconds"]), fit: true, date: d["show_date"], hour12: d["format"] == "12h", locale: I18n.locale.to_s, time_zone: d["tz"],
                                      size: { "small" => 36, "large" => 88 }.fetch(d["size"].to_s, 56)) %>
  </div>
</div>
