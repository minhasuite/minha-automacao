<%# locals: (w:, points:, dashboard:, live:) -%>
<% ids = w["data"]["point_ids"] %>
<% labels = w["labels"].is_a?(Hash) ? w["labels"] : {} %>
<% tiles = w["display"] == "tiles" %>
<% cols = (w["columns"].to_i.nonzero? || 3).clamp(1, 4) %>
<%# Texto de vazio " " = o card some quando não há nada (show_empty: false do HA). %>
<% unless ids.empty? && w["empty_text"] == " " %>
<div class="<%= tiles ? '' : 'ss-card ss-card-pad h-full' %>">
  <%# Sem nome, sem cabeçalho: o título da seção já diz o que é (um "Lista" genérico só ocupa espaço). %>
  <% if w["label"].present? %>
    <%= render Ss::CardHeaderComponent.new(title: w["label"], css: (tiles ? "mb-2 px-1" : "mb-1")) do |h| %>
      <% if w["data"]["count"].positive? %><% h.with_action do %><span class="ss-badge ss-badge-accent num"><%= w["data"]["count"] %></span><% end %><% end %>
    <% end %>
  <% end %>
  <% if ids.empty? %>
    <%= render Ss::NoteComponent.new(text: w["empty_text"].presence || t("dashboards.w.nothing_now"), icon: icon("check-circle", ""), tone: :success, css: (tiles ? "ss-card ss-card-pad" : "mt-3")) %>
  <% elsif tiles %>
    <%# Grade de tiles (o auto-entities do HA com card grid): cada ponto é um tile, com o nome que o painel dava; o comando refaz a lista inteira (o id é o dela). %>
    <div class="dw-grid">
      <% ids.each do |id| %>
        <% next unless points[id] %>
        <div class="dw-w" style="<%= dw_span_style({ 'mobile' => 12, 'tablet' => (cols == 1 ? 12 : 6), 'desktop' => 12 / cols }) %>">
          <%= render "web/dashboards/widgets/tile", w: { "id" => w["id"], "type" => "tile", "bind" => id, "label" => labels[id],
                                                         "data" => { "title" => labels[id].presence || points[id]["name"], "point_ids" => [ id ] } },
                                                    points: points, dashboard: dashboard, live: live %>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= render "web/dashboards/widgets/rows", ids: ids, points: points, w: w, dashboard: dashboard, live: live, labels: labels %>
  <% end %>
</div>
<% end %>
