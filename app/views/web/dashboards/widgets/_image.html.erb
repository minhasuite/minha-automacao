<%# locals: (w:, points:, dashboard:, live:) -%>
<%# Imagem (ondaB2 B10): foto com legenda e o estado do ponto por cima; gestos opcionais. %>
<% d = w["data"] %>
<% p = points[Array(d["point_ids"]).first] %>
<% gattrs, ghidden = dw_gestures(w, points, dashboard: dashboard, live: live) %>
<div class="relative h-full" <%= tag.attributes(data: gattrs) %>>
  <%= ghidden %>
  <figure class="dw-card dw-pic <%= 'dw-pic-off' if p && !dw_on?(p) && p['capability'].in?(%w[onoff dimmer]) %>" style="aspect-ratio: <%= d['ratio'] %>">
    <% if d["image"] %><img src="<%= d["image"] %>" alt="<%= w["label"] %>" loading="lazy" decoding="async"><% end %>
    <% if w["label"].present? || p %>
      <figcaption><span class="truncate font-bold"><%= w["label"] %></span><% if p %><span class="dw-pic-state"><%= p["text"] %></span><% end %></figcaption>
    <% end %>
  </figure>
</div>
