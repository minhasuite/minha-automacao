<%# locals: (w:, points:, dashboard:, live:) -%>
<%# Imagem (ondaB2 B10): o card de foto da gem com a legenda e o estado do ponto por cima (apagada com o aparelho desligado); gestos opcionais. %>
<% d = w["data"] %>
<% p = points[Array(d["point_ids"]).first] %>
<% gattrs, ghidden = dw_gestures(w, points, dashboard: dashboard, live: live) %>
<div class="relative h-full" <%= tag.attributes(data: gattrs) %>>
  <%= ghidden %>
  <%= render Ss::PhotoCardComponent.new(src: d["image"], title: w["label"], badge: p&.dig("text"), ratio: d["ratio"].presence || "16 / 9",
                                        dimmed: p.present? && !dw_on?(p) && p["capability"].in?(%w[onoff dimmer])) %>
</div>
