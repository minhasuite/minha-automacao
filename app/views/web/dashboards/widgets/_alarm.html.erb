<%# locals: (w:, points:, dashboard:, live:) -%>
<% d = w["data"] %>
<% p = points[Array(d["point_ids"]).first] %>
<div class="ss-card ss-card-pad h-full">
  <% if p.nil? %>
    <%= render Ss::CardHeaderComponent.new(title: w["label"].presence || t("dashboards.w.alarm"), icon: icon("lock-closed", "")) %>
    <%= render Ss::NoteComponent.new(text: t("dashboards.w.pick_alarm"), icon: icon("shield-check", ""), css: "mt-2") %>
  <% else %>
    <% state = d["state"].to_s %>
    <% tone = { "triggered" => "is-danger", "pending" => "is-warn", "arming" => "is-warn" }[state] || (d["armed"] ? "is-grad" : "is-accent") %>
    <div class="flex items-center gap-3">
      <span class="ss-icon-tile is-lg <%= tone %>"><%= icon(d["armed"] || state.in?(%w[pending triggered]) ? "lock-closed" : "lock-open") %></span>
      <div class="min-w-0 flex-1">
        <p class="text-sm text-muted truncate"><%= dw_label(w, p) %></p>
        <p class="font-bold text-ink" aria-live="polite"><%= p["quality"] == "good" ? d["state_text"] : t("dashboards.w.no_signal") %></p>
        <% if d["until"] && state.in?(%w[arming pending]) %><p class="text-xs text-muted num"><%= t("dashboards.w.until") %> <%= l(Time.zone.parse(d["until"]), format: "%H:%M:%S") %></p><% end %>
        <% if Array(d["tripped_by"]).any? && state.in?(%w[pending triggered]) %><p class="text-xs text-danger truncate"><%= t("dashboards.w.by") %> <%= Array(d["tripped_by"]).join(", ") %></p><% end %>
      </div>
    </div>
    <% if p["can_command"] %>
      <%# O comando vai no botão (name="command"); o código no "value" (nunca fica na tela nem no histórico de comandos). %>
      <%= ss_form_with url: command_point_path(p["id"]), data: { turbo_frame: (live ? nil : "_top") }.compact, class: "mt-3" do %>
        <% if live %><%= hidden_field_tag :dashboard_id, dashboard.id, id: nil %><%= hidden_field_tag :widget_id, w["id"], id: nil %><% end %>
        <% if state == "disarmed" && !d["code_arm"] %>
          <%# Armar sem código: só os modos. %>
          <div class="mt-3 flex flex-wrap gap-2">
            <% d["modes"].each do |m| %>
              <%= render Ss::ButtonComponent.new(label: m["label"], type: :submit, name: "command", value: m["command"], variant: :outline, size: :sm, css: "flex-auto") %>
            <% end %>
          </div>
        <% else %>
          <% actions = state == "disarmed" ? d["modes"].map { |m| { label: m["label"], name: "command", value: m["command"] } } :
                                             [ { label: t("dashboards.w.disarm"), name: "command", value: "disarm", primary: true, icon: icon("lock-open", "size-4").to_s } ] %>
          <%= render Ss::CodeKeypadComponent.new(name: "value", actions: actions, title: t("dashboards.w.code"), id: "code_#{w['id']}",
                                                 labels: { keys: t("dashboards.w.keypad"), backspace: t("dashboards.w.backspace") }) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
