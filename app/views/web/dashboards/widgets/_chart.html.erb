<%# locals: (w:, points:, dashboard:, live:) -%>
<%# Gráfico no tempo da gem: séries numéricas (um eixo por unidade, cursor com balão) e faixas de liga/desliga. %>
<% ids = w["data"]["point_ids"] %>
<% records = Point.where(id: ids).index_by(&:id).values_at(*ids).compact %>
<% chart = records.any? ? dashboard_chart(records, w["range"] || "24h") : nil %>
<% title = w["label"].presence || t("dashboards.w.history") %>
<div class="dw-card">
  <p class="dw-card-title"><%= title %></p>
  <% if chart %>
    <%= render Ss::TimeSeriesChartComponent.new(title: title, series: chart[:series], bands: chart[:bands], from: chart[:from], to: chart[:to],
                                                height: 180, locale: I18n.locale.to_s, time_zone: dashboard.site.timezone, css: "mt-2") %>
    <% if chart[:on_seconds] %><p class="text-sm text-ink-2 mt-2"><%= t("dashboards.w.on_for_html", time: tag.strong(duration_text(chart[:on_seconds]), class: "num")) %></p><% end %>
  <% else %>
    <p class="dw-quiet"><%= icon("chart-bar", "size-5 text-muted") %><%= t("dashboards.w.no_readings") %></p>
  <% end %>
</div>
