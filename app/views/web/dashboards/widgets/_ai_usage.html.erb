<%# locals: (w:, points:, dashboard:, live:) -%>
<%# Uso de IA (AiCall): os números no Ss::KpiStripComponent e as automações que mais chamaram, em linhas. %>
<% d = w["data"] %>
<% label = w["label"].presence || Dashboards::Widgets::AiUsageWidget.label %>
<div class="ss-card ss-card-pad h-full">
  <%= render Ss::CardHeaderComponent.new(title: label, icon: icon("sparkles", "")) %>
  <%= render Ss::KpiStripComponent.new(label: label, css: "mt-2",
                                       items: Array(d["items"]).map { |i| { label: i["label"], value: i["text"].presence || number_with_delimiter(i["value"]),
                                                                            good: (false if i["bad"] && i["value"].to_i.positive?) }.compact }) %>
  <% rows = Array(d["by_automation"]) %>
  <% if rows.any? %>
    <p class="ss-kicker mt-4 mb-1"><%= d["title"] %></p>
    <ul class="grid gap-0.5">
      <% rows.each do |r| %>
        <li class="ss-item">
          <span class="ss-icon-tile is-sm is-muted"><%= icon("lightning-bolt", "") %></span>
          <span class="ss-item-main"><span class="text-sm"><%= r["name"] %></span>
            <span class="text-xs"><%= t("dashboards.w.ran_ago", time: dw_short_ago(Time.zone.parse(r["last_at"]))) if r["last_at"] %></span></span>
          <span class="text-sm font-semibold num text-ink shrink-0"><%= r["calls"] %></span>
          <% if r["errors"].positive? %><span class="ss-badge ss-badge-danger num shrink-0"><%= r["errors"] %></span><% end %>
        </li>
      <% end %>
    </ul>
  <% elsif Array(d["items"]).sum { |i| i["key"] == "month" ? i["value"].to_i : 0 }.zero? %>
    <%= render Ss::NoteComponent.new(text: d["empty"], icon: icon("sparkles", ""), css: "mt-3") %>
  <% end %>
</div>
