<%# locals: (w:, points:, dashboard:, live:) -%>
<%# Cartão de área: o bloco do mosaico da gem (Ss::MosaicTileComponent, o SsMosaicTile do app), com a foto da área
    ou o tom da marca, e as pílulas do que importa agora (ligados, abertos, movimento, potência, sem sinal). %>
<% d = w["data"] %>
<% if d["missing"] %>
  <div class="ss-card ss-card-pad h-full"><p class="text-sm font-semibold text-ink-2"><%= t("dashboards.w.area_removed") %></p></div>
<% else %>
  <% a = d["area"] %>
  <% facts = [
       ({ label: t("dashboards.w.n_on", count: d["on"]), icon: icon("light-bulb", "") } if d["on"].positive?),
       ({ label: t("dashboards.w.n_open", count: d["open"]), icon: icon("view-boards", "") } if d["open"].positive?),
       ({ label: t("dashboards.w.motion"), icon: icon("eye", "") } if d["motion"]),
       ({ label: dw_number(d["power"], "W"), icon: icon("lightning-bolt", ""), num: true } if d["power"]),
       ({ label: t("dashboards.w.n_offline", count: d["unavailable"]) } if d["unavailable"].positive?)
     ].compact %>
  <% facts = [ { label: t("dashboards.ed.points", count: d["total"]) } ] if facts.empty? %>
  <%= render Ss::MosaicTileComponent.new(title: a["name"], icon: icon(a["icon"].presence || "view-boards", ""), image_url: a["background"], variant: dw_area_variant(a), facts: facts,
                                         url: d["view_id"] ? dw_view_path(dashboard, { "id" => d["view_id"] }, home: @home) : area_path(a["id"]), link_data: { turbo_frame: "_top" }) %>
<% end %>
