<%# locals: (w:, points:, dashboard:, live:) -%>
<%# Mostrador (ondaB2 B10): termostato, umidificador e luz. Anel de 270° com o alvo, −/+ no alvo, modos e liga/desliga. %>
<% d = w["data"] %>
<% target = points[d["target_id"]] %>
<% power = points[d["power_id"]] %>
<% mode = points[d["mode_id"]] %>
<% main = target || power %>
<% if d["missing"] || main.nil? %>
  <div class="dw-card dw-tile dw-unavailable"><span class="dw-ico"><%= icon("question-mark-circle") %></span><span><span class="dw-name"><%= w["label"].presence || t("dashboards.w.point_removed") %></span><span class="dw-state"><%= t("dashboards.w.not_found") %></span></span></div>
<% else %>
  <% off_line = main["quality"] != "good" %>
  <% can = target && target["can_command"] && !off_line %>
  <% glow = dw_glow(points[d["color_id"]]) if d["color_id"] %>
  <% f = { "value" => d["value"], "step" => d["step"], "min" => d["min"], "max" => d["max"] } %>
  <div class="dw-card dw-dial dw-dial-<%= d['tone'] %> <%= 'dw-unavailable' if off_line %>" style="<%= "--glow: #{glow}" if glow %>">
    <div class="dw-dial-head">
      <span class="dw-name truncate"><%= d["title"] %></span>
      <% if power && power["can_command"] && !off_line %>
        <%= dw_command_button(power, "toggle", w: w, dashboard: dashboard, live: live, class: "dw-dial-power", form_class: "contents", "aria-pressed": power["on"].to_s,
                              "aria-label": t(power["on"] ? "dashboards.w.turn_off_x" : "dashboards.w.turn_on_x", name: d["title"])) do %><%= icon("power", "size-4") %><% end %>
      <% end %>
    </div>
    <div class="dw-dial-ring">
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="42" pathLength="100" class="dw-dial-track"/>
        <circle cx="50" cy="50" r="42" pathLength="100" class="dw-dial-bar" style="--r: <%= d['ratio'].to_f %>"/>
      </svg>
      <div class="dw-dial-center">
        <span class="dw-dial-label"><%= d["on"] ? d["target_label"] : t("dashboards.cards.turned_off") %></span>
        <strong class="dw-dial-value num"><%= d["value"].is_a?(Numeric) ? dw_number(d["value"], d["unit"]) : (main["text"].presence || "—") %></strong>
        <% if d["current"].is_a?(Numeric) %><span class="dw-dial-now num"><%= icon("thermometer", "size-4") if w["type"] == "thermostat" %><%= t("dashboards.cards.now_x", value: dw_number(d["current"], d["unit"])) %></span><% end %>
      </div>
    </div>
    <% if can %>
      <div class="dw-dial-steps" role="group" aria-label="<%= d["target_label"] %>">
        <%= dw_command_button(target, "set", value: dw_step(f, -1), w: w, dashboard: dashboard, live: live, class: "dw-step dw-step-lg", form_class: "contents", "aria-label": t("dashboards.feat.less", name: d["target_label"])) do %><%= icon("minus") %><% end %>
        <%= dw_command_button(target, "set", value: dw_step(f, 1), w: w, dashboard: dashboard, live: live, class: "dw-step dw-step-lg", form_class: "contents", "aria-label": t("dashboards.feat.more", name: d["target_label"])) do %><%= icon("plus") %><% end %>
      </div>
    <% end %>
    <% if mode && d["modes"].present? %>
      <div class="dw-chips justify-center mt-3" role="group" aria-label="<%= mode["name"] %>">
        <% d["modes"].each do |o| %>
          <% if mode["can_command"] && mode["quality"] == "good" %>
            <%= dw_command_button(mode, "select", value: o, w: w, dashboard: dashboard, live: live, class: "dw-chip", form_class: "contents", "aria-pressed": (o.to_s == d["mode"].to_s).to_s) do %><%= o %><% end %>
          <% else %>
            <span class="dw-chip" aria-current="<%= o.to_s == d['mode'].to_s %>"><%= o %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% feats = Array(d["features"]).select { |x| points[x["point_id"]] } %>
    <% if feats.any? %>
      <div class="dw-feats" data-no-gesture><% feats.each do |x| %><%= render dw_feature_partial(x), f: x, p: points[x["point_id"]], w: w, dashboard: dashboard, live: live %><% end %></div>
    <% end %>
  </div>
<% end %>
