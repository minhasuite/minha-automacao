<%# locals: (w:, points:, dashboard:, live:) -%>
<% d = w["data"] %>
<% f = d["flows"] || {} %>
<% has = d["has"] || {} %>
<% watts = d["watts"] || {} %>
<% power = ->(v) { v.nil? ? "—" : (v.abs >= 1000 ? "#{number_with_precision(v.abs / 1000.0, precision: 2, strip_insignificant_zeros: true, separator: t("number.format.separator"))} kW" : "#{v.abs.round} W") } %>
<% idle = Dashboards::Widgets::EnergyFlowWidget::IDLE_W %>
<div class="dw-card ef-card">
  <div class="flex items-center justify-between gap-2">
    <p class="dw-card-title"><%= w["label"].presence || t("dashboards.w.energy_now") %></p>
    <span class="ss-icon-tile is-muted is-sm" style="color: var(--amber)"><%= icon("lightning-bolt", "") %></span>
  </div>
  <% if d["missing"] %>
    <p class="dw-quiet"><%= icon("lightning-bolt", "size-5 text-muted") %><%= t("dashboards.w.pick_power") %></p>
  <% else %>
    <%# Fluxo da gem: a casa no meio, rede à esquerda, solar em cima, bateria embaixo; os pontos correm no sentido da energia. %>
    <% g = watts["grid"] %>
    <% b = watts["battery"] %>
    <% around = []
       around << { id: :solar, kind: :solar, label: t("dashboards.w.ef.solar"), value: power.(watts["solar"]), slot: :top } if has["solar"]
       around << { id: :grid, kind: :grid, label: g.nil? ? t("dashboards.w.ef.grid") : (g.negative? ? t("dashboards.w.ef.selling") : t("dashboards.w.ef.buying")), value: power.(g), slot: :left } if has["grid"]
       around << { id: :battery, kind: :battery, label: t("dashboards.w.battery"), value: d["soc"] ? "#{d['soc']}%" : power.(b), slot: :bottom,
                   caption: (t(b.negative? ? "dashboards.w.ef.charging_x" : "dashboards.w.ef.using_x", power: power.(b)) if b && b.abs > idle) } if has["battery"]
       links = { "grid_home" => %i[grid home], "solar_home" => %i[solar home], "solar_grid" => %i[solar grid], "solar_battery" => %i[solar battery],
                 "battery_home" => %i[battery home], "grid_battery" => %i[grid battery] }.filter_map do |key, (from, to)|
         next unless [ from, to ].all? { |n| n == :home || has[n.to_s] }

         { from: from, to: to, power: f[key].to_f > idle ? f[key].to_f : 0 }
       end %>
    <%= render Ss::FlowDiagramComponent.new(center: { id: :home, kind: :home, label: t("dashboards.w.ef.home"), value: power.(f["home"]) }, around: around, links: links,
                                            label: [ t("dashboards.w.ef.home_x", power: power.(f["home"])), (t(g.to_f.negative? ? "dashboards.w.ef.grid_in_x" : "dashboards.w.ef.grid_out_x", power: power.(g)) if has["grid"]),
                                                     (t("dashboards.w.ef.solar_x", power: power.(watts["solar"])) if has["solar"]) ].compact.join(", "), css: "mt-2") %>
    <% if has["solar"] && f["home"].to_f.positive? %>
      <% share = ((f["solar_home"].to_f + f["battery_home"].to_f) / f["home"].to_f * 100).round.clamp(0, 100) %>
      <p class="ef-foot"><span class="dw-meter" role="img" aria-label="<%= t("dashboards.w.ef.self_share", pct: share) %>"><span style="width: <%= share %>%"></span></span><%= t("dashboards.w.ef.self_share_now_html", pct: tag.span("#{share}%", class: "num")) %></p>
    <% end %>
    <%# ondaB2 (B12): parcela fóssil da rede e previsão solar de hoje. %>
    <% if d["fossil_pct"] || d["forecast_kwh"] %>
      <div class="ef-extras">
        <% if d["fossil_pct"] %><span class="ef-chip ef-co2"><%= icon("globe-alt", "size-4") %><%= t("dashboards.energy_b12.low_carbon", pct: 100 - d["fossil_pct"]) %></span><% end %>
        <% if d["forecast_kwh"] %><span class="ef-chip ef-fc"><%= icon("sun", "size-4") %><%= t("dashboards.energy_b12.forecast", kwh: number_with_precision(d["forecast_kwh"], precision: 1, strip_insignificant_zeros: true, separator: ",")) %></span><% end %>
      </div>
    <% end %>
  <% end %>
</div>
