<%# locals: (w:, points:, dashboard:, live:) -%>
<%# Botão (ondaB2 B10): sem tap_action, o toque faz o natural do ponto (tile da gem em modo aperto, com a
    confirmação do risco); segurar e duplo toque pelos gestos. %>
<% d = w["data"] %>
<% p = points[Array(d["point_ids"]).first] %>
<% gattrs, ghidden = dw_gestures(w, points, dashboard: dashboard, live: live) %>
<% label = w["label"].presence || p&.dig("title") || p&.dig("name") || Dashboards::Widgets::ButtonWidget.label %>
<% art = icon(w["icon"].presence || (p ? dw_point_icon(p) : "cursor-click")).to_s %>
<% state = (p["quality"] == "good" ? p["text"] : t("dashboards.w.no_signal")) if p && d["show_state"] %>
<% press = w.dig("gestures", "tap").nil? && p && d["command"] && p["can_command"] && p["quality"] == "good" %>
<div class="relative h-full" <%= tag.attributes(data: gattrs, role: ("button" if w["gestures"] && !press), tabindex: (0 if w["gestures"] && !press)) %>>
  <%= ghidden %>
  <%= render Ss::DeviceTileComponent.new(name: label, state: state, on: !!(p && dw_on?(p)), icon: art, tone: dw_tone(w, p),
                                         status: (d["missing"] ? :unavailable : :ready), unavailable_label: t("dashboards.w.not_found"),
                                         action_url: (command_point_path(p["id"]) if press),
                                         action_params: (press ? dw_command_params(d["command"], w: w, dashboard: dashboard, live: live) : {}),
                                         action_label: label, confirm: (dw_confirm_text(p) if press), confirm_title: (dw_confirm(p)[:turbo_confirm_title] if press),
                                         css: "h-full") %>
</div>
