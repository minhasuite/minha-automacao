<%# locals: (w:, points:, dashboard:, live:) -%>
<%# Planta (ondaB2 B10): cada medida com a barra, a faixa boa e o aviso de baixo/alto. %>
<% d = w["data"] %>
<div class="ss-card ss-card-pad h-full">
  <div class="flex items-center gap-3">
    <%# Arte: a foto da planta ou a folha no ícone tonal da gem (verde; âmbar com aviso). %>
    <span class="ss-icon-tile is-lg <%= d['problem'] ? 'is-warn' : 'is-success' %>"><% if d["image"] %><img src="<%= d["image"] %>" alt="" loading="lazy"><% else %><%= icon("leaf", "") %><% end %></span>
    <%= render Ss::CardHeaderComponent.new(title: w["label"].presence || Dashboards::Widgets::PlantWidget.label, css: "min-w-0 flex-1") %>
  </div>
  <%= render Ss::NoteComponent.new(text: d["summary"], icon: icon(d["problem"] ? "exclamation-circle" : "check-circle", ""), tone: (d["problem"] ? :warn : :success), css: "mt-2") %>
  <ul class="mt-3 grid gap-2.5">
    <% Array(d["metrics"]).each do |m| %>
      <% p = points[m["point_id"]] %>
      <li class="grid gap-1">
        <div class="ss-value-row p-0">
          <span><%= icon(m["icon"], "") %><%= m["label"] %></span>
          <span class="inline-flex items-center gap-1.5"><%= p ? p["text"] : dw_number(m["value"], m["unit"]) %><% if m["status_text"] %><span class="ss-badge ss-badge-warn"><%= m["status_text"] %></span><% end %></span>
        </div>
        <div class="ss-progress" role="meter" aria-label="<%= m["label"] %>" aria-valuenow="<%= m['value'] %>"><span class="ss-progress-bar <%= { 'ok' => 'bg-success', 'low' => 'bg-warn', 'high' => 'bg-warn' }[m['status']] %>" style="width: <%= ((m['ratio'] || 0).to_f * 100).round(1) %>%"></span></div>
      </li>
    <% end %>
  </ul>
</div>
