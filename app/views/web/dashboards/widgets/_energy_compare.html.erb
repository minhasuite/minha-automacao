<%# locals: (w:, points:, dashboard:, live:) -%>
<% d = w["data"] %>
<% kwh = ->(v) { "#{number_with_precision(v, precision: v.to_f < 10 ? 2 : 1, strip_insignificant_zeros: true, delimiter: '.', separator: ',')} kWh" } %>
<% money = ->(v) { number_to_currency(v, unit: "R$ ", separator: ",", delimiter: ".") } %>
<div class="dw-card">
  <%= render Ss::CardHeaderComponent.new(title: w["label"].presence || t("dashboards.w.compare"), icon: icon("trending-up", ""), tone: :heat) %>
  <% if d["missing"] %>
    <p class="dw-quiet"><%= icon("lightning-bolt", "size-5 text-muted") %><%= t("dashboards.w.pick_energy") %></p>
  <% else %>
    <div class="ef-cmp">
      <% d["rows"].each do |r| %>
        <% prev = r["previous_kwh"].to_f %>
        <% top = [ r["kwh"].to_f, prev, 0.001 ].max %>
        <section class="ef-cmp-row" aria-label="<%= r['label'] %>">
          <div class="flex items-baseline justify-between gap-2">
            <p class="font-semibold text-ink"><%= r["label"] %></p>
            <% if r["delta_pct"] %>
              <span class="ef-delta <%= r['delta_pct'].positive? ? 'ef-up' : 'ef-down' %> num"><%= icon(r["delta_pct"].positive? ? "trending-up" : "trending-down", "size-3.5") %><%= r["delta_pct"].positive? ? "+" : "" %><%= r["delta_pct"] %>%</span>
            <% else %>
              <span class="text-xs text-muted"><%= t("dashboards.w.no_compare") %></span>
            <% end %>
          </div>
          <div class="ef-cmp-bars">
            <span class="ef-cmp-now" style="width: <%= (r['kwh'].to_f / top * 100).round(1) %>%"></span>
            <span class="ef-cmp-prev" style="width: <%= (prev / top * 100).round(1) %>%"></span>
          </div>
          <p class="text-xs text-muted num"><strong class="text-ink"><%= kwh.(r["kwh"]) %></strong><%= " · #{money.(r['cost'])}" if r["cost"] %> · <%= r["before"] %>: <%= kwh.(prev) %></p>
        </section>
      <% end %>
    </div>
  <% end %>
</div>
