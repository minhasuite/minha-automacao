<%# locals: (w:, points:, dashboard:, live:) -%>
<% d = w["data"] %>
<% kwh = ->(v) { "#{number_with_precision(v, precision: v.to_f < 10 ? 2 : 1, strip_insignificant_zeros: true, delimiter: '.', separator: ',')} kWh" } %>
<% money = ->(v) { number_to_currency(v, unit: "R$ ", separator: ",", delimiter: ".") } %>
<div class="ss-card ss-card-pad h-full">
  <%= render Ss::CardHeaderComponent.new(title: w["label"].presence || t("dashboards.w.compare"), icon: icon("trending-up", ""), tone: :heat) %>
  <% if d["missing"] %>
    <%= render Ss::NoteComponent.new(text: t("dashboards.w.pick_energy"), icon: icon("lightning-bolt", ""), css: "mt-3") %>
  <% else %>
    <div class="mt-3 grid gap-4">
      <% d["rows"].each do |r| %>
        <% prev = r["previous_kwh"].to_f %>
        <% top = [ r["kwh"].to_f, prev, 0.001 ].max %>
        <section aria-label="<%= r['label'] %>">
          <div class="flex items-baseline justify-between gap-2">
            <p class="font-semibold text-ink"><%= r["label"] %></p>
            <% if r["delta_pct"] %>
              <span class="ss-delta <%= r['delta_pct'].positive? ? 'is-bad' : 'is-good' %> num"><%= icon(r["delta_pct"].positive? ? "trending-up" : "trending-down", "size-3.5") %><%= r["delta_pct"].positive? ? "+" : "" %><%= r["delta_pct"] %>%</span>
            <% else %>
              <span class="text-xs text-muted"><%= t("dashboards.w.no_compare") %></span>
            <% end %>
          </div>
          <%# Agora e antes em duas barras da gem: a de agora em âmbar (energia), a de antes apagada. %>
          <div class="my-1.5 grid gap-1" aria-hidden="true">
            <div class="ss-progress"><span class="ss-progress-bar bg-warn" style="width: <%= (r['kwh'].to_f / top * 100).round(1) %>%"></span></div>
            <div class="ss-progress"><span class="ss-progress-bar bg-muted/40" style="width: <%= (prev / top * 100).round(1) %>%"></span></div>
          </div>
          <p class="text-xs text-muted num"><strong class="text-ink"><%= kwh.(r["kwh"]) %></strong><%= " · #{money.(r['cost'])}" if r["cost"] %> · <%= r["before"] %>: <%= kwh.(prev) %></p>
        </section>
      <% end %>
    </div>
  <% end %>
</div>
