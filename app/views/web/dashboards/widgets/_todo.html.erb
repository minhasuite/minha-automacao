<%# locals: (w:, points:, dashboard:, live:) -%>
<%# Lista de tarefas (ondaB2 B10): marcar/desmarcar, remover, adicionar e limpar, pelos comandos do ponto. %>
<% d = w["data"] %>
<% p = points[Array(d["point_ids"]).first] %>
<% if p.nil? %>
  <%= render Ss::DeviceTileComponent.new(name: w["label"].presence || t("dashboards.w.point_removed"), status: :unavailable, icon: icon("clipboard-list").to_s,
                                         unavailable_label: t("dashboards.w.not_found"), css: "h-full") %>
<% else %>
  <% can = p["can_command"] %>
  <div class="ss-card ss-card-pad h-full">
    <%= render Ss::CardHeaderComponent.new(title: w["label"].presence || p["title"] || p["name"], icon: icon("clipboard-list", "")) do |h| %>
      <% h.with_action do %><span class="ss-badge ss-badge-accent num"><%= Array(d["pending"]).size %></span><% end %>
    <% end %>
    <% if can %>
      <%= dw_command_form(p, "add_item", w: w, dashboard: dashboard, live: live) do %>
        <div class="flex gap-2"><%= ss_fields(nil) { |f| f.ss_text_field :value, label: d["add_label"], hide_label: true, id: "td-#{w['id']}", maxlength: 255, placeholder: d["add_label"],
                                                                 required: true, autocomplete: "off", wrapper_class: "min-w-0 flex-1" } %>
          <%= render Ss::ButtonComponent.new(icon: icon("plus", "size-4"), type: :submit, size: :sm, aria: { label: d["add_label"] }) %></div>
      <% end %>
    <% end %>
    <% if Array(d["pending"]).empty? && Array(d["done"]).empty? %><%= render Ss::NoteComponent.new(text: d["empty"], icon: icon("clipboard-list", ""), css: "mt-3") %><% end %>
    <%# Tarefa com comando da gem (.ss-checklist + [role=checkbox], o SsTaskItem do app): a linha inteira marca, o × remove. %>
    <ul class="ss-checklist mt-2 max-h-80 overflow-y-auto">
      <% (Array(d["pending"]) + Array(d["done"])).each do |i| %>
        <% done = i["status"] == "completed" %>
        <li>
          <% if can %>
            <%= dw_command_button(p, done ? "reopen_item" : "complete_item", value: i["uid"], w: w, dashboard: dashboard, live: live, form_class: "contents",
                                  role: "checkbox", "aria-checked": done.to_s) do %><span class="truncate"><%= i["summary"] %></span><% end %>
            <%= dw_command_button(p, "remove_item", value: i["uid"], w: w, dashboard: dashboard, live: live, class: "ss-checklist-x", form_class: "contents", "aria-label": "#{HelperTypes::TodoList.command_labels['remove_item']}: #{i['summary']}") do %><%= icon("x", "size-4") %><% end %>
          <% else %>
            <span role="checkbox" aria-checked="<%= done %>" aria-disabled="true"><span class="truncate"><%= i["summary"] %></span></span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if can && d["done_count"].to_i.positive? %>
      <div class="mt-2 flex items-center justify-between text-xs text-muted"><span><%= d["done_label"] %></span>
        <%= dw_command_button(p, "clear_completed", w: w, dashboard: dashboard, live: live, class: "ss-btn ss-btn-ghost ss-btn-sm", form_class: "contents") do %><%= icon("trash", "size-4") %><%= d["clear_label"] %><% end %></div>
    <% end %>
  </div>
<% end %>
