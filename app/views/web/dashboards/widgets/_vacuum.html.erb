<%# locals: (w:, points:, dashboard:, live:) -%>
<% d = w["data"] %>
<% p = points[d["point_ids"].first] %>
<% if p.nil? %>
  <%= render Ss::DeviceTileComponent.new(name: w["label"].presence || t("dashboards.w.vacuum_removed"), status: :unavailable, icon: icon("vacuum").to_s,
                                         unavailable_label: t("dashboards.w.not_found"), css: "h-full") %>
<% else %>
  <% off_line = p["quality"] != "good" %>
  <% detail = points[d["detail"]] %>
  <% battery = points[d["battery"]] %>
  <% fault = points[d["fault"]] %>
  <% can = p["can_command"] && !off_line %>
  <% busy = p["value"].in?(%w[cleaning returning]) %>
  <% uid = w["id"] %>
  <%# Robô montado com as peças da gem: o tile (nome, estado, bateria) e, no rodapé, comandos, cômodos e peças. %>
  <% state = [ p["text"], (detail["text"] if detail && detail["text"] != p["text"]), (battery["text"] if battery && battery["value"].is_a?(Numeric)) ].compact.uniq.join(" · ") %>
  <%= render Ss::DeviceTileComponent.new(name: w["label"].presence || p["device"], state: state, on: busy, status: dw_tile_status(p, off_line), icon: icon(w["icon"].presence || "vacuum").to_s,
                                         url: point_path(p["id"]), link_data: { turbo_frame: "_top" }, wide: true, unavailable_label: t("dashboards.w.offline"), css: "h-full") do |tile| %>
  <% tile.with_footer do %>
    <% if busy && !off_line %>
      <%# Robô limpando (uiweb): ele percorre o piso em faixas e deixa o rastro; só CSS. %>
      <div class="dw-vac-run dw-anim <%= 'dw-vac-back' if p['value'] == 'returning' %>" aria-hidden="true">
        <span class="dw-vac-trail"></span><span class="dw-vac-bot"><span></span></span><span class="dw-vac-dock"></span>
      </div>
    <% end %>
    <% if fault && fault["value"] == true && !off_line %>
      <%= render Ss::NoteComponent.new(text: t("dashboards.w.vacuum_fault"), icon: icon("exclamation-circle", ""), tone: :danger, css: "mt-3") %>
    <% end %>

    <% if can %>
      <div class="mt-3 grid grid-cols-[repeat(auto-fit,minmax(7.5rem,1fr))] gap-2" role="group" aria-label="<%= t("dashboards.w.vacuum_commands") %>">
        <% [ [ "start", p["value"] == "paused" ? t("dashboards.w.vac.resume") : t("dashboards.w.vac.start"), "play" ], [ "pause", t("dashboards.w.vac.pause"), "pause" ], [ "stop", t("dashboards.w.vac.stop"), "stop" ], [ "home", t("dashboards.w.vac.home"), "home" ] ].each do |cmd, label, ico| %>
          <% next unless d["actions"].include?(cmd) %>
          <%= dw_command_button(p, cmd, w: w, dashboard: dashboard, live: live, class: "ss-btn w-full #{cmd == 'start' ? 'ss-btn-primary' : 'ss-btn-outline'}", form_class: "contents", "aria-label": label) do %><%= icon(ico, "size-4") %><span><%= label %></span><% end %>
        <% end %>
      </div>
    <% end %>

    <% if d["rooms"].any? %>
      <%= dw_command_form(p, "clean_rooms", w: w, dashboard: dashboard, live: live) do %>
        <fieldset>
          <legend class="ss-kicker mb-2"><%= t("dashboards.w.vac.rooms") %></legend>
          <%# Cômodos nos chips de marcar da gem (f.ss_chip_check_box). %>
          <div class="ss-chips flex-wrap overflow-visible">
            <%= ss_fields(nil) do |f| %>
              <% d["rooms"].each do |r| %>
                <%= f.ss_chip_check_box "value[rooms][]", label: r["name"], checked_value: r["id"], unchecked_value: nil, checked: false,
                                                          id: "#{uid}-room-#{r['id']}", disabled: !can %>
              <% end %>
            <% end %>
          </div>
        </fieldset>
        <% if d["settings"].any? %>
          <div class="mt-3 grid grid-cols-[repeat(auto-fit,minmax(9.5rem,1fr))] gap-2.5">
            <% d["settings"].each do |role, id| %>
              <% s = points[id] or next %>
              <%= ss_fields(nil) { |f| f.ss_select "value[#{role}]", Array(s["options"]), selected: s["value"], label: s["name"], id: "#{uid}-#{role}", disabled: !can, wrapper_class: "min-w-0" } %>
            <% end %>
          </div>
        <% end %>
        <% if can %>
          <%= render Ss::ButtonComponent.new(label: t("dashboards.w.vac.clean_selected"), icon: icon("play", "size-4"), type: :submit, block: true, css: "mt-3") %>
        <% end %>
      <% end %>
    <% end %>

    <% base = [ [ "wash_mop", t("dashboards.w.vac.wash_mop") ], [ "dry_mop", t("dashboards.w.vac.dry_mop") ], [ "empty", t("dashboards.w.vac.empty") ] ].select { |cmd, _| d["actions"].include?(cmd) } %>
    <% if can && base.any? %>
      <p class="ss-kicker mt-4"><%= t("dashboards.w.vac.dock") %></p>
      <div class="mt-2 grid grid-cols-[repeat(auto-fit,minmax(7.5rem,1fr))] gap-2">
        <% base.each do |cmd, label| %>
          <%= dw_command_button(p, cmd, w: w, dashboard: dashboard, live: live, class: "ss-btn ss-btn-outline w-full", form_class: "contents") do %><span><%= label %></span><% end %>
        <% end %>
      </div>
    <% end %>

    <% parts = d["parts"].filter_map { |id| points[id] } %>
    <% if parts.any? %>
      <p class="ss-kicker mt-4"><%= t("dashboards.w.vac.parts") %></p>
      <ul class="mt-2 grid grid-cols-[repeat(auto-fit,minmax(13rem,1fr))] gap-x-5 gap-y-2 text-sm text-ink-2">
        <% parts.each do |part| %>
          <% pct = part["value"].is_a?(Numeric) ? part["value"].clamp(0, 100) : nil %>
          <li class="grid grid-cols-[minmax(0,7.5rem)_1fr_2.6rem] items-center gap-2.5">
            <span class="min-w-0 truncate"><%= part["name"] %></span>
            <span class="ss-progress" aria-hidden="true"><span class="ss-progress-bar <%= 'bg-danger' if pct && pct < 20 %>" style="width: <%= pct || 0 %>%"></span></span>
            <span class="num text-right"><%= pct ? "#{pct.round}%" : "—" %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
  <% end %>
<% end %>
