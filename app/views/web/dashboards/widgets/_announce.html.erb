<%# locals: (w:, points:, dashboard:, live:) -%>
<%# "Falar na Alexa" (Alexa::Talk): Echo de destino, texto (Enter envia) e microfone (voz gravada, só em https). %>
<% d = w["data"] %>
<% targets = Array(d["targets"]) %>
<div class="ss-card ss-card-pad h-full" data-controller="announce" data-announce-url-value="<%= site_talk_path(dashboard.site_id) %>"
     data-announce-max-value="<%= Alexa::Talk::MAX_SECONDS %>"
     data-announce-sent-value="<%= t("dashboards.talk.sent") %>" data-announce-recording-value="<%= t("dashboards.talk.recording") %>"
     data-announce-mic-denied-value="<%= t("dashboards.talk.mic_denied") %>">
  <%= render Ss::CardHeaderComponent.new(title: w["label"].presence || t("dashboards.talk.title"), icon: icon(w["icon"].presence || "mdi:message-text-outline", "")) %>
  <% if targets.empty? %>
    <%= render Ss::NoteComponent.new(text: t("dashboards.talk.no_echo"), icon: icon("mdi:speaker", ""), css: "mt-3") %>
  <% elsif !d["can_command"] %>
    <%= render Ss::NoteComponent.new(text: t("dashboards.talk.no_permission"), icon: icon("lock-closed", ""), css: "mt-3") %>
  <% else %>
    <%# A Echo vai à frente do texto, na mesma linha: "para quem" e "o quê" se leem juntos. %>
    <%= ss_form_with url: site_talk_path(dashboard.site_id), class: "mt-3 flex gap-2", data: { action: "submit->announce#send" } do |f| %>
      <% if targets.size > 1 %>
        <%= f.ss_select :targets, [ [ t("dashboards.talk.all"), "all" ] ] + targets.map { |e| [ e["name"], e["id"] ] }, label: t("dashboards.talk.target"), hide_label: true,
                        id: "t_#{w['id']}", class: "w-auto", wrapper_class: "max-w-[40%] flex-none", data: { announce_target: "echo" } %>
      <% elsif targets.one? %>
        <%= hidden_field_tag :targets, targets.first["id"], id: nil, data: { announce_target: "echo" } %>
      <% end %>
      <%= f.ss_text_field :text, label: t("dashboards.talk.message"), hide_label: true, id: "m_#{w['id']}", maxlength: 250, autocomplete: "off",
                          placeholder: w["placeholder"].presence || t("dashboards.talk.placeholder"), data: { announce_target: "text" }, wrapper_class: "min-w-0 flex-1" %>
      <% if d["audio"] %>
        <%= render Ss::ButtonComponent.new(icon: icon("mdi:microphone", "size-5"), variant: :ghost, size: :sm, hidden: true, title: t("dashboards.talk.record"),
                                           aria: { label: t("dashboards.talk.record") }, data: { announce_target: "mic", action: "announce#record" }) %>
      <% end %>
      <%= render Ss::ButtonComponent.new(icon: icon("mdi:send", "size-4"), type: :submit, size: :sm, title: t("dashboards.talk.send"),
                                         aria: { label: t("dashboards.talk.send") }, data: { announce_target: "send" }) %>
    <% end %>
    <p class="mt-2 text-xs text-muted [&.is-error]:text-danger min-h-4" role="status" aria-live="polite" data-announce-target="status"></p>
  <% end %>
</div>
