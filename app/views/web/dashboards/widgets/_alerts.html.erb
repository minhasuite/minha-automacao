<%# locals: (w:, points:, dashboard:, live:) -%>
<%# Alertas abertos no Ss::NoticeCardComponent (tom pela gravidade, "Ciente" como ação). %>
<div class="ss-card ss-card-pad h-full">
  <%= render Ss::CardHeaderComponent.new(title: w["label"].presence || t("dashboards.w.alerts")) do |h| %>
    <% h.with_action { link_to t("dashboards.w.see_all"), alerts_path, class: "ss-btn ss-btn-ghost ss-btn-sm", data: { turbo_frame: "_top" } } %>
  <% end %>
  <% if w["data"]["alerts"].empty? %>
    <%= render Ss::NoteComponent.new(text: t("dashboards.w.no_alerts"), icon: icon("check-circle", ""), tone: :success, css: "mt-3") %>
  <% else %>
    <div class="mt-3 grid gap-2">
      <% w["data"]["alerts"].each do |a| %>
        <% acked = a["acked"] ? [ t("dashboards.w.acked") ] : [] %>
        <%= render Ss::NoticeCardComponent.new(title: a["title"], text: [ a["text"].presence, *acked ].compact.join(" · ").presence,
                                               tone: a["severity"] == "critical" ? :critical : :warn, time: t("dashboards.w.ago", time: dw_short_ago(Time.zone.parse(a["opened_at"].to_s))),
                                               icon: icon("exclamation-circle").to_s,
                                               actions: (a["can_ack"] && !a["acked"] ? [ { label: t("dashboards.w.acked"), url: ack_alert_path(a["id"]) } ] : [])) %>
      <% end %>
    </div>
  <% end %>
</div>
