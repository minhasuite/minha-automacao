<%# locals: (w:, points:, dashboard:, live:) -%>
<% d = w["data"] %>
<% p = points[Array(d["point_ids"]).first] %>
<% if p.nil? %>
  <%= render Ss::DeviceTileComponent.new(name: w["label"].presence || t("dashboards.w.media"), status: :unavailable, icon: icon("desktop-computer").to_s,
                                         unavailable_label: t("dashboards.w.not_found"), css: "h-full") %>
<% else %>
  <% m = d["media"] || {} %>
  <% off_line = p["quality"] != "good" %>
  <% can = p["can_command"] && !off_line %>
  <% c = Array(d["controls"]) %>
  <%# Os botões do player da gem são button_to sem params: o comando vai na query da URL (o form fica no quadro do widget). %>
  <% url = ->(cmd) { command_point_path(p["id"], **dw_command_params(cmd, w: w, dashboard: dashboard, live: live)) if can && c.include?(cmd) } %>
  <% state = off_line ? :unavailable : { "playing" => :playing, "paused" => :paused, "buffering" => :buffering }.fetch(m["state"].to_s, :idle) %>
  <% on = !m["state"].to_s.in?([ "off", "" ]) %>
  <div class="ss-card ss-card-pad h-full">
    <%= render Ss::CardHeaderComponent.new(title: link_to(dw_label(w, p), point_path(p["id"]), data: { turbo_frame: "_top" }),
                                           subtitle: off_line ? t("dashboards.w.offline") : (m["title"].present? ? PointsHelper::MEDIA_TEXT.fetch(m["state"].to_s, p["text"]) : p["text"]),
                                           icon: icon(w["icon"].presence || p["display_icon"].presence || "desktop-computer", ""), tone: (off_line ? :danger : :accent)) %>
    <%# Player da gem: liga/desliga no canto, volume (slider manda "value"), −/+ e mudo, e o "o que tocar" embaixo. %>
    <%= render Ss::MediaPlayerComponent.new(title: m["title"].presence, subtitle: [ m["artist"], m["album"] ].compact_blank.uniq.join(" · ").presence, art_url: dw_media_image(m),
                                            state: state, source: m["app"].presence, play_url: url.call("resume"), pause_url: url.call("pause"),
                                            previous_url: url.call("previous"), next_url: url.call("next"),
                                            power: (on if c.include?("on") || c.include?("off")), power_url: url.call(on ? "off" : "on"),
                                            volume: (m["volume"].to_f / 100 if c.include?("volume") && m["volume"].is_a?(Numeric)), volume_url: url.call("volume"), volume_param: "value",
                                            volume_up_url: url.call("volume_up"), volume_down_url: url.call("volume_down"), mute_url: url.call("mute"), muted: m["muted"],
                                            css: "is-flush mt-3",
                                            labels: { play: t("dashboards.w.mc.resume"), pause: t("dashboards.w.mc.pause"), previous: t("dashboards.w.mc.previous"), next: t("dashboards.w.mc.next"),
                                                      volume: t("dashboards.w.volume_x", name: p["name"]), mute: t("dashboards.w.mc.mute"), unmute: t("dashboards.w.mc.unmute"),
                                                      volume_up: t("dashboards.w.mc.volume_up"), volume_down: t("dashboards.w.mc.volume_down"),
                                                      power_on: t("dashboards.w.turn_on"), power_off: t("dashboards.w.turn_off") }) do |player| %>
      <% if url.call("play_media") %>
        <% player.with_media_picker do %>
          <%= dw_command_form(p, "play_media", w: w, dashboard: dashboard, live: live) do %>
            <div class="flex gap-2"><label for="pm-<%= w['id'] %>" class="sr-only"><%= t("dashboards.w.what_to_play") %></label>
              <input id="pm-<%= w['id'] %>" type="text" name="value" class="ss-input flex-1 min-w-0" maxlength="500" placeholder="<%= t("dashboards.w.play_hint") %>" required>
              <button class="ss-btn ss-btn-outline" type="submit"><%= icon("music-note", "size-4") %><%= t("dashboards.w.mc.resume") %></button></div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
