<%# locals: (fd:, node:, dom:, points:, site:) -%>
<% id = "#{dom}-#{fd.name}" %>
<% name = "block[#{fd.name}]" %>
<% v = node[fd.name] %>
<% wide = fd.kind.in?(%i[template expr days channels script_fields buttons prompt ai_output kv cameras points areas tags]) %>
<div class="<%= 'sm:col-span-2' if wide %> min-w-0">
  <% if fd.kind == :script_fields %>
    <% script = site.scripts.find_by(id: node["script"]) if node["script"].is_a?(String) %>
    <p class="ss-label"><%= fd.label %></p>
    <% if script.nil? %>
      <p class="text-sm text-muted"><%= t("automations.field.pick_script") %></p>
    <% elsif script.fields.empty? %>
      <p class="text-sm text-muted"><%= t("automations.field.no_fields") %></p>
    <% else %>
      <div class="grid gap-3 sm:grid-cols-2">
        <% script.fields.each do |sf| %>
          <div class="min-w-0">
            <label class="text-sm font-semibold text-ink block" for="<%= id %>-<%= sf['name'] %>"><%= sf["label"] %><%= " *" if sf["required"] && sf["default"].nil? %></label>
            <%= render "web/automations/field_input", fd: sf.merge("required" => false), name: "#{name}[#{sf['name']}]", value: v.to_h[sf["name"]], id: "#{id}-#{sf['name']}", site: site %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% elsif fd.kind.in?(%i[days channels bool]) %>
    <fieldset>
      <legend class="ss-label"><%= fd.label %></legend>
      <% if fd.kind == :days %>
        <%= hidden_field_tag "#{name}[]", "", id: nil %>
        <div class="flex flex-wrap gap-x-3 gap-y-1">
          <% Automations::Dsl.days.each_with_index do |d, i| %>
            <label class="inline-flex items-center gap-1 text-sm"><%= check_box_tag "#{name}[]", i, v.nil? || v.include?(i), id: "#{id}-#{i}" %><%= d %></label>
          <% end %>
        </div>
      <% elsif fd.kind == :channels %>
        <%= hidden_field_tag "#{name}[]", "", id: nil %>
        <div class="flex flex-wrap gap-x-3 gap-y-1">
          <% (fd.options == :speech ? Notifier.speech_choices(site) : Notifier.channel_choices(site)).each do |key, label| %>
            <label class="inline-flex items-center gap-1 text-sm"><%= check_box_tag "#{name}[]", key, v.nil? ? Notifier.default_channels.include?(key) : v.include?(key), id: "#{id}-#{key.parameterize}" %><%= label %></label>
          <% end %>
        </div>
      <% else %>
        <%= hidden_field_tag name, "0", id: nil %>
        <label class="inline-flex items-center gap-2 text-sm"><%= check_box_tag name, "1", v.nil? ? fd.name == "continue_on_timeout" : v, id: id %><%= t("automations.helper.yes_cap") %></label>
      <% end %>
    </fieldset>
  <% else %>
    <label class="ss-label" for="<%= id %>"><%= fd.label %></label>
    <% case_kind = fd.kind %>
    <% if case_kind.in?(%i[point writable_point]) %>
      <% list = points.values.uniq.select { |p| case_kind == :point || p.writable } %>
      <%= select_tag name, grouped_options_for_select(list.group_by { |p| p.device.name }.sort.map { |dev, ps| [ dev, ps.map { |p| [ p.name, p.id ] } ] }, v),
                     include_blank: t("automations.fields.pick_point"), class: "ss-input", id: id %>
    <% elsif case_kind == :value %>
      <% choices = dsl_value_choices(points[node["point"]]) %>
      <% if choices %>
        <%= select_tag name, options_for_select(choices, v.to_s), include_blank: (fd.name == "value" ? t("automations.field.no_value") : t("automations.field.any")), class: "ss-input", id: id %>
      <% else %>
        <%= text_field_tag name, v, class: "ss-input", id: id, placeholder: (fd.name == "value" ? "" : t("automations.field.any")) %>
      <% end %>
    <% elsif case_kind.in?(%i[device_trigger device_condition]) %>
      <% point = points[node["point"]] %>
      <% opts = case_kind == :device_trigger ? DeviceAutomations.triggers_for(point) : DeviceAutomations.conditions_for(point) %>
      <%= select_tag name, options_for_select(opts.invert, v), include_blank: (point ? false : t("automations.field.pick_point_first")), class: "ss-input", id: id %>
    <% elsif case_kind == :command %>
      <% point = points[node["point"]] %>
      <%= select_tag name, options_for_select(command_options(point), v), class: "ss-input", id: id %>
    <% elsif case_kind == :select %>
      <%= select_tag name, options_for_select(fd.choices.invert, v), include_blank: (fd.required ? false : t("automations.field.none")), class: "ss-input", id: id %>
    <% elsif case_kind.in?(%i[cameras points areas tags]) %>
      <% list = if case_kind == :areas then site.areas.order(:name).map { |a| [ a.name, a.id ] }
                elsif case_kind == :tags then Tag.order(:name).map { |t| [ t.name, t.id ] }
                else points.values.uniq.select { |p| case_kind == :points || p.capability == "stream" }.sort_by { |p| [ p.device.name, p.name ] }.map { |p| [ "#{p.device.name}: #{p.name}", p.id ] }
                end %>
      <%= hidden_field_tag "#{name}[]", "", id: nil %>
      <%= select_tag "#{name}[]", options_for_select(list, Array(v)), multiple: true, size: [ [ list.size, 2 ].max, 6 ].min, class: "ss-input", id: id %>
      <p class="text-xs text-muted mt-1"><%= t("automations.field.multi") %></p>
    <% elsif case_kind == :prompt %>
      <%= text_area_tag name, v, class: "ss-input", id: id, rows: 5, maxlength: Automations::Dsl::MAX_PROMPT, placeholder: t("automations.field.prompt_ph") %>
    <% elsif case_kind == :ai_output %>
      <%= text_area_tag name, (Ai::Output.text(v) if v), class: "ss-input num text-sm", id: id, rows: 3, spellcheck: false, placeholder: t("automations.field.ai_output_ph") %>
    <% elsif case_kind == :kv %>
      <%= text_area_tag name, v.to_h.map { |k, x| "#{k}: #{x}" }.join("\n"), class: "ss-input num text-sm", id: id, rows: 3, spellcheck: false, placeholder: t("automations.field.kv_ph") %>
    <% elsif case_kind == :dataset %>
      <%= select_tag name, options_for_select(site.datasets.order(:name).map { |d| [ d.name, d.id ] }, v), include_blank: t("automations.field.pick_dataset"), class: "ss-input", id: id %>
    <% elsif case_kind == :recipient %>
      <%= select_tag name, options_for_select(Notifier.recipient_choices(site), v), class: "ss-input", id: id %>
    <% elsif case_kind == :camera %>
      <%= select_tag name, options_for_select(points.values.uniq.select { |p| p.capability.in?(%w[stream detection]) }.map { |p| [ "#{p.device.name}: #{p.name}", p.id ] }, v), include_blank: t("automations.field.no_camera"), class: "ss-input", id: id %>
    <% elsif case_kind == :buttons %>
      <%= text_area_tag name, Array(v).map { |b| "#{b["id"]}: #{b["title"]}#{" -> #{[ b["point"], b["command"], b["value"] ].compact.join(" ")}" if b["point"]}" }.join("\n"), class: "ss-input", id: id, rows: 3, maxlength: 600, placeholder: t("automations.field.buttons_ph") %>
    <% elsif case_kind == :script %>
      <%= select_tag name, options_for_select(site.scripts.ordered.map { |s| [ s.name, s.id ] }, v), include_blank: t("automations.field.pick_script_short"), class: "ss-input", id: id %>
    <% elsif case_kind == :scene %>
      <%= select_tag name, options_for_select(site.scenes.order(:name).map { |s| [ s.name, s.id ] }, v), include_blank: t("automations.field.pick_scene"), class: "ss-input", id: id %>
    <% elsif case_kind == :alert_rule %>
      <%= select_tag name, options_for_select(site.alert_rules.order(:name).map { |r| [ r.name, r.id ] }, v), include_blank: t("automations.field.pick_rule"), class: "ss-input", id: id %>
    <% elsif case_kind == :time %>
      <%= time_field_tag name, v, class: "ss-input", id: id %>
    <% elsif case_kind == :template %>
      <%= text_area_tag name, v, class: "ss-input", id: id, rows: 2, maxlength: 500, placeholder: t("automations.field.template_ph") %>
    <% elsif case_kind == :secret %>
      <%= password_field_tag name, nil, class: "ss-input", id: id, maxlength: 500, autocomplete: "new-password", placeholder: (v ? t("automations.field.secret_kept") : t("automations.field.secret_ph")) %>
    <% elsif case_kind == :expr %>
      <%= text_field_tag name, v, class: "ss-input num text-sm", id: id, maxlength: 500, spellcheck: false, placeholder: t("automations.field.expr_ph") %>
    <% elsif case_kind == :number %>
      <%= text_field_tag name, v, class: "ss-input", id: id, inputmode: "decimal" %>
    <% else %>
      <%= text_field_tag name, v, class: "ss-input", id: id, maxlength: 500, placeholder: (case_kind == :duration ? "30s, 5m, 1h30m" : nil) %>
    <% end %>
  <% end %>
</div>
