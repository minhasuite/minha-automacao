<% published = params[:publicada] == "1" && @automation.published? %>
<%= render "web/shared/header", title: t("automations.edit.simulate"), subtitle: t("automations.simulate.subtitle", name: @automation.name), back: edit_automation_path(@automation) %>
<%= ss_form_with url: simulate_automation_path(@automation), method: :post, class: "ss-card ss-card-pad grid gap-4 max-w-3xl" do |f| %>
  <fieldset>
    <legend class="ss-label"><%= t("automations.simulate.what") %></legend>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("automations.index.draft"), simulate_automation_path(@automation), class: "ss-chip is-solid", "aria-current": (!published).to_s %>
      <% if @automation.published? %><%= link_to t("automations.simulate.published", version: @automation.version), simulate_automation_path(@automation, publicada: 1), class: "ss-chip is-solid", "aria-current": published.to_s %><% end %>
    </div>
    <%= hidden_field_tag :publicada, published ? "1" : "0", id: nil %>
  </fieldset>
  <div class="grid gap-3 sm:grid-cols-2">
    <%= f.ss_datetime_local_field :at, value: nil, id: "sim-at", label: t("automations.simulate.at") %>
    <%= f.ss_check_box :skip_conditions, checked_value: "1", unchecked_value: nil, checked: false, id: "sim-skip", label: t("automations.simulate.skip"), wrapper_class: "self-end pb-2" %>
  </div>
  <% if @points.any? %>
    <fieldset>
      <legend class="ss-label"><%= t("automations.simulate.values") %></legend>
      <div class="grid gap-3 sm:grid-cols-2">
        <% @points.each do |p| %>
          <% id = "sim-#{p.id}" %>
          <div class="min-w-0">
            <% lbl = safe_join([ p.name, " ", tag.span("· #{t('automations.simulate.now', value: point_value_text(p))}", class: "font-normal text-muted") ]) %>
            <% choices = dsl_value_choices(p) %>
            <% if choices %>
              <%= f.ss_select "points[#{p.key}]", options_for_select(choices), include_blank: t("automations.simulate.current"), id: id, label: lbl %>
            <% else %>
              <%= f.ss_text_field "points[#{p.key}]", value: nil, id: id, placeholder: p.value.to_s, inputmode: (p.numeric? ? "decimal" : nil), label: lbl %>
            <% end %>
          </div>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <div class="flex flex-wrap gap-2">
    <%= render Ss::ButtonComponent.new(label: t("automations.edit.simulate"), icon: icon("eye", "size-4"), type: :submit) %>
    <%= link_to t("automations.settings.cancel"), edit_automation_path(@automation), class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
