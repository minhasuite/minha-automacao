<% points = @site.points.includes(:device).ordered.to_a %>
<% by_id = points.index_by(&:id) %>
<% script = @automation.script? %>
<% noun = @automation.kind_label.downcase %>
<% risk = @automation.max_risk(@draft) %>
<% critical = risk == "critical" %>
<% status = [ (@automation.published? ? t("automations.edit.version_published", version: @automation.version) : t("automations.edit.never_published")), (@automation.enabled ? t("automations.edit.on") : t("automations.edit.off") unless script), (t("automations.edit.draft_changes") if @automation.draft?) ].compact %>
<%= render "web/shared/header", title: @automation.name, subtitle: "#{@site.name} · #{noun} · #{status.join(' · ')}", back: (script ? site_scripts_path(@site) : site_automations_path(@site)) do %>
  <%= link_to simulate_automation_path(@automation), class: "ss-btn ss-btn-outline" do %><%= icon("eye", "size-4") %><%= t("automations.edit.simulate") %><% end %>
  <% if @automation.published? %>
    <% if script && @automation.fields.any? %>
      <%= link_to run_automation_path(@automation), class: "ss-btn ss-btn-outline" do %><%= icon("play", "size-4") %><%= t("automations.edit.run") %><% end %>
    <% else %>
      <% run_risk = @automation.max_risk(@automation.definition) %>
      <%= button_to run_automation_path(@automation), params: { confirm_critical: (run_risk == "critical" ? "1" : nil) }.compact, class: "ss-btn ss-btn-outline",
                    form: { data: { turbo_confirm: t(script ? "automations.edit.run_confirm_script" : "automations.edit.run_confirm", version: @automation.version) + (run_risk == "critical" ? t("automations.edit.run_critical") : ""), turbo_confirm_button: t("automations.edit.run") } } do %><%= icon(script ? "play" : "lightning-bolt", "size-4") %><%= script ? t("automations.edit.run") : t("automations.edit.run_now") %><% end %>
    <% end %>
  <% end %>
  <% why = (@errors.any? ? t("automations.edit.why_errors") : (t("automations.edit.why_no_changes") if @automation.published? && !@automation.draft?)) %>
  <%= button_to publish_automation_path(@automation), params: { confirm_critical: (critical ? "1" : nil) }.compact, class: "ss-btn ss-btn-primary", disabled: why.present?, title: why, "aria-describedby": ("publish-why" if why),
                form: { data: { turbo_confirm: t("automations.edit.publish_confirm", version: @automation.version + 1) + (critical ? t("automations.edit.publish_critical") : ""), turbo_confirm_button: t("automations.edit.publish") } } do %><%= icon("upload", "size-4") %><%= t("automations.edit.publish") %><% end %>
  <% if why %><p id="publish-why" class="basis-full text-right text-xs text-muted sm:basis-auto"><%= why %></p><% end %>
<% end %>

<% if flash[:webhook_url] %>
  <div id="webhook" class="ss-card ss-card-pad mb-4 border border-accent" role="status">
    <p class="font-bold text-ink"><%= t("automations.edit.webhook_once") %></p>
    <p class="text-sm text-muted"><%= t("automations.edit.webhook_hint_html") %></p>
    <%= render Ss::CodeBlockComponent.new(text: flash[:webhook_url], label: "Webhook", class: "mt-2") %>
  </div>
<% end %>

<% if Shadow.active?(@automation) %>
  <%= render Ss::CalloutComponent.new(tone: :accent, icon: icon("moon", ""), title: "#{t("automations.common.in_shadow")}#{t("automations.edit.whole_site") unless @automation.shadow}.", class: "mb-4") do |c| %>
    <%= t("automations.edit.shadow_hint") %>
    <% c.with_action do %><%= link_to site_shadow_path(@site, automacao: @automation.id), class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("moon", "size-4") %><%= t("automations.edit.would_have_done") %><% end %><% end %>
  <% end %>
<% end %>

<% if @automation.blueprint_outdated? %>
  <%= render Ss::CalloutComponent.new(tone: :accent, icon: icon("information-circle", ""), class: "mb-4") do |c| %>
    <%= t("automations.edit.blueprint_changed_html", blueprint: link_to(@automation.blueprint.name, blueprint_path(@automation.blueprint)), version: @automation.blueprint.version) %>
    <% c.with_action do %><%= button_to rebuild_automation_path(@automation), class: "ss-btn ss-btn-ghost ss-btn-sm", form: { class: "contents" } do %><%= icon("refresh", "size-4") %><%= t("automations.edit.rebuild") %><% end %><% end %>
  <% end %>
<% end %>

<div class="grid gap-6 lg:grid-cols-3 items-start">
  <div class="lg:col-span-2 flex flex-col gap-4 min-w-0 ss-steps">
    <% if @errors.any? %>
      <%= render Ss::CalloutComponent.new(tone: :warn, title: t("automations.edit.missing")) do %>
        <ul><% @errors.first(8).each do |e| %><li><%= e %></li><% end %></ul>
      <% end %>
    <% end %>
    <% if critical %>
      <%= render(Ss::CalloutComponent.new(tone: :danger)) { t("automations.edit.critical") } %>
    <% end %>

    <% if script %><%= render "web/automations/fields", automation: @automation, points: points %><% end %>

    <% (script ? [ :actions ] : Automations::Dsl::KINDS).each do |kind| %>
      <section class="ss-card ss-card-pad" aria-labelledby="sec-<%= kind %>">
        <h2 id="sec-<%= kind %>" class="ss-steps-head"><%= script ? t("automations.edit.sequence") : t("automations.kind_titles.#{kind}") %></h2>
        <p class="text-sm text-muted mb-3"><%= script ? t("automations.edit.sequence_hint") : t("automations.kind_hints.#{kind}") %></p>
        <%= render "web/automations/list", list: Array(@draft[kind.to_s]), path: kind.to_s, kind: kind, points: by_id, automation: @automation %>
      </section>
    <% end %>
  </div>

  <aside class="flex flex-col gap-4 min-w-0">
    <section class="ss-card ss-card-pad" aria-label="<%= t("automations.edit.status") %>">
      <h2><%= t("automations.edit.status") %></h2>
      <p class="text-sm text-muted mt-1"><%= last_run_text(@automation) %><% if @automation.last_error.present? %> · <span class="text-danger"><%= @automation.last_error %></span><% end %></p>
      <div class="flex flex-wrap gap-2 mt-3">
        <% if script %>
          <p class="text-sm text-muted w-full"><%= t("automations.edit.script_how_html", key: Scripts.point_for(@automation)&.key) %></p>
        <% elsif @automation.published? %>
          <%= button_to (@automation.enabled ? t("automations.common.turn_off") : t("automations.common.turn_on")), automation_path(@automation), method: :patch, params: { automation: { enabled: !@automation.enabled } },
                        class: "ss-btn ss-btn-sm #{@automation.enabled ? 'ss-btn-ghost' : 'ss-btn-primary'}", form: { class: "contents" } %>
        <% else %>
          <p class="text-sm text-muted"><%= t("automations.edit.publish_to_enable") %></p>
        <% end %>
        <%= link_to automation_automation_runs_path(@automation), class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("view-list", "size-4") %><%= t("automations.common.runs") %><% end %>
      </div>
    </section>

    <% if @automation.blueprint %>
      <section class="ss-card ss-card-pad" aria-label="Blueprint">
        <h2>Blueprint</h2>
        <p class="text-sm text-muted mt-1"><%= t("automations.edit.created_from_html", blueprint: link_to(@automation.blueprint.name, blueprint_path(@automation.blueprint))) %></p>
        <ul class="text-sm mt-2 grid gap-1">
          <% @automation.blueprint.inputs.each do |input| %>
            <% v = @automation.blueprint_inputs.to_h[input["key"]] %>
            <li><span class="text-muted"><%= input["label"] %>:</span> <span class="font-semibold text-ink"><%= input["type"] == "point" ? (by_id[v]&.name || "—") : (v.nil? ? "—" : v.to_s) %></span></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <details class="ss-card ss-card-pad" <%= "open" if @automation.errors.any? %>>
      <summary class="ss-summary font-bold text-ink"><%= t("automations.edit.name_mode") %></summary>
      <div class="mt-3">
        <%= render layout: "web/automations/settings", locals: { automation: @automation, site: @site } do |f| %>
          <%= f.submit t("automations.settings.save"), class: "ss-btn ss-btn-outline" %>
        <% end %>
      </div>
    </details>

    <% if Array(@draft["triggers"]).any? { |tr| tr["type"] == "webhook" } %>
      <section class="ss-card ss-card-pad" aria-label="Webhook">
        <h2>Webhook</h2>
        <p class="text-sm text-muted mt-1"><%= @automation.webhook_token.present? ? t("automations.edit.webhook_has") : t("automations.edit.webhook_none") %></p>
        <%= button_to webhook_automation_path(@automation), class: "ss-btn ss-btn-outline ss-btn-sm mt-3",
                      form: { data: (@automation.webhook_token.present? ? { turbo_confirm: t("automations.edit.webhook_confirm") } : {}) } do %><%= icon("link", "size-4") %><%= @automation.webhook_token.present? ? t("automations.edit.webhook_again") : t("automations.edit.webhook_generate") %><% end %>
      </section>
    <% end %>

    <section class="ss-card ss-card-pad" aria-label="<%= t("automations.edit.versions") %>">
      <h2><%= t("automations.edit.versions") %></h2>
      <% versions = @automation.versions.includes(:author).limit(10).to_a %>
      <% if versions.empty? %>
        <p class="text-sm text-muted mt-1"><%= t("automations.edit.no_versions") %></p>
      <% else %>
        <ul class="mt-2 divide-y divide-line">
          <% versions.each do |v| %>
            <li class="py-2 flex items-center gap-2 text-sm">
              <span class="flex-1 min-w-0"><span class="font-semibold text-ink"><%= t("automations.edit.version", version: v.version) %></span> · <%= l(v.created_at, format: :short) %><%= " · #{v.author.name}" if v.author %></span>
              <% if v.version != @automation.version %>
                <%= button_to t("automations.edit.revert"), revert_automation_path(@automation), params: { version: v.version, confirm_critical: (@automation.max_risk(v.definition) == "critical" ? "1" : nil) }.compact,
                              class: "ss-btn ss-btn-ghost ss-btn-sm", form: { class: "contents", data: { turbo_confirm: t("automations.edit.revert_confirm", version: v.version) } } %>
              <% else %>
                <span class="ss-badge ss-badge-success"><%= t("automations.edit.current") %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="ss-card ss-card-pad flex flex-wrap gap-2" aria-label="<%= t("automations.edit.more") %>">
      <%= link_to json_automation_path(@automation), class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("document-text", "size-4") %><%= t("automations.edit.json") %><% end %>
      <%= link_to json_automation_path(@automation, formato: "yaml"), class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("code", "size-4") %>YAML<% end %>
      <% if @automation.draft? %>
        <%= button_to discard_automation_path(@automation), class: "ss-btn ss-btn-ghost ss-btn-sm", form: { class: "contents", data: { turbo_confirm: t("automations.edit.discard_confirm") } } do %><%= icon("reply", "size-4") %><%= t("automations.edit.discard") %><% end %>
      <% end %>
      <%= button_to automation_path(@automation), method: :delete, class: "ss-btn ss-btn-ghost ss-btn-sm text-danger", form: { class: "contents", data: { turbo_confirm_tone: "danger", turbo_confirm_button: t("shared.confirm.delete"), turbo_confirm: t("automations.edit.delete_confirm", noun: noun, name: @automation.name) } } do %><%= icon("trash", "size-4") %><%= t("automations.common.delete") %><% end %>
    </section>
  </aside>
</div>
