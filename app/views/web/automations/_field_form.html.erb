<%# locals: (automation:, fd:, index:, points:) -%>
<% dom = "fd-#{index || 'novo'}" %>
<% default = fd["type"] == "point" ? points[fd["default"]]&.key : fd["default"] %>
<%= ss_form_with url: fields_automation_path(automation), method: :patch, class: "grid gap-3 sm:grid-cols-2 mt-3" do |f| %>
  <%= hidden_field_tag :op, index ? "update" : "add", id: nil %>
  <% if index %><%= hidden_field_tag :index, index, id: nil %><% end %>
  <%= f.ss_text_field "field[name]", value: fd["name"], class: "num", id: "#{dom}-name", required: true, pattern: "[a-z_][a-z0-9_]*", placeholder: t("automations.fields.name_ph"), maxlength: 40, label: t("automations.fields.name") %>
  <%= f.ss_text_field "field[label]", value: fd["label"], id: "#{dom}-label", placeholder: t("automations.fields.label_ph"), maxlength: 80, label: t("automations.fields.label") %>
  <%= f.ss_select "field[type]", options_for_select(Automation::FIELD_TYPES.invert, fd["type"] || "text"), id: "#{dom}-type", label: t("automations.fields.type") %>
  <%= f.ss_text_field "field[default]", value: default, id: "#{dom}-default", placeholder: t("automations.fields.default_ph"), maxlength: 200, label: t("automations.fields.default_label") %>
  <%= f.ss_text_field "field[options]", value: Array(fd["options"]).join(", "), id: "#{dom}-options", placeholder: t("automations.fields.options_ph"), maxlength: 300, label: t("automations.fields.options"), wrapper_class: "sm:col-span-2" %>
  <%= f.ss_check_box "field[required]", checked_value: "1", unchecked_value: "0", checked: fd["required"].present?, id: "#{dom}-required", label: t("automations.fields.required_label") %>
  <div class="sm:col-span-2 flex flex-wrap gap-2">
    <%= f.ss_submit (index ? t("automations.fields.save") : t("automations.fields.add")), small: true %>
  </div>
<% end %>
<% if index %>
  <%= render Ss::ButtonComponent.new(label: t("automations.fields.remove"), icon: icon("trash", "size-4"), href: fields_automation_path(automation), method: :patch, params: { op: "remove", index: index },
                                     variant: :ghost, size: :sm, css: "text-danger mt-2", confirm: t("automations.fields.remove_confirm", label: fd["label"]), confirm_tone: :danger,
                                     confirm_button: t("automations.fields.remove")) %>
<% end %>
