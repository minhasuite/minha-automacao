<%# locals: (list:, path:, kind:, points:, automation:) -%>
<% if list.any? %>
  <ol class="grid gap-3" aria-label="<%= kind == :options ? 'Opções' : AutomationsHelper::KIND_TITLES.fetch(kind, 'Blocos') %>">
    <% list.each_with_index do |node, i| %>
      <%= render "web/automations/block", node: node, path: "#{path}.#{i}", kind: kind, points: points, automation: automation, first: i.zero?, last: i == list.size - 1 %>
    <% end %>
  </ol>
<% end %>
<% if can?(:manage) %>
  <%= form_with url: draft_automation_path(automation), method: :patch, class: "flex flex-wrap items-center gap-2 #{'mt-3' if list.any?}" do %>
    <%= hidden_field_tag :op, "add", id: nil %><%= hidden_field_tag :target, path, id: nil %>
    <% if kind == :options %>
      <%= button_tag type: "submit", class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("plus", "size-4") %>Adicionar opção<% end %>
    <% else %>
      <label class="sr-only" for="add-<%= path.tr('.', '-') %>">Tipo do bloco novo</label>
      <%= select_tag :type, options_for_select(dsl_type_choices(kind)), class: "ss-input w-auto min-w-0 flex-1 sm:flex-none", id: "add-#{path.tr('.', '-')}" %>
      <%= button_tag type: "submit", class: "ss-btn ss-btn-outline ss-btn-sm" do %><%= icon("plus", "size-4") %>Adicionar<% end %>
    <% end %>
  <% end %>
<% end %>
