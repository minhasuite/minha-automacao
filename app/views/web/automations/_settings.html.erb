<%# locals: (automation:, site:) -%>
<%# Nome, modo e organização da automação ou do script; o bloco (de new e edit) traz as ações: yield f. -%>
<% list = automation.script? ? site_scripts_path(site) : site_automations_path(site) %>
<%= ss_form_with model: automation, scope: :automation, url: (automation.new_record? ? list : automation_path(automation)), class: "ss-card ss-card-pad grid gap-4 sm:grid-cols-2" do |f| %>
  <%= render "web/shared/errors", record: automation %>
  <div class="sm:col-span-2"><%= f.ss_text_field :name, label: t("automations.settings.name"), required: true, maxlength: 120, autofocus: automation.new_record?,
                                                 placeholder: (automation.script? ? t("automations.settings.name_ph_script") : t("automations.settings.name_ph")) %></div>
  <%= f.ss_select :mode, Automation::MODES.invert, label: t(automation.script? ? "automations.settings.mode_script" : "automations.settings.mode") %>
  <%= f.ss_number_field :max_runs, label: t("automations.settings.max_runs"), min: 1, max: 50 %>
  <%= f.ss_select :area_id, site.areas.order(:position, :name).map { |a| [ a.name, a.id ] }, label: t("automations.settings.area"), include_blank: t("automations.settings.none") %>
  <div class="sm:col-span-2"><%= render "web/shared/icon_picker", name: "automation[icon]", selected: automation.icon, icons: HelperTypes::ICONS, id: "automation_icon" %></div>
  <%= render "web/shared/organize_fields", f: f, record: automation, categories: category_options(automation.script? ? site.scripts : site.automations) %>
  <div class="sm:col-span-2"><%= f.ss_check_box :shadow, label: t("automations.settings.shadow"),
                                                help: (t("automations.settings.site_shadow", kind: automation.kind_label.downcase) if Shadow.site?(site)) %></div>
  <div class="sm:col-span-2"><%= f.ss_text_area :description, label: t("automations.settings.description"), rows: 2, maxlength: 1000 %></div>
  <div class="sm:col-span-2 flex flex-wrap gap-2"><%= yield f %></div>
<% end %>
