<%# locals: (site:, current:) -%>
<%= render "web/sites/tabs", site: site, current: :automation, css: "max-sm:!hidden" %>
<%= link_to site_path(site), class: "ss-chip mb-2 sm:!hidden", "aria-label": t("automations.tabs.back_to", name: site.name) do %><%= icon("arrow-left", "size-4") %><%= site.name %><% end %>
<%= render Ss::TabsComponent.new(label: t("automations.index.title"), id: "automation-tabs", css: "mb-4") do |tabs| %>
  <% [ [ t("automations.tabs.automations"), site_automations_path(site), "lightning-bolt", :automations ], [ t("automations.tabs.scenes"), site_scenes_path(site), "sparkles", :scenes ],
       [ t("automations.tabs.scripts"), site_scripts_path(site), "play", :scripts ], [ t("automations.tabs.blueprints"), site_blueprints_path(site), "duplicate", :blueprints ],
       [ t("automations.tabs.rules"), rules_site_path(site), "clock", :rules ], [ t("automations.tabs.shadow"), site_shadow_path(site), "moon", :shadow ] ].each do |label, path, ico, key| %>
    <% tabs.with_tab(label: label, icon: icon(ico, ""), href: path, current: key == current, id: key.to_s) %>
  <% end %>
<% end %>
