<%= render "web/shared/header", title: t("automations.index.title"), subtitle: t("automations.index.subtitle", site: @site.name) do %>
  <% if can?(:manage) %>
    <%= link_to site_blueprints_path(@site), class: "ss-btn ss-btn-ghost" do %><%= icon("duplicate", "size-4") %><%= t("automations.index.from_blueprint") %><% end %>
    <%= link_to new_site_automation_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("automations.index.new") %><% end %>
  <% end %>
<% end %>
<%= render "web/automations/tabs", site: @site, current: :automations %>

<% if @total.zero? %>
  <%= render Ss::EmptyStateComponent.new(title: t("automations.index.empty"), css: "ss-card",
                                         text: safe_join([ t("automations.index.empty_example"), " ", t("automations.index.empty_hint_html", blueprint: link_to(t("automations.index.empty_blueprint"), site_blueprints_path(@site)), rules: link_to(t("automations.index.empty_rules"), rules_site_path(@site))) ])) do %>
    <% if can?(:manage) %><%= link_to new_site_automation_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("automations.index.create_first") %><% end %><% end %>
  <% end %>
<% else %>
  <%# Filtros da gem: busca, chips dos ativos e "+ Filtro" (uma linha no celular, em vez de quatro campos). %>
  <% pair = ->(o) { o.is_a?(Array) ? o : [ o, o ] } %>
  <%= render Ss::FilterBarComponent.new(url: site_automations_path(@site), search: :q, placeholder: t("automations.index.search_placeholder"), css: "mb-3",
                                        filters: [ { param: :estado, label: t("automations.index.state"), options: [ [ t("automations.index.active"), "ativas" ], [ t("automations.index.inactive"), "desativadas" ] ] },
                                                   { param: :area, label: t("automations.index.area"), options: @site.areas.order(:position, :name).map { |a| [ a.name, a.id ] } },
                                                   ({ param: :rotulo, label: t("automations.index.label"), options: @labels.map(&pair) } if @labels.any?),
                                                   ({ param: :categoria, label: t("automations.index.category"), options: @categories.map(&pair) } if @categories.any?) ].compact) %>

  <% if @automations.empty? %>
    <%= render Ss::EmptyStateComponent.new(title: t("automations.index.no_match"), variant: :busca, css: "ss-card") do %><%= link_to t("automations.common.clear_filters"), site_automations_path(@site), class: "ss-btn ss-btn-ghost" %><% end %>
  <% else %>
    <div data-controller="ss-table" data-ss-table-key-value="automations">
    <% site_shadow = Shadow.site?(@site) %>
    <% groups = category_groups(@automations) %>
    <% groups.each do |category, items| %>
    <%= render layout: "web/shared/category_group", locals: { name: category, count: items.size, grouped: groups.size > 1 || category } do %>
    <ul class="ss-card ss-rows" aria-label="<%= t("automations.index.list") %><%= " · #{category}" if category %>">
      <% items.each do |a| %>
        <li id="automation-<%= a.id %>">
          <% if can?(:manage) %><%= ss_fields do |f| %><%= f.ss_check_box "ids[]", checked_value: a.id, unchecked_value: nil, id: "bulk-row-#{a.id}", form: "bulk", label: t("automations.common.mark", name: a.name), hide_label: true, data: { ss_table_target: "check", action: "ss-table#toggleRow" } %><% end %><% end %>
          <%# No celular o ícone sai (a chave já diz se está ligada) e o texto encolhe: chave e execuções ficam na linha do nome. %>
          <span class="ss-icon-tile max-sm:hidden <%= a.enabled ? 'is-grad' : 'is-muted' %>"><%= icon(a.icon.presence_in(HelperTypes::ICONS) || "lightning-bolt") %></span>
          <div class="min-w-0 flex-1 basis-36 sm:basis-48">
            <p class="font-bold text-ink break-words"><%= link_to a.name, (can?(:manage) ? edit_automation_path(a) : automation_automation_runs_path(a)), class: "text-ink no-underline hover:text-accent" %>
              <% unless a.enabled %> <span class="ss-badge ss-badge-warn"><%= a.published? ? t("automations.index.off") : t("automations.index.draft") %></span><% end %>
              <% if a.draft? && a.published? %> <span class="ss-badge"><%= t("automations.index.draft_changes") %></span><% end %>
              <% if a.blueprint_outdated? %> <span class="ss-badge ss-badge-accent"><%= t("automations.index.blueprint_changed") %></span><% end %>
              <% if a.shadow || site_shadow %> <span class="ss-badge ss-badge-accent"><%= icon("moon", "size-3 inline") %><%= t("automations.common.in_shadow") %></span><% end %></p>
            <p class="text-sm text-muted break-words"><%= [ a.area&.name, a.mode_label.split(" (").first ].compact.join(" · ") %> <%= label_chips(a) %></p>
            <p class="text-xs text-muted"><%= t("automations.index.last_run", text: last_run_text(a).downcase) %></p>
            <% if a.last_error.present? %><p class="text-sm text-danger mt-1 flex gap-1"><%= icon("exclamation-circle", "size-4 shrink-0 mt-0.5") %><span><%= a.last_error %></span></p><% end %>
          </div>
          <%# Quem não edita abre as execuções pelo nome: sem botão repetido (a lista fica curta com 50+ automações). %>
          <% if can?(:manage) %>
          <div class="flex items-center justify-end gap-2 max-sm:ml-auto">
            <%= link_to automation_automation_runs_path(a), class: "ss-btn ss-btn-ghost ss-btn-sm", "aria-label": t("automations.index.runs_of", name: a.name), title: t("automations.common.runs") do %><%= icon("view-list", "size-4") %><span class="max-sm:hidden"><%= t("automations.common.runs") %></span><% end %>
            <% if a.published? %>
              <%= render Ss::SwitchComponent.new(url: automation_path(a), method: :patch, params: { automation: { enabled: !a.enabled }, back: request.fullpath }, on: a.enabled, label: a.name, id: "automation-switch-#{a.id}") %>
            <% end %>
          </div>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% end %>
    <% end %>
    <% if can?(:manage) %>
      <div class="ss-selection-bar" role="region" aria-label="<%= t("automations.index.bulk_actions") %>" hidden data-ss-table-target="bar">
        <span><b data-ss-table-target="count">0</b> <%= t("automations.index.marked") %></span>
        <%= ss_form_with url: bulk_site_automations_path(@site), id: "bulk", class: "ss-dt-bulk" do |f| %>
          <%= hidden_field_tag :back, request.fullpath, id: nil %>
          <%= f.ss_check_box :all, name: nil, unchecked_value: nil, id: "bulk-all", label: t("automations.index.mark_all"), wrapper_class: "text-sm ml-3", data: { ss_table_target: "all", action: "ss-table#toggleAll" } %>
          <%= f.ss_select :op, options_for_select([ [ t("automations.common.turn_on"), "enable" ], [ t("automations.common.turn_off"), "disable" ], [ t("automations.index.shadow_on"), "shadow_on" ], [ t("automations.index.shadow_off"), "shadow_off" ], [ t("automations.common.delete"), "delete" ] ]), id: "bulk-op", class: "w-auto min-h-0 py-1.5", wrapper_class: "ml-2", label: t("automations.index.bulk_action"), hide_label: true %>
          <%= render Ss::ButtonComponent.new(label: t("automations.index.apply"), type: :submit, confirm: t("automations.index.apply_confirm"), confirm_button: t("automations.index.apply_button")) %>
        <% end %>
        <%= render Ss::IconButtonComponent.new(icon: icon("x", "size-4"), label: t("automations.index.clear_selection"), size: :sm, data: { action: "ss-table#clear" }) %>
      </div>
    <% end %>
    </div>
  <% end %>
<% end %>
