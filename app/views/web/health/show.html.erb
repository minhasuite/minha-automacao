<% overall = t("health.overall.#{@status}", default: "") %>
<%= render "web/shared/header", title: t("ai_settings.title"), subtitle: t("health.subtitle") %>
<%= render layout: "web/settings/frame", locals: { current: :health } do %>
<section class="ss-card ss-card-pad flex flex-wrap items-center justify-between gap-3" aria-labelledby="health-t">
  <div class="min-w-0">
    <h2 id="health-t" class="flex items-center gap-2"><%= icon("shield-check", "size-5 text-accent") %><%= t("health.title") %></h2>
    <p class="text-sm text-muted mt-1"><%= t("health.checked") %></p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <% if QueueMonitor.visible_to?(current_user) %>
      <%= link_to settings_queue_path, class: "ss-btn ss-btn-ghost ss-btn-sm", data: { health_link: "queue" } do %><%= icon("clock", "size-4") %><%= t("queue.from_health") %><% end %>
    <% end %>
    <%= link_to settings_health_checks_path, class: "ss-btn ss-btn-ghost ss-btn-sm", data: { health_link: "custom" } do %><%= icon("adjustments", "size-4") %><%= t("custom.health.title") %><% end %>
    <span class="ss-badge ss-badge-<%= Health::TONES[@status] %>"><%= overall %></span>
  </div>
</section>

<% if @drive %>
  <% at = @drive[:status]["uploaded_at"].presence && Time.zone.parse(@drive[:status]["uploaded_at"]) %>
  <section class="ss-card ss-card-pad mt-4 flex flex-wrap items-center justify-between gap-3" aria-labelledby="drive-t" data-health="google-drive">
    <div class="min-w-0">
      <h2 id="drive-t" class="flex items-center gap-2 font-bold"><%= icon("download", "size-5 text-accent") %><%= t("health.drive.title") %></h2>
      <% if @drive[:connected] %>
        <p class="text-sm text-ink mt-1 break-words"><%= @drive[:email] ? t("health.drive.connected_as", email: @drive[:email], folder: Backups::Destinations::GoogleDrive::FOLDER) : t("health.drive.connected", folder: Backups::Destinations::GoogleDrive::FOLDER) %></p>
        <p class="text-sm text-muted break-words">
          <%= at ? t("health.drive.last", at: l(at, format: :short)) : t("health.drive.none") %>
          <% if (used = @drive[:status]["destination"].to_s[/\AGoogle Drive: .* · (.+)\z/, 1]) %> · <%= t("health.drive.used") %> <%= used %><% end %>
        </p>
        <% unless Backups.passphrase %><p class="text-sm text-warn mt-1"><%= t("health.drive.no_pass") %></p><% end %>
      <% else %>
        <p class="text-sm text-muted mt-1"><%= t("health.drive.pitch") %></p>
      <% end %>
    </div>
    <% if @drive[:connected] %>
      <%= button_to settings_health_drive_path, method: :delete, class: "ss-btn ss-btn-ghost",
                    form: { data: { turbo_confirm_tone: "danger", turbo_confirm: t("health.drive.confirm"), turbo_confirm_button: t("health.drive.disconnect") } } do %><%= t("health.drive.disconnect") %><% end %>
    <% else %>
      <%= link_to t("health.drive.connect"), @drive[:auth_url], class: "ss-btn ss-btn-primary", data: { turbo: false } %>
    <% end %>
  </section>
<% end %>

<div class="mt-4 grid gap-4 xl:grid-cols-2">
  <% @results.each do |r| %>
    <section class="ss-card ss-card-pad min-w-0" aria-labelledby="hc-<%= r.check.key %>" data-health="<%= r.check.key %>">
      <div class="flex items-center justify-between gap-3">
        <h3 id="hc-<%= r.check.key %>" class="flex items-center gap-2 font-bold"><%= icon(r.check.icon, "size-5 text-accent") %><%= r.check.label %></h3>
        <span class="ss-badge ss-badge-<%= Health::TONES[r.status] %>"><%= Health.label(r.status) %></span>
      </div>
      <ul class="mt-3 divide-y divide-line">
        <% r.items.each do |i| %>
          <li class="py-2 flex items-start gap-3 <%= "opacity-60" if i.ignored %>">
            <%= icon({ "ok" => "check-circle", "warn" => "exclamation-circle", "error" => "x-circle" }[i.status], "size-5 shrink-0 mt-0.5 #{{ 'ok' => 'text-success', 'warn' => 'text-warn', 'error' => 'text-danger' }[i.status]}") %>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-ink break-words"><%= i.title %><span class="sr-only"> (<%= Health.label(i.status) %>)</span></p>
              <% if i.detail.present? %><p class="text-sm text-muted break-words"><%= i.detail %></p><% end %>
              <% if i.problem? %>
                <div class="mt-1.5 flex flex-wrap items-center gap-2" data-repair="<%= r.check.key %>:<%= i.key %>">
                  <% if i.ignored %><span class="ss-badge ss-badge-muted"><%= t("repairs.ignored_badge") %></span><% end %>
                  <% if i.fix && !i.ignored %><%= link_to i.fix[:url], class: "ss-btn ss-btn-outline ss-btn-sm" do %><%= icon("pencil", "size-4") %><%= i.fix[:label] %><% end %><% end %>
                  <% if r.check.repairs? && !i.ignored %>
                    <%= button_to settings_health_repair_path(check: r.check.key, item: i.key), class: "ss-btn ss-btn-primary ss-btn-sm" do %><%= icon("refresh", "size-4") %><%= t("repairs.fix") %><% end %>
                  <% end %>
                  <%= button_to settings_health_ignore_path(ref: "#{r.check.key}:#{i.key}", on: i.ignored ? "0" : "1"), class: "ss-btn ss-btn-ghost ss-btn-sm",
                                "aria-label": t(i.ignored ? "repairs.show_of" : "repairs.ignore_of", title: i.title) do %><%= t(i.ignored ? "repairs.show" : "repairs.ignore") %><% end %>
                </div>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
<% end %>
