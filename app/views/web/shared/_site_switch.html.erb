<%# locals: (sites:, site:, path:) -%>
<% if sites.size > 1 %>
  <nav class="flex flex-wrap gap-2 mb-4" aria-label="Local">
    <% sites.each do |s| %>
      <%= link_to s.name, "#{path}?site_id=#{s.id}", class: "ss-chip no-underline", "aria-current": (s.id == site.id ? "true" : nil) %>
    <% end %>
  </nav>
<% end %>
