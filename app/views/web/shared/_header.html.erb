<%# locals: (title:, subtitle: nil, back: nil, badge: nil, view_transition: nil) -%>
<%# Cabeçalho da tela: Ss::PageComponent só com o topo (o corpo segue na view, depois). O bloco são as ações.
    view_transition: o registro cujo card da lista vira este cabeçalho (ss_view_transition_attrs na lista). -%>
<% content_for :title, title %>
<% actions = capture { yield }.presence %>
<%= render Ss::PageComponent.new(title: title, subtitle: subtitle, back: back, back_label: t("layout.back"), view_transition: view_transition, css: "mb-6") do |p| %>
  <% p.with_badge { badge } if badge.present? %>
  <% p.with_actions { actions } if actions %>
<% end %>
