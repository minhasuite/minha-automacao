<%# Avisos da requisição na pilha da gem (#ss-toasts): o de sucesso some sozinho, o de erro
    fica até fechar. Resposta em Turbo Stream empilha com Ss::ToastStackComponent.append(turbo_stream, message:, tone:). %>
<% toasts = { notice: :good, alert: :bad }.filter_map { |key, tone| { message: flash[key], tone: tone, sticky: tone == :bad } if flash[key].present? } %>
<%= render Ss::ToastStackComponent.new(toasts: toasts) %>
