<%# locals: (name:, count:, grouped:) -%>
<%# ondaA1 (A2): bloco recolhível de uma categoria (sem categorias, só o conteúdo). -%>
<% if grouped %>
  <details class="ss-group mb-4" open>
    <summary class="ss-group-head"><%= icon("chevron-right", "size-4 ss-group-caret") %><span class="font-bold text-ink"><%= name || "Sem categoria" %></span><span class="ss-badge"><%= count %></span></summary>
    <%= yield %>
  </details>
<% else %>
  <%= yield %>
<% end %>
