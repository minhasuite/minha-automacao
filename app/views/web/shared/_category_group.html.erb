<%# locals: (name:, count:, grouped:) -%>
<%# ondaA1 (A2): bloco recolhível de uma categoria (sem categorias, só o conteúdo). Ss::CollapsibleComponent da gem (era .ss-group, que na gem é o título de lista). -%>
<% if grouped %>
  <%= render Ss::CollapsibleComponent.new(title: name || t("shared.organize.no_category"), count: count, open: true, css: "mb-4") do %>
    <%= yield %>
  <% end %>
<% else %>
  <%= yield %>
<% end %>
