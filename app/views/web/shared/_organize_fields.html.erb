<%# locals: (f:, record:, categories: nil, span: "sm:col-span-2") -%>
<%# ondaA1 (A2): rótulos (todos os modelos) e categoria (listas que agrupam). O ss_fields com o mesmo
    escopo do f serve a quem chama com o formulário comum ou o da gem (mesmos name/id). -%>
<% list_id = "labels-#{record.class.name.underscore}" %>
<%= ss_fields(f.object_name, model: f.object) do |o| %>
  <%= o.ss_text_field :label_list, label: t("shared.organize.labels"), wrapper_class: (categories ? nil : span), maxlength: 300, placeholder: t("shared.organize.labels_ph"), list: list_id, autocomplete: "off" %>
  <datalist id="<%= list_id %>"><% Tag.order(:name).limit(200).pluck(:name).each do |n| %><option value="<%= n %>"></option><% end %></datalist>
  <% if categories %>
    <%= o.ss_text_field :category, label: t("shared.organize.category"), maxlength: 60, placeholder: t("shared.organize.category_ph"), list: "#{list_id}-cat", autocomplete: "off" %>
    <datalist id="<%= list_id %>-cat"><% categories.each do |c| %><option value="<%= c %>"></option><% end %></datalist>
  <% end %>
  <% if record.respond_to?(:alias_list) %>
    <%= o.ss_text_field :alias_list, label: t("shared.organize.aliases"), wrapper_class: span, maxlength: 600, placeholder: t("shared.organize.aliases_ph") %>
  <% end %>
<% end %>
