<%# locals: (art: "board", title:, text: nil) -%>
<%# Estado vazio ilustrado (uiweb): SVG próprio, só com as cores do tema (accent, field, line). %>
<div class="ss-empty-art">
  <svg viewBox="0 0 160 110" class="ss-empty-svg" aria-hidden="true" focusable="false">
    <ellipse cx="80" cy="100" rx="62" ry="6" class="ss-ea-shadow"/>
    <% case art %>
    <% when "plan" %>
      <rect x="22" y="14" width="116" height="80" rx="8" class="ss-ea-paper"/>
      <path d="M22 54h52V14M74 54v40M74 70h64M106 14v40" class="ss-ea-wall"/>
      <rect x="30" y="22" width="36" height="24" rx="4" class="ss-ea-room"/>
      <circle cx="48" cy="34" r="5" class="ss-ea-dot ss-ea-pulse"/>
      <circle cx="120" cy="32" r="4" class="ss-ea-dot2"/>
      <circle cx="96" cy="82" r="4" class="ss-ea-dot2"/>
      <path d="M118 74l10 10m0-10l-10 10" class="ss-ea-wall" opacity=".35"/>
    <% when "search" %>
      <rect x="26" y="20" width="108" height="20" rx="10" class="ss-ea-paper"/>
      <circle cx="40" cy="30" r="5" class="ss-ea-wall"/>
      <path d="M44 34l4 4" class="ss-ea-wall"/>
      <rect x="54" y="27" width="46" height="6" rx="3" class="ss-ea-room"/>
      <rect x="34" y="50" width="92" height="12" rx="6" class="ss-ea-room"/>
      <rect x="34" y="68" width="70" height="12" rx="6" class="ss-ea-room" opacity=".6"/>
      <circle cx="124" cy="74" r="5" class="ss-ea-dot ss-ea-pulse"/>
    <% else %>
      <rect x="24" y="16" width="52" height="34" rx="8" class="ss-ea-paper"/>
      <rect x="84" y="16" width="52" height="34" rx="8" class="ss-ea-room"/>
      <rect x="24" y="58" width="112" height="34" rx="8" class="ss-ea-paper"/>
      <circle cx="40" cy="33" r="7" class="ss-ea-dot ss-ea-pulse"/>
      <rect x="52" y="29" width="16" height="4" rx="2" class="ss-ea-room"/>
      <path d="M36 82l14-10 12 6 16-12 14 8 16-10 12 6" class="ss-ea-wall"/>
      <path d="M110 22v22M99 33h22" class="ss-ea-wall" opacity=".5"/>
    <% end %>
  </svg>
  <p class="font-bold text-ink"><%= title %></p>
  <% if text %><p class="mt-1 text-sm text-muted"><%= text %></p><% end %>
</div>
