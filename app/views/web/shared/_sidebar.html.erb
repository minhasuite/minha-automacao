<%# Menu lateral escuro (padrão da suíte). %>
<aside id="side" class="ss-side fixed inset-y-0 left-0 z-50 w-64 flex flex-col shadow-xl -translate-x-full lg:translate-x-0 transition-all duration-300" data-menu-target="panel" aria-label="Menu">
  <div class="flex items-center justify-between h-14 px-3 border-b border-white/10 shrink-0">
    <%= link_to root_path, class: "flex items-center gap-2.5 min-w-0 no-underline text-white font-bold" do %>
      <span class="grid place-items-center size-8 shrink-0 rounded-xl ss-grad shadow-lg shadow-black/30"><%= icon("lightning-bolt", "size-4") %></span>
      <span class="ss-side-label truncate">Minha Automação</span>
    <% end %>
    <button type="button" class="ss-side-label hidden lg:grid place-items-center size-7 rounded-lg border-0 bg-transparent text-white/50 hover:text-white hover:bg-white/10 cursor-pointer" data-action="menu#collapse" title="Recolher menu" aria-label="Recolher menu"><%= icon("chevron-left", "size-4") %></button>
    <button type="button" class="lg:hidden grid place-items-center size-8 rounded-lg border-0 bg-transparent text-white/70 hover:text-white cursor-pointer" data-action="menu#close" aria-label="Fechar menu"><%= icon("x", "size-5") %></button>
  </div>
  <button type="button" class="ss-expand hidden mx-auto mt-2 size-8 place-items-center rounded-lg border-0 bg-transparent text-white/50 hover:text-white hover:bg-white/10 cursor-pointer" data-action="menu#collapse" title="Expandir menu" aria-label="Expandir menu"><%= icon("chevron-right", "size-4") %></button>
  <nav class="ss-nav ss-side-scroll flex-1 overflow-y-auto px-2 py-4 space-y-1" aria-label="Principal">
    <%= nav_link "Início", root_path, icon: "lightning-bolt" %>
    <% Dashboard.sidebar_for(current_user).each do |d| %><%= nav_link d.name, dashboard_path(d), icon: d.icon_name %><% end %>
    <% unless (reader = current_user.reader?) %>
      <%= nav_link "Locais", sites_path, icon: "home" %>
      <%= nav_link "Alertas", alerts_path, icon: "exclamation-circle", badge: Alert.active.where(acked_at: nil, site_id: Site.visible_to(current_user).select(:id)).count %>
      <%= nav_link "Perguntar à casa", ask_path, icon: "sparkles" %>
    <% end %>
    <%= nav_link "Notificações", notifications_path, icon: "bell", badge: Notification.for_user(current_user).unread.count %>
    <%= nav_link reader ? "Minha conta" : "Configurações", reader ? settings_account_path : settings_path, icon: "cog", class: "mt-3" %>
  </nav>
  <div class="shrink-0 border-t border-white/10 p-2">
    <div class="flex items-center gap-3 rounded-lg px-2 py-2">
      <span class="grid place-items-center size-8 shrink-0 rounded-full text-sm font-bold text-white ring-2 ring-white/10" style="background: linear-gradient(135deg, rgba(123, 92, 255, .55), rgba(59, 130, 246, .45))"><%= current_user.name.to_s[0]&.upcase %></span>
      <div class="ss-side-label min-w-0 flex-1">
        <p class="truncate text-sm font-semibold text-white"><%= current_user.name %></p>
        <p class="truncate text-xs text-white/50"><%= current_user.email %></p>
      </div>
      <span class="ss-side-label rounded-full px-2 py-0.5 text-[10px] font-semibold text-white/60 ring-1 ring-white/25"><%= current_user.role_label %></span>
    </div>
    <div class="ss-side-label mt-1 grid grid-cols-3 gap-1 text-xs">
      <button type="button" class="flex items-center justify-center gap-1.5 rounded-lg py-2 border-0 bg-transparent text-white/70 hover:text-white hover:bg-white/10 cursor-pointer" data-action="theme#toggle"><%= icon("moon", "size-4") %>Tema</button>
      <%= render "web/shared/privacy_button", css: "flex items-center justify-center gap-1.5 rounded-lg py-2 hover:text-white hover:bg-white/10", label: "Valores" %>
      <%= button_to logout_path, method: :delete, class: "w-full flex items-center justify-center gap-1.5 rounded-lg py-2 border-0 bg-transparent text-white/70 hover:text-white hover:bg-white/10 cursor-pointer", form: { class: "contents" } do %><%= icon("logout", "size-4") %>Sair<% end %>
    </div>
  </div>
</aside>
