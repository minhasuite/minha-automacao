<%# Idioma da tela (produto): troca na hora (cookie; com sessão, também na pessoa). Sem Turbo (form: da gem):
    a página volta inteira no idioma novo (lang do <html> e textos do JS). Sem bandeira (sem emoji na tela). %>
<%= render Ss::LocalePickerComponent.new(value: I18n.locale, url: locale_path, segmented: true, flags: false, label: t("layout.language"),
                                         form: { data: { turbo: false } },
                                         locales: Localized::NAMES.map { |code, name| { code: code, name: name } }) %>
