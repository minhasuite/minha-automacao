<%# locals: (items:, label:, css: nil) -%>
<%# resto: no celular a faixa de abas vira um menu (sem rolar de lado): mostra a aba atual e abre a lista inteira em grade. Desktop usa a faixa normal. -%>
<% cur = items.find { |i| i[:current] } || items.first %>
<details class="ss-subnav-menu lg:hidden <%= css %>" data-app="skip">
  <summary class="ss-subnav-current" aria-label="<%= label %>">
    <%= icon(cur[:icon], "size-4") %><span class="min-w-0 flex-1 truncate"><%= cur[:label] %></span>
    <span class="text-xs font-semibold text-muted"><%= t("resto.subnav.more", n: items.size) %></span><%= icon("chevron-down", "size-4 ss-subnav-chevron") %>
  </summary>
  <nav class="ss-subnav-grid" aria-label="<%= label %>">
    <% items.each do |i| %><%= link_to i[:path], "aria-current": (i[:current] ? "page" : nil) do %><%= icon(i[:icon], "size-4") %><span class="truncate"><%= i[:label] %></span><% end %><% end %>
  </nav>
</details>
