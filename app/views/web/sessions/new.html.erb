<% content_for :title, "#{t("sessions.title")} — Minha Automação" %>
<div class="text-center">
  <h1 class="text-2xl"><%= t("sessions.heading") %></h1>
  <p class="text-sm text-muted mt-1"><%= t("sessions.lead") %></p>
</div>
<%= render "google", text: "signin_with" %>
<%= ss_form_with url: login_path, class: "mt-6 space-y-4" do |f| %>
  <%= hidden_field_tag :return_to, params[:return_to] %>
  <%= f.ss_email_field :email, label: t("sessions.email"), required: true, autofocus: true, autocomplete: "email", value: params[:email], placeholder: t("sessions.email_hint") %>
  <div>
    <%= f.ss_password_field :password, label: t("sessions.password"), required: true, autocomplete: "current-password", placeholder: "••••••••" %>
    <div class="mt-1 flex justify-end"><%= link_to t("sessions.forgot"), forgot_password_path, class: "text-xs font-semibold text-accent" %></div>
  </div>
  <%= f.ss_submit t("sessions.submit"), css: "w-full min-h-12" %>
<% end %>
<div class="mt-3" data-controller="passkey" data-passkey-options-value="<%= login_passkey_path %>" data-passkey-url-value="<%= login_passkey_path(return_to: params[:return_to].presence) %>">
  <%= render Ss::ButtonComponent.new(label: t("security.login.passkey"), icon: icon("finger-print", ""), variant: :outline, block: true, class: "min-h-12", data: { action: "passkey#login" }) %>
  <p class="text-sm text-danger mt-2 text-center" data-passkey-target="error" role="alert" hidden></p>
</div>
<p class="mt-6 text-sm text-muted text-center"><%= t("sessions.no_account") %> <%= link_to t("sessions.create_free"), signup_path, class: "text-accent font-bold" %></p>
