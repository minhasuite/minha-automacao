<% content_for :title, "Entrar — Minha Automação" %>
<div class="text-center">
  <h1 class="text-2xl">Bem-vindo de volta</h1>
  <p class="text-sm text-muted mt-1">Entre para acompanhar sua automação</p>
</div>
<%= render "google", text: "signin_with" %>
<%= form_with url: login_path, class: "mt-6 space-y-4" do |f| %>
  <%= hidden_field_tag :return_to, params[:return_to] %>
  <div><%= f.label :email, "E-mail", class: "ss-label" %><%= f.email_field :email, class: "ss-input", required: true, autofocus: true, autocomplete: "email", value: params[:email], placeholder: "seu@email.com" %></div>
  <div>
    <div class="flex items-baseline justify-between"><%= f.label :password, "Senha", class: "ss-label" %><%= link_to "Esqueci a senha", forgot_password_path, class: "text-xs font-semibold text-accent" %></div>
    <%= f.password_field :password, class: "ss-input", required: true, autocomplete: "current-password", placeholder: "••••••••" %>
  </div>
  <%= f.submit "Entrar", class: "ss-btn ss-btn-primary w-full min-h-12" %>
<% end %>
<p class="mt-6 text-sm text-muted text-center">Não tem conta? <%= link_to "Criar conta grátis", signup_path, class: "text-accent font-bold" %></p>
