<% content_for :title, "#{t("sessions.title")} — Minha Automação" %>
<div class="text-center">
  <h1 class="text-2xl"><%= t("sessions.heading") %></h1>
  <p class="text-sm text-muted mt-1"><%= t("sessions.lead") %></p>
</div>
<%= render "google", text: "signin_with" %>
<%= form_with url: login_path, class: "mt-6 space-y-4" do |f| %>
  <%= hidden_field_tag :return_to, params[:return_to] %>
  <div><%= f.label :email, t("sessions.email"), class: "ss-label" %><%= f.email_field :email, class: "ss-input", required: true, autofocus: true, autocomplete: "email", value: params[:email], placeholder: t("sessions.email_hint") %></div>
  <div>
    <div class="flex items-baseline justify-between"><%= f.label :password, t("sessions.password"), class: "ss-label" %><%= link_to t("sessions.forgot"), forgot_password_path, class: "text-xs font-semibold text-accent" %></div>
    <%= f.password_field :password, class: "ss-input", required: true, autocomplete: "current-password", placeholder: "••••••••" %>
  </div>
  <%= f.submit t("sessions.submit"), class: "ss-btn ss-btn-primary w-full min-h-12" %>
<% end %>
<p class="mt-6 text-sm text-muted text-center"><%= t("sessions.no_account") %> <%= link_to t("sessions.create_free"), signup_path, class: "text-accent font-bold" %></p>
