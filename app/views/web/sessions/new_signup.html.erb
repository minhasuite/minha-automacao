<% content_for :title, "#{t("signup.title")} — Minha Automação" %>
<div class="text-center">
  <h1 class="text-2xl"><%= t("signup.heading") %></h1>
  <p class="text-sm text-muted mt-1"><%= t("signup.lead") %></p>
</div>
<%= render "google", text: "signup_with" %>
<%= form_with url: signup_path, class: "mt-6 space-y-4" do |f| %>
  <div><%= f.label :name, t("signup.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", required: true, value: params[:name], autocomplete: "name", autofocus: true %></div>
  <div><%= f.label :email, t("sessions.email"), class: "ss-label" %><%= f.email_field :email, class: "ss-input", required: true, value: params[:email], autocomplete: "email", placeholder: t("sessions.email_hint") %></div>
  <div><%= f.label :password, t("signup.password"), class: "ss-label" %><%= f.password_field :password, class: "ss-input", required: true, minlength: 8, autocomplete: "new-password" %></div>
  <%= f.submit t("signup.submit"), class: "ss-btn ss-btn-primary w-full min-h-12" %>
<% end %>
<p class="mt-6 text-sm text-muted text-center"><%= t("signup.have_account") %> <%= link_to t("signup.sign_in"), login_path, class: "text-accent font-bold" %></p>
<p class="mt-2 text-xs text-muted text-center"><%= t("signup.terms_html", terms: link_to(t("signup.terms"), terms_path, class: "underline"), privacy: link_to(t("signup.privacy"), privacy_path, class: "underline")) %></p>
