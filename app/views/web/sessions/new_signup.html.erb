<% content_for :title, "#{t("signup.title")} — Minha Automação" %>
<div class="text-center">
  <h1 class="text-2xl"><%= t("signup.heading") %></h1>
  <p class="text-sm text-muted mt-1"><%= t("signup.lead") %></p>
</div>
<%= render "google", text: "signup_with" %>
<%= ss_form_with url: signup_path, class: "mt-6 space-y-4" do |f| %>
  <%= f.ss_text_field :name, label: t("signup.name"), required: true, value: params[:name], autocomplete: "name", autofocus: true %>
  <%= f.ss_email_field :email, label: t("sessions.email"), required: true, value: params[:email], autocomplete: "email", placeholder: t("sessions.email_hint") %>
  <%= f.ss_password_field :password, label: t("signup.password"), required: true, minlength: 8, autocomplete: "new-password" %>
  <%= f.ss_submit t("signup.submit"), css: "w-full min-h-12" %>
<% end %>
<p class="mt-6 text-sm text-muted text-center"><%= t("signup.have_account") %> <%= link_to t("signup.sign_in"), login_path, class: "text-accent font-bold" %></p>
<p class="mt-2 text-xs text-muted text-center"><%= t("signup.terms_html", terms: link_to(t("signup.terms"), terms_path, class: "underline"), privacy: link_to(t("signup.privacy"), privacy_path, class: "underline")) %></p>
