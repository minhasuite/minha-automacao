<% content_for :title, "Criar conta — Minha Automação" %>
<div class="text-center">
  <h1 class="text-2xl">Crie sua conta</h1>
  <p class="text-sm text-muted mt-1">Grátis, em menos de um minuto</p>
</div>
<%= render "google", text: "signup_with" %>
<%= form_with url: signup_path, class: "mt-6 space-y-4" do |f| %>
  <div><%= f.label :name, "Seu nome", class: "ss-label" %><%= f.text_field :name, class: "ss-input", required: true, value: params[:name], autocomplete: "name", autofocus: true %></div>
  <div><%= f.label :company_name, "Nome da empresa", class: "ss-label" %><%= f.text_field :company_name, class: "ss-input", value: params[:company_name], autocomplete: "organization", placeholder: "Ex.: Mercado Bom Preço" %></div>
  <div><%= f.label :email, "E-mail", class: "ss-label" %><%= f.email_field :email, class: "ss-input", required: true, value: params[:email], autocomplete: "email", placeholder: "seu@email.com" %></div>
  <div><%= f.label :password, "Senha (mínimo 8)", class: "ss-label" %><%= f.password_field :password, class: "ss-input", required: true, minlength: 8, autocomplete: "new-password" %></div>
  <%= f.submit "Criar conta", class: "ss-btn ss-btn-primary w-full min-h-12" %>
<% end %>
<p class="mt-6 text-sm text-muted text-center">Já tem conta? <%= link_to "Entrar", login_path, class: "text-accent font-bold" %></p>
<p class="mt-2 text-xs text-muted text-center">Ao criar a conta você aceita os <%= link_to "termos", terms_path, class: "underline" %> e a <%= link_to "privacidade", privacy_path, class: "underline" %>.</p>
