<%# Botão "Entrar com o Google" (Google Identity Services). Some sem GOOGLE_CLIENT_ID. %>
<% if ENV["GOOGLE_CLIENT_ID"].present? %>
  <% content_for :head do %>
    <meta name="turbo-visit-control" content="reload">
    <script src="https://accounts.google.com/gsi/client" async></script>
  <% end %>
  <%= form_with url: google_login_path, id: "google-login", data: { turbo: false } do %>
    <%= hidden_field_tag :credential %>
    <%= hidden_field_tag :return_to, params[:return_to] %>
  <% end %>
  <div id="g_id_onload" data-client_id="<%= ENV["GOOGLE_CLIENT_ID"] %>" data-callback="msGoogleLogin" data-auto_prompt="false"></div>
  <div class="mt-6 flex justify-center">
    <div class="g_id_signin" data-type="standard" data-text="<%= text %>" data-shape="pill" data-locale="pt-BR" data-width="320"></div>
  </div>
  <script>
    function msGoogleLogin(r) {
      const f = document.getElementById("google-login");
      f.credential.value = r.credential;
      f.submit();
    }
  </script>
  <div class="mt-6 flex items-center gap-3 text-xs text-muted"><span class="h-px flex-1 bg-line"></span>ou<span class="h-px flex-1 bg-line"></span></div>
<% end %>
