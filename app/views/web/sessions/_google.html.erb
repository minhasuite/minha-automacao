<%# locals: (text: "signin_with", url: google_login_path, invite: nil, return_to: params[:return_to], divider: true) -%>
<%# Botão do Google (Google Identity Services, controller google-signin). Some sem GOOGLE_CLIENT_ID
    e em endereço que o Google não aceita (IP, .local). `text`: signin_with, signup_with ou continue_with. %>
<% if google_login_available? %>
  <div class="mt-6" data-controller="google-signin" data-google-signin-client-value="<%= GoogleLogin.client_id %>"
       data-google-signin-text-value="<%= text %>" data-google-signin-locale-value="<%= I18n.locale %>" data-google="button">
    <%= ss_form_with url: url, data: { turbo: false, google_signin_target: "form" } do %>
      <%= hidden_field_tag :credential, nil, id: nil, data: { google_signin_target: "credential" } %>
      <%= hidden_field_tag :return_to, return_to, id: nil if return_to.present? %>
      <%= hidden_field_tag :invite, invite, id: nil if invite %>
    <% end %>
    <div class="flex justify-center min-h-11" data-google-signin-target="button"></div>
    <% if divider %>
      <div class="ss-divider mt-6"><%= t("sessions.or") %></div>
    <% end %>
  </div>
<% end %>
