<%= render "web/shared/header", title: (@record.new_record? ? t("automations.primitive.new", what: label_text.downcase) : label_text), subtitle: @site.name, back: back_path %>
<%= render "web/#{controller_name}/form", site: @site, record: @record %>
<% if @record.persisted? %>
  <%= button_to polymorphic_path(@record), method: :delete, params: { back: params[:back] }, class: "ss-btn ss-btn-ghost text-danger mt-4", form: { data: { turbo_confirm: t("automations.primitive.delete_confirm", what: label_text.downcase) } } do %><%= icon("trash", "size-4") %><%= t("automations.common.delete") %><% end %>
<% end %>
