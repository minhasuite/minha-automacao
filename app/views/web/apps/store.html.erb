<%= render "web/shared/header", title: t("apps.store"), subtitle: t("apps.store_subtitle"), back: apps_path %>
<%= render layout: "web/settings/frame", locals: { current: :apps } do %>
<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <nav class="ss-chips is-solid" data-controller="ss-scroll-current" aria-label="<%= t("apps.categories") %>">
    <%= link_to t("apps.all"), apps_store_path(q: params[:q]), class: "ss-chip shrink-0", "aria-current": params[:categoria].blank?.to_s %>
    <% AppCatalog.categories.each do |c| %>
      <%= link_to c, apps_store_path(q: params[:q], categoria: c), class: "ss-chip shrink-0", "aria-current": (params[:categoria] == c).to_s %>
    <% end %>
  </nav>
  <%= form_with url: apps_store_path, method: :get, class: "flex gap-2", role: "search" do %>
    <%= hidden_field_tag :categoria, params[:categoria] if params[:categoria].present? %>
    <label for="q" class="sr-only"><%= t("apps.search_label") %></label>
    <%= search_field_tag :q, params[:q], class: "ss-input w-56", placeholder: t("apps.search_hint") %>
    <button class="ss-btn ss-btn-ghost" aria-label="<%= t("integrations.index.search") %>"><%= icon("search", "size-4") %></button>
  <% end %>
</div>
<% if @offline %><p class="text-sm text-muted mb-3" role="status"><%= icon("information-circle", "size-4 inline") %> <%= @offline %></p><% end %>
<% if @apps.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("apps.no_match", q: params[:q]), variant: :busca, css: "ss-card") %>
<% else %>
  <ul class="grid gap-3 sm:grid-cols-2 2xl:grid-cols-3" aria-label="<%= t("apps.catalog") %>">
    <% @apps.each do |app| %>
      <li>
        <%= link_to app_path(app.key), class: "ss-card ss-card-link p-4 no-underline flex items-start gap-3 h-full" do %>
          <span class="ss-icon-tile is-accent"><%= icon(app.icon) %></span>
          <span class="min-w-0 flex-1">
            <span class="flex flex-wrap items-center gap-2">
              <span class="font-bold text-ink"><%= app.name %></span>
              <% if @statuses.dig(app.key, "installed") %><span class="ss-badge ss-badge-success"><%= t("apps.installed") %></span><% end %>
              <% if app.system? %><span class="ss-badge"><%= t("apps.system_badge") %></span><% end %>
              <% if app.third_party? %><span class="ss-badge ss-badge-warn" title="<%= t("resto.apps.third_party_hint") %>"><%= t("resto.apps.third_party", repo: app.repository) %></span><% end %>
            </span>
            <span class="block text-xs text-muted mt-0.5"><%= app.category %> · <%= app.version %></span>
            <span class="block text-sm text-muted mt-1"><%= app.description %></span>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
<section class="ss-card ss-card-pad mt-6" aria-labelledby="repos-t" data-apps="repositories">
  <h2 id="repos-t" class="flex items-center gap-2"><%= icon("archive", "size-5 text-accent") %><%= t("resto.apps.repos_title") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("resto.apps.repos_pitch") %></p>
  <% if @repositories.any? %>
    <ul class="mt-3 divide-y divide-line">
      <% @repositories.each do |r| %>
        <li class="py-2 flex flex-wrap items-center justify-between gap-2">
          <div class="min-w-0"><p class="font-semibold text-ink"><%= r["name"] %> <span class="text-xs text-muted"><%= t("resto.apps.repo_apps", count: r["apps"].to_h.size) %></span></p>
            <p class="text-xs text-muted break-all"><%= r["url"] %></p></div>
          <%= button_to app_repositories_path, method: :delete, params: { url: r["url"] }, class: "ss-btn ss-btn-ghost ss-btn-sm",
                        form: { data: { turbo_confirm_tone: "danger", turbo_confirm_button: t("integrations.common.remove"), turbo_confirm: t("resto.apps.remove_confirm", name: r["name"]) } } do %><%= icon("trash", "size-4") %><%= t("integrations.common.remove") %><% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with url: app_repositories_path, class: "mt-4 flex flex-wrap gap-2 items-end" do %>
    <div class="flex-1 min-w-0"><%= label_tag :url, t("resto.apps.repo_url"), class: "ss-label" %><%= url_field_tag :url, nil, class: "ss-input w-full", placeholder: "https://exemplo.com/apps.json", required: true %></div>
    <button class="ss-btn ss-btn-outline"><%= icon("plus", "size-4") %><%= t("resto.apps.add_repo") %></button>
  <% end %>
</section>
<% end %>
