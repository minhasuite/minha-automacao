<%# locals: (app:, values:) -%>
<%= ss_fields(nil) do |f| %>
  <% app.options.each do |o| %>
    <% id = "opt-#{o['key']}" %>
    <% name = "options[#{o['key']}]" %>
    <% value = values.key?(o["key"]) ? values[o["key"]] : o["default"] %>
    <% help = (app.option_text(o, "help") if o["help"]) %>
    <% label = app.option_text(o, "label") + (o["required"] && o["type"] != "boolean" ? " *" : "") %>
    <% if o["type"] == "boolean" %>
      <%= f.ss_check_box name, label: label, name: name, id: id, checked: value == true, help: help %>
    <% elsif o["type"] == "enum" %>
      <%= f.ss_select name, o["choices"], label: label, name: name, id: id, selected: value, help: help %>
    <% elsif o["secret"] %>
      <%= f.ss_password_field name, label: label, name: name, id: id, autocomplete: "new-password", help: help,
                                    placeholder: (values.key?(o["key"]) ? t("apps.keep_secret") : nil), required: o["required"] && !values.key?(o["key"]) %>
    <% elsif o["type"] == "integer" %>
      <%= f.ss_number_field name, label: label, name: name, id: id, value: value, class: "num", min: o["min"], max: o["max"], required: o["required"], help: help %>
    <% else %>
      <%= f.ss_text_field name, label: label, name: name, id: id, value: value, required: o["required"], maxlength: 200, help: help,
                                placeholder: (o["type"] == "device" ? "/dev/serial/by-id/..." : nil) %>
    <% end %>
  <% end %>
<% end %>
