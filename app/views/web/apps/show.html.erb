<% st = @status || {} %>
<% label, tone = app_state(st) %>
<% installed = st["installed"] %>
<% running = st["state"] == "running" %>
<%= render "web/shared/header", title: @app.name, subtitle: @app.description, back: apps_path,
           badge: (@status ? tag.span(label, class: "ss-badge #{"ss-badge-#{tone}" if tone}") : nil) %>
<%= render layout: "web/settings/frame", locals: { current: :apps } do %>
<div <%= tag.attributes(data: { controller: "ss-reload", ss_reload_every_value: 4000 }) if st["busy"] %>>
<% if @offline || !Apps::Supervisor.configured? %>
  <%= render(Ss::CalloutComponent.new(tone: :info, title: t("apps.local_only"), class: "mb-4")) { @offline || t("apps.catalog_only") } %>
<% end %>

<% if installed %>
  <nav class="ss-chips is-solid mb-4" data-controller="ss-scroll-current" aria-label="<%= t("apps.sections") %>">
    <% [ [ t("apps.tabs.info"), "info", "information-circle" ], [ t("apps.tabs.config"), "config", "cog" ], [ t("apps.tabs.log"), "log", "document-text" ] ].each do |name, key, ico| %>
      <%= link_to app_path(@app.key, aba: key), class: "ss-chip shrink-0", "aria-current": (@tab == key).to_s do %><%= icon(ico, "size-4") %><%= name %><% end %>
    <% end %>
  </nav>
<% end %>

<% if st["error"] %>
  <%= render(Ss::CalloutComponent.new(tone: :danger, title: t("apps.last_failed").delete_suffix(":"), class: "mb-4")) { st["error"] } %>
<% end %>

<% if !installed || @tab == "info" %>
  <section class="ss-card ss-card-pad" aria-labelledby="sobre-t">
    <div class="flex items-start gap-3">
      <span class="ss-icon-tile is-accent"><%= icon(@app.icon) %></span>
      <div class="min-w-0 flex-1">
        <h2 id="sobre-t" class="font-bold text-ink"><%= @app.name %></h2>
        <p class="text-sm text-muted"><%= @app.category %><%= " · #{t("apps.system_long")}" if @app.system? %></p>
      </div>
    </div>
    <dl class="mt-4 grid gap-3 grid-cols-2 sm:grid-cols-4 text-sm">
      <div><dt class="text-muted"><%= t("apps.version") %></dt><dd class="font-semibold text-ink num"><%= st["version"] || @app.version %></dd></div>
      <div><dt class="text-muted"><%= t("apps.in_catalog") %></dt><dd class="font-semibold text-ink num"><%= @app.version %></dd></div>
      <div><dt class="text-muted"><%= t("apps.memory") %></dt><dd class="font-semibold text-ink num"><%= st["memory_mb"] ? "#{st['memory_mb'].round} MB" : "–" %></dd></div>
      <div><dt class="text-muted"><%= t("apps.ui") %></dt><dd class="font-semibold text-ink num"><%= @app.web_ui ? t("apps.port", port: @app.web_ui['port']) : t("apps.no_ui") %></dd></div>
    </dl>
    <% if app_update?(@app, st) %>
      <%= render Ss::CalloutComponent.new(tone: :warn, title: t("apps.update_from_to", from: st["version"], to: @app.version), class: "mt-4") do |c| %>
        <% c.with_action do %><%= render Ss::ButtonComponent.new(label: t("apps.upgrade"), href: upgrade_app_path(@app.key), method: :post, size: :sm, confirm: t("apps.upgrade_confirm", name: @app.name, version: @app.version)) %><% end %>
      <% end %>
    <% end %>
    <% if installed %>
      <div class="mt-4 flex flex-wrap gap-2">
        <% unless @app.system? %>
          <% if running %>
            <%= render Ss::ButtonComponent.new(label: t("apps.stop"), icon: icon("stop", ""), href: act_app_path(@app.key, do: "stop"), method: :post, variant: :ghost, disabled: st["busy"].present?) %>
          <% else %>
            <%= render Ss::ButtonComponent.new(label: t("apps.start"), icon: icon("play", ""), href: act_app_path(@app.key, do: "start"), method: :post, disabled: st["busy"].present?) %>
          <% end %>
        <% end %>
        <%= render Ss::ButtonComponent.new(label: t("apps.restart"), icon: icon("refresh", ""), href: act_app_path(@app.key, do: "restart"), method: :post, variant: :ghost,
                                           disabled: st["busy"].present?, confirm: (@app.system? ? t("apps.restart_confirm", name: @app.name) : nil)) %>
        <% if @app.web_ui && running %>
          <%= link_to launch_app_path(@app.key), class: "ss-btn ss-btn-outline", target: "_blank", rel: "noopener" do %><%= icon("external-link", "size-4") %><%= t("apps.open_ui") %><% end %>
        <% end %>
      </div>
      <% if @app.web_ui %><p class="text-xs text-muted mt-2"><%= t("apps.ui_hint", port: @app.web_ui["port"]) %></p><% end %>
    <% end %>
  </section>
  <%= render "web/apps/extras", app: @app, installed: installed, running: running %>

  <% if Apps::Supervisor.configured? && !@offline && !installed && !@app.system? %>
    <section class="ss-card ss-card-pad mt-4" aria-labelledby="instalar-t">
      <h2 id="instalar-t"><%= t("apps.install") %></h2>
      <% if st["busy"] %>
        <%= render Ss::SplashComponent.new(message: t("apps.busy", what: st["busy"]), inline: true) %>
      <% else %>
        <%= ss_form_with url: install_app_path(@app.key), class: "mt-3 grid gap-4 md:grid-cols-2", data: { turbo_submits_with: t("apps.installing") } do |f| %>
          <%= render "web/apps/options", app: @app, values: {} %>
          <%= render "web/apps/behavior", boot: true, watchdog: true %>
          <div class="md:col-span-2"><%= f.ss_submit t("apps.install"), name: nil, data: { turbo_submits_with: t("apps.installing") } %></div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% if installed && !@app.system? %>
    <section class="ss-card ss-card-pad mt-4" aria-labelledby="comp-t">
      <h2 id="comp-t"><%= t("apps.behavior") %></h2>
      <%= ss_form_with url: app_path(@app.key), method: :patch, class: "mt-3 grid gap-4 md:grid-cols-2" do |f| %>
        <%= render "web/apps/behavior", boot: st["boot"], watchdog: st["watchdog"] %>
        <div class="md:col-span-2"><%= f.ss_submit t("integrations.common.save"), variant: :ghost, name: nil %></div>
      <% end %>
    </section>

    <section class="ss-card ss-card-pad mt-4" aria-labelledby="desinst-t">
      <h2 id="desinst-t"><%= t("apps.uninstall") %></h2>
      <%= ss_form_with url: app_path(@app.key), method: :delete, class: "mt-3 flex flex-wrap items-center gap-4",
                       data: { turbo_confirm: t("apps.uninstall_confirm", name: @app.name), turbo_confirm_button: t("apps.uninstall") } do |f| %>
        <%= f.ss_check_box :keep_data, label: t("apps.keep_data"), id: "keep-data", checked: true, unchecked_value: nil %>
        <%= render Ss::ButtonComponent.new(label: t("apps.uninstall"), icon: icon("trash", ""), type: :submit, variant: :danger) %>
      <% end %>
    </section>
  <% end %>
<% elsif @tab == "config" %>
  <section class="ss-card ss-card-pad" aria-labelledby="conf-t">
    <h2 id="conf-t"><%= t("apps.tabs.config") %></h2>
    <% if @app.system? || @app.options.empty? %>
      <p class="text-sm text-muted mt-1"><%= @app.system? ? t("apps.system_config") : t("apps.no_options") %></p>
    <% else %>
      <p class="text-sm text-muted mt-1"><%= t("apps.config_hint") %></p>
      <%= ss_form_with url: app_path(@app.key), method: :patch, class: "mt-3 grid gap-4 md:grid-cols-2", data: { turbo_submits_with: t("apps.saving") } do |f| %>
        <%= render "web/apps/options", app: @app, values: st["options"] || {} %>
        <div class="md:col-span-2"><%= f.ss_submit t("apps.save_restart"), name: nil, disabled: st["busy"].present?, data: { turbo_submits_with: t("apps.saving") } %></div>
      <% end %>
    <% end %>
  </section>
<% else %>
  <section class="ss-card ss-card-pad" aria-labelledby="log-t">
    <div class="flex items-center justify-between gap-3">
      <h2 id="log-t"><%= t("apps.tabs.log") %></h2>
      <span class="text-xs text-muted"><%= t("apps.log_hint") %></span>
    </div>
    <turbo-frame id="app-log" class="ss-live" src="<%= logs_app_path(@app.key) %>" data-controller="ss-reload" data-ss-reload-every-value="5000">
      <%= render Ss::SkeletonComponent.new(lines: 4, label: t("apps.loading"), class: "mt-3") %>
    </turbo-frame>
  </section>
<% end %>
</div>
<% end %>
