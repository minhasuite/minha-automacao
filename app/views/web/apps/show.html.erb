<% st = @status || {} %>
<% label, tone = app_state(st) %>
<% installed = st["installed"] %>
<% running = st["state"] == "running" %>
<%= render "web/shared/header", title: @app.name, subtitle: @app.description, back: apps_path,
           badge: (@status ? tag.span(label, class: "ss-badge #{"ss-badge-#{tone}" if tone}") : nil) %>
<%= render layout: "web/settings/frame", locals: { current: :apps } do %>
<div <%= tag.attributes(data: { controller: "reload", reload_every_value: 4000 }) if st["busy"] %>>
<% if @offline || !Apps::Supervisor.configured? %>
  <div class="ss-card ss-card-pad mb-4 flex items-start gap-3" role="status">
    <span class="ss-icon-tile text-accent"><%= icon("information-circle") %></span>
    <div><p class="font-bold text-ink"><%= t("apps.local_only") %></p><p class="text-sm text-muted mt-0.5"><%= @offline || t("apps.catalog_only") %></p></div>
  </div>
<% end %>

<% if installed %>
  <nav class="ss-chips mb-4" aria-label="<%= t("apps.sections") %>">
    <% [ [ t("apps.tabs.info"), "info", "information-circle" ], [ t("apps.tabs.config"), "config", "cog" ], [ t("apps.tabs.log"), "log", "document-text" ] ].each do |name, key, ico| %>
      <%= link_to app_path(@app.key, aba: key), class: "ss-chip shrink-0", "aria-current": (@tab == key).to_s do %><%= icon(ico, "size-4") %><%= name %><% end %>
    <% end %>
  </nav>
<% end %>

<% if st["error"] %>
  <div class="ss-card ss-card-pad mb-4 text-sm text-danger" role="alert"><%= t("apps.last_failed") %> <%= st["error"] %></div>
<% end %>

<% if !installed || @tab == "info" %>
  <section class="ss-card ss-card-pad" aria-labelledby="sobre-t">
    <div class="flex items-start gap-3">
      <span class="ss-icon-tile text-accent"><%= icon(@app.icon) %></span>
      <div class="min-w-0 flex-1">
        <h2 id="sobre-t" class="font-bold text-ink"><%= @app.name %></h2>
        <p class="text-sm text-muted"><%= @app.category %><%= " · #{t("apps.system_long")}" if @app.system? %></p>
      </div>
    </div>
    <dl class="mt-4 grid gap-3 grid-cols-2 sm:grid-cols-4 text-sm">
      <div><dt class="text-muted"><%= t("apps.version") %></dt><dd class="font-semibold text-ink num"><%= st["version"] || @app.version %></dd></div>
      <div><dt class="text-muted"><%= t("apps.in_catalog") %></dt><dd class="font-semibold text-ink num"><%= @app.version %></dd></div>
      <div><dt class="text-muted"><%= t("apps.memory") %></dt><dd class="font-semibold text-ink num"><%= st["memory_mb"] ? "#{st['memory_mb'].round} MB" : "–" %></dd></div>
      <div><dt class="text-muted"><%= t("apps.ui") %></dt><dd class="font-semibold text-ink num"><%= @app.web_ui ? t("apps.port", port: @app.web_ui['port']) : t("apps.no_ui") %></dd></div>
    </dl>
    <% if app_update?(@app, st) %>
      <div class="mt-4 flex flex-wrap items-center gap-3 rounded-xl p-3 bg-[var(--warn-soft)]" role="status">
        <span class="text-sm font-semibold text-ink"><%= t("apps.update_from_to", from: st["version"], to: @app.version) %></span>
        <%= button_to t("apps.upgrade"), upgrade_app_path(@app.key), class: "ss-btn ss-btn-primary ss-btn-sm", form: { data: { turbo_confirm: t("apps.upgrade_confirm", name: @app.name, version: @app.version) } } %>
      </div>
    <% end %>
    <% if installed %>
      <div class="mt-4 flex flex-wrap gap-2">
        <% unless @app.system? %>
          <% if running %>
            <%= button_to act_app_path(@app.key, do: "stop"), class: "ss-btn ss-btn-ghost", disabled: st["busy"].present? do %><%= icon("stop", "size-4") %><%= t("apps.stop") %><% end %>
          <% else %>
            <%= button_to act_app_path(@app.key, do: "start"), class: "ss-btn ss-btn-primary", disabled: st["busy"].present? do %><%= icon("play", "size-4") %><%= t("apps.start") %><% end %>
          <% end %>
        <% end %>
        <%= button_to act_app_path(@app.key, do: "restart"), class: "ss-btn ss-btn-ghost", disabled: st["busy"].present?,
                      form: { data: { turbo_confirm: (@app.system? ? t("apps.restart_confirm", name: @app.name) : nil) } } do %><%= icon("refresh", "size-4") %><%= t("apps.restart") %><% end %>
        <% if @app.web_ui && running %>
          <%= link_to launch_app_path(@app.key), class: "ss-btn ss-btn-outline", target: "_blank", rel: "noopener" do %><%= icon("external-link", "size-4") %><%= t("apps.open_ui") %><% end %>
        <% end %>
      </div>
      <% if @app.web_ui %><p class="text-xs text-muted mt-2"><%= t("apps.ui_hint", port: @app.web_ui["port"]) %></p><% end %>
    <% end %>
  </section>

  <% if Apps::Supervisor.configured? && !@offline && !installed && !@app.system? %>
    <section class="ss-card ss-card-pad mt-4" aria-labelledby="instalar-t">
      <h2 id="instalar-t"><%= t("apps.install") %></h2>
      <% if st["busy"] %>
        <p class="text-sm text-muted mt-1" role="status"><%= t("apps.busy", what: st["busy"]) %></p>
      <% else %>
        <%= form_with url: install_app_path(@app.key), class: "mt-3 grid gap-4 md:grid-cols-2", data: { turbo_submits_with: t("apps.installing") } do %>
          <%= render "web/apps/options", app: @app, values: {} %>
          <%= render "web/apps/behavior", boot: true, watchdog: true %>
          <div class="md:col-span-2"><%= submit_tag t("apps.install"), class: "ss-btn ss-btn-primary", name: nil %></div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% if installed && !@app.system? %>
    <section class="ss-card ss-card-pad mt-4" aria-labelledby="comp-t">
      <h2 id="comp-t"><%= t("apps.behavior") %></h2>
      <%= form_with url: app_path(@app.key), method: :patch, class: "mt-3 grid gap-4 md:grid-cols-2" do %>
        <%= render "web/apps/behavior", boot: st["boot"], watchdog: st["watchdog"] %>
        <div class="md:col-span-2"><%= submit_tag t("integrations.common.save"), class: "ss-btn ss-btn-ghost", name: nil %></div>
      <% end %>
    </section>

    <section class="ss-card ss-card-pad mt-4" aria-labelledby="desinst-t">
      <h2 id="desinst-t"><%= t("apps.uninstall") %></h2>
      <%= form_with url: app_path(@app.key), method: :delete, class: "mt-3 flex flex-wrap items-center gap-4",
                    data: { turbo_confirm: t("apps.uninstall_confirm", name: @app.name), turbo_confirm_button: t("apps.uninstall") } do %>
        <label class="ss-check"><%= check_box_tag :keep_data, "1", true, id: "keep-data" %><%= t("apps.keep_data") %></label>
        <%= button_tag class: "ss-btn ss-btn-danger", name: nil do %><%= icon("trash", "size-4") %><%= t("apps.uninstall") %><% end %>
      <% end %>
    </section>
  <% end %>
<% elsif @tab == "config" %>
  <section class="ss-card ss-card-pad" aria-labelledby="conf-t">
    <h2 id="conf-t"><%= t("apps.tabs.config") %></h2>
    <% if @app.system? || @app.options.empty? %>
      <p class="text-sm text-muted mt-1"><%= @app.system? ? t("apps.system_config") : t("apps.no_options") %></p>
    <% else %>
      <p class="text-sm text-muted mt-1"><%= t("apps.config_hint") %></p>
      <%= form_with url: app_path(@app.key), method: :patch, class: "mt-3 grid gap-4 md:grid-cols-2", data: { turbo_submits_with: t("apps.saving") } do %>
        <%= render "web/apps/options", app: @app, values: st["options"] || {} %>
        <div class="md:col-span-2"><%= submit_tag t("apps.save_restart"), class: "ss-btn ss-btn-primary", name: nil, disabled: st["busy"].present? %></div>
      <% end %>
    <% end %>
  </section>
<% else %>
  <section class="ss-card ss-card-pad" aria-labelledby="log-t">
    <div class="flex items-center justify-between gap-3">
      <h2 id="log-t"><%= t("apps.tabs.log") %></h2>
      <span class="text-xs text-muted"><%= t("apps.log_hint") %></span>
    </div>
    <turbo-frame id="app-log" src="<%= logs_app_path(@app.key) %>" data-controller="reload" data-reload-every-value="5000">
      <p class="text-sm text-muted mt-3"><%= t("apps.loading") %></p>
    </turbo-frame>
  </section>
<% end %>
</div>
<% end %>
