<%= render "web/shared/header", title: t("api_keys.title"), subtitle: t("apps.subtitle") do %>
  <%= link_to apps_store_path, class: "ss-btn ss-btn-primary" do %><%= icon("shopping-bag", "size-4") %><%= t("apps.store") %><% end %>
<% end %>
<%= render layout: "web/settings/frame", locals: { current: :apps } do %>
<% if @offline %>
  <%= render(Ss::CalloutComponent.new(tone: :info, title: t("apps.local_only"), class: "mb-4")) { @offline } %>
<% end %>

<% if @installed.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("apps.empty"), text: t("apps.empty_hint"), css: "ss-card") %>
<% else %>
  <ul class="grid gap-4 sm:grid-cols-2 2xl:grid-cols-3" aria-label="<%= t("apps.installed_label") %>">
    <% @installed.each do |app| %>
      <% st = @statuses[app.key] %>
      <% label, tone = app_state(st) %>
      <li class="ss-card ss-card-pad flex flex-col">
        <div class="flex items-start gap-3">
          <span class="ss-icon-tile is-accent"><%= icon(app.icon) %></span>
          <div class="min-w-0 flex-1">
            <h2 class="font-bold text-ink truncate"><%= link_to app.name, app_path(app.key), class: "no-underline text-ink hover:text-accent" %></h2>
            <p class="text-sm text-muted truncate"><%= app.category %><%= " · #{t("apps.system")}" if app.system? %></p>
          </div>
          <span class="ss-badge <%= "ss-badge-#{tone}" if tone %>"><%= label %></span>
        </div>
        <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div><dt class="text-muted"><%= t("apps.version") %></dt><dd class="font-semibold text-ink num"><%= st["version"] %></dd></div>
          <div><dt class="text-muted"><%= t("apps.memory") %></dt><dd class="font-semibold text-ink num"><%= st["memory_mb"] ? "#{number_with_delimiter(st['memory_mb'].round)} MB" : "–" %></dd></div>
        </dl>
        <% if app_update?(app, st) %>
          <%= link_to app_path(app.key), class: "mt-3 ss-badge ss-badge-warn no-underline w-fit" do %><%= icon("sparkles", "size-3.5") %><%= t("apps.update_available", version: app.version) %><% end %>
        <% end %>
        <div class="mt-auto pt-4 flex flex-wrap items-center gap-2">
          <%= link_to app_path(app.key), class: "ss-btn ss-btn-outline ss-btn-sm flex-1 justify-center whitespace-nowrap" do %><%= icon("cog", "size-4") %><%= t("apps.manage") %><% end %>
          <% if app.web_ui && st["state"] == "running" %>
            <%= link_to launch_app_path(app.key), class: "ss-btn ss-btn-ghost ss-btn-sm", target: "_blank", rel: "noopener" do %><%= icon("external-link", "size-4") %><%= t("apps.open_ui") %><% end %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
<% end %>
