<%= render "web/shared/header", title: "Configurações", subtitle: "Aplicativos: serviços extras que rodam no servidor de casa para a instalação inteira." do %>
  <%= link_to apps_store_path, class: "ss-btn ss-btn-primary" do %><%= icon("shopping-bag", "size-4") %>Loja de aplicativos<% end %>
<% end %>
<%= render layout: "web/settings/frame", locals: { current: :apps } do %>
<% if @offline %>
  <div class="ss-card ss-card-pad mb-4 flex items-start gap-3" role="status">
    <span class="ss-icon-tile text-accent"><%= icon("information-circle") %></span>
    <div><p class="font-bold text-ink">Disponível no servidor local</p><p class="text-sm text-muted mt-0.5"><%= @offline %></p></div>
  </div>
<% end %>

<% if @installed.empty? %>
  <div class="ss-card ss-empty">
    <p class="font-bold text-ink">Nenhum aplicativo instalado.</p>
    <p class="mt-1">Na loja há Node-RED, ESPHome, Frigate, Uptime Kuma e outros, prontos para instalar.</p>
  </div>
<% else %>
  <ul class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" aria-label="Aplicativos instalados">
    <% @installed.each do |app| %>
      <% st = @statuses[app.key] %>
      <% label, tone = app_state(st) %>
      <li class="ss-card ss-card-pad flex flex-col">
        <div class="flex items-start gap-3">
          <span class="ss-icon-tile text-accent"><%= icon(app.icon) %></span>
          <div class="min-w-0 flex-1">
            <h2 class="font-bold text-ink truncate"><%= link_to app.name, app_path(app.key), class: "no-underline text-ink hover:text-accent" %></h2>
            <p class="text-sm text-muted truncate"><%= app.category %><%= " · do sistema" if app.system? %></p>
          </div>
          <span class="ss-badge <%= "ss-badge-#{tone}" if tone %>"><%= label %></span>
        </div>
        <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div><dt class="text-muted">Versão</dt><dd class="font-semibold text-ink num"><%= st["version"] %></dd></div>
          <div><dt class="text-muted">Memória</dt><dd class="font-semibold text-ink num"><%= st["memory_mb"] ? "#{number_with_delimiter(st['memory_mb'].round)} MB" : "–" %></dd></div>
        </dl>
        <% if app_update?(app, st) %>
          <%= link_to app_path(app.key), class: "mt-3 ss-badge ss-badge-warn no-underline w-fit" do %><%= icon("sparkles", "size-3.5") %>Atualização disponível: <%= app.version %><% end %>
        <% end %>
        <div class="mt-auto pt-4 flex items-center gap-2">
          <%= link_to app_path(app.key), class: "ss-btn ss-btn-outline ss-btn-sm flex-1 justify-center" do %><%= icon("cog", "size-4") %>Gerenciar<% end %>
          <% if app.web_ui && st["state"] == "running" %>
            <%= link_to launch_app_path(app.key), class: "ss-btn ss-btn-ghost ss-btn-sm", target: "_blank", rel: "noopener" do %><%= icon("external-link", "size-4") %>Abrir interface<% end %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
<% end %>
