<%# locals: (boot:, watchdog:) -%>
<%= ss_fields(nil) do |f| %>
  <%= f.ss_check_box :boot, label: t("apps.boot"), id: "app-boot", checked: boot ? true : false, help: t("apps.boot_hint") %>
  <%= f.ss_check_box :watchdog, label: "Watchdog", id: "app-watchdog", checked: watchdog ? true : false, help: t("apps.watchdog_hint") %>
<% end %>
