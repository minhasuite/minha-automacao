<%# locals: (boot:, watchdog:) -%>
<div>
  <%= hidden_field_tag :boot, "0", id: nil %>
  <label class="ss-check"><%= check_box_tag :boot, "1", boot, id: "app-boot" %><%= t("apps.boot") %></label>
  <p class="text-xs text-muted mt-1"><%= t("apps.boot_hint") %></p>
</div>
<div>
  <%= hidden_field_tag :watchdog, "0", id: nil %>
  <label class="ss-check"><%= check_box_tag :watchdog, "1", watchdog, id: "app-watchdog" %>Watchdog</label>
  <p class="text-xs text-muted mt-1"><%= t("apps.watchdog_hint") %></p>
</div>
