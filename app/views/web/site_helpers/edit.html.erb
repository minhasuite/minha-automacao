<%= render "web/shared/header", title: @point.name, subtitle: t("site_helpers.edit.subtitle", type: @plugin.title, key: @point.key), back: site_helpers_path(@site) %>
<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem] items-start">
  <%= render layout: "form", locals: { point: @point, plugin: @plugin, url: helper_path(@point), method: :patch } do |f| %>
    <%= f.ss_submit(t("site_helpers.form.save")) %>
    <%= link_to t("site_helpers.form.cancel"), site_helpers_path(@site), class: "ss-btn ss-btn-ghost" %>
  <% end %>
  <aside class="grid gap-4">
    <section class="ss-card ss-card-pad" aria-labelledby="uso">
      <h2 id="uso" class="flex items-center gap-2"><%= icon("collection", "size-5") %><%= t("site_helpers.edit.used") %></h2>
      <%= render "web/shared/usages", usages: @usages, empty: t("site_helpers.edit.unused") %>
    </section>
    <section class="ss-card ss-card-pad" aria-labelledby="excluir">
      <h2 id="excluir" class="flex items-center gap-2"><%= icon("trash", "size-5") %><%= t("site_helpers.edit.delete") %></h2>
      <p class="mt-2 text-sm text-muted"><%= @usages.any? ? t("site_helpers.edit.used_in", n: @usages.size) : t("site_helpers.edit.delete_text") %></p>
      <%= render Ss::ButtonComponent.new(label: t("site_helpers.edit.delete_button"), icon: icon("trash", ""), href: helper_path(@point), method: :delete, variant: :outline, size: :sm,
                                         css: "mt-3 !text-danger", confirm_tone: :danger, confirm_button: t("site_helpers.edit.delete"),
                                         confirm: t("site_helpers.edit.confirm", name: @point.name) + (@usages.any? ? t("site_helpers.edit.confirm_used", n: @usages.size) : "")) %>
    </section>
  </aside>
</div>
