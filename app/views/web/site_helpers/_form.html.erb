<%# locals: (point:, plugin:, url:, method:) -%>
<%# Formulário do helper; o bloco (de new e edit) traz as ações: yield f. -%>
<%= ss_form_with scope: :helper, url: url, method: method, class: "ss-card ss-card-pad grid gap-4 sm:grid-cols-2 max-w-3xl w-full" do |f| %>
  <%= render "web/shared/errors", record: point %>
  <div class="sm:col-span-2"><%= f.ss_text_field :name, label: t("site_helpers.form.name"), value: point.name, required: true, maxlength: 80, autofocus: point.new_record?, placeholder: t("site_helpers.form.name_ph") %></div>
  <div class="sm:col-span-2"><%= render "web/shared/icon_picker", name: "helper[icon]", selected: point.icon, icons: HelperTypes::ICONS, id: "helper_icon", blank: t("site_helpers.form.icon_default") %></div>
  <%= f.ss_select :area_id, options_for_select(point.site.areas.order(:name).pluck(:name, :id), point.area_id), label: t("site_helpers.form.area"), include_blank: t("site_helpers.form.no_area") %>
  <%= fields_for :helper, point do |o| %><%= render "web/shared/organize_fields", f: o, record: point, categories: category_options(point.site.points.helpers) %><% end %>
  <%= render helper_form_partial(plugin), f: f, point: point %>
  <% unless plugin.sourced? %>
    <div class="sm:col-span-2"><%= f.ss_check_box :restore, label: t("site_helpers.form.restore"), checked: point.address.fetch("restore", true) != false %></div>
  <% end %>
  <div class="sm:col-span-2 flex flex-wrap gap-2"><%= yield f %></div>
<% end %>
