<%# locals: (point:, plugin:, url:, method:) -%>
<%= form_with scope: :helper, url: url, method: method, class: "ss-card ss-card-pad grid gap-4 sm:grid-cols-2 max-w-3xl w-full" do |f| %>
  <%= render "web/shared/errors", record: point %>
  <div class="sm:col-span-2"><%= f.label :name, "Nome", class: "ss-label" %><%= f.text_field :name, value: point.name, class: "ss-input", required: true, maxlength: 80, autofocus: point.new_record?, placeholder: "Modo da casa" %></div>
  <div><%= f.label :icon, "Ícone", class: "ss-label" %><%= f.select :icon, HelperTypes::ICONS, { selected: point.icon, include_blank: "Padrão do tipo" }, class: "ss-input" %></div>
  <div><%= f.label :area_id, "Área (opcional)", class: "ss-label" %><%= f.select :area_id, point.site.areas.order(:name).pluck(:name, :id), { selected: point.area_id, include_blank: "Sem área" }, class: "ss-input" %></div>
  <%= render "web/site_helpers/forms/#{plugin.key}", f: f, point: point %>
  <% unless plugin.sourced? %>
    <label class="ss-check sm:col-span-2"><%= f.check_box :restore, { checked: point.address.fetch("restore", true) != false }, "1", "0" %>Restaurar o valor depois de reiniciar</label>
  <% end %>
  <div class="sm:col-span-2 flex flex-wrap gap-2">
    <%= f.submit point.new_record? ? "Criar helper" : "Salvar", class: "ss-btn ss-btn-primary" %>
    <%= link_to "Cancelar", site_helpers_path(point.site), class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
