<%= render "web/shared/header", title: t("site_helpers.index.title"), subtitle: t("site_helpers.index.subtitle", site: @site.name), back: site_path(@site) do %>
  <% if can?(:manage) %><%= link_to new_site_helper_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("site_helpers.catalog.title") %><% end %><% end %>
<% end %>
<%= render "web/sites/tabs", site: @site, current: :helpers %>

<% filtered = params.values_at(:q, :tipo).any?(&:present?) %>
<% if @counts.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("site_helpers.index.empty"), text: t("site_helpers.index.empty_text"), css: "ss-card") do %><% if can?(:manage) %><%= link_to new_site_helper_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("site_helpers.index.create_first") %><% end %><% end %><% end %>
<% else %>
  <%= form_with url: site_helpers_path(@site), method: :get, class: "mb-3 flex flex-wrap items-end gap-3", role: "search" do %>
    <div class="min-w-48 flex-1"><label for="q" class="ss-label"><%= t("site_helpers.index.search") %></label><%= search_field_tag :q, params[:q], class: "ss-input", placeholder: t("site_helpers.index.search_ph") %></div>
    <%= hidden_field_tag :tipo, params[:tipo] if params[:tipo].present? %>
    <% if @labels.any? %><div><label for="rotulo" class="ss-label"><%= t("automations.index.label") %></label><%= select_tag :rotulo, options_for_select(@labels, params[:rotulo]), include_blank: t("automations.index.all_m"), class: "ss-input", data: { autosubmit: true } %></div><% end %>
    <button type="submit" class="ss-btn ss-btn-ghost" aria-label="<%= t("site_helpers.index.search") %>"><%= icon("search", "size-4") %></button>
  <% end %>
  <nav class="ss-chips mb-4" aria-label="<%= t("site_helpers.index.filter") %>">
    <%= link_to site_helpers_path(@site, q: params[:q].presence), class: "ss-chip", "aria-current": params[:tipo].blank?.to_s do %><%= t("site_helpers.index.all") %> <span class="ss-chip-count"><%= @counts.values.sum %></span><% end %>
    <% HelperTypes.plugins.select { |p| @counts.key?(p.key) }.each do |p| %>
      <%= link_to site_helpers_path(@site, tipo: p.key, q: params[:q].presence), class: "ss-chip", "aria-current": (params[:tipo] == p.key).to_s do %><%= icon(p.icon, "size-4") %><%= p.title %> <span class="ss-chip-count"><%= @counts[p.key] %></span><% end %>
    <% end %>
  </nav>

  <% if @helpers.empty? %>
    <%= render Ss::EmptyStateComponent.new(title: (filtered ? t("site_helpers.index.none_filtered") : t("site_helpers.index.none")), variant: :busca, css: "ss-card") do %><% if filtered %><%= link_to t("site_helpers.index.clear"), site_helpers_path(@site), class: "ss-btn ss-btn-ghost" %><% end %><% end %>
  <% else %>
    <% @helpers.each { |h| %><%= turbo_stream_from h, channel: PointsChannel %><% } %>
    <% groups = category_groups(@helpers) %>
    <% groups.each do |category, items| %>
    <%= render layout: "web/shared/category_group", locals: { name: category, count: items.size, grouped: groups.size > 1 || category } do %>
    <ul class="ss-card ss-rows" aria-label="<%= t("site_helpers.index.title") %><%= " · #{category}" if category %>">
      <% items.each do |h| %>
        <% plugin = h.helper_type %>
        <li id="<%= dom_id(h) %>">
          <% value_text = h.quality == "good" ? point_value_text(h) : (h.quality == "error" ? t("site_helpers.index.error") : t("site_helpers.index.no_signal")) %>
          <span class="grid place-items-center size-10 shrink-0 rounded-xl <%= point_on?(h) ? 'ss-grad' : 'bg-accent-soft text-accent' %>"><%= icon(point_icon(h)) %></span>
          <%# Celular: chave e lápis cabem ao lado do nome; campo largo (hora, número) desce para a linha de baixo. %>
          <div class="min-w-0 flex-1 max-sm:basis-40">
            <p class="font-bold text-ink truncate max-sm:whitespace-normal max-sm:line-clamp-2 max-sm:break-words"><%= link_to h.name, point_path(h), class: "text-ink no-underline hover:text-accent" %></p>
            <p class="text-xs text-muted truncate"><%= [ plugin&.title, h.area&.name, plugin&.summary(h) ].compact_blank.join(" · ") %> <%= label_chips(h) %></p>
            <%# No celular o valor vem embaixo do nome (o nome não é espremido pelo valor). %>
            <p class="sm:hidden text-sm font-bold truncate <%= h.quality == 'good' ? 'text-ink' : 'text-warn' %> <%= 'num' if h.value.is_a?(Numeric) %>"><%= value_text %></p>
          </div>
          <p class="max-sm:hidden max-w-[45%] truncate text-right text-sm font-bold <%= h.quality == 'good' ? 'text-ink' : 'text-warn' %> <%= 'num' if h.value.is_a?(Numeric) %> shrink-0" aria-live="polite">
            <%= value_text %>
          </p>
          <div class="ml-auto flex items-center justify-end gap-1 shrink-0">
            <%= render "web/points/control", point: h %>
            <% if can?(:manage) %>
              <%= link_to edit_helper_path(h), class: "grid place-items-center size-9 rounded-lg text-muted hover:text-accent hover:bg-accent-soft", title: t("site_helpers.index.edit"), "aria-label": t("site_helpers.index.edit_name", name: h.name) do %><%= icon("pencil", "size-4") %><% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
    <% end %>
    <% end %>
    <%= render "web/shared/pagination", pagy: @pagy %>
  <% end %>
<% end %>
