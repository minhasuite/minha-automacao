<%# locals: (f:, point:) -%>
<%= f.ss_number_field :min, label: t("helper_forms.text.min"), value: (point.min || 0).to_i, min: 0, max: 255, class: "num" %>
<%= f.ss_number_field :max, label: t("helper_forms.text.max"), value: (point.max || 255).to_i, min: 1, max: 255, class: "num" %>
<%= f.ss_text_field :pattern, label: t("helper_forms.text.pattern"), value: point.address["pattern"], class: "num", maxlength: 200, spellcheck: false, placeholder: "[0-9]{4}", wrapper_class: "sm:col-span-2" %>
<%= f.ss_check_box :password, label: t("helper_forms.text.password"), checked: point.address["password"] == true, wrapper_class: "sm:col-span-2" %>
