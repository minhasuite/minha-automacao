<%# locals: (f:, point:) -%>
<%= render "web/site_helpers/forms/source_field", f: f, point: point %>
<%= render "web/site_helpers/forms/unit_fields", f: f, point: point %>
<%= f.ss_text_field :window, label: t("helper_forms.window_opt"), value: (helper_duration(point.address["window_s"]) if point.address["window_s"].to_i.positive?), class: "num", placeholder: "10m, 1h" %>
<p class="sm:col-span-2 text-xs text-muted"><%= t("helper_forms.derivative.hint") %></p>
