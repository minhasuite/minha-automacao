<%# locals: (f:, point:) -%>
<%= render "web/site_helpers/forms/source_field", f: f, point: point %>
<%= render "web/site_helpers/forms/unit_fields", f: f, point: point %>
<div><%= f.label :window, t("helper_forms.window_opt"), class: "ss-label" %><%= f.text_field :window, value: (helper_duration(point.address["window_s"]) if point.address["window_s"].to_i.positive?), class: "ss-input num", placeholder: "10m, 1h" %></div>
<p class="sm:col-span-2 text-xs text-muted"><%= t("helper_forms.derivative.hint") %></p>
