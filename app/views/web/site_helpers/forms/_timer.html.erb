<%# locals: (f:, point:) -%>
<div class="sm:col-span-2"><%= f.label :duration, "Duração", class: "ss-label" %><%= f.text_field :duration, value: helper_duration(point.address["duration_s"]), class: "ss-input num max-w-48", required: true, placeholder: "20m, 1h30m, 45s" %>
  <p class="text-xs text-muted mt-1">"Iniciar" pode levar outra duração. Ao terminar, o valor vira "Terminou": use o gatilho "Ponto mudou" para "Terminou". Continua contando se o servidor reiniciar.</p></div>
