<%# locals: (f:, point:) -%>
<% a = point.address %>
<% chosen = Array(a["sources"]) %>
<% options = People.by_confidence(People.trackable(point.site)).map { |p| [ "#{p.name} · #{p.device.name} (#{People.tracker_for(p).label} · #{t("presence.confidence.#{People.tracker_for(p).confidence}")})", p.id ] } %>
<% delay = point.new_record? && !a.key?("away_delay_s") ? People::AWAY_DELAY_S : a["away_delay_s"].to_i %>
<%= f.ss_select :user_id, User.where(disabled_at: nil).order(:name).pluck(:name, :id), label: t("helper_forms.person.user"), selected: a["user_id"], include_blank: t("helper_forms.person.no_user") %>
<fieldset class="sm:col-span-2 min-w-0">
  <legend class="ss-label"><%= t("helper_forms.person.sources") %></legend>
  <% if options.empty? %>
    <p class="text-sm text-muted"><%= t("helper_forms.person.no_sources") %></p>
  <% end %>
  <ol class="grid gap-2">
    <% [ chosen.size + 1, 3 ].max.clamp(1, HelperTypes::Person::MAX_SOURCES).times do |i| %>
      <li class="flex items-center gap-2"><span class="text-xs text-muted num w-5"><%= i + 1 %>.</span>
        <%= f.ss_select :sources, options_for_select(options, chosen[i]), label: t("helper_forms.person.source", n: i + 1), hide_label: true, include_blank: "—",
                        name: "helper[sources][]", id: "src_#{i}", wrapper_class: "flex-1 min-w-0" %></li>
    <% end %>
  </ol>
  <p class="text-xs text-muted mt-1"><%= t("helper_forms.person.sources_hint") %></p>
</fieldset>
<%= f.ss_text_field :home_ssids, label: t("helper_forms.person.ssids"), value: Array(a["home_ssids"]).join(", "), placeholder: "MinhaRede, MinhaRede-5G", wrapper_class: "sm:col-span-2" %>
<%= f.ss_number_field :away_delay_min, label: t("helper_forms.person.away_delay"), value: (delay / 60.0).round(1).to_s.delete_suffix(".0"), in: 0..60, step: "any", class: "num",
                      help: t("helper_forms.person.away_delay_hint") %>
<p class="sm:col-span-2 text-xs text-muted"><%= t("helper_forms.person.privacy") %></p>
