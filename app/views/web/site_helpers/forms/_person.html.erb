<%# locals: (f:, point:) -%>
<% a = point.address %>
<% chosen = Array(a["sources"]) %>
<% options = People.trackable(point.site).map { |p| [ "#{p.name} · #{p.device.name} (#{People.tracker_for(p).label})", p.id ] } %>
<div><%= f.label :user_id, t("helper_forms.person.user"), class: "ss-label" %><%= f.select :user_id, User.where(disabled_at: nil).order(:name).pluck(:name, :id), { selected: a["user_id"], include_blank: t("helper_forms.person.no_user") }, class: "ss-input" %></div>
<fieldset class="sm:col-span-2 min-w-0">
  <legend class="ss-label"><%= t("helper_forms.person.sources") %></legend>
  <% if options.empty? %>
    <p class="text-sm text-muted"><%= t("helper_forms.person.no_sources") %></p>
  <% end %>
  <ol class="grid gap-2">
    <% [ chosen.size + 1, 3 ].max.clamp(1, HelperTypes::Person::MAX_SOURCES).times do |i| %>
      <li class="flex items-center gap-2"><span class="text-xs text-muted num w-5"><%= i + 1 %>.</span>
        <label for="src_<%= i %>" class="sr-only"><%= t("helper_forms.person.source", n: i + 1) %></label>
        <%= select_tag "helper[sources][]", options_for_select(options, chosen[i]), include_blank: "—", id: "src_#{i}", class: "ss-input" %></li>
    <% end %>
  </ol>
  <p class="text-xs text-muted mt-1"><%= t("helper_forms.person.sources_hint") %></p>
</fieldset>
<div class="sm:col-span-2"><%= f.label :home_ssids, t("helper_forms.person.ssids"), class: "ss-label" %><%= f.text_field :home_ssids, value: Array(a["home_ssids"]).join(", "), class: "ss-input", placeholder: "MinhaRede, MinhaRede-5G" %></div>
<p class="sm:col-span-2 text-xs text-muted"><%= t("helper_forms.person.privacy") %></p>
