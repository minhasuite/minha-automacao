<%# locals: (f:, point:) -%>
<%= render "web/site_helpers/forms/source_field", f: f, point: point %>
<%= f.ss_text_field :lower, label: t("helper_forms.threshold.lower"), value: point.address["lower"], class: "num", inputmode: "decimal" %>
<%= f.ss_text_field :upper, label: t("helper_forms.threshold.upper"), value: point.address["upper"], class: "num", inputmode: "decimal" %>
<%= f.ss_text_field :hysteresis, label: t("helper_forms.threshold.hysteresis"), value: point.address["hysteresis"] || 0, class: "num", inputmode: "decimal" %>
<p class="sm:col-span-2 text-xs text-muted"><%= t("helper_forms.threshold.hint") %></p>
