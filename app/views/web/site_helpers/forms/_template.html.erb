<%# locals: (f:, point:) -%>
<div><%= f.label :kind, "Resultado", class: "ss-label" %><%= f.select :kind, HelperTypes::Template::KINDS.transform_values(&:first).invert, { selected: point.address["kind"] }, class: "ss-input" %></div>
<div><%= f.label :unit, "Unidade (número)", class: "ss-label" %><%= f.text_field :unit, value: point.unit, class: "ss-input", maxlength: 20, placeholder: "°C, W" %></div>
<div class="sm:col-span-2"><%= f.label :expr, "Expressão", class: "ss-label" %><%= f.text_area :expr, value: point.address["expr"], rows: 3, maxlength: 500, class: "ss-input num text-sm", spellcheck: false, required: true,
                                                    placeholder: "sala.temperatura - externo.temperatura" %>
  <p class="text-xs text-muted mt-1">Número e liga/desliga: pontos pela chave, com + - * /, comparação, and/or, if(), round(), min(), max(). Texto: <span class="num">{{ points["sala.luz"].text }}</span>. Recalcula quando um ponto citado muda. <span class="num">previous</span> é o valor de antes (acumulador: <span class="num">previous + sala.kwh</span>). Data e hora: segundos (<span class="num">timestamp + 3600</span>) ou texto.</p></div>
<div><%= f.label :every, "A cada (opcional)", class: "ss-label" %><%= f.text_field :every, value: (Automations::Dsl.duration_label(point.address["every"]).delete(" ") if point.address["every"]), class: "ss-input num", maxlength: 10, placeholder: "1m, 15m, 1h" %>
  <p class="text-xs text-muted mt-1">Com isto, recalcula pelo relógio e não quando a origem muda.</p></div>
<div class="sm:col-span-2"><%= f.label :attrs, "Atributos (opcional)", class: "ss-label" %><%= f.text_area :attrs, value: point.address["attrs"].to_h.map { |k, v| "#{k}: #{v}" }.join("\n"), rows: 3, maxlength: 5000, class: "ss-input num text-sm", spellcheck: false,
                                                     placeholder: 'frase: {{ points["sala.luz"].text }} desde {{ points["sala.luz"].changed_at | date: "%H:%M" }}' %>
  <p class="text-xs text-muted mt-1">Um por linha, "nome: texto". Aparecem no widget Número (campo Atributo) e no texto como <span class="num">points["chave"].attrs.nome</span>.</p></div>
