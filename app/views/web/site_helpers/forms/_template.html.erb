<%# locals: (f:, point:) -%>
<%= f.ss_select :kind, HelperTypes::Template.kinds.invert, label: t("helper_forms.template.kind"), selected: point.address["kind"] %>
<%= f.ss_text_field :unit, label: t("helper_forms.template.unit"), value: point.unit, maxlength: 20, placeholder: "°C, W" %>
<%= f.ss_text_area :expr, label: t("helper_forms.template.expr"), value: point.address["expr"], rows: 3, maxlength: 500, class: "num text-sm", spellcheck: false, required: true,
                   placeholder: "sala.temperatura - externo.temperatura", help: t("helper_forms.template.expr_hint_html"), wrapper_class: "sm:col-span-2" %>
<%= f.ss_text_field :every, label: t("helper_forms.template.every"), value: (Automations::Dsl.duration_label(point.address["every"]).delete(" ") if point.address["every"]), class: "num", maxlength: 10,
                    placeholder: "1m, 15m, 1h", help: t("helper_forms.template.every_hint") %>
<%= f.ss_text_area :attrs, label: t("helper_forms.template.attrs"), value: point.address["attrs"].to_h.map { |k, v| "#{k}: #{v}" }.join("\n"), rows: 3, maxlength: 5000, class: "num text-sm", spellcheck: false,
                   placeholder: 'frase: {{ points["sala.luz"].text }} desde {{ points["sala.luz"].changed_at | date: "%H:%M" }}', help: t("helper_forms.template.attrs_hint_html"), wrapper_class: "sm:col-span-2" %>
