<%# locals: (f:, point:) -%>
<% a = point.address %>
<% sensors = point.site.points.includes(:device).where(capability: %w[contact motion tamper problem onoff gate]).where(helper: nil).ordered %>
<%= f.ss_password_field :code, label: a["code_digest"] ? t("helper_forms.alarm.new_code") : t("helper_forms.alarm.code"), value: nil, class: "num max-w-48", inputmode: "numeric",
                        autocomplete: "new-password", pattern: "[0-9]{4,8}", required: a["code_digest"].nil? %>
<%= f.ss_text_field :trigger_time, label: t("helper_forms.alarm.trigger_time"), value: helper_duration(a["trigger_s"] || 180), class: "num max-w-40", placeholder: "3m", help: t("helper_forms.alarm.trigger_hint") %>
<%= f.ss_check_box :code_arm, label: t("helper_forms.alarm.code_arm"), checked: a["code_arm"] == true, wrapper_class: "sm:col-span-2" %>
<% HelperTypes::AlarmPanel::MODES.each do |state, m| %>
  <% conf = a.dig("modes", state) || {} %>
  <% chosen = Array(conf["sensors"]) %>
  <fieldset class="sm:col-span-2 min-w-0 rounded-xl p-3 ring-1 ring-inset ring-line grid gap-3 sm:grid-cols-2">
    <legend class="px-1 ss-label"><%= t("helper_forms.alarm.mode", mode: HelperTypes::AlarmPanel.mode_label(state).downcase) %></legend>
    <%= ss_fields "helper[modes][#{state}]" do |mf| %>
      <%= mf.ss_check_box :enabled, label: t("helper_forms.alarm.use_mode"), checked: conf.present?, unchecked_value: nil, id: "mode_#{state}", wrapper_class: "sm:col-span-2" %>
      <%= mf.ss_text_field :exit, label: t("helper_forms.alarm.exit"), value: helper_duration(conf["exit_s"] || 0), id: "exit_#{state}", class: "num", placeholder: "60s" %>
      <%= mf.ss_text_field :entry, label: t("helper_forms.alarm.entry"), value: helper_duration(conf["entry_s"] || 0), id: "entry_#{state}", class: "num", placeholder: "30s" %>
      <div class="sm:col-span-2">
        <p class="ss-label"><%= t("helper_forms.alarm.sensors") %></p>
        <%= hidden_field_tag "helper[modes][#{state}][sensors][]", "", id: nil %>
        <div class="max-h-56 overflow-y-auto grid gap-1 sm:grid-cols-2">
          <% sensors.each do |s| %>
            <%= mf.ss_check_box :sensors, label: tag.span(class: "truncate font-normal") { safe_join([ s.name, " ", tag.span("· #{s.device.name}", class: "text-muted") ]) },
                                multiple: true, checked: chosen.include?(s.id), checked_value: s.id, unchecked_value: nil, id: "s_#{state}_#{s.id}", wrapper_class: "min-w-0" %>
          <% end %>
        </div>
        <% if sensors.empty? %><p class="text-sm text-muted"><%= t("helper_forms.alarm.no_sensors") %></p><% end %>
      </div>
    <% end %>
  </fieldset>
<% end %>
<p class="sm:col-span-2 text-xs text-muted"><%= t("helper_forms.alarm.hint") %></p>
