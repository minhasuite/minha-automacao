<%# locals: (f:, point:) -%>
<% datasets = point.site.datasets.order(:name) %>
<% a = point.address %>
<div class="sm:col-span-2"><%= f.label :dataset, "Conjunto de dados", class: "ss-label" %>
  <%= f.select :dataset, datasets.map { |d| [ d.name, d.id ] }, { selected: a.dig("sources", 0), include_blank: "Escolha o conjunto" }, class: "ss-input", required: true %>
  <% if datasets.empty? %><p class="text-xs text-muted mt-1">Nenhum conjunto ainda: crie em <%= link_to "Dados", site_datasets_path(point.site) %>.</p><% end %></div>
<div><%= f.label :op, "Consulta", class: "ss-label" %><%= f.select :op, Datasets.scalar_choices.invert, { selected: a["op"] }, class: "ss-input" %></div>
<div><%= f.label :field, "Campo (contagem não precisa)", class: "ss-label" %><%= f.text_field :field, value: a["field"], class: "ss-input num", maxlength: 40, placeholder: "valor" %></div>
<div><%= f.label :window, "Janela (vazio = tudo)", class: "ss-label" %><%= f.text_field :window, value: (helper_duration(a["window_s"]) if a["window_s"]), class: "ss-input num", placeholder: "24h, 168h" %></div>
<div class="sm:col-span-2"><%= f.label :filters, "Filtros (um por linha)", class: "ss-label" %>
  <%= f.text_area :filters, value: a["filters"], rows: 2, class: "ss-input num text-sm", placeholder: "porta = garagem\nvalor > 3" %>
  <p class="text-xs text-muted mt-1">Operadores: <%= Datasets.operators.map(&:symbol).join(" ") %>.</p></div>
