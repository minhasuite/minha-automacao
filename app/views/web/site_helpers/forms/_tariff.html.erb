<%# locals: (f:, point:) -%>
<% a = point.address %>
<%= f.ss_text_field :base, label: t("helper_forms.tariff.base"), value: a["base"]&.then { |v| format("%.4g", v).tr(".", ",") }, class: "num max-w-40", inputmode: "decimal", placeholder: "0,65", required: true %>
<%= f.ss_check_box :weekdays_only, label: t("helper_forms.tariff.weekdays"), checked: a.fetch("weekdays_only", true), wrapper_class: "self-end" %>
<%= f.ss_text_area :bands, label: t("helper_forms.tariff.bands"),
                   value: Array(a["bands"]).map { |b| "#{"#{b['label']} " if b['label']}#{b['from']}-#{b['to']} = #{format('%.4g', b['price']).tr('.', ',')}" }.join("\n"),
                   rows: 4, class: "num", placeholder: HelperTypes::Tariff::WHITE, help: t("helper_forms.tariff.hint"), wrapper_class: "sm:col-span-2" %>
