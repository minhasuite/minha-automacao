<%# locals: (f:, point:) -%>
<%= f.ss_number_field :min, label: t("helper_forms.number.min"), value: point.min || 0, step: "any", class: "num", required: true %>
<%= f.ss_number_field :max, label: t("helper_forms.number.max"), value: point.max || 100, step: "any", class: "num", required: true %>
<%= f.ss_number_field :step, label: t("helper_forms.step"), value: point.step || 1, step: "any", min: 0, class: "num", required: true %>
<%= f.ss_text_field :unit, label: t("helper_forms.number.unit"), value: point.unit, maxlength: 20, placeholder: "°C, min, %" %>
<%= f.ss_radio_buttons :mode, HelperTypes::Number.modes.map { |k, label| [ label, k ] }, label: t("helper_forms.number.display"), checked: point.address["mode"] || "slider", wrapper_class: "sm:col-span-2 min-w-0" %>
