<%# locals: (f:, point:) -%>
<div><%= f.label :min, t("helper_forms.number.min"), class: "ss-label" %><%= f.number_field :min, value: point.min || 0, step: "any", class: "ss-input num", required: true %></div>
<div><%= f.label :max, t("helper_forms.number.max"), class: "ss-label" %><%= f.number_field :max, value: point.max || 100, step: "any", class: "ss-input num", required: true %></div>
<div><%= f.label :step, t("helper_forms.step"), class: "ss-label" %><%= f.number_field :step, value: point.step || 1, step: "any", min: 0, class: "ss-input num", required: true %></div>
<div><%= f.label :unit, t("helper_forms.number.unit"), class: "ss-label" %><%= f.text_field :unit, value: point.unit, class: "ss-input", maxlength: 20, placeholder: "°C, min, %" %></div>
<fieldset class="sm:col-span-2 min-w-0"><legend class="ss-label"><%= t("helper_forms.number.display") %></legend>
  <div class="flex flex-wrap gap-4">
    <% HelperTypes::Number.modes.each do |k, label| %><label class="ss-check"><%= f.radio_button :mode, k, checked: (point.address["mode"] || "slider") == k %><%= label %></label><% end %>
  </div>
</fieldset>
