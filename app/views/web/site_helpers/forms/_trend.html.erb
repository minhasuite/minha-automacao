<%# locals: (f:, point:) -%>
<%= render "web/site_helpers/forms/source_field", f: f, point: point %>
<%= f.ss_text_field :window, label: t("helper_forms.window_opt"), value: (helper_duration(point.address["window_s"]) if point.address["window_s"].to_i.positive?), class: "num", placeholder: "30m" %>
<%= f.ss_text_field :min_gradient, label: t("helper_forms.trend.gradient"), value: point.address["min_gradient"] || 0, class: "num", inputmode: "decimal" %>
<%= f.ss_number_field :min_samples, label: t("helper_forms.trend.min_samples"), value: point.address["min_samples"] || 2, min: 2, step: 1, class: "num" %>
<%= f.ss_number_field :max_samples, label: t("helper_forms.trend.max_samples"), value: point.address["max_samples"] || 2, min: 2, max: HelperTypes::Derivative::MAX_SAMPLES, step: 1, class: "num" %>
<%= f.ss_check_box :invert, label: t("helper_forms.trend.invert"), checked: point.address["invert"] == true, wrapper_class: "sm:col-span-2" %>
<p class="sm:col-span-2 text-xs text-muted"><%= t("helper_forms.trend.hint") %></p>
