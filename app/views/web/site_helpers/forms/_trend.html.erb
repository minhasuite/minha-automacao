<%# locals: (f:, point:) -%>
<%= render "web/site_helpers/forms/source_field", f: f, point: point %>
<div><%= f.label :window, t("helper_forms.window_opt"), class: "ss-label" %><%= f.text_field :window, value: (helper_duration(point.address["window_s"]) if point.address["window_s"].to_i.positive?), class: "ss-input num", placeholder: "30m" %></div>
<div><%= f.label :min_gradient, t("helper_forms.trend.gradient"), class: "ss-label" %><%= f.text_field :min_gradient, value: point.address["min_gradient"] || 0, class: "ss-input num", inputmode: "decimal" %></div>
<div><%= f.label :min_samples, t("helper_forms.trend.min_samples"), class: "ss-label" %><%= f.number_field :min_samples, value: point.address["min_samples"] || 2, min: 2, step: 1, class: "ss-input num" %></div>
<div><%= f.label :max_samples, t("helper_forms.trend.max_samples"), class: "ss-label" %><%= f.number_field :max_samples, value: point.address["max_samples"] || 2, min: 2, max: HelperTypes::Derivative::MAX_SAMPLES, step: 1, class: "ss-input num" %></div>
<label class="ss-check sm:col-span-2"><%= f.check_box :invert, { checked: point.address["invert"] == true }, "1", "0" %><%= t("helper_forms.trend.invert") %></label>
<p class="sm:col-span-2 text-xs text-muted"><%= t("helper_forms.trend.hint") %></p>
