<%# locals: (f:, point:) -%>
<%= f.ss_select :prefix, [ [ t("helper_forms.units.none"), "" ], [ t("helper_forms.units.k"), "k" ], [ t("helper_forms.units.m"), "M" ], [ t("helper_forms.units.g"), "G" ] ], label: t("helper_forms.units.prefix"), selected: point.address["prefix"] %>
<%= f.ss_select :time_unit, [ [ t("helper_forms.units.s"), "s" ], [ t("helper_forms.units.min"), "min" ], [ t("helper_forms.units.h"), "h" ], [ t("helper_forms.units.d"), "d" ] ], label: t("helper_forms.units.time"), selected: point.address["time_unit"] || "h" %>
<%= f.ss_number_field :round, label: t("helper_forms.units.round"), value: point.address.fetch("round", 3), min: 0, max: 6, step: 1, class: "num" %>
