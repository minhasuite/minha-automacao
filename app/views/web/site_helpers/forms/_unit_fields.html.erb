<%# locals: (f:, point:) -%>
<div><%= f.label :prefix, "Prefixo da unidade", class: "ss-label" %><%= f.select :prefix, [ [ "Nenhum", "" ], [ "k (mil)", "k" ], [ "M (milhão)", "M" ], [ "G (bilhão)", "G" ] ], { selected: point.address["prefix"] }, class: "ss-input" %></div>
<div><%= f.label :time_unit, "Unidade de tempo", class: "ss-label" %><%= f.select :time_unit, [ [ "Segundo", "s" ], [ "Minuto", "min" ], [ "Hora", "h" ], [ "Dia", "d" ] ], { selected: point.address["time_unit"] || "h" }, class: "ss-input" %></div>
<div><%= f.label :round, "Casas decimais", class: "ss-label" %><%= f.number_field :round, value: point.address.fetch("round", 3), min: 0, max: 6, step: 1, class: "ss-input num" %></div>
