<%# locals: (f:, point:) -%>
<% sources = point.site.points.includes(:device).where(data_type: %w[integer decimal]).where.not(id: point.id).ordered %>
<div class="sm:col-span-2"><%= f.label :source, "Ponto de origem", class: "ss-label" %>
  <%= f.select :source, sources.map { |p| [ "#{p.name} · #{p.device.name}", p.id ] }, { selected: point.address.dig("sources", 0), include_blank: "Escolha um ponto numérico" }, class: "ss-input", required: true %></div>
<div><%= f.label :func, "Cálculo", class: "ss-label" %><%= f.select :func, HelperTypes::Statistics::FUNCS.invert, { selected: point.address["func"] }, class: "ss-input" %></div>
<div><%= f.label :window, "Janela", class: "ss-label" %><%= f.text_field :window, value: helper_duration(point.address["window_s"]), class: "ss-input num", required: true, placeholder: "1h, 30m, 24h" %></div>
