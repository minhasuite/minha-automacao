<%# locals: (f:, point:) -%>
<% sources = point.site.points.includes(:device).where(data_type: %w[integer decimal]).where.not(id: point.id).ordered %>
<%= f.ss_select :source, sources.map { |p| [ "#{p.name} · #{p.device.name}", p.id ] }, label: t("helper_forms.source"), selected: point.address.dig("sources", 0),
                include_blank: t("helper_forms.pick_numeric"), required: true, wrapper_class: "sm:col-span-2" %>
<%= f.ss_select :func, HelperTypes::Statistics.funcs.invert, label: t("helper_forms.statistics.func"), selected: point.address["func"] %>
<%= f.ss_text_field :window, label: t("helper_forms.statistics.window"), value: helper_duration(point.address["window_s"]), class: "num", required: true, placeholder: "1h, 30m, 24h" %>
