<%# locals: (f:, point:) -%>
<%= f.ss_number_field :initial, label: t("helper_forms.counter.initial"), value: point.address["initial"] || 0, step: 1, class: "num", required: true %>
<%= f.ss_number_field :step, label: t("helper_forms.step"), value: (point.step || 1).to_i, step: 1, min: 1, class: "num", required: true %>
<%= f.ss_number_field :min, label: t("helper_forms.counter.min"), value: point.min&.to_i, step: 1, class: "num" %>
<%= f.ss_number_field :max, label: t("helper_forms.counter.max"), value: point.max&.to_i, step: 1, class: "num" %>
