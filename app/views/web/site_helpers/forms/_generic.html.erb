<%# locals: (f:, point:) -%>
<%# ondaA1 (A10): formulário montado pelo plugin (`form_spec`): [campo, tipo, opções]. Rótulo e dica vêm dos textos do plugin ("form.<campo>", "hint.<campo>"). -%>
<% plugin = point.helper_type %>
<% a = point.address %>
<% plugin.form_spec.each do |name, kind, opts| %>
  <% opts ||= {} %>
  <% label = plugin.text("form.#{name}") %>
  <% help = plugin.text("hint.#{name}", default: "").presence %>
  <% value = opts[:value] ? opts[:value].call(point) : a[name.to_s] %>
  <% wide = opts[:wide] || %i[point source textarea].include?(kind) %>
  <div class="<%= class_names("sm:col-span-2": wide, "sm:pt-6": kind == :bool) %>">
    <% case kind %>
    <% when :source, :point %>
      <% list = point.site.points.includes(:device).where.not(id: point.id).ordered.to_a %>
      <% list = list.select(&:numeric?) if kind == :source %>
      <% list = list.select { |p| opts[:filter].call(p) } if opts[:filter] %>
      <% chosen = opts[:index] ? Array(a["sources"])[opts[:index]] : value %>
      <%= f.ss_select name, options_for_select(list.map { |p| [ "#{p.name} · #{p.device.name}#{" (#{p.unit})" if p.unit.present?}", p.id ] }, chosen),
                      label: label, help: help, include_blank: opts[:required] == false ? "—" : t("helper_forms.pick_numeric"), required: opts[:required] != false %>
    <% when :select %>
      <%= f.ss_select name, options_for_select(opts[:choices].call.map { |k, v| [ v, k ] }, value), label: label, help: help %>
    <% when :bool %>
      <%= f.ss_check_box name, label: label, help: help, checked: value == true %>
    <% when :textarea %>
      <%= f.ss_text_area name, label: label, help: help, value: value, rows: 4, class: "font-mono text-sm", placeholder: opts[:placeholder] %>
    <% else %>
      <%= f.ss_text_field name, label: label, help: help, value: value, class: ("num" if kind == :number), inputmode: (kind == :number ? "decimal" : nil), placeholder: opts[:placeholder] %>
    <% end %>
  </div>
<% end %>
