<%# locals: (f:, point:, label: t("helper_forms.source")) -%>
<% sources = point.site.points.includes(:device).where(data_type: %w[integer decimal]).where.not(id: point.id).ordered %>
<%= f.ss_select :source, sources.map { |p| [ "#{p.name} · #{p.device.name}#{" (#{p.unit})" if p.unit.present?}", p.id ] }, label: label, selected: point.address.dig("sources", 0),
                include_blank: t("helper_forms.pick_numeric"), required: true, wrapper_class: "sm:col-span-2" %>
