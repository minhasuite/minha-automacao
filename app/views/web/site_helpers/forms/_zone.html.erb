<%# locals: (f:, point:) -%>
<% a = point.address %>
<% site = point.site %>
<%= f.ss_check_box :home, label: "#{t('helper_forms.zone.home')}#{": #{site.latitude}, #{site.longitude}" if site.latitude && site.longitude})", checked: a["home"] == true, wrapper_class: "sm:col-span-2" %>
<fieldset class="sm:col-span-2 grid grid-cols-2 gap-2">
  <legend class="ss-label"><%= t("helper_forms.zone.center") %> <span class="font-normal"><%= t("helper_forms.zone.center_note") %></span></legend>
  <%= f.ss_text_field :latitude, label: "Latitude", value: a["latitude"], class: "num", inputmode: "decimal", placeholder: "-12,345678" %>
  <%= f.ss_text_field :longitude, label: "Longitude", value: a["longitude"], class: "num", inputmode: "decimal", placeholder: "-45,678901" %>
</fieldset>
<%= f.ss_number_field :radius_m, label: t("helper_forms.zone.radius"), value: a["radius_m"] || HelperTypes::Zone::DEFAULT_RADIUS, min: 20, max: 50_000, class: "num max-w-40" %>
<p class="sm:col-span-2 text-xs text-muted"><%= t("helper_forms.zone.hint") %></p>
