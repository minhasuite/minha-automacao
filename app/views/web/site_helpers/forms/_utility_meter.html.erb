<%# locals: (f:, point:) -%>
<%= render "web/site_helpers/forms/source_field", f: f, point: point, label: t("helper_forms.meter.source") %>
<%= f.ss_select :cycle, HelperTypes::UtilityMeter.cycles.invert, label: t("helper_forms.meter.cycle"), selected: point.address["cycle"] || "month" %>
<%= f.ss_number_field :day, label: t("helper_forms.meter.day"), value: point.address["day"] || 1, min: 1, max: 28, step: 1, class: "num" %>
<%= f.ss_text_field :cron, label: t("helper_forms.meter.cron"), value: point.address["cron"], class: "num", placeholder: t("helper_forms.meter.cron_ph"), help: t("helper_forms.meter.cron_hint"), wrapper_class: "sm:col-span-2" %>
<%= f.ss_text_field :tariffs_text, label: t("helper_forms.meter.tariffs"), value: point.options.to_a.join(", "), placeholder: t("helper_forms.meter.tariffs_ph"), help: t("helper_forms.meter.tariffs_hint_html"), wrapper_class: "sm:col-span-2" %>
