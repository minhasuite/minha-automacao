<%# locals: (f:, point:) -%>
<%= render "web/site_helpers/forms/source_field", f: f, point: point, label: t("helper_forms.meter.source") %>
<div><%= f.label :cycle, t("helper_forms.meter.cycle"), class: "ss-label" %><%= f.select :cycle, HelperTypes::UtilityMeter.cycles.invert, { selected: point.address["cycle"] || "month" }, class: "ss-input" %></div>
<div><%= f.label :day, t("helper_forms.meter.day"), class: "ss-label" %><%= f.number_field :day, value: point.address["day"] || 1, min: 1, max: 28, step: 1, class: "ss-input num" %></div>
<div class="sm:col-span-2"><%= f.label :cron, t("helper_forms.meter.cron"), class: "ss-label" %><%= f.text_field :cron, value: point.address["cron"], class: "ss-input num", placeholder: t("helper_forms.meter.cron_ph") %>
  <p class="text-xs text-muted mt-1"><%= t("helper_forms.meter.cron_hint") %></p></div>
<div class="sm:col-span-2"><%= f.label :tariffs_text, t("helper_forms.meter.tariffs"), class: "ss-label" %><%= f.text_field :tariffs_text, value: point.options.to_a.join(", "), class: "ss-input", placeholder: t("helper_forms.meter.tariffs_ph") %>
  <p class="text-xs text-muted mt-1"><%= t("helper_forms.meter.tariffs_hint_html") %></p></div>
