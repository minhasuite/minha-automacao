<%# locals: (f:, point:) -%>
<%= render "web/site_helpers/forms/source_field", f: f, point: point, label: t("helper_forms.integral.source") %>
<%= f.ss_select :method, HelperTypes::Integral.methods_labels.invert, label: t("helper_forms.integral.method"), selected: point.address["method"] %>
<%= render "web/site_helpers/forms/unit_fields", f: f, point: point %>
<%= f.ss_text_field :max_interval, label: t("helper_forms.integral.max"), value: helper_duration(point.address["max_s"]), class: "num", placeholder: "5m" %>
<p class="sm:col-span-2 text-xs text-muted"><%= t("helper_forms.integral.hint") %></p>
