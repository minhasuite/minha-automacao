<%# locals: (f:, point:) -%>
<%= render "web/site_helpers/forms/source_field", f: f, point: point, label: t("helper_forms.integral.source") %>
<div><%= f.label :method, t("helper_forms.integral.method"), class: "ss-label" %><%= f.select :method, HelperTypes::Integral.methods_labels.invert, { selected: point.address["method"] }, class: "ss-input" %></div>
<%= render "web/site_helpers/forms/unit_fields", f: f, point: point %>
<div><%= f.label :max_interval, t("helper_forms.integral.max"), class: "ss-label" %><%= f.text_field :max_interval, value: helper_duration(point.address["max_s"]), class: "ss-input num", placeholder: "5m" %></div>
<p class="sm:col-span-2 text-xs text-muted"><%= t("helper_forms.integral.hint") %></p>
