<%# locals: (f:, point:) -%>
<% selected = Array(point.address["sources"]) %>
<% members = point.site.points.includes(:device).where(capability: HelperTypes::Group::BOOL_CAPS + HelperTypes::Group::NUM_CAPS)
                  .where.not(id: point.id).where("points.helper IS DISTINCT FROM 'group'").ordered %>
<fieldset class="sm:col-span-2 min-w-0">
  <legend class="ss-label"><%= t("helper_forms.group.members") %></legend>
  <%= hidden_field_tag "helper[members][]", "", id: nil %>
  <div class="max-h-72 overflow-y-auto rounded-xl p-3 grid gap-3 ring-1 ring-inset ring-line">
    <% members.group_by(&:capability_label).sort.each do |cap, ps| %>
      <div>
        <p class="text-xs font-bold uppercase text-muted mb-1"><%= cap %></p>
        <div class="grid gap-1 sm:grid-cols-2">
          <% ps.each do |p| %>
            <%= f.ss_check_box :members, label: tag.span(class: "truncate font-normal") { safe_join([ p.name, " ", tag.span("· #{p.device.name}", class: "text-muted") ]) },
                               multiple: true, checked: selected.include?(p.id), checked_value: p.id, unchecked_value: nil, id: "m_#{p.id}", wrapper_class: "min-w-0" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  <p class="text-xs text-muted mt-1"><%= t("helper_forms.group.hint") %></p>
</fieldset>
<%= f.ss_select :mode, grouped_options_for_select([ [ t("helper_forms.group.bool"), HelperTypes::Group.bool_modes.invert.to_a ], [ t("helper_forms.group.num"), HelperTypes::Group.num_modes.invert.to_a ] ], point.address["mode"]),
                label: t("helper_forms.group.value"), wrapper_class: "sm:col-span-2" %>
