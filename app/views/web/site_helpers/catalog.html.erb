<%= render "web/shared/header", title: "Criar helper", subtitle: "Escolha o tipo. Depois de criado, ele vira um ponto para automações, painéis, histórico e API.", back: site_helpers_path(@site) %>
<ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3" aria-label="Tipos de helper">
  <% HelperTypes.plugins.each do |p| %>
    <li>
      <%= link_to new_site_helper_path(@site, tipo: p.key), class: "ss-card ss-card-link p-4 no-underline flex items-start gap-3 h-full" do %>
        <span class="grid place-items-center size-11 shrink-0 rounded-2xl ss-grad"><%= icon(p.icon) %></span>
        <span class="min-w-0">
          <span class="block font-bold text-ink"><%= p.title %></span>
          <span class="block text-sm text-muted mt-0.5"><%= p.description %></span>
        </span>
      <% end %>
    </li>
  <% end %>
</ul>
