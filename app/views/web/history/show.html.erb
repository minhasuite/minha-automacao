<% ids = @selected.map(&:id) %>
<% span = @to - @from %>
<% now = Time.current %>
<% zone = @zone.tzinfo.name %>
<% index = @selected.each_with_index.to_h { |p, i| [ p.id, i ] } %>
<% suggestions = Points::Overlay.suggestions(@site) %>
<%= render "web/shared/header", title: t("points.show.history"), subtitle: t("history.subtitle") do %>
  <%= link_to logbook_path(site_id: @site.id), class: "ss-btn ss-btn-ghost" do %><%= icon("view-list", "size-4") %><%= t("logbook.title") %><% end %>
  <% if ids.any? %>
    <%= link_to history_path(site_id: @site.id, point_ids: ids, from: @from.iso8601, to: @to.iso8601, format: :csv), class: "ss-btn ss-btn-outline", data: { turbo: false } do %><%= icon("download", "size-4") %><%= t("history.csv") %><% end %>
  <% end %>
<% end %>
<%= render "web/shared/site_switch", sites: @sites, site: @site, path: history_path %>

<%# Período: atalhos numa faixa só (rola no celular, o atual à vista), a janela com ‹ › e aproximar/afastar, e as datas. %>
<section class="ss-card ss-card-pad grid gap-3 mb-4" aria-label="<%= t("history.period") %>">
  <nav class="ss-chips is-solid" data-controller="ss-scroll-current" aria-label="<%= t("history.shortcuts") %>">
    <% Points::Overlay::DAY_LABELS.merge(Points::Overlay::RANGE_LABELS).each do |k, label| %>
      <% on = Points::Overlay.current?(k, @from, @to, now: now) %>
      <%= link_to label, history_path(site_id: @site.id, point_ids: ids, range: k), class: "ss-chip shrink-0", "aria-current": on.to_s %>
    <% end %>
  </nav>
  <div class="flex flex-wrap items-center gap-x-1.5 gap-y-2">
    <div class="flex min-w-0 items-center gap-1">
      <%= link_to hx_path(@site, ids, @from - span, @to - span), class: "ss-icon-btn", title: t("history.previous"), "aria-label": t("history.previous") do %><%= icon("chevron-left", "size-4") %><% end %>
      <p class="mx-1 text-sm font-semibold text-ink num"><%= l(@from.in_time_zone(@zone), format: "%d/%m %H:%M") %> <span class="text-muted"><%= t("history.until") %></span> <%= l(@to.in_time_zone(@zone), format: "%d/%m %H:%M") %></p>
      <% if now - @to > 1.minute %>
        <%= link_to hx_path(@site, ids, @from + span, [ @to + span, now ].min), class: "ss-icon-btn", title: t("history.next"), "aria-label": t("history.next") do %><%= icon("chevron-right", "size-4") %><% end %>
      <% else %>
        <span class="ss-icon-btn opacity-40" aria-disabled="true" aria-hidden="true"><%= icon("chevron-right", "size-4") %></span>
      <% end %>
    </div>
    <div class="flex items-center gap-1 sm:ml-auto">
      <%= link_to hx_path(@site, ids, @from + (span / 4), @to - (span / 4)), class: "ss-btn ss-btn-ghost ss-btn-sm", title: t("history.zoom_in") do %><%= icon("zoom-in", "size-4") %><span class="max-sm:sr-only"><%= t("history.zoom_in") %></span><% end %>
      <%= link_to hx_path(@site, ids, @from - (span / 2), [ @to + (span / 2), now ].min), class: "ss-btn ss-btn-ghost ss-btn-sm", title: t("history.zoom_out") do %><%= icon("zoom-out", "size-4") %><span class="max-sm:sr-only"><%= t("history.zoom_out") %></span><% end %>
    </div>
  </div>
  <details>
    <summary class="ss-summary text-sm font-semibold text-ink-2"><%= icon("calendar", "size-4") %><%= t("history.pick_dates") %></summary>
    <%= ss_form_with url: history_path, method: :get, class: "flex flex-wrap gap-3 mt-2.5" do |f| %>
      <%= hidden_field_tag :site_id, @site.id, id: nil %>
      <% ids.each do |id| %><%= hidden_field_tag "point_ids[]", id, id: nil %><% end %>
      <%= f.ss_datetime_local_field :from, label: t("history.from"), value: @from.in_time_zone(@zone).strftime("%Y-%m-%dT%H:%M"), class: "num", id: "hx-from", wrapper_class: "flex-[1_1_12rem]" %>
      <%= f.ss_datetime_local_field :to, label: t("history.to"), value: @to.in_time_zone(@zone).strftime("%Y-%m-%dT%H:%M"), class: "num", id: "hx-to", wrapper_class: "flex-[1_1_12rem]" %>
      <%= render Ss::ButtonComponent.new(label: t("points.apply"), type: :submit, class: "self-end") %>
    <% end %>
  </details>
</section>

<%# Gráficos no principal; os pontos (escolhidos, sugestões e a busca) na coluna da gem, que no celular desce. %>
<%= render Ss::AsideLayoutComponent.new(label: t("history.points")) do |lay| %>
  <% lay.with_main do %>
    <% if @selected.any? %>
      <% chart_url = history_path(site_id: @site.id, point_ids: ids) %>
      <% zoomed = params[:from].present? %>
      <div class="grid gap-4">
        <% @overlay.charts.each do |unit, series| %>
          <% unit_name = unit.presence || t("history.no_unit") %>
          <section class="ss-card ss-card-pad" aria-label="<%= t("history.chart", unit: unit.presence || t("history.no_unit").downcase) %>">
            <%= render Ss::CardHeaderComponent.new(title: unit_name, icon: icon("chart-bar", ""),
                                                   subtitle: series.first.resolution == "raw" ? t("history.readings") : t(series.first.resolution == "1h" ? "history.hourly" : "history.daily")) %>
            <%= render Ss::TimeSeriesChartComponent.new(title: t("history.chart", unit: unit_name.downcase), from: @from, to: @to, series: hx_series(series, index, @to),
                                                        legend: false, height: 260, zoom_url: chart_url, reset_url: chart_url, zoomed: zoomed, time_zone: zone,
                                                        texts: { empty: t("history.no_readings") }, css: "mt-3") %>
            <p class="text-xs text-muted mt-2 max-sm:hidden"><%= t("history.drag") %></p>
            <%# Legenda com o resumo da janela: agora, mínimo, máximo e média de cada série. %>
            <ul class="mt-3 grid grid-cols-1 gap-1 border-t border-line pt-3" aria-label="<%= t("history.summary") %>">
              <% series.each do |s| %>
                <% st = hx_stats(s) %>
                <li class="grid min-w-0 grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-2.5 gap-y-0.5 py-1">
                  <span class="inline-block size-2.5 shrink-0 rounded-full" style="background: <%= hx_color(index[s.point.id]) %>" aria-hidden="true"></span>
                  <%= link_to Logbook.point_title(s.point), point_path(s.point), class: "truncate text-sm font-semibold no-underline text-ink hover:text-accent" %>
                  <strong class="num text-sm text-ink"><%= point_value_text(s.point) %></strong>
                  <% if st %>
                    <span class="col-start-2 col-span-2 text-xs text-muted num"><%= t("history.stats", min: hx_num(st[:min], s.point.unit), max: hx_num(st[:max], s.point.unit), avg: hx_num(st[:avg], s.point.unit)) %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
        <% if @overlay.timelines.any? %>
          <section class="ss-card ss-card-pad" aria-labelledby="hx-tl-title">
            <%= render Ss::CardHeaderComponent.new(title: t("history.timeline"), icon: icon("view-list", ""), id: "hx-tl-title", heading: :h2) %>
            <%= render Ss::StateBandsComponent.new(title: t("history.timeline"), from: @from, to: @to, rows: hx_band_rows(@overlay.timelines), time_zone: zone,
                                                   label_position: :top, css: "mt-3") %>
          </section>
        <% end %>
      </div>
    <% else %>
      <% chips = capture do %>
        <% if suggestions.any? %>
          <div class="flex flex-wrap justify-center gap-2">
            <% suggestions.each do |g| %>
              <%= link_to history_path(site_id: @site.id, point_ids: g[:ids], from: @from.iso8601, to: @to.iso8601), class: "ss-chip no-underline" do %><%= [ g[:label], g[:unit] ].compact.join(" · ") %> <span class="text-muted num">(<%= g[:count] %>)</span><% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>
      <%# mobile-ajustes: o vazio num card da largura da coluna (como o do período), não num cartão estreito solto. %>
      <div class="ss-card"><%= render "web/shared/empty_art", art: "search", title: t("history.empty"), text: t("history.empty_hint"), actions: chips.presence %></div>
    <% end %>
  <% end %>

  <% lay.with_aside do %>
    <div class="grid min-w-0 gap-4">
      <section class="ss-card ss-card-pad min-w-0" aria-labelledby="hx-points-title">
        <%= render Ss::CardHeaderComponent.new(title: t("history.points"), icon: icon("adjustments", ""), id: "hx-points-title", heading: :h2,
                                               subtitle: (@selected.any? ? t("history.chosen", count: @selected.size, max: Points::Overlay::MAX) : t("history.none_chosen"))) do |h| %>
          <% if @selected.any? %>
            <% h.with_action do %><%= link_to t("history.clear"), history_path(site_id: @site.id, from: @from.iso8601, to: @to.iso8601), class: "ss-btn ss-btn-ghost ss-btn-sm" %><% end %>
          <% end %>
        <% end %>
        <% if @selected.any? %>
          <ul class="mt-2 grid grid-cols-1 gap-0.5">
            <% @selected.each_with_index do |p, i| %>
              <li class="ss-item min-w-0">
                <span class="inline-block size-3 shrink-0 rounded-full" style="background: <%= hx_color(i) %>" aria-hidden="true"></span>
                <span class="ss-item-main"><span class="text-sm"><%= Logbook.point_title(p) %></span>
                  <span class="text-xs num"><%= point_value_text(p) %></span></span>
                <%= link_to history_path(site_id: @site.id, point_ids: ids - [ p.id ], from: @from.iso8601, to: @to.iso8601), class: "ss-icon-btn is-sm",
                            title: t("history.remove", name: p.name), "aria-label": t("history.remove", name: p.name) do %><%= icon("x", "size-4") %><% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
        <% if suggestions.any? && @selected.any? %>
          <p class="ss-kicker mt-4 mb-1.5"><%= t("history.suggestions") %></p>
          <div class="flex flex-wrap gap-1.5">
            <% suggestions.each do |g| %>
              <%= link_to history_path(site_id: @site.id, point_ids: g[:ids], from: @from.iso8601, to: @to.iso8601), class: "ss-chip no-underline", title: t("history.suggestion_title", count: g[:count]) do %><%= [ g[:label], g[:unit] ].compact.join(" · ") %><% end %>
            <% end %>
          </div>
        <% end %>
      </section>

      <section id="hx-pick" class="ss-card ss-card-pad min-w-0" aria-labelledby="hx-pick-title">
        <%= render Ss::CardHeaderComponent.new(title: t("history.pick_points"), icon: icon("plus", ""), id: "hx-pick-title", heading: :h2, subtitle: t("history.pick_hint", n: Points::Overlay::MAX)) %>
        <%= ss_form_with url: history_path, method: :get, data: { controller: "ss-filter" }, class: "mt-3" do |f| %>
          <%= hidden_field_tag :site_id, @site.id, id: nil %>
          <%= hidden_field_tag :from, @from.iso8601, id: nil %><%= hidden_field_tag :to, @to.iso8601, id: nil %>
          <%# Busca só na tela (ss-filter): nome do ponto, do aparelho e a área; sem name, não vai na URL. %>
          <div class="flex items-center gap-2">
            <%= f.ss_search_field :hx_filter, name: nil, id: "hx-filter", label: t("history.filter_points"), hide_label: true, prefix: icon("search", ""),
                                  placeholder: t("history.filter_name"), wrapper_class: "min-w-0 flex-1",
                                  data: { ss_filter_target: "input", action: "input->ss-filter#apply keydown.esc->ss-filter#clear" } %>
            <%= render Ss::ButtonComponent.new(label: t("history.show"), type: :submit) %>
          </div>
          <% groups = @site.points.where(hidden: false, disabled: false).where.not(capability: %w[stream calendar command]).includes(:device, :area, device: :area).ordered.group_by { |p| p.area&.name || p.device.area&.name || t("devices.no_area") } %>
          <div class="grid gap-4 mt-3 max-h-[34rem] overflow-auto overscroll-contain pr-1">
            <% groups.sort_by { |k, _| k == t("devices.no_area") ? "~" : k }.each do |area, pts| %>
              <fieldset class="grid gap-2 content-start" data-ss-filter-target="group"><legend class="ss-section"><%= area %></legend>
                <% pts.each do |p| %>
                  <%= render Ss::OptionCardComponent.new(type: :checkbox, name: "point_ids[]", value: p.id, id: "hx-p-#{p.id}", dense: true, checked: ids.include?(p.id), title: p.name,
                                                         description: "#{p.device.name} · #{p.numeric? ? (p.unit.presence || t("history.number")) : t("history.bands")}",
                                                         data: { ss_filter_target: "item", ss_filter_text: [ p.name, p.device.name, area ].join(" ") }) %>
                <% end %>
              </fieldset>
            <% end %>
            <p class="text-sm text-muted" data-ss-filter-target="empty" hidden><%= t("history.no_match") %></p>
          </div>
        <% end %>
      </section>
    </div>
  <% end %>
<% end %>
