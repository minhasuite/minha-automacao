<%= render "web/shared/header", title: t("ai_settings.title"), subtitle: t("ai_settings.subtitle") %>
<% owner = current_user.owner? %>
<% b = @budget %>
<%= render layout: "web/settings/frame", locals: { current: :ai } do %>
<section class="ss-card ss-card-pad" aria-labelledby="mes-t">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="mes-t"><%= t("ai_settings.month") %></h2>
    <p class="text-sm text-muted"><%= b.exceeded? ? t("ai_settings.exceeded") : t("ai_settings.stops") %></p>
  </div>
  <dl class="mt-3 grid gap-3 grid-cols-2 sm:grid-cols-4 text-sm">
    <div><dt class="text-muted"><%= t("ai_settings.calls") %></dt><dd class="text-xl font-bold text-ink num"><%= b.calls %><%= " / #{b.limit_calls}" if b.limit_calls %></dd></div>
    <div><dt class="text-muted"><%= t("ai_settings.spent") %></dt><dd class="text-xl font-bold text-ink num"><%= usd(b.cost) %></dd></div>
    <div><dt class="text-muted"><%= t("ai_settings.limit") %></dt><dd class="text-xl font-bold text-ink num"><%= b.limit_usd ? usd(b.limit_usd) : t("ai_settings.no_limit") %></dd></div>
    <div><dt class="text-muted"><%= t("ai_settings.default") %></dt><dd class="text-xl font-bold text-ink truncate"><%= Ai.provider(b.default_provider)&.label || AiAccount.pick&.plugin&.label || t("ai_settings.none") %></dd></div>
  </dl>
  <% if b.ratio %>
    <div class="ss-progress mt-3" role="progressbar" aria-label="<%= t("ai_settings.usage") %>" aria-valuenow="<%= (b.ratio * 100).round %>" aria-valuemin="0" aria-valuemax="100">
      <div class="ss-progress-bar <%= b.ratio >= 1 ? 'bg-danger' : ('bg-warn' if b.ratio >= 0.8) %>" style="width: <%= [ (b.ratio * 100).round, 100 ].min %>%"></div>
    </div>
  <% end %>
  <% if owner %>
    <%= ss_form_with url: settings_ai_path, method: :patch, scope: :ai, class: "mt-4 grid gap-3 sm:grid-cols-3 items-end" do |f| %>
      <%= f.ss_select :default_provider, Ai.providers.map { |p| [ p.label, p.key ] }, label: t("ai_settings.default"), selected: b.default_provider, include_blank: t("ai_settings.first") %>
      <%= f.ss_text_field :limit_usd, label: t("ai_settings.limit_usd"), value: b.limit_usd&.then { |v| v % 1 == 0 ? v.to_i : v }, class: "num", inputmode: "decimal", placeholder: t("ai_settings.no_limit") %>
      <%= f.ss_number_field :limit_calls, label: t("ai_settings.limit_calls"), value: b.limit_calls, min: 1, class: "num", placeholder: t("ai_settings.no_limit") %>
      <div class="sm:col-span-3"><%= f.ss_submit t("ai_settings.save_limit"), name: nil %></div>
    <% end %>
  <% end %>
</section>

<h2 class="mt-6 mb-3"><%= t("ai_settings.providers") %></h2>
<div class="grid gap-4 md:grid-cols-2">
  <% Ai.providers.each do |plugin| %>
    <% acc = @accounts[plugin.key] %>
    <section id="<%= plugin.key %>" class="ss-card ss-card-pad scroll-mt-24 min-w-0" aria-labelledby="p-<%= plugin.key %>">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h3 id="p-<%= plugin.key %>" class="font-bold text-ink flex items-center gap-2"><%= icon("sparkles", "size-5") %><%= plugin.label %></h3>
        <% if acc&.usable? %>
          <span class="ss-badge <%= acc.last_error ? 'ss-badge-danger' : 'ss-badge-success' %>"><%= acc.last_error ? t("site_helpers.index.error") : (acc.last_ok_at ? t("ai_settings.tested") : t("ai_settings.configured")) %></span>
        <% else %>
          <span class="ss-badge"><%= acc && !acc.enabled ? t("ai_settings.off") : t("ai_settings.no_key") %></span>
        <% end %>
      </div>
      <div class="mt-2 flex flex-wrap gap-1" aria-label="<%= t("ai_settings.capabilities") %>">
        <% plugin.capabilities.each do |c| %><span class="ss-badge ss-badge-accent"><%= t("ai_settings.caps.#{c}", default: Ai::CAPABILITIES[c]) %></span><% end %>
      </div>
      <% if plugin.hint %><p class="mt-2 text-xs text-muted"><%= plugin.hint %></p><% end %>
      <% if acc&.last_error %><p class="mt-2 text-sm text-danger" role="alert"><%= acc.last_error %></p><% end %>
      <% if acc&.last_ok_at %><p class="mt-1 text-xs text-muted"><%= t("ai_settings.last_ok", ago: ago_text(acc.last_ok_at)) %></p><% end %>
      <% if owner %>
        <%= ss_form_with url: settings_ai_provider_path(plugin.key), method: :patch, scope: :account, class: "mt-3 grid gap-3" do |f| %>
          <%= f.ss_password_field :api_key, label: plugin.key_required? ? t("ai_settings.api_key") : t("ai_settings.key_opt"), id: "k-#{plugin.key}", autocomplete: "new-password", maxlength: 300,
                                            placeholder: acc&.api_key.present? ? t("ai_settings.key_kept") : t("ai_settings.key_paste") %>
          <% if plugin.custom_url? %>
            <%= f.ss_url_field :base_url, label: t("ai_settings.base_url"), id: "u-#{plugin.key}", value: acc&.base_url, class: "num", placeholder: plugin.base_url %>
          <% end %>
          <div>
            <%= f.ss_text_field :model, label: t("ai_settings.model_default", model: plugin.default_model), id: "m-#{plugin.key}", value: acc&.model, class: "num", list: "models-#{plugin.key}", maxlength: 100, placeholder: plugin.default_model %>
            <datalist id="models-<%= plugin.key %>"><% plugin.models.each do |m| %><option value="<%= m %>"></option><% end %></datalist></div>
          <div class="flex flex-wrap gap-x-4 gap-y-1">
            <%= f.ss_check_box :enabled, label: t("ai_settings.enabled"), checked: acc.nil? || acc.enabled, id: "e-#{plugin.key}" %>
            <% if acc&.api_key.present? %><%= f.ss_check_box :remove_key, label: t("ai_settings.remove_key"), id: "r-#{plugin.key}", unchecked_value: nil %><% end %>
          </div>
          <div><%= f.ss_submit t("site_helpers.form.save"), small: true, name: nil %></div>
        <% end %>
        <% if acc&.usable? %>
          <%= render Ss::ButtonComponent.new(label: t("ai_settings.test"), icon: icon("lightning-bolt", ""), href: settings_ai_check_path(plugin.key), method: :post,
                                             variant: :outline, size: :sm, class: "mt-2") %>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>

<section class="mt-6" aria-labelledby="uso-t">
  <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="uso-t"><%= t("ai_settings.usage_title") %></h2>
    <p class="text-sm text-muted"><%= @by_source.map { |s, c| "#{AiCall.source_text(s)}: #{usd(c)}" }.join(" · ").presence || t("ai_settings.no_spend") %></p>
  </div>
  <%= render Ss::DataTableComponent.new(rows: @calls, id: "uso-ia", caption: t("ai_settings.usage_title"), sort: @sort, dir: @dir, tools: false, empty: t("ai_settings.no_calls")) do |tb| %>
    <% tb.column :created_at, t("datasets.show.when"), sortable: true do |c| %><span class="num whitespace-nowrap"><%= l(c.created_at, format: t("ai_settings.time_format")) %></span><% end %>
    <% tb.column :source, t("ai_settings.source") do |c| %><span class="block font-semibold text-ink truncate max-w-[12rem]"><%= c.automation&.name || c.source_label %></span><span class="block text-xs text-muted"><%= [ c.source_label, c.site&.name ].compact.join(" · ") %></span><% end %>
    <% tb.column :model, t("ai_settings.model") do |c| %><span class="block"><%= Ai.provider(c.provider)&.label || c.provider %></span><span class="block text-xs text-muted num"><%= c.model %></span><% end %>
    <% tb.column :tokens, t("ai_settings.tokens"), align: :right, sortable: true do |c| %><span class="num"><%= number_with_delimiter(c.tokens) %></span><% end %>
    <% tb.column :cost, t("ai_settings.cost"), align: :right, sortable: true do |c| %><span class="num"><%= usd(c.cost) %></span><% end %>
    <% tb.column :status, t("ai_settings.result") do |c| %><span class="ss-badge <%= { 'ok' => 'ss-badge-success', 'error' => 'ss-badge-danger', 'blocked' => 'ss-badge-warn' }[c.status] %>" title="<%= c.error %>"><%= c.status_label %></span><% end %>
  <% end %>
</section>
<p class="text-xs text-muted mt-3"><%= t("ai_settings.cost_note") %></p>
<% end %>
