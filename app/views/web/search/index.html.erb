<% content_for :title, t("search.title") %>
<%= render "web/shared/header", title: t("search.title"), subtitle: t("search.subtitle") %>
<%= ss_form_with url: search_path, method: :get, class: "ss-card p-3 flex gap-2 mb-4" do |f| %>
  <%= f.ss_search_field :q, value: @q, label: t("search.title"), hide_label: true, wrapper_class: "flex-1", placeholder: t("search.placeholder"), autofocus: true %>
  <%= render Ss::ButtonComponent.new(label: t("search.title"), type: :submit) %>
<% end %>
<div class="ss-card p-2"><%= render "web/search/results", results: @results, q: @q, recent: @recent %></div>
