<% content_for :title, t("search.title") %>
<%= render "web/shared/header", title: t("search.title"), subtitle: t("search.subtitle") %>
<%= form_with url: search_path, method: :get, class: "ss-card p-3 flex gap-2 mb-4" do %>
  <label for="q" class="sr-only"><%= t("search.title") %></label>
  <%= search_field_tag :q, @q, class: "ss-input flex-1", placeholder: t("search.placeholder"), autofocus: true %>
  <%= submit_tag t("search.title"), class: "ss-btn ss-btn-primary" %>
<% end %>
<div class="ss-card p-2"><%= render "web/search/results", results: @results, q: @q, recent: @recent %></div>
