<%# locals: (site:, record:) -%>
<%= form_with model: record.new_record? ? [ site, record ] : record, class: "ss-card ss-card-pad grid gap-4 md:grid-cols-3 max-w-4xl" do |f| %>
  <%= render "web/shared/errors", record: record %>
  <%= hidden_field_tag :back, params[:back], id: nil %>
  <div class="md:col-span-2"><%= f.label :name, t("automations.settings.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", required: true, placeholder: t("automations.alert_rules.name_ph"), autofocus: true %></div>
  <div><%= f.label :severity, t("automations.alert_rules.severity"), class: "ss-label" %><%= f.select :severity, AlertRule::SEVERITIES.invert, {}, class: "ss-input" %></div>
  <div><%= f.label :point_id, t("automations.labels.field_types.point"), class: "ss-label" %><%= f.select :point_id, point_choices(site), { include_blank: t("automations.bp.choose") }, class: "ss-input", required: true %></div>
  <div><%= f.label :operator, t("automations.alert_rules.operator"), class: "ss-label" %><%= f.select :operator, AlertRule::OPERATORS.invert, {}, class: "ss-input" %></div>
  <div><%= f.label :value, t("automations.scenes.value"), class: "ss-label" %><%= f.text_field :value, value: record.value, class: "ss-input", placeholder: t("automations.alert_rules.value_ph") %></div>
  <div><%= f.label :for_min, t("automations.alert_rules.for_min"), class: "ss-label" %><%= f.number_field :for_min, min: 0, step: "any", class: "ss-input num" %></div>
  <div><%= f.label :repeat_min, t("automations.alert_rules.repeat"), class: "ss-label" %><%= f.number_field :repeat_min, min: 1, class: "ss-input num", placeholder: t("automations.alert_rules.repeat_ph") %></div>
  <fieldset class="md:col-span-3">
    <legend class="ss-label"><%= t("automations.alert_rules.steps") %></legend>
    <div class="grid gap-2">
      <% steps = record.escalation.presence || [ { "wait_s" => 0, "channels" => Notifier.default_channels } ] %>
      <% (steps + Array.new([ 5 - steps.size, 1 ].max) { {} }).each_with_index do |s, i| %>
        <div class="flex flex-wrap items-center gap-3">
          <label class="text-sm text-muted w-16" for="step_<%= i %>"><%= t("automations.alert_rules.step", n: i + 1) %></label>
          <%= number_field_tag "alert_rule[steps][#{i}][wait_min]", (s["wait_s"] && (s["wait_s"] / 60.0).round(2).to_s.delete_suffix(".0")), min: 0, step: "any", class: "ss-input num w-28", id: "step_#{i}", placeholder: "min" %>
          <% Notifier.channel_choices(site).each do |key, name| %>
            <label class="ss-check"><%= check_box_tag "alert_rule[steps][#{i}][channels][]", key, Array(s["channels"]).include?(key), id: "step_#{i}_#{key.parameterize}" %> <%= name %></label>
          <% end %>
        </div>
      <% end %>
    </div>
  </fieldset>
  <label class="ss-check"><%= f.check_box :auto_resolve %> <%= t("automations.alert_rules.auto_resolve") %></label>
  <label class="ss-check"><%= f.check_box :enabled %> <%= t("automations.notify_rules.active") %></label>
  <div class="md:col-span-3 flex flex-wrap gap-2">
    <%= f.submit t("automations.alert_rules.save"), class: "ss-btn ss-btn-primary" %>
    <%= link_to t("automations.settings.cancel"), back_path, class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
