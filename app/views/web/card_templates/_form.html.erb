<%# locals: (template:, site:, sample:) -%>
<%# Editor do modelo de card (P1.3) com prévia ao vivo: o formulário envia sozinho para a prévia (ss-autosubmit da
    gem; a resposta troca só o quadro "tpl_preview"); Salvar troca o destino (formaction). Espaço de texto = Liquid
    (`{{ vars.area.name }}`); começando com { ou [ = JSON: consulta + conta, regras [{when, value}], itens ou ação. %>
<% slot_text = ->(v) { v.nil? ? "" : (v.is_a?(String) ? v : JSON.pretty_generate(v)) } %>
<% slots = template.slots.to_h %>
<% areas = site.areas.order(:position, :name).to_a %>
<% pts = site.points.where(disabled: false).includes(:device).ordered.to_a %>
<% save_url = template.persisted? ? card_template_path(template) : site_card_templates_path(site) %>
<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem] items-start">
  <%= ss_form_with model: template, url: preview_site_card_templates_path(site), scope: :card_template, class: "grid gap-4",
                data: { controller: "ss-autosubmit", action: "input->ss-autosubmit#queue change->ss-autosubmit#now", turbo_frame: "tpl_preview" } do |f| %>
    <%= render Ss::FormErrorsComponent.new(record: template) if template.errors.any? %>
    <section class="ss-card ss-card-pad grid gap-3 sm:grid-cols-2">
      <%= f.ss_text_field :name, label: t("dashboards.templates.name"), required: true, maxlength: 80 %>
      <%= f.ss_text_field :key, label: t("dashboards.templates.key"), class: "num", required: true, pattern: "[a-z0-9][a-z0-9_-]{1,39}", disabled: template.persisted? %>
      <%= f.ss_text_field :description, label: t("dashboards.templates.description"), wrapper_class: "sm:col-span-2", maxlength: 200 %>
      <%= f.ss_select :layout, Dashboards::CardTemplates::LAYOUTS.map { |l| [ t("dashboards.templates.layouts.#{l}"), l ] }, label: t("dashboards.templates.layout"),
                      help: t("dashboards.templates.layout_hint"), wrapper_class: "sm:col-span-2" %>
    </section>

    <section class="ss-card ss-card-pad grid gap-3">
      <%= render Ss::SectionHeaderComponent.new(title: t("dashboards.templates.params"), subtitle: t("dashboards.templates.params_hint")) %>
      <% rows = Array(template.params) + Array.new([ Dashboards::CardTemplates::MAX_PARAMS - Array(template.params).size, 2 ].min.clamp(0, 2)) { {} } %>
      <% rows.each_with_index do |p, i| %>
        <%= ss_fields "card_template[params][#{i}]" do |pf| %>
          <div class="grid gap-2 sm:grid-cols-[1fr_1fr_9rem_auto] items-end">
            <%= pf.ss_text_field :key, value: p["key"], id: "tp-k#{i}", label: t("dashboards.templates.param_key"), class: "num", placeholder: "area", maxlength: 30 %>
            <%= pf.ss_text_field :label, value: (Dashboards::CardTemplates.param_label(p) if p["key"]), id: "tp-l#{i}", label: t("dashboards.templates.param_label"), maxlength: 60 %>
            <%= pf.ss_select :kind, Dashboards::CardTemplates::KINDS.map { |k| [ t("dashboards.templates.kinds.#{k}"), k ] }, selected: p["kind"], id: "tp-t#{i}",
                             label: t("dashboards.templates.param_kind") %>
            <%= pf.ss_check_box :required, checked: p["required"].present?, unchecked_value: nil, id: "tp-r#{i}", label: t("dashboards.templates.param_required"), wrapper_class: "pb-2" %>
          </div>
        <% end %>
      <% end %>
    </section>

    <section class="ss-card ss-card-pad grid gap-3">
      <%= render Ss::SectionHeaderComponent.new(title: t("dashboards.templates.slots"), subtitle: t("dashboards.templates.slots_hint")) %>
      <% Dashboards::CardTemplates::SLOTS.each do |s| %>
        <% big = %w[facts tap tone].include?(s) || !slots[s].is_a?(String) && !slots[s].nil? %>
        <%= f.ss_text_area :"slot_#{s}", value: slot_text.(slots[s]), id: "ts-#{s}", class: "num", rows: big ? 4 : 1, spellcheck: false,
                           label: safe_join([ t("dashboards.templates.slot_names.#{s}"), " ", tag.span(t("dashboards.templates.slot_hints.#{s}"), class: "font-normal") ]) %>
      <% end %>
    </section>

    <section class="ss-card ss-card-pad grid gap-3 sm:grid-cols-2">
      <%= render Ss::SectionHeaderComponent.new(title: t("dashboards.templates.sample"), subtitle: t("dashboards.templates.sample_hint"), css: "sm:col-span-2") %>
      <%= ss_fields "card_template[sample]" do |sf| %>
        <% Array(template.params).each do |p| %>
          <% id = "tx-#{p['key']}" %>
          <% label = Dashboards::CardTemplates.param_label(p) %>
          <% if p["kind"] == "area" %>
            <%= sf.ss_select p["key"], areas.map { |a| [ a.name, a.id ] }, selected: sample[p["key"]] || areas.first&.id, include_blank: true, id: id, label: label %>
          <% elsif p["kind"] == "point" %>
            <%= sf.ss_select p["key"], pts.map { |pt| [ "#{pt.name} · #{pt.device.name}", pt.id ] }, selected: sample[p["key"]] || pts.first&.id, include_blank: true, id: id, label: label %>
          <% else %>
            <%= sf.ss_text_field p["key"], value: sample[p["key"]], id: id, label: label %>
          <% end %>
        <% end %>
      <% end %>
    </section>

    <div class="flex flex-wrap gap-2">
      <%= render Ss::ButtonComponent.new(label: t("dashboards.templates.save"), icon: icon("check", ""), type: :submit, formaction: save_url, data: { turbo_frame: "_top" }) %>
      <%= link_to t("dashboards.cancel"), site_card_templates_path(site), class: "ss-btn ss-btn-ghost" %>
    </div>
  <% end %>

  <aside class="lg:sticky lg:top-4 grid gap-2">
    <h2 class="ss-label"><%= t("dashboards.templates.preview") %></h2>
    <%= render "web/card_templates/preview", widget: @widget, errors: @errors || [], points: @points || {}, dashboard: @dashboard %>
    <p class="text-xs text-muted"><%= t("dashboards.templates.preview_hint") %></p>
  </aside>
</div>
