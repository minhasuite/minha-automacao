<%= render "web/shared/header", title: t("dashboards.templates.editing", name: @template.name), subtitle: "#{@template.key} · v#{@template.version}", back: site_card_templates_path(@site) do %>
  <%= link_to export_site_card_templates_path(@site, key: @template.key), class: "ss-btn ss-btn-ghost", data: { turbo: false } do %><%= icon("download", "size-4") %><%= t("dashboards.templates.export") %><% end %>
<% end %>
<%= render "form", template: @template, site: @site, sample: @sample %>
