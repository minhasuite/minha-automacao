<%= render "web/shared/header", title: t("settings.title"), subtitle: t("backup_restore.subtitle") %>
<%= render layout: "web/settings/frame", locals: { current: :backups } do %>
<% st = @status %>
<% if st["state"].present? %>
  <% tone = { "running" => "accent", "done" => "success", "rolled_back" => "warn", "failed" => "danger" }.fetch(st["state"], "muted") %>
  <section class="ss-card ss-card-pad mb-4 flex flex-wrap items-center justify-between gap-3" role="status" aria-live="polite" data-restore="<%= st["state"] %>"
           <%= tag.attributes(data: { controller: "ss-reload", ss_reload_every_value: 5000 }) if st["state"] == "running" %>>
    <div class="min-w-0">
      <p class="font-bold text-ink"><%= t("backup_restore.states.#{st["state"]}", default: st["state"]) %><%= " · #{t("backup_restore.steps.#{st["step"]}", default: st["step"])}" if st["state"] == "running" %></p>
      <p class="text-sm text-muted break-words"><%= st["file"] %><%= " · #{l(Time.zone.parse(st["at"]), format: :short)}" if st["at"].present? %><%= " · #{st["message"]}" if st["message"].present? %></p>
    </div>
    <span class="ss-badge ss-badge-<%= tone %>"><%= t("backup_restore.badges.#{st["state"]}", default: st["state"]) %></span>
  </section>
<% end %>

<%= render "web/backups/now" %>
<section class="ss-card ss-card-pad" aria-labelledby="rs-t">
  <h2 id="rs-t" class="flex items-center gap-2"><%= icon("refresh", "size-5 text-accent") %><%= t("backup_restore.title") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("backup_restore.pitch") %></p>
  <% unless @available %><%= render(Ss::CalloutComponent.new(tone: :warn, class: "mt-2")) { t("backup_restore.no_supervisor") } %><% end %>
  <%= ss_form_with url: settings_backups_path, multipart: true, class: "mt-4 grid gap-4", data: { turbo: false } do |form| %>
    <fieldset class="grid gap-2">
      <legend class="ss-label"><%= t("backup_restore.choose") %></legend>
      <% if @local.empty? && @offsite.empty? %><p class="text-sm text-muted"><%= t("backup_restore.none") %></p><% end %>
      <% @local.first(10).each_with_index do |f, i| %>
        <%= render Ss::OptionCardComponent.new(name: "pick", value: "local:#{f[:name]}", checked: i.zero?, title: f[:name], class: "break-all",
                                               description: "#{t("backup_restore.here")} · #{l(f[:at], format: :short)} · #{number_to_human_size(f[:size])}") %>
      <% end %>
      <% @offsite.first(10).each do |name| %>
        <%= render Ss::OptionCardComponent.new(name: "pick", value: "offsite:#{name}", title: name, description: t("backup_restore.away"), class: "break-all") %>
      <% end %>
    </fieldset>
    <details class="rounded-xl border border-line p-3">
      <summary class="ss-summary font-semibold text-accent"><%= t("backup_restore.upload") %></summary>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <%= form.ss_file_field :file, label: t("backup_restore.file"), id: "file", accept: ".gz,.enc" %>
        <%= form.ss_password_field :passphrase, label: t("backup_restore.passphrase"), id: "passphrase", autocomplete: "off" %>
      </div>
      <p class="text-xs text-muted mt-2"><%= t("backup_restore.upload_hint") %></p>
    </details>
    <%= render(Ss::CalloutComponent.new(tone: :danger)) { t("backup_restore.warning") } %>
    <div class="flex flex-wrap items-end gap-3">
      <%= form.ss_text_field :confirm, label: t("backup_restore.type_word", word: t("backup_restore.word")), id: "confirm", class: "w-48", autocomplete: "off", required: true %>
      <%= render Ss::ButtonComponent.new(label: t("backup_restore.submit"), icon: icon("refresh", ""), type: :submit, variant: :danger, disabled: !@available) %>
    </div>
  <% end %>
</section>
<% end %>
