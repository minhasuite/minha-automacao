<%# resto (7.12): backup agora, completo ou parcial (o que ficar desmarcado vai sem os dados). -%>
<section class="ss-card ss-card-pad mb-4" aria-labelledby="bk-now-t" data-backup="now">
  <h2 id="bk-now-t" class="flex items-center gap-2"><%= icon("archive", "size-5 text-accent") %><%= t("resto.backup.title") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("resto.backup.pitch") %></p>
  <%= ss_form_with url: settings_backups_now_path, class: "mt-4 grid gap-3", data: { turbo_submits_with: t("resto.backup.working") } do |f| %>
    <fieldset class="grid gap-2 sm:grid-cols-2">
      <legend class="ss-label"><%= t("resto.backup.include") %></legend>
      <%= f.ss_check_box :config, label: t("resto.backup.config"), name: nil, id: "part-config", checked: true, disabled: true, unchecked_value: nil %>
      <% Backups::Partial.labels.each do |key, label| %>
        <%= f.ss_check_box :parts, label: label, name: "parts[]", id: "part-#{key}", checked_value: key, unchecked_value: nil, checked: true %>
      <% end %>
    </fieldset>
    <div><%= render Ss::ButtonComponent.new(label: t("resto.backup.now"), icon: icon("download", ""), type: :submit) %></div>
  <% end %>
</section>
