<%= render "web/shared/header", title: t("settings.title"), subtitle: t("tags.index.subtitle") %>
<%= render layout: "web/settings/frame", locals: { current: :labels } do %>
  <% if @tags.empty? %>
    <%= render Ss::EmptyStateComponent.new(title: t("tags.index.empty"), text: t("tags.index.empty_hint_html"), css: "ss-card") %>
  <% else %>
    <ul class="ss-card ss-rows" aria-label="<%= t("tags.index.list") %>">
      <% @tags.each do |tg| %>
        <% use = @usage[tg.id] %>
        <li id="<%= dom_id(tg) %>">
          <span class="ss-label-chip" style="<%= "--chip: #{tg.color}" if tg.color %>"><%= tg.name %></span>
          <p class="min-w-0 flex-1 basis-40 text-sm text-muted"><%= use.any? ? use.map { |type, n| t("tags.kinds.#{type}", count: n, default: "#{n} #{type}") }.join(" · ") : t("tags.index.unused") %></p>
          <%= form_with model: tg, url: tag_path(tg), method: :patch, class: "flex flex-wrap items-center gap-2" do |f| %>
            <label class="sr-only" for="<%= dom_id(tg, :name) %>"><%= t("tags.index.name_of", name: tg.name) %></label>
            <%= f.text_field :name, class: "ss-input w-40", id: dom_id(tg, :name), maxlength: 40 %>
            <label class="sr-only" for="<%= dom_id(tg, :color) %>"><%= t("tags.index.color_of", name: tg.name) %></label>
            <%= f.color_field :color, value: tg.color.presence || "#5a45e8", class: "h-10 w-12 rounded-lg border border-line bg-transparent", id: dom_id(tg, :color) %>
            <%= f.submit t("tags.index.save"), class: "ss-btn ss-btn-outline ss-btn-sm" %>
          <% end %>
          <%= button_to tag_path(tg), method: :delete, class: "ss-btn ss-btn-ghost ss-btn-sm", "aria-label": t("tags.index.delete", name: tg.name), form: { class: "contents", data: { turbo_confirm_tone: "danger", turbo_confirm: t("tags.index.delete_confirm", name: tg.name), turbo_confirm_button: t("tags.index.delete_button") } } do %><%= icon("trash", "size-4") %><% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
