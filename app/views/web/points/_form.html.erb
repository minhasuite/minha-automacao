<%# locals: (device:, point:) -%>
<%# Formulário do ponto; o bloco (de new e edit) traz as ações: yield f. -%>
<%= ss_form_with model: point.new_record? ? [ device, point ] : point, class: "ss-card ss-card-pad grid gap-4 md:grid-cols-3 max-w-4xl" do |f| %>
  <%= render "web/shared/errors", record: point %>
  <div class="md:col-span-2"><%= f.ss_text_field :name, label: t("sites.form.name"), required: true, placeholder: t("points.form.name_hint"), autofocus: true %></div>
  <%= f.ss_select :capability, Point::CAPABILITY_LABELS.invert, label: t("sites.form.kind") %>
  <%= f.ss_text_field :unit, label: t("points.form.unit"), placeholder: "°C, W, %" %>
  <% if (units = Units.compatible(point.unit)).any? %>
    <%= f.ss_select :display_unit, units, label: t("points.form.display_unit"),
                    include_blank: t("points.form.display_unit_default", unit: Units.display_unit(point.dup.tap { |p| p.display_unit = nil })) %>
  <% end %>
  <%= f.ss_select :risk, Point::RISKS.invert, label: t("points.form.risk"), help: t("points.form.risk_hint") %>
  <%= f.ss_select :area_id, device.site.areas.order(:name).pluck(:name, :id), label: t("devices.area"), include_blank: t("points.form.device_area") %>
  <%= f.ss_number_field :min, label: t("points.form.min"), step: "any", class: "num" %>
  <%= f.ss_number_field :max, label: t("points.form.max"), step: "any", class: "num" %>
  <%= f.ss_number_field :step, label: t("points.form.step"), step: "any", class: "num" %>
  <div class="md:col-span-2"><%= f.ss_text_field :options_text, label: t("points.form.options"), placeholder: t("points.form.options_hint") %></div>
  <%= f.ss_text_field :confirm, label: t("points.form.confirm"), placeholder: t("points.form.confirm_hint") %>
  <%= render Ss::CollapsibleComponent.new(title: t("points.form.advanced"), css: "md:col-span-3") do %>
    <div class="grid gap-4 md:grid-cols-3">
      <%= f.ss_text_field :key, label: t("points.form.key"), class: "num", placeholder: t("points.form.key_hint") %>
      <%= f.ss_text_field :device_class, label: t("points.form.device_class"), placeholder: "temperature, power, door" %>
      <%= f.ss_number_field :scale, label: t("points.form.scale"), step: "any", class: "num" %>
      <%= f.ss_number_field :offset, label: t("points.form.offset"), step: "any", class: "num" %>
      <%= f.ss_number_field :pulse_ms, label: t("points.form.pulse"), min: 1, class: "num" %>
      <%= f.ss_number_field :max_on_s, label: t("points.form.max_on"), min: 1, class: "num" %>
      <%= f.ss_check_box :writable, label: t("points.form.writable") %>
      <%= f.ss_check_box :hidden, label: t("points.form.hidden") %>
      <%= f.ss_check_box :disabled, label: t("devices.disabled") %>
    </div>
  <% end %>
  <%= render "web/shared/organize_fields", f: f, record: point, span: "md:col-span-3" %>
  <div class="md:col-span-3 flex flex-wrap gap-2"><%= yield f %></div>
<% end %>
