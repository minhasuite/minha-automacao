<%# locals: (point:) -%>
<%# Controle compacto do valor, pela capacidade e pelos comandos do ponto (lista de helpers). Vai pelo PointsController#command. %>
<% cmds = Points::Command.commands_for(point) %>
<% actions = Points::Command.actions_for(point) %>
<% if point.writable && !point.disabled && cmds.any? && point.quality == "good" && can?(:command, risk: point.risk) %>
  <% confirm = point_confirm_data(point).merge(turbo_frame: "_top") %>
  <% fid = "v_#{point.id}" %>
  <div class="flex flex-wrap items-center justify-end gap-2">
    <% if cmds.include?("toggle") %>
      <% on = point_on?(point) %>
      <%# Chave da gem (vira na hora, volta se falhar); o form fica no quadro do ponto ou na página. %>
      <%= render Ss::SwitchComponent.new(url: command_point_path(point), on: on, label: "#{on ? t('points.turn_off') : t('points.turn_on')} #{point.name}",
                                         params: { command: "toggle" }, confirm: confirm[:turbo_confirm], confirm_title: confirm[:turbo_confirm_title]) %>
    <% elsif cmds.include?("run") %>
      <%= render Ss::ButtonComponent.new(label: t("points.run"), icon: icon("play", ""), href: command_point_path(point), method: :post, params: { command: "run" },
                                         variant: :outline, size: :sm, form: { data: confirm }) %>
    <% elsif cmds.include?("press") %>
      <%= render Ss::ButtonComponent.new(label: t("points.press"), icon: icon("lightning-bolt", ""), href: command_point_path(point), method: :post, params: { command: "press" },
                                         variant: :outline, size: :sm, form: { data: confirm }) %>
    <% elsif cmds.include?("select") %>
      <%= ss_form_with url: command_point_path(point), data: confirm, class: "block" do |f| %>
        <%= hidden_field_tag :command, "select", id: nil %>
        <%= f.ss_select :value, point.option_values, label: t("points.choose", name: point.name), hide_label: true, selected: point.value, id: fid,
                        class: "!py-1.5 min-w-36", data: { autosubmit: true } %>
      <% end %>
    <% elsif cmds.include?("set") && point.numeric? && point.address["mode"] != "box" && point.min && point.max %>
      <%= ss_form_with url: command_point_path(point), data: confirm, class: "flex items-center gap-2" do %>
        <%= hidden_field_tag :command, "set", id: nil %>
        <%= render Ss::RangeComponent.new(name: "value", label: t("points.adjust", name: point.name), hide_label: true, value: dw_plain(point.value || point.min), min: dw_plain(point.min),
                                          max: dw_plain(point.max), step: dw_plain(point.step || 1), format: dw_range_format(point.unit), submit: :release, id: fid, css: "w-36 sm:w-48") %>
      <% end %>
    <% elsif cmds.include?("set") && actions.empty? %>
      <%= ss_form_with url: command_point_path(point), data: confirm, class: "flex items-center gap-2" do |f| %>
        <%= hidden_field_tag :command, "set", id: nil %>
        <% type = point_input_type(point) %>
        <% kind = { "number" => :ss_number_field, "password" => :ss_password_field, "date" => :ss_date_field, "time" => :ss_time_field,
                    "datetime-local" => :ss_datetime_local_field }.fetch(type, :ss_text_field) %>
        <% input = { id: fid, class: "!py-1.5 #{type == 'number' ? 'num w-28' : 'w-44'}", label: t("points.new_value", name: point.name), hide_label: true } %>
        <% input[:required] = true unless type.in?(%w[text password]) %>
        <% input[:value] = point.value unless type == "password" %>
        <% input.merge!(min: point.min, max: point.max, step: point.step || "any") if type == "number" %>
        <% input[:maxlength] = (point.max || 255).to_i if type.in?(%w[text password]) %>
        <%= f.public_send(kind, :value, **input) %>
        <%= render Ss::ButtonComponent.new(icon: icon("check", ""), type: :submit, variant: :ghost, size: :sm, title: t("points.apply"), aria: { label: "#{t('points.apply')} #{point.name}" }) %>
      <% end %>
    <% end %>
    <% if actions.any? %>
      <span class="ss-btn-group" role="group" aria-label="<%= t("points.actions", name: point.name) %>">
        <% actions.each do |c| %>
          <% ico, label = PointsHelper::ACTION_BUTTONS.fetch(c, [ "lightning-bolt", c ]) %>
          <%= render Ss::ButtonComponent.new(icon: icon(ico, ""), href: command_point_path(point), method: :post, params: { command: c }, variant: :ghost, size: :sm, css: "p-0",
                                             form: { data: confirm }, title: label, aria: { label: "#{label} #{point.name}" }) %>
        <% end %>
      </span>
    <% end %>
  </div>
<% end %>
