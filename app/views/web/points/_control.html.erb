<%# locals: (point:) -%>
<%# Controle compacto do valor, pela capacidade e pelos comandos do ponto (lista de helpers). Vai pelo PointsController#command. %>
<% cmds = Points::Command.commands_for(point) %>
<% actions = Points::Command.actions_for(point) %>
<% if point.writable && !point.disabled && cmds.any? && point.quality == "good" && can?(:command, risk: point.risk) %>
  <% confirm = point_confirm_data(point).merge(turbo_frame: "_top") %>
  <% fid = "v_#{point.id}" %>
  <div class="flex flex-wrap items-center justify-end gap-2">
    <% if cmds.include?("toggle") %>
      <% on = point_on?(point) %>
      <%# Chave da gem (vira na hora, volta se falhar); o form fica no quadro do ponto ou na página. %>
      <%= render Ss::SwitchComponent.new(url: command_point_path(point), on: on, label: "#{on ? t('points.turn_off') : t('points.turn_on')} #{point.name}",
                                         params: { command: "toggle" }, confirm: confirm[:turbo_confirm], confirm_title: confirm[:turbo_confirm_title]) %>
    <% elsif cmds.include?("run") %>
      <%= button_to command_point_path(point), params: { command: "run" }, class: "ss-btn ss-btn-outline ss-btn-sm", form: { data: confirm } do %><%= icon("play", "size-4") %><%= t("points.run") %><% end %>
    <% elsif cmds.include?("press") %>
      <%= button_to command_point_path(point), params: { command: "press" }, class: "ss-btn ss-btn-outline ss-btn-sm", form: { data: confirm } do %><%= icon("lightning-bolt", "size-4") %><%= t("points.press") %><% end %>
    <% elsif cmds.include?("select") %>
      <%= form_with url: command_point_path(point), data: confirm do %>
        <%= hidden_field_tag :command, "select", id: nil %>
        <label for="<%= fid %>" class="sr-only"><%= t("points.choose", name: point.name) %></label>
        <%= select_tag :value, options_for_select(point.option_values, point.value), id: fid, class: "ss-input !py-1.5 min-w-36", data: { autosubmit: true } %>
      <% end %>
    <% elsif cmds.include?("set") && point.numeric? && point.address["mode"] != "box" && point.min && point.max %>
      <%= form_with url: command_point_path(point), data: confirm, class: "flex items-center gap-2" do %>
        <%= hidden_field_tag :command, "set", id: nil %>
        <%= render Ss::RangeComponent.new(name: "value", label: t("points.adjust", name: point.name), hide_label: true, value: dw_plain(point.value || point.min), min: dw_plain(point.min),
                                          max: dw_plain(point.max), step: dw_plain(point.step || 1), format: dw_range_format(point.unit), submit: :release, id: fid, css: "w-36 sm:w-48") %>
      <% end %>
    <% elsif cmds.include?("set") && actions.empty? %>
      <%= form_with url: command_point_path(point), data: confirm, class: "flex items-center gap-2" do %>
        <%= hidden_field_tag :command, "set", id: nil %>
        <label for="<%= fid %>" class="sr-only"><%= t("points.new_value", name: point.name) %></label>
        <% type = point_input_type(point) %>
        <input type="<%= type %>" id="<%= fid %>" name="value" class="ss-input !py-1.5 <%= type == 'number' ? 'num w-28' : 'w-44' %>" <%= "required" unless type.in?(%w[text password]) %>
               value="<%= point.value unless type == 'password' %>" <% if type == "number" %>min="<%= point.min %>" max="<%= point.max %>" step="<%= point.step || 'any' %>"<% end %>
               <% if type.in?(%w[text password]) %>maxlength="<%= (point.max || 255).to_i %>"<% end %>>
        <button class="ss-btn ss-btn-ghost ss-btn-sm" title="<%= t("points.apply") %>" aria-label="<%= t("points.apply") %> <%= point.name %>"><%= icon("check", "size-4") %></button>
      <% end %>
    <% end %>
    <% if actions.any? %>
      <span class="ss-btn-group" role="group" aria-label="<%= t("points.actions", name: point.name) %>">
        <% actions.each do |c| %>
          <% ico, label = PointsHelper::ACTION_BUTTONS.fetch(c, [ "lightning-bolt", c ]) %>
          <%= button_to command_point_path(point), params: { command: c }, form: { data: confirm }, title: label, "aria-label": "#{label} #{point.name}" do %><%= icon(ico, "") %><% end %>
        <% end %>
      </span>
    <% end %>
  </div>
<% end %>
