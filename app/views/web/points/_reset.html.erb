<%# locals: (point:) -%>
<%# "Redefinir estado" (Points::Reset): sensor que perdeu o evento; técnico+, fica na linha do tempo. -%>
<section class="ss-card ss-card-pad mb-4" aria-labelledby="reset-title">
  <h2 id="reset-title"><%= t("points.show.reset") %></h2>
  <% if point.quality == "stale" && Points::Stale.limit(point) %>
    <%= render Ss::NoteComponent.new(text: t("points.show.stale_note", time: duration_text(Points::Stale.limit(point))), icon: icon("exclamation-circle", ""), css: "mt-2") %>
  <% end %>
  <p class="text-sm text-muted mt-1"><%= t("points.show.reset_hint") %></p>
  <%= ss_form_with url: reset_point_path(point), method: :post, class: "mt-3 flex flex-wrap items-end gap-3",
                   data: { turbo_confirm: t("points.show.reset_confirm", name: point.name), turbo_confirm_button: t("points.show.reset_button") } do |f| %>
    <% if (choices = reset_choices(point)) %>
      <%= f.ss_select :value, choices, label: t("points.show.reset_value"), selected: point.value.to_s, id: "reset_value", wrapper_class: "min-w-0 basis-48" %>
    <% else %>
      <%= f.ss_number_field :value, label: t("points.show.reset_value"), value: point.value, id: "reset_value", step: "any", required: true, class: "num", wrapper_class: "min-w-0 basis-48" %>
    <% end %>
    <%= render Ss::ButtonComponent.new(label: t("points.show.reset_button"), icon: icon("refresh", ""), type: :submit, variant: :ghost, size: :sm) %>
  <% end %>
</section>
