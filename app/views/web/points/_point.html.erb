<%# locals: (point:, error: nil, target: nil) -%>
<%# Duas por linha no celular; ponto com campo (número, lista, texto, helper) ocupa a linha toda. %>
<% wide = point.writable && (point.helper_type || !point.capability.in?(%w[onoff gate command])) %>
<% wp = Dashboards::Widgets.for_capability(point.capability) %>
<%= turbo_frame_tag point, class: "block #{'max-sm:col-span-2' if wide || wp}", target: target do %>
  <% if wp %>
    <%# Pacote 1: capacidade com widget próprio (mídia, controle remoto) usa o mesmo desenho do painel. %>
    <%= render wp.partial, w: { "id" => "pt-#{point.id}", "data" => wp.data(nil, {}, [ point ]).first }, points: { point.id => Dashboards::Resolver.point_json(point, @site_role) }, dashboard: nil, live: false %>
    <% if error %><p class="mt-2 text-sm font-semibold text-danger" role="alert"><%= error %></p><% end %>
  <% else %>
  <%# Comando a caminho do aparelho: o tile já mostra o estado pedido, com "Enviando…" (Points::Inflight). %>
  <% flight = Points::Inflight.for([ point ])[point.id] || {} %>
  <% point.value = flight["expect"] if flight.key?("expect") %>
  <% on = point_on?(point) %>
  <% off_line = point.quality.in?(%w[unavailable error]) %>
  <% can_cmd = point.writable && !point.disabled && Points::Command.commands_for(point).any? && can?(:command, risk: point.risk) %>
  <% locked = point.writable && !point.disabled && Points::Command.commands_for(point).any? && !can_cmd %>
  <% switch = can_cmd && point.capability == "onoff" && !point.helper_type %>
  <%# Tile da gem: nome (detalhes), valor no estado, chave para liga/desliga; o resto dos controles no rodapé
      (só quando há) e o editar no ⋯ do tile (também no toque longo), sem uma linha só para o lápis. %>
  <% foot = capture do %>
      <% if error %><p class="text-sm font-semibold text-danger" role="alert"><%= error %></p><% end %>
    <% if can_cmd %>
      <% confirm = point_confirm_data(point) %>
      <% if point.helper_type %>
        <%= render "web/points/control", point: point %>
      <% elsif point.capability == "onoff" %>
        <%# Liga/desliga: a chave do próprio tile. %>
      <% elsif point.capability == "stream" %>
        <%# ondaC2: câmera tem PTZ, gravar e falar na página do ponto (_camera). %>
      <% elsif point.capability.in?(%w[gate command]) %>
        <%= button_to command_point_path(point), params: { command: point.capability == "gate" ? "pulse" : "press" }, class: "ss-btn ss-btn-primary w-full", form: { data: confirm } do %><%= icon("lightning-bolt", "size-4") %><%= t("points.fire") %><% end %>
      <% else %>
        <%= form_with url: command_point_path(point), class: "flex gap-2", data: confirm do |f| %>
          <%= f.hidden_field :command, value: point.capability == "enum" ? "select" : "set", id: nil %>
          <% field_id = "value_#{point.id}" %>
          <label for="<%= field_id %>" class="sr-only"><%= t("points.new_value", name: point.name) %></label>
          <% if point.capability == "enum" %>
            <%= f.select :value, point.option_values, { selected: point.value }, class: "ss-input flex-1 min-w-0", id: field_id %>
          <% elsif point.capability == "color" %>
            <%= f.color_field :value, value: Points::Color.hex_of(point.value), class: "ss-input flex-1 min-w-0 h-11", id: field_id %>
          <% elsif point.numeric? %>
            <%= render Ss::StepperInputComponent.new(name: "value", value: dw_plain(point.value), min: dw_plain(point.min), max: dw_plain(point.max), step: dw_plain(point.step || 1),
                                                     unit: point.unit, id: field_id, css: "flex-1 min-w-0") %>
          <% else %>
            <%= f.text_field :value, value: point.value, maxlength: 255, class: "ss-input flex-1 min-w-0", id: field_id %>
          <% end %>
          <%= f.button t("points.apply"), class: "ss-btn ss-btn-primary", name: nil %>
        <% end %>
      <% end %>
    <% elsif point.writable && !point.disabled && Points::Command.commands_for(point).empty? %>
      <p class="text-xs text-muted"><%= t("points.no_control") %></p>
    <% end %>
  <% end %>
  <%= render Ss::DeviceTileComponent.new(name: point.name, state: [ point_value_text(point), point.capability_label, (point.risk_label unless point.risk == "normal") ].compact_blank.join(" · "),
                                         on: on, status: off_line ? :unavailable : (locked ? :locked : (flight["pending"] ? :pending : (flight["failed"] ? :error : :ready))), icon: icon(point_icon(point)).to_s, url: point_path(point),
                                         toggle_url: (command_point_path(point) if switch), toggle_params: { command: on ? "off" : "on" },
                                         confirm: point_confirm_data(point)[:turbo_confirm], unavailable_label: t("points.no_signal"),
                                         more_url: (edit_point_path(point) if can?(:manage)), more_label: t("shared.edit_name", name: point.name), more_data: { turbo_frame: "_top" },
                                         title: point_status_note(point), css: [ "h-full", ("opacity-60" if point.disabled) ].compact.join(" "), aria: { live: "polite" }) do |c| %>
    <% c.with_footer { foot } if foot.present? %>
  <% end %>
  <% end %>
<% end %>
