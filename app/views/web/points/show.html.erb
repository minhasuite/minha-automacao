<%= turbo_stream_from @point, channel: PointsChannel %>
<%= render "web/shared/header", title: @point.name, subtitle: [ @point.capability_label, @device.name, @point.area&.name || @device.area&.name ].compact.join(" · "), back: device_path(@device) do %>
  <%# Ideia 13: favorito da pessoa (a linha fixa no topo do painel). %>
  <% fav = Dashboards::Personal.favorite?(current_user, @point) %>
  <%= button_to favorite_point_path(@point), class: "ss-btn #{fav ? 'ss-btn-primary' : 'ss-btn-outline'}", "aria-pressed": fav.to_s do %><%= icon("star", "size-4") %><%= fav ? t("favorites.on") : t("favorites.add") %><% end %>
<% end %>

<div class="grid gap-4 lg:grid-cols-3">
  <%# Na página do ponto o comando recarrega a página toda (gráfico e lista juntos). %>
  <div><%= render "web/points/point", point: @point, target: "_top" %></div>

  <section class="ss-card ss-card-pad lg:col-span-2" aria-labelledby="chart-title">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="chart-title"><%= t("points.show.history") %></h2>
      <nav class="flex gap-2" aria-label="<%= t("points.show.range") %>">
        <% Points::History::RANGES.each_key do |range| %>
          <%= link_to range, point_path(@point, range: range), class: "ss-chip is-solid no-underline", "aria-current": (range == @range ? "true" : nil) %>
        <% end %>
      </nav>
    </div>
    <% chart = chart_data(@history) %>
    <% if chart %>
      <%# Gráfico da gem: série com cursor e balão (faixa mín–máx nos rollups) ou faixa de liga/desliga. %>
      <%= render Ss::TimeSeriesChartComponent.new(title: @point.name, series: [ chart[:series] ].compact, bands: [ chart[:band] ].compact, from: @history.from, to: @history.to,
                                                  mode: (@point.capability.in?(%w[enum]) ? :step : :line), locale: I18n.locale.to_s,
                                                  time_zone: @site.timezone, css: "mt-4") %>
      <% if chart[:on_seconds] %>
        <p class="text-sm text-ink-2 mt-3"><%= t("points.show.on_for_html", time: duration_text(chart[:on_seconds])) %></p>
      <% end %>
      <p class="sr-only"><%= t(@history.raw? ? "points.show.raw" : (@history.resolution == "1h" ? "points.show.hourly" : "points.show.daily"), from: l(@history.from, format: :short), to: l(@history.to, format: :short)) %></p>
    <% elsif @point.numeric? || @point.bool? %>
      <p class="text-sm text-muted mt-4"><%= t("points.show.no_readings") %></p>
    <% else %>
      <p class="text-sm text-muted mt-4"><%= t("points.show.no_chart") %></p>
    <% end %>
  </section>
</div>
<% if @point.capability == "stream" && @device.driver == "go2rtc" %><%= render "web/points/camera", point: @point, site: @site %><% end %>

<p class="ss-section mt-6 mb-3"><%= t("points.show.automation") %></p>
<% if @point.capability == "onoff" && @point.writable %>
  <section class="ss-card ss-card-pad mb-4 flex flex-wrap items-center gap-3" aria-labelledby="auto-off-title">
    <div class="min-w-0 flex-1 basis-64">
      <h2 id="auto-off-title"><%= t("points.show.auto_off") %></h2>
      <p class="text-sm text-muted mt-1">
        <% if @point.pulse_ms || @point.max_on_s %>
          <%= [ (t("points.show.pulse", s: number_with_precision(@point.pulse_ms / 1000.0, precision: 1, strip_insignificant_zeros: true)) if @point.pulse_ms),
                (t("points.show.max_on", time: duration_text(@point.max_on_s)) if @point.max_on_s) ].compact.join(" · ") %><%= t("points.show.any_path") %>
        <% else %>
          <%= t("points.show.no_auto_off") %>
        <% end %>
      </p>
    </div>
    <% if can?(:manage) %><%= link_to edit_point_path(@point), class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("clock", "size-4") %><%= t("points.show.tune") %><% end %><% end %>
  </section>
<% end %>
<% if can?(:manage) && Points::Reset.allowed?(@point) %><%= render "web/points/reset", point: @point %><% end %>
<%= render "web/automation/lists", site: @site, point: @point %>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="timeline-title">
  <h2 id="timeline-title"><%= t("points.show.timeline") %></h2>
  <%# Linha do tempo no Ss::LogbookComponent (dia que gruda, hora, ícone tonal); a lista já vem inteira. %>
  <% entries = @timeline.map do |item|
       { at: item.at, title: item.title, detail: [ (t("shared.by", name: item.user) if item.user), item.detail ].compact.join(" · ").presence,
         icon: icon({ "command" => "lightning-bolt", "event" => "exclamation-circle", "audit" => "pencil" }.fetch(item.kind)), tone: item.tone == "muted" ? "neutral" : item.tone }
     end %>
  <%= render Ss::LogbookComponent.new(entries: entries, label: t("points.show.timeline"), css: "mt-3", texts: { empty: t("shared.nothing_yet") },
                                      end_marker: false, time_zone: @site.timezone) %>
</section>
