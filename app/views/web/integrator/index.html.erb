<%= render "web/shared/header", title: t("integrator.title"), subtitle: t("integrator.subtitle") %>
<%= render layout: "web/settings/frame", locals: { current: :integrator } do %>
<% if @plain %>
  <section class="ss-card ss-card-grad p-4 mb-4" role="status" aria-labelledby="nova-inst-t">
    <h2 id="nova-inst-t" class="flex items-center gap-2"><%= icon("desktop-computer", "size-4") %><%= t("integrator.created", name: @created.name) %></h2>
    <p class="text-sm text-muted mt-1"><%= t("integrator.copy_now") %></p>
    <%= render Ss::CodeBlockComponent.new(text: "INTEGRATOR_URL=#{request.base_url}\nINTEGRATOR_TOKEN=#{@plain}", label: t("integrator.env"), id: "inst-env", css: "mt-3") %>
  </section>
<% end %>

<% if @installations.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("integrator.empty"), text: t("integrator.empty_hint"), css: "ss-card") %>
<% else %>
  <%= render Ss::DataTableComponent.new(rows: @installations, id: "instalacoes", caption: t("integrator.title"), tools: false, max_height: "none") do |tb| %>
    <% tb.column :name, t("integrator.client") do |i| %><%= link_to i.name, integrator_installation_path(i), class: "font-semibold text-ink" %><span class="block text-xs text-muted"><%= i.version_tag.presence || "—" %></span><% end %>
    <% tb.column :status, t("integrator.state") do |i| %><%= render "web/integrator/status", installation: i %><% end %>
    <% tb.column :seen, t("integrator.seen") do |i| %><%= i.last_seen_at ? ago_text(i.last_seen_at) : t("integrator.never") %><% end %>
    <% tb.column :temp, t("integrator.temp") do |i| %><span class="num"><%= i.server["temp"] ? "#{i.server['temp']} °C" : "—" %></span><% end %>
    <% tb.column :disk, t("integrator.disk") do |i| %><span class="num"><%= i.server.dig("disk", "used") ? "#{i.server.dig('disk', 'used')}%" : "—" %></span><% end %>
    <% tb.column :problems, t("integrator.problems") do |i| %><%= i.alerts.except("last_outage_to").keys.map { |k| t("integrator.labels.#{k}", default: k) }.to_sentence.presence || "—" %><% end %>
  <% end %>
<% end %>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="criar-inst-t">
  <h2 id="criar-inst-t"><%= t("integrator.new") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("integrator.new_hint") %></p>
  <%= ss_form_with scope: :installation, url: integrator_path, class: "mt-3 flex flex-wrap items-end gap-3", data: { turbo: false } do |f| %>
    <%= f.ss_text_field :name, label: t("integrator.client"), required: true, maxlength: 80, placeholder: t("integrator.name_hint"), wrapper_class: "min-w-64 flex-1" %>
    <%= f.ss_submit t("integrator.create") %>
  <% end %>
</section>
<% end %>
