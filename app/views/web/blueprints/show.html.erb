<%= render "web/shared/header", title: @blueprint.name, subtitle: "#{@site.name} · #{[ @blueprint.domain_label, @blueprint.source_label, t("automations.bp.version", version: @blueprint.version) ].join(' · ')}", back: site_blueprints_path(@site) do %>
  <% if can?(:manage) %><%= link_to use_blueprint_path(@blueprint), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t(@blueprint.domain == "script" ? "automations.bp.create_script" : "automations.bp.create_automation") %><% end %><% end %>
<% end %>

<div class="grid gap-6 lg:grid-cols-3 items-start">
  <div class="lg:col-span-2 flex flex-col gap-4 min-w-0">
    <% if @blueprint.unsupported.any? %>
      <%= render Ss::CalloutComponent.new(tone: :warn, title: t("automations.bp.unsupported")) do %>
        <p><%= t("automations.bp.unsupported_hint") %></p>
        <ul><% @blueprint.unsupported.each do |u| %><li><%= t("automations.bp.unsupported_item", item: u) %></li><% end %></ul>
      <% end %>
    <% end %>
    <% if @blueprint.description.present? %><p class="ss-card ss-card-pad text-ink-2"><%= @blueprint.description %></p><% end %>

    <section class="ss-card ss-card-pad" aria-labelledby="bp-inputs">
      <h2 id="bp-inputs"><%= t("automations.bp.inputs") %></h2>
      <% if @blueprint.inputs.empty? %>
        <p class="text-sm text-muted mt-1"><%= t("automations.bp.none") %></p>
      <% else %>
        <ul class="mt-2 divide-y divide-line">
          <% @blueprint.inputs.each do |i| %>
            <li class="py-2 text-sm">
              <p><span class="font-semibold text-ink"><%= i["label"] %></span> <code class="ss-code-inline"><%= i["key"] %></code></p>
              <p class="text-muted"><%= [ Blueprint::INPUT_TYPES[i["type"]], (Array(i.dig("filter", "capability")).map { |c| Point::CAPABILITY_LABELS.fetch(c, c).downcase }.join(t("automations.blueprint_errors.or")).presence),
                                        (t("automations.fields.default", value: i["default"]) if i.key?("default")), (t("automations.bp.required") if @blueprint.required?(i)) ].compact.join(" · ") %></p>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <details class="ss-card ss-card-pad">
      <summary class="ss-summary font-bold text-ink"><%= t("automations.bp.definition") %></summary>
      <% json = JSON.pretty_generate(@blueprint.slice("name", "description", "mode", "inputs", "definition")) %>
      <% if can?(:manage) && !@blueprint.builtin? %>
        <%= ss_form_with url: blueprint_path(@blueprint), method: :patch, class: "grid gap-3 mt-3" do |f| %>
          <%= f.ss_text_area :json, label: t("automations.bp.edit_json"), value: json, id: "bp-json", rows: 20, spellcheck: false, class: "ss-code-input" %>
          <div><%= f.ss_submit t("automations.bp.save"), small: true, data: { turbo_confirm: t("automations.bp.save_confirm") } %></div>
        <% end %>
      <% else %>
        <%= render Ss::CodeBlockComponent.new(text: json, wrap: false, max_height: "32rem", class: "mt-3") %>
      <% end %>
    </details>
  </div>

  <aside class="flex flex-col gap-4 min-w-0">
    <section class="ss-card ss-card-pad" aria-labelledby="bp-created">
      <h2 id="bp-created"><%= t("automations.bp.created_here") %></h2>
      <% if @automations.empty? %>
        <p class="text-sm text-muted mt-1"><%= t("automations.edit.no_versions") %></p>
      <% else %>
        <ul class="mt-2 divide-y divide-line">
          <% @automations.each do |a| %>
            <li class="py-2 text-sm flex flex-wrap items-center gap-2">
              <%= link_to a.name, edit_automation_path(a), class: "flex-1 min-w-0 font-semibold" %>
              <% if a.blueprint_outdated? %><span class="ss-badge ss-badge-accent"><%= t("automations.bp.new_draft") %></span><% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
    <% if @blueprint.source_url.present? %>
      <section class="ss-card ss-card-pad text-sm"><h2><%= t("automations.bp.source") %></h2><p class="break-all mt-1 text-muted"><%= @blueprint.source_url %></p></section>
    <% end %>
    <% if can?(:manage) && !@blueprint.builtin? %>
      <%= render Ss::ButtonComponent.new(label: t("automations.common.delete"), icon: icon("trash", ""), href: blueprint_path(@blueprint), method: :delete,
                                         variant: :ghost, size: :sm, class: "text-danger w-fit", confirm: t("automations.bp.delete_confirm"),
                                         confirm_tone: :danger, confirm_button: t("shared.confirm.delete")) %>
    <% end %>
  </aside>
</div>
