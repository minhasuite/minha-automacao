<%# locals: (site:, record:) -%>
<%= ss_form_with model: record.new_record? ? [ site, record ] : record, class: "ss-card ss-card-pad grid gap-4 md:grid-cols-2 max-w-3xl" do |f| %>
  <%= render "web/shared/errors", record: record %>
  <%= hidden_field_tag :back, params[:back], id: nil %>
  <%= f.ss_select :point_id, point_choices(site), label: t("automations.labels.field_types.point"), include_blank: t("automations.bp.choose"), required: true %>
  <%= f.ss_text_field :to_value, label: t("automations.notify_rules.to_value"), value: record.to_value, placeholder: t("automations.notify_rules.to_value_ph") %>
  <div class="md:col-span-2">
    <%= f.ss_text_area :message, label: t("automations.notify_rules.message"), rows: 3, maxlength: MessageTemplate::MAX, placeholder: t("custom.notify.message_ph") %>
    <%= render "web/shared/message_preview", preview: @preview, css: "mt-2" %></div>
  <fieldset class="md:col-span-2">
    <legend class="ss-label"><%= t("automations.notify_rules.channels") %></legend>
    <div class="flex flex-wrap gap-3">
      <%= hidden_field_tag "notify_rule[channels][]", "", id: nil %>
      <% Notifier.channel_choices(site).each do |key, name| %>
        <%= f.ss_check_box :channels, label: name, name: "notify_rule[channels][]", id: f.field_id(:channels, key), checked: Array(record.channels).include?(key),
                           checked_value: key, unchecked_value: nil %>
      <% end %>
    </div>
  </fieldset>
  <%= f.ss_select :priority, notification_level_choices, label: t("notifications.level.label"), help: t("notifications.level.hint") %>
  <%= f.ss_select :merge_s, notification_merge_choices(include_default: true), label: t("notifications.merge.label"), help: t("notifications.merge.hint") %>
  <%= f.ss_check_box :enabled, label: t("automations.notify_rules.active") %>
  <div class="md:col-span-2 flex flex-wrap gap-2">
    <%= f.ss_submit t("automations.notify_rules.save") %>
    <%= render Ss::ButtonComponent.new(label: t("automations.settings.cancel"), href: back_path, variant: :ghost) %>
  </div>
<% end %>
