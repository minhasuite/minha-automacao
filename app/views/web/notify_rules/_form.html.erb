<%# locals: (site:, record:) -%>
<%= form_with model: record.new_record? ? [ site, record ] : record, class: "ss-card ss-card-pad grid gap-4 md:grid-cols-2 max-w-3xl" do |f| %>
  <%= render "web/shared/errors", record: record %>
  <%= hidden_field_tag :back, params[:back], id: nil %>
  <div><%= f.label :point_id, t("automations.labels.field_types.point"), class: "ss-label" %><%= f.select :point_id, point_choices(site), { include_blank: t("automations.bp.choose") }, class: "ss-input", required: true %></div>
  <div><%= f.label :to_value, t("automations.notify_rules.to_value"), class: "ss-label" %><%= f.text_field :to_value, value: record.to_value, class: "ss-input", placeholder: t("automations.notify_rules.to_value_ph") %></div>
  <div class="md:col-span-2"><%= f.label :message, t("automations.notify_rules.message"), class: "ss-label" %><%= f.text_area :message, rows: 3, class: "ss-input", maxlength: MessageTemplate::MAX, placeholder: t("custom.notify.message_ph") %>
    <%= render "web/shared/message_preview", preview: @preview, css: "mt-2" %></div>
  <fieldset class="md:col-span-2">
    <legend class="ss-label"><%= t("automations.notify_rules.channels") %></legend>
    <div class="flex flex-wrap gap-3">
      <%= f.collection_check_boxes :channels, Notifier.channel_choices(site), :first, :last do |b| %><label class="ss-check"><%= b.check_box %> <%= b.text %></label><% end %>
    </div>
  </fieldset>
  <div><%= f.label :priority, t("notifications.level.label"), class: "ss-label" %><%= f.select :priority, notification_level_choices, {}, class: "ss-input" %>
    <p class="text-xs text-muted mt-1"><%= t("notifications.level.hint") %></p></div>
  <div><%= f.label :merge_s, t("notifications.merge.label"), class: "ss-label" %><%= f.select :merge_s, notification_merge_choices(include_default: true), {}, class: "ss-input" %>
    <p class="text-xs text-muted mt-1"><%= t("notifications.merge.hint") %></p></div>
  <label class="ss-check"><%= f.check_box :enabled %> <%= t("automations.notify_rules.active") %></label>
  <div class="md:col-span-2 flex flex-wrap gap-2">
    <%= f.submit t("automations.notify_rules.save"), class: "ss-btn ss-btn-primary" %>
    <%= link_to t("automations.settings.cancel"), back_path, class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
