<% fmt = ->(t) { t && l(Time.zone.parse(t.to_s), format: "%H:%M:%S") } %>
<%= render "web/shared/header", title: (@run.dry_run ? t("automations.runs.simulation") : t("automations.runs.run")), subtitle: "#{@automation.name} · #{l(@run.started_at, format: :long)}",
                                back: automation_automation_runs_path(@automation), badge: run_badge(@run) do %>
  <% if can?(:manage) %>
    <%= link_to edit_automation_path(@automation), class: "ss-btn ss-btn-ghost" do %><%= icon("pencil", "size-4") %><%= t("automations.runs.edit", kind: @automation.kind_label.downcase) %><% end %>
    <% if @run.dry_run %><%= link_to simulate_automation_path(@automation), class: "ss-btn ss-btn-outline" do %><%= icon("refresh", "size-4") %><%= t("automations.runs.simulate_again") %><% end %><% end %>
  <% end %>
<% end %>

<div class="grid gap-4 lg:grid-cols-3 items-start">
  <section class="ss-card ss-card-pad lg:col-span-2 min-w-0" aria-label="<%= t("automations.runs.steps") %>">
    <h2><%= t("automations.runs.steps") %></h2>
    <% if @run.dry_run %><p class="text-sm text-muted"><%= t("automations.runs.simulation_hint") %></p><% end %>
    <ol class="mt-3 relative">
      <% @run.steps.each do |s| %>
        <li class="flex gap-3 pb-4 min-w-0">
          <%= result_icon(s["result"]) %>
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-ink break-words"><%= s["title"] %></p>
            <% if s["detail"].present? %><p class="text-sm text-ink-2 break-words"><%= s["detail"] %></p><% end %>
            <% meta = [ fmt.call(s["at"]), ("#{s['ms']} ms" if s["ms"].to_i.positive?) ].compact %>
            <% if meta.any? %><p class="text-xs text-muted num"><%= meta.join(" · ") %></p><% end %>
            <% if s["checks"].present? %><%= render "web/automation_runs/checks", checks: s["checks"] %><% end %>
          </div>
        </li>
      <% end %>
    </ol>
  </section>

  <aside class="ss-card ss-card-pad min-w-0" aria-label="<%= t("automations.runs.summary") %>">
    <h2><%= t("automations.runs.summary") %></h2>
    <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
      <dt class="text-muted"><%= t("automations.runs.trigger") %></dt><dd class="text-ink break-words"><%= @run.trigger["title"] || t("automations.runs.trigger_default") %></dd>
      <dt class="text-muted"><%= t("automations.edit.status") %></dt><dd class="text-ink"><%= @run.status_label %></dd>
      <dt class="text-muted"><%= t("automations.runs.version") %></dt><dd class="text-ink"><%= @run.version&.positive? ? @run.version : t("automations.runs.draft") %></dd>
      <dt class="text-muted"><%= t("automations.runs.started") %></dt><dd class="text-ink num"><%= l(@run.started_at, format: "%d/%m %H:%M:%S") %></dd>
      <% if @run.finished_at %><dt class="text-muted"><%= t("automations.runs.finished") %></dt><dd class="text-ink num"><%= l(@run.finished_at, format: "%d/%m %H:%M:%S") %></dd><% end %>
      <% if @run.resume_at && @run.status == "waiting" %><dt class="text-muted"><%= t("automations.runs.resumes") %></dt><dd class="text-ink num"><%= l(@run.resume_at, format: "%d/%m %H:%M:%S") %></dd><% end %>
      <% if @run.depth.positive? %><dt class="text-muted"><%= t("automations.runs.chain") %></dt><dd class="text-ink"><%= t("automations.runs.chain_before", count: @run.depth) %></dd><% end %>
    </dl>
    <% if @run.error.present? %><%= render(Ss::CalloutComponent.new(tone: :danger, class: "mt-3")) { @run.error } %><% end %>
    <% vars = @run.state["vars"].to_h.except("repeat_index") %>
    <% if vars.any? %>
      <p class="ss-label mt-4"><%= t("automations.runs.variables") %></p>
      <ul class="text-sm num"><% vars.each do |k, v| %><li class="break-words"><span class="text-muted"><%= k %></span> = <%= v.inspect.truncate(120) %></li><% end %></ul>
    <% end %>
  </aside>
</div>
