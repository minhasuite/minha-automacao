<% back = @page.parent.nil? ? site_media_path(@site) : site_media_browse_path(@site, @source.key, path: @page.parent.presence) %>
<%= render "web/shared/header", title: @page.title, subtitle: @source.title, back: back %>
<%= render "web/sites/tabs", site: @site, current: :media %>

<% if @error %>
  <%= render(Ss::CalloutComponent.new(tone: :danger, title: t("media.browse.error"), css: "mb-4")) { tag.p(@error) } %>
<% end %>

<% if @item %>
  <% preview = @preview %>
  <section class="ss-card ss-card-pad mb-6" aria-labelledby="item-title">
    <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] items-center">
      <div data-kind="<%= @item.kind %>">
        <% if preview && @item.kind == "video" %>
          <video class="block max-h-96 w-full rounded-2xl bg-ink object-contain" src="<%= preview %>" controls playsinline preload="metadata" aria-label="<%= @item.title %>"></video>
        <% elsif preview && @item.kind == "image" %>
          <img class="block max-h-96 w-full rounded-2xl object-contain" src="<%= preview %>" alt="<%= @item.title %>">
        <% else %>
          <span class="ss-icon-tile is-accent mx-auto aspect-square size-auto w-full max-w-56 rounded-3xl"><% if @item.thumb %><img src="<%= @item.thumb %>" alt="" loading="lazy"><% else %><%= icon(@item.kind == "radio" ? "globe" : "music-note", "size-12") %><% end %></span>
          <% if preview %><audio src="<%= preview %>" controls preload="none" class="w-full mt-3" aria-label="<%= t("media.browse.listen_here", name: @item.title) %>"></audio><% end %>
        <% end %>
      </div>
      <div class="min-w-0">
        <p class="ss-section"><%= t("media.kinds.#{@item.kind}") %></p>
        <h2 id="item-title" class="text-xl break-words"><%= @item.title %></h2>
        <% if @item.subtitle.present? %><p class="text-sm text-muted mt-1"><%= @item.subtitle %></p><% end %>
        <% if preview %><%= link_to MediaSources.public_url(preview), class: "ss-btn ss-btn-ghost ss-btn-sm mt-3", target: "_blank", rel: "noopener" do %><%= icon("external-link", "size-4") %><%= t("media.browse.open") %><% end %><% end %>
        <% if @players.any? && can?(:command) %>
          <%= ss_form_with url: site_media_play_path(@site), class: "flex flex-wrap items-end gap-2 mt-4" do |f| %>
            <%= hidden_field_tag :source, @source.key, id: nil %>
            <%= hidden_field_tag :item, @item.id, id: nil %>
            <%= hidden_field_tag :path, @path, id: nil %>
            <%= f.ss_select :player_id, @players.map { |p| [ Notifier::Channels::Player.name(p), p.id ] }, id: "play-on", label: t("media.browse.play_on"), wrapper_class: "flex-1 min-w-48" %>
            <%= render Ss::ButtonComponent.new(label: t("media.browse.play"), icon: icon("play", ""), type: :submit) %>
          <% end %>
        <% elsif @players.empty? %>
          <p class="text-sm text-muted mt-4"><%= t("media.browse.no_player") %></p>
        <% end %>
        <% if @source.uploads? && can?(:manage) %>
          <%= render Ss::ButtonComponent.new(label: t("media.files.delete"), icon: icon("trash", ""), href: site_media_file_delete_path(@site), method: :delete, params: { path: @item.id },
                                             variant: :ghost, size: :sm, css: "mt-3",
                                             confirm: t("media.files.confirm_delete", name: @item.title), confirm_tone: :danger, confirm_button: t("media.files.delete")) %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<% if @source.searchable? %>
  <%= ss_form_with url: site_media_browse_path(@site, @source.key), method: :get, class: "flex gap-2 mb-4", role: "search" do |f| %>
    <%= f.ss_search_field :q, value: @query, id: "media-q", label: t("media.browse.search"), hide_label: true, wrapper_class: "flex-1 min-w-0", placeholder: t("media.browse.search_ph") %>
    <%= render Ss::ButtonComponent.new(icon: icon("search", ""), type: :submit, variant: :ghost, aria: { label: t("media.browse.search") }) %>
  <% end %>
<% end %>

<% if @source.uploads? && can?(:manage) && !@item %>
  <div class="grid gap-3 sm:grid-cols-2 mb-4">
    <%= ss_form_with url: site_media_files_path(@site), multipart: true, class: "ss-card ss-card-pad flex flex-wrap items-end gap-2" do |f| %>
      <%= hidden_field_tag :path, @path, id: nil %>
      <%= f.ss_file_field :files, id: "media-upload", multiple: true, include_hidden: false, accept: "audio/*,video/*,image/*", required: true,
                          label: t("media.files.upload"), wrapper_class: "flex-1 min-w-48" %>
      <%= render Ss::ButtonComponent.new(label: t("media.files.send"), icon: icon("upload", ""), type: :submit) %>
    <% end %>
    <%= ss_form_with url: site_media_folders_path(@site), class: "ss-card ss-card-pad flex flex-wrap items-end gap-2" do |f| %>
      <%= hidden_field_tag :path, @path, id: nil %>
      <%= f.ss_text_field :name, id: "media-folder", label: t("media.files.new_folder"), wrapper_class: "flex-1 min-w-48", maxlength: 120, required: true %>
      <%= render Ss::ButtonComponent.new(label: t("media.files.create"), icon: icon("plus", ""), type: :submit, variant: :ghost) %>
    <% end %>
  </div>
<% end %>

<% if @page.items.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("media.browse.empty"), text: (@source.uploads? ? t("media.browse.empty_local") : t("media.browse.empty_hint")), css: "ss-card") %>
<% else %>
  <ul class="grid grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fill,minmax(9.5rem,1fr))]" aria-label="<%= @page.title %>">
    <% @page.items.each do |i| %>
      <li>
        <% href = i.folder? ? site_media_browse_path(@site, @source.key, path: i.id) : site_media_browse_path(@site, @source.key, path: @path.presence, q: @query, item: i.id) %>
        <%# Item da fonte num card-link da gem (sobe no hover): a capa no ícone tonal (foto ou ícone), título e linha menor. %>
        <%= link_to href, class: "ss-card grid h-full content-start gap-1.5 p-2 no-underline aria-[current=true]:border-accent", "aria-current": (@item&.id == i.id ? "true" : nil) do %>
          <span class="ss-icon-tile <%= i.folder? ? 'is-muted' : 'is-accent' %> aspect-square size-auto w-full">
            <% if i.thumb %><img src="<%= i.thumb %>" alt="" loading="lazy"><% else %><%= icon({ "folder" => "collection", "audio" => "music-note", "video" => "video-camera", "image" => "photograph", "radio" => "globe" }.fetch(i.kind, "document-text"), "size-7") %><% end %>
          </span>
          <span class="line-clamp-2 text-sm font-bold break-words text-ink"><%= i.title %></span>
          <% if i.subtitle.present? %><span class="truncate text-xs text-muted"><%= i.subtitle %></span><% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
