<%= render "web/shared/header", title: t("media.index.title"), subtitle: t("media.index.subtitle", site: @site.name) %>
<%= render "web/sites/tabs", site: @site, current: :media %>

<p class="ss-section mb-3"><%= t("media.index.players") %></p>
<% if @players.empty? %>
  <div class="ss-card ss-empty mb-6">
    <p class="font-bold text-ink"><%= t("media.index.no_players") %></p>
    <p class="mt-1 max-w-lg mx-auto"><%= t("media.index.no_players_hint") %></p>
    <% if can?(:manage) %><%= link_to new_site_integration_path(@site), class: "ss-btn ss-btn-primary mt-4" do %><%= icon("plus", "size-4") %><%= t("media.index.add_player") %><% end %><% end %>
  </div>
<% else %>
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3 mb-6">
    <% @players.each do |p| %>
      <% v = p.value.is_a?(Hash) ? p.value : {} %>
      <% cmds = Points::Command.commands_for(p) %>
      <% ok = p.quality == "good" && can?(:command, risk: p.risk) %>
      <section class="ss-card ss-card-pad ma-player" id="player-<%= p.id %>" aria-labelledby="pl-<%= p.id %>" data-state="<%= v["state"] || "idle" %>">
        <div class="flex items-start gap-3">
          <span class="ss-icon-tile text-accent shrink-0"><%= icon(p.capability == "stream" ? "video-camera" : (p.helper.present? ? "collection" : "music-note")) %></span>
          <div class="min-w-0 flex-1">
            <h2 id="pl-<%= p.id %>" class="truncate"><%= Notifier::Channels::Player.name(p) %></h2>
            <% if v["title"].present? %>
              <p class="text-sm text-ink truncate font-semibold"><%= v["title"] %></p>
              <p class="text-xs text-muted truncate"><%= [ v["artist"], v["album"], v["app"] ].compact_blank.join(" · ") %></p>
            <% else %>
              <p class="text-sm text-muted"><%= p.quality == "good" ? t("media.states.#{v['state'].presence_in(%w[playing paused buffering on off idle]) || 'idle'}") : t("media.states.unavailable") %></p>
            <% end %>
          </div>
          <% if v["state"] == "playing" %><span class="ss-badge ss-badge-accent"><%= t("media.states.playing") %></span><% end %>
        </div>
        <% if ok %>
          <div class="flex flex-wrap items-center gap-2 mt-4">
            <span class="ss-step" role="group" aria-label="<%= t("media.index.controls", name: p.name) %>">
              <% [ [ "previous", "rewind" ], [ v["state"] == "playing" ? "pause" : "resume", v["state"] == "playing" ? "pause" : "play" ], [ "next", "fast-forward" ] ].each do |c, ico| %>
                <% next unless cmds.include?(c) %>
                <%= button_to site_media_control_path(@site, p), params: { command: c }, title: t("media.cmd.#{c}"), "aria-label": "#{t("media.cmd.#{c}")} #{p.name}" do %><%= icon(ico, "size-4") %><% end %>
              <% end %>
            </span>
            <% if cmds.include?("mute") %>
              <%= button_to site_media_control_path(@site, p), params: { command: "mute" }, class: "ss-btn ss-btn-ghost ss-btn-sm", "aria-pressed": (v["muted"] == true).to_s, title: t("media.cmd.mute") do %><%= icon(v["muted"] ? "volume-off" : "volume-up", "size-4") %><% end %>
            <% end %>
            <% if cmds.include?("volume") %>
              <%= form_with url: site_media_control_path(@site, p), class: "flex items-center gap-2 flex-1 min-w-32" do %>
                <%= hidden_field_tag :command, "volume", id: nil %>
                <label class="sr-only" for="vol-<%= p.id %>"><%= t("media.index.volume", name: p.name) %></label>
                <input type="range" id="vol-<%= p.id %>" name="value" class="dw-range flex-1" min="0" max="100" step="1" value="<%= v["volume"] || 0 %>" data-autosubmit>
              <% end %>
            <% end %>
          </div>
          <% if cmds.include?("join") %>
            <% others = @players.select { |o| o.id != p.id && o.device.driver == p.device.driver && o.capability == "media" } %>
            <% if others.any? %>
              <%= form_with url: site_media_control_path(@site, p), class: "flex flex-wrap items-end gap-2 mt-3" do %>
                <%= hidden_field_tag :command, "join", id: nil %>
                <div class="flex-1 min-w-40">
                  <label class="ss-label" for="join-<%= p.id %>"><%= t("media.index.join") %></label>
                  <%= select_tag :value, options_for_select(others.map { |o| [ o.device.name, o.id ] }), id: "join-#{p.id}", class: "ss-input" %>
                </div>
                <button class="ss-btn ss-btn-ghost ss-btn-sm"><%= icon("link", "size-4") %><%= t("media.index.join_btn") %></button>
              <% end %>
              <%= button_to site_media_control_path(@site, p), params: { command: "unjoin" }, class: "ss-btn ss-btn-ghost ss-btn-sm mt-2" do %><%= icon("x", "size-4") %><%= t("media.index.unjoin") %><% end %>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>
  </div>

  <% if can?(:command) %>
    <section class="ss-card ss-card-pad mb-6" aria-labelledby="say-title">
      <h2 id="say-title" class="flex items-center gap-2"><span class="ss-icon-tile text-accent"><%= icon("speakerphone") %></span><%= t("media.index.say") %></h2>
      <p class="text-sm text-muted mt-1"><%= t("media.index.say_hint") %></p>
      <%= form_with url: site_media_speak_path(@site), class: "grid gap-3 sm:grid-cols-[1fr_2fr_auto] items-end mt-3" do %>
        <div>
          <label class="ss-label" for="say-player"><%= t("media.index.on") %></label>
          <%= select_tag :player_id, options_for_select(@players.map { |p| [ Notifier::Channels::Player.name(p), p.id ] }), id: "say-player", class: "ss-input" %>
        </div>
        <div>
          <label class="ss-label" for="say-text"><%= t("media.index.text") %></label>
          <%= text_field_tag :text, nil, id: "say-text", class: "ss-input", maxlength: Points::Command::MAX_SPEECH, required: true, placeholder: t("media.index.say_ph") %>
        </div>
        <button class="ss-btn ss-btn-primary"><%= icon("volume-up", "size-4") %><%= t("media.index.say_btn") %></button>
      <% end %>
    </section>
  <% end %>
<% end %>

<p class="ss-section mb-3"><%= t("media.index.sources") %></p>
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
  <% @sources.each do |s| %>
    <%= link_to site_media_browse_path(@site, s.key), class: "ss-card ss-card-pad ma-source no-underline flex items-start gap-3" do %>
      <span class="ss-icon-tile text-accent shrink-0"><%= icon(s.icon) %></span>
      <span class="min-w-0">
        <span class="block font-bold text-ink"><%= s.title %></span>
        <span class="block text-sm text-muted mt-1"><%= s.description %></span>
      </span>
    <% end %>
  <% end %>
</div>
