<%= render "web/shared/header", title: t("media.index.title"), subtitle: t("media.index.subtitle", site: @site.name) %>
<%= render "web/sites/tabs", site: @site, current: :media %>

<p class="ss-section mb-3"><%= t("media.index.players") %></p>
<% if @players.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("media.index.no_players"), text: t("media.index.no_players_hint"), css: "ss-card mb-6") do %>
    <% if can?(:manage) %><%= link_to new_site_integration_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("media.index.add_player") %><% end %><% end %>
  <% end %>
<% else %>
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3 mb-6">
    <% @players.each do |p| %>
      <% v = p.value.is_a?(Hash) ? p.value : {} %>
      <% cmds = Points::Command.commands_for(p) %>
      <% ok = p.quality == "good" && can?(:command, risk: p.risk) %>
      <% url = ->(cmd) { site_media_control_path(@site, p, command: cmd) if ok && cmds.include?(cmd) } %>
      <% state = p.quality != "good" ? :unavailable : { "playing" => :playing, "paused" => :paused, "buffering" => :buffering }.fetch(v["state"].to_s, :idle) %>
      <% others = cmds.include?("join") ? @players.select { |o| o.id != p.id && o.device.driver == p.device.driver && o.capability == "media" } : [] %>
      <section class="ss-card ss-card-pad" id="player-<%= p.id %>" aria-labelledby="pl-<%= p.id %>" data-state="<%= v["state"] || "idle" %>">
        <div class="flex items-start gap-3 mb-3">
          <span class="ss-icon-tile text-accent shrink-0"><%= icon(p.capability == "stream" ? "video-camera" : (p.helper.present? ? "collection" : "music-note")) %></span>
          <div class="min-w-0 flex-1">
            <h2 id="pl-<%= p.id %>" class="truncate"><%= Notifier::Channels::Player.name(p) %></h2>
            <p class="text-sm text-muted"><%= p.quality == "good" ? t("media.states.#{v['state'].presence_in(%w[playing paused buffering on off idle]) || 'idle'}") : t("media.states.unavailable") %></p>
          </div>
        </div>
        <%# Player da gem: anterior/tocar/próxima, volume (o slider manda "value") e mudo; o comando vai na query da URL. %>
        <%= render Ss::MediaPlayerComponent.new(title: v["title"].presence, subtitle: [ v["artist"], v["album"] ].compact_blank.uniq.join(" · ").presence,
                                                art_url: dw_media_image(v), state: state, source: v["app"].presence,
                                                play_url: url.call("resume"), pause_url: url.call("pause"), previous_url: url.call("previous"), next_url: url.call("next"),
                                                volume: ((v["volume"].to_f / 100) if cmds.include?("volume")), volume_url: url.call("volume"), volume_param: "value",
                                                mute_url: url.call("mute"), muted: v["muted"] == true, css: "is-flush",
                                                labels: { play: t("media.cmd.resume"), pause: t("media.cmd.pause"), previous: t("media.cmd.previous"), next: t("media.cmd.next"),
                                                          volume: t("media.index.volume", name: p.name), mute: t("media.cmd.mute"), unmute: t("dashboards.w.mc.unmute") }) do |player| %>
          <% if ok && others.any? %>
            <% player.with_media_picker do %>
              <%= form_with url: site_media_control_path(@site, p), class: "flex flex-wrap items-end gap-2" do %>
                <%= hidden_field_tag :command, "join", id: nil %>
                <div class="flex-1 min-w-40">
                  <label class="ss-label" for="join-<%= p.id %>"><%= t("media.index.join") %></label>
                  <%= select_tag :value, options_for_select(others.map { |o| [ o.device.name, o.id ] }), id: "join-#{p.id}", class: "ss-input" %>
                </div>
                <button class="ss-btn ss-btn-ghost ss-btn-sm"><%= icon("link", "size-4") %><%= t("media.index.join_btn") %></button>
              <% end %>
              <%= button_to site_media_control_path(@site, p), params: { command: "unjoin" }, class: "ss-btn ss-btn-ghost ss-btn-sm mt-2" do %><%= icon("x", "size-4") %><%= t("media.index.unjoin") %><% end %>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>
  </div>

  <% if can?(:command) %>
    <section class="ss-card ss-card-pad mb-6" aria-labelledby="say-title">
      <h2 id="say-title" class="flex items-center gap-2"><span class="ss-icon-tile text-accent"><%= icon("speakerphone") %></span><%= t("media.index.say") %></h2>
      <p class="text-sm text-muted mt-1"><%= t("media.index.say_hint") %></p>
      <%= form_with url: site_media_speak_path(@site), class: "grid gap-3 sm:grid-cols-[1fr_2fr_auto] items-end mt-3" do %>
        <div>
          <label class="ss-label" for="say-player"><%= t("media.index.on") %></label>
          <%= select_tag :player_id, options_for_select(@players.map { |p| [ Notifier::Channels::Player.name(p), p.id ] }), id: "say-player", class: "ss-input" %>
        </div>
        <div>
          <label class="ss-label" for="say-text"><%= t("media.index.text") %></label>
          <%= text_field_tag :text, nil, id: "say-text", class: "ss-input", maxlength: Points::Command::MAX_SPEECH, required: true, placeholder: t("media.index.say_ph") %>
        </div>
        <button class="ss-btn ss-btn-primary"><%= icon("volume-up", "size-4") %><%= t("media.index.say_btn") %></button>
      <% end %>
    </section>
  <% end %>
<% end %>

<p class="ss-section mb-3"><%= t("media.index.sources") %></p>
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
  <% @sources.each do |s| %>
    <section class="ss-card ss-card-pad ss-card-link relative flex items-start gap-3" aria-labelledby="src-<%= s.key %>">
      <span class="ss-icon-tile text-accent shrink-0"><%= icon(s.icon) %></span>
      <div class="min-w-0 flex-1">
        <h3 id="src-<%= s.key %>"><%= s.title %></h3>
        <p class="text-sm text-muted mt-1"><%= s.description %></p>
        <%= link_to site_media_browse_path(@site, s.key), class: "ss-btn ss-btn-ghost ss-btn-sm mt-3 after:absolute after:inset-0" do %><%= icon("arrow-right", "size-4") %><%= t("media.index.open_source") %><% end %>
      </div>
    </section>
  <% end %>
</div>
