<%= render "web/shared/header", title: t("automations.alerts.title"), subtitle: t("automations.alerts.subtitle") %>

<section class="ss-card ss-card-pad" aria-labelledby="open-title">
  <h2 id="open-title"><%= t("automations.alerts.open") %></h2>
  <% if @open.empty? %>
    <p class="text-sm text-muted mt-2"><%= t("automations.alerts.none_open") %></p>
  <% else %>
    <ul class="mt-2 divide-y divide-line">
      <% @open.each do |a| %>
        <% critical = a.alert_rule.severity == "critical" %>
        <li class="flex flex-wrap items-center gap-3 py-3">
          <span class="grid place-items-center size-9 shrink-0 rounded-lg <%= critical ? 'bg-danger-soft text-danger' : 'bg-warn-soft text-warn' %>"><%= icon("exclamation-circle", "size-5") %></span>
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-ink"><%= a.alert_rule.name %> <span class="ss-badge <%= critical ? 'ss-badge-danger' : 'ss-badge-warn' %>"><%= a.alert_rule.severity_label %></span></p>
            <p class="text-sm text-muted"><%= a.point.name %>: <%= point_value_text(a.point) %> · <%= a.site.name %> · <%= t("automations.alerts.opened", at: l(a.opened_at, format: :short)) %> · <%= t("automations.alerts.notices", count: a.level) %><% if a.acked? %> · <%= t("automations.alerts.acked_by", name: a.acked_by&.name || t("automations.alerts.someone")) %><% end %></p>
          </div>
          <% if !a.acked? && SiteMembership.allowed?(a.site.role_for(current_user), :command, risk: "sensitive") %>
            <%= button_to ack_alert_path(a), class: "ss-btn ss-btn-primary ss-btn-sm" do %><%= icon("check", "size-4") %><%= t("automations.alerts.ack") %><% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="closed-title">
  <h2 id="closed-title"><%= t("automations.alerts.resolved") %></h2>
  <% if @closed.empty? %>
    <p class="text-sm text-muted mt-2"><%= t("automations.alerts.nothing") %></p>
  <% else %>
    <ul class="mt-2 divide-y divide-line">
      <% @closed.each do |a| %>
        <li class="py-3">
          <p class="font-semibold text-ink"><%= a.alert_rule.name %></p>
          <p class="text-sm text-muted"><%= a.site.name %> · <%= t("automations.alerts.range", from: l(a.opened_at, format: :short), to: l(a.resolved_at, format: :short)) %><% if a.acked? %> · <%= t("automations.alerts.acked_by", name: a.acked_by&.name || t("automations.alerts.someone")) %><% end %></p>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
