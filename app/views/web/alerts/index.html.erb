<%= render "web/shared/header", title: t("automations.alerts.title"), subtitle: t("automations.alerts.subtitle") %>

<section class="ss-card ss-card-pad" aria-labelledby="open-title">
  <h2 id="open-title"><%= t("automations.alerts.open") %></h2>
  <% if @open.empty? %>
    <p class="text-sm text-muted mt-2"><%= t("automations.alerts.none_open") %></p>
  <% else %>
    <div class="grid gap-3 mt-3">
      <% @open.each do |a| %>
        <% can_ack = !a.acked? && SiteMembership.allowed?(a.site.role_for(current_user), :command, risk: "sensitive") %>
        <% details = [ a.alert_rule.severity_label, "#{a.point.name}: #{point_value_text(a.point)}", a.site.name, t("automations.alerts.notices", count: a.level),
                       (t("automations.alerts.acked_by", name: a.acked_by&.name || t("automations.alerts.someone")) if a.acked?) ].compact %>
        <%= render Ss::NoticeCardComponent.new(title: a.alert_rule.name, text: details.join(" · "), tone: a.alert_rule.severity == "critical" ? :critical : :warn,
                                               time: t("dashboards.w.ago", time: dw_short_ago(a.opened_at)), id: "alert-#{a.id}",
                                               actions: (can_ack ? [ { label: t("automations.alerts.ack"), url: ack_alert_path(a), icon: icon("check", "") } ] : [])) %>
      <% end %>
    </div>
  <% end %>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="closed-title">
  <h2 id="closed-title"><%= t("automations.alerts.resolved") %></h2>
  <% if @closed.empty? %>
    <p class="text-sm text-muted mt-2"><%= t("automations.alerts.nothing") %></p>
  <% else %>
    <div class="grid gap-3 mt-3">
      <% @closed.each do |a| %>
        <%= render Ss::NoticeCardComponent.new(title: a.alert_rule.name, tone: :success, id: "alert-#{a.id}",
                                               text: "#{a.site.name} · #{t("automations.alerts.range", from: l(a.opened_at, format: :short), to: l(a.resolved_at, format: :short))}",
                                               footer: (t("automations.alerts.acked_by", name: a.acked_by&.name || t("automations.alerts.someone")) if a.acked?)) %>
      <% end %>
    </div>
  <% end %>
</section>
