<%= render "web/shared/header", title: t("dev_tools.title"), subtitle: t("dev_tools.subtitle", site: @site.name), back: site_path(@site) %>
<%= render "web/sites/tabs", site: @site, current: :dev_tools %>
<nav class="ss-chips is-solid mb-4" data-controller="ss-scroll-current" aria-label="<%= t("dev_tools.title") %>">
  <% Web::DevToolsController::TABS.each_key do |key| %>
    <%= link_to t("dev_tools.tabs.#{key}"), dev_tools_site_path(@site, aba: key), class: "ss-chip no-underline", "aria-current": (key == @tab).to_s %>
  <% end %>
</nav>

<% if @tab == "estados" %>
  <%= ss_form_with url: dev_tools_site_path(@site), method: :get, class: "mb-3 flex flex-wrap items-end gap-3", role: "search" do |f| %>
    <%= hidden_field_tag :aba, "estados", id: nil %>
    <%= f.ss_search_field :q, value: params[:q], label: t("datasets.show.filter"), wrapper_class: "min-w-48 flex-1", placeholder: t("dev_tools.filter_ph") %>
    <%= f.ss_select :capacidade, Point::CAPABILITY_LABELS.invert.sort, selected: params[:capacidade], include_blank: t("site_helpers.index.all"), label: t("dev_tools.type") %>
    <%= render Ss::IconButtonComponent.new(icon: icon("search", ""), label: t("datasets.show.filter"), type: :submit, variant: :outline) %>
  <% end %>
  <% if @states.empty? %>
    <%= render Ss::EmptyStateComponent.new(title: t("dev_tools.none"), variant: :busca, css: "ss-card") %>
  <% else %>
    <ul class="ss-card ss-rows" aria-label="<%= t("dev_tools.tabs.estados") %>">
      <% @states.each do |p| %>
        <li class="!items-start">
          <div class="min-w-0 flex-1">
            <p class="font-bold text-ink truncate"><%= link_to p.name, point_path(p), class: "text-ink no-underline hover:text-accent" %></p>
            <p class="text-xs text-muted truncate num"><%= p.key %> · <%= p.capability_label %><%= " · helper #{p.helper_type&.title}" if p.helper %></p>
            <% if p.attrs.present? %>
              <details class="mt-1"><summary class="ss-summary text-xs text-accent"><%= t("dev_tools.attrs", n: p.attrs.size) %></summary>
                <%= render Ss::CodeBlockComponent.new(text: JSON.pretty_generate(p.attrs), max_height: "16rem", class: "mt-1 max-w-full") %></details>
            <% end %>
          </div>
          <div class="text-right shrink-0 max-w-[50%]">
            <p class="text-sm font-bold truncate <%= p.quality == 'good' ? 'text-ink' : 'text-warn' %>"><%= p.quality == "good" ? point_value_text(p) : t("site_helpers.index.no_signal") %></p>
            <p class="text-xs text-muted num truncate"><%= p.value.to_json.truncate(40) %></p>
            <% if p.helper %>
              <%= ss_form_with url: dev_tools_state_site_path(@site), class: "mt-1 flex items-center gap-1 justify-end" do |f| %>
                <%= hidden_field_tag :point_id, p.id, id: nil %><%= hidden_field_tag :q, params[:q], id: nil %>
                <%= f.ss_text_field :value, id: "v_#{p.id}", label: t("dev_tools.new_value_of", name: p.name), hide_label: true, class: "!py-1 w-32 text-sm", placeholder: t("dev_tools.new_value") %>
                <%= render Ss::IconButtonComponent.new(icon: icon("check", ""), label: t("dev_tools.set_value_of", name: p.name), title: t("dev_tools.set_value"), type: :submit, size: :sm) %>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
    <p class="text-xs text-muted mt-2"><%= t("dev_tools.limit", n: DevTools::STATES_LIMIT) %></p>
  <% end %>

<% elsif @tab == "modelo" %>
  <div class="grid gap-4 lg:grid-cols-2">
    <%= ss_form_with url: dev_tools_template_site_path(@site), class: "ss-card ss-card-pad grid gap-3", data: { controller: "ss-autosubmit", turbo_frame: "dev-result", action: "input->ss-autosubmit#queue change->ss-autosubmit#now" } do |f| %>
      <%= f.ss_select :mode, [ [ t("dev_tools.liquid"), "liquid" ], [ t("dev_tools.expr"), "expr" ] ], label: t("dev_tools.type") %>
      <%= f.ss_text_area :template, value: @template, label: t("dev_tools.tabs.modelo"), rows: 10, class: "ss-code-input", spellcheck: false, maxlength: DevTools::MAX_TEMPLATE %>
      <p class="text-xs text-muted"><%= t("dev_tools.template_hint_html") %></p>
    <% end %>
    <% result, error = DevTools.render(@site, @template) %>
    <%= render "web/dev_tools/result", result: result, error: error, mode: "liquid" %>
  </div>

<% elsif @tab == "acao" %>
  <%= ss_form_with url: dev_tools_command_site_path(@site), class: "ss-card ss-card-pad grid gap-3 sm:grid-cols-2 max-w-3xl", data: { turbo_confirm: t("dev_tools.confirm"), turbo_confirm_title: t("dev_tools.confirm_title") } do |f| %>
    <%= f.ss_select :point_id, @writable.map { |p| [ "#{p.name} · #{p.device.name} (#{Points::Command.commands_for(p).join(', ')})#{" · #{t('dev_tools.critical')}" if p.risk == 'critical'}", p.id ] },
                    label: t("dev_tools.point"), wrapper_class: "sm:col-span-2", required: true %>
    <%= f.ss_text_field :command, label: t("dev_tools.command"), class: "num", required: true, placeholder: "on, off, set, select…", maxlength: 40 %>
    <%= f.ss_text_field :value, label: t("dev_tools.value"), maxlength: 255 %>
    <p class="sm:col-span-2 text-xs text-muted"><%= t("dev_tools.command_hint") %><%= t("dev_tools.in_shadow") if Shadow.site?(@site) %>. <%= t("dev_tools.command_log") %></p>
    <div class="sm:col-span-2"><%= render Ss::ButtonComponent.new(label: t("dev_tools.run"), icon: icon("play", ""), type: :submit) %></div>
  <% end %>

<% elsif @tab == "estatisticas" %>
  <%= render "web/dev_tools/statistics" %>

<% else %>
  <div class="grid gap-4 lg:grid-cols-2">
    <%= ss_form_with url: dev_tools_event_site_path(@site), class: "ss-card ss-card-pad grid gap-3" do |f| %>
      <p class="font-bold text-ink"><%= t("dev_tools.fire_event") %></p>
      <%= f.ss_text_field :event, label: t("site_helpers.form.name"), class: "num", required: true, placeholder: t("dev_tools.event_ph"), maxlength: 60 %>
      <%= f.ss_text_area :data, value: "{}", label: t("dev_tools.data"), rows: 4, class: "ss-code-input min-h-0" %>
      <p class="text-xs text-muted"><%= t("dev_tools.event_hint") %></p>
      <div><%= render Ss::ButtonComponent.new(label: t("dev_tools.fire"), icon: icon("lightning-bolt", ""), type: :submit) %></div>
    <% end %>
    <section class="ss-card ss-card-pad" aria-label="<%= t("dev_tools.incoming") %>">
      <p class="font-bold text-ink"><%= t("dev_tools.listening") %></p>
      <p class="text-xs text-muted mb-2"><%= t("dev_tools.listening_hint") %></p>
      <%= turbo_stream_from DevTools.stream(@site.id) %>
      <ol id="dev-events" class="grid gap-2" aria-live="polite"></ol>
    </section>
  </div>
<% end %>
