<%= render "web/shared/header", title: "Ferramentas", subtitle: "#{@site.name} · estados, modelos, ações e eventos para montar e depurar automações. Só administradores.", back: site_path(@site) %>
<%= render "web/sites/tabs", site: @site, current: :dev_tools %>
<nav class="ss-chips mb-4" aria-label="Ferramentas">
  <% Web::DevToolsController::TABS.each do |key, label| %>
    <%= link_to label, dev_tools_site_path(@site, aba: key), class: "ss-chip no-underline", "aria-current": (key == @tab).to_s %>
  <% end %>
</nav>

<% if @tab == "estados" %>
  <%= form_with url: dev_tools_site_path(@site), method: :get, class: "mb-3 flex flex-wrap items-end gap-3", role: "search" do %>
    <%= hidden_field_tag :aba, "estados", id: nil %>
    <div class="min-w-48 flex-1"><label for="q" class="ss-label">Filtrar</label><%= search_field_tag :q, params[:q], class: "ss-input", placeholder: "Nome, chave ou valor" %></div>
    <div><label for="capacidade" class="ss-label">Tipo</label><%= select_tag :capacidade, options_for_select(Point::CAPABILITY_LABELS.invert.sort, params[:capacidade]), include_blank: "Todos", class: "ss-input" %></div>
    <button type="submit" class="ss-btn ss-btn-ghost" aria-label="Filtrar"><%= icon("search", "size-4") %></button>
  <% end %>
  <% if @states.empty? %>
    <div class="ss-card ss-empty"><p class="font-bold text-ink">Nenhum ponto com esse filtro.</p></div>
  <% else %>
    <ul class="ss-card ss-rows" aria-label="Estados">
      <% @states.each do |p| %>
        <li class="!items-start">
          <div class="min-w-0 flex-1">
            <p class="font-bold text-ink truncate"><%= link_to p.name, point_path(p), class: "text-ink no-underline hover:text-accent" %></p>
            <p class="text-xs text-muted truncate num"><%= p.key %> · <%= p.capability_label %><%= " · helper #{p.helper_type&.title}" if p.helper %></p>
            <% if p.attrs.present? %>
              <details class="mt-1"><summary class="text-xs text-accent cursor-pointer">Atributos (<%= p.attrs.size %>)</summary>
                <pre class="mt-1 text-xs bg-field rounded-lg p-2 overflow-x-auto max-w-full"><%= JSON.pretty_generate(p.attrs) %></pre></details>
            <% end %>
          </div>
          <div class="text-right shrink-0 max-w-[50%]">
            <p class="text-sm font-bold truncate <%= p.quality == 'good' ? 'text-ink' : 'text-warn' %>"><%= p.quality == "good" ? point_value_text(p) : "Sem sinal" %></p>
            <p class="text-xs text-muted num truncate"><%= p.value.to_json.truncate(40) %></p>
            <% if p.helper %>
              <%= form_with url: dev_tools_state_site_path(@site), class: "mt-1 flex items-center gap-1 justify-end" do %>
                <%= hidden_field_tag :point_id, p.id, id: nil %><%= hidden_field_tag :q, params[:q], id: nil %>
                <label for="v_<%= p.id %>" class="sr-only">Novo valor de <%= p.name %></label>
                <input id="v_<%= p.id %>" name="value" class="ss-input !py-1 w-32 text-sm" placeholder="Novo valor">
                <button class="ss-btn ss-btn-ghost ss-btn-sm" title="Definir valor" aria-label="Definir valor de <%= p.name %>"><%= icon("check", "size-4") %></button>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
    <p class="text-xs text-muted mt-2">Mostra até <%= DevTools::STATES_LIMIT %> pontos. Definir valor vale só para helper (aparelho só por comando, na aba Ação).</p>
  <% end %>

<% elsif @tab == "modelo" %>
  <div class="grid gap-4 lg:grid-cols-2">
    <%= form_with url: dev_tools_template_site_path(@site), class: "ss-card ss-card-pad grid gap-3", data: { controller: "live-form", turbo_frame: "dev-result", action: "input->live-form#queue change->live-form#queue" } do %>
      <div><label for="mode" class="ss-label">Tipo</label><%= select_tag :mode, options_for_select([ [ "Texto com Liquid", "liquid" ], [ "Expressão (condição, cálculo)", "expr" ] ]), class: "ss-input" %></div>
      <div><label for="template" class="ss-label">Modelo</label>
        <%= text_area_tag :template, @template, rows: 10, class: "ss-input num text-sm", spellcheck: false, maxlength: DevTools::MAX_TEMPLATE %></div>
      <p class="text-xs text-muted">Atualiza enquanto você digita. Ex.: <code>{{ points["sala.temperatura"].text }}</code>, <code>{{ count_points("capability=onoff value=true") }}</code> ou, em expressão, <code>hour >= 18</code>.</p>
    <% end %>
    <% result, error = DevTools.render(@site, @template) %>
    <%= render "web/dev_tools/result", result: result, error: error, mode: "liquid" %>
  </div>

<% elsif @tab == "acao" %>
  <%= form_with url: dev_tools_command_site_path(@site), class: "ss-card ss-card-pad grid gap-3 sm:grid-cols-2 max-w-3xl", data: { turbo_confirm: "Mandar este comando de verdade? Em local na sombra, aparelho não recebe nada.", turbo_confirm_title: "Executar ação" } do %>
    <div class="sm:col-span-2"><label for="point_id" class="ss-label">Ponto</label>
      <%= select_tag :point_id, options_for_select(@writable.map { |p| [ "#{p.name} · #{p.device.name} (#{Points::Command.commands_for(p).join(', ')})#{' · crítico' if p.risk == 'critical'}", p.id ] }), class: "ss-input", required: true %></div>
    <div><label for="command" class="ss-label">Comando</label><%= text_field_tag :command, nil, class: "ss-input num", required: true, placeholder: "on, off, set, select…", maxlength: 40 %></div>
    <div><label for="value" class="ss-label">Valor (opcional)</label><%= text_field_tag :value, nil, class: "ss-input", maxlength: 255 %></div>
    <p class="sm:col-span-2 text-xs text-muted">Passa pelo caminho normal: valida o comando, exige o papel do risco do ponto e respeita a sombra do local<%= " (este local está em sombra)" if Shadow.site?(@site) %>. Fica no histórico de comandos.</p>
    <div class="sm:col-span-2"><button type="submit" class="ss-btn ss-btn-primary"><%= icon("play", "size-4") %>Executar</button></div>
  <% end %>

<% else %>
  <div class="grid gap-4 lg:grid-cols-2">
    <%= form_with url: dev_tools_event_site_path(@site), class: "ss-card ss-card-pad grid gap-3" do %>
      <p class="font-bold text-ink">Disparar evento</p>
      <div><label for="event" class="ss-label">Nome</label><%= text_field_tag :event, nil, class: "ss-input num", required: true, placeholder: "meu_evento", maxlength: 60 %></div>
      <div><label for="data" class="ss-label">Dados (JSON, opcional)</label><%= text_area_tag :data, "{}", rows: 4, class: "ss-input num text-sm" %></div>
      <p class="text-xs text-muted">Dispara as automações com o gatilho "Evento" e retoma quem espera por ele. Nomes do sistema não valem.</p>
      <div><button type="submit" class="ss-btn ss-btn-primary"><%= icon("lightning-bolt", "size-4") %>Disparar</button></div>
    <% end %>
    <section class="ss-card ss-card-pad" aria-label="Eventos chegando">
      <p class="font-bold text-ink">Escutando eventos</p>
      <p class="text-xs text-muted mb-2">Cada evento do local aparece aqui na hora (com esta aba aberta).</p>
      <%= turbo_stream_from DevTools.stream(@site.id) %>
      <ol id="dev-events" class="grid gap-2" aria-live="polite"></ol>
    </section>
  </div>
<% end %>
