<% rows = DevTools::Statistics.list(@site) %>
<p class="text-sm text-muted mb-3 max-w-3xl"><%= t("dev_tools.stats.intro") %></p>
<% if rows.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("dev_tools.stats.none"), css: "ss-card") %>
<% else %>
  <ul class="ss-card ss-rows" aria-label="<%= t("dev_tools.tabs.estatisticas") %>">
    <% rows.each do |r| %>
      <li class="!items-start flex-wrap gap-3" data-stat="<%= r.point.id %>">
        <div class="min-w-0 flex-1">
          <p class="font-bold text-ink truncate"><%= link_to r.point.name, point_path(r.point), class: "text-ink no-underline hover:text-accent" %>
            <% if r.issue %><span class="ss-badge ss-badge-warn ml-1"><%= t("dev_tools.stats.issues.#{r.issue}") %></span><% end %></p>
          <p class="text-xs text-muted num truncate"><%= r.point.key %><%= " · #{r.point.unit}" if r.point.unit.present? %> · <%= t("dev_tools.stats.hours", n: r.hours) %> · <%= l(r.first_at, format: :short) %> → <%= l(r.last_at, format: :short) %></p>
        </div>
        <div class="flex flex-wrap items-end gap-2">
          <%= ss_form_with url: dev_tools_stats_adjust_site_path(@site), class: "flex flex-wrap items-end gap-1" do |f| %>
            <%= hidden_field_tag :point_id, r.point.id, id: nil %>
            <%= f.ss_datetime_local_field :at, id: "at_#{r.point.id}", label: t("dev_tools.stats.hour"), step: 3600, class: "!py-1 text-sm", required: true %>
            <%= f.ss_text_field :sum, id: "sum_#{r.point.id}", label: t("dev_tools.stats.sum"), inputmode: "decimal", class: "!py-1 w-24 text-sm", required: true %>
            <%= render Ss::ButtonComponent.new(label: t("dev_tools.stats.adjust"), icon: icon("check", ""), type: :submit, variant: :ghost, size: :sm,
                                               aria: { label: t("dev_tools.stats.adjust_of", name: r.point.name) }) %>
          <% end %>
          <%= render Ss::ButtonComponent.new(label: t("dev_tools.stats.purge"), icon: icon("trash", ""), href: dev_tools_stats_purge_site_path(@site, point_id: r.point.id),
                                             method: :delete, variant: :ghost, size: :sm, tone: :danger,
                                             confirm: t("dev_tools.stats.confirm", name: r.point.name), confirm_tone: :danger, confirm_button: t("dev_tools.stats.purge")) %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
