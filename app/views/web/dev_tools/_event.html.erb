<%# locals: (name:, payload:, at:) -%>
<li class="rounded-xl p-2 ring-1 ring-inset ring-line">
  <p class="text-sm font-bold text-ink num"><%= name %> <span class="font-normal text-xs text-muted"><%= l(at, format: "%H:%M:%S") %></span></p>
  <%= render Ss::CodeBlockComponent.new(text: JSON.pretty_generate(payload.to_h.except("event")).truncate(1500), copy: false, class: "mt-1") %>
</li>
