<% site_names = @sites.to_h { |s| [ s.id, s.name ] } %>
<%= render "web/shared/header", title: t("api_keys.title"), subtitle: t("api_keys.subtitle") %>
<%= render layout: "web/settings/frame", locals: { current: :api_keys } do %>
<% if @plain %>
  <section class="ss-card ss-card-grad p-4 mb-4" role="status" aria-labelledby="nova-chave-t">
    <h2 id="nova-chave-t" class="flex items-center gap-2"><%= icon("link", "size-4") %><%= t("api_keys.created", name: @created.name) %></h2>
    <p class="text-sm text-muted mt-1"><%= t("api_keys.copy_now") %></p>
    <div class="mt-3 flex gap-2" data-controller="clipboard">
      <label for="plain-key" class="sr-only"><%= t("api_keys.key") %></label>
      <input id="plain-key" class="ss-input num" value="<%= @plain %>" readonly data-clipboard-target="source">
      <button type="button" class="ss-btn ss-btn-primary" data-action="clipboard#copy"><%= icon("duplicate", "size-4") %><%= t("api_keys.copy") %></button>
    </div>
  </section>
<% end %>

<% if @keys.empty? %>
  <div class="ss-card ss-empty"><p class="font-bold text-ink"><%= t("api_keys.empty") %></p><p class="mt-1"><%= t("api_keys.empty_hint") %></p></div>
<% else %>
  <section class="ss-card overflow-x-auto" aria-label="<%= t("api_keys.active") %>">
    <table class="ss-table">
      <thead><tr><th><%= t("api_keys.key") %></th><th class="hidden md:table-cell"><%= t("api_keys.sites") %></th><th class="hidden sm:table-cell"><%= t("api_keys.scopes_label") %></th><th class="hidden lg:table-cell"><%= t("api_keys.validity_label") %></th><th class="hidden md:table-cell"><%= t("api_keys.last_used") %></th><th class="r"><span class="sr-only"><%= t("api_keys.revoke") %></span></th></tr></thead>
      <tbody>
        <% @keys.each do |k| %>
          <tr>
            <td><span class="block font-semibold text-ink"><%= k.name %></span><span class="block text-xs text-muted"><%= t("api_keys.created_on", date: l(k.created_at.to_date)) %><%= " · #{t("api_keys.expired")}" if k.expired? %></span></td>
            <td class="hidden md:table-cell"><%= k.site_ids.filter_map { |id| site_names[id] }.to_sentence %></td>
            <td class="hidden sm:table-cell"><div class="flex flex-wrap gap-1"><% k.scopes.each do |s| %><span class="ss-badge"><%= t(s, scope: "api_keys.scopes") %></span><% end %></div></td>
            <td class="hidden lg:table-cell"><%= k.expires_at ? l(k.expires_at.to_date) : t("api_keys.validity.none") %></td>
            <td class="hidden md:table-cell"><%= k.last_used_at ? ago_text(k.last_used_at) : t("api_keys.never") %></td>
            <td class="r"><%= button_to t("api_keys.revoke"), api_key_path(k), method: :delete, class: "ss-btn ss-btn-ghost ss-btn-sm text-danger", form: { data: { turbo_confirm: t("api_keys.revoke_confirm", name: k.name), turbo_confirm_button: t("api_keys.revoke") } } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="criar-t">
  <h2 id="criar-t"><%= t("api_keys.new") %></h2>
  <%= form_with scope: :api_key, url: api_keys_path, class: "mt-3 grid gap-4 md:grid-cols-2", data: { turbo: false } do |f| %>
    <div><%= f.label :name, t("integrations.forms.common.name"), class: "ss-label" %><%= f.text_field :name, class: "ss-input", required: true, maxlength: 60, placeholder: t("api_keys.name_hint") %></div>
    <div><%= f.label :validity, t("api_keys.validity_label"), class: "ss-label" %><%= f.select :validity, Web::ApiKeysController::VALIDITY.map { |d| [ t(d.presence || "none", scope: "api_keys.validity"), d ] }, { selected: "365" }, class: "ss-input" %></div>
    <fieldset><legend class="ss-label"><%= t("api_keys.allowed_sites") %></legend>
      <div class="flex flex-wrap gap-3">
        <% @sites.each do |s| %><label class="ss-check"><%= check_box_tag "api_key[site_ids][]", s.id, @sites.one?, id: "ak-site-#{s.id}" %><%= s.name %></label><% end %>
      </div></fieldset>
    <fieldset><legend class="ss-label"><%= t("api_keys.scopes_label") %></legend>
      <div class="flex flex-wrap gap-3">
        <% ServiceApiKey::KNOWN_SCOPES.each do |key| %><label class="ss-check"><%= check_box_tag "api_key[scopes][]", key, key == "read", id: "ak-scope-#{key}" %><%= t(key, scope: "api_keys.scopes") %></label><% end %>
      </div></fieldset>
    <p class="md:col-span-2 text-sm text-muted"><%= t("api_keys.scopes_help_html") %></p>
    <div class="md:col-span-2"><%= f.submit t("api_keys.create"), class: "ss-btn ss-btn-primary" %></div>
  <% end %>
</section>
<% end %>
