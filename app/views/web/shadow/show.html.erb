<%= render "web/shared/header", title: t("automations.tabs.shadow"), subtitle: t("automations.shadow_page.subtitle", site: @site.name), back: site_automations_path(@site) %>
<%= render "web/automations/tabs", site: @site, current: :shadow %>

<section class="ss-card ss-card-pad mb-4 grid gap-3 sm:grid-cols-[1fr_auto] sm:items-center" aria-labelledby="shadow-state">
  <div class="min-w-0">
    <h2 id="shadow-state" class="flex items-center gap-2"><%= icon("moon", "size-5 text-accent") %><%= @site_shadow ? t("automations.shadow_page.site_on") : t("automations.shadow_page.per_automation") %></h2>
    <p class="text-sm text-ink-2 mt-1">
      <% if @site_shadow %>
        <%= t("automations.shadow_page.site_hint") %>
      <% else %>
        <%= t("automations.shadow_page.per_hint") %>
      <% end %>
    </p>
    <p class="text-sm mt-2"><span class="ss-badge ss-badge-accent"><%= t("automations.shadow_page.in_shadow", count: @in_shadow) %></span>
      <span class="ss-badge <%= 'ss-badge-warn' if @live.positive? %>"><%= t("automations.shadow_page.live", count: @live) %></span></p>
  </div>
  <% if can?(:admin) %>
    <%= render Ss::ButtonComponent.new(label: @site.shadow ? t("automations.shadow_page.turn_off") : t("automations.shadow_page.turn_on"), icon: icon("moon", ""),
                                       href: site_shadow_path(@site), method: :patch, params: { shadow: !@site.shadow }, variant: @site.shadow ? :outline : :primary,
                                       confirm: (@site.shadow ? t("automations.shadow_page.off_confirm") : t("automations.shadow_page.on_confirm")), confirm_button: t("automations.shadow_page.confirm")) %>
  <% end %>
</section>

<div class="grid gap-6 lg:grid-cols-3 items-start">
  <div class="lg:col-span-2 min-w-0">
    <h2 class="mb-2"><%= t("automations.shadow_page.would") %></h2>
    <%= ss_form_with url: site_shadow_path(@site), method: :get, class: "mb-3 grid gap-3 grid-cols-2 sm:flex sm:flex-wrap sm:items-end", role: "search" do |f| %>
      <%= f.ss_select :automacao, @origins, label: t("automations.shadow_page.origin"), include_blank: t("automations.index.all_f"), selected: params[:automacao], data: { autosubmit: true }, wrapper_class: "col-span-2 min-w-0 sm:min-w-48 sm:flex-1" %>
      <%= f.ss_select :tipo, @types.map { |ty| [ shadow_action_label(ty), ty ] }, label: t("automations.shadow_page.action_type"), include_blank: t("automations.index.all_m"), selected: params[:tipo], data: { autosubmit: true } %>
      <%= f.ss_select :horas, Web::ShadowController::WINDOWS.invert, label: t("automations.shadow_page.period"), selected: @hours, data: { autosubmit: true } %>
      <%= render Ss::ButtonComponent.new(icon: icon("filter", ""), type: :submit, variant: :ghost, class: "hidden sm:inline-flex", aria: { label: t("automations.shadow_page.filter") }) %>
    <% end %>

    <% if @actions.empty? %>
      <%= render Ss::EmptyStateComponent.new(title: t("automations.shadow_page.empty"), text: t("automations.shadow_page.empty_hint"), css: "ss-card") %>
    <% else %>
      <ol class="ss-card ss-rows" aria-label="<%= t("automations.shadow_page.timeline") %>">
        <% @actions.each do |a| %>
          <li id="shadow-<%= a.id %>">
            <span class="ss-icon-tile <%= a.executed ? 'is-muted' : 'is-grad' %>"><%= icon(a.executed ? "check-circle" : "moon") %></span>
            <div class="min-w-0 flex-1 basis-48">
              <p class="font-bold text-ink break-words"><%= a.executed ? t("automations.shadow_page.did") : t("automations.shadow_page.would_have") %> <%= a.title %></p>
              <p class="text-sm text-muted break-words">
                <% if a.automation %><%= link_to a.origin_name, automation_automation_runs_path(a.automation) %><% else %><%= a.origin_name %><% end %>
                · <%= a.origin_kind.downcase %> · <%= shadow_action_label(a.action).downcase %></p>
              <% if a.detail.present? %><p class="text-xs text-muted break-words"><%= a.detail %></p><% end %>
            </div>
            <time class="text-sm text-muted num whitespace-nowrap" datetime="<%= a.created_at.iso8601 %>"><%= l(a.created_at.in_time_zone(@site.timezone), format: "%d/%m %H:%M:%S") %></time>
          </li>
        <% end %>
      </ol>
      <%= render "web/shared/pagination", pagy: @pagy %>
    <% end %>
  </div>

  <aside class="grid gap-4 min-w-0">
    <section class="ss-card ss-card-pad" aria-labelledby="shadow-compare">
      <h2 id="shadow-compare"><%= t("automations.shadow_page.compare") %></h2>
      <% if @sources.empty? %><p class="text-sm text-muted mt-1"><%= t("automations.shadow_page.no_sources") %></p><% end %>
      <% @sources.each do |plugin, integration| %>
        <% if integration %>
          <%= ss_form_with url: compare_site_shadow_path(@site), class: "grid gap-2 mt-2" do |f| %>
            <%= hidden_field_tag :fonte, plugin.key, id: nil %>
            <%= f.ss_select :horas, Web::ShadowController::WINDOWS.invert, label: t("automations.shadow_page.window", name: plugin.title), selected: "24", id: "horas-#{plugin.key}" %>
            <% if can?(:manage) %><%= render Ss::ButtonComponent.new(label: t("automations.shadow_page.compare_now"), icon: icon("refresh", ""), type: :submit) %><% end %>
          <% end %>
        <% else %>
          <p class="text-sm text-muted mt-1"><%= t("automations.shadow_page.connect_html", name: plugin.title, link: link_to(t("automations.shadow_page.integrations"), site_integrations_path(@site))) %></p>
        <% end %>
      <% end %>
      <% if @reports.any? %>
        <ul class="mt-3 grid gap-2 text-sm" aria-label="<%= t("automations.shadow_page.comparisons") %>">
          <% @reports.each do |r| %>
            <li><%= link_to report_site_shadow_path(@site, r.id), class: "flex flex-wrap gap-x-2 no-underline" do %>
                <span class="num text-ink"><%= l(r.created_at.in_time_zone(@site.timezone), format: "%d/%m %H:%M") %></span>
                <span class="text-muted"><%= ((r.window_to - r.window_from) / 3600).round %> h · <%= shadow_summary(r) %></span>
              <% end %></li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="ss-card ss-card-pad" aria-labelledby="shadow-map">
      <h2 id="shadow-map"><%= t("automations.shadow_page.mapping") %></h2>
      <% if @refs.empty? %>
        <p class="text-sm text-muted mt-1"><%= t("automations.shadow_page.no_migration") %></p>
      <% else %>
        <%= render Ss::DataTableComponent.new(rows: @refs.sort, id: "sombra-de-para", caption: t("automations.shadow_page.mapping"), tools: false, flat: true, empty_art: false, max_height: "none", css: "mt-2 text-sm") do |tb| %>
          <% tb.column :source, t("automations.shadow_page.map_source") do |(key, _n)| %><%= key[0] %><% end %>
          <% tb.column :kind, t("automations.shadow_page.map_kind") do |(key, _n)| %><%= key[1] %><% end %>
          <% tb.column :count, t("automations.shadow_page.map_count"), align: :right do |(_key, n)| %><span class="num"><%= n %></span><% end %>
        <% end %>
        <% if @unmapped.any? %>
          <details class="mt-2 text-sm"><summary class="ss-summary"><%= t("automations.shadow_page.unmapped", count: @unmapped.size) %></summary>
            <ul class="mt-1 grid gap-1"><% @unmapped.each do |r| %><li class="break-words"><code class="ss-code-inline"><%= r.external_id %></code> <span class="text-muted"><%= r.note %></span></li><% end %></ul>
          </details>
        <% end %>
      <% end %>
    </section>
  </aside>
</div>
