<%= render "web/shared/header", title: t("automations.index.title"), subtitle: t("automations.scripts_page.subtitle", site: @site.name) do %>
  <% if can?(:manage) %><%= link_to new_site_script_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("automations.new.script") %><% end %><% end %>
<% end %>
<%= render "web/automations/tabs", site: @site, current: :scripts %>

<% if @total.zero? %>
  <%= render Ss::EmptyStateComponent.new(title: t("automations.scripts_page.empty"), text: t("automations.scripts_page.empty_hint"), css: "ss-card") do %>
    <% if can?(:manage) %><%= link_to new_site_script_path(@site), class: "ss-btn ss-btn-primary" do %><%= icon("plus", "size-4") %><%= t("automations.scripts_page.create_first") %><% end %><% end %>
  <% end %>
<% else %>
  <%= ss_form_with url: site_scripts_path(@site), method: :get, class: "mb-3 flex flex-wrap items-end gap-3", role: "search" do |f| %>
    <%= f.ss_search_field :q, label: t("automations.common.search"), value: params[:q], placeholder: t("automations.scripts_page.search_placeholder"), wrapper_class: "min-w-48 flex-1" %>
    <% if @labels.any? %><%= f.ss_select :rotulo, @labels, label: t("automations.index.label"), selected: params[:rotulo], include_blank: t("automations.index.all_m"), data: { autosubmit: true } %><% end %>
    <%= render Ss::IconButtonComponent.new(icon: icon("search", ""), label: t("automations.common.search"), type: :submit) %>
  <% end %>
  <% if @scripts.empty? %>
    <%= render Ss::EmptyStateComponent.new(title: t("automations.scripts_page.no_match"), variant: :busca, css: "ss-card") do %><%= link_to t("automations.scripts_page.clear"), site_scripts_path(@site), class: "ss-btn ss-btn-ghost" %><% end %>
  <% else %>
    <% groups = category_groups(@scripts) %>
    <% groups.each do |category, items| %>
    <%= render layout: "web/shared/category_group", locals: { name: category, count: items.size, grouped: groups.size > 1 || category } do %>
    <ul class="ss-card ss-rows" aria-label="Scripts<%= " · #{category}" if category %>">
      <% items.each do |s| %>
        <li id="script-<%= s.id %>">
          <span class="ss-icon-tile is-accent"><%= icon(s.icon.presence_in(HelperTypes::ICONS) || "play") %></span>
          <div class="min-w-0 flex-1 basis-48">
            <p class="font-bold text-ink break-words"><%= link_to s.name, (can?(:manage) ? edit_automation_path(s) : automation_automation_runs_path(s)), class: "text-ink no-underline hover:text-accent" %>
              <% unless s.published? %> <span class="ss-badge ss-badge-warn"><%= t("automations.index.draft") %></span><% end %>
              <% if s.draft? && s.published? %> <span class="ss-badge"><%= t("automations.index.draft_changes") %></span><% end %></p>
            <p class="text-sm text-muted break-words"><%= [ s.area&.name, t("automations.scripts_page.fields", count: s.fields.size), s.mode_label.split(" (").first ].compact.join(" · ") %> <%= label_chips(s) %></p>
            <p class="text-xs text-muted"><%= t("automations.index.last_run", text: last_run_text(s).downcase) %></p>
            <% if s.last_error.present? %><p class="text-sm text-danger mt-1 flex gap-1"><%= icon("exclamation-circle", "size-4 shrink-0 mt-0.5") %><span><%= s.last_error %></span></p><% end %>
          </div>
          <div class="flex w-full flex-wrap items-center justify-end gap-2 sm:w-auto">
            <%= link_to automation_automation_runs_path(s), class: "ss-btn ss-btn-ghost ss-btn-sm" do %><%= icon("view-list", "size-4") %><%= t("automations.common.runs") %><% end %>
            <% if s.published? && can?(:command, risk: s.max_risk(s.definition)) %>
              <% if s.fields.any? %>
                <%= link_to run_automation_path(s), class: "ss-btn ss-btn-primary ss-btn-sm" do %><%= icon("play", "size-4") %><%= t("automations.edit.run") %><% end %>
              <% else %>
                <%= render Ss::ButtonComponent.new(label: t("automations.edit.run"), icon: icon("play", "size-4"), href: run_automation_path(s), method: :post, size: :sm,
                                                   params: { back: request.fullpath, confirm_critical: ("1" if s.max_risk(s.definition) == "critical") }.compact, form: { class: "contents" },
                                                   confirm: t("automations.run_form.confirm", name: s.name), confirm_button: t("automations.edit.run")) %>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
    <% end %>
    <% end %>
  <% end %>
<% end %>
