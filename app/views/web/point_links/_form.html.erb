<%# locals: (site:, record:) -%>
<%= form_with model: record.new_record? ? [ site, record ] : record, class: "ss-card ss-card-pad grid gap-4 md:grid-cols-2 max-w-3xl" do |f| %>
  <%= render "web/shared/errors", record: record %>
  <%= hidden_field_tag :back, params[:back], id: nil %>
  <div><%= f.label :source_point_id, t("point_links.form.source"), class: "ss-label" %><%= f.select :source_point_id, point_choices(site), { include_blank: t("shared.choose") }, class: "ss-input", required: true %></div>
  <div><%= f.label :target_point_id, t("point_links.form.target"), class: "ss-label" %><%= f.select :target_point_id, point_choices(site, writable: true), { include_blank: t("shared.choose") }, class: "ss-input", required: true %></div>
  <div><%= f.label :mode, t("point_links.form.mode"), class: "ss-label" %><%= f.select :mode, PointLink::MODES.invert, {}, class: "ss-input" %>
    <p class="text-xs text-muted mt-1"><%= t("point_links.form.mode_hint") %></p></div>
  <div><%= f.label :trigger_value, t("point_links.form.trigger_value"), class: "ss-label" %><%= f.text_field :trigger_value, value: record.trigger_value, class: "ss-input", placeholder: t("point_links.form.trigger_value_hint") %></div>
  <label class="ss-check"><%= f.check_box :bidirectional %> <%= t("point_links.form.bidirectional") %></label>
  <label class="ss-check"><%= f.check_box :enabled %> <%= t("point_links.form.enabled") %></label>
  <div class="md:col-span-2 flex flex-wrap gap-2">
    <%= f.submit t("point_links.form.save"), class: "ss-btn ss-btn-primary" %>
    <%= link_to t("shared.cancel"), back_path, class: "ss-btn ss-btn-ghost" %>
  </div>
<% end %>
