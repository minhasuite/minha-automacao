<%# locals: (site:, record:) -%>
<%= ss_form_with model: record.new_record? ? [ site, record ] : record, class: "ss-card ss-card-pad grid gap-4 md:grid-cols-2 max-w-3xl" do |f| %>
  <%= render "web/shared/errors", record: record %>
  <%= hidden_field_tag :back, params[:back], id: nil %>
  <%= f.ss_select :source_point_id, point_choices(site), label: t("point_links.form.source"), include_blank: t("shared.choose"), required: true %>
  <%= f.ss_select :target_point_id, point_choices(site, writable: true), label: t("point_links.form.target"), include_blank: t("shared.choose"), required: true %>
  <%= f.ss_select :mode, PointLink::MODES.invert, label: t("point_links.form.mode"), help: t("point_links.form.mode_hint") %>
  <%= f.ss_text_field :trigger_value, label: t("point_links.form.trigger_value"), value: record.trigger_value, placeholder: t("point_links.form.trigger_value_hint") %>
  <%= f.ss_check_box :bidirectional, label: t("point_links.form.bidirectional") %>
  <%= f.ss_check_box :enabled, label: t("point_links.form.enabled") %>
  <div class="md:col-span-2 flex flex-wrap gap-2">
    <%= f.ss_submit t("point_links.form.save") %>
    <%= render Ss::ButtonComponent.new(label: t("shared.cancel"), href: back_path, variant: :ghost) %>
  </div>
<% end %>
