<%# locals: (site:, adapter:, bridge:, joins:) -%>
  <section class="ss-card ss-card-pad grid gap-3" aria-labelledby="pairing-state" role="status" aria-live="polite">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="min-w-0">
        <h2 id="pairing-state" class="font-bold text-ink"><%= bridge.open? ? t("pairing.state_open") : t("pairing.state_closed") %></h2>
        <p class="text-sm text-muted">
          <% if bridge.open? %>
            <%= t("pairing.left", time: format("%d:%02d", bridge.seconds_left / 60, bridge.seconds_left % 60)) %><% if bridge.info["via"].present? %> · <%= t("pairing.via_now", name: bridge.info["via"]) %><% end %>
          <% else %>
            <%= t("pairing.closed_hint") %>
          <% end %>
        </p>
      </div>
      <% if bridge.open? %>
        <div class="flex flex-wrap gap-2">
          <%= button_to t("pairing.renew_short"), site_pairing_open_path(site, adapter.key), params: { via: bridge.info["via"] }.compact, class: "ss-btn ss-btn-outline ss-btn-sm" %>
          <%= button_to t("pairing.close"), site_pairing_close_path(site, adapter.key), class: "ss-btn ss-btn-ghost ss-btn-sm" %>
        </div>
      <% end %>
    </div>
    <% if bridge.open? %>
      <%= render Ss::ScanRadarComponent.new(state: :searching, compact: true, icon: icon("status-online", ""), labels: { searching: t("pairing.searching") }) %>
    <% end %>
    <% if bridge.state == "offline" %>
      <%= render(Ss::NoteComponent.new(tone: :warn)) { t("pairing.bridge_offline") } %>
    <% end %>
    <% if bridge.info["error"].present? %>
      <%= render(Ss::NoteComponent.new(tone: :danger)) { t("pairing.bridge_error", error: bridge.info["error"]) } %>
    <% end %>
  </section>

  <section class="ss-card ss-card-pad mt-4" aria-labelledby="pairing-joins">
    <%= render Ss::CardHeaderComponent.new(title: t("pairing.joins_title"), subtitle: t("pairing.joins_hint"), icon: icon("chip", ""), heading: :h2) %>
    <% if joins.empty? %>
      <%= render(Ss::NoteComponent.new(css: "mt-3")) { t("pairing.joins_empty") } %>
    <% else %>
      <ul class="mt-3 grid gap-2">
        <% joins.each do |j| %>
          <% mesh = j.device ? Pairing.mesh(j.device) : {} %>
          <li class="ss-item flex flex-wrap items-center gap-3">
            <span class="ss-icon-tile text-accent"><%= icon(j.battery? ? "battery" : "chip", "") %></span>
            <div class="min-w-0 flex-1 basis-56">
              <p class="font-semibold text-ink truncate"><%= j.device&.name || j.name || j.external_id %></p>
              <p class="text-xs text-muted"><%= [ j.manufacturer, j.model, j.description ].compact_blank.uniq.join(" · ").presence || j.external_id %></p>
              <p class="text-xs text-muted">
                <%= t("pairing.joined_ago", ago: time_ago_in_words(j.joined_at)) %>
                <% if mesh["lqi"] %> · <%= t("pairing.lqi", n: mesh["lqi"]) %><% end %>
                <% if j.power_source.present? %> · <%= j.battery? ? t("pairing.power.battery") : t("pairing.power.mains") %><% end %>
              </p>
              <% if j.status == "failed" %><p class="text-sm text-danger mt-1"><%= t("pairing.failed_hint") %></p><% end %>
              <% if j.supported == false && j.status == "successful" %><p class="text-sm text-warn mt-1"><%= t("pairing.unsupported_hint") %></p><% end %>
            </div>
            <% if j.resolved? %>
              <span class="ss-badge ss-badge-success"><%= t("pairing.resolutions.#{j.resolution}", name: j.details["replaced_device_name"]) %></span>
            <% elsif j.ready? %>
              <%= link_to site_pairing_join_path(site, adapter.key, j), class: "ss-btn ss-btn-primary ss-btn-sm" do %><%= t("pairing.next") %><% end %>
            <% else %>
              <span class="ss-badge ss-badge-<%= { "failed" => "danger", "left" => "muted", "successful" => "accent" }.fetch(j.status, "accent") %>"><%= t("pairing.statuses.#{j.status}") %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
