<%= render "web/shared/header", title: t("automations.notifications.title"), subtitle: t("automations.notifications.subtitle") do %>
  <%= link_to digest_notifications_path, class: "ss-btn ss-btn-ghost" do %><%= icon("calendar", "size-4") %><%= t("notifications.digest.open") %><% end %>
  <%= link_to settings_notifications_path, class: "ss-btn ss-btn-ghost" do %><%= icon("adjustments", "size-4") %><%= t("notifications.settings.open") %><% end %>
  <%= render Ss::ButtonComponent.new(label: t(@filters.any? ? "notifications.filters.read_these" : "automations.notifications.read_all"), icon: icon("check", ""), href: read_all_notifications_path(@filters), method: :patch, variant: :ghost) %>
<% end %>
<%= ss_form_with url: notifications_path, method: :get, class: "ss-card ss-card-pad mb-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 items-end",
                 data: { controller: "ss-autosubmit", action: "change->ss-autosubmit#now", turbo_action: "replace" } do |f| %>
  <%= f.ss_select :kind, @choices[:kinds].map(&:reverse), selected: @filters[:kind], include_blank: t("notifications.filters.all"), label: t("notifications.filters.kind") %>
  <% if @choices[:areas].any? %>
    <%= f.ss_select :area_id, @choices[:areas].map(&:reverse), selected: @filters[:area_id], include_blank: t("notifications.filters.all"), label: t("notifications.filters.area") %>
  <% end %>
  <%= f.ss_select :level, @choices[:levels].map(&:reverse), selected: @filters[:level], include_blank: t("notifications.filters.all"), label: t("notifications.level.label") %>
  <%= f.ss_check_box :unread, label: t("notifications.filters.unread"), unchecked_value: nil, checked: @filters[:unread].present? %>
  <noscript><%= f.ss_submit t("notifications.filters.apply"), variant: :outline, name: nil %></noscript>
<% end %>
<% if @mutes.any? %>
  <section class="ss-card ss-card-pad mb-4" aria-labelledby="silencios-t">
    <h2 id="silencios-t" class="flex items-center gap-2"><%= icon("volume-off", "size-4") %><%= t("notifications.mute.active") %></h2>
    <ul class="mt-2 grid gap-2">
      <% @mutes.each do |m| %>
        <li class="flex flex-wrap items-center justify-between gap-2">
          <span class="min-w-0"><span class="font-semibold"><%= m["label"] %></span> <span class="text-sm text-muted"><%= t("notifications.mute.until", time: l(m["until"].in_time_zone(Notifications.zone(current_user.tenant)), format: :short)) %></span></span>
          <%= render Ss::ButtonComponent.new(label: t("notifications.mute.undo"), icon: icon("bell", ""), href: unmute_notifications_path(key: m["key"]), method: :delete, variant: :ghost, size: :sm) %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
<% if @notifications.any? %>
  <div class="ss-card divide-y divide-line overflow-hidden">
    <% @notifications.each do |n| %>
      <% ico, tone = ApplicationHelper::NOTIFICATION_KINDS.fetch(n.kind, [ "bell", "is-muted" ]) %>
      <div id="<%= dom_id(n) %>" class="<%= 'opacity-70' if n.read_at && !n.actionable? %>">
        <%= render(Ss::ButtonComponent.new(href: read_notification_path(n), method: :patch, variant: :bare, class: "w-full text-left px-4 py-3.5 hover:bg-field flex items-start gap-3", form: { class: "block" })) do %>
          <span class="ss-icon-tile <%= n.critical? ? 'is-danger' : tone %>"><%= icon(ico, "") %></span>
          <span class="min-w-0 flex-1">
            <span class="flex items-start justify-between gap-3"><span class="<%= n.read_at ? 'font-semibold' : 'font-bold' %> text-ink break-words min-w-0"><%= with_money(n.title) %></span>
              <span class="shrink-0 text-xs text-muted flex items-center gap-1.5 mt-0.5"><%= ma_when(n.created_at) %><% unless n.read_at %><span class="size-2 rounded-full bg-accent" aria-label="<%= t("automations.notifications.unread") %>"></span><% end %></span></span>
            <% if n.body.present? %><span class="block text-sm text-muted mt-0.5 break-words"><%= with_money(n.body) %></span><% end %>
            <% if n.level != "normal" || n.count > 1 %>
              <span class="flex flex-wrap gap-1.5 mt-1.5">
                <% if n.level != "normal" %><span class="ss-badge <%= n.critical? ? 'ss-badge-danger' : 'ss-badge-warning' %>"><%= t("notifications.level.#{n.level}") %></span><% end %>
                <% if n.count > 1 %><span class="ss-badge"><%= t("notifications.merge.count", count: n.count) %></span><% end %>
              </span>
            <% end %>
          </span>
        <% end %>
        <% if n.image_url || n.actions.any? || n.open_url || n.mute_key %>
          <div class="px-4 pb-3.5 pl-[4.25rem] grid gap-2 min-w-0">
            <% if n.image_url %><img src="<%= n.image_url %>" alt="<%= t("automations.notifications.image") %>" loading="lazy" class="rounded-xl max-h-56 w-auto max-w-full border border-line"><% end %>
            <div class="flex flex-wrap items-center gap-2">
              <% if n.actionable? %>
                <% n.actions.each do |a| %>
                  <%= render Ss::ButtonComponent.new(label: a["title"], href: respond_notification_path(n), method: :patch, params: { action_id: a["id"] }, variant: :outline, size: :sm, form: { class: "contents" }) %>
                <% end %>
              <% elsif n.response %>
                <span class="ss-badge ss-badge-success"><%= icon("check", "size-3.5") %><%= t("automations.notifications.answered", title: n.response_title, user: n.response["user"]) %></span>
              <% end %>
              <% if n.open_url %>
                <%= link_to n.open_url, class: "ss-btn ss-btn-ghost ss-btn-sm", **(n.open_url.start_with?("/") ? {} : { target: "_blank", rel: "noopener" }) do %><%= icon("external-link", "size-4") %><%= t("automations.notifications.open") %><% end %>
              <% end %>
              <% if n.mute_key %>
                <details class="ss-menu">
                  <summary class="ss-menu-btn" aria-label="<%= t("notifications.mute.of", name: n.mute_label) %>"><%= icon("volume-off", "size-4") %><span><%= t("notifications.mute.button") %></span></summary>
                  <div class="min-w-48">
                    <% Notifications::MUTE_HOURS.each do |h| %>
                      <%= render Ss::ButtonComponent.new(label: t("notifications.mute.for", count: h), icon: icon("clock", ""), href: mute_notification_path(n, hours: h), method: :patch, variant: :item) %>
                    <% end %>
                  </div>
                </details>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <%= render "web/shared/pagination", pagy: @pagy %>
<% elsif @filters.any? %>
  <%= render Ss::EmptyStateComponent.new(title: t("notifications.filters.empty"), text: t("notifications.filters.empty_hint"), css: "ss-card") do %><%= link_to notifications_path, class: "ss-btn ss-btn-ghost" do %><%= icon("filter", "size-4") %><%= t("notifications.filters.clear") %><% end %><% end %>
<% else %>
  <%= render Ss::EmptyStateComponent.new(title: t("automations.notifications.empty"), text: t("automations.notifications.empty_hint"), css: "ss-card") do %><%= link_to push_subscriptions_path, class: "ss-btn ss-btn-ghost" do %><%= icon("bell", "size-4") %><%= t("automations.notifications.my_devices") %><% end %><% end %>
<% end %>
