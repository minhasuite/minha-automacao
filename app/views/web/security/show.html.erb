<%= render "web/shared/header", title: t("settings.title"), subtitle: t("security.subtitle") %>
<%= render layout: "web/settings/frame", locals: { current: :security } do %>
<% on = Mfa::Totp.enabled?(@user) %>
<% if @codes %>
  <section class="ss-card ss-card-pad border-2 border-accent" aria-labelledby="codes-t" data-security="codes">
    <h2 id="codes-t" class="flex items-center gap-2"><%= icon("lock-closed", "size-5 text-accent") %><%= t("security.recovery.title") %></h2>
    <p class="text-sm text-muted mt-1"><%= t("security.recovery.save") %></p>
    <ul class="mt-3 grid grid-cols-2 sm:grid-cols-5 gap-2 num text-sm font-bold">
      <% @codes.each do |c| %><li class="ss-code-inline block py-1.5 text-center"><%= c %></li><% end %>
    </ul>
    <div class="mt-3" data-controller="ss-copy" data-ss-copy-text-value="<%= @codes.join("\n") %>" data-ss-copy-done-value="<%= ss_t("code_block.copied") %>">
      <%= render(Ss::ButtonComponent.new(icon: icon("duplicate", ""), variant: :ghost, size: :sm, data: { action: "ss-copy#copy", ss_copy_target: "button" })) do %><span data-ss-copy-target="label"><%= t("security.recovery.copy") %></span><% end %>
    </div>
  </section>
<% end %>

<section class="ss-card ss-card-pad <%= "mt-4" if @codes %>" aria-labelledby="totp-t" data-security="totp">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 id="totp-t" class="flex items-center gap-2"><%= icon("device-mobile", "size-5 text-accent") %><%= t("security.totp.title") %></h2>
    <span class="ss-badge <%= on ? "ss-badge-success" : "ss-badge-muted" %>"><%= on ? t("security.on") : t("security.off") %></span>
  </div>
  <p class="text-sm text-muted mt-1"><%= t("security.totp.pitch") %></p>
  <% if on %>
    <p class="text-sm text-ink mt-3"><%= t("security.recovery.left", count: Array(@user.otp_recovery).size) %></p>
    <div class="mt-3 flex flex-wrap items-end gap-3">
      <%= render Ss::ButtonComponent.new(label: t("security.recovery.renew"), href: settings_security_recovery_path, method: :post, variant: :outline, confirm: t("security.recovery.renew_confirm")) %>
      <%= ss_form_with url: settings_security_totp_path, method: :delete, class: "flex flex-wrap items-end gap-2" do |f| %>
        <%= f.ss_text_field :code, label: t("security.totp.code"), id: "off-code", class: "num w-36", inputmode: "numeric", autocomplete: "one-time-code", required: true %>
        <%= render Ss::ButtonComponent.new(label: t("security.totp.disable"), type: :submit, variant: :danger) %>
      <% end %>
    </div>
  <% else %>
    <div class="mt-3 grid gap-4 sm:grid-cols-[12rem_1fr] items-start">
      <div class="ss-qr-box w-48 max-w-full" role="img" aria-label="<%= t("security.totp.qr") %>"><%= qr_svg(Mfa::Totp.uri(@secret, @user.email)) %></div>
      <div class="min-w-0">
        <ol class="text-sm text-ink list-decimal pl-5 space-y-1">
          <li><%= t("security.totp.step1") %></li>
          <li><%= t("security.totp.step2") %> <code class="ss-code-inline num"><%= @secret.scan(/.{1,4}/).join(" ") %></code></li>
          <li><%= t("security.totp.step3") %></li>
        </ol>
        <%= ss_form_with url: settings_security_totp_path, class: "mt-3 flex flex-wrap items-end gap-2" do |f| %>
          <%= f.ss_text_field :code, label: t("security.totp.code"), id: "on-code", class: "num w-36", inputmode: "numeric", autocomplete: "one-time-code", maxlength: 6, required: true %>
          <%= render Ss::ButtonComponent.new(label: t("security.totp.enable"), icon: icon("shield-check", ""), type: :submit) %>
        <% end %>
      </div>
    </div>
  <% end %>
</section>

<% if GoogleLogin.enabled? %>
<section class="ss-card ss-card-pad mt-4" aria-labelledby="google-t" data-security="google">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 id="google-t" class="flex items-center gap-2"><%= icon("link", "size-5 text-accent") %><%= t("security.google.title") %></h2>
    <span class="ss-badge <%= @user.google_uid.present? ? "ss-badge-success" : "ss-badge-muted" %>"><%= @user.google_uid.present? ? t("security.google.on") : t("security.google.off") %></span>
  </div>
  <p class="text-sm text-muted mt-1"><%= t("security.google.pitch") %></p>
  <% if @user.google_uid.present? %>
    <% can_unlink = @user.password_digest.present? || @user.passkeys.any? %>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <%= render Ss::ButtonComponent.new(label: t("security.google.unlink"), href: settings_security_google_path, method: :delete, disabled: !can_unlink,
                                         variant: :outline, confirm: t("security.google.unlink_confirm")) %>
      <% unless can_unlink %><p class="text-sm text-muted"><%= t("security.google.last_credential") %></p><% end %>
    </div>
  <% elsif google_login_available? %>
    <div class="max-w-xs -mt-3"><%= render "web/sessions/google", text: "continue_with", url: settings_security_google_path, divider: false %></div>
  <% else %>
    <p class="text-sm text-muted mt-3"><%= t("security.google.unavailable_here") %></p>
  <% end %>
</section>
<% end %>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="pk-t" data-security="passkeys"
         data-controller="passkey" data-passkey-options-value="<%= settings_passkey_options_path %>" data-passkey-url-value="<%= settings_passkeys_path %>">
  <h2 id="pk-t" class="flex items-center gap-2"><%= icon("finger-print", "size-5 text-accent") %><%= t("security.passkeys.title") %></h2>
  <p class="text-sm text-muted mt-1"><%= t("security.passkeys.pitch") %></p>
  <% if @user.passkeys.any? %>
    <ul class="mt-3 divide-y divide-line">
      <% @user.passkeys.order(:created_at).each do |p| %>
        <li class="py-2 flex flex-wrap items-center justify-between gap-2">
          <div class="min-w-0"><p class="font-semibold text-ink break-words"><%= p.name %></p>
            <p class="text-xs text-muted"><%= t("security.passkeys.added_at", at: l(p.created_at, format: :short)) %><%= " · #{t('security.passkeys.used_at', at: l(p.last_used_at, format: :short))}" if p.last_used_at %></p></div>
          <%= render Ss::ButtonComponent.new(label: t("security.passkeys.remove"), icon: icon("trash", ""), href: settings_passkey_path(p), method: :delete, variant: :ghost, size: :sm,
                                             aria: { label: t("security.passkeys.remove_of", name: p.name) },
                                             confirm: t("security.passkeys.remove_confirm", name: p.name), confirm_tone: :danger, confirm_button: t("security.passkeys.remove")) %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <form class="mt-3 flex flex-wrap items-end gap-2" data-action="passkey#register">
    <%= ss_fields do |f| %>
      <%= f.ss_text_field :pk_name, label: t("security.passkeys.name"), id: "pk-name", name: nil, data: { passkey_target: "name" }, maxlength: 60, placeholder: t("security.passkeys.name_ph") %>
    <% end %>
    <%= render Ss::ButtonComponent.new(label: t("security.passkeys.add"), icon: icon("plus", ""), type: :submit) %>
  </form>
  <p class="text-sm text-danger mt-2" data-passkey-target="error" role="alert" hidden></p>
  <p class="text-sm text-muted mt-2" data-passkey-target="unsupported" hidden><%= t("security.passkeys.unsupported") %></p>
</section>
<% end %>
