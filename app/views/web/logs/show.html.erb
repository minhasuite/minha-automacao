<%= render "web/shared/header", title: t("settings.title"), subtitle: t("logs.subtitle") %>
<%= render layout: "web/settings/frame", locals: { current: :logs } do %>
<nav class="ss-chips is-solid mb-4" data-controller="ss-scroll-current" aria-label="<%= t("logs.nav") %>">
  <% %w[resumo completo].each do |key| %>
    <%= link_to t("logs.tabs.#{key}"), settings_logs_path(aba: key), class: "ss-chip no-underline", "aria-current": (key == @tab).to_s %>
  <% end %>
</nav>
<%= form_with url: settings_logs_path, method: :get, class: "mb-3 flex flex-wrap items-end gap-3", role: "search" do %>
  <%= hidden_field_tag :aba, @tab, id: nil %>
  <% if @tab == "resumo" %>
    <div><label for="nivel" class="ss-label"><%= t("logs.level") %></label>
      <%= select_tag :nivel, options_for_select([ [ t("logs.levels.warn"), "warn" ], [ t("logs.levels.error"), "error" ] ], params[:nivel]), include_blank: t("logs.all"), class: "ss-input" %></div>
    <div><label for="fonte" class="ss-label"><%= t("logs.source") %></label>
      <%= select_tag :fonte, options_for_select(@sources, params[:fonte]), include_blank: t("logs.all"), class: "ss-input" %></div>
  <% else %>
    <div><label for="servico" class="ss-label"><%= t("logs.service") %></label>
      <%= select_tag :servico, options_for_select(Web::LogsController::SERVICES.map { |s| [ t("logs.services.#{s}"), s ] }, @service), class: "ss-input" %></div>
  <% end %>
  <div class="min-w-48 flex-1"><label for="q" class="ss-label"><%= t("logs.search") %></label><%= search_field_tag :q, params[:q], class: "ss-input" %></div>
  <button type="submit" class="ss-btn ss-btn-ghost"><%= icon("search", "size-4") %><%= t("logs.filter") %></button>
  <%= link_to settings_logs_path(request.query_parameters.merge(format: :text)), class: "ss-btn ss-btn-outline", data: { turbo: false } do %><%= icon("download", "size-4") %><%= t("logs.download") %><% end %>
<% end %>

<% if @tab == "resumo" %>
  <% if @logs.empty? %>
    <%= render Ss::EmptyStateComponent.new(title: t("logs.empty"), text: t("logs.empty_hint"), css: "ss-card") %>
  <% else %>
    <ul class="ss-card ss-rows" aria-label="<%= t("logs.tabs.resumo") %>">
      <% @logs.each do |l| %>
        <li class="!items-start" data-log="<%= l.level %>">
          <%= icon(l.level == "warn" ? "exclamation-circle" : "x-circle", "size-5 shrink-0 mt-0.5 #{l.level == 'warn' ? 'text-warn' : 'text-danger'}") %>
          <div class="min-w-0 flex-1">
            <p class="text-sm text-ink break-words num"><%= l.message %></p>
            <p class="text-xs text-muted"><span class="ss-badge ss-badge-muted"><%= l.source %></span> · <%= t("logs.levels.#{l.level == 'fatal' ? 'error' : l.level}") %> ·
              <%= t("logs.times", count: l.count) %> · <%= t("logs.last", at: l(l.last_at, format: :short)) %><%= " · #{t('logs.first', at: l(l.first_at, format: :short))}" if l.count > 1 %></p>
          </div>
        </li>
      <% end %>
    </ul>
    <div class="mt-3 flex justify-end">
      <%= button_to settings_logs_path, method: :delete, class: "ss-btn ss-btn-ghost ss-btn-sm", form: { data: { turbo_confirm_tone: "danger", turbo_confirm: t("logs.clear_confirm"), turbo_confirm_button: t("logs.clear") } } do %><%= icon("trash", "size-4") %><%= t("logs.clear") %><% end %>
    </div>
  <% end %>
<% elsif @error %>
  <%= render Ss::EmptyStateComponent.new(title: t("logs.raw_unavailable"), text: @error, variant: :erro, css: "ss-card") %>
<% else %>
  <%= render Ss::CodeBlockComponent.new(text: @raw.presence || t("logs.empty"), max_height: "70vh", label: t("logs.tabs.completo")) %>
<% end %>
<% end %>
