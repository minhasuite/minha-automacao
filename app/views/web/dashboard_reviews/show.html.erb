<%# Ideias 24 e 25: revisar antes de publicar. Avisos que não bloqueiam (Dashboards::Lint) com o link para corrigir,
    o resumo do que mudou e a prévia do rascunho em celular, tablet e computador, no claro ou no escuro: cada
    quadro é um iframe do próprio painel (`?rascunho=1&embed=1`), sem desenhar o painel de novo aqui. %>
<% views = Array(@draft["views"]) %>
<% nothing = !@dashboard.draft? && !@dashboard.auto? %>
<%= render "web/shared/header", title: t("dashboards.review.title"), subtitle: [ @dashboard.name, t("dashboards.review.changes", count: @changes) ].join(" · "), back: edit_dashboard_path(@dashboard, view: @view&.dig("id")) do %>
  <%= link_to compare_dashboard_path(@dashboard), class: "ss-btn ss-btn-ghost" do %><%= icon("switch-horizontal", "size-4") %><%= t("dashboards.cmp.short") %><% end %>
  <%= render Ss::ButtonComponent.new(label: t("dashboards.publish"), icon: "upload", href: publish_dashboard_path(@dashboard), method: :post, disabled: nothing,
                                     title: (t("dashboards.ed.nothing_to_publish") if nothing),
                                     confirm: (@warnings.any? ? t("dashboards.review.confirm_warnings", count: @warnings.size) : t("dashboards.ed.publish_confirm")),
                                     confirm_button: t("dashboards.publish")) %>
<% end %>

<section class="ss-card ss-card-pad" aria-labelledby="rv-warn">
  <h2 id="rv-warn" class="flex items-center gap-2"><%= icon(@warnings.any? ? "exclamation-circle" : "check-circle", "size-5 #{@warnings.any? ? 'text-warn' : 'text-ok'}") %><%= t("dashboards.review.warnings_title", count: @warnings.size) %></h2>
  <% if @warnings.empty? %>
    <p class="text-sm text-muted mt-1"><%= t("dashboards.review.no_warnings") %></p>
  <% else %>
    <p class="text-sm text-muted mt-1"><%= t("dashboards.review.warnings_hint") %></p>
    <ul class="mt-3 divide-y divide-line">
      <% @warnings.each do |w| %>
        <li class="py-2 flex flex-wrap items-center gap-2">
          <span class="ss-badge ss-badge-warn"><%= t("dashboards.lint.kinds.#{w['kind']}") %></span>
          <span class="min-w-0 flex-1"><span class="font-semibold text-ink"><%= w["label"] %></span> <span class="text-xs text-muted"><%= w["view_title"] %></span>
            <span class="block text-sm text-ink-2"><%= w["text"] %></span></span>
          <%= link_to t("dashboards.review.fix"), edit_dashboard_path(@dashboard, view: w["view_id"], w: w["widget_id"], anchor: w["widget_id"]), class: "ss-btn ss-btn-ghost ss-btn-sm" %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section class="ss-card ss-card-pad mt-4" aria-labelledby="rv-prev">
  <div class="flex flex-wrap items-center gap-3">
    <h2 id="rv-prev" class="flex-1 flex items-center gap-2"><%= icon("eye", "size-5 text-accent") %><%= t("dashboards.review.preview_title") %></h2>
    <nav class="ss-seg w-full sm:w-64" aria-label="<%= t("dashboards.review.theme") %>">
      <% Web::DashboardReviewsController::THEMES.each do |th| %>
        <%= link_to review_dashboard_path(@dashboard, view: @view&.dig("id"), tema: th), "aria-current": (th == @theme ? "true" : nil), class: "flex items-center justify-center gap-1.5 text-sm font-bold no-underline" do %><%= icon(th == "dark" ? "moon" : "sun", "size-4") %><%= t("dashboards.review.themes.#{th}") %><% end %>
      <% end %>
    </nav>
  </div>
  <% if views.size > 1 %>
    <nav class="ss-chips is-solid mt-3" aria-label="<%= t("dashboards.views") %>">
      <% views.each do |v| %>
        <%= link_to v["title"], review_dashboard_path(@dashboard, view: v["id"], tema: @theme), class: "ss-chip no-underline", "aria-current": (v == @view ? "true" : nil) %>
      <% end %>
    </nav>
  <% end %>
  <div class="mt-4 flex flex-wrap items-start gap-4">
    <% { "mobile" => [ 0.6, 520 ], "tablet" => [ 0.45, 520 ], "desktop" => [ 0.42, 520 ] }.each do |screen, (zoom, height)| %>
      <% width = Web::DashboardReviewsController::SCREENS[screen] %>
      <figure class="min-w-0">
        <figcaption class="text-xs font-semibold text-muted mb-1"><%= t("dashboards.screens.#{screen}") %> · <span class="num"><%= width %> px</span></figcaption>
        <div class="dw-ed-shot dw-ed-shot-box" style="--w: <%= width %>px; --h: <%= height %>px; --z: <%= zoom %>">
          <iframe src="<%= dashboard_path(@dashboard, rascunho: 1, embed: 1, view: @view&.dig("id"), tema: @theme) %>" title="<%= t("dashboards.review.frame", screen: t("dashboards.screens.#{screen}")) %>"
                  loading="lazy" sandbox="allow-same-origin allow-scripts" tabindex="-1"></iframe>
        </div>
      </figure>
    <% end %>
  </div>
</section>
