<%# locals: (site:) -%>
<p class="text-sm text-muted mb-4 max-w-3xl"><%= t("assist_settings.runs.pitch", keep: AssistRun::KEEP) %></p>
<% if @runs.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("assist_settings.runs.empty"), text: t("assist_settings.runs.empty_hint"), css: "ss-card") %>
<% else %>
  <ol class="grid gap-3" aria-label="<%= t("assist_settings.runs.label") %>">
    <% @runs.each do |r| %>
      <% total = [ r.stages.sum { |s| s["ms"].to_i }, 1 ].max %>
      <li class="ss-card vz-run <%= 'vz-run-error' if r.error %>">
        <details>
          <summary class="vz-run-head">
            <span class="vz-run-src" title="<%= t("assist_settings.sources.#{r.source}") %>"><%= icon({ "satellite" => "status-online", "app" => "device-mobile", "mcp" => "code", "api" => "link" }.fetch(r.source, "desktop-computer"), "size-4") %></span>
            <span class="min-w-0 flex-1">
              <span class="vz-run-heard"><%= r.heard.presence || t("assist_settings.runs.no_text") %></span>
              <span class="vz-run-reply"><%= r.error || r.reply.presence || "—" %></span>
            </span>
            <span class="vz-run-meta">
              <% if r.intent %><span class="ss-badge <%= r.intent == 'unknown' ? 'ss-badge-warn' : 'ss-badge-accent' %>"><%= r.intent %></span><% end %>
              <% if r.error %><span class="ss-badge ss-badge-danger"><%= t("assist_settings.runs.error") %></span><% end %>
              <time class="text-xs text-muted num" datetime="<%= r.created_at.iso8601 %>"><%= l(r.created_at, format: "%d/%m %H:%M:%S") %></time>
            </span>
          </summary>
          <div class="vz-run-bar" role="img" aria-label="<%= t("assist_settings.runs.bar", ms: r.duration_ms.to_i) %>">
            <% r.stages.each do |s| %><span class="vz-seg vz-seg-<%= s["stage"] %> <%= 'vz-seg-error' if s["error"] %>" style="flex-grow: <%= [ s["ms"].to_i, total / 50, 1 ].max %>"></span><% end %>
          </div>
          <%# Etapas no Ss::JobProgressComponent (tempo de cada uma e o total); a faixa colorida acima é a proporção. %>
          <% stages = r.stages.map do |s|
               detail = [ (Assist::Engines[s["engine"]]&.label || s["engine"] if s["engine"]), (%(“#{s["text"]}”) if s["text"]), s["intent"],
                          (s["slots"].map { |k, v| "#{k}=#{v}" }.join(", ") if s["slots"].present?), s["error"] ].compact_blank.join(" · ")
               { name: t("assist_settings.stages.#{s['stage']}", default: s["stage"]), duration: s["ms"].to_i, status: (s["error"] ? :failed : :done), detail: detail.presence }
             end %>
          <%= render Ss::JobProgressComponent.new(id: "assist-run-#{r.id}", title: t("assist_settings.runs.stages"), state: (r.error ? :failed : :done), error: r.error,
                                                  stages: stages, css: "vz-run-job") %>
          <p class="vz-run-who"><b><%= t("assist_settings.runs.who") %></b> <%= [ r.user&.name, r.pipeline&.name, t("assist_settings.sources.#{r.source}"), r.language ].compact.join(" · ") %></p>
        </details>
      </li>
    <% end %>
  </ol>
<% end %>
