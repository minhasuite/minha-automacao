<%# locals: (site:) -%>
<%= render(Ss::CalloutComponent.new(css: "mb-4 max-w-3xl")) { t("assist_settings.runs.pitch", keep: AssistRun::KEEP) } %>
<% if @latency.present? %>
  <section class="ss-card ss-card-pad mb-4" aria-labelledby="dl-t">
    <h2 id="dl-t" class="text-base font-bold text-ink flex items-center gap-2"><%= icon("clock", "size-5") %><%= t("assist_settings.latency.title") %></h2>
    <%= render "latency", latency: @latency %>
  </section>
<% end %>
<% if @runs.empty? %>
  <%= render Ss::EmptyStateComponent.new(title: t("assist_settings.runs.empty"), text: t("assist_settings.runs.empty_hint"), css: "ss-card") %>
<% else %>
  <ol class="grid gap-3" aria-label="<%= t("assist_settings.runs.label") %>">
    <% @runs.each do |r| %>
      <% total = [ r.stages.sum { |s| s["ms"].to_i }, 1 ].max %>
      <li class="ss-card overflow-hidden">
        <%# Execução num card recolhível: a linha de cima é um .ss-item com a seta da gem (.ss-summary); embaixo, a faixa de tempo (domínio) e as etapas. %>
        <details>
          <summary class="ss-summary ss-item px-4 py-3">
            <span class="ss-icon-tile is-sm <%= r.error ? 'is-danger' : 'is-muted' %>" title="<%= t("assist_settings.sources.#{r.source}") %>"><%= icon({ "satellite" => "status-online", "app" => "device-mobile", "mcp" => "code", "api" => "link" }.fetch(r.source, "desktop-computer"), "") %></span>
            <span class="ss-item-main">
              <span><%= r.heard.presence || t("assist_settings.runs.no_text") %></span>
              <span><%= r.error || r.reply.presence || "—" %></span>
            </span>
            <span class="flex flex-none flex-col items-end gap-1">
              <% if r.intent %><span class="ss-badge <%= r.intent == 'unknown' ? 'ss-badge-warn' : 'ss-badge-accent' %>"><%= r.intent %></span><% end %>
              <% if r.error %><span class="ss-badge ss-badge-danger"><%= t("assist_settings.runs.error") %></span><% end %>
              <time class="text-xs text-muted num" datetime="<%= r.created_at.iso8601 %>"><%= l(r.created_at, format: "%d/%m %H:%M:%S") %></time>
            </span>
          </summary>
          <div class="vz-run-bar mx-4" role="img" aria-label="<%= t("assist_settings.runs.bar", ms: r.duration_ms.to_i) %>">
            <% r.stages.each do |s| %><span class="vz-seg vz-seg-<%= s["stage"] %> <%= 'vz-seg-error' if s["error"] %>" style="flex-grow: <%= [ s["ms"].to_i, total / 50, 1 ].max %>"></span><% end %>
          </div>
          <%# Etapas no Ss::JobProgressComponent (tempo de cada uma e o total); a faixa colorida acima é a proporção. %>
          <% stages = r.stages.map do |s|
               detail = [ (Assist::Engines[s["engine"]]&.label || s["engine"] if s["engine"]), s["provider"], (t("assist_settings.test.where.#{s['where']}") if s["where"]),
                          (%(“#{s["text"]}”) if s["text"]), s["intent"],
                          (s["slots"].map { |k, v| "#{k}=#{v}" }.join(", ") if s["slots"].present?), s["error"] ].compact_blank.join(" · ")
               { name: t("assist_settings.stages.#{s['stage']}", default: s["stage"]), duration: s["ms"].to_i, status: (s["error"] ? :failed : :done), detail: detail.presence }
             end %>
          <%= render Ss::JobProgressComponent.new(id: "assist-run-#{r.id}", title: t("assist_settings.runs.stages"), state: (r.error ? :failed : :done), error: r.error,
                                                  stages: stages, css: "is-flush mx-4 mt-2.5") %>
          <p class="mx-4 mt-1.5 mb-3.5 text-sm text-ink break-words"><b class="font-semibold text-ink-2"><%= t("assist_settings.runs.who") %></b> <%= [ r.user&.name, r.pipeline&.name, t("assist_settings.sources.#{r.source}"), r.language ].compact.join(" · ") %></p>
        </details>
      </li>
    <% end %>
  </ol>
<% end %>
