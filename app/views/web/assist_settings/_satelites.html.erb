<%# locals: (site:) -%>
<%= render(Ss::CalloutComponent.new(css: "mb-4 max-w-3xl")) { t("assist_settings.satellites.pitch") } %>
<% areas = site.areas.order(:level, :position, :name).map { |a| [ a.name, a.id ] } %>
<% devices = site.devices.where(driver: "esphome", removed_at: nil).order(:name).map { |d| [ d.name, d.id ] } %>
<% pipelines = @pipelines.map { |p| [ p.name, p.id ] } %>
<div class="grid gap-4 xl:grid-cols-2">
  <% (@satellites + [ AssistSatellite.new(site: site, kind: "wyoming", role: "resident", enabled: true) ]).each do |sat| %>
    <% id = sat.persisted? ? sat.id : "novo" %>
    <section class="ss-card ss-card-pad min-w-0 <%= 'border-dashed' unless sat.persisted? %>" aria-labelledby="st-<%= id %>">
      <div class="flex items-center gap-3">
        <span class="ss-icon-tile <%= sat.online? ? 'is-success' : 'is-accent' %>"><%= icon(sat.persisted? ? "status-online" : "plus", "") %></span>
        <div class="min-w-0 flex-1">
          <h2 id="st-<%= id %>" class="text-base font-bold text-ink truncate"><%= sat.persisted? ? sat.name : t("assist_settings.satellites.new") %></h2>
          <% if sat.persisted? %>
            <p class="text-xs text-muted truncate"><%= [ sat.plugin&.label, sat.area&.name, sat.pipeline_or_default&.name ].compact.join(" · ") %></p>
          <% end %>
        </div>
        <% if sat.persisted? %>
          <span class="ss-badge <%= sat.online? ? 'ss-badge-success' : (sat.last_error ? 'ss-badge-danger' : '') %>"><%= sat.online? ? t("assist_settings.satellites.online") : (sat.enabled ? t("assist_settings.satellites.offline") : t("assist_settings.satellites.off")) %></span>
        <% end %>
      </div>
      <% if sat.last_error %><p class="mt-2 text-sm text-danger" role="alert"><%= sat.last_error %></p><% end %>
      <%= ss_form_with model: sat, scope: :satellite, url: sat.persisted? ? site_assist_satellite_path(site, sat) : site_assist_satellites_path(site), method: sat.persisted? ? :patch : :post,
                    class: "mt-4 grid gap-3 sm:grid-cols-2" do |f| %>
        <%= f.ss_text_field :name, label: t("assist_settings.pipelines.name"), id: "sn-#{id}", maxlength: 60, required: true %>
        <%= f.ss_select :kind, Assist::Satellites.plugins.map { |p| [ p.label, p.key ] }, label: t("assist_settings.satellites.kind"), id: "sk-#{id}" %>
        <%= f.ss_text_field :host, label: t("assist_settings.fields.host"), id: "sh-#{id}", class: "num", maxlength: 120, placeholder: "192.168.0.50" %>
        <%= f.ss_number_field :port, label: t("assist_settings.fields.port"), id: "sp-#{id}", class: "num", min: 1, max: 65_535, placeholder: Wyoming::PORTS[:satellite] %>
        <%= f.ss_select :device_id, devices, label: t("assist_settings.satellites.device"), include_blank: t("assist_settings.satellites.device_none"), id: "sd-#{id}", wrapper_class: "sm:col-span-2" %>
        <%= f.ss_select :area_id, areas, label: t("assist_settings.satellites.area"), include_blank: t("assist_settings.satellites.no_area"), id: "sa-#{id}" %>
        <%= f.ss_select :pipeline_id, pipelines, label: t("assist_settings.satellites.pipeline"), include_blank: t("assist_settings.satellites.preferred"), id: "sl-#{id}" %>
        <%= f.ss_select :role, AssistSatellite::ROLES.map { |r| [ SiteMembership::ROLE_LABELS[r], r ] }, label: t("assist_settings.satellites.role"), id: "sr-#{id}" %>
        <%= f.ss_check_box :enabled, label: t("assist_settings.satellites.enabled"), id: "se-#{id}", wrapper_class: "text-sm self-end pb-2" %>
        <p class="text-xs text-muted sm:col-span-2"><%= Assist::Satellites.plugins.map(&:hint).join(" ") %></p>
        <div class="sm:col-span-2"><%= f.ss_submit sat.persisted? ? t("assist_settings.save") : t("assist_settings.satellites.create"), name: nil %></div>
      <% end %>
      <% if sat.persisted? %>
        <div class="mt-2 flex flex-wrap gap-2">
          <%= render Ss::ButtonComponent.new(label: t("assist_settings.satellites.test"), href: site_assist_satellite_test_path(site, sat), method: :post, variant: :outline, size: :sm) %>
          <%= render Ss::ButtonComponent.new(label: t("assist_settings.remove"), href: site_assist_satellite_path(site, sat), method: :delete, variant: :ghost, size: :sm, css: "text-danger",
                                             confirm: t("assist_settings.satellites.confirm_remove", name: sat.name), confirm_tone: :danger, confirm_button: t("shared.confirm.remove")) %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
