<%# locals: (site:) -%>
<%# P3: o que a voz desta casa entende e responde, como dado: frase → cena ou script e respostas no lugar das padrão. -%>
<% languages = [ [ t("custom.voice.any_language"), "" ] ] + Assist::LANGUAGES.map { |l| [ t("assist_settings.languages.#{l.tr('-', '_')}"), l ] } %>
<% targets = AssistCustomIntent.targets(site) %>
<%= render(Ss::CalloutComponent.new(css: "mb-4 max-w-3xl")) { t("custom.voice.pitch") } %>

<h2 class="mb-3 flex items-center gap-2"><%= icon("microphone", "size-5") %><%= t("custom.voice.intents") %></h2>
<div class="grid gap-4 xl:grid-cols-2">
  <% (@intents + [ AssistCustomIntent.new(site: site, enabled: true) ]).each do |ci| %>
    <% id = ci.persisted? ? ci.id : "nova" %>
    <section class="ss-card ss-card-pad min-w-0 <%= 'border-dashed' unless ci.persisted? %>" aria-labelledby="ci-<%= id %>" data-custom-intent="<%= id %>">
      <h3 id="ci-<%= id %>" class="text-base font-bold text-ink truncate"><%= ci.persisted? ? ci.name : t("custom.voice.new_intent") %></h3>
      <% if ci.persisted? %><p class="text-xs text-muted truncate"><%= [ ci.target_name, ci.language.presence && t("assist_settings.languages.#{ci.language.tr('-', '_')}"), (t("custom.voice.off") unless ci.enabled) ].compact.join(" · ") %></p><% end %>
      <%= ss_form_with model: ci, scope: :intent, url: ci.persisted? ? site_assist_intent_path(site, ci) : site_assist_intents_path(site), method: ci.persisted? ? :patch : :post,
                    class: "mt-3 grid gap-3 sm:grid-cols-2" do |f| %>
        <%= f.ss_text_field :name, label: t("custom.voice.name"), id: "cin-#{id}", maxlength: 60, required: true, placeholder: t("custom.voice.name_ph") %>
        <%= f.ss_select :language, languages, label: t("assist_settings.pipelines.language"), id: "cil-#{id}" %>
        <%= f.ss_text_area :sentences_text, label: t("custom.voice.sentences"), help: t("custom.voice.sentences_hint"), id: "cis-#{id}", rows: 3, class: "num", required: true,
                                            placeholder: t("custom.voice.sentences_ph"), wrapper_class: "sm:col-span-2" %>
        <%= f.ss_select :target, grouped_options_for_select(targets, ci.target), label: t("custom.voice.target"), help: t("custom.voice.target_hint"), include_blank: t("automations.bp.choose"),
                                 id: "cit-#{id}", required: true, wrapper_class: "sm:col-span-2" %>
        <%= f.ss_text_field :response, label: t("custom.voice.response"), id: "cir-#{id}", maxlength: 300, placeholder: t("custom.voice.response_ph"), wrapper_class: "sm:col-span-2" %>
        <%= f.ss_check_box :enabled, label: t("custom.voice.enabled"), id: "cie-#{id}", wrapper_class: "text-sm" %>
        <div class="sm:col-span-2"><%= f.ss_submit ci.persisted? ? t("assist_settings.save") : t("custom.voice.create"), name: nil %></div>
      <% end %>
      <% if ci.persisted? %>
        <%= render Ss::ButtonComponent.new(label: t("assist_settings.remove"), href: site_assist_intent_path(site, ci), method: :delete, variant: :ghost, size: :sm, css: "text-danger mt-2",
                                           confirm: t("custom.voice.confirm_remove", name: ci.name), confirm_tone: :danger, confirm_button: t("shared.confirm.remove")) %>
      <% end %>
    </section>
  <% end %>
</div>

<h2 class="mt-6 mb-3 flex items-center gap-2"><%= icon("reply", "size-5") %><%= t("custom.voice.responses") %></h2>
<p class="text-sm text-muted mb-3 max-w-3xl"><%= t("custom.voice.responses_hint") %></p>
<% choices = AssistCustomResponse.choices.map { |i, k, txt| [ "#{i == AssistCustomResponse::ANY ? t('custom.voice.all_intents') : i} · #{k} — #{txt}".truncate(110), "#{i}.#{k}" ] } %>
<div class="grid gap-4 xl:grid-cols-2">
  <% (@responses + [ AssistCustomResponse.new(site: site) ]).each do |cr| %>
    <% id = cr.persisted? ? cr.id : "nova" %>
    <section class="ss-card ss-card-pad min-w-0 <%= 'border-dashed' unless cr.persisted? %>" aria-labelledby="cr-<%= id %>" data-custom-response="<%= id %>">
      <h3 id="cr-<%= id %>" class="text-base font-bold text-ink truncate"><%= cr.persisted? ? cr.ref : t("custom.voice.new_response") %></h3>
      <%= ss_form_with model: cr, scope: :response, url: cr.persisted? ? site_assist_response_path(site, cr) : site_assist_responses_path(site), method: cr.persisted? ? :patch : :post,
                    class: "mt-3 grid gap-3 sm:grid-cols-2" do |f| %>
        <%= f.ss_select :ref, choices, label: t("custom.voice.which"), include_blank: t("automations.bp.choose"), id: "crk-#{id}", required: true, wrapper_class: "sm:col-span-2" %>
        <%= f.ss_select :language, languages, label: t("assist_settings.pipelines.language"), id: "crl-#{id}" %>
        <%= f.ss_text_field :text, label: t("custom.voice.text"), id: "crt-#{id}", maxlength: 300, required: true, placeholder: t("custom.voice.text_ph"), wrapper_class: "sm:col-span-2" %>
        <div class="sm:col-span-2"><%= f.ss_submit cr.persisted? ? t("assist_settings.save") : t("custom.voice.create"), name: nil %></div>
      <% end %>
      <% if cr.persisted? %>
        <%= render Ss::ButtonComponent.new(label: t("assist_settings.remove"), href: site_assist_response_path(site, cr), method: :delete, variant: :ghost, size: :sm, css: "text-danger mt-2",
                                           confirm: t("custom.voice.confirm_remove", name: cr.ref), confirm_tone: :danger, confirm_button: t("shared.confirm.remove")) %>
      <% end %>
    </section>
  <% end %>
</div>
