<%# locals: (site:) -%>
<%# P3: o que a voz desta casa entende e responde, como dado: frase → cena ou script e respostas no lugar das padrão. -%>
<% languages = [ [ t("custom.voice.any_language"), "" ] ] + Assist::LANGUAGES.map { |l| [ t("assist_settings.languages.#{l.tr('-', '_')}"), l ] } %>
<% targets = AssistCustomIntent.targets(site) %>
<%= render(Ss::CalloutComponent.new(css: "mb-4 max-w-3xl")) { t("custom.voice.pitch") } %>

<h2 class="mb-3 flex items-center gap-2"><%= icon("microphone", "size-5") %><%= t("custom.voice.intents") %></h2>
<div class="grid gap-4 xl:grid-cols-2">
  <% (@intents + [ AssistCustomIntent.new(site: site, enabled: true) ]).each do |ci| %>
    <% id = ci.persisted? ? ci.id : "nova" %>
    <section class="ss-card ss-card-pad min-w-0 <%= 'border-dashed' unless ci.persisted? %>" aria-labelledby="ci-<%= id %>" data-custom-intent="<%= id %>">
      <h3 id="ci-<%= id %>" class="text-base font-bold text-ink truncate"><%= ci.persisted? ? ci.name : t("custom.voice.new_intent") %></h3>
      <% if ci.persisted? %><p class="text-xs text-muted truncate"><%= [ ci.target_name, ci.language.presence && t("assist_settings.languages.#{ci.language.tr('-', '_')}"), (t("custom.voice.off") unless ci.enabled) ].compact.join(" · ") %></p><% end %>
      <%= form_with model: ci, scope: :intent, url: ci.persisted? ? site_assist_intent_path(site, ci) : site_assist_intents_path(site), method: ci.persisted? ? :patch : :post,
                    class: "mt-3 grid gap-3 sm:grid-cols-2" do |f| %>
        <div><%= f.label :name, t("custom.voice.name"), class: "ss-label", for: "cin-#{id}" %><%= f.text_field :name, id: "cin-#{id}", class: "ss-input", maxlength: 60, required: true, placeholder: t("custom.voice.name_ph") %></div>
        <div><%= f.label :language, t("assist_settings.pipelines.language"), class: "ss-label", for: "cil-#{id}" %><%= f.select :language, languages, {}, id: "cil-#{id}", class: "ss-input" %></div>
        <div class="sm:col-span-2"><%= f.label :sentences_text, t("custom.voice.sentences"), class: "ss-label", for: "cis-#{id}" %>
          <%= f.text_area :sentences_text, id: "cis-#{id}", rows: 3, class: "ss-input num", required: true, placeholder: t("custom.voice.sentences_ph") %>
          <p class="text-xs text-muted mt-1"><%= t("custom.voice.sentences_hint") %></p></div>
        <div class="sm:col-span-2"><%= f.label :target, t("custom.voice.target"), class: "ss-label", for: "cit-#{id}" %>
          <%= f.select :target, grouped_options_for_select(targets, ci.target), { include_blank: t("automations.bp.choose") }, id: "cit-#{id}", class: "ss-input", required: true %>
          <p class="text-xs text-muted mt-1"><%= t("custom.voice.target_hint") %></p></div>
        <div class="sm:col-span-2"><%= f.label :response, t("custom.voice.response"), class: "ss-label", for: "cir-#{id}" %><%= f.text_field :response, id: "cir-#{id}", class: "ss-input", maxlength: 300, placeholder: t("custom.voice.response_ph") %></div>
        <label class="ss-check text-sm"><%= f.check_box :enabled, id: "cie-#{id}" %> <%= t("custom.voice.enabled") %></label>
        <div class="sm:col-span-2"><%= f.submit ci.persisted? ? t("assist_settings.save") : t("custom.voice.create"), class: "ss-btn ss-btn-primary", name: nil %></div>
      <% end %>
      <% if ci.persisted? %>
        <%= button_to t("assist_settings.remove"), site_assist_intent_path(site, ci), method: :delete, class: "ss-btn ss-btn-ghost ss-btn-sm text-danger mt-2",
                      form: { data: { turbo_confirm_tone: "danger", turbo_confirm_button: t("shared.confirm.remove"), turbo_confirm: t("custom.voice.confirm_remove", name: ci.name) } } %>
      <% end %>
    </section>
  <% end %>
</div>

<h2 class="mt-6 mb-3 flex items-center gap-2"><%= icon("reply", "size-5") %><%= t("custom.voice.responses") %></h2>
<p class="text-sm text-muted mb-3 max-w-3xl"><%= t("custom.voice.responses_hint") %></p>
<% choices = AssistCustomResponse.choices.map { |i, k, txt| [ "#{i == AssistCustomResponse::ANY ? t('custom.voice.all_intents') : i} · #{k} — #{txt}".truncate(110), "#{i}.#{k}" ] } %>
<div class="grid gap-4 xl:grid-cols-2">
  <% (@responses + [ AssistCustomResponse.new(site: site) ]).each do |cr| %>
    <% id = cr.persisted? ? cr.id : "nova" %>
    <section class="ss-card ss-card-pad min-w-0 <%= 'border-dashed' unless cr.persisted? %>" aria-labelledby="cr-<%= id %>" data-custom-response="<%= id %>">
      <h3 id="cr-<%= id %>" class="text-base font-bold text-ink truncate"><%= cr.persisted? ? cr.ref : t("custom.voice.new_response") %></h3>
      <%= form_with model: cr, scope: :response, url: cr.persisted? ? site_assist_response_path(site, cr) : site_assist_responses_path(site), method: cr.persisted? ? :patch : :post,
                    class: "mt-3 grid gap-3 sm:grid-cols-2" do |f| %>
        <div class="sm:col-span-2"><%= f.label :ref, t("custom.voice.which"), class: "ss-label", for: "crk-#{id}" %>
          <%= f.select :ref, choices, { include_blank: t("automations.bp.choose") }, id: "crk-#{id}", class: "ss-input", required: true %></div>
        <div><%= f.label :language, t("assist_settings.pipelines.language"), class: "ss-label", for: "crl-#{id}" %><%= f.select :language, languages, {}, id: "crl-#{id}", class: "ss-input" %></div>
        <div class="sm:col-span-2"><%= f.label :text, t("custom.voice.text"), class: "ss-label", for: "crt-#{id}" %><%= f.text_field :text, id: "crt-#{id}", class: "ss-input", maxlength: 300, required: true, placeholder: t("custom.voice.text_ph") %></div>
        <div class="sm:col-span-2"><%= f.submit cr.persisted? ? t("assist_settings.save") : t("custom.voice.create"), class: "ss-btn ss-btn-primary", name: nil %></div>
      <% end %>
      <% if cr.persisted? %>
        <%= button_to t("assist_settings.remove"), site_assist_response_path(site, cr), method: :delete, class: "ss-btn ss-btn-ghost ss-btn-sm text-danger mt-2",
                      form: { data: { turbo_confirm_tone: "danger", turbo_confirm_button: t("shared.confirm.remove"), turbo_confirm: t("custom.voice.confirm_remove", name: cr.ref) } } %>
      <% end %>
    </section>
  <% end %>
</div>
