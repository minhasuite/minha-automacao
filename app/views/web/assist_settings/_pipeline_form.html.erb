<%# locals: (site:, pipeline:) -%>
<% pl = pipeline %>
<% id = pl.persisted? ? pl.id : "novo" %>
<section class="ss-card ss-card-pad min-w-0 <%= 'border-dashed' unless pl.persisted? %>" aria-labelledby="pl-<%= id %>">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 id="pl-<%= id %>" class="text-base font-bold text-ink flex items-center gap-2">
      <%= icon(pl.persisted? ? "volume-up" : "plus", "size-5") %><%= pl.persisted? ? pl.name : t("assist_settings.pipelines.new") %>
    </h2>
    <% if pl.preferred? && pl.persisted? %><span class="ss-badge ss-badge-accent"><%= icon("star", "size-3") %><%= t("assist_settings.pipelines.preferred") %></span><% end %>
  </div>
  <% if pl.persisted? %>
    <ol class="vz-flow" aria-label="<%= t("assist_settings.pipelines.flow") %>">
      <% [ [ :wake, "bell" ], [ :stt, "microphone" ], [ :agent, "sparkles" ], [ :tts, "volume-up" ] ].each do |kind, ico| %>
        <% label = kind == :agent ? AssistPipeline::AGENTS[pl.agent] : (pl.engine(kind)&.label || (kind == :wake ? t("assist_settings.pipelines.none") : Assist::Engines::Auto.label)) %>
        <li class="vz-flow-step"><span class="vz-flow-ico"><%= icon(ico, "size-4") %></span><span class="min-w-0"><span class="vz-flow-kind"><%= t("assist_settings.kinds.#{kind}") %></span><span class="vz-flow-val"><%= label %></span></span></li>
      <% end %>
    </ol>
  <% end %>
  <%= ss_form_with model: pl, scope: :pipeline, url: pl.persisted? ? site_assist_pipeline_path(site, pl) : site_assist_pipelines_path(site), method: pl.persisted? ? :patch : :post,
                class: "mt-4 grid gap-3 sm:grid-cols-2", data: { controller: "assist-engines" } do |f| %>
    <%= f.ss_text_field :name, label: t("assist_settings.pipelines.name"), id: "pn-#{id}", maxlength: 60, required: true %>
    <%= f.ss_select :language, Assist::LANGUAGES.map { |l| [ t("assist_settings.languages.#{l.tr('-', '_')}"), l ] }, label: t("assist_settings.pipelines.language"), id: "pg-#{id}" %>
    <%= f.ss_select :agent, AssistPipeline::AGENTS.invert.to_a, label: t("assist_settings.pipelines.agent"), id: "pa-#{id}" %>
    <%= f.ss_select :llm_provider, Ai.choices(:structured).invert.to_a, label: t("assist_settings.pipelines.llm"), include_blank: t("assist_settings.pipelines.llm_default"), id: "pp-#{id}" %>
    <% %i[stt tts wake].each do |kind| %>
      <% engines = Assist::Engines.for(kind) %>
      <% next if engines.empty? %>
      <% current = pl.send(kind).to_h %>
      <fieldset class="ss-fieldset ss-field-group sm:col-span-2 grid gap-2.5">
        <legend class="ss-label"><%= t("assist_settings.kinds.#{kind}") %></legend>
        <%= f.ss_select :"#{kind}_engine", engines.map { |e| [ e.label, e.key ] }, label: t("assist_settings.kinds.#{kind}"), hide_label: true, selected: current["engine"],
                                           include_blank: (kind == :wake ? t("assist_settings.pipelines.none") : t("assist_settings.pipelines.auto_default")), id: "pe-#{kind}-#{id}",
                                           data: { action: "assist-engines#pick" } %>
        <% engines.each do |e| %>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(10rem,1fr))] gap-2.5" data-engine="<%= e.key %>" <%= "hidden" unless current["engine"] == e.key %>>
            <% if e.hint %><p class="col-span-full text-xs text-muted"><%= e.hint %></p><% end %>
            <% e.fields.each do |name, type, only| %>
              <% next if only && !only.include?(kind) %>
              <% fid = "pf-#{kind}-#{e.key}-#{name}-#{id}" %>
              <% value = current["engine"] == e.key ? current[name] : nil %>
              <%= ss_fields("pipeline[#{kind}][#{e.key}]") do |ef| %>
                <% if type == :provider %>
                  <%= ef.ss_select name, Ai.choices(kind).invert.to_a, label: t("assist_settings.fields.#{name}"), selected: value, include_blank: t("assist_settings.pipelines.llm_default"), id: fid %>
                <% else %>
                  <%= ef.ss_text_field name, label: t("assist_settings.fields.#{name}"), value: value, id: fid, class: ("num" if type == :number), inputmode: (type == :number ? "numeric" : nil), maxlength: 120 %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </fieldset>
    <% end %>
    <%# voz-offline: desmarcado = STT, TTS e IA só da rede da casa (nada sai da casa). %>
    <%= f.ss_check_box :cloud, label: t("assist_settings.pipelines.cloud"), help: t("assist_settings.pipelines.cloud_hint"), id: "pc-#{id}", wrapper_class: "sm:col-span-2 text-sm" %>
    <%= f.ss_check_box :preferred, label: t("assist_settings.pipelines.make_preferred"), id: "pr-#{id}", wrapper_class: "sm:col-span-2 text-sm" %>
    <div class="sm:col-span-2 flex flex-wrap gap-2">
      <%= f.ss_submit pl.persisted? ? t("assist_settings.save") : t("assist_settings.pipelines.create"), name: nil %>
    </div>
  <% end %>
  <% if pl.persisted? %>
    <%= render Ss::ButtonComponent.new(label: t("assist_settings.remove"), href: site_assist_pipeline_path(site, pl), method: :delete, variant: :ghost, size: :sm, css: "mt-2 text-danger",
                                       confirm: t("assist_settings.pipelines.confirm_remove", name: pl.name), confirm_tone: :danger, confirm_button: t("shared.confirm.remove")) %>
  <% end %>
</section>
