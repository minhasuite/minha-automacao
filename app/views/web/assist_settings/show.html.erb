<%= render "web/shared/header", title: t("assist_settings.title"), subtitle: t("assist_settings.subtitle", site: @site.name) %>
<%= render "web/sites/tabs", site: @site, current: :assist %>
<%= render Ss::TabsComponent.new(label: t("assist_settings.tabs.label"), id: "assist-tabs", css: "mb-5") do |tabs| %>
  <% Web::AssistSettingsController::TABS.each do |tab| %>
    <% tabs.with_tab(label: t("assist_settings.tabs.#{tab}"), href: site_assist_settings_path(@site, aba: tab), current: tab == @tab, id: tab) %>
  <% end %>
<% end %>
<% case @tab %>
<% when "satelites" %><%= render "satelites", site: @site %>
<% when "depuracao" %><%= render "depuracao", site: @site %>
<% when "frases" %><%= render "frases", site: @site %>
<% when "personalizadas" %><%= render "personalizadas", site: @site %>
<% when "mcp" %><%= render "mcp", site: @site %>
<% else %><%= render "pipelines", site: @site %>
<% end %>
