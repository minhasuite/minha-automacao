<!doctype html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for(:title) || "Minha Automação" %></title>
  <%= csrf_meta_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= render "web/shared/pwa_head" %>
  <%= javascript_importmap_tags %>
  <%= yield :head %>
  <%= ss_density_head %>
  <%= render "web/shared/theme_head" %>
</head>
<%# Entrar / criar conta / esqueci a senha: tela dividida como no meu-financeiro. %>
<body class="ss-base ss-inputs min-h-screen" data-controller="ss-theme">
  <div class="min-h-screen grid lg:grid-cols-2">
    <aside class="ss-hero rounded-none! hidden lg:flex flex-col justify-between p-12 shadow-none!">
      <%= link_to root_path, class: "flex items-center gap-3 no-underline text-on-accent font-bold text-lg" do %>
        <span class="ss-icon-tile is-on-grad"><%= icon("lightning-bolt", "size-5") %></span>Minha Automação
      <% end %>
      <div class="max-w-md">
        <p class="text-4xl font-bold leading-tight tracking-tight"><%= t("layout.tagline_html") %></p>
        <p class="mt-4 text-on-accent/80 leading-relaxed"><%= t("layout.pitch") %></p>
      </div>
      <p class="text-xs text-on-accent/70">© <%= Date.current.year %> Minha Automação · MinhaSuite</p>
    </aside>
    <main class="flex flex-col items-center justify-center px-4 py-10">
      <%= link_to root_path, class: "lg:hidden mb-8 flex items-center gap-2.5 no-underline font-bold text-lg text-ink" do %>
        <span class="ss-icon-tile is-sm is-grad"><%= icon("lightning-bolt", "size-5") %></span>Minha Automação
      <% end %>
      <div class="w-full max-w-md">
        <div class="flex justify-end mb-3"><%= render "web/shared/locale_picker" %></div>
        <div class="ss-card p-7 sm:p-10 ss-rise"><%= yield %></div>
      </div>
    </main>
  </div>
  <%= render "web/shared/flash" %>
</body>
</html>
