<!doctype html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= [ content_for(:title), "Minha Automação" ].compact.join(" — ") %></title>
  <meta name="view-transition" content="same-origin">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= render "web/shared/pwa_head" %>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <%= turbo_refresh_method_tag :morph %>
  <%= turbo_refresh_scroll_tag :preserve %>
  <%= yield :head %>
  <%= ss_app_shell_head %>
  <%= ss_density_head %>
  <%= render "web/shared/theme_head" %>
</head>
<% body_theme = @body_theme || {} %>
<%# ss-inputs: caixas e rádios soltos no desenho da suíte; tema e "esconder valores" pelos controllers da gem
    (ss-privacy na chave "privacy" de antes, para não perder a escolha de quem já usava). %>
<%# Quiosque: tela cheia sem limite de largura; o cursor some parado (is-kiosk-idle, do kiosk_controller). %>
<body class="ss-base ss-inputs min-h-screen<%= " [&_main]:max-w-none [&.is-kiosk-idle]:cursor-none! [&.is-kiosk-idle_*]:cursor-none!" if kiosk %> <%= body_theme["class"] %>" style="<%= body_theme["style"] %>"
      data-controller="ss-theme ss-privacy" data-ss-privacy-key-value="privacy" data-action="keydown.p@window->ss-privacy#key">
  <%= ss_skip_link("#conteudo", t("layout.skip")) %>
  <% if kiosk %>
    <main id="conteudo" tabindex="-1" class="outline-none min-w-0 px-4 py-6 lg:px-8 lg:py-8 <%= content_for?(:wide) ? "" : "max-w-7xl" %> mx-auto"><%= yield %></main>
  <% else %>
    <%# Moldura da gem: menu recolhível (o recolhido fica no <html>, ss_app_shell_head no <head>),
        gaveta no celular, busca (abre a paleta) e troca de local (só nas telas de um local por vez,
        que a pedem pela web/shared/site_switch). Largura do conteúdo: 80rem, a não ser com :wide. %>
    <%= render Ss::AppShellComponent.new(brand: "Minha Automação", brand_url: root_path, nav: shell_nav, tenants: @shell_tenants || [], tenant_label: t("layout.site"),
                                         search_label: t("layout.search"), side_label: t("layout.main_nav"), search_action: ("palette" if current_user),
                                         main_max: (content_for?(:wide) ? nil : "80rem")) do |s| %>
      <% s.with_mark do %><img src="/icon-192.png" alt=""><% end %>
      <% s.with_top do %><%= render "web/shared/privacy_button", css: "ss-btn ss-btn-ghost ss-btn-sm lg:hidden" %><% end %>
      <% s.with_side_footer do %><%= render "web/shared/side_footer" %><% end %>
      <%= yield %>
    <% end %>
  <% end %>
  <%# "Falar com a casa" em todas as telas: botão flutuante da gem fora do <main> (o AppScreen lê só o main;
      o app tem o dele), uma vez por página. No quiosque, acima da barra do canto. %>
  <% if (site = assist_site) %><%= render "web/assist/fab", site: site, lift: ("4rem" if kiosk) %><% end %>
  <%= render "web/shared/flash" %>
  <%= render "web/shared/palette" if current_user %>
  <%# Confirmação da suíte no lugar do confirm() do navegador: com global, todo data-turbo-confirm
      abre esta caixa. Por elemento: data-turbo-confirm-title, -button (verbo do OK) e
      -tone="danger" (botão vermelho, para excluir/remover/apagar). %>
  <%= render Ss::ConfirmDialogComponent.new(id: "confirm", title: t("shared.confirm.title"), ok_label: t("shared.confirm.ok"), cancel_label: t("shared.confirm.back"), global: true) %>
</body>
</html>
