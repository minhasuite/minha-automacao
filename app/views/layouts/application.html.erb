<!doctype html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= [ content_for(:title), "Minha Automação" ].compact.join(" — ") %></title>
  <meta name="view-transition" content="same-origin">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= render "web/shared/pwa_head" %>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <%= turbo_refresh_method_tag :morph %>
  <%= turbo_refresh_scroll_tag :preserve %>
  <%= yield :head %>
  <script>try { if (localStorage.getItem("side") === "collapsed") document.documentElement.classList.add("ss-collapsed"); if (localStorage.getItem("privacy") === "on") document.documentElement.dataset.privacy = "on" } catch (_) {}</script>
</head>
<% body_theme = @body_theme || {} %>
<body class="min-h-screen<%= " ss-kiosk" if kiosk %> <%= body_theme["class"] %>" style="<%= body_theme["style"] %>" data-controller="theme menu privacy" data-action="keydown.p@window->privacy#key keydown.esc@window->menu#close">
  <a href="#conteudo" class="ss-skip"><%= t("layout.skip") %></a>
  <% unless kiosk %>
  <%# Barra do topo no celular (escura, como a sidebar). %>
  <header class="ss-side lg:hidden sticky top-0 z-30 flex items-center gap-3 px-4 h-14 shadow-lg">
    <button type="button" class="grid place-items-center size-9 rounded-xl hover:bg-white/10 border-0 bg-transparent text-current cursor-pointer" data-action="menu#open" data-menu-target="toggle" aria-label="<%= t("layout.open_menu") %>" aria-controls="side" aria-expanded="false"><%= icon("menu") %></button>
    <%= link_to root_path, class: "font-bold text-white no-underline flex-1" do %>Minha Automação<% end %>
    <button type="button" class="grid place-items-center size-9 rounded-xl hover:bg-white/10 border-0 bg-transparent text-current cursor-pointer" data-palette-open aria-label="<%= t("layout.search") %>"><%= icon("search") %></button>
    <%= render "web/shared/privacy_button", css: "grid place-items-center size-9 rounded-xl hover:bg-white/10" %>
  </header>
  <div class="ss-scrim lg:hidden" data-menu-target="scrim" data-action="click->menu#close"></div>
  <%= render "web/shared/sidebar" %>
  <% end %>
  <div class="ss-main <%= "lg:pl-64" unless kiosk %> transition-[padding] duration-300">
    <main id="conteudo" tabindex="-1" class="outline-none min-w-0 px-4 py-6 lg:px-8 lg:py-8 <%= content_for?(:wide) ? "" : "max-w-7xl" %> mx-auto">
      <div id="flash"><%= render "web/shared/flash" %></div>
      <%= yield %>
    </main>
  </div>
  <%= render "web/shared/palette" if current_user %>
  <%= render "web/shared/confirm" %>
</body>
</html>
