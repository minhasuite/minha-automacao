<!doctype html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= [ @step&.title, t("onboarding.title"), "Minha Automação" ].compact.join(" — ") %></title>
  <meta name="view-transition" content="same-origin">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= render "web/shared/pwa_head" %>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <%= render "web/shared/theme_head" %>
</head>
<%# Primeira configuração (produto): tela cheia, passos no topo, ilustração e formulário no cartão. %>
<body class="ss-base ss-inputs ob-page min-h-screen" data-controller="ss-theme">
  <div class="ob-blobs" aria-hidden="true"><span></span><span></span><span></span></div>
  <header class="ob-top">
    <span class="flex items-center gap-2.5 font-bold text-ink">
      <span class="ss-icon-tile is-sm is-grad"><%= icon("lightning-bolt", "size-5") %></span>
      <span class="max-sm:sr-only">Minha Automação</span>
    </span>
    <div class="flex items-center gap-2">
      <%= render "web/shared/locale_picker" %>
      <button type="button" class="ss-icon-btn" data-action="ss-theme#toggle" title="<%= t("layout.theme") %>" aria-label="<%= t("layout.theme") %>"><%= icon("moon", "") %></button>
    </div>
  </header>
  <main class="ob-main" id="conteudo">
    <% if @steps && @step %>
      <%# Passos no Ss::WizardComponent em modo servidor: cada passo é uma página; o já feito (e pronto) é link. %>
      <% done = Array(Onboarding.state(@ctx.tenant)["done"]) %>
      <%= render Ss::WizardComponent.new(current: @steps.index(@step) || 0, done: @steps.each_index.select { |i| done.include?(@steps[i].key) },
                                         css: "ob-wizard") do |w| %>
        <% @steps.each { |s| w.with_step(title: s.title, url: (onboarding_step_path(s.key) if s != @step && done.include?(s.key) && s.ready?(@ctx))) } %>
        <%= yield %>
      <% end %>
    <% else %>
      <%= yield %>
    <% end %>
  </main>
  <%= render "web/shared/flash" %>
</body>
</html>
