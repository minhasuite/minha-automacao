<!doctype html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="referrer" content="no-referrer">
  <title><%= content_for(:title) || "Minha Automação" %></title>
  <%= csrf_meta_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <%= ss_density_head %>
  <%= render "web/shared/theme_head" %>
</head>
<%# Ideia 11: painel do convidado. Sem menu, sem busca, sem "Falar com a casa": só o que o link mostra. %>
<body class="ss-base ss-inputs min-h-screen" data-controller="ss-theme">
  <main class="mx-auto w-full max-w-3xl px-4 py-6"><%= yield %></main>
  <%= render "web/shared/flash" %>
  <%= render Ss::ConfirmDialogComponent.new(id: "confirm", title: t("shared.confirm.title"), ok_label: t("shared.confirm.ok"), cancel_label: t("shared.confirm.back"), global: true) %>
</body>
</html>
