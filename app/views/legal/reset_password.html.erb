<% content_for(:title, t("legal.reset.title")) %>
<%= ss_form_with url: request.path, id: "reset", class: "ss-card ss-card-pad max-w-md" do |f| %>
  <%= f.ss_password_field :password, label: t("legal.reset.password"), id: "reset-password", minlength: 8, maxlength: 72, required: true, autocomplete: "new-password" %>
  <div><%= render Ss::ButtonComponent.new(label: t("legal.reset.save"), type: :submit) %></div>
  <%= render Ss::CalloutComponent.new(icon: false, id: "msg", hidden: true) %>
<% end %>
<script>
  document.getElementById("reset").addEventListener("submit", async (e) => {
    e.preventDefault();
    const msg = document.getElementById("msg");
    const token = new URLSearchParams(location.search).get("token") || "";
    const res = await fetch("/api/v1/auth/password/reset", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token, password: e.target.password.value })
    });
    const body = await res.json().catch(() => ({}));
    msg.dataset.tone = res.ok ? "success" : "danger";
    msg.querySelector(".ss-callout-body").textContent = res.ok ? <%= raw t("legal.reset.done").to_json %> : (body.error?.message || <%= raw t("legal.reset.failed").to_json %>);
    msg.hidden = false;
    if (res.ok) e.target.querySelector("button").disabled = true;
  });
</script>
