<% content_for(:title, t("legal.reset.title")) %>
<form id="reset" style="display:grid;gap:12px;max-width:360px">
  <label><%= t("legal.reset.password") %>
    <input type="password" name="password" minlength="8" maxlength="72" required autocomplete="new-password" style="width:100%;padding:10px;font-size:1rem">
  </label>
  <button type="submit" style="padding:12px;font-size:1rem;font-weight:700;background:#2e6b4f;color:#fff;border:0;border-radius:10px"><%= t("legal.reset.save") %></button>
  <p id="msg" role="status"></p>
</form>
<script>
  document.getElementById("reset").addEventListener("submit", async (e) => {
    e.preventDefault();
    const msg = document.getElementById("msg");
    const token = new URLSearchParams(location.search).get("token") || "";
    const res = await fetch("/api/v1/auth/password/reset", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token, password: e.target.password.value })
    });
    const body = await res.json().catch(() => ({}));
    msg.textContent = res.ok ? <%= raw t("legal.reset.done").to_json %> : (body.error?.message || <%= raw t("legal.reset.failed").to_json %>);
    if (res.ok) e.target.querySelector("button").disabled = true;
  });
</script>
